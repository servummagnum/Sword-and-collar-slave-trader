[{"headerIndex":230,"headerParam":["",0,0,2]}],[{"headerIndex":234,"headerParam":["",0,0,2]}],[{"headerIndex":240,"headerParam":["",0,0,2]}],[{"headerIndex":244,"headerParam":["",0,0,2]}],[{"headerIndex":247,"headerParam":["",0,0,2]}],[{"headerIndex":250,"headerParam":["",0,0,2]}],[{"headerIndex":254,"headerParam":["",0,0,2]}],[{"headerIndex":256,"headerParam":["",0,0,2]}],[{"headerIndex":296,"headerParam":["",0,0,2]}],[{"headerIndex":302,"headerParam":["",0,0,2]}],[{"headerIndex":308,"headerParam":["",0,0,2]}],[{"headerIndex":312,"headerParam":["",0,0,2]}],[{"headerIndex":315,"headerParam":["",0,0,2]}],[{"headerIndex":318,"headerParam":["",0,0,2]}],[{"headerIndex":348,"headerParam":["",0,0,2]}],[{"headerIndex":357,"headerParam":["",0,0,2]}],[{"headerIndex":372,"headerParam":["",0,0,1]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":85,"headerParam":["",0,0,2]}],[{"headerIndex":94,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":109,"headerParam":["",0,0,2]}],[{"headerIndex":114,"headerParam":["",0,0,2]}],[{"headerIndex":126,"headerParam":["",0,0,2]}],[{"headerIndex":128,"headerParam":["",0,0,2]}],[{"headerIndex":133,"headerParam":["",0,0,2]}],[{"headerIndex":141,"headerParam":["",0,0,2]}],[{"headerIndex":146,"headerParam":["",0,0,2]}],[{"headerIndex":150,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]}],[{"headerIndex":3,"headerParam":[2,false]}],[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":4,"headerParam":["イージー"]}],[{"headerIndex":8,"headerParam":["ノーマル"]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"２階":5,"EV006":6,"EV007":7,"燭台":8,"光":9,"書庫案内":10,"「こちらが一般書架になります。\n　持ち出しはできませんが、閲覧はご自由にしていただいて\n　結構ですので」\\nw[僧侶]":11,"↓隊列歩行off":12,"「ここに『竜の鉤爪』に関する資料があるのか……。\n　しかしこの本の量は……」\\nw[\\N[1]]":13,"「地道に探すしかないですね」\\nw[\\N[2]]":14,"\n\\>　　\\C[17]※　書庫の中から、目当ての資料を探し出そう　※\\C[0]":15,"チェックマーク":16,"一般書架1":17,"『四聖の神々は、先住民である猫人族が信仰していた\n　四精霊と同一視されることもあるが、これは明確な\n　誤りであって――』":18,"一般書架2":19,"『建国王リジェルダが流民を率いて、遥か南方から\n　この地へやってきたとき、四聖教の淵源となった\n　元素神信仰もまた一緒に――』":20,"『合いびき肉に、塩、胡椒、少量の砂糖、パン粉を入れ、\n　それから先に炒めておいた玉ねぎも混ぜてから、\n　しっかりとこねていき――』":21,"『王国歴２５４年７月２２日\n　猫人の集落がまたひとつ、四聖教に改宗したとの報告が\n　あった。やはり彼らの精霊信仰との類似性が――』":22,"書架調べ終わり":23,"「全然、それらしき資料が見つからんな」\\nw[\\N[1]]":24,"「本当にここにあるんでしょうか？\\nw[\\N[2]]":25,"「そもそもこんな場所にあるなら、父が会ったという\n　学者さんも普通に閲覧できていたのでは？」\\nw[\\N[2]]":26,"「そうだよなぁ。\n　……たしかここは『一般書架』だったよな？\\nw[\\N[1]]":27,"「ってことは、\\C[17]一般向けじゃない書架\\C[0]もどこかに\n　あるんじゃないか？」\\nw[\\N[1]]":28,"「あっ、そうですよきっと！\n　あそこいる僧侶の人に、ちょっと訊いてみましょう！」\\nw[\\N[2]]":29,"トークマーク":30,"書庫の僧侶":31,"「書庫の中ではお静かに」\\nw[僧侶]":32,"「はい？　ここ以外の書庫ですか？\n　ええ、ありますよ」\\nw[僧侶]":33,"「やっぱりそうか！\n　じゃあ、その書庫も見せて欲しいんだが」\\nw[\\N[1]]":34,"「それは難しいですね。\n　\\C[17]閉架書庫\\C[0]は高位の聖職者しか入ることを許されて\n　いませんので」\\nw[僧侶]":35,"「お金を払ってもダメなんですか？」\\nw[\\N[2]]":36,"「金銭の問題ではありません。\n　古くて貴重な書物が多いため、立ち入りは厳しく\n　制限されているのです。\\nw[僧侶]":37,"「どうしても閉架書庫に入りたいのであれば、高位聖職者\n　から特別な許可をもらう必要があります」\\nw[僧侶]":38,"「それなら、適当に偉い坊さんを紹介してくれ」\\nw[\\N[1]]":39,"「無茶を言わないでください。\n　高名な学者や貴族でさえ、おいそれとは許可をもらえ\n　ないんですよ？」\\nw[僧侶]":40,"「例の学者さんと同じですね。\n　正攻法で頼んでも、許可は下りないみたいです」\\nw[\\N[2]]":41,"「となると、別の攻め口を考えなきゃならんか。\n　しかし、坊さんってのは融通の効かんヤツが多い\n　からなぁ……」\\nw[\\N[1]]":42,"「すみません。\n　そちらの男性の方、よろしいでしょうか？」\\nw[尼僧]":43,"「俺のことか？」\\nw[\\N[1]]":44,"「はい。\n　司教様が、あなたにお会いしたいと申しております。\\nw[尼僧]":45,"「お手数ですが、ご足労願えますでしょうか？」\\nw[尼僧]":46,"「えっ！？　\n　司教って、なんでそんな偉い人が！？」\\nw[\\N[2]]":47,"「さあな、分からん。だが渡りに舟かもしれないな。\n　会うだけ会ってみようじゃないか」\\nw[\\N[1]]":48,"「それではご案内いたします」\\nw[尼僧]":49,"案内尼僧":50,"司教（依頼Ev）":51,"「よく来てくださいました。\n　どうぞ、そちらの席におかけください」\\nw[司教]":52,"「お呼びに応じて参上したが、司教様が俺なんかに\n　いったい何の用かな？」\\nw[\\N[1]]":53,"「あの、もうちょっと礼儀正しくした方が……」\\nw[\\N[2]]":54,"「いえいえ、そう肩肘を張らずに、楽にしてください。\\nw[司教]":55,"「お呼びしたのは、あなたに依頼したいことが\n　あるからです。\\N[1]さん」\\nw[司教]":56,"「四聖教が俺に？\n　誰か別の人間と勘違いしてるんじゃないか？」\\nw[\\N[1]]":57,"「いいえ、そんなことはありません。\n　奴隷商人のあなたにお願いをしたいのです。\\nw[司教]":58,"「我々四聖教は、つねに市井の動きに注意を払っており、\n　有望な商人のリストを作成しております。\\nw[司教]":59,"「あなたの名も、つい先日そのリストに載ったところ\n　ですよ」\\nw[司教]":60,"「へぇ？\n　少しは四聖教の役に立ちそうなヤツだと、認めて\n　くれたわけだ？」\\nw[\\N[1]]":61,"「だから言い方……。\n　失礼ですよ、\\N[1]さん」\\nw[\\N[2]]":62,"「誤解しないでください。\n　なにも一方的にあなたを利用しようというのでは\n　ありません。\\nw[司教]":63,"「お互いに必要なものを補い合おう、ということです」\\nw[司教]":64,"「こちらの必要とするものは閉架書庫の閲覧だが、\n　そちらの依頼を果たせば許可してくれるのか？」\\nw[\\N[1]]":65,"「本来であれば絶対に許可できませんが……いいでしょう。\n　私の権限において閲覧できるよう手配します」\\nw[司教]":66,"「なるほど、悪くない話だ。\n　で、肝心の依頼というのは？」\\nw[\\N[1]]":67,"「王都ラウ・ディゼルにある\\C[17]王都聖堂\\C[0]はご存じですね？」\\nw[司教]":68,"「もちろんだ。\n　この大聖堂を除けば、王国で一番デカイ聖堂だったな」\\nw[\\N[1]]":69,"「はい。\n　その王都聖堂の責任者であり、四聖教のＮｏ．２である\n　\\C[17]大司教\\C[0]に、いま重大な背教の嫌疑がかかっています」\\nw[司教]":70,"「そ、そんな偉い聖職者が背教！？」\\nw[\\N[2]]":71,"「ほう？　具体的にはどんな嫌疑が？」\\nw[\\N[1]]":72,"「密貿易や違法な奴隷売買への協力、四聖教の権威を利用\n　しての不正な土地取引。\\nw[司教]":73,"「そして王都聖堂の尼僧たちを、無理矢理に自分の寝室へ\n　引き込んでいるとも」\\nw[司教]":74,"「うわぁ……聖職者のやることじゃないですね……」\\nw[\\N[2]]":75,"「こうした嫌疑は前々から囁かれていましたが、証拠を\n　つかむまでには至っておらず、ずっと野放しのまま\n　だったのです。\\nw[司教]":76,"「ところが最近になって、悪事の証拠となる\\C[17]『覚え書き』\\C[0]を\n　大司教がこまめに書き記しているらしいと分かりました。\\nw[司教]":77,"「その『覚え書き』を入手できれば、動かぬ証拠と\n　なるでしょう」\\nw[司教]":78,"「まさかそいつを、俺たちに盗んで来いと？」\\nw[\\N[1]]":79,"「はい、お察しの通りです」\\nw[司教]":80,"「ちょっと待ってくれ、俺たちはプロの泥棒じゃ\n　ないんだぞ？」\\nw[\\N[1]]":81,"「わかっています。\n　しかし今回に限っては、盗みのプロより奴隷商人の力が\n　必要なのです。\\nw[司教]":82,"「覚え書きがある大司教の寝室は常に厳重な警備下に\n　おかれており、人の目を盗んで忍び入ることは\n　まず不可能なのです。\\nw[司教]":83,"「そして大司教から寝室への入室許可が与えられるのは、\n　特定の役目をもった女性のみ――」\\nw[司教]":84,"「夜のお相手を命じられた、憐れな尼僧だけってか」\\nw[\\N[1]]":85,"「はい、まったくもって許しがたいことですが……」\\nw[司教]":86,"「だがそれなら、目端の利く尼僧をスパイにして、\n　王都聖堂へ送ればいいじゃないか」\\nw[\\N[1]]":87,"「ところが大司教もそれを警戒しており、最近では\n　正規の尼僧には手を出さないようにしているらしく」\\nw[司教]":88,"「正規の尼僧？」\\nw[\\N[1]]":89,"「現在はどうやら、奴隷商人から買った女奴隷を\n　尼僧に仕立て上げて、身辺にはべらせているよう\n　なのです。\\nw[司教]":90,"「そこであなたから、大司教へ奴隷を売り込んでもらいたい。\n　もちろんその奴隷は、こちらで用意します」\\nw[司教]":91,"「\\C[17]女スパイの潜入を手助けしろ\\C[0]ってことですか！？」\\nw[\\N[2]]":92,"「なるほど、そういう話なら……」\\nw[\\N[1]]":93,"「引き受けてもらえますか？」\\nw[司教]":94,"「分かった、その依頼を受けようじゃないか」\\nw[\\N[1]]":95,"「ありがとうございます。\\nw[司教]":96,"「では早速、潜入させる奴隷――もとい、特殊任務専門の\n　尼僧をご紹介いたしましょう」\\nw[司教]":97,"「び、びっくりしたぁ！？\n　どこから現れたんですか、この人！？」\\nw[\\N[2]]":98,"「この者が奴隷に扮して、王都聖堂へ潜入します」\\nw[司教]":99,"「よろしくお願いします、奴隷商人殿」\\nw[スパイ尼僧]":100,"「お、おう……ヨロシク」\\nw[\\N[1]]":101,"「私は先に王都へ向かい、聖堂の近くに潜伏して\n　おきますので、奴隷商人殿はあとから来てください。\\nw[スパイ尼僧]":102,"「では、これにて」\\nw[スパイ尼僧]":103,"「ではよろしく頼みます、\\N[1]さん。\n　うまくやってくださいね」\\nw[司教]":104,"依頼\\C[17]『スパイ大作戦』\\C[0]を受けた！":105,"\\>　　※　王都へ行き、\\C[17]王都聖堂\\C[0]のそばに潜伏している　※\n\\>　　※　\\C[17]スパイ尼僧\\C[0]と合流しよう。　　　　　　　　　※\\<":106,"「大司教の覚え書きを入手してくれたそうですね。\n　ありがとうございます」\\nw[司教]":107,"「予想外のトラブルもあったが、どうにかな」\\nw[\\N[1]]":108,"「スパイさんも、無事に戻ってこられたんですね」\\nw[\\N[2]]":109,"「はい。\n　自分一人逃げるだけなら、どうとでもなりますので」\\nw[スパイ尼僧]":110,"「で、これが約束の品だ」\\nw[\\N[1]]":111,"\\C[17]『大司教の覚え書き』\\C[0]を渡した！":112,"「確かに。\n　これで大司教を、背教の徒として告発することが\n　できます」\\nw[司教]":113,"「わたしが受けた仕打ちの分も、きっちり罰して\n　くださいね！」\\nw[\\N[2]]":114,"「え、ええ……。\n　忘れず罪状に数えておきます」\\nw[司教]":115,"メインシナリオ\\C[17]『スパイ大作戦』\\C[0]を達成した！":116,"\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！":117,"「依頼は果たしたんだ、閉架書庫への入室を許可して\n　もらうぞ」\\nw[\\N[1]]":118,"「はい、すでに手続きはしてありますので、彼女に\n　案内させましょう」\\nw[司教]":119,"「貴重な書籍が山のようにある場所なので、申し訳あり\n　ませんが、案内だけじゃなく監視もさせてもらいます」\\nw[スパイ尼僧]":120,"「はいはい、そーですか。\n　勝手にしてくれ」\\nw[\\N[1]]":121,"ユマ":122,"スパイ尼僧":123,"スパイ尼僧2":124,"EV038":125,"僧侶":126,"「ここでは神酒という、祈祷用の酒を作っているんだ。\n　少量だけど一般への販売も、受付の方でやっているよ」\\nw[僧侶]":127,"番兵":128,"「一般の方は、二階への立ち入り禁止となっています」\\nw[番兵]":129,"「ここは関係者以外、立ち入り禁止です」\\nw[僧侶]":130,"「写本作業の最中なので、話しかけないでください」\\nw[僧侶]":131,"「写本は神聖な労働なんだ。\n　神々の英知を世界に知らしめるための、聖務なのさ」\\nw[僧侶]":132,"「うぅ……目が疲れる……」\\nw[僧侶]":133,"「腱鞘炎と眼精疲労は、真面目に写本作業をやってる\n　証とも言える」\\nw[僧侶]":134,"「信仰と無関係な書物を写すこともあるわよ。\n　例えばこれ、『家庭菜園の手引き』とか」\\nw[尼僧]":135,"「くくくっ……この小説、面白いわね。\n　……ちょっと、サボってたことチクらないでよ」\\nw[尼僧]":136,"「速く書こうとすると誤字脱字が多くなるし、\n　丁寧にやり過ぎると作業が進まないし……悩ましい」\\nw[尼僧]":137,"「写本作業に入る前に、修復しなければならない書物も\n　多いのだよ」\\nw[司祭]":138,"番兵2":139,"本":140,"MWL_行数変更 16":141,"\\>　　　　　　　　『四聖神頌歌』\n\\>\n\\>　　『いと高き天と、いと広き大地に\n\\>　　　深く慈悲をたれたもう\n\\>　　　聖なる四柱の神々よ\n\\>\n\\>　　　万物を成す力はその足元より出で\n\\>　　　我らの魂をあまねく潤す\n\\>\n\\>　　　神々を称えよ\n\\>　　　聖なる力を言祝ぎ歌え\n\n\\>　　　ハァ＝ドッコイショ＝ドッコイショ\n\\>　　　騒乱なき平らかなる世のため』":142,"MWL_行数リセット":143,"\\>　　　　　　　『助祭資格試験問題集』\n\\>\n\\>『Ｑ１１\n\\>　水の神の御使いでありシンボルともされる生物は？\n\\>　　Ａ．魚\n\\>\n\\>　Ｑ１２\n\\>　第十五代総司教猊下が改革した位階制度の名は？\n\\>　　Ａ．階位十二階\n\\>\n\\>　Ｑ１３\n\\>　戒律で殺人と背教に次いで重い罪とされるのは？\n\\>　　Ａ．アナルセックス』":144,"\\>　　　　　　　『助祭資格試験問題集』\n\\>\n\\>『Ｑ１１\n\\>　水の神の御使いでありシンボルともされる生物は？\n\\>　　Ａ．魚\n\\>\n\\>　Ｑ１２\n\\>　第十五代総司教猊下が改革した位階制度の名は？\n\\>　　Ａ．階位十二階\n\\>\n\\>　Ｑ１３\n\\>　戒律で殺人と背教に次いで重い罪とされるのは？\n\\>　　Ａ．アナルセックス　　　　　　　　　　　　　　』":145,"\\>　　　　　　『四聖教認定・発禁本目録』\n\\>\n\\>　・カエギウス著『宗教発達史』\n\\>\n\\>　・デメオール著『金と聖職者の真実』\n\\>\n\\>　・リンブル著『歴史から見た四聖教』\n\\>\n\\>　・ヴィジオン著『楽しい邪教・入門編』\n\\>　\n\\>　・ヴィジオン著『楽しい邪教・地獄編』\n\\>　\n\\>　・ベノラ著『異世界に来てしまったようなので一発人生大逆転をねらってみた』\n\\>　\n\\>　・ユーゼル著『魔力実験論』":146,"地下階段前の兵士2":147,"EV056":148,"地下階段前の兵士1":149,"「こ、ここはいま立ち入り禁止だ！\n　近づいてはならん！」\\nw[番兵]":150,"「地下へはここから入れます。\n　手下の悪魔も徘徊しているようなので、どうか\n　お気をつけて」\\nw[番兵]":151,"EV059":152,"EV060":153,"イージー":154,"ノーマル":155},"extension":"json","dataType":"map","filename":"Map169","basename":"Map169.json","path":"data/Map169.json","relPath":"data/Map169.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":156,"percent":0},"cellInfo":[]},"data/Map170.json":{"data":[["火",""],["EV002",""],["１階",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["燭台",""],["光",""],["スパイ尼僧（閉架書庫Ev）",""],["「ここが閉架書庫です。\n　閲覧は自由にして構いませんが、塵ひとつでも持ち出す\n　ことは許されませんので」\\nw[スパイ尼僧]",""],["「はいはい、分かってるって」\\nw[\\N[1]]",""],["「また本や資料がいっぱい……。\\nw[\\N[2]]",""],["「この中から『竜の鉤爪』に関するものを見つけるのは、\n　手間ですね」\\nw[\\N[2]]",""],["「竜の鉤爪？\n　それに関連する資料を探しているので？」\\nw[スパイ尼僧]",""],["「なにか知ってるのか？」\\nw[\\N[1]]",""],["「詳しくは言えませんが、つい最近も同じ物について\n　調べていった人がいました。\\nw[スパイ尼僧]",""],["「ほら、そこの机の上に、まだ資料が出しっぱなしに\n　なっているでしょう？」\\nw[スパイ尼僧]",""],["「出したらしまえって教わらなかったのかしら？\n　あの金髪ツインテール」\\nw[スパイ尼僧]",""],["「金髪ツインテールって……\\N[3]！？」\\nw[\\N[2]]",""],["「あら、口が滑っちゃったわ」\\nw[スパイ尼僧]",""],["「感謝するぜ、スパイのねえさん。\\nw[\\N[1]]",""],["「ついでにその金髪のガキが、誰の紹介でここに入った\n　のかも口を滑らせてくれると嬉しいんだが」\\nw[\\N[1]]",""],["「さすがにそれは無理。\n　サービスはここまでですよ」\\nw[スパイ尼僧]",""],["「そりゃ残念だ。\\nw[\\N[1]]",""],["「じゃあ気を取り直して、資料を読ませてもらおうか」\\nw[\\N[1]]",""],["「資料の取り扱いには注意してください」\\nw[スパイ尼僧]",""],["「必要な資料を読んだなら、退出してください。\n　あと、ここで知ったことは、外で無闇に話さないよう」\\nw[スパイ尼僧]",""],["閉鎖扉",""],["分厚い扉により、固く閉ざされている。",""],["鉤爪資料",""],["\n\\>　　　　　　　『建国王記　～補遺～』\\<",""],["「これがその資料か」\\nw[\\N[1]]",""],["「『建国王記』って、\\C[17]建国王リジェルダの伝記\\C[0]ですよね？\\nw[\\N[2]]",""],["「ウチにもありました。\n　読みもしないくせに、父さんが箔付けのために本棚へ\n　ならべてて……」\\nw[\\N[2]]",""],["「確かにその『建国王記』だが、これは補遺――つまり\n　補足資料らしいな。\\nw[\\N[1]]",""],["「おそらく、一般に流通している『建国王記』には\n　載っていないような事柄が書かれているんだろう」\\nw[\\N[1]]",""],["「『竜の鉤爪』がこの補足資料に載っているってことは、\n　建国王となにか関係が？」\\nw[\\N[2]]",""],["「あるのかもな。\n　取り合えず読んでみよう。\\nw[\\N[1]]",""],["「頭から順に目を通す必要もないだろうから、肝心な\n　箇所をさがして――と」\\nw[\\N[1]]",""],["「あったぞ！\n　ここに『竜の鉤爪について』って項目がある」\\nw[\\N[1]]",""],["\n\\>　　　　　　　『竜の鉤爪について』\\<",""],["『建国王が崩御された後、遺品を整理していた文官が、\n　宝物目録に記載のあった\\C[17]竜の鉤爪３品\\C[0]がどこにも\n　見当たらないことに気づいた。",""],["『慌てて調べてみたところ、この竜の鉤爪なる品が\n　どういったものか知っている者はなく、紛失\n　したのかどうかさえ、定かではなかった。",""],["『名前からすると、建国王が討ち取った\\C[17]古代竜\\N[6]\\C[0]の\n　爪かとも思われるが、もしそうであれば行方の知れない\n　こと誠に残念である』",""],["「……えっ、これだけですか！？\\nw[\\N[2]]",""],["「竜の鉤爪が全部で三つあるらしいのは分かりましたけど、\n　肝心の場所が不明って……」\\nw[\\N[2]]",""],["「そう慌てるな。\n　このページに全部書いてあるとは限らんだろ」\\nw[\\N[1]]",""],["「ほらあった！\n　えーっと、なになに……」\\nw[\\N[1]]",""],["\n\\>　　　　　　『建国王の奇妙な旅について』\\<",""],["『王国歴１２年、すでに戴冠していた建国王が周囲の\n　反対を押し切り、少数の供のみ連れて四ヶ月の旅に\n　出たことは、あまり知られていない。",""],["『一説によればこのとき、建国王は獣の爪の形をした\n　奇妙な品を携えていたという。",""],["『これが宝物目録に記されていた竜の鉤爪であるか\n　どうかは定かでない。",""],["『この旅の目的は不明であるが、建国王のたどった足跡は\n　以下の三ヶ所にわずかながら確認できる。\n　すなわち――』",""],["『南東の砂漠にある\\C[17]古代遺跡\\C[0]。\n　西方雪原に建つ\\C[17]氷雪の神殿\\C[0]。\n　北海に浮かぶ\\C[17]ドゥブカ島\\C[0]』",""],["「これですよ、これ！\n　きっとこの三つの場所に、竜の鉤爪はあるんですよ！」\\nw[\\N[2]]",""],["「必ずしもそうとは限らんだろうが……しかしこれ以外に\n　手がかりは無さそうだな」\\nw[\\N[1]]",""],["「わたしは間違いないと思います！\n　この三ヶ所を調べましょう！」\\nw[\\N[2]]",""],["「そうだな。\n　どうやらメスガキには先行されてるようだし、\n　グズグズやってる暇は無いか。\\nw[\\N[1]]",""],["「よしっ、この三ヶ所へ探しに行くぞ！」\\nw[\\N[1]]",""],["「はい！」\\nw[\\N[2]]",""],["メインシナリオ\\C[17]『大聖堂の書庫』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["メインシナリオ\\C[17]『砂に埋もれし』\\C[0]を受けた！",""],["メインシナリオ\\C[17]『氷雪は阻む』\\C[0]を受けた！",""],["メインシナリオ\\C[17]『孤島を探して』\\C[0]を受けた！",""],["\\>　　 ※　新たに発生した３件のメインシナリオは　※\n\\>　　 ※　\\C[17]どの順番でクリアしても構いません。\\C[0]　　※",""],["『建国王記　～補遺～』を読みますか？",""],["読む",""],["読まない",""],["MWL_行数変更 16",""],["\\>　　　　　　　『竜の鉤爪について』\n\\>\n\\>『建国王が崩御された後、遺品を整理していた文官が、\n\\>　宝物目録に記載のあった\\C[17]竜の鉤爪３品\\C[0]がどこにも\n\\>　見当たらないことに気づいた。\n\n\\>　慌てて調べてみたところ、この竜の鉤爪なる品が\n\\>　どういったものか知っている者はなく、紛失した\n\\>　のかどうかさえ、定かではなかった。\n\n\\>　名前からすると、建国王が討ち取った\\C[17]古代竜\\N[6]\\C[0]\n\\>　の爪かとも思われるが、もしそうであれば行方の知れ\n\\>　ないこと誠に残念である』",""],["MWL_行数リセット",""],["\\>　　　　　　『建国王の奇妙な旅について』\n\\>\n\\>『王国歴１２年、すでに戴冠していた建国王が周囲の\n\\>　反対を押し切り、少数の供のみ連れて四ヶ月の旅に\n\\>　出たことは、あまり知られていない。\n\\>　一説によればこのとき、建国王は獣の爪の形をした\n\\>　奇妙な品を携えていたという。\n\\>　これが宝物目録に記されていた竜の鉤爪であるか\n\\>　どうかは定かでない。\n\\>　この旅の目的は不明であるが、建国王のたどった足跡は\n\\>　以下の三ヶ所にわずかながら確認できる。すなわち、\n\\>\n\\>　南東の砂漠にある\\C[17]古代遺跡\\C[0]。\n\\>　西方雪原に建つ\\C[17]氷雪の神殿\\C[0]。\n\\>　北海に浮かぶ\\C[17]ドゥブカ島\\C[0]』",""],["資料矢印",""],["宝蔵マップ",""],["\\>　　　　　　　『神々の宝蔵の謎』\n\\>\n\\>『王国建国よりはるか昔に栄えた古代文明については\n\\>　謎ばかりが山積みになっており、分かっていることは\n\\>　ほんの少しでしかない。\n\\>\n\\>　数多ある謎のなかでも特に興味深いのは、神々の力を\n\\>　宿した武具が造られ、それを\\C[17]『神々の宝蔵』\\C[0]なる複数\n\\>　の保管場所へ安置したという伝承だ。\n\\>\n\\>　今にいたるまで宝蔵が見つかったという話は聞かない\n\\>　が、その\\C[17]候補地と思われる封鎖された遺跡\\C[0]がいくつか\n\\>　あるので、ここに記しておく――』",""],["「神々の宝蔵か……。\n　この情報はもしかすると金になるかもしれんぞ」\\nw[\\N[1]]",""],["「ちょっと、なに考えてるんですか？\n　あんまり変な真似しないでくださいよ」\\nw[\\N[2]]",""],["「ここに書いてある宝蔵の候補地をちょっとメモるだけだ。\n　もしかしたらお宝が見つかるかもしれんからな」\\nw[\\N[1]]",""],["「そんなのあるとは思えないんですけど？\n　もしあっても、とっくに盗掘されちゃってますよ」\\nw[\\N[2]]",""],["「ロマンの無いヤツめ……。\n　とにかく地図に位置を書き込んでいくからな」\\nw[\\N[1]]",""],["「ねぇ、\\N[1]さん！\n　これって前にわたしたちが鍵を開けて入った、あの遺跡\n　のことじゃないですか！？」\\nw[\\N[2]]",""],["「ああ、間違いなさそうだな。\n　神々の宝蔵なんて大仰な名前がついてたのか。\\nw[\\N[1]]",""],["「しかし、ここに書かれてる宝蔵候補地……俺たちで\n　全部回っちゃったよな？」\\nw[\\N[1]]",""],["「びっくりですよね。\n　すべてを制覇した記念に、宝蔵の位置を地図に書き込んで\n　おきましょうか？」\\nw[\\N[2]]",""],["「よし、ここに書かれている他の宝蔵候補地を地図に\n　写していくぞ！\n　まだまだ金目のものが保管されてるかもしれん！」\\nw[\\N[1]]",""],["「盗掘する気満々ですね……」\\nw[\\N[2]]",""],["\n\\>　※　マップに\\C[17]『神々の宝蔵』の位置\\C[0]が追加されました　※",""],["本",""],["\\>　　　　　　『邪神崇拝の危険性について』\n\\>\n\\>『先住民族である猫人やエルフの伝承の中に、かつて\n\\>　ショエ＝クロシュなる邪神がこの地に現れ、これを\n\\>　崇拝する者たちが邪教団を組織して悪行を働いてい\n\\>　た――というものがある。\n\\>\n\\>　一説によるとハイエルフが中心となって多大な犠牲\n\\>　を払い、邪教団を壊滅させ邪神を封印したというが、\n\\>　それを証明するものは残されておらず――』",""],["「邪神といえば、ハリエーツで依頼を受けた冒険者の人を\n　思い出しますね」\\nw[\\N[2]]",""],["「ああ……邪神と取り引きして一気にパワーアップする\n　とかアホなこと言ってた、あの三流冒険者か。\\nw[\\N[1]]",""],["「邪神の召喚なんて出来るはずもないし、きっと今頃は\n　強くなるために地味な冒険修行でもしてるんじゃ\n　ないか？」\\nw[\\N[1]]",""],["「そ、そうですよね。\n　たぶん真面目に冒険をやってますよね……」\\nw[\\N[2]]",""],["（でも何となく嫌な予感が……。\n　ううん、気のせいだよね……）\\nw[\\N[2]]",""],["EV042",""],["EV043",""],["尼僧",""],["総司教",""],["「どうぞ、そのままお進みください」\\nw[尼僧]",""],["「よくぞ来てくださった、お二方。\n　急にお呼び立てしてしまい申し訳ない」\\nw[？？？]",""],["「なぁに、\\C[17]総司教猊下\\C[0]のお呼びとあらば、馳せ参じない\n　わけにはいかんさ」\\nw[\\N[1]]",""],["「へっ？！\n　総司教って……四聖教の一番エライ人じゃないですか！？\\nw[\\N[2]]",""],["「そんなまさか、トップが直々にわたしたちを呼ぶなんて\n　ことあるはずが……」\\nw[\\N[2]]",""],["「いいえ、お嬢さん。\n　確かに私はここで、総司教の勤めを果たさせてもらって\n　いる者だよ」\\nw[総司教]",""],["「えっ……えええぇっ！？」\\nw[\\N[2]]",""],["「大聖堂の最奥の、そのまたド真ん中にいるおっさんだぞ？\n　総司教以外に考えられるか？」\\nw[\\N[1]]",""],["「ちょっ？！\n　おっさんとか言っちゃダメでしょぉーッ！！」\\nw[\\N[2]]",""],["「はっはっはっ！　別に構わないさ。\\nw[総司教]",""],["「王都の大司教の件では、あなた方に大変お世話になった\n　ことだしね」\\nw[総司教]",""],["「そういやあの後、大司教はどうなったんだ？\n　失脚したとは聞いたが」\\nw[\\N[1]]",""],["「言い訳ばかりで改心する様子もなかったのでね、\n　破門のうえで永久追放としたよ」\\nw[総司教]",""],["「こ、こう言ってはなんですけど、ちゃんと処分が\n　下されていて安心しました……」\\nw[\\N[2]]",""],["「で、まさかその礼を言うためだけに、呼び出したわけ\n　じゃないんだろ？」\\nw[\\N[1]]",""],["「もちろんだとも。\n　実は再び、あなたたちに頼みたいことが出来てね。\\nw[総司教]",""],["「\\C[17]悪竜退治の英雄\\C[0]にしか、お願いできないことなのだ」\\nw[総司教]",""],["「なっ、なんでそのことを！？」\\nw[\\N[2]]",""],["「私はね、新女王陛下の相談役でもあるんだ。\\nw[総司教]",""],["「悪竜討伐の裏事情については、だいたい聞かせて\n　もらったよ」\\nw[総司教]",""],["「ハァ……ったく！\n　あの女王様、存外口が軽いみたいだな」\\nw[\\N[1]]",""],["「どうかチェリア様を責めないでやって欲しい。\n　それに四聖教の中でこのことを知っているのは私一人\n　だけだ。\\nw[総司教]",""],["「これ以上話が広がることは絶対にないと、約束させて\n　もらうよ」\\nw[総司教]",""],["「そう願うぜ。\n　……で、猊下は俺たちになにをさせたいんだ？」\\nw[\\N[1]]",""],["「……\\C[17]悪魔\\C[0]を、倒して欲しいのだ」\\nw[総司教]",""],["「悪魔？　それは普段、わたしたちが捕縛して奴隷に\n　してるような、あの――」\\nw[\\N[2]]",""],["「いいや違う！　違うのだ！\n　そのような悪魔であれば、頭を悩ませることも無かった\n　だろうが……」\\nw[総司教]",""],["「強いのか？」\\nw[\\N[1]]",""],["「う、うむ……強い。\n　そして、わけが分からんのだ……。\\nw[総司教]",""],["「その悪魔は突如この大聖堂の地下に現れたかと思うと、\n　\\C[17]“親善大使”\\C[0]を名乗って、聖職者や警備兵２０人以上を\n　虐殺したのだ」\\nw[総司教]",""],["「し、親善大使……？　それで虐殺……？」\\nw[\\N[2]]",""],["「ホントにわけが分からんな……」\\nw[\\N[1]]",""],["「今のところ地下への出入口を塞いで、悪魔が地上へ出て\n　こないよう閉じ込めてはいるものの……果たしていつまで\n　もつものか……」\\nw[総司教]",""],["「それで悪魔が地上で大暴れする前に、潜って倒して\n　こいと？」\\nw[\\N[1]]",""],["「すでに腕利きの兵たちを地下に送り込んだのだが、\n　誰一人戻っては来なかった。\\nw[総司教]",""],["「もはや望みを託せるのは、あなたたちだけなのだ！」\\nw[総司教]",""],["「ど、どうします、\\N[1]さん？\n　なんか凄いこと頼まれちゃってますけど？」\\nw[\\N[2]]",""],["「四聖教に恩が売れるとはいえ……出来れば辞退したい\n　けどなぁ……」\\nw[\\N[1]]",""],["「もし悪魔を倒してくれたなら、謝礼として\\C[17]３０万Ｇ\\C[0]を\n　お渡ししよう！」\\nw[総司教]",""],["「さ、３０万Ｇ！？」\\nw[\\N[2]]",""],["「金の問題じゃないんだがな……」\\nw[\\N[1]]",""],["「ならば\\C[17]秘蔵の魔法道具\\C[0]も進呈する！\n　だからどうか頼まれて欲しい！」\\nw[総司教]",""],["「うーむ……どのみち悪魔に王国を蹂躙されでもしたら、\n　俺の商売だって危うくなるか……。\\nw[\\N[1]]",""],["「……しょうがない、猊下直々のお願いだ。\n　やれるだけやってみるか」\\nw[\\N[1]]",""],["「そ、そうか！　非常に助かる！\n　では準備が出来次第、地下へ向かってくれ！」\\nw[総司教]",""],["「あ～あ……やっぱりこうなるんですね……」\\nw[\\N[2]]",""],["\\>\\C[17]　※　大聖堂一階の東側にある階段から、地下へ入って　※\n\\>　※　親善大使を名乗る悪魔を倒そう！！　　　　　　　※",""],["「ありがとう！　心から感謝するよ！\n　あなたたちは悪竜討伐につづき、二度目の王国の危機を\n　救ったのだ！\\nw[総司教]",""],["「二度目の王国の危機……ね」\\nw[\\N[1]]",""],["「\\N[1]さん……？」\\nw[\\N[2]]",""],["「本当はただ、今回の騒動が表沙汰になるのを、防ぎた\n　かっただけなんじゃないか？」\\nw[\\N[1]]",""],["「…………」\\nw[総司教]",""],["「四聖教の総本山に強大な悪魔が出現したなんて話が\n　広がれば、犠牲を払って倒せたとしても権威はガタ\n　落ちだ。\\nw[\\N[1]]",""],["「大司教の野郎もそれが分かってたから、ここに忍び込んで\n　悪魔の召喚を行ったんじゃないか？」\\nw[\\N[1]]",""],["「確かに、地下の悪魔の討伐は秘密裏に素早く\n　行わなければならなかった……。\\nw[総司教]",""],["「しかし体面を保つためだけに、あなたたちを利用した\n　わけでは――」\\nw[総司教]",""],["「……フフン、まあいいさ。\n　これで互いに公言できない秘密を知ったってことで、\n　おあいこだ」\\nw[\\N[1]]",""],["「なにもそんな、脅迫めいたことまでしなくっても……」\\nw[\\N[2]]",""],["「いいや、これで丁度いいくらいだ。\\nw[\\N[1]]",""],["「出生の秘密を盾に、またお願いと称する命令を聞かされる\n　のはゴメンだからな」\\nw[\\N[1]]",""],["「それは誤解だ。\n　決してそのような意図は――」\\nw[総司教]",""],["「誤解ならそれに越したことはないな。\n　それじゃ俺たちは報酬を貰って、帰らせてもらうぜ」\\nw[\\N[1]]",""],["「あなたとはもっとじっくり話をしたいものだが……\n　仕方ない。こちらが約束のお礼だ」\\nw[総司教]",""],["報酬として\\C[17]３０万Ｇ\\C[0]と\\C[17]「\\in[41]」\\C[0]をもらった！",""],["「じゃあな、大司教猊下」\\nw[\\N[1]]",""],["「あわよくば、これを契機に彼を四聖教へ引き込み\n　たかったが……さすがに一筋縄ではいかんか。\\nw[総司教]",""],["「しかし悪竜の使役者が、他人に取り込まれるような\n　間抜けな人間であっても、それはそれで困るというもの。\\nw[総司教]",""],["「ふむ……あるいは、これで良かったのかもしれんな」\\nw[総司教]",""],["ユマ",""],["総司教2",""],["「あなたたちに頼らざるを得ない我々を、許してほしい。\n　だがそれほどに地下の悪魔は常軌を逸した存在なのだ。\\nw[総司教]",""],["「地下へは一階東側の階段から降りられるから、どうか\n　一刻も早く彼奴の退治を……！」\\nw[総司教]",""],["「もし困り事があれば、いつでも四聖教を頼って構わんよ。\n　なにせあなたたちは、多大な恩があるのだから」\\nw[総司教]",""],["番兵",""],["「この先は総司教猊下の私室です。\n　どうかご無礼のないように」\\nw[警備兵]",""],["「自分の同僚も地下の悪魔に殺されてしまいました……。\n　お願いです……仇を！」\\nw[警備兵]",""],["「地下の悪魔を倒していただき、ありがとうございます！\n　これで殺された同僚の無念も晴れるでしょう」\\nw[警備兵]",""]],"context":[["Map170/events/1/name"],["Map170/events/2/name"],["Map170/events/2/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map170/events/3/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map170/events/4/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map170/events/5/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map170/events/6/pages/0/list/2/Control Variables/var:1076-1076/