["",0,0,2]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":32,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":42,"headerParam":["",0,0,2]}],[{"headerIndex":46,"headerParam":["",0,0,2]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],null,null,[{"attachment":"scriptCommand/16944098102648020.js","start":0,"end":13,"leftHand":{"type":"","context":[]}}],[{"attachment":"scriptCommand/16944098102643720.js","start":0,"end":5,"leftHand":{"type":"","context":[]}}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":11,"headerParam":["依頼条件達成"]}],[{"headerIndex":31,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":70,"headerParam":["↓プレーヤー位置強制中央"]}],null,[{"headerIndex":78,"headerParam":["依頼条件未達成"]}],[{"headerIndex":79,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":10,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[{"headerIndex":18,"headerParam":["",0,0,2]}],[{"headerIndex":22,"headerParam":["",0,0,2]}],[{"headerIndex":26,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":69,"headerParam":["",0,0,2]}],[{"headerIndex":77,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":96,"headerParam":["",0,0,2]}],[{"headerIndex":99,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}]],"indexIds":{"火":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"EV006":5,"EV007":6,"燭台":7,"光":8,"娼館従業員":9,"娼館の客（依頼22~25)":10,"依頼を出している場合":11,"依頼フキダシ":12,"娼館支配人（依頼20）":13,"奴隷市（フキダシ）":14,"薄衣購入フキダシ":15,"窃盗用下着4":16,"<TE:119>":17,"娼婦":18,"「\\N[6]を見て失神したお客さん、あれから一度も\n　来ないのよね。まさか勃たなくなっちゃったのかな？」\\nw[娼婦]":19,"「ヤってる最中に、客があの赤い竜を見ちゃってさ、\n　おっ勃てたまま失神しちゃったのよ」\\nw[娼婦]":20,"「アナル好きなお客様は多いけど、アナルプレイＯＫな\n　女の子はあまりいないのよね」\\nw[娼婦]":21,"「ようやく副都も落ち着いてきたわね。\n　まだちょっと客足の戻りが鈍いけれど」\\nw[娼婦]":22,"「この街は安全だって思ってたから、モンスターの\n　侵入にはビックリしちゃった」\\nw[娼婦]":23,"「尻尾を強くにぎってくるお客さんはキライ！」\\nw[娼婦]":24,"「３Ｐが大好きだった彼は、もうここへ来ることは\n　ないのね……」\\nw[娼婦]":25,"「３Ｐするのは構わないけど、実際問題として\n　アッチの方はもつのかしら？」\\nw[娼婦]":26,"「常連の３Ｐおじさん、モンスターにオチンチンを\n　潰されちゃったんだって」\\nw[娼婦]":27,"「お金さえ払ってくれるなら、わたしは３人でも４人でも\n　構わないけど？」\\nw[娼婦]":28,"客1":29,"「私くらいになると、女を抱くにしても１人じゃ満足\n　できなくてな。\n　今日は３Ｐと洒落こもうじゃないか！」\\nw[客]":30,"ドア":31,"部屋の中でお楽しみ中のようだ。":32,"客2":33,"個別依頼24":34,"常連客の注文Ｂ":35,"「色白な娘が大好きな常連のお客さんがいるんだけど、\n　ウチに今いる女の子の中で一番色白の娘でも、満足して\n　くれないの。\\nw[娼婦]":36,"「支配人は新人を雇ってもいいって言ってるから、\n　\\C[17]色白の女の子\\C[0]を連れてきてくれる？」\\nw[娼婦]":37,"「ハイエルフなんかはみんな色白だが、それでいいか？」\\nw[\\N[1]]":38,"「あー……エルフはダメ。\n　お客さん、昔エルフに襲われたことがあるとかで\n　エルフを毛嫌いしてたから。\\nw[娼婦]":39,"「\\C[17]人間の娘\\C[0]でお願いできる？\n　できればお客さんの好みに合わせて、\\C[17]おっぱいは普通の\n　サイズ\\C[0]で」\\nw[娼婦]":40,"「面倒だが、まあどうにかなるだろ。\n　それでいくらまで出せる？」\\nw[\\N[1]]":41,"「んーっと、\\C[17]５０００Ｇ\\C[0]と、あとこの価値があるんだか\n　分からない\\C[17]変な玉\\C[0]もつけられるわよ」\\nw[娼婦]":42,"個別依頼『常連客の注文Ｂ』を受けますか？":43,"受ける":44,"受けない":45,"ダークエルフの森・2層":46,"風の塔":47,"個別依頼\\C[17]『常連客の注文Ｂ』\\C[0]を受けた！":48,"\\C[17]『\\in[107]』\\C[0]を依頼者に渡しますか？":49,"渡す":50,"渡さない":51,"依頼条件達成":52,"「注文に合う人間の奴隷を仕入れてきた。\n　これでいいか？」\\nw[\\N[1]]":53,"「うん、とっても白くて綺麗な肌ね。\n　これならあのお客さん、喜ぶと思うわ」\\nw[娼婦]":54,"個別依頼\\C[17]『常連客の注文Ｂ』\\C[0]を達成した！":55,"↓プレーヤー位置強制中央":56,"SFC_ENABLE_RESERVE":57,"依頼条件未達成":58,"「お客さんに振り回されるのは嫌だけど、大切な常連さん\n　だから仕方ないの。\n　色白の娘、見つけてきてね」\\nw[娼婦]":59,"依頼マーク":60,"セックス中":61,"\n\\>　　　　　　　　～　娼館の一室にて　～":62,"「おおっ、白くて綺麗な肌だねぇ。\n　うんうん、実に理想的だよ」\\nw[男性客]":63,"「ありがと\\I[29]\n　お手入れにはすごく気をつかってるの」\\nw[奴隷娼婦]":64,"「ところで奴隷娼婦ってことは、キミも何か罪を犯した\n　のかな？」\\nw[男性客]":65,"「え、ええ……まあその……ちょっと……。\n　野盗のお頭の愛人をやってて、一緒に追剥もしたり……」\\nw[奴隷娼婦]":66,"「ほほぅ！　悪い子だ！\n　これは私の肉棒でたっぷり“おしおき”してやらんとな！」\\nw[男性客]":67,"「いやーん、こわーい\\I[29]」\\nw[奴隷娼婦]":68,"「さあ、ベッドの上で刑を執行してやる！\n　んへへへっ……」\\nw[男性客]":69,"「こんなに気持ちよくイッたの、初めてぇ……\\I[29]」\\nw[奴隷娼婦]":70,"「やれやれ、結局改心してくれなかったね。\n　これは今後もおしおきを続ける必要がありそうだ」\\nw[男性客]":71,"「つまりまた指名してくれるってこと？\n　やったぁ\\I[29]」\\nw[奴隷娼婦]":72,"↓プレーヤー位置強制中央解除":73,"SFC_DISABLE_RESERVE":74,"個別依頼『常連客の注文Ｂ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[50]１個\\C[0]を入手した！":75,"\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！":76,"EV039":77,"EV040":78,"「さっき、自称『悪竜スレイヤー』の客が来てたわ。\n　悪竜を倒した冒険者が正体不明だからって、あんな\n　見え透いた嘘つくなんてね」\\nw[娼婦]":79,"「さっきの客、モンスターを追い返したって自慢話を\n　延々続けて……そのくせアッチは１０秒で終わりよ？」\\nw[娼婦]":80,"「さっきまで時間延長でずっと突かれてて……\n　もう足腰が立たないわ……」\\nw[娼婦]":81,"EV043":82,"武器商ギルド秘密文書（横）":83,"<TE:75>":84},"extension":"json","dataType":"map","filename":"Map162","basename":"Map162.json","path":"data/Map162.json","relPath":"data/Map162.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":85,"percent":0},"cellInfo":[]},"data/Map163.json":{"data":[["光",""],["EV004",""],["EV005",""],["EV006",""],["燭台",""],["EV021",""]],"context":[["Map163/events/1/name","Map163/events/2/name","Map163/events/3/name","Map163/events/14/name","Map163/events/15/name","Map163/events/16/name","Map163/events/17/name"],["Map163/events/4/name"],["Map163/events/5/name"],["Map163/events/6/name"],["Map163/events/7/name","Map163/events/8/name","Map163/events/9/name","Map163/events/10/name","Map163/events/11/name","Map163/events/12/name","Map163/events/13/name"],["Map163/events/21/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"光":0,"EV004":1,"EV005":2,"EV006":3,"燭台":4,"EV021":5},"extension":"json","dataType":"map","filename":"Map163","basename":"Map163.json","path":"data/Map163.json","relPath":"data/Map163.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map164.json":{"data":[["EV001",""],["EV002",""],["家具職人",""],["奴隷1",""],["「奴隷としてあの人に買われたんだけど、この前\n　プロポーズされちゃったの。\n　このまま幸せになっちゃっていいかしら？」\\nw[奴隷]",""],["三角木馬",""]],"context":[["Map164/events/1/name"],["Map164/events/2/name"],["Map164/events/3/name"],["Map164/events/4/name"],["Map164/events/4/pages/0/list/0/message/noPicture/bottom"],["Map164/events/5/name","Map164/events/6/name","Map164/events/7/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,["gold"]],"parameters":[null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"家具職人":2,"奴隷1":3,"「奴隷としてあの人に買われたんだけど、この前\n　プロポーズされちゃったの。\n　このまま幸せになっちゃっていいかしら？」\\nw[奴隷]":4,"三角木馬":5},"extension":"json","dataType":"map","filename":"Map164","basename":"Map164.json","path":"data/Map164.json","relPath":"data/Map164.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map165.json":{"data":[["EV001",""],["EV002",""],["家具職人",""],["三角木馬",""]],"context":[["Map165/events/1/name"],["Map165/events/2/name"],["Map165/events/3/name"],["Map165/events/4/name","Map165/events/5/name","Map165/events/6/name","Map165/events/7/name"]],"tags":[["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"EV001":0,"EV002":1,"家具職人":2,"三角木馬":3},"extension":"json","dataType":"map","filename":"Map165","basename":"Map165.json","path":"data/Map165.json","relPath":"data/Map165.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":4,"percent":0},"cellInfo":[]},"data/Map166.json":{"data":[["火",""],["EV002",""],["EV003",""],["光",""],["家具職人",""],["三角木馬",""]],"context":[["Map166/events/1/name"],["Map166/events/2/name"],["Map166/events/3/name"],["Map166/events/4/name"],["Map166/events/5/name"],["Map166/events/6/name","Map166/events/7/name","Map166/events/8/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"火":0,"EV002":1,"EV003":2,"光":3,"家具職人":4,"三角木馬":5},"extension":"json","dataType":"map","filename":"Map166","basename":"Map166.json","path":"data/Map166.json","relPath":"data/Map166.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map167.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["燭台",""],["EV020",""],["EV021",""],["EV022",""],["光",""],["受付嬢",""],["「ようこそ、四聖教大聖堂へ。\n　分からないことがあれば、なんなりとご相談ください」\\nw[尼僧]",""],["大聖堂とは？",""],["四聖神とは？",""],["総司教とは？",""],["お姉さん、お茶しない？",""],["聞くことはない",""],["「大聖堂は、わたしたち四聖教の総本山です。\n　信仰の中心地であり、総司教猊下がおわす場所でも\n　あります」\\nw[尼僧]",""],["「四聖教で奉じる神々、それが四聖神です。\n　火の神、水の神、風の神、地の神の四柱が主祭神と\n　なっております」\\nw[尼僧]",""],["「総司教猊下は、四聖教の最高位聖職者です。\n　普段はこの大聖堂の御座所におられ、月に一度の大礼拝\n　のときには、一般信徒の前にもお顔をみせられます」\\nw[尼僧]",""],["「すみませんが、そういったお誘いはお断りしております。\n　大聖堂に務める者として、この身は清くあらねば\n　ならないので」\\nw[尼僧]",""],["「ここにある書庫の中に、閲覧したい資料があるんだ。\n　どうしたら見せてもらえる？」\\nw[\\N[1]]",""],["「一般書架のご利用でしたら、\\C[17]１００Ｇ\\C[0]の寄付でお受け\n　しております」\\nw[尼僧]",""],["「意外と簡単に見せてもらえるんですね」\\nw[\\N[2]]",""],["書庫利用のため\\C[17]１００Ｇ\\C[0]を支払いますか？",""],["払う",""],["払わない",""],["１００Ｇを寄付した。",""],["「ありがとうございます。\n　それでは係の者に書庫までご案内させますので、\n　お待ちください」\\nw[尼僧]",""],["↓隊列歩行ON",""],["寄付するには所持金が足りない。",""],["「ようこそ、\\N[1]様。\n　ただいまご案内いたしますね」\\nw[尼僧]",""],["トークマーク",""],["EV039",""],["EV040",""],["EV041",""],["EV042",""],["EV043",""],["EV044",""],["EV045",""],["EV046",""],["巡礼者",""],["「広くて迷ってしまいそう。\n　それも楽しいかもしれないけど」\\nw[巡礼者]",""],["「大聖堂をこうして見られて、ボクは感激で\n　泣いてしまいそうですよ」\\nw[巡礼者]",""],["「喜捨をしてここに願い事を書くと、あとで司教様が\n　ご祈祷してくださるそうだ」\\nw[巡礼者]",""],["「ええと……『夫の浮気癖が治りますように』と」\\nw[巡礼者]",""],["「とてもためになるお話だわ」\\nw[巡礼者]",""],["「キミ、静かに座って司教様のお話を聞いたらどうだ？」\\nw[巡礼者]",""],["「子供には退屈な話かもしれないわね」\\nw[巡礼者]",""],["「……ねむい」\\nw[女の子]",""],["「信仰の力で\\N[6]が退治されたようなこと言ってるけど、\n　絶対ウソだよね」\\nw[観光客]",""],["「建物はすごいけど、話はイマイチだね。\n　そろそろ帰ろうかな」\\nw[観光客]",""],["「悪竜を退治した謎の冒険者は、四聖神がお遣わしに\n　なった使徒だったのかもしれないわ」\\nw[巡礼者]",""],["「やっぱり日々を慎ましく暮らすことが大切なのね」\\nw[巡礼者]",""],["「帰りに聖典を買っていこうかしら。\n　一冊持ってるけど」\\nw[巡礼者]",""],["「誰だか知らんが、悪竜を倒した者は大きな功徳を積んだ\n　ものだな。きっと死後は四聖神の御許へ行けるだろう」\\nw[巡礼者]",""],["「昔の私は人を人とも思わない悪人だった。\n　しかし今はそのことを悔いて、こうして巡礼の旅を\n　行っているんだ」\\nw[巡礼者]",""],["「わたしたちが使う魔法は、四聖教の神々の力に\n　よるもの――ってことらしいけど、別に信仰して\n　なくても使えるのよね」\\nw[冒険者]",""],["「ううむ……神の教えとは難しいな。\n　なぜ敵を無闇にブッ殺してはならないんだ？」\\nw[冒険者]",""],["歴史学者",""],["「聖職者たちは否定するが、四聖教の教義の半分以上は\n　猫人たちの土着宗教から来ているのだよ」\\nw[歴史学者]",""],["「あそこの尼さん、かわいいと思わないか？」\\nw[巡礼者]",""],["「オレは無学だが、信仰の篤さでは村一番だと自負して\n　るんだ」\\nw[巡礼者]",""],["尼僧1",""],["「司教の法話中です。どうかお静かに」\\nw[尼僧]",""],["尼僧2",""],["司祭（法話）",""],["「つまり悪竜を倒すには四聖神のお力にすがるしかない\n　わけで、であるからには、謎の冒険者は間違いなく\n　四聖教の忠実な信徒であると考えられ――」\\nw[司教]",""],["「法話中なので、壇上に上がらないでください」\\nw[司教]",""],["僧侶",""],["「司教様、今日はのどの調子が良さそうだな」\\nw[僧侶]",""],["「知っとるか？\n　ここで作られとる神酒は、量が出回らないんで\n　幻の酒とも言われとるんじゃ」\\nw[巡礼者]",""],["尼僧3",""],["「こちらは裏口になりますので、受付でしたら\n　建物の反対側へどうぞ」\\nw[尼僧]",""],["尼僧（物販）",""],["物販マーク",""],["「聖典って、ここで買えるのかしら？」\\nw[巡礼者]",""]],"context":[["Map167/events/1/name"],["Map167/events/2/name"],["Map167/events/3/name"],["Map167/events/4/name"],["Map167/events/5/name"],["Map167/events/6/name","Map167/events/7/name","Map167/events/8/name","Map167/events/9/name","Map167/events/10/name","Map167/events/11/name","Map167/events/12/name","Map167/events/13/name","Map167/events/14/name","Map167/events/15/name","Map167/events/16/name","Map167/events/17/name","Map167/events/18/name","Map167/events/19/name"],["Map167/events/20/name"],["Map167/events/21/name"],["Map167/events/22/name"],["Map167/events/23/name","Map167/events/24/name","Map167/events/25/name","Map167/events/26/name","Map167/events/27/name","Map167/events/28/name","Map167/events/29/name","Map167/events/30/name","Map167/events/31/name","Map167/events/32/name","Map167/events/33/name","Map167/events/34/name","Map167/events/35/name","Map167/events/36/name"],["Map167/events/37/name"],["Map167/events/37/pages/0/list/1/message/noPicture/bottom","Map167/events/37/pages/1/list/0/message/noPicture/bottom","Map167/events/37/pages/2/list/1/message/noPicture/bottom","Map167/events/37/pa