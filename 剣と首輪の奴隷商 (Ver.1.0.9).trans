derIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":5,"headerParam":["",0,0,2]},{"headerIndex":5,"headerParam":["",0,0,2]},{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]},{"headerIndex":13,"headerParam":["",0,0,2]},{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]},{"headerIndex":17,"headerParam":["",0,0,2]},{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]},{"headerIndex":23,"headerParam":["",0,0,2]},{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["",0,0,2]},{"headerIndex":27,"headerParam":["",0,0,2]},{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]},{"headerIndex":30,"headerParam":["",0,0,2]},{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,1,1]},{"headerIndex":2,"headerParam":["",0,1,1]}],[{"headerIndex":5,"headerParam":["",0,1,1]},{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":32,"headerParam":["",0,0,2]}],[{"headerIndex":37,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],null,null,null,null,[{"attachment":"scriptCommand/16944098117189056.js","start":0,"end":10,"leftHand":{"type":"","context":[]}}]],"indexIds":{"EV001":0,"脱出用魔法陣":1,"ダンジョンの外へ脱出しますか？":2,"脱出する":3,"脱出しない":4,"createFilter 1 twist 2":5,"setFilter 1 408 312 416 0":6,"moveFilter 1 408 312 816 13 120":7,"eraseFilter 1":8,"ユマ":9,"EXIT":10,"発掘現場通行Ev":11,"「なんだキミたちは？」\\nw[護衛の冒険者]":12,"「この遺跡で発掘作業をしてるっていう伝承学者の先生に\n　会いに来たんだ。知っているか？」\\nw[\\N[1]]":13,"「先生ならこの先におられるが、要件はなんだ？」\\nw[護衛の冒険者]":14,"「わたしたち、先生が前に興味を持っていらっしゃった\n　竜の鉤爪を所持しているんです。\\nw[\\N[2]]":15,"「それについてお話をうかがいたくて」\\nw[\\N[2]]":16,"「その鉤爪のことなら、以前先生が話していたな。\n　現物を見られるとなれば、きっと喜ぶだろう。\\nw[護衛の冒険者]":17,"「分かった、通っていいぞ」\\nw[護衛の冒険者]":18,"「ありがとうございます」\\nw[\\N[2]]":19,"粘土板の解読を待たなければ。":20,"護衛冒険者":21,"「発掘の護衛は危険な仕事だが、そのぶん報酬はいいぞ」\\nw[護衛の冒険者Ａ]":22,"「すまん……俺としたことが、賊の一撃で昏倒して\n　しまうとは……」\\nw[護衛の冒険者Ａ]":23,"「結局あの暗殺者は、誰が何のために寄越したんだろう？\n　先生はなにか知っているようだけど……」\\nw[護衛の冒険者Ａ]":24,"労働奴隷":25,"「モンスターだらけの遺跡で穴掘りなんて、危険すぎて\n　シャレになんねーぜ……」\\nw[人間奴隷]":26,"「さっきのあれ、盗賊か？\n　風みたいにビューッと走って行って、すごかったな」\\nw[人間奴隷]":27,"護衛冒険者2":28,"「あの先生、基本的にケチだけど、あたしらへの報酬は\n　しっかり払ってくれるのよ」\\nw[護衛の冒険者Ｂ]":29,"「ケチらずに高い防具をつけてたおかげで、致命傷には\n　ならなかったよ……でも防具はボロボロ……」\\nw[護衛の冒険者Ｂ]":30,"「二度と暗殺者なんかに遅れをとらないよう、これまで\n　以上にしっかり警備しないと」\\nw[護衛の冒険者Ｂ]":31,"「窃盗１００件くらいで奴隷に落とされるなんて、\n　信じらんねぇ！」\\nw[猫人奴隷]":32,"「モンスターやら盗賊やら、くそっ、やってらんねぇぜ！」\\nw[猫人奴隷]":33,"「アナホリ……モウアキタ……」\\nw[鬼奴隷]":34,"「オレモシヌナラ、タタカッテシニタイ……」\\nw[鬼奴隷]":35,"伝承学者（会話Ev）":36,"↓奴隷譲渡処理":37,"肉体労働用の奴隷":38,"↑ここまで":39,"奴隷不足のとき":40,"\\C[18]※　注意　※\\C[0]\n　伝承学者に手土産として渡す\\C[17]奴隷の数が不足\\C[0]しています。":41,"必要な奴隷を連れてこないと……。":42,"奴隷OKのとき":43,"「あんたが伝承学者の先生か？」\\nw[\\N[1]]":44,"「なんだね、キミたちは？\n　借金取りなら間に合ってるよ」\\nw[伝承学者]":45,"「い、いえ。\n　わたしたちは竜の鉤爪について、先生から話を――」\\nw[\\N[2]]":46,"「竜の鉤爪だって！？\n　もしかして、何か新しい発見でもあったのか！？」\\nw[伝承学者]":47,"「発見も何も、ここに現物を持ってきてあるぜ」\\nw[\\N[1]]":48,"「なんだと！？　見せてみろ！」\\nw[伝承学者]":49,"「こ、これは本物なのか……？\n　ううむ……」\\nw[伝承学者]":50,"「先生、竜の鉤爪とは何なんでしょうか？\\nw[\\N[2]]":51,"「大聖堂の閉架書庫で見た資料には、建国王が倒した\n　古代竜アルテトの爪かもしれないと、書いて\n　ありましたけど……」\\nw[\\N[2]]":52,"「そうか、キミたちは大聖堂の資料を見て、これを探し\n　出したのか」\\nw[伝承学者]":53,"「興味は無かったが、色々あってやむなく集めたんだ」\\nw[\\N[1]]":54,"「ふぅむ……これはアルテトの爪ではないな。\\nw[伝承学者]":55,"「成竜だったアルテトの爪にしては小さすぎる」\\nw[伝承学者]":56,"「え、そうなんですか？\\nw[\\N[2]]":57,"「しかしながら、古代竜の爪ではあるようだ。\n　おそらくは幼竜のものだろう」\\nw[伝承学者]":58,"「実は竜の鉤爪と一緒に、こんな粘土板も見つけたんだ。\\nw[\\N[1]]":59,"「専門家のあんたになら解読できるんじゃないかと\n　思って、わざわざここまで来たんだが」\\nw[\\N[1]]":60,"「興味深いな。\n　どれどれ……これは古代文字か。\\nw[伝承学者]":61,"「確かにこの種類の文字なら、多少時間はかかるが\n　翻訳は可能だ」\\nw[伝承学者]":62,"「本当ですか！？　じゃあこれの解読を――」\\nw[\\N[2]]":63,"「いや、いますぐに解読するのは無理だぞ？\n　なにせ私はここの発掘調査の真っ最中だから。\\nw[伝承学者]":64,"「発掘というのは時間と金がかかるんだ。\n　別のことに労力を割いている暇はない。\\nw[伝承学者]":65,"「もっとも……キミたちの出方次第では、\n　考えてやらないでもないが？（チラリ）」\\nw[伝承学者]":66,"「そうくると思って、肉体労働用の奴隷を３人連れて\n　きたぞ。\\nw[\\N[1]]":67,"「奴隷購入の費用が浮いて、発掘スピードも上がる。\n　これでどうだ？」\\nw[\\N[1]]":68,"「すぐに解読作業を始めよう」\\nw[伝承学者]":69,"（現金な人だなぁ……）\\nw[\\N[2]]":70,"伝承学者に\\C[17]奴隷３人\\C[0]と\\C[17]古代の粘土板\\C[0]を渡した。":71,"「解読が終わるまで、その辺りを見学しているといい。\\nw[伝承学者]":72,"「ただし、そこの\\C[17]魔法陣\\C[0]の中には入らないでくれ。\\nw[伝承学者]":73,"「まだ安全が確認できていないんだ。\n　なにが起こるか分からないのでね」\\nw[伝承学者]":74,"「じゃあお言葉に甘えて、発掘の見学といくか」\\nw[\\N[1]]":75,"発掘現場を見て回ろう！":76,"「今のは……」\\nw[\\N[1]]":77,"「オイッ！　魔法陣に入るなって言っただろうが！\n　バカかお前は！？」\\nw[伝承学者]":78,"「ん？　あれ？　いつの間に……？」\\nw[\\N[1]]":79,"「だ、大丈夫ですか、\\N[1]さん？\\nw[\\N[2]]":80,"「光が見えるとか言ったり、急に黙って魔法陣に入ったり、\n　さっきから様子が変ですよ？」\\nw[\\N[2]]":81,"「あー……大丈夫だ、問題ない。\n　ちょっと足元がフラついて、中に入っちまっただけだ」\\nw[\\N[1]]":82,"「まったく、気をつけてくれよ！\n　爆発でもしてたら、私たち全員あの世行きだったぞ！」\\nw[伝承学者]":83,"「悪かったよ、先生。\n　まあ何も起きなかったんだから、大目に見てくれ」\\nw[\\N[1]]":84,"「いい加減な男だな、キミは！」\\nw[伝承学者]":85,"「ところでちょっと聞きたいんだが、この遺跡は建国王と\n　なにか関係あったりするのか？」\\nw[\\N[1]]":86,"「ん？　うむ、遺跡自体は古代人の手によるものだが、\n　この空間は後から建国王が掘らせた可能性が高い。\\nw[伝承学者]":87,"「ただ、用途については不明だ。\n　その魔法陣が関係しているのだろうが……」\\nw[伝承学者]":88,"「なるほど……」\\nw[\\N[1]]":89,"「それより解読は終わったから、結果を読んだらさっさと\n　帰ってくれないか？」\\nw[伝承学者]":90,"「なに？　もう終わったのか？」\\nw[\\N[1]]":91,"「解読された内容は、これだそうです」\\nw[\\N[2]]":92,"『無垢なる幼き竜の爪三つより作りし魔法の呪物。\n　同種を縛り、封じるためにこれを生み出せり。":93,"『霊気宿る地にて力を集むるならば、\n　竜の使役もまた能うなり』":94,"「つまり竜の鉤爪とは、古代人が\\C[17]竜を封じたり操るため\\C[0]に\n　生み出したマジックアイテムってわけだ。\\nw[伝承学者]":95,"「建国王がこれを所持していたのなら、きっと\n　古代竜アルテトの討伐時に使ったのだろう」\\nw[伝承学者]":96,"「じゃあ、竜の鉤爪でアルテトの力を封じて、\n　そこを仕留めたんですか？」\\nw[\\N[2]]":97,"「たぶんそうだろうね。\\nw[伝承学者]":98,"「しかし古代竜が絶滅している現代では、歴史的な価値\n　こそあれ、マジックアイテムとしては無用の長物だな」\\nw[伝承学者]":99,"「いや、違う。\n　アルテトは封じられはしたが――」\\nw[\\N[1]]":100,"「\\N[1]さん？」\\nw[\\N[2]]":101,"「おい先生、大事な質問がある。\n　答えてくれ」\\nw[\\N[1]]":102,"「なんだ一体？　急に怖い顔をして」\\nw[伝承学者]":103,"「この竜の鉤爪、ブッ壊せば機能は失われるのか？」\\nw[\\N[1]]":104,"「そりゃ壊せば使えなくなる。当然だ」\\nw[伝承学者]":105,"「じゃあ、封印が機能し続けていた場合はどうだ？」\\nw[\\N[1]]":106,"「そりゃあ……封印が解けるんじゃないか？」\\nw[伝承学者]":107,"「かぁーっ！　やっぱりか！\n　となると、迂闊に壊して捨てることもできねぇ！」\\nw[\\N[1]]":108,"「歴史的な遺物を捨てるだと！？\n　ふざけたことを抜かすな！」\\nw[伝承学者]":109,"「さっきから何なんですか？\n　普段とは違った意味で変ですよ？」\\nw[\\N[2]]":110,"「うるさい、色々あるんだよ！\n　それと俺は平均的な成年男子で、どこも変じゃない」\\nw[\\N[1]]":111,"「キミは一度、平均の意味を辞書で引いてみるといい」\\nw[伝承学者]":112,"「\\N[2]、すぐに王都の貧民街へ戻るぞ。\n　あそこなら身をひそめるのに丁度いいからな」\\nw[\\N[1]]":113,"「はい？」\\nw[\\N[2]]":114,"「それと学者先生、あんたは竜の鉤爪や粘土板のことを\n　口外するな。命に関わるかもしれん」\\nw[伝承学者]":115,"「な、なんだと？　冗談を言うな」\\nw[伝承学者]":116,"「いいから信じろ。\n　今日会ったばかりのヤツでも、死なれたら寝覚めが\n　悪くなる」\\nw[\\N[1]]":117,"「わけが分かりませんよ。\n　なにか事情があるなら、ちゃんと説明を――」\\nw[\\N[2]]":118,"\\{「何だキサマッ？！」\\}\\nw[護衛の冒険者Ａ]":119,"\\{「ぐわああぁぁっ！！」\\}\\nw[護衛の冒険者Ａ]":120,"「くっ、曲者！？　遺跡荒らしの盗賊か！？」\\nw[伝承学者]":121,"アサシンとの戦闘\n↓　　↓　　↓":122,"「ふーっ……危ない危ない。いきなり襲ってきやがって」\\nw[\\N[1]]":123,"「な、なんだったんですかコイツ？！　強盗？」\\nw[\\N[2]]":124,"「いや、たぶん刺客だろう。\n　竜の鉤爪の回収と、事情を知る俺たちの暗殺が目的か」\\nw[\\N[1]]":125,"「まさか\\N[3]が雇ったんですか！？」\\nw[\\N[2]]":126,"「どうかな？\n　むしろ、その裏側にいるヤツの方が怪しいと思うぞ」\\nw[\\N[1]]":127,"「さっき言ってた命に関わるって、こういうことか！？\n　何が起こってるんだ！？」\\nw[伝承学者]":128,"「あんたは知らずにいた方がいい。\n　これ以上巻き込まれたくはないだろ？\\nw[\\N[1]]":129,"「それじゃこの黒づくめ野郎から、裏にいる人間の名前を\n　聞き出すか」\\nw[\\N[1]]":130,"「あっ！？　この人、死んでますよ！？」\\nw[\\N[2]]":131,"「くそっ、毒を飲んだか！\n　いらんプロ根性を発揮しやがって！」\\nw[\\N[1]]":132,"「最初から危険は承知してましたけど、こんな暗殺者まで\n　出てくるなんて、そこまでする価値が竜の鉤爪に\n　あるんですか？」\\nw[\\N[2]]":133,"「あるから寄越したんだろうよ。\\nw[\\N[1]]":134,"「このまま放置しておけば、第二第三の刺客が\n　来るかもな」\\nw[\\N[1]]":135,"「そんな！？」\\nw[\\N[2]]":136,"「……ともかく、ここを出て\\C[17]貧民街の酒場\\C[0]に戻るぞ。\n　詳しい話はそこでする。いいな？」\\nw[\\N[1]]":137,"「は……はい……」\\nw[\\N[2]]":138,"メインシナリオ\\C[17]『粘土板解読』\\C[0]を達成した！":139,"\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！":140,"メインシナリオ\\C[17]『黒幕は誰だ？』\\C[0]を受けた。":141,"「えらいことに巻き込んでくれたようだな」\\nw[伝承学者]":142,"「ここにはまだ、建国王が何かを残しているかもしれん。\n　徹底的に発掘してやる！」\\nw[伝承学者]":143,"魔法陣":144,"中に入るなと言われている。":145,"発掘助手":146,"「聞きたいことがあれば、どうぞ。\n　解説してさしあげますよ」\\nw[助手]":147,"この地下遺跡は何だ？":148,"なにを発掘しているんだ？":149,"あの学者先生はどういう人物？":150,"「ここは相当に古い遺跡で、王国成立よりずっと昔に\n　栄えていた古代人が造ったものと思われます。\\nw[助手]":151,"「ただし、いま我々がいるこの空間だけは後から掘られた\n　比較的新しいものですね」\\nw[助手]":152,"「建国王がこの遺跡に手を加えたらしいという記録が\n　見つかり、それを手掛かりに発掘したところ、ここ\n　を見つけたんです。\\nw[助手]":153,"「その魔法陣や壁の碑文などは、建国王の命令で設置\n　されたのでしょう。\n　信じられないほどの大発見ですよ！」\\nw[助手]":154,"「先生は行動する伝承学者なんです。\n　普通の伝承学者は文献調査ばかりしていますが、先生は\n　こうして大掛かりな発掘も行う。\\nw[助手]":155,"「伝承が真実かどうかを、自分の目で確かめないと気が\n　済まないのですよ。\\nw[助手]":156,"「ただ、発掘に私財を投じ過ぎたせいで、日々の生活にも\n　困窮する有様なんですが……」\\nw[助手]":157,"「賊ごときで、僕の探求心は止められませんよ！\n　さあ、聞きたいことがあればどうぞ！」\\nw[助手]":158,"碑文":159,"崩れた碑文がある。":160,"『この…………し魔…陣は、我…………の血を\n　……く……し者に……反応し……する。":161,"『後……秘事が伝わ…………た場合を……、これ……す\n　こと……る』":162,"「これじゃまったく意味が分からんな」\\nw[\\N[1]]":163,"「魔法陣について書いてあるんでしょうか？\\nw[\\N[2]]":164,"「なんとなく、重要そうな文面に思えますが……」\\nw[\\N[2]]":165,"伝承学者（作業中）":166,"「なにがあるか分からないから、魔法陣の中には\n　入らないように」\\nw[伝承学者]":167,"石柱":168,"「石柱だ。特に目を引くところはない」":169,"謎の光":170,"魔法陣Ev":171,"「な、なんだ！？　あの光は？\n　さっきまであんなもの無かったのに！？」\\nw[\\N[1]]":172,"「光？　どこですか？」\\nw[\\N[2]]":173,"「魔法陣の中心にあるだろうが！\n　ほれ、あれだ！」\\nw[\\N[1]]":174,"「え～？　分かんないです。\n　光なんてどこにもありませんよ？」\\nw[\\N[2]]":175,"「そんなわけ――」\\nw[\\N[1]]":176,"（そういや周りの人間も、まったく気づいた様子がないぞ。\n　まさか俺にしか見えてないのか？）\\nw[\\N[1]]":177,"「くっ！？　なんだっ、近づいて――」\\nw[\\N[1]]":178,"アサシン":179,"マーク":180,"回復魔法陣":181,"敵索敵スタート":182,"５層（発掘現場）":183},"extension":"json","dataType":"map","filename":"Map313","basename":"Map313.json","path":"data/Map313.json","relPath":"data/Map313.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":184,"percent":0},"cellInfo":[]},"data/Map314.json":{"data":[["<fog effect>\nid: 1\nname: 'fog01'\nopacity: 150\nhue: 100\nblend: 0\nmove x: 2\nmove y: 1\n</fog effect>",""],["EV001",""],["weather : 0 : 29 : 20 : 50 : 1 : Light_01A : 1 : 50",""],["weather : 1 : 29 : 20 : 20 : 1 : Light_01B : 1 : 70",""],["\n赤き鱗と四本の角を持つ恐るべき竜、アルテト――。",""],["\n我々の生命を脅かし、いたずらに命を弄ぶ悪しき竜――。",""],["\n人々の安寧のため、アルテトは滅びたのだと伝えた――。",""],["\nしかしそれは偽りだ――。",""],["\n四本角の悪竜は生きている――。",""],["\n私は滅ぼすことをためらい、封じたのだ――。",""],["\nこれから築く私の国に、いつか危機が訪れたとき――。",""],["\n悪竜を護国の竜へと変え、同胞たちを守るために――。",""],["\n三つの竜の鉤爪を集めよ――。",""],["\nさればアルテトを目覚めさせ、意のままに操れよう――。",""],["\nだが忘れるな――。",""],["\n四本角の竜を目覚めさせるは、亡国の危機のときのみ――。",""],["\n己が欲にて使役することは、厳に慎むべし――。",""],["\n我欲は国を亡ぼすと知れ――。",""],["clear_all_weathers",""]],"context":[["Map314/note"],["Map314/events/1/name"],["Map314/events/1/pages/0/list/5/Plugin Command"],["Map314/events/1/pages/0/list/6/Plugin Command"],["Map314/events/1/pages/0/list/23/message/noPicture/middle"],["Map314/events/1/pages/0/list/26/message/noPicture/middle"],["Map314/events/1/pages/0/list/29/message/noPicture/middle"],["Map314/events/1/pages/0/list/32/message/noPicture/middle"],["Map314/events/1/pages/0/list/35/message/noPicture/middle"],["Map314/events/1/pages/0/list/38/message/noPicture/middle"],["Map314/events/1/pages/0/list/41/message/noPicture/middle"],["Map314/events/1/pages/0/list/44/message/noPicture/middle"],["Map314/events/1/pages/0/list/47/message/noPicture/middle"],["Map314/events/1/pages/0/list/50/message/noPicture/middle"],["Map314/events/1/pages/0/list/53/message/noPicture/middle"],["Map314/events/1/pages/0/list/56/message/noPicture/middle"],["Map314/events/1/pages/0/list/59/message/noPicture/middle"],["Map314/events/1/pages/0/list/62/message/noPicture/middle"],["Map314/events/1/pages/0/list/72/Plugin Command"]],"tags":[null,["gold"],["blue"],["blue"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["blue"]],"parameters":[null,null,null,null,[{"headerIndex":23,"headerParam":["",0,1,1]}],[{"headerIndex":26,"headerParam":["",0,1,1]}],[{"headerIndex":29,"headerParam":["",0,1,1]}],[{"headerIndex":32,"headerParam":["",0,1,1]}],[{"headerIndex":35,"headerParam":["",0,1,1]}],[{"headerIndex":38,"headerParam":["",0,1,1]}],[{"headerIndex":41,"headerParam":["",0,1,1]}],[{"headerIndex":44,"headerParam":["",0,1,1]}],[{"headerIndex":47,"headerParam":["",0,1,1]}],[{"headerIndex":50,"headerParam":["",0,1,1]}],[{"headerIndex":53,"headerParam":["",0,1,1]}],[{"headerIndex":56,"headerParam":["",0,1,1]}],[{"headerIndex":59,"headerParam":["",0,1,1]}],[{"headerIndex":62,"headerParam":["",0,1,1]}]],"indexIds":{"<fog effect>\nid: 1\nname: 'fog01'\nopacity: 150\nhue: 100\nblend: 0\nmove x: 2\nmove y: 1\n</fog effect>":0,"EV001":1,"weather : 0 : 29 : 20 : 50 : 1 : Light_01A : 1 : 50":2,"weather : 1 : 29 : 20 : 20 : 1 : Light_01B : 1 : 70":3,"\n赤き鱗と四本の角を持つ恐るべき竜、アルテト――。":4,"\n我々の生命を脅かし、いたずらに命を弄ぶ悪しき竜――。":5,"\n人々の安寧のため、アルテトは滅びたのだと伝えた――。":6,"\nしかしそれは偽りだ――。":7,"\n四本角の悪竜は生きている――。":8,"\n私は滅ぼすことをためらい、封じたのだ――。":9,"\nこれから築く私の国に、いつか危機が訪れたとき――。":10,"\n悪竜を護国の竜へと変え、同胞たちを守るために――。":11,"\n三つの竜の鉤爪を集めよ――。":12,"\nさればアルテトを目覚めさせ、意のままに操れよう――。":13,"\nだが忘れるな――。":14,"\n四本角の竜を目覚めさせるは、亡国の危機のときのみ――。":15,"\n己が欲にて使役することは、厳に慎むべし――。":16,"\n我欲は国を亡ぼすと知れ――。":17,"clear_all_weathers":18},"extension":"json","dataType":"map","filename":"Map314","basename":"Map314.json","path":"data/Map314.json","relPath":"data/Map314.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":19,"percent":0},"cellInfo":[]},"data/Map315.json":{"data":[["出入口",""],["地上へ戻る前に、呼びつけた相手に会わなければ。",""],["戻っている暇はない。王宮へ向かわなければ。",""],["燭台",""],["メイド1",""],["メイド2",""],["通路Ev",""],["「ここって……？」\\nw[\\N[2]]",""],["「王都の地下には王宮からの秘密の脱出路が通ってる、って\n　噂があったが……まさか本当に存在してたとは」\\nw[\\N[1]]",""],["「え？　ここが脱出路？\n　そんな場所を知っているなんて、相手は一体……？」\\nw[\\N[2]]",""],["「すぐに分かる。進むぞ」\\nw[\\N[1]]",""],["姫会話Ev",""],["「来てやったぞ。\n　で、俺を呼びつけたのはどこのどいつだ？」\\nw[\\N[1]]",""],["「無礼者！　口を慎みなさい！」\\nw[メイドＡ]",""],["「己の身分を自覚し、そこに跪きなさい！」\\nw[メイドＢ]",""],["「な、なんだかすっごく怒られちゃってますよ？」\\nw[\\N[2]]",""],["「聞こえなかったのですか！？\n　いますぐ、貴人に対する礼を――」\\nw[メイドＡ]",""],["「二人とも、そんな風に居丈高に命じてはダメよ」\\nw[？？？]",""],["「申し訳ありません。\n　こちらからお呼び立てしておきながら……」\\nw[？？？]",""],["「ようこそいらして下さいましたね。\n　\\N[1]殿」\\nw[\\N[5]]",""],["ラーナの顔を知っているとき",""],["「えっ、ま、まさか……\\N[5]姫！？」\\nw[\\N[2]]",""],["ラーナの顔を知らないとき",""],["「えっと……こちらの高貴そうな女性はいったい……？」\\nw[\\N[2]]",""],["「なるほど、メイドどもがキャンキャン吠えるわけだ。\n　お姫様の呼び出しだったか」\\nw[\\N[1]]",""],["「え、お姫様って……？」\\nw[\\N[2]]",""],["「\\C[17]\\N[5]姫\\C[0]だ。名前くらい知ってるだろ？\n　国王の一人娘で、次代の女王だ」\\nw[\\N[1]]",""],["「えええぇぇっ！？」\\nw[\\N[2]]",""],["「姫様ともあろう者が、なんでこんな薄汚い場所に\n　俺を呼びつけた？」\\nw[\\N[1]]",""],["「それは、秘密のお話がしたかったからです。\n　竜の鉤爪に関わる話を」\\nw[\\N[5]]",""],["「…………。\\nw[\\N[1]]",""],["「\\N[3]とかいうメスガキを操って、竜の鉤爪を集めさせて\n　いたのは、姫様あんたか？」\\nw[\\N[1]]",""],["「えっ！？　ち、ちがいます！\\nw[\\N[5]]",""],["「ですがその\\N[3]という人のことや、刺客が放たれた\n　ことも含めて、事情は把握しています。\\nw[\\N[5]]",""],["「おそらくは、あなた方よりも詳しく。\\nw[\\N[5]]",""],["「\\N[1]殿、あなたは竜の鉤爪について、どこまで\n　知っていますか？」\\nw[\\N[5]]",""],["「古代竜さえ封印できる強力なマジックアイテムで、\n　これがあれば悪竜アルテトを支配し、操ることも\n　可能――ってところかな。\\nw[\\N[1]]",""],["「そしてどこかの馬鹿な王族が、アルテトを使って\n　多分クーデターでも企んでやがる」\\nw[\\N[1]]",""],["「そ、そこまでご存じでしたか！」\\nw[\\N[5]]",""],["「\\N[1]さんの言ってたこと、ホントのホント\n　だったんだ……」\\nw[\\N[2]]",""],["「だが黒幕をやってる王族が誰なのか、肝心なそこが\n　まだ分かってない。\\nw[\\N[1]]",""],["「姫様、あんたが教えてくれると期待していいんだよな？」\\nw[\\N[1]]",""],["「はい、もちろんそのつもりです。\\nw[\\N[5]]",""],["「簒奪を企み、あなた方に刺客を差し向けてまで\n　竜の鉤爪を手に入れようとした犯人は――\\nw[\\N[5]]",""],["「私の叔父、副都の領主である\\C[17]パルフューク大公\\C[0]です！」\\nw[\\N[5]]",""],["「えぇっ！　パルフューク大公！？」\\nw[\\N[2]]",""],["「フーン、そうか」\\nw[\\N[1]]",""],["「って、ちょっと！？\n　なんで\\N[1]さんは驚かないんですか！？」\\nw[\\N[2]]",""],["「そりゃあ、パルフューク大公は二番目に怪しいと睨んで\n　いたヤツだからな。意外性に乏しかった」\\nw[\\N[1]]",""],["「も、もしかして、一番怪しいと思っていた相手は、\n　わたしですか……？」\\nw[\\N[5]]",""],["「いいや、姫様は十番手くらいだ。\\nw[\\N[1]]",""],["「黙っていてもいずれ玉座に座れるのに、わざわざ\n　アルテトなんて持ち出す必要ないだろ？\\nw[\\N[1]]",""],["「それとも圧倒的な武力での、世界征服でも\n　企んでたか？」\\nw[\\N[1]]",""],["「まさか。\n　そんな大それたこと、考えたこともありませんわ。\\nw[\\N[5]]",""],["「でも叔父上――パルフューク大公は、簒奪という\n　大それたことを本気で考えているのです。\\nw[\\N[5]]",""],["「なのに父上は叔父上のことを、まったく疑おうと\n　しません。\\nw[\\N[5]]",""],["「パルフューク大公に怪しい動きあり――との注進が\n　あっても調査せず、逆に報告者を処罰する始末でして。\\nw[\\N[5]]",""],["「密かに王家に伝わっていた、竜の鉤爪とアルテトの封印の\n　話についても、ただの脚色された伝説だと言って、\n　本気にしていませんし……。\\nw[\\N[5]]",""],["「もし鉤爪が三つとも叔父上の手に渡れば、王都に\n　アルテトが飛来し、玉座は簒奪されてしまうでしょう」\\nw[\\N[5]]",""],["「だから使えない父親に代わって、お姫様が動いている\n　わけか。\\nw[\\N[1]]",""],["「それで俺にどうしろと？\n　竜の鉤爪を渡せって話なら、悪いが断らせてもらうぞ」\\nw[\\N[1]]",""],["「なんでですか！？　渡しちゃいましょうよ！\n　そうすれば――」\\nw[\\N[2]]",""],["「そうすれば刺客が来なくなって、お前もお姫様の権力で\n　奴隷から解放される――か？\\nw[\\N[1]]",""],["「そんなわけないだろ。\n　パルフューク大公を倒さない限り、刺客は送られて\n　くる。\\nw[\\N[1]]",""],["「そしてこのお姫様に、大公とまともに戦えるだけの\n　兵力はない。\\nw[\\N[1]]",""],["「鉤爪を渡したとして、守り切れるかどうかも\n　怪しいもんだ」\\nw[\\N[1]]",""],["「その通りです。\n　兵権は父上のものであり、わたしでは軍を動かすことは\n　できません。\\nw[\\N[5]]",""],["「わたしが自由に動かせるのは、彼女たちのような一部の\n　使用人くらい。\\nw[\\N[5]]",""],["「あなたのことも、このメイドたちに頼んで調べて\n　もらったのです」\\nw[\\N[5]]",""],["「じゃ、じゃあどうすればいいんですか！？」\\nw[\\N[2]]",""],["「叔父上の簒奪計画は、悪竜アルテトあってのもの。\n　ならばアルテトを使えないようにしてしまえば\n　いいのです」\\nw[\\N[5]]",""],["「使えなくするって、どうやってだ？\\nw[\\N[1]]",""],["「鉤爪を壊せば使役はできなくなるが、封印は解けて\n　甦ったアルテトが大暴れするかもしれないぞ？」\\nw[\\N[1]]",""],["「か、隠したらどうでしょう？\n　すっごく見つかりにくいどこかに」\\nw[\\N[2]]",""],["「その場合はなにがなんでも俺たちを捕えて、拷問で\n　隠し場所を吐かせようとするだろうな」\\nw[\\N[1]]",""],["「そんな……八方塞がりじゃないですかぁ！」\\nw[\\N[2]]",""],["「ご心配なく。\n　アルテトの封印を維持したまま、鉤爪を永遠に使えなく\n　する方法があるのです！\\nw[\\N[5]]",""],["「そしてその方法を、あなた方に実行していただきたい\n　のです」\\nw[\\N[5]]",""],["「それがここに呼んだ本題か。\\nw[\\N[1]]",""],["「使える手駒が使用人しかいないんで、手っ取り早く\n　俺たちを利用しようってわけだ」\\nw[\\N[1]]",""],["「気を悪くしたのなら謝ります。\n　ですが他に、任せられそうな人がいないのです」\\nw[\\N[5]]",""],["「フンッ……それでどうすりゃいいんだ？\n　詳しく聞かないことには返答できんぞ」\\nw[\\N[1]]",""],["「建国王リジェルダが、悪竜アルテトを葬ったとされる\n　場所――\\C[17]『竜の寝床』\\C[0]はご存じですね？」\\nw[\\N[5]]",""],["「王国最大の湖、クルバ湖に浮かぶ火山島だな」\\nw[\\N[1]]",""],["「はい。\n　そこには古代竜の腐敗した死骸から出来たという\n　\\C[17]死毒の沼\\C[0]があります。\\nw[\\N[5]]",""],["「その猛毒の沼に竜の鉤爪を沈めてしまえば、誰にも\n　拾い上げることは不可能となるでしょう」\\nw[\\N[5]]",""],["「竜の寝床まで行って、俺たちの手元にある二つの鉤爪を\n　毒沼に捨ててこい――と？\\nw[\\N[1]]",""],["「その場合、メスガキの――いや、大公の手元に残った\n　ひとつはどうなる？」\\nw[\\N[1]]",""],["「ご心配なく。\n　鉤爪は三つ揃わないと力を発揮しませんので、\n　ひとつだけ残っても脅威にはなりません。\\nw[\\N[5]]",""],["「どうかこの話、引き受けてはいただけないで\n　しょうか？\\nw[\\N[5]]",""],["「もちろんお礼はいたします。\n　猫人のお二人の、奴隷身分の取り消しもお約束\n　いたしましょう」\\nw[\\N[5]]",""],["「ほっ、本当ですか！？\\nw[\\N[2]]",""],["「ねぇっ、\\N[1]さん！\n　\\N[5]姫様もこう言ってますし、やりましょうよ！」\\nw[\\N[2]]",""],["「鼻息が荒いぞ。……ったく。\\nw[\\N[1]]",""],["「だがそれでも問題は残るな。\n　野望を阻止された大公が、腹いせに俺たちを狙い続ける\n　かもしれん」\\nw[\\N[1]]",""],["「そのときはあなた方を王宮の使用人として雇い入れて、\n　わたしのそばで保護しましょう\\nw[\\N[5]]",""],["「そしてわたしが王位についた暁には、叔父上を\n　反逆者として捕えます」\\nw[\\N[5]]",""],["「保護してくれるのはいいが、お姫様が女王になるのは\n　何十年先のことになるやら……。\n　それまで使用人でいろってか？」\\nw[\\N[1]]",""],["「…………いえ。\\nw[\\N[5]]",""],["「それほどお待たせすることには、ならないかと」\\nw[\\N[5]]",""],["「え、それはどういう……？」\\nw[\\N[2]]",""],["「ここだけの話にして欲しいのですが……父上の健康状態は\n　あまり良くありません。\\nw[\\N[5]]",""],["「もともと王家の人間は早逝する者が多く、アルテトの\n　呪いだなどと噂されたりもしますが――\\nw[\\N[5]]",""],["「父上もその例外ではないようです。\\nw[\\N[5]]",""],["「失政を繰り返しているのも、死ぬ前に何か功績を\n　残したいと焦ってのことなのです」\\nw[\\N[5]]",""],["「そ、そうだったんですか……」\\nw[\\N[2]]",""],["「…………」\\nw[\\N[1]]",""],["「お願いです、力を貸していただけませんか？\\nw[\\N[5]]",""],["「パルフューク大公の野望を阻止するために。\n　そしてなにより、あなた方の生活に平穏を取り戻す\n　ために」\\nw[\\N[5]]",""],["「…………フン。\\nw[\\N[1]]",""],["「王家のために、なんて言ったら断ってやろうと思って\n　たが、そこまで傲慢でもなかったか。\\nw[\\N[1]]",""],["「いいぜ、お姫様。\n　この竜の鉤爪、二度と誰も手にできないよう始末して\n　きてやる」\\nw[\\N[1]]",""],["「あ……ありがとうございます！」\\nw[\\N[5]]",""],["「任せてください！\n　特に自信はありませんけど！」\\nw[\\N[2]]",""],["「自身満々になに言ってんだ、お前は？」\\nw[\\N[1]]",""],["「い、いえ……お姫様に頼まれごとされるなんて、\n　これが最初で最後でしょうから、ちょっと舞い上がっ\n　ちゃいまして……」\\nw[\\N[2]]",""],["「それではよろしくお願いします。\\nw[\\N[5]]",""],["「あっ、それとこれは支度金ということで、\n　少ないですが受け取ってください」\\nw[\\N[5]]",""],["\\N[5]姫から\\C[17]３００００Ｇ\\C[0]を受け取った。",""],["「こ、こんなに！？」\\nw[\\N[2]]",""],["「命がけになるでしょうから、せめてこれくらいは。\n　遠慮せず使ってください」\\nw[\\N[5]]",""],["「ああ、この金でせいぜい丈夫な装備を買わせて\n　もらうぜ」\\nw[\\N[1]]",""],["「ご武運をお祈りしております。\\nw[\\N[5]]",""],["「それではわたしは王宮へもどりますので、\n　これで失礼を――」\\nw[\\N[5]]",""],["「あの、\\N[1]殿。\n　つかぬことを伺いますが……」\\nw[\\N[5]]",""],["「ん？」\\nw[\\N[1]]",""],["「わたしたち、以前にどこかでお会いしたことが\n　あるでしょうか？」\\nw[\\N[5]]",""],["「えっ！？　あるんですか！？」\\nw[\\N[2]]",""],["「あるわけないだろうが。\\nw[\\N[1]]",""],["「こちとら庶民だぞ？　\n　今回みたいなことでもない限り、お姫様と知り合う機会\n　なんて無いってぇの」\\nw[\\N[1]]",""],["「そ、そうですか……。\n　すみません、変なことを聞いてしまって。\\nw[\\N[5]]",""],["「では……」\\nw[\\N[5]]",""],["メインシナリオ\\C[17]『黒幕は誰だ？』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「２」\\C[0]上がった！",""],["メインシナリオ\\C[17]『竜の寝床へ』\\C[0]を受けた！",""],["\\>　※　\\C[17]『竜の寝床』\\C[0]へ向かい、死毒の沼に竜の鉤爪を　※\n\\>　※　投げ捨てよう！　　　　　　　　　　　　　　　※\\<",""],["ユマ（地下1）",""],["ラーナ姫",""],["光",""],["EV012",""],["EV013",""],["EV014",""],["ラーナ（ED2Ev）",""],["「ここ、勝手に使っちゃって大丈夫でしょうか？」\\nw[\\N[2]]",""],["「心配すんな。\n　王宮の隠し脱出路なんて、有事のとき以外は誰も\n　使わんさ。\\nw[\\N[1]]",""],["「\\N[5]を連れて街中を歩くわけにもいかんから、\n　しばらくはここに身を潜めるぞ」\\nw[\\N[1]]",""],["「でも……」\\nw[\\N[2]]",""],["「大体、お前はもうこれ以上付き合わなくてもいい\n　んだぞ？\\nw[\\N[1]]",""],["「女王が奴隷身分から解放してくれたわけだし、メスガキ\n　のせいで被った損害も全部補填されたんだ。\\nw[\\N[1]]",""],["「父親のところへ行くなり、故郷へ戻るなりしても……」\\nw[\\N[1]]",""],["「なんですかソレ！\n　わたしがいると邪魔だっていうんですか！？」\\nw[\\N[2]]",""],["「いや、そうは言ってないだろ。\n　居たいなら居てかまわないが」\\nw[\\N[1]]",""],["「じゃあ、そうさせてもらいます！」\\nw[\\N[2]]",""],["「あの、イチャついてるとこ悪いけど、わたしはこれから\n　どうなるの……？\\nw[\\N[5]=\\N[6]]",""],["「ま、まさか、今になって殺すとか言ったりしない\n　わよね？　ね？」\\nw[\\N[5]=\\N[6]]",""],["「殺すつもりならとっくにそうしてる。\n　大臣どもにも散々、そうしろと要請されたからな。\\nw[\\N[1]]",""],["「なのにお前を生かしておいた理由はただひとつ。\n　それは――」\\nw[\\N[1]]",""],["「それは？」\\nw[\\N[2]]",""],["「商売のためだ！」\\nw[\\N[1]]",""],["「はぁっ？！」\\nw[\\N[2]]",""],["「えぇっ？！　えっ？」\\nw[\\N[5]=\\N[6]]",""],["「考えてもみろ、こいつがいれば空を飛んで荷物の輸送が\n　できるんだぞ！\\nw[\\N[1]]",""],["「空中輸送！　他の商人には真似できない画期的な\n　アイディアだろう！」\\nw[\\N[1]]",""],["「そんなこと考えていたんですか！？\n　で、でも、もし\\N[6]が力を取り戻しでもしたら――」\\nw[\\N[2]]",""],["「ああ、それなら心配はいらん。\\nw[\\N[1]]",""],["「おい\\N[5]」\\nw[\\N[1]]",""],["「は、はい！　なんでしょう、お兄様？」\\nw[\\N[5]=\\N[6]]",""],["「お前は俺の言うことを何でも聞くと言ったよな？」\\nw[\\N[1]]",""],["「え……ええ、言いました」\\nw[\\N[5]=\\N[6]]",""],["「俺に忠誠を誓って、絶対に逆らったりしないな？」\\nw[\\N[1]]",""],["「は、はいっ！　もちろん！」\\nw[\\N[5]=\\N[6]]",""],["「三回まわってワンと吠えろと命じたら吠えるな？」\\nw[\\N[1]]",""],["「と、当然やらせていただきます」\\nw[\\N[5]=\\N[6]]",""],["「\\C[17]俺の子を孕め\\C[0]と言えば孕むな？」\\nw[\\N[1]]",""],["「そのくらい喜んで――\\nw[\\N[5]=\\N[6]]",""],["「――って、え？」\\nw[\\N[5]=\\N[6]]",""],["「ちょ、ちょっと\\N[1]さん？\n　いまとんでもないこと言いませんでした？」\\nw[\\N[2]]",""],["「まあ聞け。理由あってのことだ。\\nw[\\N[1]]",""],["「\\N[6]は建国王リジェルダに自分の魂の欠片を\n　撃ち込んで呪っただろ？\\nw[\\N[1]]",""],["「それの逆バージョンをやるんだ。\n　俺の種をブチ込んで孕ませることで\\C[17]使役の呪い\\C[0]をかけ、\n　完璧に支配下に置く。\\nw[\\N[1]]",""],["「竜の鉤爪の力を応用すれば、多分できるはずなんだ。\\nw[\\N[1]]",""],["「成功すれば、俺の許可が無い限り悪竜の力は恒久的に\n　使えなくなるから、世界平和も維持できるって寸法だ」\\nw[\\N[1]]",""],["「で、でも、お兄様？　わたしたちは母親が違うとはいえ\n　実の兄妹なわけで……」\\nw[\\N[5]=\\N[6]]",""],["「気にするな！　生まれてこのかたずっと離れていたから、\n　兄妹なんて実感、お前だって持ってないだろ？\\nw[\\N[1]]",""],["「だ、だからって！」\\nw[\\N[5]=\\N[6]]",""],["「ぶっちゃけ、この処置を施さない限り、危なっかしくて\n　お前を生かしてはおけないんだ。\\nw[\\N[1]]",""],["「いまでこそ竜の鉤爪の力で抑え込めているが、いずれ\n　歳月が経って俺が死ねば、悪竜は力を取り戻すだろう。\\nw[\\N[1]]",""],["「そうなれば元の木阿弥だからな。\n　俺の死後もお前に首輪を嵌めつづけるには、これしか\n　方法がないんだ。\\nw[\\N[1]]",""],["「まあ、どうしてもイヤだと言うなら、この場で屠殺する\n　しかないわけだが？」\\nw[\\N[1]]",""],["「……………………は、孕まさせていただきます」\\nw[\\N[5]=\\N[6]]",""],["「なんだか\\N[1]さんに買われた当初の自分を見て\n　いるようで、やるせなさが……」\\nw[\\N[2]]",""],["「じゃあ服を脱げ。\n　兄貴のチンコの味を教えこんでやろう」\\nw[\\N[1]]",""],["「うそっ！？　い、いまここでするの！？」\\nw[\\N[5]=\\N[6]]",""],["「嫌なら屠殺でも――」\\nw[\\N[1]]",""],["「わ……わぁい！　お兄様とのセックス、楽しみだわぁ！」\\nw[\\N[5]=\\N[6]]",""],["「あぁ……\\I[29]　こんな気持ち初めてぇ\\I[29]\n　お兄さま……おにいさまぁ\\I[29]」\\nw[\\N[5]=\\N[6]]",""],["「ほ、本当に実妹としちゃうなんて……」\\nw[\\N[2]]",""],["「さすが俺の妹だな。\n　抱いてやったら一発で和解できたぜ」\\nw[\\N[1]]",""],["「それ和解って言うか……下半身で堕としただけでは？」\\nw[\\N[2]]",""],["「それじゃ次は\\N[2]とだな」\\nw[\\N[1]]",""],["「へ？　つ、次って……」\\nw[\\N[2]]",""],["「安心しろ。\\N[5]だけ特別扱いってわけじゃないから。\n　お前も平等に、きっちり孕ませてやるぞ」\\nw[\\N[1]]",""],["「ちょ、ちょっと待って……あっ、ああぁっ……\n　ああぁああぁぁーーっ\\I[29]\\I[29]」」\\nw[\\N[2]]",""],["エンディングロール\n↓　　↓　　↓",""],["↑　　↑　　↑\nエンディングロール",""],["「お兄様、なんなりとお命じになってくださいね\\I[29]」\\nw[\\N[5]=\\N[6]]",""],["エッチする",""],["なにもしない",""],["\\N[5]を王都の自宅に移す",""],["「えぇ～？！　してくださらないのですかぁ？」\\nw[\\N[5]=\\N[6]]",""],["\\N[5]を\\C[17]王都の自宅\\C[0]へ移動させますか？",""],["移動させる",""],["移動させない",""],["「わかりました。自宅の方へ移りますね」\\nw[\\N[5]=\\N[6]]",""],["\\C[18]王都の自宅を購入していません。\\C[0]\n自宅を購入後、\\N[5]を移すことができます。",""],["エンディング後再開処理",""],["C_START",""],["C_ENABLE_WEATHER",""],["地下通路",""],["\\>※　本作を遊んでいただきありがとうございました。　※\n\\>※　ここから未クリアの依頼やダンジョンを引き続き　※\n\\>※　攻略することができます。　　　　　　　　　　　※",""],["\\>\\N[1]が戦技\\C[17]『\\sn[103]』\\C[0]を覚えた！",""],["\\>自宅にある\\C[17]赤い本\\C[0]から、\\C[17]アルテトとの決戦\\C[0]をやり直せる\n\\>ようになった！\n\\>（※別エンディングを見るためにご活用ください）",""],["アルテトハートマーク",""],["アルテト寝床",""],["アルテト食事",""],["障害物",""]],"context":[["Map315/events/1/name"],["Map315/events/1/pages/0/list/0/message/noPicture/bottom"],["Map315/events/1/pages/1/list/0/message/noPicture/bottom"],["Map315/events/2/name","Map315/events/3/name"],["Map315/events/4/name"],["Map315/events/5/name"],["Map315/events/6/name"],["Map315/events/6/pages/0/list/14/message/noPicture/bottom"],["Map315/events/6/pages/0/list/18/message/noPicture/bottom"],["Map315/events/6/pages/0/list/25/message/noPicture/bottom"],["Map315/events/6/pages/0/list/30/message/noPicture/bottom"],["Map315/events/7/name"],["Map315/events/7/pages/1/list/69/message/noPicture/bottom"],["Map315/events/7/pages/1/list/74/message/noPicture/bottom"],["Map315/events/7/pages/1/list/77/message/noPicture/bottom"],["Map315/events/7/pages/1/list/82/message/noPicture/bottom"],["Map315/events/7/pages/1/list/86/message/noPicture/bottom"],["Map315/events/7/pages/1/list/90/message/noPicture/bottom"],["Map315/events/7/pages/1/list/100/message/noPicture/bottom"],["Map315/events/7/pages/1/list/115/message/noPicture/bottom"],["Map315/events/7/pages/1/list/120/comment"],["Map315/events/7/pages/1/list/125/message/noPicture/bottom"],["Map315/events/7/pages/1/list/130/comment"],["Map315/events/7/pages/1/list/135/message/noPicture/bottom"],["Map315/events/7/pages/1/list/139/message/noPicture/bottom"],["Map315/events/7/pages/1/list/146/message/noPicture/bottom"],["Map315/events/7/pages/1/list/150/message/noPicture/bottom"],["Map315/events/7/pages/1/list/158/message/noPicture/bottom"],["Map315/events/7/pages/1/list/164/message/noPicture/bott