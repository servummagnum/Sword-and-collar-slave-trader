ex":113,"headerParam":["",0,0,2]}],[{"headerIndex":117,"headerParam":["",0,0,2]}],[{"headerIndex":124,"headerParam":["",0,0,2]}],[{"headerIndex":129,"headerParam":["",0,0,2]}],[{"headerIndex":132,"headerParam":["",0,0,2]}],[{"headerIndex":136,"headerParam":["",0,0,2]}],[{"headerIndex":144,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["",0,0,2]}],[{"headerIndex":149,"headerParam":["",0,0,2]}],[{"headerIndex":153,"headerParam":["",0,0,2]}],[{"headerIndex":157,"headerParam":["",0,0,2]}],[{"headerIndex":167,"headerParam":["",0,0,1]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":28,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":37,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]},{"headerIndex":6,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]},{"headerIndex":6,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]},{"headerIndex":14,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"酔った客":2,"「アルテトォ？　それがどうしたぁ！\n　そんなことより酒だぁ！」\\nw[酔った客]":3,"「酒だぁー！　もっと酒をくれぇ！」\\nw[酔った客]":4,"「日のあるうちから飲んで、なにが悪いってんだぁー！？」\\nw[酔った客]":5,"マスター":6,"「いらっしゃぁい\\I[29]\n　あら、この辺じゃ見かけないお兄さんね？」\\nw[マスター]":7,"「ああ、王都の人間じゃないんでな。\n　実は人を探していて、ここまで来たんだ」\\nw[\\N[1]]":8,"「あのっ、このお店に猫人の奴隷がいるって聞いて\n　来たんです！」\\nw[\\N[2]]":9,"「そうなの？\n　確かにウチには、奴隷の従業員がいるけど」\\nw[マスター]":10,"「よし、情報に間違いはなかったようだな。\\nw[\\N[1]]":11,"「マスター、その猫人奴隷に会わせてもらえないか？」\\nw[\\N[1]]":12,"「お安い御用よ。いま呼んであげるわ\\I[29]」\\nw[マスター]":13,"「良かった……やっと父さんと会える……」\\nw[\\N[2]]":14,"「ミニャニャちゃーん！　ご指名よー！\\I[29]」\\nw[マスター]":15,"「はーい\\I[29]」\\nw[？？？]":16,"「いらっしゃいませニャ！\n　ご指名いただきました、ミニャニャですニャ\\I[29]」\\nw[ミニャニャ]":17,"「おいおいマスター、違うぞ。\n　俺たちが探してるのは、中年の男で――」\\nw[\\N[1]]":18,"\\{「父さんっ？！」\\}\\nw[\\N[2]]":19,"\\{「なにぃっ！？\\!　　\n　　　　　\\}\\}あっ、よく見たら無精ヒゲが……！\\{\\{」\\nw[\\N[1]]":20,"「\\N[2]ッ！？\n　ほんとうに\\N[2]なのかニャッ！？\\nw[ミニャニャ]":21,"「まさか無事な姿で、また会えるにゃんて……！」\\nw[ミニャニャ]":22,"「ち……ちがう……父さんじゃない……」\\nw[\\N[2]]":23,"「なにを言ってるのニャ、\\N[2]？\n　ほら、父さんにゃよ？」\\nw[ミニャニャ]":24,"\\{「ちがうもんっ！\\}\\nw[\\N[2]]":25,"\\{「わたしの父さんは、語尾に『ニャ』とか\n　つけないもんッ！」\\}\\nw[\\N[2]]":26,"「そんにゃーっ！？」\\nw[ミニャニャ]":27,"「お、おい\\N[2]、とりあえず落ち着け。\\nw[\\N[1]]":28,"「現実を見たくない気持ちは分かるが、どうやらコレが\n　お前の父親らしいぞ？」\\nw[\\N[1]]":29,"\\{「ちがうもんっ！」\\}\\nw[\\N[2]]":30,"「仕方ない……とりあえず、ここは俺が話を聞こう。\n　あんたが\\N[2]の父親で間違いないんだな？」\\nw[\\N[1]]":31,"「……そうだにゃん。\n　いまちょっと自信が揺らいでるけど」\\nw[ミニャニャ]":32,"「いったい、なにがあってチンコを切る羽目に\n　なったんだ？」\\nw[\\N[1]]":33,"「別にチンコはとってないニャ。\n　女装してるだけにゃよ。\\nw[ミニャニャ]":34,"「奴隷に堕ちて売られた先が、このちょっと特殊な酒場\n　だったから、店のノリに合わせてるだけニャ」\\nw[ミニャニャ]":35,"「ミニャニャちゃん、お客さんからの評判も良くってね。\n　きっとこのお仕事が天職なのよ\\I[29]」\\nw[マスター]":36,"「そんにゃ……マスターが丁寧に仕事を教えてくれる\n　おかげニャ\\I[29]」\\nw[ミニャニャ]":37,"「……まあ、幸せそうで良かったよ」\\nw[\\N[1]]":38,"「おい\\N[2]、そろそろ現実に戻って来い。\n　どうあがいたって、これがお前の父親だぞ」\\nw[\\N[1]]":39,"「わかってます……わたしの知ってる父さんはもうどこにも\n　いないって……」\\nw[\\N[2]]":40,"「だから父さんはココにいるんにゃけど！？」\\nw[ミニャニャ]":41,"「そっちの子がミニャニャちゃんの娘だっていうのは\n　分かったけど、じゃあ、あなたはどういう関係なの？」\\nw[マスター]":42,"「そうニャ！\n　あんたはどこの誰ニャ！？」\\nw[ミニャニャ]":43,"「慌てるな。\n　いまイチから説明してやるから」\\nw[\\N[1]]":44,"\n\\>　　　　　～　これまでの事情を説明中　～\\<":45,"「やはりあいつらに裏切られていたのか！\n　くそぉっ！\\nw[\\N[2]の父]":46,"「海賊の襲撃が、タイミング良すぎたから\n　おかしいと思っていたんだ！」\\nw[\\N[2]の父]":47,"「おっ、口調がまともになったな」\\nw[\\N[1]]":48,"「ミニャニャだった期間が長すぎて自然と語尾がニャに\n　なってたが、それも怒りで吹き飛んだぞ！」\\nw[\\N[2]の父]":49,"「\\N[3]とかいうメスガキの商会が元凶だと、\n　気づいていたのか？」\\nw[\\N[1]]":50,"「薄々はな。\n　だが信頼していた相手だから、まさかという思いも\n　あったんだが……。\\nw[\\N[2]の父]":51,"「くそっ！\n　俺が不甲斐ないばかりに、\\N[2]まで奴隷にして\n　しまった……。\\nw[\\N[2]の父]":52,"「すまん、\\N[2]！」\\nw[\\N[2]の父]":53,"「父さん……」\\nw[\\N[2]]":54,"「だいじょうぶ、父さんは悪くない。\n　悪いのは\\N[3]たちだもん。ちゃんと分かってるよ」\\nw[\\N[2]]":55,"「\\N[2]……ありがとう……」\\nw[\\N[2]の父]":56,"「いい話ね、泣けるわぁ」\\nw[マスター]":57,"「いや、泣いてばかりもいられん！\n　娘ともども奴隷身分にされた恨み……晴らさずには\n　おかんぞ！」\\nw[\\N[2]の父]":58,"「その意気があるなら、俺たちを手伝ってくれないか？」\\nw[\\N[1]]":59,"「是非ともそうしたいが……実は腰が悪くて……。\n　とてもじゃないが、戦闘の役には立てそうにないんだ」\\nw[\\N[2]の父]":60,"「そ、そうか。\n　腰は……まあ仕方ないよな。\\nw[\\N[1]]":61,"「だが戦闘以外でも仕事はあるだろ。\n　たとえば情報収集とか。\\nw[\\N[1]]":62,"「これから俺たちは、『竜の鉤爪』って代物の情報を集め\n　ようとしてるところなんだ。\\nw[\\N[1]]":63,"「それをメスガキより先に入手できれば、あいつの\n　商会ごとブッ潰せるかもしれないんだが」\\nw[\\N[1]]":64,"「竜の鉤爪……？\n　どこかで聞いたことがあるような……」\\nw[\\N[2]の父]":65,"「なに、本当か！？」\\nw[\\N[1]]":66,"「昔、たまたま酒場で知り合った学者が、そんなような\n　話をしてた……と思うが……。\\nw[\\N[2]の父]":67,"「しかしなにぶん、酔ってたんでほとんど覚えてないんだ。\n　確かその学者は、こう愚痴ってたような――。\\nw[\\N[2]の父]":68,"「必要な資料が\\C[17]大聖堂の書庫\\C[0]にあるはずなのに、\n　いくら頼んでも見せてもらえない――と」\\nw[\\N[2]の父]":69,"「竜の鉤爪に関する資料が、大聖堂に？」\\nw[\\N[2]]":70,"「それなら、次の行き先は決まりだな。\n　大聖堂へ行って、竜の鉤爪について調べるぞ」\\nw[\\N[1]]":71,"「そうしてくれるのはありがたいが、あんたはどうして\n　そこまで深入りしようとするんだ？\\nw[\\N[2]の父]":72,"「一介の奴隷商人には荷の重い話のはずだ。\n　我々父娘を助ける義理だって無いだろうに」\\nw[\\N[2]の父]":73,"「それについては、以前\\N[2]にも言ったが、\n　あの気にくわないメスガキに、地獄を見せて\n　やりたいからさ」\\nw[\\N[1]]":74,"「そ、そうかい……あまり健全な動機じゃなさそうだが、\n　あんたがそれでいいと言うなら……」\\nw[\\N[2]の父]":75,"（なんてな。最初の動機はそうだったが、いまは別に気に\n　なることがあるから動いてるだけだ。\\nw[\\N[1]]":76,"（メスガキをアゴで使ってる王族――そいつは誰なんだ？）\\nw[\\N[1]]":77,"「父さん、わたし行ってくる。\n　奴隷身分から解放されるために、竜の鉤爪を見つけ出し\n　てくるよ！」\\nw[\\N[2]]":78,"「分かった。\n　それなら父さんはここで、敵の動向を探ろう。\\nw[\\N[2]の父]":79,"「ヤツラの商会は王都に進出して、かなり手広く\n　商取引をしているらしいからな」\\nw[\\N[2]の父]　":80,"「そういうことなら、王都の方はミニャニャちゃんに\n　任せるとするか」\\nw[\\N[1]]":81,"「ガンバルにゃん\\I[29]」\\nw[\\N[2]の父]":82,"メインシナリオ\\C[17]『大聖堂の書庫』\\C[0]を受けた！":83,"「あたしは何も聞かなかったことにしてあげるから、\n　好きなようにやるといいわ」\\nw[マスター]":84,"「一杯おごるから、私にも旅の話を聞かせてちょうだいよ」\\nw[マスター]":85,"「詮索はしないわよ。\n　この街じゃ、誰もが厄介事を抱えているからね」\\nw[マスター]":86,"「誰も彼もが悪竜アルテトの話をしてるわ。\n　みんな不安なのね」\\nw[マスター]":87,"「ミニャニャちゃんが奴隷身分から解放されて良かったわ。\n　故郷でも元気にやってるかしら？」」\\nw[マスター]":88,"火":89,"光":90,"トークマーク":91,"ユマ父1":92,"「竜の鉤爪は、\\C[17]封印された古代竜アルテトを目覚めさせ、\n　操るためのマジックアイテム\\C[0]だった」\\nw[\\N[1]]":93,"「あの伝説の悪竜が生きてる！？」\\nw[\\N[2]の父]":94,"「それ、本当なんですか！？\n　でもどこでそんな話を？」\\nw[\\N[2]]":95,"「それについては内緒だ。\n　だが、まず間違いはない。\\nw[\\N[1]]":96,"「王族の誰かがアルテトの力を自分のものにするため、\n　メスガキを使って鉤爪を集めさせていたんだ」\\nw[\\N[1]]":97,"「それを信じるとして……なんのためにアルテトを？」\\nw[\\N[2]の父]":98,"「決まってる。\n　玉座を奪って、自分が王になるためだ」\\nw[\\N[1]]":99,"「えええぇぇっ！？」\\nw[\\N[2]]":100,"「今の国王の役立たずっぷりは有名だろ？\\nw[\\N[1]]":101,"「あんなアホに国の行く末を任せるくらいなら、\n　いっそ自分が――と考える他の王族がいても\n　おかしくはない」\\nw[\\N[1]]":102,"「国王自身が、鉤爪を探させてたって可能性はニャいか？」\\nw[\\N[2]の父]":103,"「いや、それなら普通に兵隊なり役人なりを動員して\n　捜索させるだろ？\\nw[\\N[1]]":104,"「堂々と鉤爪捜索をすると、謀反の疑いがかかるかも\n　しれない他の王族だからこそ、メスガキを使うなんて\n　面倒な方法をとっているんだ」\\nw[\\N[1]]":105,"「じゃあ、鉤爪はクーデター計画の要だから、\n　あんな刺客まで送り込んで取り戻そうとしたんですか？」\\nw[\\N[2]]":106,"「そう考えると、しっくりくるだろ？\n　忌々しいことにな」\\nw[\\N[1]]":107,"「これはもう、私たちの手に負える規模の話じゃニャい\n　と思うニャー。\\nw[\\N[2]の父]":108,"「いっそ鉤爪といまの話を王宮に持って行って、\n　王様を味方につけちゃったらどうニャ？」\\nw[\\N[2]の父]":109,"「あっ、それいいかも！\n　王様の鶴の一声があれば、すぐに奴隷から解放して\n　もらえるかもしれないし！」\\nw[\\N[2]]":110,"「アホ王が聞く耳を持ってくれれば、の話だがな。\\nw[\\N[1]]":111,"「だが一歩間違えると、不敬罪や騒乱罪で処刑コース\n　かもしれんぞ？」\\nw[\\N[1]]":112,"「そ、そんなぁ……」\\nw[\\N[2]]":113,"「だが、考え方は悪くない。\\nw[\\N[1]]":114,"「もし、黒幕でないと確信できる王族の誰かを味方に\n　つけられれば――」\\nw[\\N[1]]":115,"「メイドさん？\n　これはまた珍しいお客さんが来たわねぇ」\\nw[マスター]":116,"「こちらの店主の方でしょうか？\n　少々お伺いしたいのですが」\\nw[メイド]":117,"「なぁに？\n　スリーサイズ以外なら教えちゃうわよ\\I[29]」\\nw[マスター]":118,"「こちらに\\N[1]という名の奴隷商人がいると\n　思うのですが」\\nw[メイド]":119,"「ま、まさか、また刺客が……！？」\\nw[\\N[2]]":120,"「いや、そういう感じではなさそうだぞ？\n　だがこちらの居所をつかんでるなら、油断はできんな」\\nw[\\N[1]]":121,"「\\N[1]？\n　ウチの店にはいろんなお客がくるんで、名前なんて\n　いちいち覚えてないわぁ」\\nw[マスター]":122,"「では手紙を置いていきますので、来店したら\n　お渡ししてください。\\nw[メイド]":123,"「それと伝言もおねがいします。\\nw[メイド]":124,"「あなたたちが抱えている問題。それを解決するための\n　糸口を、我々は提供できる――と」\\nw[メイド]":125,"「ではこれで、失礼いたします」\\nw[メイド]":126,"「これがメイドの置いていった手紙ニャ」\\nw[\\N[2]の父]":127,"\n\\C[17]『日が落ちてから、闘技場北の公園まで来られたし』\\C[0]":128,"「これだけ？　差出人の名前もない」\\nw[\\N[2]]":129,"「あからさまに怪しいな」\\nw[\\N[1]]":130,"「行った先で、敵が待ち伏せしてるかもニャ」\\nw[\\N[2]の父]":131,"「その可能性もあるが……俺は行ってみようと思う」\\nw[\\N[1]]":132,"「き、危険ですよ！」\\nw[\\N[2]]":133,"「今更だろうが。\n　それにただ何もせずにいれば、危険が向こうから\n　押しかけて来るだろうよ」\\nw[\\N[1]]":134,"「虎穴に入らずんば虎児を得ず、かニャ？」\\nw[\\N[2]の父]":135,"「そういうことだ。\n　手紙の誘いに乗ってやろう」\\nw[\\N[1]]":136,"「だいじょぶかなぁ～？」\\nw[\\N[2]]":137,"\\>　　※　\\C[17]夜\\C[0]になったら、闘技場の北にある\\C[17]公園\\C[0]へ　※\n\\>　　※　行ってみよう。　　　　　　　　　　　　※\\<":138,"「誰かと思えば、学者先生じゃないか」\\nw[\\N[1]]":139,"「ああそうだ。\n　キミたちのお陰で厄介事に巻き込まれて、発掘作業が\n　中断中の学者だよ！」\\nw[伝承学者]":140,"「そ、その節はたいへんご迷惑をおかけして……」\\nw[\\N[2]]":141,"「なんだ、わざわざ文句を言いに来たのか？」\\nw[\\N[1]]":142,"「それもあるが、それだけじゃない！\n　この騒ぎについて言いたいことと、訊きたいことが\n　あるからだ！」\\nw[伝承学者]":143,"「噂が爆発的に広がって、いまや王都はアルテト関連の\n　話題で持ちきりニャからね」\\nw[\\N[2]の父]":144,"「その噂、意図的に広められたんじゃないか？\n　たとえばメスガキの商会あたりが中心になって」\\nw[\\N[1]]":145,"「確かにその形跡はあったニャ！\n　でもなんでそんなことを？」\\nw[\\N[2]の父]":146,"「えっと……実は……」\\nw[\\N[2]]":147,"\n\\>　　　　　　※　ここまでの経緯を説明中　※":148,"「……というわけでして」\\nw[\\N[2]]":149,"「やはり竜の鉤爪が使われてしまったのか！\n　しかも王族である\\N[5]姫がアルテトの化身だとは！」\\nw[伝承学者]":150,"「滅茶苦茶な話ニャ！\n　娘の口から聞いたんでなきゃ、とても信じられないニャ！」\\nw[\\N[2]の父]":151,"「そう、この事実を俺たちがいくら叫んだところで、\n　荒唐無稽すぎて誰も信じやしないだろう。\\nw[\\N[1]]":152,"「パルフューク大公が反逆を企んでアルテトを\n　甦らせ、制御に失敗して自滅――。\\nw[\\N[1]]":153,"「それが『真実』として、王都中に広まっちまってる。\n　\\N[5]の指示で、メスガキがやったに違いない」\\nw[\\N[1]]":154,"「今度こそもう、私たちには手に負えない話ニャ。\\nw[\\N[2]の父]":155,"「あきらめて、どこかに逃げるか隠れるかするのが\n　賢明だと思うニャ」\\nw[\\N[2]の父]":156,"「そんな！？\n　\\N[6]が復活したのは、わたしたちが騙されたせいでも\n　あるのに……！」\\nw[\\N[2]]":157,"「だからと言って、ほぼ孤立無援のキミたちになにが\n　できる？」\\nw[伝承学者]":158,"「そ、それは……」\\nw[\\N[2]]":159,"「ミニャニャちゃんや学者先生の言う通りだ。\n　\\N[2]、お前は父親と一緒に身を隠せ」\\nw[\\N[1]]":160,"「お前は……って、\\N[1]さんはどうする\n　つもりなんですか！？」\\nw[\\N[2]]":161,"「言っただろう。\n　やられっぱなしは性に合わないって。\\nw[\\N[1]]":162,"「あの腹黒ドラゴン姫をブッ潰す方法を、なんとか\n　探し出してやるさ」\\nw[\\N[1]]":163,"「そんな、どうして自分だけ！？\n　これまで一緒にやってきたのに！\\nw[\\N[2]]":164,"「だいたい、\\N[6]と戦ってもお金にならないのに、\n　そこまで執着するなんて……\\N[1]さん、\n　なにか変ですよ！？」\\nw[\\N[2]]":165,"「…………」\\nw[\\N[1]]":166,"「もしかしてキミが\\N[6]との戦いから逃げないのは、\n　\\C[17]血筋\\C[0]に対して責任を感じているからか？」\\nw[伝承学者]":167,"「血筋……？」\\nw[\\N[2]]":168,"「なんのことニャ？」\\nw[\\N[2]の父]":169,"「実は、あの地下遺跡にあった壊れた碑文を復元して\n　みたのだ。\\nw[伝承学者]":170,"「そこに\\C[17]魔法陣\\C[0]の効果について記述があった。\n　そう、その男がうっかり起動させてしまった、あの\n　大型魔法陣だ」\\nw[伝承学者]":171,"「あのときは何も起こらなくて、\\N[1]さんが\n　先生に怒られただけでしたよね？」\\nw[\\N[2]]":172,"「我々にとってはそうだったが、彼にとっては違う体験が\n　あったかもしれない」\\nw[伝承学者]":173,"「意味が分からないニャ？」\\nw[\\N[2]の父]":174,"「碑文には、魔法陣が建国王リジェルダによって作られた\n　ある種の情報伝達装置であると記されていた。\\nw[伝承学者]":175,"「そして魔法陣を起動できるのは、\\C[17]リジェルダの血\\C[0]を\n　色濃く継ぐ者のみであるとも」\\nw[伝承学者]":176,"「\\N[1]、率直に問おう。\n　キミは\\C[17]王族\\C[0]なのではないかね？」\\nw[伝承学者]":177,"「俺が王族？\n　バカも休み休み言えって」\\nw[\\N[1]]":178,"「そ、そうですよ！\n　こんな品のないドスケベ人間が、王族なわけないですよ」\\nw[\\N[2]]":179,"「\\N[2]の偏見に満ちた評価はともかくとして、\n　俺は断じて王族なんかじゃないからな」\\nw[\\N[1]]":180,"「本当かね？」\\nw[伝承学者]":181,"「ああ、本当だとも。\n　ただ\\C[17]父親がアホ王\\C[0]ってだけであって、俺自身は\n　正真正銘の庶民だ！」\\nw[\\N[1]]":182,"「へぇー。お父さんが王様なんですかぁー」\\nw[\\N[2]]":183,"「…………」\\nw[\\N[2]]":184,"\\{「それって王族ってことでしょー？！！」\\}\\nw[\\N[2]]":185,"「いや違うな。\n　王族ってのは血筋じゃなくて、制度に基づく身分だ。\\nw[\\N[1]]":186,"「だから俺は庶民。王族じゃない。\n　以上証明終了」\\nw[\\N[1]]":187,"「へりくつー！！\\nw[\\N[2]]":188,"「……って、えっ、あっ？\n　ほ、ほんとの本当に、王様の子供なんですか？\\nw[\\N[2]]":189,"「つまり……王子様？」\\nw[\\N[2]]":190,"「王子様？」\\nw[\\N[2]の父]":191,"「王子様？」\\nw[伝承学者]":192,"「『王子様』って言葉に対する侮辱ですよ、存在自体が」\\nw[\\N[2]]":193,"「冗談抜きでブン殴るぞ？」\\nw[\\N[1]]":194,"「す、すみません。\n　あまりのことに混乱して、つい本音が……」\\nw[\\N[2]]":195,"「ふむ……あの国王に男児がいたなどという話は\n　聞いたこともないから、とするとキミは当然――」\\nw[伝承学者]":196,"「ああ、庶子――つまり私生児だ。\\nw[\\N[1]]":197,"「王宮で侍女をやってた俺のお袋に、アホ王が手をつけて\n　身籠らせたんだ。\\nw[\\N[1]]":198,"「それも、半年後には他国の姫を正妃として迎え入れるって\n　タイミングでな」\\nw[\\N[1]]":199,"「それって最悪じゃニャいの？」\\nw[\\N[2]の父]":200,"「最悪も最悪。\n　表沙汰にはできない話さ。\\nw[\\N[1]]":201,"「だから腹に俺を抱えたお袋に金品をあてがって、\n　こっそり実家に送り返したんだ。\\nw[\\N[1]]":202,"「以降、アホ王からの接触は一切なし。\n　俺は成人するまでずっと、父親が誰かも知らないまま\n　育てられたよ」\\nw[\\N[1]]":203,"「そ、そんな生い立ちが……」\\nw[\\N[2]]":204,"「言っておくが、俺は自分の境遇に対して不満は\n　感じてないぞ？\\nw[\\N[1]]":205,"「アホ王の血を引いてるって点だけは、残念に思うがな」\\nw[\\N[1]]":206,"「じゃ、じゃあ、\\N[5]姫のことは？\n　腹違いの妹なんですよね？」\\nw[\\N[2]]":207,"「……いまになって、兄だ妹だと言うつもりはない。\\nw[\\N[1]]":208,"「ただ、あんなんでも一応は身内ってことになるからな。\n　他にやれそうなヤツがいない以上、俺が始末をつける\n　しかないだろ」\\nw[\\N[1]]":209,"「じゃ、じゃあ、わたしも手伝います！\n　だってわたしはまだ、\\N[1]さんの\n　奴隷ですから！」\\nw[\\N[2]]":210,"「…………物好きなヤツだな。\n　勝手にすりゃいい」\\nw[\\N[1]]":211,"「はい、勝手にします！」\\nw[\\N[2]]":212,"「自分の娘ながら、まったく損な生き方を選ぶ子ニャー」\\nw[\\N[2]の父]":213,"「しかし始末をつけると言って、なにか具体策は\n　あるのか？」\\nw[伝承学者]":214,"「そんなものはない！\n　……が、気になることが二つある。\\nw[\\N[1]]":215,"「ひとつは、どうして\\N[6]を復活させるのに、\n　\\N[5]のヤツは竜の鉤爪を壊さなかったのか」\\nw[\\N[1]]":216,"「\\N[6]を制御するためには壊しちゃダメって話\n　でしたけど、姫自身が\\N[6]の分身なら鉤爪なんて\n　必要ないですよね？」\\nw[\\N[2]]":217,"「ああ、そのはずだ。\n　そして二つ目の気になる点――。\\nw[\\N[1]]":218,"「『竜の寝床』で\\N[6]に襲われたとき、あれだけの\n　力の差があったのに、なぜ俺たちは逃げ延びることが\n　できたのか？\\nw[\\N[1]]":219,"「副都でもそうだ。\n　虚を突いたとはいえ意外とあっさり逃げることができた。\\nw[\\N[1]]":220,"「なんとなくだが……\\N[6]の動きには制限がかかって\n　いるような、妙な感じがあった」\\nw[\\N[1]]":221,"「壊されなかった竜の鉤爪と、\\N[6]の見せた\n　謎の隙……か。\\nw[伝承学者]":222,"「それならばひとつ、可能性のある推測が立てられるぞ」\\nw[伝承学者]":223,"「ホントですか！？」\\nw[\\N[2]]":224,"「だが、あまり期待しないでくれ。\n　確証はまったくないんだからな」\\nw[伝承学者]":225,"「それでもいい、聞かせてくれ」\\nw[\\N[1]]":226,"「……もしかしたら、死毒の沼に投げ入れられた竜の\n　鉤爪は、三つ揃ったことで今も正常に機能し続けて\n　いるのかもしれない」\\nw[伝承学者]":227,"「どういうことだ？」\\nw[\\N[1]]":228,"「鉤爪が機能しているからこそ、少しだけどキミは\n　無意識に\\N[6]を操れて、窮地を脱することが\n　できたんじゃないか？\\nw[伝承学者]":229,"「竜の鉤爪は本来、子孫に悪竜を操る力を与えようとして\n　リジェルダが用意したものだ。\\nw[伝承学者]":230,"「まさに直系の子孫であるキミのために用意された\n　ようなモノだろう」\\nw[伝承学者]":231,"「なるほど、言われてみれば確かに」\\nw[\\N[1]]":232,"「そしてその“操る力”を\\N[5]姫も必要としているのかも\n　しれない」\\nw[伝承学者]":233,"「えっ、でも、\\N[5]姫が\\N[6]なわけですから……」\\nw[\\N[2]]":234,"「考えてもみたまえ。姫と悪竜が同じ魂を持つとはいえ、\n　存在が二つに分かれてから５００年もの歳月が経って\n　いるんだぞ？\\nw[伝承学者]":235,"「それに\\N[5]姫の体には、悪竜のものだけでなく\n　人間としての魂も同時に存在しているはずだ。\\nw[伝承学者]":236,"「いわば\\N[5]姫は、竜と人間の複合体とでも呼ぶべき\n　未知の生物と言えよう。\\nw[伝承学者]":237,"「そんな異質な存在が、長年に渡って分かたれていた\n　悪竜本体と、スムーズに同化できるものだろうか？」\\nw[伝承学者]":238,"「そうか……本体と分身の同化を確実に行うために、\n　竜の鉤爪の“操る力”が必要だったんだな？\\nw[\\N[1]]":239,"「たとえ分身であっても、確実に同化するには本体を\n　操って自分の支配下に置く必要があったと」\\nw[\\N[1]]":240,"「ああ、私はそう推測する。\n　そしてその同化作業は、まだ完全には終わっていない\n　のかもしれない」\\nw[伝承学者]":241,"「二度も\\N[6]の前から逃げられたのは、あいつが\n　まだ本調子じゃなかったからってワケだ」\\nw[\\N[1]]":242,"「まあ、希望的観測かもしれないがね。\n　ともあれ、もし毒沼の底でいまも本当に鉤爪が作動して\n　いるとしたら――\\N[1]。\\nw[伝承学者]":243,"「キミの中に流れるリジェルダの血の力を高めることで、\n　今度は意識的に\\C[17]\\N[6]をコントロールできるように\n　なる\\C[0]かもしれない」\\nw[伝承学者]":244,"「どういうことだ？　血の力を高めるだと？」\\nw[\\N[1]]":245,"「そう、\\C[17]『地母神の乳』\\C[0]を使えば、あるいは血の力を\n　覚醒させられる可能性が……」\\nw[伝承学者]":246,"「ちょっと待て、いったい何の話だ！？　乳？」\\nw[\\N[1]]":247,"「『地母神の乳』だ。\n　飲めば自分の血の中に眠っている才覚や能力が\n　活性化するという、伝説の泉の水だ」\\nw[伝承学者]":248,"「そんなお伽話に出てきそうな泉、実在するんですか？」」\\nw[\\N[2]]":249,"「存在をほのめかす伝承ならいくつもある。\n　だが実物となると――探してみないことには、なんとも\n　言えないな。\\nw[伝承学者]":250,"「伝わるところによれば、この王都から北へ行った先に\n　ある\\C[17]『迷いの森』\\C[0]の奥に、それは湧き出ているのだと\n　いう」\\nw[伝承学者]":251,"「つまりそいつでご先祖様の血の力を強くして、\\N[6]を\n　屈服させろと」\\nw[\\N[1]]":252,"「でも\\N[5]姫だって、直系の子孫ニャわけでしょ？\n　力の綱引きになったら勝てるのニャ？」\\nw[\\N[2]の父]":253,"「そう言われると……\\N[5]姫本人が悪竜\\N[6]でも\n　あるわけだから、こっちが大分不利なような……」\\nw[\\N[2]]":254,"「そこは、地母神の乳でどれだけ能力を活性化できるかに\n　賭かっているとしか――」\\nw[伝承学者]":255,"「他に案がないなら、それで行くしかないだろ。\n　ダメだったら、そのときまた考えりゃいいんだよ」\\nw[\\N[1]]":256,"「羨ましい性格ニャー」\\nw[\\N[2]の父]":257,"「そうだ、『迷いの森』へ行くなら、\\C[17]生贄\\C[0]を用意して\n　おかないとダメだぞ」\\nw[伝承学者]":258,"「いっ、いけにえ！？」\\nw[\\N[2]]":259,"「これも伝承にあるのだが、迷いの森の最深部へ行くには、\n　この地の先住民である\\C[17]猫人\\C[0]を生贄として捧げる必要がある\n　のだそうだ。\\nw[伝承学者]":260,"「それも種族として最も純血種に近い、\\C[17]茶色髪の猫人\\C[0]を\n　捧げるべきだと」\\nw[伝承学者]":261,"「なんだ、じゃあ\\N[2]じゃダメなのか」\\nw[\\N[1]]":262,"「わたしでもＯＫだったら生贄にするんですか！？\n　ひどい！」\\nw[\\N[2]]":263,"「なら、そこは奴隷で用意するとして」\\nw[\\N[1]]":264,"「必要なら、躊躇なく奴隷を生贄にしちゃうのニャ。\n　そういうとこ、\\N[5]姫との血のつながりを感じる\n　のニャ」\\nw[\\N[2]の父]":265,"「フンッ！　一緒にするな。\n　俺は好き好んで、残虐な真似なんかしないぞ」\\nw[\\N[1]]":266,"「ん？　なんか店の外が騒がしくないか？」\\nw[\\N[1]]":267,"「酔っぱらいがケンカでもしてるんじゃニャいかな？」\\nw[\\N[2]の父]":268,"「な、なに？\n　兵隊さんがウチみたいな店になんのご用？」\\nw[マスター]":269,"「我々は王都近衛隊である！\\nw[近衛兵]":270,"「この店に、反逆者パルフューク大公の協力者が匿われて\n　いるとの情報が寄せられた！\\nw[近衛兵]":271,"「よって、これより強制捜査を行う！\n　全員その場から動かぬように！」\\nw[近衛兵]":272,"「こ、これってもしかして、わたしたちのこと\n　探してるんじゃ！？」\\nw[\\N[2]]":273,"「だろうな。\n　\\N[5]の差し金に違いない」\\nw[\\N[1]]":274,"「二人とも、裏口から逃げるニャ！」\\nw[\\N[2]の父]":275,"「ここで捕まっては\\N[6]の思う壺だぞ。\n　さあ、早く！」」\\nw[伝承学者]":276,"「わかった。じゃあな！」\\nw[\\N[1]]":277,"「父さん、また後でね！」\\nw[\\N[2]]":278,"ユマ":279,"ユマ父2":280,"「\\N[2]、気をつけて行動するんにゃよ？」\\nw[\\N[2]の父]":281,"「\\N[2]ッ、おかえりニャン！\n　父さん心配だったニャ！」\\nw[\\N[2]の父]":282,"「う、うん……大変だったけど、わたしは大丈夫だよ」\\nw[\\N[2]]":283,"「……どうやらまだ、今の父さんに抵抗があるようだニャ？\\nw[\\N[2]の父]":284,"「それならいっそ、母さんと呼んでも――」\\nw[\\N[2]の父]":285,"\\>「絶対よばない」\\nw[\\N[2]]":286,"「それでミニャニャちゃんよ、こっちは収穫があったん\n　だが、そっちはどうだ？　進展はあったか？」\\nw[\\N[1]]":287,"「そうそう、話さなきゃならないことがあるニャ！\\nw[\\N[2]の父]":288,"「まず、私たちをハメたあの商会だけど、王都や副都を\n　中心にどんどん商売の手を広げていってるニャ！\\nw[\\N[2]の父]":289,"「あきらかに不自然な成長っぷりで、経営努力だけじゃ\n　説明がつかないニャ」\\nw[\\N[2]の父]":290,"「\\N[3]に指示を出してる王族の誰かが、裏から援助を？」\\nw[\\N[2]]":291,"「おそらくな。\\nw[\\N[1]]":292,"「だがメスガキが竜の鉤爪をひとつしか入手できなかった\n　と知れば、その援助もいつまで続くか。見ものだな」\\nw[\\N[1]]":293,"「そうニャ！　竜の鉤爪についてもひとつ、いい知らせ\n　があるニャ！\\nw[\\N[2]の父]":294,"「私が前に会った、鉤爪について調査してるっていう\n　伝承学者にゃんだけど、彼の居所が分かったのニャ！」\\nw[\\N[2]の父]":295,"「大神殿の書庫に入れてもらえない、って愚痴ってたって\n　いう学者か？」\\nw[\\N[1]]":296,"「その学者先生ニャ。\n　彼はいま、この王都の近くにある\\C[17]地下遺跡の最深部\\C[0]で、\n　発掘作業をしているらしいニャ」\\nw[\\N[2]の父]":297,"「その学者の人に竜の鉤爪と粘土板を見せれば、なにか\n　分かるかもしれませんね」\\nw[\\N[2]]":298,"「ああ、地下遺跡に行ってみるか」\\nw[\\N[1]]":299,"「でもいきなり訪ねて質問しても、親切に答えてくれる\n　とは限らないニャ。\\nw[\\N[2]の父]":300,"「あの学者先生はケチだから。\n　手土産くらい持って行った方がいいと思うニャ」\\nw[\\N[2]の父]":301,"「手土産って……お菓子の詰め合わせとか？」\\nw[\\N[2]]":302,"「奴隷商人なんだから、労働用の奴隷とかどうニャ？\\nw[\\N[2]の父]":303,"「発掘作業は重労働で、奴隷を何人も使うそうだから、\n　きっと喜ばれるニャ」\\nw[\\N[2]の父]":304,"「それなら\\C[17]肉体労働用の奴隷\\C[0]を\\C[17]３人\\C[0]ばかり連れていくか」\\nw[\\N[1]]":305,"「３人とは太っ腹ニャ！\n　それならあのケチンボな学者先生も、口が緩むニャ」\\nw[\\N[2]の父]":306,"\\>　※　\\C[17]肉体労働用の奴隷を３人\\C[0]用意して、地下遺跡の　※\n\\>　※　最深部にいる伝承学者を訪ねよう。　　　　　　※\\<":307,"「学者先生は地下遺跡の最深部にいるニャ。\n　モンスターの出没する場所だから、気をつけるニャよ？」\\nw[\\N[2]の父]":308,"「おかえりニャ。\n　伝承学者の先生には会えたかニャ？」\\nw[\\N[2]の父]":309,"「それについてなんだが……。\n　どこか人のいないところで話せるか？」\\nw[\\N[1]]":310,"「別にここでも、誰も聞いてニャいと思うけど？」\\nw[\\N[2]の父]":311,"「用心のためだ」\\nw[\\N[1]]":312,"「じゃあ、店の倉庫の方に行くニャ」\\nw[\\N[2]の父]":313,"「急いで副都へ行く？\n　なんだか分からニャいけど、無理はしちゃダメにゃよ？」\\nw[\\N[2]の父]":314,"「罠かもしれニャいから、くれぐれも気をつけるんニャよ？」\\nw[\\N[2]の父]":315,"「鉤爪を捨てに行く！？\n　……わかったニャ、必ず無事に帰ってくるんニャよ？」\\nw[\\N[2]の父]":316,"「無事に戻ってきてくれたのは嬉しいけど……\n　なんでアルテトが復活したなんて話になってるニャ！？」\\nw[\\N[2]の父]":317,"「色々とあったんだよ！\n　ここじゃアレだから、説明は別室でするぞ」\\nw[\\N[1]]":318,"「だったらついでに、キミを訪ねてきたお客さんも\n　紹介するニャ」\\nw[\\N[2]の父]":319,"「俺に客だと？」\\nw[\\N[1]]":320,"「まさか、また刺客じゃ？」\\nw[\\N[2]]":321,"「それは無いから安心していいニャ」\\nw[\\N[2]の父]":322,"客1":323,"「くっそぉー！　ミニャニャちゃん戻ってきてくれぇ！」\\nw[客]":324,"「ミニャニャちゃん、まじ天使。\n　無精ひげ生えてるけど」\\nw[客]":325,"客2":326,"「ミニャニャちゃんがいないなんて！\n　この店での楽しみが半減……いや九割減だよ！」\\nw[客]":327,"「ミニャニャちゃんはみんなの愚痴を、嫌な顔ひとつ\n　しないで聞いてくれるんだ」\\nw[客]":328,"料理1":329,"料理2":330,"客3":331,"「副都には知り合いがいるんだが、無事だろうか……」\\nw[客]":332,"「ここはいい店だよ。\n　貧民街にあるのに、ぼったくりもしないし」\\nw[客]":333,"客4":334,"「副都はモンスターとの戦闘で、かなりの兵力を失った\n　らしいね」\\nw[客]":335,"「女の子のいる店より、こういうところの方が\n　なんだかくつろげるんだよね」\\nw[客]":336,"客5":337,"「ミニャニャちゃん、お店やめちゃったんだって？\n　ちょっと残念だなぁ」\\nw[客]":338,"「王都にもアルテトが来るなら、その前にさっさと\n　地方へ逃げるかな」\\nw[客]":339,"「ミニャニャちゃんって、前に取り引きのあった商会の\n　経営者に似てるんだけど……まさかね」\\nw[客]":340,"客6":341,"「長く平穏な時が続いてきたが、そろそろ動乱の時代が\n　くるのかもな」\\nw[客]":342,"「この店はお気に入りでな、週に一度は飲みに来ているよ」\\nw[客]":343,"料理3":344,"料理4":345,"メイド":346,"伝承学者":347,"近衛隊兵士1":348,"近衛隊兵士2":349,"近衛隊兵士3":350,"裏口":351,"手紙":352},"extension":"json","dataType":"map","filename":"Map301","basename":"Map301.json","path":"data/Map301.json","relPath":"data/Map301.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":353,"percent":0},"cellInfo":[]},"data/Map302.json":{"data":[["脱出用魔法陣",""],["ダンジョンの外へ脱出しますか？",""],["脱出する",""],["脱出しない",""],["createFilter 1 twist 2",""],["setFilter 1 408 312 416 0",""],["moveFilter 1 408 312 816 13 120",""],["eraseFilter 1",""],["EV002",""],["敵索敵スタート",""],["PSS start",""],["最奥部",""],["EXIT",""],["EV005",""],["EV006",""],["EV007",""],["EV008",""],["EV009",""],["敵01",""],["<PsensorS:\\V[1166] Rv\\S[22]>",""],["探索範囲にプレイヤー侵入",""],["SmartPath 0 -1",""],["SmartPath 0 cancel",""],["敵に見つかっている場合の戦闘",""],["勝利したとき",""],["PSS t_stop",""],["逃げたとき",""],["戦闘から離脱したときの処理",""],["PSS t_start",""],["敵がプレイヤーを見失ったときの処理",""],["敵02",""],["敵03",""],["敵04",""],["敵05",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["EV016",""],["壁ひび",""],["※\nアイテム：耐衝撃剤\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["対バルコルド戦",""],["「あれは……！」\\nw[\\N[1]]",""],["「どうしたんですか、\\N[1]さん？\\nw[\\N[2]]",""],["「……あっ！？」\\nw[\\N[2]]",""],["「モンスターには苦労させられたけど、やっと最深部に\n　たどり着いたわね」\\nw[\\N[3]]",""],["「はい、お嬢様」\\nw[\\N[4]]",""],["すでに他の鉤爪ダンジョンイベントを終えているとき\n↓　　↓　　↓",""],["「この前は\\N[2]とあのフード男にしてやられたけど、\n　今度こそ『竜の鉤爪』を持って帰るわよ！\\nw[\\N[3]]",""],["「でないと、あの方に見捨てられてしまうかも……」\\nw[\\N[3]]",""],["「お嬢様、ご安心ください。\n　今回は必ずや、あの邪魔者どもが来ても阻止します。\\nw[\\N[4]]",""],["「そういうわけだ！\n　出てこい！　アサシン！」\\nw[\\N[4]]",""],["「えっ！？」\\nw[\\N[3]]",""],["まだ他の鉤爪ダンジョンイベントをひとつもやっていないとき\n↓　　↓　　↓",""],["「それにしても、こんな場所にあるなんてね。\\nw[\\N[3]]",""],["「あの方の紹介で大聖堂の書庫を利用できたから、\n　どうにか手がかりをつかめたけど――。\\nw[\\N[3]]",""],["「普通分かんないわよ、『竜の鉤爪』の隠し場所\n　なんて！」\\nw[\\N[3]]",""],["「お嬢様、いますぐ鉤爪の確保に向かってください」\\nw[\\N[4]]",""],["「え、なに？　どうしたのよ急に？」\\nw[\\N[3]]",""],["「そこにいるのは分かっているぞ！　出てこい！\n　出て来なければこちらから行くぞ！」\\nw[\\N[4]]",""],["「チッ……！　気づいてやがったか！」\\nw[\\N[1]]",""],["「ど、どうしましょう！？」\\nw[\\N[2]]",""],["「戦うしかないだろ。\n　あっちはやる気満々みたいだしな」\\nw[\\N[1]]",""],["「\\N[2]とフード男！？\\nw[\\N[3]]",""],["「このっ……また邪魔しに来たの！？」\\nw[\\N[3]]",""],["「な、何度だって邪魔するよ！\n　わたしは\\N[3]に勝って、必ず奴隷身分から解放\n　されるもん！」\\nw[\\N[2]]",""],["「あたしに勝つぅー！？\n　あんたがぁ！？\\nw[\\N[3]]",""],["「どこまでツケ上がるつもりよ、この奴隷猫！\n　あたしの出世を妨害するとか、何様のつもり！？」\\nw[\\N[3]]",""],["「ツケ上がってるのはお前だろう、メスガキ！\n　胸のサイズ以外、\\N[2]に勝てる要素が皆無のくせに」\\nw[\\N[1]]",""],["「なっ……！？\n　このアサシン崩れのフード野郎ッ！！」\\nw[\\N[3]]",""],["「挑発に乗らないでください、お嬢様。\\nw[\\N[4]]",""],["「それよりも今は、鉤爪を先に。\n　こいつらの相手は私がやりますので」\\nw[\\N[4]]",""],["「ハッ……そうだった！\\nw[\\N[3]]",""],["「鉤爪を取ってくるから、あなたはそいつらをボコボコに\n　しちゃいなさい！」\\nw[\\N[3]]",""],["「仰せのままに」\\nw[\\N[4]]",""],["「あっ、\\N[3]が……！」\\nw[\\N[2]]",""],["「ここから先は通さん！\n　竜の鉤爪は今度こそお嬢様のものだ！」\\nw[\\N[4]]",""],["「上等だ！　いくぞ\\N[2]！」\\nw[\\N[1]]",""],["「はいっ！」\\nw[\\N[2]]",""],["「な……なんであんたたちが、ここにいるのよ！？」\\nw[\\N[3]]",""],["「気にすんな。\n　ちょっと近くを通りがかっただけだから」\\nw[\\N[1]]",""],["「ふざけんなっ！」\\nw[\\N[3]]",""],["「おそらくこいつらは、私たちに意趣返しするつもりで、\n　鉤爪捜索の邪魔をしに来たのでしょう」\\nw[\\N[4]]",""],["「なんて性根の腐ったヤツラなのかしら！」\\nw[\\N[3]]",""],["「お前が言うか……」\\nw[\\N[1]]",""],["「\\N[3]、あなたたちが海賊とグルになって、ウチの\n　商会を破産に追い込んだことは分かってる！\\nw[\\N[2]]",""],["「わたし、絶対に泣き寝入りなんてしないから！」\\nw[\\N[2]]",""],["「あーあー、泣き虫\\N[2]がイキがっちゃって！\n　あんたがどうあがいた所で、もう勝敗はついてるって\n　いうのに」\\nw[\\N[3]]",""],["「そいつは早計だぜ？\n　俺たちは勝負をひっくり返すために来たんだからな」\\nw[\\N[1]]",""],["「お嬢様、こいつらの相手は私がしますので、先に\n　鉤爪の確保をお願いします」\\nw[\\N[4]]",""],["「わかったわ。\n　遠慮せずギッタンギッタンにしてやりなさい！」\\nw[\\N[3]]",""],["「ここから先は通さん！\n　竜の鉤爪はお嬢様のものだ！」\\nw[\\N[4]]",""],["戦闘勝利↓",""],["「どうした、大口叩いてた割にこれで終わりか？」\\nw[\\N[1]]",""],["「なるほど、予想していたより戦闘慣れしているようだ。\n　なかなかに手ごわい。\\nw[\\N[4]]",""],["「――だが時間稼ぎにはこれで十分」\\nw[\\N[4]]",""],["「な、なに！？」\\nw[\\N[1]]",""],["「\\N[1]さん！\n　\\N[3]が竜の鉤爪を――」\\nw[\\N[2]]",""],["FocusCamera 32 20 60",""],["「竜の鉤爪、いただいたわ！！」\\nw[\\N[3]]",""],["「しまった！　メスガキから鉤爪を取り上げないと！」\\nw[\\N[1]]",""],["「もう遅いわよッ、バーカッ！！」\\nw[\\N[3]]",""],["「今は退いてやろう。\\nw[\\N[4]]",""],["「だが近いうちにキサマとは決着をつけてやる。\n　首を洗って待っていろ、アサシン！」\\nw[\\N[4]]",""],["ResetFocus 60",""],["「くそっ、やられた！」\\nw[\\N[1]]",""],["「お、追いかけないと！」\\nw[\\N[2]]",""],["「いや、もう無理だろう。\\nw[\\N[1]]",""],["「メスガキ一匹ならともかく、あの\\N[4]って男が\n　いるんじゃ追跡は難しい」\\nw[\\N[1]]",""],["「そんな……」\\nw[\\N[2]]",""],["鉤爪をまったく持っていないとき",""],["「三つとも手に入れてやるつもりだったが、幸先の悪い\n　出だしになっちまったな。\\nw[\\N[1]]",""],["「でもまあ、ここ以外の鉤爪はまだ、見つからずに\n　残っているかもしれん。\\nw[\\N[1]]",""],["「気を取り直して、他の二つを探しにいくぞ！」\\nw[\\N[1]]",""],["「そ、そうですね！\n　じゃあ、もうここに用はありませんから、私たちも\n　外に出ましょう！」\\nw[\\N[2]]",""],["鉤爪を一つ持っているとき",""],["「二つ目も手に入れてやるつもりだったが、しくじったな。\\nw[\\N[1]]",""],["「でもまあ、鉤爪の一つはすでに確保してあるんだ。\n　気を取り直して、残り一つも取りにいくぞ！」\\nw[\\N[1]]",""],["他二つの鉤爪を持っているとき",""],["「最後の鉤爪回収で、ケチがついちまったな。\\nw[\\N[1]]",""],["「でもまあ、３個中２個は俺たちで確保してるんだ。\n　こちらが有利には違いない。\\nw[\\N[1]]",""],["「あとはこの手元の鉤爪を守り抜けばいい」\\nw[\\N[1]]",""],["「そ、そうですよね！\n　じゃあ、もうここに用はありませんから、私たちも\n　外に出ましょう！」\\nw[\\N[2]]",""],["「……ん？\n　ちょっと待て、なにか――」\\nw[\\N[1]]",""],["「どうしたんですか？」\\nw[\\N[2]]",""],["「箱の中にまだなにか残ってるぞ」\\nw[\\N[1]]",""],["「えっ！？」\\nw[\\N[2]]",""],["「メスガキのヤツ、鉤爪を持っていくことしか頭になくて\n　目に入らなかったんだろうな。\\nw[\\N[1]]",""],["「これは……\\C[17]粘土板\\C[0]か？\n　なにか文字みたいなのが刻まれてるな」\\nw[\\N[1]]",""],["「読めそうですか？」\\nw[\\N[2]]",""],["「いや、全然知らない文字だ。古代文字か？\\nw[\\N[1]]",""],["「ともあれ、鉤爪と一緒に置いてあったということは、\n　なにか関係のある代物なんだろう。\\nw[\\N[1]]",""],["「竜の鉤爪は逃したが、どうやら無駄足には\n　ならなかったな」\\nw[\\N[1]]",""],["\\C[17]『古代の粘土板』\\C[0]を入手した！",""],["メインシナリオ\\C[17]『砂漠に埋もれし』\\C[0]を一応（？）達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["以下、三ヶ所ともクリアした場合のイベント\n↓　　↓　　↓",""],["「結局、竜の鉤爪は３個中の２個を手に入れましたけど、\n　これからどうします……？」\\nw[\\N[2]]",""],["「どうにかして、この粘土板に書かれている内容を\n　解読したいな。\\nw[\\N[1]]",""],["「内容によっちゃ、メスガキどもを更に追い詰めて\n　やれるかもしれないぞ。\\nw[\\N[1]]",""],["「あと、メスガキどもがこれからどう動くかも気になるな」\\nw[\\N[1]]",""],["「じゃあ一度、王都の貧民街にいる父のところへ\n　行きませんか？\\nw[\\N[2]]",""],["「なにか新しい情報が入っているかもしれませんし」\\nw[\\N[2]]",""],["「そうだな、王都へ向かうか」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『粘土板解読』\\C[0]を受けた！",""],["\\>　　　※　\\C[17]王都貧民街の酒場\\C[0]にいる、\\N[2]の父親の　※\n\\>　　　※　ところへ行こう。　　　　　　　　　　　※\\<",""],["エルラ",""],["バルコルド",""],["竜の鉤爪宝箱",""],["ユマ",""],["EV023",""],["EV024",""],["モンスター進入禁止",""],["回復魔法陣",""],["床トラップ",""],["床針トラップ制御",""],["床針検知",""],["トラップ無敵時間",""],["EV057",""],["橋渡し1",""]],"context":[["Map302/events/1/name"],["Map302/events/1/pages/0/list/0/message/noPicture/bottom"],["Map302/events/1/pages/0/list/2/Show Choices/2/1from2"],["Map302/events/1/pages/0/list/2/Show Choices/2/2from2"],["Map302/events/1/pages/0/list/18/Plugin Command"],["Map302/events/1/pages/0/list/19/Plugin Command"],["Map302/events/1/pages/0/list/20/Plu