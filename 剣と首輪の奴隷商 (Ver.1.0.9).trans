:16>":34,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":35,"戦闘マーク":36},"extension":"json","dataType":"map","filename":"Map044","basename":"Map044.json","path":"data/Map044.json","relPath":"data/Map044.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":37,"percent":0},"cellInfo":[]},"data/Map045.json":{"data":[["馬車",""],["EV002",""],["EV003",""],["EV004",""],["宿泊テント",""],["EV005",""],["EV006",""],["EV007",""],["トロッコ",""],["EV009",""],["坑道",""],["EV010",""],["EV011",""],["管理小屋",""],["坑夫",""],["「あーっ、まったく！　これじゃ仕事にならん！」\\nw[坑夫]",""],["「坑道の中にモンスターが出ちまってな、\n　いまこの鉱山は開店休業状態だ」\\nw[坑夫]",""],["「モンスターをぜんぶ倒しただって！？\n　おいおい、マジか？」\\nw[坑夫]",""],["「あんたのお陰で仕事が再開できた。\n　ありがとう」\\nw[坑夫]",""],["「聞いたよ。\n　モンスターだけじゃなく盗賊まで倒してくれたんだって？\\nw[坑夫]",""],["「ありがとう、これは俺からの感謝の気持ちだ。\n　受け取ってくれ」\\nw[坑夫]",""],["PNDK_LC getSurplusWeights 15",""],["装飾品\\C[17]『\\an[203]』\\C[0]を受け取った！",""],["鉱夫が装飾品\\C[17]『\\an[203]』\\C[0]を渡そうとしたが、積載可能な\n重量をオーバーしているため受け取れない。",""],["柵",""],["中に入れないよう、柵が設置されている。",""],["「くそっ、一体どこから入り込んできやがったんだ！？」\\nw[坑夫]",""],["「あのモンスターどもを倒した？\n　あんたが？」\\nw[坑夫]",""],["「なんだってモンスターなんかが……」\\nw[坑夫]",""],["「ほ、ほんとに坑道の中はもう安全なのか！？」\\nw[坑夫]",""],["「あいつらが出てから、もう何日になる？\n　いつになったら兵隊は助けにきてくれるんだ？」\\nw[坑夫]",""],["「あんた商人なんだろ？\n　それがモンスター退治って……すごいな」\\nw[坑夫]",""],["商人",""],["「鉱石の買い付けにきたというのに、まさかこんな事態に\n　なっているとは……」\\nw[商人]",""],["「ありがとう！\n　これで商売が再開できるよ！」\\nw[商人]",""],["「新女王が即位したなら、この鉱山の扱いも変わるかもね。\n　良い方にか、それとも悪い方にかは分からないけど」\\nw[商人]",""],["「この鉱山は鉄や金だけでなく、宝石も産出するんだ。\n　王国の金蔵と言われる所以さ」\\nw[商人]",""],["EV019",""],["EV020",""],["テント",""],["初回イベント",""],["P_D_FILENAME name_town\\V[101]",""],["「ここが\\C[17]鉱山\\C[0]だ。\n　銅・鉄・ミスリルに宝石――色々と採れるらしいぞ」\\nw[\\N[1]]",""],["「もしかして、鉱石を取り引きできたら儲けも\n　大きいんじゃ？」\\nw[\\N[2]]",""],["「もしかしなくても儲けは出るだろうさ。\n　ただし取引に加われる商人は限定されてる。\\nw[\\N[1]]",""],["「いきなり鉱石を売ってくれと言っても、追い返される\n　のがオチだ」\\nw[\\N[1]]",""],["「そうなんですか、残念ですね」\\nw[\\N[2]]",""],["「ま、俺たちの仕事は鉱山の状況調査だ。\n　それをきっちりやれば報酬はもらえるわけだしな。\\nw[\\N[1]]",""],["「まずは\\C[17]鉱山の責任者\\C[0]を探して、そいつから話を\n　聞くとしよう」\\nw[\\N[1]]",""],["村人（奴隷買い取り）",""],["「モンスターは怖いが、仕事が止まって休めるのは\n　ありがてぇ」\\nw[鉱山奴隷]",""],["「これでまた、あの地獄の労働の再開かよ……」\\nw[鉱山奴隷]",""],["「とにもかくにも、これで体を休められるぜ……」\\nw[鉱山奴隷]",""],["「モンスター……倒しちまったのか……」\\nw[鉱山奴隷]",""],["焚火",""],["光",""],["「クタクタダカラ、ヤスメルノ、ウレシイ」\\nw[鉱山奴隷]",""],["「マタ、イシホリ……」\\nw[鉱山奴隷]",""],["奴隷買い取り（フキダシ）",""],["落ちてる精霊石（街）",""],["EV030",""],["フクロウ",""],["マップ取得",""],["FocusCamera 17 17 120",""],["ZoomOut 2.5 120",""],["\\C[17]\\V[919]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["聖堂通行不可スイッチ",""],["EV035",""],["藁山",""],["EV037",""],["EV038",""]],"context":[["Map045/events/1/name"],["Map045/events/2/name"],["Map045/events/3/name"],["Map045/events/4/name"],["Map045/events/4/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map045/events/5/name"],["Map045/events/6/name"],["Map045/events/7/name"],["Map045/events/8/name"],["Map045/events/9/name"],["Map045/events/9/pages/0/list/9/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map045/events/10/pages/0/list/9/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map045/events/10/name"],["Map045/events/11/name"],["Map045/events/11/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map045/events/12/name","Map045/events/15/name","Map045/events/16/name","Map045/events/17/name","Map045/events/23/name","Map045/events/24/name","Map045/events/27/name"],["Map045/events/12/pages/0/list/0/message/noPicture/bottom"],["Map045/events/12/pages/1/list/0/message/noPicture/bottom"],["Map045/events/12/pages/2/list/0/message/noPicture/bottom"],["Map045/events/12/pages/3/list/0/message/noPicture/bottom","Map045/events/12/pages/4/list/1/message/noPicture/bottom"],["Map045/events/12/pages/4/list/6/message/noPicture/bottom"],["Map045/events/12/pages/4/list/9/message/noPicture/bottom"],["Map045/events/12/pages/4/list/12/Plugin Command"],["Map045/events/1