,[{"headerIndex":874,"headerParam":["",0,0,2]}],[{"headerIndex":879,"headerParam":["",0,0,2]}],[{"headerIndex":886,"headerParam":["",0,0,2]}],[{"headerIndex":888,"headerParam":["",0,0,2]}],[{"headerIndex":892,"headerParam":["",0,0,2]}],[{"headerIndex":894,"headerParam":["",0,0,2]}],[{"headerIndex":897,"headerParam":["",0,0,2]}],[{"headerIndex":902,"headerParam":["",0,0,2]}],[{"headerIndex":908,"headerParam":["",0,0,2]}],[{"headerIndex":913,"headerParam":["",0,0,2]}],[{"headerIndex":917,"headerParam":["",0,0,2]}],[{"headerIndex":941,"headerParam":["",0,0,2]}],[{"headerIndex":945,"headerParam":["",0,0,2]}],[{"headerIndex":949,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098117969364.js","start":0,"end":6,"leftHand":{"type":"","context":[]}}]],"indexIds":{"EV001":0,"clear_all_weathers":1,"回復魔法陣":2,"EV003":3,"アルテト復活Ev":4,"「どうやらこれが、\\C[17]死毒の沼\\C[0]のようだな」\\nw[\\N[1]]":5,"「ひどい臭い……それにこの煙……」\\nw[\\N[2]]":6,"「吸い込まないよう気をつけろ。\n　どんな害があるか分からんからな」\\nw[\\N[1]]":7,"「こんなに広くて毒々しい沼に竜の鉤爪を捨てれば、\n　二度と拾い上げることなんて出来ないでしょうね」\\nw[\\N[2]]":8,"「ああ。\n　毒水に守られて、鉤爪は二度と人間の手に渡ることは\n　ない……。\\nw[\\N[1]]":9,"「そのはずだ。\n　ああ、そのはずだが……」\\nw[\\N[1]]":10,"「どうかしましたか？\n　早く竜の鉤爪を捨てちゃいましょうよ」\\nw[\\N[2]]":11,"「なにか引っかかるんだよなぁ……」\\nw[\\N[1]]":12,"「なにかって、なにがですか？」\\nw[\\N[2]]":13,"「わからん。\n　ただ喉の奥に魚の小骨が刺さったような、すっきり\n　しない感じがするんだ」\\nw[\\N[1]]":14,"「はぁ？\n　よく分かりませんけど……\\nw[\\N[2]]":15,"「でも、やることに変わりはないですよね？\n　危険を冒してこんな場所まで来たんですから」\\nw[\\N[2]]":16,"「……そうだな。\n　いつまたパルフューク大公の刺客や、メスガキが\n　来るか分かったもんじゃないし――\\nw[\\N[1]]":17,"「この元凶を、とっとと沼に沈めちまおう」\\nw[\\N[1]]":18,"「えっと……これで終わり……で、いいんですよね？」\\nw[\\N[2]]":19,"「そうだ。\n　竜の鉤爪は二つとも死毒の沼の底に沈んだ。\\nw[\\N[1]]":20,"「お姫様の依頼は完了。\n　そんでもって、大公の野望は打ち砕かれた」\\nw[\\N[1]]":21,"メインシナリオ\\C[17]『竜の寝床へ』\\C[0]を達成した！":22,"\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！":23,"「なんと言いますか……最後はあっけなく終わりましたね」\\nw[\\N[2]]":24,"「これまで波乱がありすぎたから、拍子抜けした\n　気分になるな」\\nw[\\N[1]]":25,"「でもこれでやっと、奴隷身分から解放されるんですね！」\\nw[\\N[2]]":26,"「お前が俺の下で働く必要も無くなるわけだ」\\nw[\\N[1]]":27,"「えっ……？\\nw[\\N[2]]":28,"「あっ、そ、そうですよね……」\\nw[\\N[2]]":29,"「まあ、お前にはこれまで十分に働いてもらったからな。\n　元は取れたし、いい買い物だったぜ」\\nw[\\N[1]]":30,"「…………」\\nw[\\N[2]]":31,"「\\N[1]さん……わ、わたし……\n　\\N[1]さんが望むなら、その、これからも――」\\nw[\\N[2]]":32,"\\{「あーはっはっはぁッ！！」\\}\\nw[？？？]":33,"FocusCamera 30 12 120":34,"「また会ったわね！\n　泣き虫\\N[2]にフード野郎！」\\nw[\\N[3]]":35,"「\\N[3]！？　な、なんでここに！？」\\nw[\\N[2]]":36,"「メスガキ！　お前ら、俺たちの後を尾けてきたのか！？」\\nw[\\N[1]]":37,"「はぁ？　なに言ってんの？\n　あたしたちは、あんたらより先にここへ着いてたわよ！」\\nw[\\N[3]]":38,"「なにっ？！」\\nw[\\N[1]]":39,"「なにも知らないマヌケが踊ってる様を見るのは\n　楽しかったわよ！」\\nw[\\N[3]]":40,"「なにを言ってるか分かんないけど……\\N[3]！\n　もう全部終わったんだよ！\\nw[\\N[2]]":41,"「竜の鉤爪は二つとも毒沼の底に沈んで、回収は不可能！\n　\\N[3]が持ってる一つだけじゃ、アルテトを甦らす\n　ことは出来ないんだから！」\\nw[\\N[2]]":42,"「その通り。\n　竜の鉤爪は三つがそろってこそ、力を発揮する\n　マジックアイテムだ」\\nw[\\N[4]]":43,"「だからね、三つとも同じようにしてやるわ！」\\nw[\\N[3]]":44,"「最後の鉤爪を投げ捨てた！？」\\nw[\\N[2]]":45,"「なんのつもりだメスガキ！？」\\nw[\\N[1]]":46,"「まだ分からないの？\n　全部、あの方の書いたシナリオ通りだったって\n　ことよ！」\\nw[\\N[3]]":47,"「え？　あの方ってパルフューク大公でしょ？\n　それがなんで計画通りだなんて――」\\nw[\\N[2]]":48,"「ちがうぞ\\N[2]！\n　くそっ、そういうことか！　まんまと騙されたぜ……！」\\nw[\\N[1]]":49,"「ようやく気付いたか、アサシン。\n　我々が誰に仕えているか。\\nw[\\N[4]]":50,"「お前たちが誰の指図でここまでやって来たか」\\nw[\\N[4]]":51,"「ちょ、ちょっと待って……え、それってまさか……」\\nw[\\N[2]]":52,"「悪竜が封印されたこの毒沼に、竜の鉤爪が三つとも\n　そろった！\\nw[\\N[3]]":53,"「いよいよ目覚めの刻よ！」\\nw[\\N[3]]":54,"「あはっ！　あはははははっ！！\n　甦った！　ついに甦ったわッ！！\\nw[\\N[3]]":55,"「伝説の古代竜\\C[17]アルテト\\C[0]よ！！」\\nw[\\N[3]]":56,"「なっ、なんと凄まじい……！\n　これほどの怪物とは！」\\nw[\\N[4]]":57,"「ひっ、あっ……あわわわわわっ……！\n　％＃＄＆＝￥＊〒＆＄ッ？！」\\nw[\\N[2]]":58,"「おいっ、落ち着け！　ゆっくり呼吸しろ！\n　いいか、あんなモンただのデカいトカゲだ！」\\nw[\\N[1]]":59,"「そそそっ、そんなわけないでしょう！？\n　あの伝説の悪竜アルテトなんですよぉッ！！」\\nw[\\N[2]]":60,"「見なさい！　\\N[2]！　フード野郎！\\nw[\\N[3]]":61,"「あんたたちには散々邪魔されたけど、最後に勝ったのは\n　やっぱりこのあたしよ！\\nw[\\N[3]]":62,"「というわけで早速だけど、あんたたちにはアルテトの餌に\n　なってもらうわ！\\nw[\\N[3]]":63,"「伝説の竜に食べてもらえるなんてステキでしょ？\n　あーはっはっはっ！\\nw[\\N[3]]":64,"「このクソメスガキがっ……！」\\nw[\\N[1]]":65,"「さあアルテトよ！\n　そいつらを食い殺しておしまい！」\\nw[\\N[3]]":66,"「……あ、あれ？\n　アルテト？　ちょっとアルテト！」\\nw[\\N[3]]":67,"「お嬢様、大変申し上げにくいのですが、\n　アルテトを使役できるのはあの方だけのはずでは？」\\nw[\\N[4]]":68,"「ハッ？！　そ、そうだったわ！\n　つい勢いで命じちゃったけど……」\\nw[\\N[3]]":69,"「おいっ、ちょっと待て！\n　お前がアルテトを操れないって、それじゃこのデカブツ、\n　ここからどうなるんだ！？」\\nw[\\N[1]]":70,"「ま、まさか野放しになって、勝手に暴れるんじゃ？！」\\nw[\\N[2]]":71,"「そ、そんなことないわよ！\n　……ないわよね？　\\N[4]？」\\nw[\\N[3]]":72,"「い、いえ……あの方から命じられたのは鉤爪を沼に\n　捨てることだけで、ここから先どうなるかは私にも\n　分かりかねます」\\nw[\\N[4]]":73,"「えっ……それ、ちょっと……ま、まずくない？」\\nw[\\N[3]]":74,"「うあぁあああぁっ？！」\\nw[\\N[2]]":75,"「どどっ、どうしよう！？\n　\\N[4]！　なんとかして！」\\nw[\\N[3]]":76,"「そ、そう言われましても……私ごときでは如何とも\n　しがたく……」\\nw[\\N[4]]":77,"「あのアホども……！\n　自分でやっといて収拾つける算段もないのかよ！」\\nw[\\N[1]]":78,"「ひっ、ひいいいぃぃっ！！」\\nw[\\N[3]]":79,"「大丈夫ですよ。\\N[6]はわたしが御します」\\nw[？？？]":80,"「\\N[5]姫！？」\\nw[\\N[2]]":81,"「ひ、姫様！？　どうしてここに！？\n　王都でお待ちいただいてたはずじゃ！？」\\nw[\\N[3]]":82,"「どうしてって、アルテトが甦ったのだから\n　わたしが来るのは当然でしょう？」\\nw[\\N[5]]":83,"「\\N[3]、今度はうまくやってくれたようですね？\n　これで竜の鉤爪を奪われた件は、不問に付しましょう」\\nw[\\N[5]]":84,"「はっ、はいぃっ！　ありがとうございます！」\\nw[\\N[3]]":85,"「そして\\N[1]殿。\n　あなた方もご苦労様でした」\\nw[\\N[5]]":86,"「やってくれたな、お姫様。\n　すっかり騙されたぜ。\\nw[\\N[1]]":87,"「敵である俺たちを、まんまと鉤爪の運び屋に\n　仕立て上げるとはな……！\\nw[\\N[1]]":88,"「だが何故だ？\\nw[\\N[1]]":89,"「お前にはアルテトなんて物騒なモノを使わなきゃ\n　ならない動機は無いはずだ」\\nw[\\N[1]]":90,"「それは、これから死にゆくあなたに話しても\n　仕方のないことでは？」\\nw[\\N[5]]":91,"「やっ、やっぱり、なにがどう転んでも、\n　わたしたち始末されちゃうんですかぁっ！？」\\nw[\\N[2]]":92,"「ええ、そうです。\n　申し訳ありませんが、ここでお亡くなりになって\n　くださいね\\I[29]」\\nw[\\N[5]]":93,"「この腹黒姫がっ！\\nw[\\N[1]]":94,"「\\N[2]っ！　逃げるぞ！」\\nw[\\N[1]]":95,"「逃がすわけがないでしょう？」\\nw[\\N[5]]":96,"FocusCamera 18 14 60":97,"対アルテト戦闘\n↓　　↓　　↓":98,"↑　　↑　　↑\n対アルテト戦闘":99,"「いまだ！　撤退するぞ！\n　全力で走れぇ！！」\\nw[\\N[1]]":100,"「はいぃっ！！」\\nw[\\N[2]]":101,"FocusCamera 24 12 60":102,"「あいつら、まさかアルテトの攻撃をしのいで\n　逃げるなんてッ！」\\nw[\\N[3]]":103,"「すぐに追撃を――」\\nw[\\N[4]]":104,"「かまわないわ、放っておきなさい。\\nw[\\N[5]]":105,"「あのような小物、逃げおおせたところでどうという\n　こともありませんから。\\nw[\\N[5]]":106,"「それより、今後のことです。\\nw[\\N[5]]":107,"「これよりわたしは、“反逆者パルフューク大公”のいる\n　副都を攻撃してきます。\\nw[\\N[5]]":108,"「あなたたちは王都に戻り、計画を次の段階へ進めて\n　おきなさい」\\nw[\\N[5]]":109,"「かしこまりました！\n　これでいよいよ、姫様――いえ、女王陛下の天下\n　ですね！」\\nw[\\N[3]]":110,"「気が早いですよ、\\N[3]。\n　さあ、お行きなさい」\\nw[\\N[5]]":111,"「それではまた、後ほど」\\nw[\\N[3]]":112,"「失礼いたします」\\nw[\\N[4]]":113,"（なぜあの二人を殺しきれなかったの……？\n　動きが鈍くなった……いえ、鈍くさせられた？）\\nw[\\N[5]]":114,"（まさか……いいえ、そんなはずはない……。\n　きっと封印が解けたばかりで、本調子でなかっただけ）\\nw[\\N[5]]":115,"「そうよね……“わたし”は何ひとつ変わりない。\n　今も、昔も――」\\nw[\\N[5]]":116,"ResetFocus 20":117,"ユマ":118,"煙":119,"波紋":120,"投擲用光":121,"エルラ":122,"バルコルド":123,"波紋2":124,"雷落下地点":125,"雷落下地点2":126,"雷落下地点3":127,"雷落下地点4":128,"アルテト":129,"ラーナ":130,"アルテト回想Ev":131,"「度重なる戦いで疲れ、隙が生じたアルテトに、\n　『竜の鉤爪』が使われたのです。\\nw[\\N[5]]":132,"「封印の力は強く、抗えぬものでした。\\nw[\\N[5]]":133,"「しかし封じられるその間際、アルテトはすべての力を\n　振り絞って、リジェルダにひとつの\\C[17]『呪い』\\C[0]を\n　かけました。\\nw[\\N[5]]":134,"「\\C[17]己の魂の一部\\C[0]を呪詛の矢として放ち、リジェルダの\n　魂に突き立て、その命を縮めんとしたのです。\\nw[\\N[5]]":135,"「アルテトを封じることに成功したリジェルダでしたが、\n　この呪いによって自身の寿命は半減。\\nw[\\N[5]]":136,"「さらにその子孫たちにも影響は及び、王族は短命な\n　者が多くなってしまいました」\\nw[\\N[5]]":137,"eraseFilter 1":138,"回想人物1":139,"回想人物2":140,"アルテト（回想用）":141,"脱出用魔法陣（寝床クリア後）":142,"ダンジョンの外へ脱出しますか？":143,"脱出する":144,"脱出しない":145,"createFilter 1 twist 2":146,"setFilter 1 408 312 416 0":147,"moveFilter 1 408 312 816 13 120":148,"EXIT（鉤爪クリア直後）":149,"敵索敵スタート":150,"死毒の沼":151,"weather : 0 : 32 : 2 : 40 : 0 : Fog_01bp":152},"extension":"json","dataType":"map","filename":"Map322","basename":"Map322.json","path":"data/Map322.json","relPath":"data/Map322.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":153,"percent":0},"cellInfo":[]},"data/Map323.json":{"data":[["ユマ",""],["撤退Ev",""],["「ふぅ……逃げ切れたみたいだな……」\\nw[\\N[1]]",""],["「でっ、でも！　アルテトが甦っちゃいましたよ！\n　どうしましょう！？」\\nw[\\N[2]]",""],["「どうしような、ほんと。\n　知ってたら教えてくれ」\\nw[\\N[1]]",""],["「知りませんよ！\n　わけが分かりませんよ！」\\nw[\\N[2]]",""],["「\\N[2]！　隠れろ！」\\nw[\\N[1]]",""],["「え？」\\nw[\\N[2]]",""],["「ア……アルテトが……飛んで……」\\nw[\\N[2]]",""],["「『竜の寝床』から出ていったか。\n　だがあの方角……王都に向かっているわけじゃ\n　なさそうだな」\\nw[\\N[1]]",""],["「あっ？！\n　向こうにあるのって、もしかして副都じゃないですか！？」\\nw[\\N[2]]",""],["「そうだな。\n　まさかアルテトに副都を襲わせる気か？\\nw[\\N[1]]",""],["「なにを考えてやがる、あの腹黒姫……！」\\nw[\\N[1]]",""],["「副都がアルテトに……わたしたちが甦らせちゃった\n　せいで……」\\nw[\\N[2]]",""],["「いやいや俺たちのせいじゃないぞ？\n　悪いのは\\N[5]とメスガキどもだ。\\nw[\\N[1]]",""],["「仮に責任があるとしても、せいぜい０．０１％とか\n　そのくらいだろ」\\nw[\\N[1]]",""],["「全力で責任逃れしないでくださいよ。\n　カッコ悪い」\\nw[\\N[2]]",""],["「そこまで言うなら行くか、副都に？」\\nw[\\N[1]]",""],["「そ、それは……\\nw[\\N[2]]",""],["「いえ、行きます！\n　なにが出来るか分かりませんけど」\\nw[\\N[2]]",""],["「フフン、さっきは逃げたが、俺もやられっぱなしは\n　性に合わん。\\nw[\\N[1]]",""],["「よしっ、ここを出て副都へ行くぞ！」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『副都擾乱』\\C[0]を受けた！",""],["\\>　　※　悪竜アルテトを追って、\\C[17]副都パルフューク\\C[0]へ　※\n\\>　　※　行こう！　　　　　　　　　　　　　　　　　※\\<",""]],"context":[["Map323/events/1/name"],["Map323/events/2/name"],["Map323/events/2/pages/0/list/76/message/noPicture/bottom"],["Map323/events/2/pages/0/list/88/message/noPicture/bottom"],["Map323/events/2/pages/0/list/93/message/noPicture/bottom"],["Map323/events/2/pages/0/list/98/message/noPicture/bottom"],["Map323/events/2/pages/0/list/104/message/noPicture/bottom"],["Map323/events/2/pages/0/list/111/message/noPicture/bottom"],["Map323/events/2/pages/0/list/147/message/noPicture/bottom"],["Map323/events/2/pages/0/list/152/message/noPicture/bottom"],["Map323/events/2/pages/0/list/160/message/noPicture/bottom"],["Map323/events/2/pages/0/list/165/message/noPicture/bottom"],["Map323/events/2/pages/0/list/168/message/noPicture/bottom"],["Map323/events/2/pages/0/list/174/message/noPicture/bottom"],["Map323/events/2/pages/0/list/179/message/noPicture/bottom"],["Map323/events/2/pages/0/list/182/message/noPicture/bottom"],["Map323/events/2/pages/0/list/189/message/noPicture/bottom"],["Map323/events/2/pages/0/list/194/message/noPicture/bottom"],["Map323/events/2/pages/0/list/200/message/noPicture/bottom"],["Map323/events/2/pages/0/list/205/message/noPicture/bottom"],["Map323/events/2/pages/0/list/210/message/noPicture/bottom"],["Map323/events/2/pages/0/list/213/message/noPicture/bottom"],["Map323/events/2/pages/0/list/224/message/noPicture/bottom"],["Map323/events/2/pages/0/list/245/message/noPicture/middle"]],"tags":[["gold"],["gold"]],"parameters":[null,null,[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":88,"headerParam":["",0,0,2]}],[{"headerIndex":93,"headerParam":["",0,0,2]}],[{"headerIndex":98,"headerParam":["",0,0,2]}],[{"headerIndex":104,"headerParam":["",0,0,2]}],[{"headerIndex":111,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["",0,0,2]}],[{"headerIndex":152,"headerParam":["",0,0,2]}],[{"headerIndex":160,"headerParam":["",0,0,2]}],[{"headerIndex":165,"headerParam":["",0,0,2]}],[{"headerIndex":168,"headerParam":["",0,0,2]}],[{"headerIndex":174,"headerParam":["",0,0,2]}],[{"headerIndex":179,"headerParam":["",0,0,2]}],[{"headerIndex":182,"headerParam":["",0,0,2]}],[{"headerIndex":189,"headerParam":["",0,0,2]}],[{"headerIndex":194,"headerParam":["",0,0,2]}],[{"headerIndex":200,"headerParam":["",0,0,2]}],[{"headerIndex":205,"headerParam":["",0,0,2]}],[{"headerIndex":210,"headerParam":["",0,0,2]}],[{"headerIndex":213,"headerParam":["",0,0,2]}],[{"headerIndex":224,"headerParam":["",0,0,2]}],[{"headerIndex":245,"headerParam":["",0,0,1]}]],"indexIds":{"ユマ":0,"撤退Ev":1,"「ふぅ……逃げ切れたみたいだな……」\\nw[\\N[1]]":2,"「でっ、でも！　アルテトが甦っちゃいましたよ！\n　どうしましょう！？」\\nw[\\N[2]]":3,"「どうしような、ほんと。\n　知ってたら教えてくれ」\\nw[\\N[1]]":4,"「知りませんよ！\n　わけが分かりませんよ！」\\nw[\\N[2]]":5,"「\\N[2]！　隠れろ！」\\nw[\\N[1]]":6,"「え？」\\nw[\\N[2]]":7,"「ア……アルテトが……飛んで……」\\nw[\\N[2]]":8,"「『竜の寝床』から出ていったか。\n　だがあの方角……王都に向かっているわけじゃ\n　なさそうだな」\\nw[\\N[1]]":9,"「あっ？！\n　向こうにあるのって、もしかして副都じゃないですか！？」\\nw[\\N[2]]":10,"「そうだな。\n　まさかアルテトに副都を襲わせる気か？\\nw[\\N[1]]":11,"「なにを考えてやがる、あの腹黒姫……！」\\nw[\\N[1]]":12,"「副都がアルテトに……わたしたちが甦らせちゃった\n　せいで……」\\nw[\\N[2]]":13,"「いやいや俺たちのせいじゃないぞ？\n　悪いのは\\N[5]とメスガキどもだ。\\nw[\\N[1]]":14,"「仮に責任があるとしても、せいぜい０．０１％とか\n　そのくらいだろ」\\nw[\\N[1]]":15,"「全力で責任逃れしないでくださいよ。\n　カッコ悪い」\\nw[\\N[2]]":16,"「そこまで言うなら行くか、副都に？」\\nw[\\N[1]]":17,"「そ、それは……\\nw[\\N[2]]":18,"「いえ、行きます！\n　なにが出来るか分かりませんけど」\\nw[\\N[2]]":19,"「フフン、さっきは逃げたが、俺もやられっぱなしは\n　性に合わん。\\nw[\\N[1]]":20,"「よしっ、ここを出て副都へ行くぞ！」\\nw[\\N[1]]":21,"メインシナリオ\\C[17]『副都擾乱』\\C[0]を受けた！":22,"\\>　　※　悪竜アルテトを追って、\\C[17]副都パルフューク\\C[0]へ　※\n\\>　　※　行こう！　　　　　　　　　　　　　　　　　※\\<":23},"extension":"json","dataType":"map","filename":"Map323","basename":"Map323.json","path":"data/Map323.json","relPath":"data/Map323.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":24,"percent":0},"cellInfo":[]},"data/Map324.json":{"data":[["本棚（可動）",""],["「よし、潜入成功だ」\\nw[\\N[1]]",""],["「成功しちゃいましたね……。\\nw[\\N[2]]",""],["「でも、どうしてわざわざ宮殿に？\n　建物の中にあの巨大なアルテトがいるとも思えませんけど」\\nw[\\N[2]]",""],["「常識で考えりゃそうだが、相手は幻の古代竜だ。\n　なにがあってもおかしくはない。\\nw[\\N[1]]",""],["「それに操ってるのは、あの腹黒\\N[5]だからな。\\nw[\\N[1]]",""],["「パルフュークの街を滅茶苦茶にしておいて、ここだけ\n　無事に済ませるとは思えん。\\nw[\\N[1]]",""],["「モンスターの襲撃で宮殿内も混乱してるだろうから、\n　この隙に見て回るぞ」\\nw[\\N[1]]",""],["本棚（移動後）",""],["メイド1",""],["「どうしましょう！　どうしましょう！\n　宮殿にまでモンスターが来ちゃったら！？」\\nw[メイド]",""],["「どうしましょう！　どうしましょう！\n　大公殿下が殺されてしまったわ！」\\nw[メイド]",""],["「チェリア様が女王ですって！　すごいわ！」\\nw[メイド]",""],["使用人1",""],["「宮殿全体が混乱している今こそ、窓を拭いて\n　心を落ち着けよう」\\nw[使用人]",""],["「大公様がお亡くなりになるなんて……！\n　こんなときこそ窓を拭いて心を落ち着けよう」\\nw[使用人]",""],["「たとえ主がいなくとも、掃除はしっかりしないとね！\n　さあ今日も窓を拭くぞ！」\\nw[使用人]",""],["燭台",""],["光",""],["宝箱（お金正面開き）",""],["<TE:16>",""],["↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。",""],["EV022",""],["EV023",""],["EV024",""],["チェリア（副都擾乱）",""],["兵士",""],["執事",""],["「チェリア様、ご心配には及びませんので、\n　騒ぎが収まるまでこの部屋でお待ちください」\\nw[執事]",""],["「本当に大丈夫なのですか？\n　街のあちこちから煙が上がり、人々の悲鳴がここまで……\\nw[チェリア]",""],["「なんと恐ろしい……どうしてこのようなことが……」\\nw[チェリア]",""],["「チェリア様……おいたわしや……。\n　このような形で父君を亡くされてしまうとは……」\\nw[執事]",""],["メイド2",""],["身代わり奴隷",""],["メイド（姫身代わり）",""],["主人公（姫身代わり）",""],["ユマ（姫身代わりEv）",""],["「この奴隷をチェリア様のようにすればよろしいの\n　ですか？」\\nw[メイド]",""],["「うむ。なるべくそっくりになるよう頼む」\\nw[騎士]",""],["「では……我が化粧術の最終奥義、ご覧あれ！」\\nw[メイド]",""],["「とりゃあああぁぁッ！！」\\nw[メイド]",""],["「こ、これは……！」\\nw[騎士]",""],["「なにをしているのですか？」\\nw[チェリア]",""],["「チェリア様、ちょうど良いところへ！\n　これをご覧になってくださいませ！」\\nw[メイド]",""],["「まあっ、なんてこと！\n　鏡を見ているみたい！」\\nw[チェリア]",""],["「この出来映えなら、チェリア様の身代わりとして\n　十分に通用するでしょう！」\\nw[騎士]",""],["「どうやら満足してもらえたらしい。\n　あとは報酬をもらうだけだな」\\nw[\\N[1]]",""],["「それにしても、お化粧でこれほどそっくりに出来る\n　なんてびっくりです！\\nw[\\N[2]]",""],["「あのメイドさん凄いですね」\\nw[\\N[2]]",""],["「そうだな。\n　もし姫を狙っている魔術師がここに来たら、\n　どっちをさらえばいいのか迷っちまうんじゃ――」\\nw[\\N[1]]",""],["「ぐははははっ！！\n　憎きパルフューク大公への復讐を今こそ為さん！\\nw[魔術師]",""],["「チェリア姫よ！　その身柄を預かるぞ！\n　恨むなら死んだ父親を恨め！」\\nw[魔術師]",""],["「チェリア姫よ！\n　貴様の父親に絶望を与えるため、その身柄を預かるぞ！」\\nw[魔術師]",""],["「な、なんてことだ！\n　これほど早く敵が来てしまうとは！」\\nw[騎士]",""],["「さあ我とともに来い！\n　言っておくが、逆らっても無駄――。\\nw[魔術師]",""],["「――ってアレ？\n　チェリア姫が二人？\\nw[魔術師]",""],["「ど、どういうことだ？！\n　まさか幻術か？」\\nw[魔術師]",""],["「おのれ邪悪なる魔術師め！\n　お前の好きにはさせんぞ！」\\nw[騎士]",""],["「だまれザコが！　邪魔をするな！」\\nw[魔術師]",""],["「きゃああああぁっ！？」\\nw[チェリア]",""],["「ええいっ！\n　とにかくチェリア姫以外は皆殺しにしてくれる！」\\nw[魔術師]",""],["「くそっ、こりゃあ戦うしかなさそうだ！」\\nw[\\N[1]]",""],["「なんでこんなことにぃー！！」\\nw[\\N[2]]",""],["「ぐはあぁっ？！　つ、強い！？\\nw[魔術師]",""],["「おのれっ……だが我はあきらめんぞ！」\\nw[魔術師]",""],["「チェリア姫はもらったぁッ！！」\\nw[魔術師]",""],["「ち、ちがう！　わたしは――」\\nw[女奴隷]",""],["「どうしましょう！？\n　偽のチェリア姫がさらわれちゃいましたよ！」\\nw[\\N[2]]",""],["「まあ本物は無事だったんだし、とりあえずは\n　良かったんじゃないか？」\\nw[\\N[1]]",""],["「えぇ～！？」\\nw[\\N[2]]",""],["「ぐっ……あの魔術師はどこに！？」\\nw[騎士]",""],["「みごと偽物に引っかかって、そっちをさらっていったぜ」\\nw[\\N[1]]",""],["「そ、そうか……。\n　不覚をとってしまったが、最悪の事態だけは避けられたか」\\nw[騎士]",""],["「わたしの身代わりに連れ去られてしまうなんて！\n　あの人を助けてあげないと！」\\nw[チェリア]",""],["「至急、魔術師の行方を捜索させましょう！」\\nw[騎士]",""],["「こっちの報酬も忘れずに頼むぜ」\\nw[\\N[1]]",""],["「なにもいま催促しなくても……」\\nw[\\N[2]]",""],["「いや、貴殿らの働きでチェリア様は事なきを得た。\n　ご助力、誠に感謝いたす」\\nw[騎士]",""],["個別依頼\\C[17]『姫の身代わり』\\C[0]を達成した！",""],["↓プレーヤー位置強制中央解除",""],["SFC_ENABLE_RESERVE",""],["\nその頃、連れ去られたチェリア姫の偽者は――。",""],["騎士（姫身代わり）",""],["チェリア（身代わり）",""]],"context":[["Map324/events/1/name"],["Map324/events/1/pages/1/list/28/message/noPicture/bottom"],["Map324/events/1/pages/1/list/34/message/noPicture/bottom"],["Map324/events/1/pages/1/list/39/message/n