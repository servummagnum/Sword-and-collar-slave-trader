:3,"headerParam":["",0,0,1]}],null,null,null,[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]}],[{"headerIndex":2,"headerParam":["↓拾得奴隷の種類決定"]}],[{"headerIndex":0,"headerParam":["※"]}]],"indexIds":{"EV001":0,"敵追跡の停止":1,"SmartPath 10 cancel":2,"SmartPath 11 cancel":3,"SmartPath 12 cancel":4,"SmartPath 13 cancel":5,"PSS stop":6,"PSS reset C":7,"↓敵全部倒したかチェック":8,"EV002":9,"EV003":10,"EV004":11,"EV005":12,"敵索敵スタート":13,"PSS start":14,"イージー":15,"ノーマル":16,"EV007":17,"EV008":18,"EV009":19,"敵01":20,"<PsensorS:\\V[1166] Rv\\S[22]>":21,"探索範囲にプレイヤー侵入":22,"SmartPath 0 -1":23,"追跡しているプレイヤーと接触":24,"SmartPath 0 cancel":25,"敵に見つかっている場合の戦闘":26,"勝利したとき":27,"PSS t_stop":28,"逃げたとき":29,"戦闘から離脱したときの処理":30,"PSS t_start":31,"敵がプレイヤーを見失ったときの処理":32,"敵02":33,"敵03":34,"敵04":35,"坑夫":36,"「♪おいらは穴掘りエンヤコラ～\n　　鉱石、宝石、がっぽりさ～」\\nw[坑夫]":37,"「モンスターのせいで仕事が止まってたぶん、\n　取り戻さないとな。忙しい忙しい。」\\nw[坑夫]":38,"壁ひび":39,"※\nアイテム：精霊石\n※":40,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":41,"↓アイテムのIDNo.を変数に入力する":42,"↓アイテムの入手個数を変数に入力する":43,"↓アイテムの重量を変数に入力する":44,"宝箱":45,"※\nアイテム：ツルハシ\n※":46,"※\nアイテム：万能薬":47,"「トロッコの手入れも大事な仕事なのさ」\\nw[坑夫]":48,"EV020":49,"「モンスターのせいで休めてたけど、また苦役が\n　始まっちまった……つらい」\\nw[鉱山奴隷]":50,"土":51,"EV024":52,"EV025":53,"EV026":54,"EV027":55,"EV028":56,"「きつい……休みたい……」\\nw[鉱山奴隷]":57,"EV030":58,"EV031":59,"EV032":60,"EV033":61,"「くそっ、こき使いやがって……！」\\nw[鉱山奴隷]":62,"「ずっとモンスターがいれば良かったのに！\n　いや……そしたら別の仕事に回されるだけか……」\\nw[鉱山奴隷]":63,"「ヤマニモドリタイ……。\n　ココモ、ヤマダケド」\\nw[鉱山奴隷]":64,"駆除終了Ev":65,"\\>　　\\C[17]※　坑道内のすべてのモンスターを倒した！　※\n\\>　　※　報告しに鉱山監督官のところへ行こう　　※\\C[0]":66,"宝箱（防具正面開き）":67,"<TE:4>":68,"盗賊":69,"「チッ！　人が来やがったか。\n　モンスター騒動が続いてるうちに、金目の物をいただ\n　いていくつもりだったのに！」\\nw[盗賊]":70,"「へぇ、こんな場所に盗賊がいるとは。\n　抜け目のないヤツだ」\\nw[\\N[1]]":71,"「ど、どうしましょう！？\n　盗賊退治は頼まれてませんけど……」\\nw[\\N[2]]":72,"「どうもこうもあるか。\n　わざわざ奴隷志願者が現れてくれたんだ。狩るぞ！」\\nw[\\N[1]]":73,"「ふざけたことを！\n　返り討ちにしてやる！」\\nw[盗賊]":74,"奴隷化性別：0=女、1=男、2=男女ランダム":75,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":76,"※\nアイテム：精霊石":77,"回復魔法陣":78,"盗賊表示":79,"宝箱（武器正面開き）":80,"<TE:1>":81},"extension":"json","dataType":"map","filename":"Map213","basename":"Map213.json","path":"data/Map213.json","relPath":"data/Map213.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":82,"percent":0},"cellInfo":[]},"data/Map214.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["個別依頼01",""],["鉱山（状況確認）",""],["「くそっ……どうすりゃいいんだ……！」\\nw[鉱山監督官]",""],["「なにやら困っている様子だが、どうしたんだ？」\\nw[\\N[1]]",""],["「なんだお前らは？」\\nw[鉱山監督官]",""],["「ラノティカの商業ギルドから来た者だ」\\nw[\\N[1]]",""],["「坑夫のみなさんも途方に暮れているようでしたけど、\n　なにがあったんですか？」\\nw[\\N[2]]",""],["「坑道内に\\C[17]モンスター\\C[0]が湧いて出ちまったんだよ！」\\nw[鉱山監督官]",""],["「あちゃー！　そりゃあご愁傷様だな。\n　で、駆除の予定はどうなってるんだ？」\\nw[\\N[1]]",""],["「王国軍にはとっくに討伐を願い出てるんだが、返事の\n　ひとつも来やしない。\\nw[鉱山監督官]",""],["「兵隊のアホどもめ！\n　ここが王国の金蔵だって分かってるのか！？」\\nw[鉱山監督官]",""],["「どうやら当面のあいだは操業停止状態が続きそうですね。\n　戻ってギルド長に報告しましょう」\\nw[\\N[2]]",""],["「ああ、そうだな……」\\nw[\\N[1]]",""],["「考えたんだが、坑道内のモンスターを倒すのと引き換えに\n　俺たちにも\\C[17]鉱石取引の権利\\C[0]を寄越すよう要求してみたら\n　どうだ……？」\\nw[\\N[1]]",""],["「はぁ？　なに言ってるんですか！？\n　わたしたちがモンスター退治って、本気ですか！？」\\nw[\\N[2]]",""],["「やってやれないことは、ないと思うんだが」\\nw[\\N[1]]",""],["「反対です！　反対！　無謀ですよ！\n　断固はんたーい！！」\\nw[\\N[2]]",""],["「うーん……どうするか……」\\nw[\\N[1]]",""],["鉱山（個別依頼01）",""],["鉱山監督官に、坑道内のモンスター退治を申し出ますか？",""],["申し出る",""],["やめておく",""],["「よう、監督官のおっさん。\n　坑道に出たモンスターだが、俺たちが退治してきて\n　やろうか？」\\nw[\\N[1]]",""],["「お前らが？　いったい何の冗談だ？」\\nw[鉱山監督官]",""],["「冗談でこんな話するかよ。\n　モンスターは一匹残らず狩ってきてやるから、代わりに\n　俺にも\\C[17]鉱石取引の権利\\C[0]をくれ」\\nw[\\N[1]]",""],["「ふんっ、やっぱり冗談にしか聞こえんぞ？\n　それも笑えない類の。\\nw[鉱山監督官]",""],["「まあ、もし本当にモンスターを残らず片付けてくれる\n　なら、取引の権利でもなんでもくれてやるがな」\\nw[鉱山監督官]",""],["「あぁ、言っちゃった……」\\nw[\\N[2]]",""],["「ようし、言質は取ったぞ！\n　必ずモンスターを一掃して戻ってくるから待ってろよ！」\\nw[\\N[1]]",""],["「はいはい、期待せずに待たせてもらうよ」\\nw[鉱山監督官]",""],["個別依頼\\C[17]『鉱山の解放』\\C[0]を受けた！",""],["依頼者にモンスター退治の成功を報告しますか？",""],["報告する",""],["報告しない",""],["依頼条件達成",""],["「約束通り、坑道内のモンスターは全部倒してきたぜ」\\nw[\\N[1]]",""],["「ま、まさか本当にやってのけるなんて！」\\nw[鉱山監督官]",""],["「苦労しましたよぉ……」\\nw[\\N[2]]",""],["「それじゃあ、鉱石取引の許可をいただこうか？」\\nw[\\N[1]]",""],["「ぐぬぬ……仕方ないか。\n　いいだろう、私の権限で商人\\N[1]に鉱石\n　取り引きの許可証を発行する！」\\nw[鉱山監督官]",""],["「やったぜ！」\\nw[\\N[1]]",""],["個別依頼\\C[17]『鉱山の解放』\\C[0]を達成した！",""],["報酬として\\C[17]鉱石取引の許可\\C[0]を得た！\n\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！",""],["\n\\>　 ※　鉱山監督官から\\C[17]鉱石\\C[0]が買えるようになった！　※",""],["ギルド長へ報告する前に個別依頼01を終わらせた場合",""],["「ではラノティカに戻って、ギルド長に報告しましょう」\\nw[\\N[2]]",""],["ギルド長へ報告してから個別依頼01を終わらせた場合",""],["依頼条件未達成",""],["「本当にモンスターを退治できるなら、ぜひとも\n　やってもらいたいもんだ」\\nw[鉱山監督官]",""],["EV005",""],["ユマ",""],["武器商ギルド秘密文書（横）",""],["<TE:75>",""],["坑夫",""],["「厄介事ってのは、突然きやがる」\\nw[坑夫]",""],["「二人でモンスターを退治しちまうとは、大したもんだ！」\\nw[坑夫]",""],["「知ってるか？　ラノティカの町の精錬所に行けば\n　\\C[17]ミスリル鉱石からミスリルインゴットを精錬\\C[0]できる\n　んだぜ」\\nw[坑夫]",""]],"context":[["Map214/events/1/name"],["Map214/events/2/name"],["Map214/events/3/name"],["Map214/events/4/name"],["Map214/events/4/pages/0/list/0/comment"],["Map214/events/4/pages/0/list/45/message/noPicture/bottom"],["Map214/events/4/pages/0/list/60/message/noPicture/bottom"],["Map214/events/4/pages/0/list/64/message/noPicture/bottom"],["Map214/events/4/pages/0/list/67/message/noPicture/bottom"],["Map214/events/4/pages/0/list/73/message/noPicture/bottom"],["Map214/events/4/pages/0/list/78/message/noPicture/bottom"],["Map214/events/4/pages/0/list/81/message/noPicture/bottom"],["Map214/events/4/pages/0/list/85/message/noPicture/bottom"],["Map214/events/4/pages/0/list/88/message/noPicture/bottom"],["Map214/events/4/pages/0/list/93/message/noPicture/bottom"],["Map214/events/4/pages/0/list/98/message/noPicture/bottom"],["Map214/events/4/pages/0/list/133/message/noPicture/bottom"],["Map214/events/4/pages/0/list/141/message/noPicture/bottom"],["Map214/events/4/pages/0/list/146/message/noPicture/bottom"],["Map214/events/4/pages/0/list/152/message/noPicture/bottom"],["Map2