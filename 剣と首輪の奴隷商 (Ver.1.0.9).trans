l,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":18,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":28,"headerParam":["",0,0,2]}],[{"headerIndex":32,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"魔法陣1":3,"スイッチ2":4,"FocusCamera 22 14 90":5,"ResetFocus 90":6,"魔法陣2":7,"魔法陣3":8,"スイッチ3":9,"FocusCamera 21 20 90":10,"魔法陣4":11,"魔法陣5":12,"像1右":13,"像1左":14,"魔法陣6":15,"魔法陣7":16,"魔法陣8":17,"魔法陣9":18,"像2下":19,"像2上":20,"宝箱（防具正面開き）":21,"<TE:4>":22,"通行禁止":23,"イベントトリガー":24,"姫会話Ev":25,"「おいおい、道が途切れてやがるぞ」\\nw[\\N[1]]":26,"「どこかに渡れるような所は……無さそうですね」\\nw[\\N[2]]":27,"「この脱出路を悪用されて、逆に王宮に攻め込まれない\n　ための安全弁ってところか。\\nw[\\N[1]]":28,"「だが向こうへ渡るための仕掛けは、なにかしらある\n　はずだ。探すぞ」\\nw[\\N[1]]":29,"EV044":30,"EV045":31,"EV046":32},"extension":"json","dataType":"map","filename":"Map332","basename":"Map332.json","path":"data/Map332.json","relPath":"data/Map332.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":33,"percent":0},"cellInfo":[]},"data/Map333.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["宝箱（武器正面開き）",""],["<TE:1>",""],["エルラ",""],["「ううぅ……」\\nw[\\N[3]]",""],["バルコルド",""],["「ぐ……あ゛……」\\nw[\\N[4]]",""],["ユマ（地下2）",""],["兵士1",""],["兵士2",""],["イベントトリガー",""],["バルコルド戦Ev",""],["「ここを見張れって姫様から言われたときは、\n　ムダだと思ったけど――本当に来るとはね。\\nw[\\N[3]]",""],["「地下を通ってくるなんて、ゴミカスどもには\n　お似合いの侵入ルートね！」\\nw[\\N[3]]",""],["「まったくですな」\\nw[\\N[4]]",""],["「こんなところで待ち伏せしてやがるとは。\n　ったく、執念深いメスガキだな」\\nw[\\N[1]]",""],["「\\N[3]、聞いて！\n　あなたは\\N[5]姫に騙されているの！」\\nw[\\N[2]]",""],["「はぁ？　嘘であたしたちを混乱させる気？」\\nw[\\N[3]]",""],["「本当なの！　信じて！\n　\\N[5]姫の正体が\\N[6]で、王国の人々を虐殺しようと\n　企んでるの！」\\nw[\\N[2]]",""],["「\\N[5]姫が――」\\nw[\\N[3]]",""],["「\\N[6]――？」\\nw[\\N[4]]",""],["「そうなの！\n　だからこれ以上、\\N[5]姫に協力しないで――」\\nw[\\N[2]]",""],["\\{「あっはっはっはぁッ！！」\\}\\nw[\\N[3]＆\\N[4]]",""],["「あんた、追い詰められてとうとう頭がおかしく\n　なっちゃったの？」\\nw[\\N[3]]",""],["「ち、違う！\n　嘘じゃないの！　本当の話なの！　信じて！」\\nw[\\N[2]]",""],["「言うだけ無駄だ、\\N[2]。\\nw[\\N[1]]",""],["「説得が通じるような証拠も信頼関係もないんだからな」\\nw[\\N[1]]",""],["「あーら？　少しは信頼してる部分もあるわよぉ？\\nw[\\N[3]]",""],["「このあと、あんたたちは地面に這いつくばって、\n　みっともなく泣き叫んでくれるって信じてるから\\I[29]」\\nw[\\N[3]]",""],["「おい、主語が違ってるぞ？\n　這いつくばるのはお前らだ、メスガキ。\\nw[\\N[1]]",""],["「二度と逆らえないよう、ここで厳しくしつけてやる」\\nw[\\N[1]]",""],["「口だけはよく回る男だ。\n　その舌の根、この場で切り取ってくれる！」\\nw[\\N[4]]",""],["「王国兵士の諸君！\n　この二人は、畏れ多くも姫様のお命を狙う反逆者よ！\n　遠慮なく始末してしまいなさい！」\\nw[\\N[3]]",""],["「\\N[5]姫様の御為に！」\\nw[兵士Ａ]",""],["「逆賊を討伐せよ！」\\nw[兵士Ｂ]",""],["「死ね！　アサシン！」\\nw[\\N[4]]",""],["対バルコルド戦闘\n↓　　↓　　↓",""],["↑　　↑　　↑\n対バルコルド戦闘",""],["「ぐっ……ぶはぁッ！！」\\nw[\\N[4]]",""],["「う……嘘でしょッ……！？\\nw[\\N[3]]",""],["「\\N[4]！　た、立ちなさい！\n　なに寝てんのよ！\\nw[\\N[3]]",""],["「\\N[4]ォーーッ！！」\\nw[\\N[3]]",""],["「立てるわけがないだろ。\n　体中の骨がバッキバキのはずだぞ」\\nw[\\N[1]]",""],["「\\N[3]、あなたの負けよ！\n　降参すれば手荒なことはしないから――」\\nw[\\N[2]]",""],["「はぁ？　あたしが降参？\n　あんたみたいなクソ猫に？\\nw[\\N[3]]",""],["「するわけないでしょ！！\n　なんであたしが\\N[2]なんかに！！\\nw[\\N[3]]",""],["「すぐに姫様から兵を借りて、あんたたちなんか\n　グッチャグチャのボロカスにしてやるんだから！！」\\nw[\\N[3]]",""],["「させるかボケ！　グチャグチャになるのはお前だ！」\\nw[\\N[1]]",""],["「もしかして\\N[1]さん、やっちゃうつもりですか！？\n　やっちゃうんですね\\I[29]」\\nw[\\N[2]]",""],["「\\N[2]、いいからお前はそこで黙って見てろ」\\nw[\\N[1]]",""],["「あの、\\N[1]さん、あまり乱暴なことは――」\\nw[\\N[2]]",""],["「いやっ、来るなァ！　このフード野郎！」\\nw[\\N[3]]",""],["「ひいぃっ？！　来ないでええぇッ！！」\\nw[\\N[3]]",""],["エルラ凌辱エッチ\n↓　　↓　　↓",""],["↑　　↑　　↑\nエルラ凌辱エッチ",""],["「ふぅー……。\n　心もチンコもスッキリしたぜ！」\\nw[\\N[1]]",""],["「ふふっ……これで\\N[3]もわたしと一緒だね」\\nw[\\N[2]]",""],["「お前とは穴兄妹ならぬ竿姉妹ってわけだな」\\nw[\\N[1]]",""],["「\\N[3]との関係が昔のままだったら、竿姉妹に\n　なれたことも素直に喜べたんでしょうけど……」\\nw[\\N[2]]",""],["「や、やり過ぎですよ！　\\N[1]さん！」\\nw[\\N[2]]",""],["「ヤリすぎってほどヤッてないだろ？\n　本気ならもっと、穴という穴を――」\\nw[\\N[1]]",""],["「そ、そういうことじゃなくって！」\\nw[\\N[2]]",""],["「なんにせよ、やっとメスガキが片付いたな。\n　これで安心して腹黒姫と戦えるってもんだ」\\nw[\\N[1]]",""],["「まったく、\\N[1]さんはもう……。\\nw[\\N[2]]",""],["「…………。\\nw[\\N[2]]",""],["「\\N[3]、あなたのやったことは許せないけど――。\\nw[\\N[2]]",""],["「たとえ仲直りが無理だったとしても、すべてが終わったら\n　一度ちゃんと話をしようね」\\nw[\\N[2]]",""],["実績 11",""],["壁ひび",""],["※\nアイテム：幸運を呼ぶ薬\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["EV016",""],["EV017",""],["EV018",""]],"context":[["Map333/events/1/name"],["Map333/events/2/name"],["Map333/events/3/name"],["Map333/events/4/name"],["Map333/events/4/note"],["Map333/events/5/name"],["Map333/events/5/pages/1/list/0/message/noPicture/bottom"],["Map333/events/6/name"],["Map333/events/6/pages/2/list/0/message/noPicture/bottom"],["Map333/events/7/name"],["Map333/events/8/name"],["Map333/events/9/name"],["Map333/events/10/name","Map333/events/11/name","Map333/events/12/name"],["Map333/events/13/name"],["Map333/events/13/pages/0/list/61/message/noPicture/bottom"],["Map333/events/13/pages/0/list/65/message/noPicture/bottom"],["Map333/events/13/pages/0/list/70/message/noPicture/bottom"],["Map333/events/13/pages/0/list/87/message/noPicture/bottom"],["Map333/events/13/pages/0/list/94/message/noPicture/bottom"],["Map333/events/13/pages/0/list/100/message/noPicture/bottom"],["Map333/events/13/pages/0/list/106/message/noPicture/bottom"],["Map333/events/13/pages/0/list/113/message/noPicture/bottom"],["Map333/events/13/pages/0/list/118/message/noPicture/bottom"],["Map333/events/13/pages/0/list/124/message/noPicture/bottom"],["Map333/events/13/pages/0/list/131/message/noPicture/bottom"],["Map333/events/13/pages/0/list/135/message/noPicture/bottom"],["Map333/events/13/pages/0/list/144/message/noPicture/bottom"],["Map333/events/13/pages/0/list/149/message/noPicture/bottom"],["Map333/events/13/pages/0/list/151/message/noPicture/bottom"],["Map333/events/13/pages/0/list/156/message/noPicture/bottom"],["Map333/events/13/pages/0/list/160/message/noPicture/bottom"],["Map333/events/13/pages/0/list/165/message/noPicture/bottom"],["Map333/events/13/pages/0/list/168/message/noPicture/bottom"],["Map333/events/13/pages/0/list/172/message/noPicture/bottom"],["Map333/events/13/pages/0/list/179/message/noPicture/bottom"],["Map333/events/13/pages/0/list/185/message