t"],["Map168/events/46/pages/0/list/8/comment"],["Map168/events/46/pages/0/list/10/comment"],["Map168/events/47/name"],["Map168/events/47/note"],["Map168/events/48/name"],["Map168/events/49/name"],["Map168/events/49/pages/1/list/0/message/noPicture/bottom"],["Map168/events/49/pages/1/list/2/Show Choices/2/1from2"],["Map168/events/49/pages/1/list/2/Show Choices/2/2from2"],["Map168/events/49/pages/1/list/12/message/noPicture/bottom"],["Map168/events/50/name"],["Map168/events/51/name"],["Map168/events/51/note"],["Map168/events/52/name"],["Map168/events/53/name"],["Map168/events/53/note"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["green"],["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],null,["gold"],null,["gold"],["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,null,["gold"],null,["gold"],null,null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],["gold"],null,["gold"],["red"],["red"],["red"],["red"],["red"],["gold"],null,["gold"],["gold"],null,null,null,null,["gold"],["gold"],null,["gold"],["gold"]],"parameters":[null,null,null,null,null,[{"attachment":"scriptCommand/16944098103007780.js","start":0,"end":4,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098103004472.js","start":0,"end":4,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098103002116.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":3,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":8,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":10,"headerParam":["↓アイテムの重量を変数に入力する"]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":12,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"２階":5,"EV006":6,"EV007":7,"燭台":8,"光":9,"番兵":10,"「一般の方は、二階への立ち入り禁止となっています」\\nw[番兵]":11,"「閉架書庫周辺までなら、立ち入りを許可します」\\nw[番兵]":12,"番兵2":13,"巡礼者1":14,"「ずっと歩いてきたから、クタクタだわ」\\nw[巡礼者]":15,"巡礼者2":16,"「巡礼路が整備されているとはいえ、この距離は\n　なかなかにこたえるよ」\\nw[巡礼者]":17,"料理":18,"巡礼者3":19,"「これだけ頑張ってお参りしたんだから、きっとご利益\n　あるわよね？」\\nw[巡礼者]":20,"巡礼者4":21,"「飲みすぎは罪だが、ほどほどならば良し。\n　それが四聖教の教えさ」\\nw[巡礼者]":22,"巡礼者5":23,"「親父が来いっていうから付いてきたけど、退屈で\n　しかたねぇぜ」\\nw[若者]":24,"巡礼者6":25,"「ケンカばかりしてる息子の性根を正そうと連れて\n　きたが、あまり効果はないようだ……」\\nw[父親]":26,"尼僧1":27,"「右手が談話室、そして奥の方が巡礼者のための\n　宿泊室となっております」\\nw[尼僧]":28,"巡礼者7":29,"「悪竜が甦ったっていう話を聞いてから、夢見が悪いのよ。\n　もう倒されたらしいけど」\\nw[巡礼者]":30,"「ここならいい夢見れそうな気がするわ」\\nw[巡礼者]":31,"巡礼者8":32,"「帰りもまた延々と長い道のりを歩かなきゃと思うと、\n　ちょっと憂鬱だわ」\\nw[巡礼者]":33,"巡礼者9":34,"「私の故郷で聖堂を建てようという話が出ていまして、\n　聖職者を派遣していただけるか話を聞きに来たんです」\\nw[巡礼者]":35,"「ボクは村の代表として、巡礼に来たんだ。\n　みんなが費用を持ち寄ってくれたお陰さ」\\nw[巡礼者]":36,"巡礼者11":37,"「うちのベッドよりきちゃない！」\\nw[女の子]":38,"巡礼者12":39,"「喜捨の額によって、割り当てられる宿泊室が変わる\n　ようだ。\n　こういうところは大聖堂といえど俗っぽいな」\\nw[巡礼者]":40,"巡礼者13":41,"「この大聖堂で作られとる酒はうまくてなぁ。\n　巡礼の目当ては、ほとんどそれじゃよ」\\nw[巡礼者]":42,"従者":43,"「こちらには子爵様ご夫婦が宿泊されている。\n　下々の者は近づいてはならん」\\nw[騎士]":44,"子爵":45,"宝箱（消耗品正面開き）":46,"<TE:13>":47,"宝箱":48,"※\nアイテム：ツルハシ\n※":49,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":50,"↓アイテムのIDNo.を変数に入力する":51,"↓アイテムの入手個数を変数に入力する":52,"↓アイテムの重量を変数に入力する":53,"武器商ギルド秘密文書（横）":54,"<TE:75>":55,"子爵奥方":56,"トイレドア（排泄Ev）":57,"トイレで用を足しますか？":58,"入る":59,"入らない":60,"いまのところ用を足す必要は無い。":61,"トイレドア（固定）":62,"トイレマーク（屋内用）":63,"<TE:84>":64,"ユマ（トイレ）":65,"窃盗用下着2":66,"<TE:117>":67},"extension":"json","dataType":"map","filename":"Map168","basename":"Map168.json","path":"data/Map168.json","relPath":"data/Map168.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":68,"percent":0},"cellInfo":[]},"data/Map169.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["２階",""],["EV006",""],["EV007",""],["燭台",""],["光",""],["書庫案内",""],["「こちらが一般書架になります。\n　持ち出しはできませんが、閲覧はご自由にしていただいて\n　結構ですので」\\nw[僧侶]",""],["↓隊列歩行off",""],["「ここに『竜の鉤爪』に関する資料があるのか……。\n　しかしこの本の量は……」\\nw[\\N[1]]",""],["「地道に探すしかないですね」\\nw[\\N[2]]",""],["\n\\>　　\\C[17]※　書庫の中から、目当ての資料を探し出そう　※\\C[0]",""],["チェックマーク",""],["一般書架1",""],["『四聖の神々は、先住民である猫人族が信仰していた\n　四精霊と同一視されることもあるが、これは明確な\n　誤りであって――』",""],["一般書架2",""],["『建国王リジェルダが流民を率いて、遥か南方から\n　この地へやってきたとき、四聖教の淵源となった\n　元素神信仰もまた一緒に――』",""],["『合いびき肉に、塩、胡椒、少量の砂糖、パン粉を入れ、\n　それから先に炒めておいた玉ねぎも混ぜてから、\n　しっかりとこねていき――』",""],["『王国歴２５４年７月２２日\n　猫人の集落がまたひとつ、四聖教に改宗したとの報告が\n　あった。やはり彼らの精霊信仰との類似性が――』",""],["書架調べ終わり",""],["「全然、それらしき資料が見つからんな」\\nw[\\N[1]]",""],["「本当にここにあるんでしょうか？\\nw[\\N[2]]",""],["「そもそもこんな場所にあるなら、父が会ったという\n　学者さんも普通に閲覧できていたのでは？」\\nw[\\N[2]]",""],["「そうだよなぁ。\n　……たしかここは『一般書架』だったよな？\\nw[\\N[1]]",""],["「ってことは、\\C[17]一般向けじゃない書架\\C[0]もどこかに\n　あるんじゃないか？」\\nw[\\N[1]]",""],["「あっ、そうですよきっと！\n　あそこいる僧侶の人に、ちょっと訊いてみましょう！」\\nw[\\N[2]]",""],["トークマーク",""],["書庫の僧侶",""],["「書庫の中ではお静かに」\\nw[僧侶]",""],["「はい？　ここ以外の書庫ですか？\n　ええ、ありますよ」\\nw[僧侶]",""],["「やっぱりそうか！\n　じゃあ、その書庫も見せて欲しいんだが」\\nw[\\N[1]]",""],["「それは難しいですね。\n　\\C[17]閉架書庫\\C[0]は高位の聖職者しか入ることを許されて\n　いませんので」\\nw[僧侶]",""],["「お金を払ってもダメなんですか？」\\nw[\\N[2]]",""],["「金銭の問題ではありません。\n　古くて貴重な書物が多いため、立ち入りは厳しく\n　制限されているのです。\\nw[僧侶]",""],["「どうしても閉架書庫に入りたいのであれば、高位聖職者\n　から特別な許可をもらう必要があります」\\nw[僧侶]",""],["「それなら、適当に偉い坊さんを紹介してくれ」\\nw[\\N[1]]",""],["「無茶を言わないでください。\n　高名な学者や貴族でさえ、おいそれとは許可をもらえ\n　ないんですよ？」\\nw[僧侶]",""],["「例の学者さんと同じですね。\n　正攻法で頼んでも、許可は下りないみたいです」\\nw[\\N[2]]",""],["「となると、別の攻め口を考えなきゃならんか。\n　しかし、坊さんってのは融通の効かんヤツが多い\n　からなぁ……」\\nw[\\N[1]]",""],["「すみません。\n　そちらの男性の方、よろしいでしょうか？」\\nw[尼僧]",""],["「俺のことか？」\\nw[\\N[1]]",""],["「はい。\n　司教様が、あなたにお会いしたいと申しております。\\nw[尼僧]",""],["「お手数ですが、ご足労願えますでしょうか？」\\nw[尼僧]",""],["「えっ！？　\n　司教って、なんでそんな偉い人が！？」\\nw[\\N[2]]",""],["「さあな、分からん。だが渡りに舟かもしれないな。\n　会うだけ会ってみようじゃないか」\\nw[\\N[1]]",""],["「それではご案内いたします」\\nw[尼僧]",""],["案内尼僧",""],["司教（依頼Ev）",""],["「よく来てくださいました。\n　どうぞ、そちらの席におかけください」\\nw[司教]",""],["「お呼びに応じて参上したが、司教様が俺なんかに\n　いったい何の用かな？」\\nw[\\N[1]]",""],["「あの、もうちょっと礼儀正しくした方が……」\\nw[\\N[2]]",""],["「いえいえ、そう肩肘を張らずに、楽にしてください。\\nw[司教]",""],["「お呼びしたのは、あなたに依頼したいことが\n　あるからです。\\N[1]さん」\\nw[司教]",""],["「四聖教が俺に？\n　誰か別の人間と勘違いしてるんじゃないか？」\\nw[\\N[1]]",""],["「いいえ、そんなことはありません。\n　奴隷商人のあなたにお願いをしたいのです。\\nw[司教]",""],["「我々四聖教は、つねに市井の動きに注意を払っており、\n　有望な商人のリストを作成しております。\\nw[司教]",""],["「あなたの名も、つい先日そのリストに載ったところ\n　ですよ」\\nw[司教]",""],["「へぇ？\n　少しは四聖教の役に立ちそうなヤツだと、認めて\n　くれたわけだ？」\\nw[\\N[1]]",""],["「だから言い方……。\n　失礼ですよ、\\N[1]さん」\\nw[\\N[2]]",""],["「誤解しないでください。\n　なにも一方的にあなたを利用しようというのでは\n　ありません。\\nw[司教]",""],["「お互いに必要なものを補い合おう、ということです」\\nw[司教]",""],["「こちらの必要とするものは閉架書庫の閲覧だが、\n　そちらの依頼を果たせば許可してくれるのか？」\\nw[\\N[1]]",""],["「本来であれば絶対に許可できませんが……いいでしょう。\n　私の権限において閲覧できるよう手配します」\\nw[司教]",""],["「なるほど、悪くない話だ。\n　で、肝心の依頼というのは？」\\nw[\\N[1]]",""],["「王都ラウ・ディゼルにある\\C[17]王都聖堂\\C[0]はご存じですね？」\\nw[司教]",""],["「もちろんだ。\n　この大聖堂を除けば、王国で一番デカイ聖堂だったな」\\nw[\\N[1]]",""],["「はい。\n　その王都聖堂の責任者であり、四聖教のＮｏ．２である\n　\\C[17]大司教\\C[0]に、いま重大な背教の嫌疑がかかっています」\\nw[司教]",""],["「そ、そんな偉い聖職者が背教！？」\\nw[\\N[2]]",""],["「ほう？　具体的にはどんな嫌疑が？」\\nw[\\N[1]]",""],["「密貿易や違法な奴隷売買への協力、四聖教の権威を利用\n　しての不正な土地取引。\\nw[司教]",""],["「そして王都聖堂の尼僧たちを、無理矢理に自分の寝室へ\n　引き込んでいるとも」\\nw[司教]",""],["「うわぁ……聖職者のやることじゃないですね……」\\nw[\\N[2]]",""],["「こうした嫌疑は前々から囁かれていましたが、証拠を\n　つかむまでには至っておらず、ずっと野放しのまま\n　だったのです。\\nw[司教]",""],["「ところが最近になって、悪事の証拠となる\\C[17]『覚え書き』\\C[0]を\n　大司教がこまめに書き記しているらしいと分かりました。\\nw[司教]",""],["「その『覚え書き』を入手できれば、動かぬ証拠と\n　なるでしょう」\\nw[司教]",""],["「まさかそいつを、俺たちに盗んで来いと？」\\nw[\\N[1]]",""],["「はい、お察しの通りです」\\nw[司教]",""],["「ちょっと待ってくれ、俺たちはプロの泥棒じゃ\n　ないんだぞ？」\\nw[\\N[1]]",""],["「わかっています。\n　しかし今回に限っては、盗みのプロより奴隷商人の力が\n　必要なのです。\\nw[司教]",""],["「覚え書きがある大司教の寝室は常に厳重な警備下に\n　おかれており、人の目を盗んで忍び入ることは\n　まず不可能なのです。\\nw[司教]",""],["「そして大司教から寝室への入室許可が与えられるのは、\n　特定の役目をもった女性のみ――」\\nw[司教]",""],["「夜のお相手を命じられた、憐れな尼僧だけってか」\\nw[\\N[1]]",""],["「はい、まったくもって許しがたいことですが……」\\nw[司教]",""],["「だがそれなら、目端の利く尼僧をスパイにして、\n　王都聖堂へ送ればいいじゃないか」\\nw[\\N[1]]",""],["「ところが大司教もそれを警戒しており、最近では\n　正規の尼僧には手を出さないようにしているらしく」\\nw[司教]",""],["「正規の尼僧？」\\nw[\\N[1]]",""],["「現在はどうやら、奴隷商人から買った女奴隷を\n　尼僧に仕立て上げて、身辺にはべらせているよう\n　なのです。\\nw[司教]",""],["「そこであなたから、大司教へ奴隷を売り込んでもらいたい。\n　もちろんその奴隷は、こちらで用意します」\\nw[司教]",""],["「\\C[17]女スパイの潜入を手助けしろ\\C[0]ってことですか！？」\\nw[\\N[2]]",""],["「なるほど、そういう話なら……」\\nw[\\N[1]]",""],["「引き受けてもらえますか？」\\nw[司教]",""],["「分かった、その依頼を受けようじゃないか」\\nw[\\N[1]]",""],["「ありがとうございます。\\nw[司教]",""],["「では早速、潜入させる奴隷――もとい、特殊任務専門の\n　尼僧をご紹介いたしましょう」\\nw[司教]",""],["「び、びっくりしたぁ！？\n　どこから現れたんですか、この人！？」\\nw[\\N[2]]",""],["「この者が奴隷に扮して、王都聖堂へ潜入します」\\nw[司教]",""],["「よろしくお願いします、奴隷商人殿」\\nw[スパイ尼僧]",""],["「お、おう……ヨロシク」\\nw[\\N[1]]",""],["「私は先に王都へ向かい、聖堂の近くに潜伏して\n　おきますので、奴隷商人殿はあとから来てください。\\nw[スパイ尼僧]",""],["「では、これにて」\\nw[スパイ尼僧]",""],["「ではよろしく頼みます、\\N[1]さん。\n　うまくやってくださいね」\\nw[司教]",""],["依頼\\C[17]『スパイ大作戦』\\C[0]を受けた！",""],["\\>　　※　王都へ行き、\\C[17]王都聖堂\\C[0]のそばに潜伏している　※\n\\>　　※　\\C[17]スパイ尼僧\\C[0]と合流しよう。　　　　　　　　　※\\<",""],["「大司教の覚え書きを入手してくれたそうですね。\n　ありがとうございます」\\nw[司教]",""],["「予想外のトラブルもあったが、どうにかな」\\nw[\\N[1]]",""],["「スパイさんも、無事に戻ってこられたんですね」\\nw[\\N[2]]",""],["「はい。\n　自分一人逃げるだけなら、どうとでもなりますので」\\nw[スパイ尼僧]",""],["「で、これが約束の品だ」\\nw[\\N[1]]",""],["\\C[17]『大司教の覚え書き』\\C[0]を渡した！",""],["「確かに。\n　これで大司教を、背教の徒として告発することが\n　できます」\\nw[司教]",""],["「わたしが受けた仕打ちの分も、きっちり罰して\n　くださいね！」\\nw[\\N[2]]",""],["「え、ええ……。\n　忘れず罪状に数えておきます」\\nw[司教]",""],["メインシナリオ\\C[17]『スパイ大作戦』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！",""],["「依頼は果たしたんだ、閉架書庫への入室を許可して\n　もらうぞ」\\nw[\\N[1]]",""],["「はい、すでに手続きはしてありますので、彼女に\n　案内させましょう」\\nw[司教]",""],["「貴重な書籍が山のようにある場所なので、申し訳あり\n　ませんが、案内だけじゃなく監視もさせてもらいます」\\nw[スパイ尼僧]",""],["「はいはい、そーですか。\n　勝手にしてくれ」\\nw[\\N[1]]",""],["ユマ",""],["スパイ尼僧",""],["スパイ尼僧2",""],["EV038",""],["僧侶",""],["「ここでは神酒という、祈祷用の酒を作っているんだ。\n　少量だけど一般への販売も、受付の方でやっているよ」\\nw[僧侶]",""],["番兵",""],["「一般の方は、二階への立ち入り禁止となっています」\\nw[番兵]",""],["「ここは関係者以外、立ち入り禁止です」\\nw[僧侶]",""],["「写本作業の最中なので、話しかけないでください」\\nw[僧侶]",""],["「写本は神聖な労働なんだ。\n　神々の英知を世界に知らしめるための、聖務なのさ」\\nw[僧侶]",""],["「うぅ……目が疲れる……」\\nw[僧侶]",""],["「腱鞘炎と眼精疲労は、真面目に写本作業をやってる\n　証とも言える」\\nw[僧侶]",""],["「信仰と無関係な書物を写すこともあるわよ。\n　例えばこれ、『家庭菜園の手引き』とか」\\nw[尼僧]",""],["「くくくっ……この小説、面白いわね。\n　……ちょっと、サボってたことチクらないでよ」\\nw[尼僧]",""],["「速く書こうとすると誤字脱字が多くなるし、\n　丁寧にやり過ぎると作業が進まないし……悩ましい」\\nw[尼僧]",""],["「写本作業に入る前に、修復しなければならない書物も\n　多いのだよ」\\nw[司祭]",""],["番兵2",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　　『四聖神頌歌』\n\\>\n\\>　　『いと高き天と、いと広き大地に\n\\>　　　深く慈悲をたれたもう\n\\>　　　聖なる四柱の神々よ\n\\>\n\\>　　　万物を成す力はその足元より出で\n\\>　　　我らの魂をあまねく潤す\n\\>\n\\>　　　神々を称えよ\n\\>　　　聖なる力を言祝ぎ歌え\n\n\\>　　　ハァ＝ドッコイショ＝ドッコイショ\n\\>　　　騒乱なき平らかなる世のため』",""],["MWL_行数リセット",""],["\\>　　　　　　　『助祭資格試験問題集』\n\\>\n\\>『Ｑ１１\n\\>　水の神の御使いでありシンボルともされる生物は？\n\\>　　Ａ．魚\n\\>\n\\>　Ｑ１２\n\\>　第十五代総司教猊下が改革した位階制度の名は？\n\\>　　Ａ．階位十二階\n\\>\n\\>　Ｑ１３\n\\>　戒律で殺人と背教に次いで重い罪とされるのは？\n\\>　　Ａ．アナルセックス』",""],["\\>　　　　　　　『助祭資格試験問題集』\n\\>\n\\>『Ｑ１１\n\\>　水の神の御使いでありシンボルともされる生物は？\n\\>　　Ａ．魚\n\\>\n\\>　Ｑ１２\n\\>　第十五代総司教猊下が改革した位階制度の名は？\n\\>　　Ａ．階位十二階\n\\>\n\\>　Ｑ１３\n\\>　戒律で殺人と背教に次いで重い罪とされるのは？\n\\>　　Ａ．アナルセックス　　　　　　　　　　　　　　』",""],["\\>　　　　　　『四聖教認定・発禁本目録』\n\\>\n\\>　・カエギウス著『宗教発達史』\n\\>\n\\>　・デメオール著『金と聖職者の真実』\n\\>\n\\>　・リンブル著『歴史から見た四聖教』\n\\>\n\\>　・ヴィジオン著『楽しい邪教・入門編』\n\\>　\n\\>　・ヴィジオン著『楽しい邪教・地獄編』\n\\>　\n\\>　・ベノラ著『異世界に来てしまったようなので一発人生大逆転をねらってみた』\n\\>　\n\\>　・ユーゼル著『魔力実験論』",""],["地下階段前の兵士2",""],["EV056",""],["地下階段前の兵士1",""],["「こ、ここはいま立ち入り禁止だ！\n　近づいてはならん！」\\nw[番兵]",""],["「地下へはここから入れます。\n　手下の悪魔も徘徊しているようなので、どうか\n　お気をつけて」\\nw[番兵]",""],["EV059",""],["EV060",""],["イージー",""],["ノーマル",""]],"context":[["Map169/events/1/name"],["Map169/events/2/name"],["Map169/events/3/name"],["Map169/events/4/name"],["Map169/events/5/name"],["Map169/events/5/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map169/events/6/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map169/events/7/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map169/events/6/name"],["Map169/events/7/name"],["Map169/events/8/name","Map169/events/9/name","Map169/events/10/name","Map169/events/11/name","Map169/events/12/name","Map169/events/13/name"],["Map169/events/14/name","Map169/events/15/name","Map169/events/16/name","Map169/events/17/name","Map169/events/18/name","Map169/events/19/name"],["Map169/events/20/name"],["Map169/events/20/pages/0/list/28/message/noPicture/bottom"],["Map169/events/20/pages/0/list/36/comment","Map169/events/20/pages/2/list/26/comment"],["Map169/events/20/pages/0/list/57/message/noPicture/bottom"],["Map169/events/20/pages/0/list/62/message/noPicture/bottom"],["Map169/events/20/pages/0/list/67/message/noPicture/middle"],["Map169/events/21/name","Map169/events/22/name","Map169/events/23/name","Map169/events/24/name"],["Map169/events/25/name"],["Map169/events/25/pages/0/list/2/message/noPicture/middle","Map169/events/25/pages/1/list/2/message/noPicture/middle"],[