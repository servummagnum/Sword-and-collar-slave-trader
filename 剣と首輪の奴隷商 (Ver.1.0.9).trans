":["現金を賭けての勝負（繰り返し）"]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],null,[{"headerIndex":12,"headerParam":["現金がある"]}],[{"headerIndex":15,"headerParam":["現金なし"]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["勝利（賭け金ゲット）"]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["敗北（賭け金没収）"]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"燭台":4,"火":5,"光":6,"宿屋の主人":7,"宿屋の女将":8,"ドゥブカ島について":9,"「ドゥブカねぇ……そんな名前の島、この近海に\n　あったかしら？」\\nw[宿屋の女将]":10,"「魚料理が絶品だから、食べていってくださいね」\\nw[宿屋の女将]":11,"現金（窃盗用）":12,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":13,"手薄な時間帯（1=昼、2=夜）":14,"男":15,"「ドゥブカ島？　全然聞いたこともないね」\\nw[酒飲みの男]":16,"「酒も魚もうまいし、ここでの暮らしは言う事ないね」\\nw[酒飲みの男]":17,"チェック":18,"宿泊客（依頼06）":19,"依頼を出している場合":20,"依頼を出していない場合":21,"「うぅ……まだ船酔いがおさまらん。\n　これだから船旅は……」\\nw[宿泊客]":22,"依頼フキダシ":23,"宿泊客":24,"「船旅はきつかった。\n　乗船中、何度も吐いてしまったよ」\\nw[宿泊客]":25,"トイレドア（排泄Ev）":26,"トイレで用を足しますか？":27,"入る":28,"入らない":29,"いまのところ用を足す必要は無い。":30,"吟遊詩人":31,"トイレマーク（屋内用）":32,"<TE:84>":33,"ユマ（トイレ）":34,"絶倫おじさん（依頼16）":35,"「地元民じゃないんでね、島のことなんて聞かれても\n　分からないよ」\\nw[宿泊客]":36,"「島の東に\\C[17]古い灯台\\C[0]が建っているのを見たけど、\n　あそこはもう使われていないのだろうか？」\\nw[宿泊客]":37,"料理1":38,"料理2":39,"水夫1":40,"「知ってるか？\n　武器商ギルドの商人と海賊どもは繋がってたらしいぜ。\n　とんでもねぇ話だな！」\\nw[水夫]":41,"「趣味でよく海図を見てるけど、ドゥブカっていう島の\n　名前はまったく見たことがないなぁ」\\nw[水夫]":42,"「こうして出会ったのも何かの縁だ。\n　楽しく飲もうぜ！」\\nw[水夫]":43,"水夫2":44,"「なんだって？　ドゥブカ島？\n　知るかそんな島！」\\nw[水夫]":45,"「王国一の港町はこのシーグヌースだ！\n　ウェーベロイ？　知るかそんなトコ！」\\nw[水夫]":46,"水夫3":47,"「さあてね、そんな島あったかな？」\\nw[水夫]":48,"「今回の航海も無事に終わって良かった。\n　嵐にも海賊にも遭わなくて済んだよ」\\nw[水夫]":49,"水夫4":50,"「島を探してる？　ドゥブカ島？\n　悪いけど心当たりはないね」\\nw[水夫]":51,"「航海で長く家を空けてると、家族のことが心配だよ。\n　おもに妻が浮気してないかどうかが……」\\nw[水夫]":52,"ギャンブラー":53,"特定アイテムを賭けての勝負\n↓　　↓　　↓":54,"「オレとのギャンブル勝負、受けるか？\n　あんたが勝ったらこの\\C[17]妙ちくりんな球\\C[0]をあげよう。\\nw[ギャンブラー]":55,"「ただしそっちが負けたなら、お連れのお嬢ちゃんに\n　\\C[27]ヌード\\C[0]になってもらおうか？」\\nw[ギャンブラー]":56,"勝負を受ける":57,"やめておく":58,"奴隷カードの説明":59,"「よしっ、勝負だ！！」\\nw[ギャンブラー]":60,"勝利（戦利品ゲット）":61,"「参った参った、降参だ。\n　ほら、価値のある物だか分からんがもっていけ」\\nw[ギャンブラー]":62,"特殊アイテム\\C[17]『\\in[50]』\\C[0]を手に入れた！":63,"引き分け":64,"「なんだ引き分けかよ。\n　つまんねぇ結果になっちまったな」\\nw[ギャンブラー]":65,"敗北（ユマ凌辱）":66,"「オレの勝ちだな！\n　さあ、ヌードになってもらおうか……って！？\\nw[ギャンブラー]":67,"「その女、最初から裸じゃねぇか！？\n　なんなの？　変態なの？」\\nw[ギャンブラー]":68,"「たぶんヘンタイです\\I[29]」\\nw[\\N[2]]":69,"「オレの勝ちだな！\n　さあ、ヌードになってもらおうか？」\\nw[ギャンブラー]":70,"「裸になるだけでいいんですか？\n　要求が簡単すぎて物足りないくらいですよ\\I[29]」\\nw[\\N[2]]":71,"「わ、わかりました……。\n　けど……あまり見ないでください……」\\nw[\\N[2]]":72,"「はい、どうぞ\\I[29]　わたしの体どうですか？」\\nw[\\N[2]]":73,"「淫乱のくせに、処女みてぇな綺麗な体じゃねぇか。\n　男を騙す嘘吐きな体だな！」\\nw[ギャンブラー]":74,"「こ……これでいいですか……？」\\nw[\\N[2]]":75,"「くくく……いいぜぇ。\n　お前の裸、隅々まで記憶に焼き付けてやるぜ」\\nw[ギャンブラー]":76,"\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下がった！":77,"現金を賭けての勝負（繰り返し）\n↓　　↓　　↓":78,"「現金を賭けて勝負するかい？」\n（※賭け金は\\C[17]『\\v[1170]G』\\C[0]です）\\nw[ギャンブラー]":79,"賭ける":80,"現金がある":81,"現金なし":82,"「おいおい、金がないんじゃ勝負が成立しないぜ」\\nw[ギャンブラー]":83,"勝利（賭け金ゲット）":84,"「くそっ、今日はツイてねぇぜ……！」\\nw[ギャンブラー]":85,"\\C[17]『\\v[1170]G』\\C[0]を手に入れた！":86,"敗北（賭け金没収）":87,"「へへっ！　悪く思うなよ。\n　こっちにツキがあったんだ」\\nw[ギャンブラー]":88,"\\C[9]『\\v[1170]G』\\C[0]を失った！":89,"ギャンブルふきだし":90,"EV032":91,"変態紳士（依頼17）":92},"extension":"json","dataType":"map","filename":"Map080","basename":"Map080.json","path":"data/Map080.json","relPath":"data/Map080.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":93,"percent":0},"cellInfo":[]},"data/Map081.json":{"data":[["EV001",""],["EV002",""]],"context":[["Map081/events/1/name"],["Map081/events/2/name"]],"tags":[["gold"],["gold"]],"parameters":[],"indexIds":{"EV001":0,"EV002":1},"extension":"json","dataType":"map","filename":"Map081","basename":"Map081.json","path":"data/Map081.json","relPath":"data/Map081.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":2,"percent":0},"cellInfo":[]},"data/Map082.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["燭台",""],["火",""],["光",""],["宿屋の主人",""],["宿屋の女将",""],["「モリモリ食べて、スヤスヤ眠って、\n　ステキな冒険ライフを満喫しましょう！」\\nw[宿屋の女将]",""],["男性冒険者2",""],["「絶対にひと山当てるからさ、そうしたら俺と\n　所帯を持ってくれよぉ」\\nw[男性冒険者]",""],["男",""],["「モンスターにブッ殺された戦友の冥福を祈って、\n　乾杯ってね！」\\nw[酒飲みの男]",""],["吟遊詩人",""],["宿泊客（依頼06）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「最近は冒険者も、下働きに奴隷を使ったりするんだ。\n　それで今度、奴隷のレンタル事業を始めようかと考えて\n　いるんだ」\\nw[宿泊客]",""],["依頼フキダシ",""],["料理1",""],["女性客",""],["「あんたの言動はいちいち胡散臭いのよ。\n　冒険者の言葉なんて信じられないわ」\\nw[女性]",""],["料理2",""],["女性冒険者",""],["「リーダーのやつ、まさかお宝をネコババしてたとはね」\\nw[女性冒険者]",""],["男性冒険者",""],["「このパーティもこれで解散だな。\n　リーダーがすべてを台無しにしやがった……！」\\nw[男性冒険者]",""],["女性冒険者2",""],["「ロクでもない男だと思ってたけど、あたしたちを\n　ずっと騙してたなんて……ゆるせない！」\\nw[女性冒険者]",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["ユマ（トイレ）",""],["絶倫おじさん（依頼16）",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["変態紳士（依頼17）",""],["窃盗用下着2",""],["<TE:117>",""]],"context":[["Map082/events/1/name"],["Map082/events/2/name"],["Map082/events/3/name"],["Map082/events/4/name"],["Map082/events/5/name"],["Map082/events/6/name"],["Map082/events/7/name","Map082/events/8/name"],["Map082/events/9/name"],["Map082/events/10/name"],["Map082/events/10/pages/0/list/0/message/noPicture/bottom"],["Map082/events/11/name"],["Map082/events/11/pages/0/list/0/message/noPicture/bottom","Map082/events/11/pages/2/list/0/message/noPicture/bottom"],["Map082/events/12/name"],["Map082/events/12/pages/0/list/0/message/noPicture/bottom"],["Map082/events/13/name"],["Map082/events/14/name"],["Map082/events/14/pages/0/list/0/comment","Map082/events/25/pages/0/list/1/comment","Map082/events/28/pages/0/list/1/comment"],["Map082/events/14/pages/0/list/10/comment"],["Map082/events/14/pages/0/list/11/message/noPicture/bottom"],["Map082/events/15/name","Map082/events/26/name","Map082/events/29/name"],["Map082/events/16/name"],["Map082/events/17/name"],["Map082/events/17/pages/0/list/0