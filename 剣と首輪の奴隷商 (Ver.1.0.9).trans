],[{"headerIndex":42,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":86,"headerParam":["",0,0,2]}],[{"headerIndex":90,"headerParam":["",0,0,2]}],[{"headerIndex":93,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["",0,0,2]}],[{"headerIndex":101,"headerParam":["",0,0,2]}],[{"headerIndex":104,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[{"headerIndex":46,"headerParam":["",0,0,2]}],[{"headerIndex":52,"headerParam":["",0,0,2]}],[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":78,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,1,1]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"入り口":1,"商業ギルド":2,"武器屋入り口":3,"武器防具店":4,"アクセサリ店":5,"魔法具店入り口":6,"魔法具店":7,"卸売商会":8,"宿屋":9,"馬車屋":10,"EV009":11,"EV010":12,"EV011":13,"EV012":14,"EV013":15,"EV014":16,"まず、ユマの父親のいる店に行かなければ。":17,"EV015":18,"EV016":19,"EV017":20,"EV018":21,"EV019":22,"EV020":23,"EV021":24,"EV022":25,"EV023":26,"EV024":27,"EV025":28,"EV026":29,"EV027":30,"EV028":31,"EV029":32,"景気ランタン":33,"EV031":34,"EV032":35,"EV033":36,"EV035":37,"EV036":38,"EV037":39,"EV038":40,"EV039":41,"EV040":42,"EV041":43,"女性":44,"「たとえ\\N[6]が襲い来るとしても、きっと四聖神が\n　守ってくださるわ……」\\nw[信心深い女]":45,"「大司教様が背教したという噂が流れているけれど、\n　きっと何かの間違いだわ」\\nw[信心深い女]":46,"「あなた商人なの？\n　儲けているんなら、ちゃんと聖堂に寄付しなさいよ」\\nw[信心深い女]":47,"男性市民（闘技場）":48,"「おい聞いたか！？\n　伝説の悪竜が甦って、パルフュークを攻撃したって！」\\nw[男性]":49,"「剣闘試合は賭けの対象になってるから、みんな熱く\n　なりやすいんだよなぁ」\\nw[男性]":50,"「あんた、なかなか強そうだな。\n　\\C[17]闘技場\\C[0]で剣闘試合に出てみたらどうだい？」\\nw[男性]":51,"男性":52,"「チェリア様の即位で、これから王国は良くなっていくと\n　信じてるよ」\\nw[地元の男]":53,"「嘘か本当か分からんが、大公が反乱を目論んで\n　悪竜を復活させたとか。世も末だぜ」\\nw[地元の男]":54,"「王都に来ることを夢見る田舎者は多いらしいが、そんなに\n　憧れるほどのもんかねぇ？」\\nw[地元の男]":55,"女性市民（闘技場）":56,"「パルフューク大公がアルテトを甦らせたって\n　聞いたけど、本当なのかしら？」\\nw[女性]":57,"「また剣闘試合が原因で、観客の乱闘騒ぎがあったん\n　ですって。まったく、バカみたい」\\nw[女性]":58,"「もしかして剣闘試合の観戦にきたの？\n　やめときなさいよ、あんな暴力的なもの」\\nw[女性]":59,"「悪竜アルテトの復活と聞いて、冒険者の血がひさびさに\n　うずき出してきたぜ」\\nw[元冒険者]":60,"「今度、冒険で稼いだ金を元手にして宿屋を開くんだ。\n　冒険者ってのも一生続けられる仕事じゃないからね」\\nw[元冒険者]":61,"女性市民（公園）":62,"「悪竜は死んだっていうし、ようやく外で子供を遊ばせ\n　られるわ」\\nw[母親]":63,"「副都は悪竜とモンスターに襲われて大変なことに\n　なったらしいけど、王都は大丈夫かしら？」\\nw[母親]":64,"「子供はちっとも、じっとしてないんだから」\\nw[母親]":65,"「悪竜が相手じゃ、あたしみたいな普通の冒険者風情には\n　出る幕が無さそうだね」\\nw[冒険者]":66,"「王都は規模の割に、冒険の依頼はそれほど多くないんだ。\n　雑用みたいな仕事の依頼はたくさん来るけど」\\nw[冒険者]":67,"公園猫":68,"依頼フキダシ":69,"工事監督官（依頼31）":70,"依頼を出している場合":71,"執事（依頼21）":72,"研究者（依頼32)":73,"スケベじじい（依頼19）":74,"男性市民（公園）":75,"「大公殿下が悪竜を甦らせたというデマを、ワシは信じて\n　しまったのだ。なんと愚かだったことか……」\\nw[老人]":76,"「国王と違って、大公殿下は分別のある方だとおもって\n　おったが……悪竜を甦らせるとは、なんとバカげた\n　行いをしたものか」\\nw[老人]":77,"「散歩の途中に、ここに立ち寄るのが日課でね」\\nw[老人]":78,"子供（公園）":79,"「アヒルさん、こっち向いて！\n　ぐわっ！　ぐわっ！」\\nw[女の子]":80,"公園アヒル":81,"公園看板":82,"『王都中央公園』":83,"女の子（道端）":84,"「あくりゅうって、おっきいんでしょ？\n　あたし見てみたい！」\\nw[女の子]":85,"「だいじょうぶ！　迷子じゃないよ！\n　ほんとだよ！」\\nw[女の子]":86,"「悪竜が空を飛ぼうが、大公が反逆しようが、\n　変わらずオレの腹は減るんだよなぁ……」\\nw[薄汚い男]":87,"「あぁクソッ！　腹減ったなぁ……。\n　どうせお前らはいいモン食ってんだろ？」\\nw[薄汚い男]":88,"「……なにもかも、どうでもいい」\\nw[愛想のない男]":89,"「……話す気分じゃない。放っておいてくれ」\\nw[愛想のない男]":90,"光":91,"EV066":92,"犬":93,"依頼掲示板":94,"掲示板マーク":95,"兵士":96,"兵士（追跡）":97,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":98,"馬車":99,"通行遮断":100,"食料品店":101,"おっぱいマニア（依頼18）":102,"浮気調査（依頼13・14・15）":103,"尾行対象（依頼13・14・15）":104,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":105,"難易度ノーマル用":106,"難易度イージー用（振り向く前に立ち止まる時間が倍）":107,"視界範囲に引っかかったとき":108,"SmartPath 0 14 20":109,"周囲2マス圏内に侵入したとき":110,"尾行に気づいて逃走":111,"浮気相手の元へゴールしたとき":112,"ターゲット表示":113,"浮気相手(依頼11)":114,"落ちてる精霊石（街）":115,"白骨":116,"白骨化した死体が放置されている。":117,"「お前たちは旅行者か？\n　いいか、王都で変な真似をするなよ」\\nw[兵士]":118,"娼館":119,"闘技場":120,"「世間はアルテト復活の噂話で持ち切りだが、\n　そんなことは関係なく、今日も私はギャンブル三昧さ」\\nw[年配の男]":121,"「どうしても闘技場に足が向いてしまうんだ。\n　これってギャンブル依存症なのか……？」\\nw[男性]":122,"「この闘技場で行われているのは、剣闘試合って言っても\n　人間同士の戦いじゃないんだ。\\nw[男性]":123,"「剣闘士の試合相手はモンスターなのさ」\\nw[男性]":124,"女性（貧民街）1":125,"「アルテトが来たら、こんなクソったれな生活も\n　終わりかしらね」\\nw[やつれた女]":126,"「あたいはどんだけ貧乏になろうと、体だけは売らないって\n　決めてるんだ。\n　おかげでまともに食えちゃいないんだけどね」\\nw[やつれた女]":127,"男性（貧民街）2":128,"「フン。\n　アルテトが街を焼き払ってくれたら清々するかもな」\\nw[薄汚い男]":129,"「腹減ったなぁ……。\n　川向うの店から、またメシをいただいてくるかな」\\nw[薄汚い男]":130,"闘技場飾り":131,"壁ひび":132,"※\nアイテム：瞬発剤\n※":133,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":134,"↓アイテムのIDNo.を変数に入力する":135,"↓アイテムの入手個数を変数に入力する":136,"↓アイテムの重量を変数に入力する":137,"個別依頼12":138,"性奴隷が欲しい":139,"「僕は人より性欲が強くて、週に三度は娼館へ足を\n　運んでいるんです」\\nw[男]":140,"「へぇ、そんなに通ってたら、支払う金もバカにならない\n　だろ？」\\nw[\\N[1]]":141,"「まったくその通り！\n　生活費を削りまくりですよ！\\nw[男]":142,"「だからいっそ、自分専用の性奴隷を買おうかと思った\n　んですけど、奴隷市で探しても好みの娘が見つから\n　なくて。\\nw[男]":143,"「あなた奴隷商人なら、\\C[17]僕の好みに合う奴隷\\C[0]を\n　探してきてくれませんか？」\\nw[男]":144,"「ちなみに、どんな娘が好みなんですか？」\\nw[\\N[2]]":145,"「えっと……ちなみに好みというのは？」\\nw[\\N[2]]":146,"「\\C[17]人間の女の子\\C[0]で、髪は\\C[17]ピンク\\C[0]がいいな。\n　胸のサイズは\\C[17]普通\\C[0]で。\\nw[男]":147,"「ただしお金はないんで、報酬は\\C[17]精霊石５個\\C[0]ってことで\n　お願いできませんか？」\\nw[男]":148,"個別依頼『性奴隷が欲しい』を受けますか？":149,"受ける":150,"受けない":151,"迷いの森・南東":152,"盗賊の隠れ家":153,"個別依頼\\C[17]『性奴隷が欲しい』\\C[0]を受けた！":154,"\\C[17]『\\in[102]』\\C[0]を依頼者に渡しますか？":155,"渡す":156,"渡さない":157,"依頼条件達成":158,"「ご希望の奴隷を連れてきたぞ。どうだ？」\\nw[\\N[1]]":159,"「すごい！　完璧ですよ！\n　この娘が相手なら、何度でもパコれそうだ！\\nw[男]":160,"「ありがとうございました！」\\nw[男]":161,"個別依頼\\C[17]『性奴隷が欲しい』\\C[0]を達成した！":162,"\nここからエッチイベント\n↓　　↓　　↓":163,"↓プレーヤー位置強制中央":164,"SFC_ENABLE_RESERVE":165,"依頼条件未達成":166,"「楽しみにしているので、早く性奴隷を連れてきて\n　くださいね」\\nw[男]":167,"噴水":168,"貧民街アジト入り口":169,"アジト":170,"アジト見張り":171,"シーグヌースへ行く前":172,"「なんだテメェは？\n　ウロチョロしてんじゃねぇよ！」\\nw[見張りの男]":173,"シーグヌースへ行ったあと":174,"ボスと会う条件OKの場合":175,"「俺は\\N[1]という奴隷商人なんだが、ここに\n　いるボスと面会したいんだ。\n　取り次いでくれるか？」\\nw[\\N[1]]":176,"「ん？　\\N[1]？\n　どっかで聞いたことあるような……。\\nw[見張りの男]":177,"「ちょっと待ってろ、ボスに訊いてくるから」\\nw[見張りの男]":178,"「これ、もしかして面会できるんじゃ……？」\\nw[\\N[2]]":179,"「そうでなきゃ困る。\n　いまさら門前払いなんて、されてたまるか」\\nw[\\N[1]]":180,"「いいぜ、入れ。\n　ただしこの中で見聞きしたことは、絶対に口外するなよ」\\nw[見張りの男]":181,"「やった！」\\nw[\\N[2]]":182,"「貧民街のボスとご対面といくか」\\nw[\\N[1]]":183,"ボスと会う条件未達成の場合":184,"「俺は\\N[1]という奴隷商人なんだが――」\\nw[\\N[1]]":185,"「それがどうした？\n　さっさと俺の視界から消えろって言ってんのが\n　分かんねぇか？」\\nw[見張りの男]":186,"「やっぱりダメみたいですね。\n　もっと商人としての知名度を上げてからじゃないと……」\\nw[\\N[2]]":187,"「……みたいだな。出直すとするか」\\nw[\\N[1]]":188,"「ボスは奥の部屋で待ってる。早くいけ」\\nw[見張りの男]":189,"「ボスからのお達しだ。\n　今後アジトへの出入りは、自由にしていいそうだ」\\nw[見張りの男]":190,"男性（貧民街）":191,"「どうせ王が代替わりしたところで、この貧民街は\n　そのまま放置され続けるんだろうさ」\\nw[男]":192,"「そのうち王都にもモンスターが押し寄せてくるんだ\n　ろうか？」\\nw[男]":193,"「この辺の舗装路がボコボコになってるのは、みんなが\n　勝手に剥がして持ち帰ってるからなんだ。\\nw[男]":194,"「家の補修とか、漬物石だとかに使ってるみたいだな」\\nw[男]":195,"「川向うのお上品な街並みなんて、いっそアルテトに\n　滅茶苦茶にされちまえばいいんだ」\\nw[男]":196,"「そこの家の周りだけ、路面が綺麗だろ？\n　あそこはこの貧民街を牛耳るボスのアジトだからだよ」\\nw[男]":197,"オカマバー入り口":198,"ドアは閉まっていて、開かない。":199,"酒場":200,"ユマ父誘導":201,"スパイ尼僧":202,"「お待ちしていました、奴隷商人殿」\\nw[スパイ尼僧]":203,"「お前、あのスパイ尼僧か？\n　その見た目、全然別人じゃないか」\\nw[\\N[1]]":204,"「まったく気づきませんでした」\\nw[\\N[2]]":205,"「この程度の変装は、できて当然です。\n　それよりも、今後どう動くかについてですが――。\\nw[スパイ尼僧]":206,"「これをお渡ししますので、なくさないように」\\nw[スパイ尼僧]":207,"「なんですか、その袋は？\n　ずいぶん重そうですけど」\\nw[\\N[2]]":208,"「中に\\C[17]１０万Ｇ\\C[0]入っています」\\nw[スパイ尼僧]":209,"「じっ、じうまんゴールド！？」\\nw[\\N[2]]":210,"スパイ尼僧から\\C[17]１０万Ｇ\\C[0]を受け取った！":211,"「なるほど、確かに中身は大量の貨幣みたいだが、\n　これをどうしろと？」\\nw[\\N[1]]":212,"「そのお金を使って、大司教に近づいてください。\n　まずヤツとの間にパイプを作らなければ、奴隷を売り込む\n　こともできないでしょう？」\\nw[スパイ尼僧]":213,"「\\C[17]大量の寄付金で、大司教の歓心を買え\\C[0]ってことか」\\nw[\\N[1]]":214,"「分かっていると思いますが、くれぐれもそのお金を\n　他のことに使ったりしないよう」\\nw[スパイ尼僧]":215,"「ＯＫ、ＯＫ！\n　まあ任せておけって」\\nw[\\N[1]]":216,"「私はここで待機していますので、お願いします」\\nw[スパイ尼僧]":217,"\\>　　※　王都聖堂の中に入り、\\C[17]１０万Ｇ\\C[0]を寄付して　※\n\\>　　※　こよう。　　　　　　　　　　　　　　　　※\\<":218,"「お渡しした１０万Ｇ、ちゃんと王都聖堂に寄付\n　してくださいよ」\\nw[スパイ尼僧]":219,"「奴隷商人殿、首尾はどうでした？」\\nw[スパイ尼僧]":220,"「それが、カクカクシカジカで、\\N[2]のことまで\n　一緒に連れてこいって言い出してな」\\nw[\\N[1]]":221,"「わたしは一向にかまわないですよ\\I[29]」\\nw[\\N[2]]":222,"「そ、そうなんですか……？」\\nw[スパイ尼僧]":223,"「イヤですよぉ！　わたしイヤですからねぇ！」\\nw[\\N[2]]":224,"「しかしここで大司教の機嫌を損ねて、もし話がダメに\n　なったりしたら……」\\nw[スパイ尼僧]":225,"「そうだな、チャンスを潰すわけにはいかない。":226,"「だが正直、\\N[2]をあんなハゲジジイに献上するってのも\n　癪だぜ」\\nw[\\N[1]]":227,"「ではこうしましょう。」\\nw[スパイ尼僧]":228,"「大司教の相手は私がしますので、そのあいだに\\C[17]\\N[2]さん\n　が『覚え書き』を探す\\C[0]のです。\\nw[スパイ尼僧]":229,"「わ、わたしがですか！？」\\nw[\\N[2]]":230,"「覚え書きを見つけたら、脱出をサポートしますので。\n　それでどうでしょう？」\\nw[スパイ尼僧]":231,"「不安は残るが……その案でいくしかないか。\n　\\N[2]、いいか？」\\nw[\\N[1]]":232,"「わっ、わかりました……。\n　わたしだってこれまで、何度も修羅場をくぐってきた\n　経験が……あぁでも……うぅ……」\\nw[\\N[2]]":233,"「いまいち覚悟が決まってないようですけど、やるしか\n　ありませんよ」\\nw[スパイ尼僧]":234,"「うぉっ！？\n　一瞬で別人みたいな奴隷姿に！？」\\nw[\\N[1]]":235,"「それでは参りましょう」\\nw[スパイ尼僧]":236,"\\>　※　\\C[17]裏口から\\C[0]王都聖堂に入り、\\N[2]とスパイ尼僧を\\C[0]　※\n\\>　※　大司教に引き渡そう。　　　　　　　　　　　　※\\<":237,"トークマーク":238,"裏口以外、進入禁止":239,"裏口から入るよう指示されている。":240,"聖堂":241,"裏口":242,"裏口マーク":243,"奴隷引き渡し誘導":244,"\\N[2]とスパイ尼僧を、大司教に引き渡さなければ。":245,"いま王都聖堂に近づくわけにはいかない。":246,"奴隷引き渡し後Ev":247,"「あとはスパイ尼僧の手腕と、\\N[2]の悪運を信じて\n　待つしかないか……」\\nw[\\N[1]]":248,"王都聖堂脱出":249,"「かなりの時間が経つが……どうなってるんだ？\n　\\N[2]は無事なのか？」\\nw[\\N[1]]":250,"「戻ってこれたか！\n　それで、うまくいったのか！？」\\nw[\\N[1]]":251,"「それが……」\\nw[スパイ尼僧]":252,"「…………」\\nw[\\N[2]]":253,"「な、なにがあった！？」\\nw[\\N[1]]":254,"「覚え書きを探すのに手間取り、怪しまれてしまって……\n　\\N[2]さんは大司教の餌食に……。\\nw[スパイ尼僧]":255,"「ただ、その隙に私が覚え書きを探し当てたので、\n　\\C[17]計画自体は成功\\C[0]しました」\\nw[スパイ尼僧]":256,"「おいっ、\\N[2]！　大丈夫か！？\n　しっかりしろ、おーい！」\\nw[\\N[1]]":257,"「…………。\\nw[\\N[2]]":258,"「……だ、だいじょぶれす……ただちょっと……全部の穴で\n　イキすぎちゃってぇ……\\I[29]」\\nw[\\N[2]]":259,"「……だいじょぶです……ただちょっと……穴という穴を\n　犯されて……心が折れただけで……」\\nw[\\N[2]]":260,"「そうか、大丈夫か。なら良かった」\\nw[\\N[1]]":261,"「えっ！？　それで済ましちゃうんですか！？」\\nw[スパイ尼僧]":262,"「たぶん問題はないだろ。\n　今日は安全日だから、大司教の種を孕むようなことも\n　ないだろうし」\\nw[\\N[1]]":263,"「え！？　もしかして、わたしの周期をちゃんと把握して\n　くれてるんですか！？」\\nw[\\N[2]]":264,"「もちろんだ。\n　お前のことをいつも見てるからな（性的な目線で）」\\nw[\\N[1]]":265,"「まあそんなに落ち込むな。\n　今日は安全日だから、大司教の種を孕むようなことは\n　ないだろ」\\nw[\\N[1]]":266,"「なっ……なんで\\N[1]さんが、わたしの周期を\n　知ってるんですか！？」\\nw[\\N[2]]":267,"「お前のことをいつも見てるからだ（性的な目線で）」\\nw[\\N[1]]":268,"「わたしのことを、いつも！？（恋愛的な意味で！？）」\\nw[\\N[2]]":269,"「えっと、あの……ほんとにだいじょぶです！\n　いま立ち直りましたから！」\\nw[\\N[2]]":270,"（この娘、奴隷になっていなくても、悪い男に引っかかって\n　苦労したでしょうね、きっと……）\\nw[スパイ尼僧]":271,"「ではすぐにこの場を去りましょう。\n　そろそろ騒ぎに――」\\nw[スパイ尼僧]":272,"\\{「賊だー！　賊が出たぞーッ！！」\\nw[騒ぎ声]":273,"「さっそく騒ぎ出したな。\n　見つかる前にずらかるぞ！」\\nw[\\N[1]]":274,"「それではここで別れましょう。\n　私が囮になるので、奴隷商人殿は覚え書きを大聖堂へ\n　届けてください」\\nw[スパイ尼僧]":275,"\\>　　※　スパイ尼僧から\\C[17]『大司教の覚え書き』\\C[0]を\\C[0]　※\n\\>　　※　受け取った。　　　　　　　　　　　　　※\\<":276,"\n\\>　　　※　\\C[17]大聖堂\\C[0]にいる司教のところへ届けよう　※\\<\\>":277,"「無事だったか！\n　それで、うまくいったのか！？」\\nw[\\N[1]]":278,"「はいっ！\n　例の覚え書きは、ちゃんと手に入れてきました！\\nw[\\N[2]]":279,"「よしっ！　でかした！」\\nw[\\N[1]]":280,"「でもわたし一人が脱出するだけで精一杯で、\n　スパイさんはまだ中に……」\\nw[\\N[2]]":281,"「あいつなら大丈夫だろ。自力で脱出するさ。\n　それより、俺たちが捕まらないようにしないと」\\nw[\\N[1]]":282,"\\{「賊を探せーッ！！」\\nw[騒ぎ声]":283,"「言ってるそばからこれだ。\n　僧侶どもに見つかる前にずらかるぞ！」\\nw[\\N[1]]":284,"\\>　　　※　\\C[17]『大司教の覚え書き』\\C[0]を\\C[17]大聖堂\\C[0]にいる　※\\<\n\\>　　　※　司教のところまで届けよう　　　　　　※\\<":285,"スパイ尼僧（脱出）":286,"ユマ（脱出）":287,"見張り1":288,"見張り2":289,"怒りマーク":290,"女神像（出入口）":291,"女神像だ。":292,"ここから地下の秘密通路に入りますか？":293,"入る":294,"入らない":295,"地下通路":296,"奴隷3":297,"「うるさいニンゲンつぶしたら、どれいにされた。\n　しぬのはイヤだから、したがってる」\\nw[鬼奴隷]":298,"奴隷2":299,"「王様が替わろうと、オレの境遇が変わるわけでもなし……」\\nw[奴隷]":300,"「くっくっくっ……。\n　王宮に盗みに入ろうとして捕まったオレが、こんな目と\n　鼻の先で使役されることになるとは、皮肉なもんだ」\\nw[奴隷]":301,"女性市民（道端）":302,"「\\N[5]姫はみんなに愛されていたわ。\n　どうか姫の魂が安らかに眠りますよう……」\\nw[女性]":303,"「アルテトが生き返って、英雄王リジェルダ様は\n　死んだままなんて不公平じゃない？」\\nw[女性]":304,"「生粋の王都っ子は、王室に対して批判的なことが\n　多いの。\n　でも\\N[5]姫はみんなに愛されてるのよ」\\nw[女性]":305,"駅馬車":306,"子供（公園）2":307,"「ずぎゃぎゃぎゃぎゃっ！\n　おれさまのこうげきっ！　あるてとはしんだ！！」\\nw[男の子]":308,"「うわー！　ずどどどどっ！\n　おれさまのこうげきっ！　ばしゅーん！！」\\nw[男の子]":309,"メイド待ち伏せ":310,"ラーナ姫の演説を聞かないまま、このイベントに来たとき":311,"「酒場に来たメイドだな？」\\nw[\\N[1]]":312,"「はい。ご足労いただきありがとうございます」\\nw[メイド]":313,"「あ、あの……どういったご用件で、その……」\\nw[\\N[2]]":314,"「どうか警戒なさらないでください。\n　ただ、私のお仕えする主人と会っていただきたい\n　だけなのです」\\nw[メイド]":315,"「その主人ってのは、どこの誰なんだ？」\\nw[\\N[1]]":316,"「おいそれと名を口にすることはできないのです。\n　どうかお会いいただいて、ご自身の目でお確かめください」\\nw[メイド]":317,"「隠し階段とは驚いたな」\\nw[\\N[1]]":318,"「どうぞ中へお進みください。\n　主人がお待ち申しております」\\nw[メイド]":319,"「ど、どうするんですか……？」\\nw[\\N[2]]":320,"「行くに決まってるだろ。\n　ここで引き返すようなら、最初から誘いには乗らんさ」\\nw[\\N[1]]":321,"門番兵士1":322,"「ここは王宮である！\n　みだりに近づかないように！」\\nw[門番兵士]":323,"門番兵士2":324,"王宮出入り禁止":325,"「市民が許可なく王宮に入ってはならない！\n　不審者として逮捕されたいか！？」\\nw[門番兵士]":326,"女性市民（王宮前Ev）":327,"「\\N[5]姫が亡くなられたなんて……うぅ……」\\nw[メガネの女性]":328,"「信頼していた叔父に裏切られたわけだから、\\N[5]姫も\n　さぞ気落ちしてらっしゃるでしょうね」\\nw[メガネの女性]":329,"「これから、王都の民に向けた\\C[17]\\N[5]姫\\C[0]のご挨拶がある\n　らしいの。楽しみだわ♪」\\nw[メガネの女性]":330,"「職人の方が教えてくれた通りですね！」\\nw[\\N[2]]":331,"「ほんと、姫とかどうでもいいんだがなぁ……」\\nw[\\N[1]]":332,"「姫の挨拶？」\\nw[\\N[1]]":333,"「\\N[5]姫って言ったら、王国一の美少女と名高い\n　有名人じゃないですか！\\nw[\\N[2]]":334,"「その姫様が市民の前に出て来られるんですか？\n　すごーい！」\\nw[\\N[2]]":335,"「そうなの、すごいのよ。\n　姫様を見られるなんて、年に一度あるかないか\n　だから」\\nw[メガネの女性]":336,"「\\N[1]さん！\n　わたしたちも\\N[5]姫の挨拶を見て行きましょうよ！」\\nw[\\N[2]]":337,"「めんどくせぇ。\n　姫なんか見たからって、何になるっていうんだ？」\\nw[\\N[1]]":338,"「えっ！？　見たくないんですか！？\\nw[\\N[2]]":339,"「\\N[1]さんのことだから、てっきりイヤラシイ顔\n　して、舐め回すように姫様を凝視すると思ったのに……」\\nw[\\N[2]]":340,"「お前は俺をなんだと思ってるんだ！？\n　そんなこと言ってると、今夜ベッドでお前の穴をひたすら\n　凝視してやるぞ！」\\nw[\\N[1]]":341,"「そういうこと言うからですよ～！」\\nw[\\N[2]]":342,"「フンッ！　王族なんてロクなもんじゃないぞ？」\\nw[\\N[1]]":343,"「それでもいいですからぁ～。\n　見ましょうよ」\\nw[\\N[2]]":344,"「わかった、わかった。好きにしろ」\\nw[\\N[1]]":345,"「やったぁー！」\\nw[\\N[2]]":346,"「\\N[5]姫、やっぱり美しいわねぇ。\n　女でも見惚れちゃうくらいだわ」\\nw[メガネの女性]":347,"「\\N[5]姫は、女のあたしでも見惚れちゃうくらい\n　美しいのよ」\\nw[メガネの女性]":348,"「大公様に濡れ衣を着せたのも、ぜんぶ\\N[5]姫様に\n　化けた\\N[6]の仕業だったそうよ。ひどいわねぇ」\\nw[青髪の女性]":349,"「副都の大公様が、王様を殺すためにアルテトを\n　復活させたんだそうよ。\n　なんてひどい話かしらね」\\nw[青髪の女性]":350,"「もういっそ、私たちで\\N[5]姫様のファンクラブを\n　作っちゃおうかしら？」\\nw[青髪の女性]":351,"「\\N[5]姫様のお姿を拝見できる、数少ない機会だもの。\n　見逃さないようにしなくちゃ」\\nw[青髪の女性]":352,"女性市民（王宮前Ev）会話マーク":353,"姫挨拶・演説Ev":354,"「よくもまあ、こんなに集まったもんだな」\\nw[\\N[1]]":355,"「やっぱりみんな、お姫様を見たいんですね」\\nw[\\N[2]]":356,"「そういや、挨拶って何の挨拶なんだ？\n　今日は王宮の行事でもある日なのか？」\\nw[\\N[1]]":357,"「さあ？　建国記念日とかじゃないですよね？」\\nw[\\N[2]]":358,"「始まるようだな」\\nw[\\N[1]]":359,"\\{「姫様ぁ～！！」\\}\\nw[群衆]":360,"\\{「\\N[5]姫ぇ～ッ！！」\\}\\nw[群衆]":361,"「すごい人気！\n　\\N[5]姫ってみんなから愛されてるんですねぇ」\\nw[\\N[2]]":362,"\\{「わああああぁあぁぁっ！！\n　姫様がお出ましになられたぞぉ！！」\\}\\nw[群衆]":363,"「愛する国民のみなさん。\n　お集まりいただき、ありがとうございます♪」\\nw[\\N[5]]":364,"「あれが\\N[5]姫……噂に違わない美人ですねぇ」\\nw[\\N[2]]":365,"「まあ、顔は悪くないな」\\nw[\\N[1]]":366,"「なんで上から目線なんですか……」\\nw[\\N[2]]":367,"「今日のこの良き日を、みなさんと供に祝えることを\n　喜ばしく思います」\\nw[\\N[5]]":368,"「ところで\\N[5]姫の隣にいる、王冠を被ったパッとしない\n　中年男性は誰ですか？」\\nw[\\N[2]]":369,"「王冠被ってるんだから、国王に決まってるだろうが。\n　あれがこの国の最高権力者だ」\\nw[\\N[1]]":370,"「え～？\n　あんなどこにでもいそうなくたびれたオジサンが、\n　王様で\\N[5]姫の父親なんですかぁ？」\\nw[\\N[2]]":371,"「王なんて、あんなもんだ。\n　英雄だった建国王リジェルダの子孫と言っても、本人が\n　英雄なわけでもないしな」\\nw[\\N[1]]":372,"「ご存じの通り、今日は国王陛下の誕生日。\\nw[\\N[5]]":373,"「父を祝福するため、こんなにもたくさんの方々がいらして\n　くれたことに、改めてお礼を申します」\\nw[\\N[5]]":374,"「あっ、王様の誕生日だったんだ……。\n　でもこれ、どう見ても\\N[5]姫が主役ですよね？」\\nw[\\N[2]]":375,"\\{「\\N[5]姫様ぁ～！！　好きだぁっ！！」\\}\\nw[群衆]":376,"\\{「姫様ぁ～！！　こっち見てぇ～！！」\\}\\nw[群衆]":377,"「父上、どうぞご挨拶を」\\nw[\\N[5]]":378,"「うむ！\\nw[国王]":379,"「国民よ！\n　余の誕生日を祝いによくぞ集まってくれた！\\nw[国王]":380,"「これほど民に慕われるとは、為政者として誠に本望で\n　あり――」\\nw[国王]":381,"\\{「\\N[5]様ぁ～！！　姫様ぁ～っ！！」\\}\\nw[群衆]":382,"「誰も王様の話、聞いてないですね」\\nw[\\N[2]]":383,"「失政続きのくせに、それを自覚してないアホ王\n　だからな。\\nw[\\N[1]]":384,"「娘の人気がなけりゃ、この１０分の１も人が集まったか\n　どうか」\\nw[\\N[1]]":385,"「王たる者の務めとして、余は日々精進し、\n　一日とて国を思わぬ日は無く――」\\nw[国王]":386,"\\{「王様はどうでもいいから、姫様に\n　しゃべらせろぉ！」\\}\\nw[群衆]":387,"「国民のみなさんは、今日も元気一杯ですわねぇ。\n　良いことです♪」\\nw[\\N[5]]":388,"「さて、もう行くぞ」\\nw[\\N[1]]":389,"「え～！\n　もうちょっとくらい、いいじゃないですかぁ」\\nw[\\N[2]]":390,"「これ以上、アホ王の演説なんか聞いてられるか！\n　耳が腐る！」\\nw[\\N[1]]":391,"「そういうこと大声で言ってると、不敬罪で\n　捕まっちゃいますよぉ～」\\nw[\\N[2]]":392,"「この群衆の中に入ってしまえば、まず見つからんだろう」\\nw[貧民街のボス]":393,"「ふぅー……助かったぜ。\\nw[\\N[1]]":394,"「だが、なんであんたが俺たちの手助けを？」\\nw[\\N[1]]":395,"「お金になる話にしか興味が無かったんじゃ？」\\nw[\\N[2]]":396,"「そう、金にならんトラブルなど、俺の知ったことでは\n　ない。\\nw[貧民街のボス]":397,"「だが放置しておけば、人間の皮をかぶった悪竜によって\n　この国自体が崩壊しかねないのだろう？\\nw[貧民街のボス]":398,"「王都の裏社会の支配者として、それを見過ごす\n　ことはできん」\\nw[貧民街のボス]":399,"「なんでそのことを？　誰から聞いた？」\\nw[\\N[1]]":400,"「愚問だな。貧民街は俺の庭だ。\n　どこにでも目や耳がある」\\nw[貧民街のボス]":401,"「会話には気をつかってたのに、全部筒抜けだった\n　なんて……」\\nw[\\N[2]]":402,"「で、あんたはあの腹黒姫を倒すのに協力してくれる\n　ってのか？」\\nw[\\N[1]]":403,"「サポートはしてやろう。\n　だが直接的な戦力としては期待するな。\\nw[貧民街のボス]":404,"「俺たち貧民街の住人は、兵士でも冒険者でもない\n　からな」\\nw[貧民街のボス]":405,"「それでも雲泥の差だ。\n　協力してくれるっていうなら、やってもらいたい\n　ことが――」\\nw[\\N[1]]":406,"「なんだ？　なにか始まるのか？」\\nw[\\N[1]]":407,"「悪竜の姫のありがたい演説さ」\\nw[貧民街のボス]":408,"「えっ！？　\\N[5]姫の！？」\\nw[\\N[2]]":409,"「愛する国民のみなさん。\n　本日は悲しむべきお知らせを伝えるため、集まって\n　いただきました。\\nw[\\N[5]]":410,"「すでに噂を聞いてご存知の方も多いでしょう。\n　そう、\\C[17]伝説の悪竜\\N[6]\\C[0]が甦ってしまったのです！」\\nw[\\N[5]]":411,"\\{「噂は本当だったのか！？」\\}\\nw[群衆]":412,"\\{「なんてことだぁー！！」\\}\\nw[群衆]":413,"「死んだと思われていた\\N[6]を密かに復活させて、\n　愚かにも玉座を奪うために利用しようとしたのは、\n　わたしの叔父であるパルフューク大公でした。\\nw[\\N[5]]":414,"「しかし大公は\\N[6]のコントロールに失敗して、\n　愚行の代償をみずからの命で払う結果となりました。\\nw[\\N[5]]":415,"「そしていま\\N[6]は野放しの状態となり、\n　５００年前のように我々を虐殺すべく、いずこかで\n　虎視眈々と機会を窺っています」\\nw[\\N[5]]":416,"\\{「終わりだ！\n　この世の終わりだぁー！！」\\}\\nw[群衆]":417,"「そしてもうひとつ、憂慮すべき事実が。\\nw[\\N[5]]":418,"「我が父、敬愛する国王陛下が、先日から重い病に\n　かかってしまいました。\\nw[\\N[5]]":419,"「残念ながら回復の見込みは薄く、この国難のときにあって\n　指揮をとることもままならない状態なのです」\\nw[\\N[5]]":420,"\\{「またかっ、あの王様は！」\\}\\nw[群衆]":421,"\\{「どんだけ役に立たないんだ！！」\\}\\nw[群衆]":422,"「陛下がお倒れになった今、王国の全てに対する責任は\n　長子であるわたしにあります。\\nw[\\N[5]]":423,"「よってわたしが軍を指揮して、悪竜\\N[6]との\n　戦いに挑みます！」\\nw[\\N[5]]":424,"\\{「そんなっ、\\N[5]様が！？」\\}\\nw[群衆]":425,"\\{「いや、優秀な姫様なら、あの国王が\n　指揮するよりも期待できる！」\\}\\nw[群衆]":426,"「国民のみなさん！\n　どうかわたしに力を貸してください！\\nw[\\N[5]]":427,"「ともに戦い、邪悪なる竜を再び葬りましょう！\\nw[\\N[5]]":428,"「必ずできるはずです！\n　なぜならこの身には、最初に\\N[6]を退治した\n　英雄王リジェルダの血が流れているのですから！」\\nw[\\N[5]]":429,"\\{「そうだ！　姫様は英雄の末裔なんだ！」\\}\\nw[群衆]":430,"\\{「\\N[5]姫のもとで戦えば、悪竜など\n　恐れる必要はない！」\\}\\nw[群衆]":431,"\\{「\\N[5]様アァッ！！」\\}\\nw[群衆]":432,"\\{「\\N[5]姫様、ばんざーいッ！！」\\}\\nw[群衆]":433,"「ありがとう！　ありがとう、みなさん！\\nw[\\N[5]]":434,"「ここにいるあなた方は、誇るべき真の王国民です！\\nw[\\N[5]]":435,"「しかしながら、まだ全ての王国民の心がひとつに\n　なったとは言えません。\\nw[\\N[5]]":436,"「反逆者パルフューク大公の治めていた副都には、\n　いまだ悪竜復活に加担した者たちが残っているのです。\\nw[\\N[5]]":437,"「にもかかわらず、副都へ命じた武装解除と反逆者たちの\n　出頭命令は実行されていません。\\nw[\\N[5]]":438,"「どうやら副都パルフュークは、このまま反逆を続ける\n　つもりのようなのです！\\nw[\\N[5]]":439,"「故に、\\N[6]と挟み討ちにされて窮地に陥る前に、\n　まずは反逆者たちの根城となっている\\C[17]副都を討伐\\C[0]します！」\\nw[\\N[5]]":440,"\\{「そうだ！　裏切者に鉄槌を！」\\}\\nw[群衆]":441,"\\{「パルフュークの反逆者に死を！！」\\}\\nw[群衆]":442,"「チッ、無茶苦茶言いやがる！\\nw[\\N[1]]":443,"「存在しない反逆者を、どうやって出頭させろって\n　いうんだ！」\\nw[\\N[1]]":444,"「いつまた\\N[6]やモンスターが襲ってくるか\n　分からないから、武装解除も出来ませんしね」\\nw[\\N[2]]":445,"「すべて計算の上で副都を悪者に仕立てあげ、\n　内戦を起こそうというのか」\\nw[貧民街のボス]":446,"「アホ王が死にかけてるのも、\\N[5]の仕業だろうな。\\nw[\\N[1]]":447,"「\\N[6]としての力が戻ったせいで、短命の呪いが\n　強まったか。それとも毒でも盛ったか」\\nw[\\N[1]]":448,"「なんにせよ国王が動けないのであれば、次期女王である\n　\\N[5]姫を止められる者などいないな」\\nw[貧民街のボス]":449,"「このまま人同士が戦って、疲れ切ったところに\n　\\N[6]が襲いかかってきたら……」\\nw[\\N[2]]":450,"「どうやら腹黒姫が副都を攻める前に、ケリをつけなきゃ\n　ならんようだ」\\nw[\\N[1]]":451,"ユマ（王宮前）":452,"モブ群衆1":453,"モブ群衆2":454,"モブ群衆3":455,"姫（テラス）":456,"王（テラス）":457,"近衛兵1":458,"近衛兵2":459,"近衛兵3":460,"近衛兵4":461,"ＢＧＭ変更":462,"夜間用ＢＧＭ演奏":463,"夜→昼":464,"最初から昼":465,"昼→夜":466,"最初から夜":467,"盗賊1":468,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":469,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":470,"「邪魔をするなら殺す！」\\nw[蛮族]":471,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":472,"奴隷化性別：0=女、1=男、2=男女ランダム":473,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":474,"戦闘マーク1":475,"近衛兵（酒場捜査）":476,"酒場脱出Ev":477,"「おいっ、待て！　お前！」\\nw[兵士]":478,"兵士1（変装Ev）":479,"「例の指名手配犯、もう王都にはいないんじゃないか？\n　探すだけムダだろ」\\nw[兵士Ａ]":480,"「オレもそう思うけど、隊長が草の根分けても探し出せって\n　言ってるんだ。\\nw[兵士Ｂ]":481,"「捜索を続けるしかないだろ」\\nw[兵士Ｂ]":482,"「おい、そこの冒険者！　ちょっと待て！」\\nw[兵士Ｂ]":483,"「お前らだ、お前ら！\n　ちょっと顔を見せろ」\\nw[兵士Ｂ]":484,"「なぜこっちを見ない？\n　兜を外せ！　帽子を脱げ！」\\nw[兵士Ａ]":485,"「怪しいやつらだ。\n　とりあえず捕えて尋問するぞ！」\\nw[兵士Ｂ]":486,"「おいっ、走れ！\n　目潰しが効いてるうちに逃げろ！」\\nw[？？？]":487,"兵士2（変装Ev）":488,"ユマ（帰還Ev時）":489,"投擲光1":490,"モブ群衆4":491,"貧民街ボス（王宮前）":492,"馬車（最終決戦潜入Ev）":493,"「よし、開いたぞ」\\nw[\\N[1]]":494,"「メイドさんが秘密の入り口を開けるとき、抜け目なく\n　スイッチの場所を見てたんですね」\\nw[\\N[2]]":495,"「俺の前で実演したのが運の尽きってな。\\nw[\\N[1]]":496,"「ここから王宮内に出られるはずだ。\n　行こう」\\nw[\\N[1]]":497,"ラストバトルEv":498,"C_STOP":499,"C_DISABLE_WEATHER":500,"※テスト用※\n戦闘をスキップします。":501,"「愛する国民のみなさん。\n　国家存亡のこの時に、残念なお知らせがあります。\\nw[\\N[5]]":502,"「王国の柱石たる我が父――国王陛下が、さきほどご逝去\n　あそばされました」\\nw[\\N[5]]":503,"\\{「なんだって！？　国王が死んだ？」\\}\\nw[群衆]":504,"\\{「こんなときにタイミングの悪い……」\\}\\nw[群衆]":505,"「陛下の死を嘆きたいところではありますが、\n　状況がそれを許してはくれません。\\nw[\\N[5]]":506,"「陛下の急激な衰弱の裏には毒の疑いがあり、\n　副都の反逆者たちがこれに絡んでいる可能性があります。\\nw[\\N[5]]":507,"「すぐにでもわたしが王位を継承し、しかる後に副都の\n　討伐と\\N[6]への対処を行わなければなりません！\\nw[\\N[5]]":508,"「王としての資質がわたしに足りているかどうか\n　不安ではありますが――」\\nw[\\N[5]]":509,"「どうかみなさん、わたしについてきてください！\n　力を貸してください！」\\nw[\\N[5]]":510,"\\{「姫様の方が前王より絶対資質あるって！」\\}\\nw[群衆]":511,"\\{「自信もってください！　姫様！\n　いや、女王陛下ぁー！！」\\}\\nw[群衆]":512,"\\{「女王陛下、ばんざーい！\n　\\N[5]陛下ぁーッ！！」\\}\\nw[群衆]":513,"「ありがとうございます！\n　みなさん、ほんとうにありがとう！」\\nw[\\N[5]]":514,"\\>\\{「大した小芝居だな、\\N[5]ッ！！」\\}\\nw[\\N[1]]":515,"「あっ、あなたたち！？」\\nw[\\N[5]]":516,"\\{「先手必勝！」\\}\\nw[\\N[1]]":517,"\\{「失礼御免！」\\}\\nw[\\N[2]]":518,"「どうだっ、この華麗なる不意打ち！」\\nw[\\N[1]]":519,"「自慢できることじゃないですけど、決まりましたね！」\\nw[\\N[2]]":520,"\\{「ひっ、姫様が襲われた！？」\\}\\nw[群衆]":521,"\\{「アサシンだッ！\n　アサシンが\\N[5]様を！！」\\}\\nw[群衆]":522,"\\{「チクショウ！　よくも！\n　アサシンを捕まえろ！　殺せぇッ！」\\}\\nw[群衆]":523,"「誰がアサシンだッ！！」\\nw[\\N[1]]":524,"「いや……わたしたち今、まさにアサシンそのもの\n　なんですけど。\\nw[\\N[2]]":525,"「これ、\\N[5]姫が\\N[6]だって証明できなかったら、\n　わたしたち死刑に――いえ、その前に問答無用で\n　集団リンチにかけられちゃうんじゃ……」\\nw[\\N[2]]":526,"「死刑？　リンチ？\n　なにをバカなことを……」\\nw[\\N[5]]":527,"「不意を突いたくらいで、わたしを倒せるとでも\n　思ったのですか？」\\nw[\\N[5]]":528,"「実は思ってたんだがなぁ……」\\nw[\\N[1]]":529,"「同じく思ってましたぁ……」\\nw[\\N[2]]":530,"「あなたたちに刑罰を適用させる気はありません。\\nw[\\N[5]]":531,"「いま、\\!この場で、\\!わたしが、\\!\\{殺す\\}」\\nw[\\N[5]]":532,"「おいおい、素が出てるぞ？\n　お姫様の演技はどうした？\\nw[\\N[1]]":533,"「だいだい、そんな風にケロッと起き上がっていいのか？\n　ほら、群衆も怪しんでるじゃないか」\\nw[\\N[1]]":534,"\\{「ひ、姫様、無事だったのか？」\\}\\nw[群衆]":535,"\\{「でも普通に斬られてなかったか？」\\}\\nw[群衆]":536,"「ここで戦うなら、人外であるお前の本性をさらす\n　ことになるぞ？　それでもいいのか？」\\nw[\\N[1]]":537,"「構わない」\\nw[\\N[5]]":538,"「え……？」\\nw[\\N[1]]":539,"「\\N[3]が言っていた通りだわ。\n　本当にしつこくて、しぶとい。\\nw[\\N[5]]":540,"「それにリジェルダの血を引いているとあっては、\n　絶対に見過ごせないわ」\\nw[\\N[5]]":541,"「お前、なんでそのことを！？」\\nw[\\N[1]]":542,"「改めまして、ごきげんよう。\n　お兄様\\I[29]\\nw[\\N[5]]":543,"「血のつながった兄であるなら、『竜の寝床』で\n　殺しきれなかったことにも合点がいきますわ。\\nw[\\N[5]]":544,"「鉤爪の力を少しは操れるのでしょう？\\nw[\\N[5]]":545,"「でも血の濃さはわたしも同じ。\n　理屈が分かったからには、もう不覚はとらないわ。\\nw[\\N[5]]":546,"「それにしても、お兄様は優しいのですね」\\nw[\\N[5]]":547,"「なんだと？」\\nw[\\N[1]]":548,"「さっきの攻撃、手加減していましたよね？\n　そうでなければ、もうちょっとダメージを受けていた\n　ところです。\\nw[\\N[5]]":549,"「もしかして、この期に及んで肉親を手にかけることに\n　ためらいを感じているのですか？」\\nw[\\N[5]]":550,"「…………。\\nw[\\N[1]]":551,"「\\N[5]……お前と、お前の中にある\\N[6]の魂は、\n　ひとつのものなのか？」\\nw[\\N[1]]":552,"「ああ、そういうことですか。\\nw[\\N[5]]":553,"「可哀そうな\\N[5]姫は、\\N[6]の魂に肉体を\n　乗っ取られているだけじゃないのか……と。\\nw[\\N[5]]":554,"「あっはははははっ！\n　そんなわけないでしょう？」\\nw[\\N[5]]":555,"「\\C[27]わたし\\C[0]は\\C[18]わたし\\C[0]よ！\n　産まれた時から\\C[27]\\N[5]\\C[0]で\\C[18]\\N[6]\\C[0]！」\\nw[\\N[5]＝\\N[6]]":556,"「わたしは人であり、古代竜！\n　二つではなく、不可分なひとつなのよ！」\\nw[\\N[5]＝\\N[6]]":557,"「そうかい、それを聞いて安心したぜ。\n　これで慈悲深い俺も、非情になれるってもんだ」\\nw[\\N[1]]":558,"「フフ……では殺し合いを始めましょうか？\\nw[\\N[5]＝\\N[6]]":559,"「お兄様を始末したら、そのまま王都を殲滅します。\n　それが終わったら、次に王国そのものを――。\\nw[\\N[5]＝\\N[6]]":560,"「芸の無いいたぶり方になってしまいますが、\n　どちらにせよ人間がたくさん死ぬことに違いは\n　ありませんから」\\nw[\\N[5]＝\\N[6]]":561,"「\\N[2]、やるぞ！！」\\nw[\\N[1]]":562,"「は……はいっ！」\\nw[\\N[2]]":563,"ラーナ＝アルテトとの戦闘\n↓　　↓　　↓":564,"↑　　↑　　↑\nラーナ＝アルテトとの戦闘":565,"「くっ……なぜ！？　体が思う通りに動かない！\n　この束縛感……干渉を受けてる？！\\nw[\\N[5]＝\\N[6]]":566,"「バカな！　この男の方が、わたしよりうまく竜の鉤爪を\n　扱えるというの！？」\\nw[\\N[5]＝\\N[6]]":567,"「いいぞ。\\N[6]のヤツ、力を正常に出せてない。\n　あと一息だ。このまま畳みかけて――」\\nw[\\N[1]]":568,"「ふ、ざ、け、る、なああぁあぁぁーッ！！\\nw[\\N[5]＝\\N[6]]":569,"「わたしはこの世界で最も優れた生物、古代竜なのよ！\n　生まれながらの統治者！　万物の王！\\nw[\\N[5]＝\\N[6]]":570,"「それが人間ごときに！　またしても遅れをとる！？\n　ありえないいいぃぃぃッ！！」\\nw[\\N[5]＝\\N[6]]":571,"weather : 1 : 3 : 80 : 50 : 1 : Rain_01B : 1 : 30":572,"weather : 2 : 1 : 30 : 100 : 1 : Light_01C : 1 : 30":573,"「きゃあああぁぁっ？！！」\\nw[\\N[2]]":574,"「くそっ、滅茶苦茶やりやがって！\n　王宮ごと燃やすつもりかよ！？\\nw[\\N[1]]":575,"「一旦退避するぞ、\\N[2]！」\\nw[\\N[1]]":576,"「はいぃ！」\\nw[\\N[2]]":577,"FocusCamera 50 24 120":578,"\\{「姫様のあの姿はなんだ！？」\\}\\nw[群衆]":579,"\\{「角！？　尻尾！？　それにあの赤い髪！」\\}\\nw[群衆]":580,"\\{「まるで竜……伝説の悪竜……！」\\}\\nw[群衆]":581,"「こんな屈辱、リジェルダに封じられたとき以来だわ！\\nw[\\N[5]＝\\N[6]]":582,"「\\N[1]……殺す！\\nw[\\N[5]＝\\N[6]]":583,"「殺す殺す殺す殺すッ！！\n　原型も分からないくらいグチャグチャのミンチにして、\n　燃やし尽くしてやるぅッ！！」\\nw[\\N[5]＝\\N[6]]":584,"「なんだそりゃ？\n　ハンバーグでも作るつもりか？」\\nw[\\N[1]]":585,"「俺はハンバーグより、竜の刺身を食いたい気分だけどな」\\nw[\\N[1]]":586,"「ならば竜の力、改めて思い知らせてあげるわ！\n　食えるものなら食ってみなさい！！」\\nw[\\N[5]＝\\N[6]]":587,"「わたしは食欲ないんで、ご遠慮したいんですけどぉ……」\\nw[\\N[2]]":588,"createFilter 1 twist 2 159":589,"setFilter 1 0 0 50 0":590,"moveFilter 1 0 0 200 10 150":591,"eraseFilter 1":592,"アルテト（ラスボス）との戦闘\n↓　　↓　　↓":593,"イージーのとき全回復":594,"↑　　↑　　↑\nアルテト（ラスボス）との戦闘":595,"「体が……うごかない……。\n　こんな……ウソだッ……わたしが負けるなんて……！」\\nw[\\N[5]＝\\N[6]]":596,"「\\N[6]、分かっているはずだ。\n　お前の力は弱まり、そのぶん竜の鉤爪に対する俺の\n　支配力は完璧になった。\\nw[\\N[1]]":597,"「お前はもう、俺に逆らうことすらできん。\\nw[\\N[1]]":598,"「５００年前のようにお前を封印することもできるし、\n　後腐れなく殺すことだってできる。\n　こんな風にな」\\nw[\\N[1]]":599,"「ひぎいいいぃいぃぃっ！？\\nw[\\N[5]＝\\N[6]]":600,"「ま、待って！\n　わたしはあなたの妹なのよ！？\\nw[\\N[5]＝\\N[6]]":601,"「血のつながった家族を殺すなんて、そんな酷いこと\n　しないわよね？」\\nw[\\N[5]＝\\N[6]]":602,"「うわぁ……。\n　命乞いの中でも、最悪なやつを選んできましたね。\n　いまさら家族アピールって……」\\nw[\\N[2]]":603,"「お、お願いよ！　助けて！\n　これからはお兄様のために尽くしますから！」\\nw[\\N[5]＝\\N[6]]":604,"「それは、俺のために何でもするってことか？」\\nw[\\N[1]]":605,"「は、はい！　なんでもやります！\n　足を舐めろと言うなら舐めますし、貢げというなら\n　金銀財宝を捧げます！」\\nw[\\N[5]＝\\N[6]]":606,"「これが『生まれながらの統治者』とか『万物の王』を\n　自称してた人間……いや、竜だなんて……。\n　軽蔑する気すら起きません」\\nw[\\N[2]]":607,"「う、動くな！　貴様ら！\n　いったいこれは、何事なのだ！？\\nw[騎士]":608,"「姫様が、竜に、\\N[6]に変身して――角や尻尾まで\n　生えて――。\\nw[騎士]":609,"\\{「どうなっとんのじゃああぁっ！！？」\\}\\nw[騎士]":610,"「混乱してるなぁ。\n　事情を知らなきゃ当然だが」\\nw[\\N[1]]":611,"「ど、どうします！？\n　事情を話して、納得してもらえるでしょうか？」\\nw[\\N[2]]":612,"「そうだなぁ……じゃあここはひとつ――」\\nw[\\N[1]]":613,"メインシナリオ\\C[17]『王都最終決戦』\\C[0]を達成した！":614,"\\N[2]の信頼度が\\C[17]「１０」\\C[0]上がった！":615,"clear_all_weathers":616,"エンディング分岐\n↓　　↓　　↓\n　\n　":617,"※離別エンド※\n　信頼度0以下、非淫乱状態":618,"※ノーマルエンド※\n　信頼度1以上150未満、非淫乱状態":619,"※トゥルーエンド※\n　信頼度150以上、非淫乱状態":620,"※淫乱エンド※\n　淫乱状態":621,"↓ED2のイベントを一部流用":622,"炎（王宮）1":623,"炎（王宮）2":624,"炎（王宮）3":625,"炎（王宮）4":626,"炎（王宮）5":627,"炎（王宮）6":628,"水柱1":629,"水柱2":630,"アルテト（ラスボス）":631,"particles_event_id : 58 : 0 : 15 : 1 : 0 : -5 : 0 : Line_01R":632,"兵士（包囲）1":633,"兵士（包囲）2":634,"兵士（包囲）3":635,"兵士（包囲）4":636,"兵士（包囲）5":637,"兵士（包囲）6":638,"騎士（包囲）":639,"INマーク":640,"兵士（追跡）3":641,"「貧民街へは無闇に行くな。\n　健全な市民には縁のない場所だぞ」\\nw[兵士]":642,"兵士（追跡）4":643,"「ここは兵舎だ。\n　王宮を守る近衛兵が生活している場所さ」\\nw[兵士]":644,"個別依頼05":645,"父の遺品":646,"「冒険者だった父が、もう半年以上も帰ってこないんです。\\nw[女性]":647,"「おそらく、すでに生きては……」\\nw[女性]":648,"「それは残念なことで……」\\nw[\\N[2]]":649,"「あなた方は冒険者としても活躍していると聞きました。\\nw[女性]":650,"「もしダンジョンで\\C[17]父の遺品\\C[0]など見つけたら、届けて\n　いただけないでしょうか？\\nw[女性]":651,"「大したお礼は差し上げられませんが、どうか」\\nw[女性]":652,"「親父さんが最後に向かった先は分かるか？」\\nw[\\N[1]]":653,"「たしか\\C[17]『地の洞窟』\\C[0]へ行くと言っていました」\\nw[女性]":654,"遺品を持っているとき":655,"「あ……あれ？\n　この前、地の洞窟で身元不明の冒険者の遺品を回収\n　しましたけど、もしかしてこれ……\\nw[\\N[2]]":656,"「あぁっ！　これは父が身に着けていた物です！\n　間違いありません！\\nw[女性]":657,"「ではやはり、父は……」\\nw[女性]":658,"「ああ、亡くなっていた。\n　遺体は俺たちの方で埋葬しておいたぞ」\\nw[\\N[1]]":659,"「ありがとうございます。\n　なんとお礼を言っていいか……。\\nw[女性]":660,"「価値のある物かどうかわかりませんが、お礼にこれを\n　受け取ってください」\\nw[女性]":661,"遺品を持っていないとき":662,"個別依頼『父の遺品』を受けますか？":663,"「わかりました。\n　もし見つけたときは、必ず持ち帰ってお渡しします」\\nw[\\N[2]]":664,"「ついでの話だから、あまり期待されても困るがな」\\nw[\\N[1]]":665,"「いえ、ありがとうございます！」\\nw[女性]":666,"個別依頼\\C[17]『父の遺品』\\C[0]を受けた！":667,"「お父様の遺品、おそらくこれで間違いのでは？」\\nw[\\N[2]]":668,"「そ、そうです！　ああ……やっぱり父は……」\\nw[女性]":669,"「残念ながら亡くなっていた。\n　遺体は俺たちの方で埋葬しておいたから」\\nw[\\N[1]]":670,"「もし地の洞窟で父の遺品を見つけたら、どうか\n　持ち帰ってきてください」\\nw[女性]":671,"個別依頼\\C[17]『父の遺品』\\C[0]を達成した！":672,"報酬として特殊アイテム\\C[17]『ポータル球』\\C[0]を入手した！\n\\N[2]の信頼度が\\C[17]「１０」\\C[0]上がった！":673,"個別依頼08":674,"正義の脅迫":675,"「この屋敷に住む悪徳商人にだまし取られた土地権利証を\n　取り戻したいんだ！\\nw[行商人]":676,"「あの\\N[3]っていう娘を脅すことで取り返せるという\n　なら、僕はためらわない！　協力してくれ！」\\nw[行商人]":677,"これまだ甦った\\N[6]が退治される前の話――。":678,"「あぁ……僕はなんてバカなんだ……！」\\nw[行商人]":679,"「んん？\n　お前、そんなところに隠れて何をやってるんだ？」\\nw[\\N[1]]":680,"「\\N[1]？\n　キミこそなんで王都に？」\\nw[行商人]":681,"「お知り合いの方ですか？」\\nw[\\N[2]]":682,"「ああ、顔見知りの行商人だ。\\nw[\\N[1]]":683,"「なにか困ってるようだが、どうした？」\\nw[\\N[1]]":684,"「じ、実は……貯めた金で故郷に土地を買ったんだけど、\n　その\\C[17]土地の権利証\\C[0]を悪徳商人にだまし取られてしまった\n　んだ……」\\nw[行商人]":685,"「そいつは災難だったな。\n　商業ギルドに助けは求めたのか？」\\nw[\\N[1]]":686,"「もちろんさ。……でもダメだった。\n　相手が武器商ギルドの幹部だとかで、簡単には手出し\n　できないって話なんだ」\\nw[行商人]":687,"「ひどい話ですね！\n　その悪徳商人って、どんなヤツなんですか？」\\nw[\\N[2]]":688,"「最近この屋敷に移り住んできて、王都で商売を始めた\n　新興商人なんだけど――。\\nw[行商人]":689,"「噂をすれば、ほら」\\nw[行商人]":690,"FocusCamera 70 52 100":691,"「あ～、やっぱり都会はいいわ！\n　商売も順調だし、王都に進出して正解だったわね」\\nw[\\N[3]]":692,"「まことに。\n　お父上も武器商ギルドの幹部となって、毎日お忙しい\n　ようですな」\\nw[\\N[4]]":693,"「役人への賄賂や裏金作りが大変みたいね。\n　忙しいのはうまくいってる証拠よ。\\nw[\\N[3]]":694,"「でもこんなものじゃ済まさないわ！\n　もっともっと成り上がるのよ！」\\nw[\\N[3]]":695,"「そのためには、あの方に協力して恩を売り、\n　我々を引き立ててもらわなければ――」\\nw[\\N[4]]":696,"「そうよ、遊んでる暇なんかない！\n　早く功績を立てないと！」\\nw[\\N[3]]":697,"ResetFocus 100":698,"「おいおい、悪徳商人ってのはメスガキのところの\n　商会かよ！」\\nw[\\N[1]]":699,"「うわぁ～！\n　\\N[3]ったら、こんなすごいお屋敷に住んでるんだ」\\nw[\\N[2]]":700,"「あいつらを知っているのか？」\\nw[行商人]":701,"「まあ、ちょっとした因縁があってな。\\nw[\\N[1]]":702,"「メスガキどもが相手だっていうなら、権利証を\n　取り戻す手伝いをしてやってもいいぞ」\\nw[\\N[1]]":703,"「ほ、本当か！？　頼む！\\nw[行商人]":704,"「でもどうやって権利証を取り返すんだ？\n　まさか盗み出そうっていうんじゃ……」\\nw[行商人]":705,"「権利証だけ盗んでも、土地は戻ってきませんよ？\n　ちゃんと法的な手続きを踏まないと」\\nw[\\N[2]]":706,"「そんなことは分かってる。\n　盗むんじゃなくて、脅すんだ」\\nw[\\N[1]]":707,"「お、脅すって……？」\\nw[行商人]":708,"「この屋敷に潜入して、メスガキの恥ずかしい秘密を\n　探り当てるんだよ。\\nw[\\N[1]]":709,"「あいつの性格からして、人に言えないような秘密の\n　ひとつふたつ、絶対に抱えてるはず。\\nw[\\N[1]]":710,"「暴いたそいつを交渉材料にして、権利証を取り戻す\n　って寸法だ」\\nw[\\N[1]]":711,"「盗みと大差ない……むしろ余計に悪辣な手段じゃ\n　ないですかぁ」\\nw[\\N[2]]":712,"「だ、だけどそれで僕の権利証が戻ってくるなら……協力\n　してくれ！　頼む！\\nw[行商人]":713,"「もしうまくいったら、この\\C[17]価値がありそうな玉\\C[0]をキミに\n　譲るから」\\nw[行商人]":714,"個別依頼『正義の脅迫』を受けますか？":715,"個別依頼\\C[17]『正義の脅迫』\\C[0]を受けた！":716,"「それで、\\N[3]の屋敷にはどうやって忍び込むつもり\n　なんですか？」\\nw[\\N[2]]":717,"「それはこれから考える」\\nw[\\N[1]]":718,"「つまり考えなしで引き受けたんですね」\\nw[\\N[2]]":719,"「屋敷に忍び込むだけなら、方法はあるよ。\\nw[行商人]":720,"「\\C[17]昼間\\C[0]は換気のために、\\C[17]屋敷西側の窓\\C[0]が開きっぱなし\n　になってるんだ。\\nw[行商人]":721,"「そこから中に入るのは簡単だろうね」\\nw[行商人]":722,"「本当なのか？」\\nw[\\N[1]]":723,"「伊達に未練たらしく、この屋敷の回りをうろついちゃ\n　いないさ。確かな観察の結果だよ！」\\nw[行商人]":724,"（なんでちょっと自慢気なんだろ……）\\nw[\\N[2]]":725,"「よぉし、なら窓から屋敷に侵入といくか！」\\nw[\\N[1]]":726,"FocusCamera 66 53 60":727,"\\C[17]西側の窓\\C[0]からエルラの屋敷に潜入しよう！":728,"\\C[17]昼間\\C[0]のうちに\\C[17]西側の窓\\C[0]からエルラの屋敷に潜入しよう！":729,"ResetFocus 30":730,"\\C[17]『\\in[71]』\\C[0]を依頼者に渡して報告しますか？":731,"「とっておきの脅迫材料を奪ってきたぜ。\n　これと交換なら土地の権利証も取り戻せるだろ」\\nw[\\N[1]]":732,"「これは……！？\n　まさかあのクソ生意気な女の子が、こんなドスケベな\n　日記をつけてるなんてッ！」\\nw[行商人]":733,"（なんか凄く興奮してる……）\\nw[\\N[2]]":734,"「こいつはいいズリネタ……じゃなくて強請りネタに\n　なる！\\nw[行商人]":735,"「ありがとう！　心から感謝するよ！」\\nw[行商人]":736,"個別依頼\\C[17]『正義の脅迫』\\C[0]を達成した！":737,"\n依頼達成の数日後……":738,"「身のこなしに自信がないから、僕はここで見張りを\n　しているよ。\\nw[行商人]":739,"「屋敷へは、昼間のあいだ\\C[17]西側の窓\\C[0]から入れるはずだ。\n　どうかよろしく頼む」\\nw[行商人]":740,"依頼マーク":741,"エルラ邸ドア":742,"鍵がかかっている。":743,"エルラ（屋敷）":744,"バルコルド（屋敷）":745,"隠れ用木箱":746,"エルラ邸窓1":747,"窓には鍵がかかっている。\n昼間のあいだは換気のために開いているそうだが……。":748,"エルラ邸":749,"エルラ邸窓2":750,"エルラ邸窓IN":751,"奴隷市":752,"奴隷市（フキダシ）":753,"奴隷市（通行不可）":754,"女性市民（広場）":755,"「本当にアルテトが甦ったのなら、これから王国はどう\n　なるのかしら？　王様は頼りにならないし……」\\nw[女性]":756,"「貧民街の方で、また刃傷沙汰が起きたんですって。\n　怖いわね」\\nw[女性]":757,"男性市民（広場）":758,"「国民一丸となって悪竜アルテトに対処するには、\n　王を退位させて、\\N[5]姫を女王にするべきだと\n　思うんだけど」\\nw[男性]":759,"「貧民街の治安を良くしようなんて、上の連中は\n　真面目に考えてないんだろうね」\\nw[男性]":760,"娼館前の男":761,"「悪竜が来るなら、その前に童貞を捨ててやろうって\n　思ってたけど……結局、踏ん切りがつかなかったよ……」\\nw[挙動不審な男]":762,"「悪竜のせいで国が滅びるなら、その前に童貞を\n　捨ててやる！\n　よしっ、やるぞ！　やるぞぉ！」\\nw[挙動不審な男]":763,"「大人の階段を上りたいけど……あと一歩踏み出す\n　勇気が出ない……」\\nw[挙動不審な男]":764,"駅馬車マーク":765,"女の子（道端）2":766,"「みんな、アルテトのおはなしばっかりしてる。\n　アルテトってすごいの？」\\nw[女の子]":767,"「お花をつんでるの。\n　これ油であげて食べられるんだよ」\\nw[女の子]":768,"男の子（道端）1":769,"「悪い竜なんて、オレがやっつけてやる！」\\nw[男の子]":770,"「向こう岸はあぶないから、行っちゃダメなんだって」\\nw[男の子]":771,"男の子（道端）2":772,"「アルテトって竜？　強いの？　恐いの？」\\nw[男の子]":773,"「このあいだ、噴水でおよいだらスッゴイ怒られたんだ」\\nw[男の子]":774,"男性市民（広場）2":775,"「悪竜復活か。\n　世の中なにがあるか分からんね」\\nw[男性]":776,"「ううむ……私の出した依頼、なかなか受けてもらえんな」\\nw[男性]":777,"男の子（道端）3":778,"「剣闘士がみんなでかかれば、アルテトなんて倒せるよ」\\nw[男の子]":779,"「オレ、大きくなったら剣闘士になるんだ！\n　そんでモテモテになる！」\\nw[男の子]":780,"男性市民（王宮前）":781,"「アルテトが甦ったと噂が流れたとき、デマだと言う\n　ヤツもいたけど、オレは本当のことだと見抜いていたね」\\nw[男性]":782,"「アルテトが甦ったなんて、絶対にデマだ！\n　そうに違いない！」\\nw[男性]":783,"「\\N[5]姫が次の国王になれば、もうちょっとマシな\n　政治が行われるだろうか？」\\nw[男性]":784,"男性市民（王宮前）2":785,"「ほぇ～！　これが王宮かぁ。\n　ここで甦った悪竜が退治されたんだべ？」\\nw[農夫]":786,"「アルテトって、昔話で聞いたことあるべ。\n　死んだんじゃなかったのけ？」\\nw[農夫]":787,"「ほぇ～！　これが王宮かぁ。\n　でっけぇなぁ～」\\nw[農夫]":788,"女性市民（王宮前）1":789,"「しっ！　見ちゃいけません！」\\nw[女性]":790,"「悪い竜なんて来ないから、怖がらなくていいのよ」\\nw[女性]":791,"「ほら、あそこにお姫様が住んでるのよ」\\nw[女性]":792,"女の子（道端）3":793,"「ねぇ、あのおじちゃん何してるのぉ？」\\nw[女の子]":794,"「りゅうが来るって、みんないってるよ！\n　こわい！」\\nw[女の子]":795,"「ねぇねぇ、おひめさま、どこー？\n　見えないよ？」\\nw[女の子]":796,"馬1":797,"騎士（厩舎）":798,"「どうだ、どの馬もいい毛並みだろう。\n　こいつらに乗って悪竜と戦いたかったなぁ」\\nw[騎士]":799,"「たとえ敵が悪竜だろうと、我々は陛下の御為に\n　戦うのみ！」\\nw[騎士]":800,"「どうだ、どの馬もいい毛並みだろう。\n　我々騎士の優秀な相棒さ」\\nw[騎士]":801,"釣り人":802,"「たとえ悪竜が来るとも、俺はここで釣り続ける！」\\nw[釣り人]":803,"「釣れるのかって？\n　それは問題じゃないのさ」\\nw[釣り人]":804,"騎士（西城壁）":805,"「籠城の準備はしていたが、いきなり王宮に\\N[6]が\n　現れるとは。完全に想定外だった」\\nw[騎士]":806,"「空を飛ぶ竜が相手では、籠城も無意味か……」\\nw[騎士]":807,"「ここにあるのは籠城訓練用の資材だ。\n　勝手に触るなよ」\\nw[騎士]":808,"商人（武器商ギルド）":809,"「ここは武器商ギルドの王都本部よ。\n　最近色々あってちょっと落ち目だけど……でもいつか\n　必ず復活するわ！」\\nw[女商人]":810,"「ここは武器商ギルドの王都本部よ。\n　あの商業ギルドにも引けを取らない大きさでしょ？」\\nw[女商人]":811,"「ここは武器商ギルドの王都本部よ。\n　いまちょっと改装中で閉まってるけど、近いうちにまた\n　出入りできるようになるわ」\\nw[女商人]":812,"商人（ギルド前）":813,"「大公の裏切りにアルテトの復活か……。\n　こりゃあ商売どころじゃないかもな」\\nw[商人]":814,"「王都の市民はあんまり値切らないけど、品質には\n　うるさいんだよね」\\nw[商人]":815,"男性（貧民街）1":816,"「けひひっ！\n　王都なんざ、悪竜にブッ潰されちまえ！」\\nw[薄汚い男]":817,"「なに見てんだよ？\n　オレに文句でもあんのか？　あぁっ！？」\\nw[薄汚い男]":818,"王国官吏（依頼30）":819,"女性（貧民街）2":820,"「ほんとに悪竜が来るっていうなら、そのどさくさに\n　火事場泥棒してやるわ」\\nw[狡そうな女]":821,"「あんた、なかなかいいガタイしてるわね？\n　あたしと組んで美人局やらない？\n　川向うのお上品な連中から金を巻き上げるのよ」\\nw[狡そうな女]":822,"女性（貧民街）3":823,"「悪竜のことなんか知らないわよ。\n　こっちは今日を生きるだけで精一杯なのに！」\\nw[街娼]":824,"「ねぇ、あたしのこと買ってよぉ。\n　病気は持ってないから、本当よ」\\nw[街娼]":825,"矢印":826,"奴隷1":827,"「街路の清掃も奴隷の仕事なんだ。\n　王都が美しいのは、俺たちのおかげってわけさ！」\\nw[奴隷]":828,"街ズームアウト":829,"P_D_FILENAME name_town\\V[101]":830,"「わぁ！　王都だぁ！\n　こんな都会に来るの、わたし初めてですよ！」\\nw[\\N[2]]":831,"「はしゃいでるとこ悪いが、お前が想像するほどいい\n　場所じゃないぞ。\\nw[\\N[1]]":832,"「なんせ国民からの支持が圧倒的に低いアホ王が\n　治めてる街だからな。\n　おまけに武器商ギルドの本部もあるし。」\\nw[\\N[1]]":833,"「もうっ！　またそうやって水を差すんだから！\\nw[\\N[2]]":834,"「いいじゃないですか、わたし以前から一度は王宮を\n　見てみたいって思ってたんですよ！」\\nw[\\N[2]]":835,"「どうせ観光するなら闘技場の方がいいぞ。\n　一儲けできるかもしれないしな」\\nw[\\N[1]]":836,"「ギャンブルなんて、わたしやりませんからね！」\\nw[\\N[2]]":837,"闘技場昇降口":838,"「ここで仕事をサボってること、ご主人様には\n　言わないでよ？」\\nw[女奴隷]":839,"民家":840,"あばら家":841,"自宅入り口":842,"自宅":843,"EV258":844,"売り家表示":845,"EV260":846,"物乞い（貧民街）1":847,"\\C[17]※ 注意 ※\\C[0]\nこれ以上、物乞いにお金をあげてもイベントは発生しません。":848,"「旦那ぁ、哀れと思ってお恵みくだせぇ」\\nw[物乞い]":849,"100Ｇ渡す":850,"500Ｇ渡す":851,"1000Ｇ渡す":852,"5000Ｇ渡す":853,"無視する":854,"「ありがとうございやしたぁ！」\\nw[物乞い]":855,"物乞い（貧民街）2":856,"「おねがいします。\n　ほんの少しでいいからお助けください」\\nw[物乞い]":857,"「あぁ……ありがとうございます！」\\nw[物乞い]":858,"藁山":859,"フクロウ":860,"マップ取得":861,"FocusCamera 50 25 120":862,"ZoomOut 3 120":863,"\\C[17]\\V[901]の地図\\C[0]を取得した！":864,"ResetZoom 60":865,"ResetFocus 60":866,"街中イーグルダイブ":867,"ここから飛び降りますか？":868,"飛び降りる":869,"やめる":870,"EV266":871,"御者":872,"EV292":873,"依頼01・02戦闘":874,"依頼を引き受けている場合、暴漢と戦闘":875,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":876,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":877,"暴漢と戦闘":878,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":879,"襲ってきた暴漢を撃退し、街の警備兵に引き渡した。":880,"暴漢":881,"EV296":882,"街路汚れ":883,"EV298":884,"レイプ魔":885,"レイプ被害者":886,"レイプマーク":887,"レイプEv向き合わせ":888,"レイプEv発生制御":889,"レイプ現場遭遇":890,"街中盗賊出没":891,"盗賊2":892,"戦闘マーク2":893,"噴水障害":894,"通行不可":895,"掲示板依頼初期化おばあちゃん":896,"<TE:110>":897,"「ちょっ！　人の立ちションベン見るなよ！」\\nw[酔っている男]":898,"宝箱":899,"※\nアイテム：脱出ロープ\n※":900,"職人":901,"「街が悪竜に壊されなくてよかったよ。\n　いくら仕事が増えるとはいえ、破壊された街の再建なんて\n　やりたくないからな」\\nw[職人]":902,"「こうして路面を補修しても、悪竜が来たら街全体が\n　もっと酷い有様になっちまうんだろうな……」\\nw[職人]":903,"「路面の補修をしてるんだよ。\n　昼間は人でごった返してるから、夜間作業になっちまう\n　のさ」\\nw[職人]":904,"「昼間に\\C[17]この王宮前広場\\C[0]へ来るといい。\n　\\C[17]\\N[5]姫様\\C[0]が王都の民に向けてお話をされるそうだ」\\nw[職人]":905,"「こんな夜中に大変だな」\\nw[\\N[1]]":906,"「あんたら観光客か？\n　だったら昼間に\\C[17]この王宮前広場\\C[0]へ来るといい。\\nw[職人]":907,"「近々、\\C[17]\\N[5]姫様\\C[0]が王都の民に向けてお話をされる\n　そうだ。\n　あの美しいご尊顔を拝見できる好機だぞ」\\nw[職人]":908,"「そうそう、オレも今から楽しみでね」\\nw[職人]":909,"「\\N[1]さん！\n　わたしたちも\\N[5]姫のお顔、見たいです！」\\nw[\\N[2]]":910,"「わかった、わかった。\n　時間があったら見に来るってことでいいか？」\\nw[\\N[1]]":911,"「昼間は」\\nw[大工]":912,"職人会話マーク":913,"淫行男1":914,"口の悪い男":915,"「王も貴族もクソ以下だ！\n　一人残らずブチ殺してぇぜ！」\\nw[\\v[1655]]":916,"「王はクソだが\\N[5]姫は……ブチ犯してぇ！\n　だが、お前の連れてるその奴隷も悪くねぇな」\\nw[\\v[1655]]":917,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":918,"売春させる":919,"やめておく":920,"淫行表示":921,"街中淫行制御":922,"淫行男2":923,"威圧感のある男":924,"「なんだテメェ、アサシンみてぇな格好しやがって。\n　おちょくってんのか？」\\nw[\\v[1655]]":925,"「その女、好きモノって顔してるな。\n　命令すりゃ、どの穴でも喜んで使わせるんだろ？」\\nw[\\v[1655]]":926,"淫行男3":927,"虚勢を張る男":928,"「オレは裏の世界じゃ、ちったぁ名の通ったワルなんだぜ。\n　いやマジで」\\nw[\\v[1655]]":929,"エンディング1途中Ev":930,"王都の方では先日、パルフューク大公の娘であるチェリア\n姫様が新国王としてご即位されたそうです。\\nw[\\N[2]]":931,"本人は無理だと固辞したのに、他に良い王候補がいなかった\nので、なし崩しに決まってしまったのだとか。\\nw[\\N[2]]":932,"チェリア女王陛下の最初の仕事は\\C[17]『悪竜によって密かに\n殺されて入れ替わられていた\\N[5]姫の国葬』\\C[0]だそうです。\\nw[\\N[2]]":933,"\\N[5]姫が悪竜\\N[6]の魂を宿していたという、王国を\n揺るがしかねない真実は闇に葬られました。\\nw[\\N[2]]":934,"すべては変身能力を使って王国を翻弄しようとしていた\n悪竜の仕業であった――ということになったのです。\\nw[\\N[2]]":935,"甦った悪竜を退治したのは謎の冒険者だったとして、\nわたしたちの存在も無かったことにされてしまいました。\\nw[\\N[2]]":936,"でも、そうするよう望んだのは他ならぬ\\N[1]さん\nでした。\\nw[\\N[2]]":937,"彼は悪竜退治の功績を主張することもせず、弱った\\N[5]姫\nを連れていずこかに姿を消してしまったのです。\\nw[\\N[2]]":938,"誰もいない場所で\\N[5]姫の息の根を止めるつもりなのか、\nそれとも悪竜の力を完全に封印する方法を探すつもり\nなのか――。\\nw[\\N[2]]":939,"\\N[1]さんがどうするつもりでいたにせよ、結局\nわたしは彼について行きませんでした。\\nw[\\N[2]]":940,"もうわたしは、\\N[1]さんの所有する奴隷では\nなかったから――。\\nw[\\N[2]]":941,"主人公（エンディング1）":942,"ラーナ（エンディング1）":943,"エンディング後再開処理":944,"C_START":945,"C_ENABLE_WEATHER":946,"\\>※　本作を遊んでいただきありがとうございました。　※\n\\>※　ここから未クリアの依頼やダンジョンを引き続き　※\n\\>※　攻略することができます。　　　　　　　　　　　※":947,"\\>\\N[1]が戦技\\C[17]『\\sn[103]』\\C[0]を覚えた！":948,"\\>自宅にある\\C[17]赤い本\\C[0]から、\\C[17]アルテトとの決戦\\C[0]をやり直せる\n\\>ようになった！\n\\>（※別エンディングを見るためにご活用ください）":949,"主人公（エンディング）":950,"ユマ（エンディング）":951,"\\C[17]武器商ギルド\\C[0]の入り口は閉まっている。\n（メインシナリオを進めると入れるようになります）":952,"不動産業者":953,"「この屋敷を買った商家、数々の違法行為がバレて潰れ\n　ちゃったそうだね。\n　今じゃ空き家らしいよ」\\nw[不動産業者]":954,"大臣（エンディング2途中Ev）":955,"そして悪竜アルテトについては、次のような発表が\n国民に対して為された――。":956,"「諸君！　このような悲しい調査結果を伝えなければ\n　ならないことを、我々は残念に思う！」\\nw[大臣]":957,"\\{「\\N[5]様になにがあったんだ！？」\\}\\nw[群衆]":958,"\\{「姫様はご無事なのか！？」\\}\\nw[群衆]":959,"「結論から言うと、\\N[5]殿下はすでにご逝去あそばして\n　いた。\\C[17]悪竜\\N[6]によって食い殺されていた\\C[0]のだ」\\nw[大臣]":960,"\\{「なっ、なんだってぇーッ？！」\\}\\nw[群衆]":961,"「どうやら悪竜には、食べた人間に化ける能力があった\n　ようで、こともあろうに\\N[6]は\\N[5]殿下に成り\n　すましていたのだ！」\\nw[大臣]":962,"「しかし殿下のフリをして国政を操ろうとした悪竜の\n　奸計は、謎の冒険者によって阻止された！\\nw[大臣]":963,"「我々は褒賞するために、この冒険者の行方を捜している！\n　もし諸君らに心当たりがあれば、ぜひ情報の提供を\n　お願いしたい！」\\nw[大臣]":964,"\\{「そんなっ、\\N[5]様ぁーッ！！」\\}\\nw[群衆]":965,"\\{「\\N[5]姫の仇を討った冒険者……\n　悪竜退治の英雄はいったい誰なんだ！？」\\}\\nw[群衆]":966,"「陛下……これで本当によろしかったのでしょうか？」\\nw[大臣]":967,"「言いたいことは分かりますが、従兄殿がそのように\n　望んだのです。\\nw[チェリア姫]":968,"「悪竜を倒した英雄、そして前王陛下の遺児として\n　王位に就く道もあったのに、あの方は自らそれを\n　放棄しました。\\nw[チェリア姫]":969,"「権勢を欲する人であれば、この機会を捨てて姿を消す\n　はずがないでしょう？」\\nw[チェリア姫]":970,"「ですが彼を野放しにしておくのは危険です。\n　血筋だけでも厄介であるのに――」\\nw[大臣]":971,"「わたくしは信じたいと思います。\\nw[チェリア姫]":972,"「あの方ならきっと、我らが祖たる建国王がそう望んだ\n　ように\\N[6]を護国の竜に変えてくれると……」\\nw[チェリア姫]":973,"チェリア姫（ED2）":974,"騎士（ED2）":975,"バルコルド拘束":976,"「やあやあ、これは執事殿じゃあーりませんか！\n　ずいぶんと面白い格好をしておられる！」\\nw[\\N[1]]":977,"「きっ、貴様ぁっ！！　アサシンめぇ！\n　よくもおおぉぉっ！！」\\nw[\\N[4]]":978,"「\\N[1]さん、相手が動けないからってそんな風に\n　からかうのは……」\\nw[\\N[2]]":979,"「お前たちさえ邪魔をしなければ、お嬢様はこの国最高の\n　商人にだってなれたはずなのだ！！」\\nw[\\N[4]]":980,"「まだそんなこと言ってんのか？\n　成功しようが失敗しようが、お前らは破滅するしか\n　なかったっていうのに」\\nw[\\N[1]]":981,"「断じて違う！　我々には栄光が待っていたはずなのだ！」\\nw[\\N[4]]":982,"「それは、たくさんの他人を犠牲にしての栄光ですよね？\\nw[\\N[2]]":983,"「だったら……あなたたちを阻止できたことを、わたしは\n　後悔しません」\\nw[\\N[2]]":984,"「くっ……善人面しおって！！\n　絶対にこのままでは済まさん！　いつか必ずお前らを\n　この手で……！」\\nw[\\N[4]]":985,"「いいぜ、やれるものならやってみろ。\n　まあ何十年とある刑期を終えてからの話だろうがな」\\nw[\\N[1]]":986,"「くそぉっ！　あと一歩のところだったのにっ！！\n　おのれアサシンめぇっ！！」\\nw[\\N[4]]":987,"拘束案内板":988,"この者、悪竜に加担した罪にてここに晒すもの也。\n（どうぞご自由にお使いください）":989,"「どうぞご自由にって……なにをどう使えと……」\\nw[\\N[2]]":990,"「さ、さあな……？\n　世の中広いから、需要はあるのかもしれんが……」\\nw[\\N[1]]":991,"バルコルド怒りマーク":992,"四聖教メッセンジャー":993,"<TE:112>":994,"EV343":995,"EV344":996,"会話マーク(EX)":997,"<TE:113>":998},"extension":"json","dataType":"map","filename":"Map053","basename":"Map053.json","path":"data/Map053.json","relPath":"data/Map053.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":999,"percent":0.20020020020020018},"cellInfo":[]},"data/Map054.json":{"data":[["EV001",""],["EV002",""],["商業ギルド",""],["ドアは堅く閉ざされている。",""],["EV003",""],["武器防具店",""],["EV004",""],["宿屋",""],["EV005",""],["アクセサリ店",""],["EV006",""],["卸売商会",""],["EV007",""],["聖堂",""],["EV008",""],["魔法具店",""],["EV009",""],["馬車屋","Stagecoach shop"],["EV010",""],["娼館",""],["EV011",""],["PSS stop",""],["PSS reset C",""],["↓敵の追跡を停止",""],["SmartPath 188 cancel",""],["SmartPath 189 cancel",""],["SmartPath 190 cancel",""],["SmartPath 191 cancel",""],["SmartPath 192 cancel",""],["clear_all_weathers",""],["EV012",""],["EV013",""],["EV014",""],["EV015",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["EV022",""],["女性",""],["「悪竜が滅びたのは神様のおかげに違いないわ！」\\nw[信心深い女]",""],["「神様に祈ったおかげで、モンスターの襲撃からも生き延び\n　られたわ♪」\\nw[信心深い女]",""],["「辛いことがあったときは、いつもここに来て神様に\n　お祈りするの」\\nw[信心深い女]",""],["炎",""],["男性",""],["「昔、ここが王国の首都だった時期もあったんだよ。\n　チェリア様が女王になったんだから、またここを首都に\n　すればいいのに」\\nw[地元の男]",""],["「このパルフュークがモンスターに襲われるなんて！\n　それにあの赤い竜を見たかい？\n　恐ろしいなんてもんじゃなかったよ！」\\nw[地元の男]",""],["「ここが王国の首都だった時期もあったんだよ。\n　昔の話だけどね」\\nw[地元の男]",""],["「悪竜が死んでも油断はならん。\n　この街の被害のほとんどは、その他のモンスターによる\n　ものだからな」\\nw[元冒険者]",""],["「モンスターの襲撃で久々に剣を取ったが、儂もまだ\n　衰えておらんかったよ」\\nw[元冒険者]",""],["「儂が若い頃は、この辺りにも時々オークが出没して\n　おったよ。最近はとんと見んようになったが」\\nw[元冒険者]",""],["「我が手に合う魔剣さえあれば、街を襲ったモンスター\n　など一捻りだったのだが……」\\nw[冒険者]",""],["「ここの武器屋では、我が手に合う魔剣は置いて\n　いなかった……」\\nw[冒険者]",""],["王国官吏（依頼30）",""],["依頼を出している場合",""],["依頼フキダシ",""],["執事（依頼21）",""],["工事監督官（依頼31）",""],["おっぱいマニア（依頼18）",""],["兵士（擾乱）",""],["「これ以上、火の手を広げるな！」\\nw[兵士]",""],["「俺の火消し魂を見せてやる！」\\nw[兵士]",""],["水桶（擾乱）",""],["モンスター（擾乱）",""],["死体",""],["すでにこと切れている。",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["通行遮断",""],["馬車",""],["食料品店",""],["研究者（依頼32)",""],["浮気調査（依頼13・14・15）",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 14 65",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ターゲット表示",""],["浮気相手(依頼11)",""],["障害物",""],["建国王像",""],["『建国王リジェルダの像』と台座に彫ってある。",""],["個別依頼13",""],["実験素体の調達",""],["「私は魔術師として、この身を知識の探求に捧げている。\n　思索と研究こそ、我が本懐なのだ」\\nw[魔術師]",""],["「そいつぁ、勉強熱心なことだな」\\nw[\\N[1]]",""],["「そして研究には様々なものが必要となる。\n　薬品、鉱物、書物……それに実験用の奴隷」\\nw[魔術師]",""],["「実験……どんなエッチな目に遭わされちゃうんだろ？\n　想像しただけで……はぁ～\\I[29]」\\nw[\\N[2]]",""],["「うわぁ……人体実験とか……」\\nw[\\N[2]]",""],["「奴隷商人よ。\n　今度の魔術実験には\\C[17]女の悪魔\\C[0]が素体として必要なのだ。\\nw[魔術師]",""],["「早急に用立てて欲しい。\n　報酬として、私が合成した\\C[17]筋肉増強剤\\C[0]と\\C[17]魔力増強剤\\C[0]を\n　渡そう」\\nw[魔術師]",""],["「女の悪魔奴隷なら、どんなのでもいいのか？」\\nw[\\N[1]]",""],["「\\C[17]平均的な体格\\C[0]が望ましい」\\nw[魔術師]",""],["「なら、巨乳や貧乳は避けた方がいいな」\\nw[\\N[1]]",""],["個別依頼『魔術実験』を受けますか？",""],["受ける",""],["受けない",""],["古代遺跡・転送部屋",""],["悪魔の館",""],["個別依頼\\C[17]『魔術実験』\\C[0]を受けた！",""],["\\C[17]『\\in[122]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「ご注文の悪魔奴隷を連れてきたぞ。どうだ？」\\nw[\\N[1]]",""],["「うむ、問題なさそうだ。\n　実験素体としては十分だな。\\nw[魔術師]",""],["「世話になったな、奴隷商人」\\nw[魔術師]",""],["個別依頼\\C[17]『魔術実験』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「女悪魔がこないと実験を始められん。\n　はやく調達してきてくれ」\\nw[魔術師]",""],["依頼マーク",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["戦闘マーク1",""],["副都擾乱BGM演奏",""],["weather : 1 : 3 : 80 : 50 : 1 : Rain_01B : 1 : 30",""],["weather : 2 : 1 : 30 : 100 : 1 : Light_01C : 1 : 30",""],["アヒル",""],["池の岩",""],["男性市民1（広場）",""],["「チェリア姫が女王になって王都へ行っちゃうとは。\n　戻ってきてほしいなぁ」\\nw[メガネの男]",""],["「チェリア姫をはげましてあげたいけど、ただの庶民に\n　できることなんて無いもんなぁ……」\\nw[メガネの男]",""],["「\\N[5]姫も可愛いけど、やっぱりチェリア姫だろ」\\nw[メガネの男]",""],["男性市民2（広場）",""],["「\\N[5]姫が死んだなんて信じないぞ！\n　きっとどこかで生きてる……と思いたい！」\\nw[猫人の男]",""],["「父親を亡くされて、チェリア姫もさぞ悲しんでる\n　だろうな……」\\nw[猫人の男]",""],["「いやいや、やっぱり\\N[5]姫だろ。\n　チェリア姫も可愛いとは思うけどさ」\\nw[猫人の男]",""],["女性市民1（広場）",""],["「モンスターが暴れたせいで、ウチの外壁はボロボロよ！\n　相手が人間じゃないから賠償請求もできやしないのに！」\\nw[主婦]",""],["「献立を考えるの面倒だから、今日もシチューでいいかしら。\n　もう７日間連続でシチューだけど」\\nw[主婦]",""],["血糊",""],["女性市民3",""],["「チェリア様が女王だなんて、地元の人間として\n　誇らしいわ」\\nw[女性]",""],["「竜とモンスターのせいで、たくさんの人が犠牲に\n　なってしまったわ」\\nw[女性]",""],["「王家の血筋って美人が多いのかしら？\n　パルフューク宮のチェリア様も美しい方なのよ」\\nw[女性]",""],["市民（擾乱）",""],["「ありがとうございます！\n　おかげで命拾いしました！\\nw[メイド]",""],["「なにかお礼を――ああ、でも今は何も持ってなくて、\n　すみません。\\nw[メイド]",""],["「もしまたお会いすることがあれば、必ずお礼をさせて\n　いただきます。それでは」\\nw[メイド]",""],["「なにかお礼を――ああ、でも今は何も持ってなくて……」\\nw[メイド]",""],["「そうだわ！\n　もしよろしければ、こ