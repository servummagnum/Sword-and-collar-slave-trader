t":"scriptCommand/16944098119928264.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,[{"headerIndex":0,"headerParam":["",0,0,2],"contextStr":"Map340/events/18/pages/0/list/0/message/noPicture/bottom","translation":""}],[{"contextStr":"Map340/events/18/pages/0/list/2/Show Choices/2/1from2","translation":""}]],"indexIds":{"燭台":0,"光":1,"回復魔法陣":2,"EV008":3,"EV009":4,"EV010":5,"EV011":6,"\\C[18]※　注意　※\\C[0]\nこの先へ進むと、最後の戦いとなります。":7,"進む":8,"まだ進まない":9,"EV012":10,"EV013":11,"敵索敵スタート":12,"２階":13,"EV018":14,"アルテトとの戦闘をスキップしますか？":15,"はい":16,"いいえ":17},"extension":"json","dataType":"map","filename":"Map340","basename":"Map340.json","path":"data/Map340.json","relPath":"data/Map340.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":18,"percent":11.11111111111111},"cellInfo":[],"cacheResetOnChange":{}},"data/Map341.json":{"data":[["EV001",""],["EV002",""],["男性",""],["「元祖悪竜退治の英雄リジェルダ王がつくった町――って\n　ことで観光客を呼べないかなぁ」\\nw[男性]",""],["「建国王リジェルダが最初に作った町ってことで、\n　そこそこ観光客が来るけど……みんな微妙な顔を\n　して帰っていくんだよね」\\nw[男性]",""],["火",""],["光",""],["主婦",""],["「やだ、お塩もお砂糖もほとんど残ってないわ！\n　買っておかなきゃ」\\nw[主婦]",""],["現金（窃盗用）",""],["窃盗の難しさ（1=簡単、2=難しい、3=高難度）",""],["手薄な時間帯（1=昼、2=夜）",""],["チェック",""],["「夜中に街の外へ出るのは、よしておいた方がいいわ。\n　盗賊や危険亜人が出没することもあるから」\\nw[主婦]",""],["窃盗用下着2",""],["<TE:117>",""]],"context":[["Map341/events/1/name"],["Map341/events/2/name"],["Map341/events/3/name"],["Map341/events/3/pages/0/list/1/message/noPicture/bottom","Map341/events/3/pages/2/list/1/message/noPicture/bottom"],["Map341/events/3/pages/0/list/7/message/noPicture/bottom","Map341/events/3/pages/2/list/7/message/noPicture/bottom"],["Map341/events/4/name"],["Map341/events/5/name"],["Map341/events/6/name","Map341/events/9/name"],["Map341/events/6/pages/1/list/0/message/noPicture/bottom"],["Map341/events/7/name"],["Map341/events/7/pages/0/list/0/comment"],["Map341/events/7/pages/0/list/2/comment"],["Map341/events/8/name","Map341/events/11/name"],["Map341/events/9/pages/0/list/0/message/noPicture/bottom","Map341/events/9/pages/2/list/0/message/noPicture/bottom"],["Map341/events/10/name"],["Map341/events/10/note"]],"tags":[["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],null,["gold"],["red"],["red"],["gold"],null,["gold"]],"parameters":[null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["窃盗の難しさ（1=簡単、2=難しい、3=高難度）"]}],[{"headerIndex":2,"headerParam":["手薄な時間帯（1=昼、2=夜）"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"男性":2,"「元祖悪竜退治の英雄リジェルダ王がつくった町――って\n　ことで観光客を呼べないかなぁ」\\nw[男性]":3,"「建国王リジェルダが最初に作った町ってことで、\n　そこそこ観光客が来るけど……みんな微妙な顔を\n　して帰っていくんだよね」\\nw[男性]":4,"火":5,"光":6,"主婦":7,"「やだ、お塩もお砂糖もほとんど残ってないわ！\n　買っておかなきゃ」\\nw[主婦]":8,"現金（窃盗用）":9,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":10,"手薄な時間帯（1=昼、2=夜）":11,"チェック":12,"「夜中に街の外へ出るのは、よしておいた方がいいわ。\n　盗賊や危険亜人が出没することもあるから」\\nw[主婦]":13,"窃盗用下着2":14,"<TE:117>":15},"extension":"json","dataType":"map","filename":"Map341","basename":"Map341.json","path":"data/Map341.json","relPath":"data/Map341.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":16,"percent":0},"cellInfo":[]},"data/Map342.json":{"data":[["EV001",""],["EV002",""],["主婦",""],["「ねぇ\\I[29]　今夜もいいでしょう？」\\nw[主婦]",""],["火",""],["光",""],["女の子",""],["「パパがお星さまになっちゃってから、ママは奴隷の\n　人と仲良しなの。\n　あたし、なんかヤダなぁ」\\nw[女の子]",""],["現金（窃盗用）",""],["窃盗の難しさ（1=簡単、2=難しい、3=高難度）",""],["手薄な時間帯（1=昼、2=夜）",""],["チェック",""],["奴隷",""],["「いけません奥様！\n　奴隷のオレなんかと……ハァハァ」\\nw[男奴隷]",""],["宝箱",""],["※\nアイテム：脱出ロープ\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""]],"context":[["Map342/events/1/name"],["Map342/events/2/name"],["Map342/events/3/name"],["Map342/events/3/pages/0/list/0/message/noPicture/bottom","Map342/events/3/pages/2/list/0/message/noPicture/bottom"],["Map342/events/4/name"],["Map342/events/5/name"],["Map342/events/6/name"],["Map342/events/6/pages/0/list/0/message/noPicture/bottom","Map342/events/6/pages/2/list/0/message/noPicture/bottom"],["Map342/events/7/name"],["Map342/events/7/pages/0/list/0/comment"],["Map342/events/7/pages/0/list/2/comment"],["Map342/events/8/name"],["Map342/events/9/name"],["Map342/events/9/pages/0/list/0/message/noPicture/bottom","Map342/events/9/pages/2/list/0/message/noPicture/bottom"],["Map342/events/10/name"],["Map342/events/10/pages/0/list/0/comment"],["Map342/events/10/pages/0/list/3/comment"],["Map342/events/10/pages/0/list/6/comment"],["Map342/events/10/pages/0/list/8/comment"],["Map342/events/10/pages/0/list/10/comment"]],"tags":[["gold"],["gold"],["gold"],null,["gold"],["gold"],["gold"],null,["gold"],["red"],["red"],["gold"],["gold"],null,["gold"],["red"],["red"],["red"],["red"],["red"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["窃盗の難しさ（1=簡単、2=難しい、3=高難度）"]}],[{"headerIndex":2,"headerParam":["手薄な時間帯（1=昼、2=夜）"]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":3,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":8,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":10,"headerParam":["↓アイテムの重量を変数に入力する"]}]],"indexIds":{"EV001":0,"EV002":1,"主婦":2,"「ねぇ\\I[29]　今夜もいいでしょう？」\\nw[主婦]":3,"火":4,"光":5,"女の子":6,"「パパがお星さまになっちゃってから、ママは奴隷の\n　人と仲良しなの。\n　あたし、なんかヤダなぁ」\\nw[女の子]":7,"現金（窃盗用）":8,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":9,"手薄な時間帯（1=昼、2=夜）":10,"チェック":11,"奴隷":12,"「いけません奥様！\n　奴隷のオレなんかと……ハァハァ」\\nw[男奴隷]":13,"宝箱":14,"※\nアイテム：脱出ロープ\n※":15,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":16,"↓アイテムのIDNo.を変数に入力する":17,"↓アイテムの入手個数を変数に入力する":18,"↓アイテムの重量を変数に入力する":19},"extension":"json","dataType":"map","filename":"Map342","basename":"Map342.json","path":"data/Map342.json","relPath":"data/Map342.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":20,"percent":0},"cellInfo":[]},"data/Map343.json":{"data":[["EV001",""],["EV002",""],["光",""],["火",""],["冒険者1",""],["「悪竜は無理でも、ミノタウロスを倒せるくらいには\n　強くなりたいもんだ」\\nw[男性冒険者]",""],["「ミノタウロスはヤベーな。\n　いまの俺らじゃ歯がたたないぜ」\\nw[男性冒険者]",""],["冒険者2",""],["「悪竜を倒せるくらい強ければ、どんなダンジョンも\n　入り放題でしょうね」\\nw[女性冒険者]",""],["「私たち結構強くなったと思うけど、まだまだ避けるべき\n　モンスターもいるわね」\\nw[女性冒険者]",""],["冒険者3",""],["「次は風の塔に挑戦してみないか？\n　ここからだと、ちょっと遠いけど」\\nw[猫人冒険者]",""],["冒険者4",""],["「今回のダンジョンはシケてたなぁ。\n　次はもっとお宝のありそうなところに行こうぜ」\\nw[男性冒険者]",""],["冒険者5",""],["「この付近は同業者が多すぎるわ。\n　どこかに穴場のダンジョンはないかしら？」\\nw[女性冒険者]",""],["冒険者6",""],["「言われるがまま入会しちゃったけど、もっとちゃんと\n　説明を聞いた方が良かったかなぁ……」\\nw[冒険者]",""],["冒険者7",""],["「割のいい依頼でも貼り出されてないかと、読んで\n　みたものの……なにこれ？」\\nw[冒険者]",""],["掲示物",""],["～　冒険者の心得　～\nその１.　依頼主には笑顔で挨拶！\nその２.　依頼内容は慎重にチェック！",""],["その３.　自分の命より大切なお宝はない！\nその４.　困ったときは恥ずかしがらずに相談しよう！\nその５.　報酬の配分は平等に！",""],["ギルドスタッフ1（個別依頼）",""],["冒険者の証",""],["「当ギルドに入会希望の方は、特定のモンスターが落とす\n　換金用アイテムを入会費として収めていただきます。\\nw[ギルド職員]",""],["「ノルマは\\C[17]『\\in[403]』\\C[0]と\\C[17]『\\in[405]』\\C[0]が\\C[17]１個ずつ\\C[0]\n　となります」\\nw[ギルド職員]",""],["「ようこそ、王国で唯一の冒険者ギルドへ！」\\nw[ギルド職員]",""],["「ほー！\n　冒険者なんて適当にツルむもんだと思ってたが、\n　とうとうギルドが出来たのか」\\nw[\\N[1]]",""],["「無職のゴロツキと大差ない扱いを受けてた冒険者も、\n　ギルドを作るような時代になったってワケか」\\nw[\\N[1]]",""],["「そうなんですよ！\n　王国初です！　もしかしたら世界初かも！」\\nw[ギルド職員]",""],["「それは流石にないんじゃ……」\\nw[\\N[2]]",""],["「それで、ギルドに入るとどんなメリットがあるんだ？」\\nw[\\N[1]]",""],["「よくぞ聞いてくださいました！\n　当ギルドでは、冒険者向けの傷病保険や死亡保険を\n　扱っておりまして――」\\nw[ギルド職員]",""],["「そういうのは別にいらないんだが。\n　もっとこう、即物的なやつはないのか？」\\nw[\\N[1]]",""],["「で、でしたら、会員にお配りしている\\C[17]ダンジョンマップ\\C[0]\n　はどうでしょう？\\nw[ギルド職員]",""],["「王国内の主要なダンジョンの位置が記されている\n　マップなんですよ！」\\nw[ギルド職員]",""],["「それは便利そうですね。\n　いちいち街の人に話を聞いて、ダンジョンのある場所を\n　探す必要もなくなりますし」\\nw[\\N[2]]",""],["「ご入会いただければ、他にも次のようなメリットが\n　ありますよ」\\nw[ギルド職員]",""],["・地下の訓練場で有料訓練を受け、\\C[17]経験値\\C[0]を得られる\n・換金用アイテムの\\C[17]優待価格での買い取り\\C[0]\n・冒険者ギルド専売アイテム\\C[17]『脱出ロープ』\\C[0]が購入可能",""],["「ほうほう。それで肝心のギルド入会費はいくらなんだ？」\\nw[\\N[1]]",""],["「そこがちょっと特殊でして。\\nw[ギルド職員]",""],["「当ギルドではお金の代わりに、特定のモンスターが落とす\n　\\C[17]換金用アイテム\\C[0]を入会費として収めていただきます。\\nw[ギルド職員]",""],["「これは質の悪すぎる冒険者を加入させないための\n　テストも兼ねているためなんです」\\nw[ギルド職員]",""],["「なるほど。\n　モンスターを倒した証拠として換金用アイテムを\n　提出しなさい、というわけですか」\\nw[\\N[2]]",""],["「はい、おっしゃる通りです。\n　ノルマは\\C[17]『\\in[403]』\\C[0]と\\C[17]『\\in[405]』\\C[0]が\\C[17]１個ずつ\\C[0]。\\nw[ギルド職員]",""],["「それぞれクモ系のモンスターと、スケルトン系の\n　モンスターからドロップする換金用アイテムですね。\\nw[ギルド職員]",""],["「以上が冒険者ギルドの説明となりますが、\n　入会をご希望されますか？」\\nw[ギルド職員]",""],["個別依頼『冒険者の証』を受けますか？",""],["受ける",""],["受けない",""],["「わかった。\n　その換金用アイテムを集めてくるから、入会希望って\n　ことでよろしく頼む」\\nw[\\N[1]]",""],["「はぁ……また戦闘しなきゃダメですか……」\\nw[\\N[2]]",""],["個別依頼\\C[17]『冒険者の証』\\C[0]を受けた！",""],["「ところで、クモとスケルトンを狩れるような場所って、\n　この近くにあるか？」\\nw[\\N[1]]",""],["「\\C[17]町のすぐ西側に広がる湿地帯\\C[0]に、クモもスケルトンも\n　よく湧きますよ」\\nw[ギルド職員]",""],["「それってつまり、ていよく町のためにモンスター駆除を\n　やらされてるだけなんじゃ……」\\nw[\\N[2]]",""],["「一石二鳥ねらいかよ。\n　……まあいい、とにかく湿地帯でモンスターを狩るぞ」\\nw[\\N[1]]",""],["「えぇっ！？\n　ここまで来ておいて、入会しないんですか！？」\\nw[\\N[2]]",""],["ギルド職員に『\\in[403]』１個と『\\in[405]』１個を\n提出した。",""],["「はい、確かに必要な数をお預かりしました。\\nw[ギルド職員]",""],["「ありがとうございます。\n　それでは\\N[1]様と\\N[2]様を当ギルドの会員\n　として登録させていただきます」\\nw[ギルド職員]",""],["「これで、晴れて俺たちも冒険者の仲間入りって\n　わけだ」\\nw[\\N[1]]",""],["「単にギルド会員って肩書がついただけですけどね」\\nw[\\N[2]]",""],["個別依頼\\C[17]『冒険者の証』\\C[0]を達成した！\n報酬として\\C[17]冒険者ギルドに入会\\C[0]した！",""],["\\N[2]の信頼度が\\C[17]「６」\\C[0]上がった！",""],["\\>　　 ※　\\C[17]『マップ』\\C[0]に、ダンジョンの位置が追加　※\n\\>　　 ※　された！　　　　　　　　　　　　　　　※",""],["\n\\>　　※　冒険者ギルドで売買ができるようになった！　※",""],["里帰りEvを受けている場合",""],["「さて、冒険者としての箔付けも済んだことだし、\n　いよいよシーグヌースへ向かうぞ」\\nw[\\N[1]]",""],["「さっき職員の方から聞いたんですけど、\\C[17]ウェーベロイの町\\C[0]\n　で護衛の募集をしている商船があるそうです」\\nw[\\N[2]]",""],["「まさに渡りに船だな！\n　じゃあウェーベロイで船を探すか。\\nw[\\N[1]]",""],["「運が良ければ、海賊に襲われずにシーグヌースまで\n　渡れるかもな」\\nw[\\N[1]]",""],["「だといいんですけど……」\\nw[\\N[2]]",""],["\\C[17]港の町ウェーベロイ\\C[0]へ行って、シーグヌース行きの商船を\n探そう！",""],["実績 31",""],["「ギルド入会のノルマは\\C[17]『\\in[403]』\\C[0]と\\C[17]『\\in[405]』\\C[0]\n　それぞれ\\C[17]１個ずつ\\C[0]の提出となります。\\nw[ギルド職員]",""],["ギルドスタッフ2",""],["ギルド長",""],["「これまでは冒険者も町の依頼掲示板を利用して\n　きたが、いずれここに冒険者専用の掲示板を\n　作るつもりなのだ」\\nw[ギルド長]",""],["依頼マーク",""],["冒険者8",""],["「パーティーを組んでくれる人がいないか探しに来たん\n　だけど……誰に声をかけたらいいんだろう？」\\nw[新米冒険者]",""],["料理1",""],["冒険者",""],["「数年前までここにいたっていう凄腕冒険者。\n　もしかすると彼が悪竜退治の英雄かもしれないな。\\nw[ハゲた冒険者]",""],["「なんでも俺と同様ハゲていたらしいが、多少は髪が\n　残っていたとか」\\nw[ハゲた冒険者]",""],["「数年前までこのハリエーツの町には、伝説の再来と\n　言われた凄腕冒険者がいたらしい。\\nw[ハゲた冒険者]",""],["「だが俺が来たときには、もう姿を消していたんだ。\n　彼も俺と同類だったそうだ……ああ、ハゲていたのさ」\\nw[ハゲた冒険者]",""],["「北へ行くと\\C[17]ハイエルフの森\\C[0]があるけど、命が惜しいなら\n　無闇に入らないことね。\n　モンスターはたくさんいるし、エルフは排他的だから」\\nw[女性冒険者]",""],["EV021",""],["EV022",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　　『名前のない英雄』\n\\>\n\\>『……この伝説の冒険者と言われる男について、現存\n\\>　する資料は断片的なエピソードを語るのみだ。\n\\>　出身地や容姿、そして名前についても推測のための\n\\>　手がかりすら無いのである。\n\\>　おそらく、冒険者本人が名を明かさずに活動してい\n\\>　たのであろう。その背景にはなにがあったのか？\n\\>　\n\\>　ただ複数の資料から、彼が尋常でない力を秘めた武\n\\>　具をまとっていたことは確認できる。\n\\>　正体を解き明かせる可能性があるとすれば、この武\n\\>　具方面の研究からではないかと思う』",""],["MWL_行数リセット",""]],"context":[["Map343/events/1/name"],["Map343/events/2/name"],["Map343/events/3/name"],["Map343/events/4/name"],["Map343/events/5/name"],["Map343/events/5/pages/0/list/1/message/noPicture/bottom","Map343/events/5/pages/2/list/1/message/noPicture/bottom"],["Map343/events/5/pages/0/list/7/message/noPicture/bottom","Map343/events/5/pages/2/list/7/message/noPicture/bottom"],["Map343/events/6/name"],["Map343/events/6/pages/0/list/1/message/noPicture/bottom","Map343/events/6/pages/2/list/1/message/noPicture/bottom"],["Map343/events/6/pages/0/list/7/message/noPicture/bottom","Map343/events/6/pages/2/list/7/message/noPicture/bottom"],["Map343/events/7/name"],["Map343/events/7/pages/1/li