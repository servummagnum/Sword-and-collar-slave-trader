した！":44,"ResetZoom 60":45,"ResetFocus 60":46},"extension":"json","dataType":"map","filename":"Map051","basename":"Map051.json","path":"data/Map051.json","relPath":"data/Map051.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":47,"percent":0},"cellInfo":[]},"data/Map052.json":{"data":[["EV001",""],["↓再現性の無い左移動し続けるバグに対しての対症療法処理(Ver.1.0.4で追加)",""],["↑ここまで",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["宿屋",""],["EV008",""],["魔法具店",""],["EV009",""],["アクセサリ店",""],["EV010",""],["武器防具店",""],["EV011",""],["卸売商会",""],["EV012",""],["聖堂",""],["EV013",""],["商業ギルド",""],["EV014",""],["馬車屋","Stagecoach shop"],["スケベじじい（依頼19）",""],["依頼を出している場合",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["女性",""],["「夫が無事に航海から帰ってくるよう、毎日お祈りに\n　通っているの」\\nw[信心深い女]",""],["依頼フキダシ",""],["男性",""],["ドゥブカ島について",""],["「は？　ドゥブカ島だって？\n　この北海にそんな間の抜けた名前の島、ないと思うぞ？」\\nw[地元の男]",""],["通常会話",""],["「この町は、ここ数十年のあいだに急速に発展したんだ。\n　だから余所から移り住んできた者も多いんだよ」\\nw[地元の男]",""],["落ちてる精霊石（街）",""],["「謎の冒険者が王都で悪竜を倒したという話だけど、\n　僕の経験からいって有り得ないね。\n　百人がかりだって相手になるかどうか」\\nw[元冒険者]",""],["「この辺りの海で長いこと冒険をしてきたけど、\n　ドゥブカという島はちょっと聞いたことないね」\\nw[元冒険者]",""],["「海のモンスターは水属性の攻撃を多用する。\n　けど、そればかりに気を取られてると、別のところで\n　痛い目を見るかもしれないよ？」\\nw[元冒険者]",""],["王国官吏（依頼30）",""],["「うーん……少しは地理に詳しいつもりだけど、\n　ドゥブカなんて島は記憶にないわねぇ」\\nw[冒険者]",""],["「冒険者がこの島で稼ぐなら、船の護衛か、東の灯台での\n　モンスター退治ね」\\nw[冒険者]",""],["工事監督官（依頼31）",""],["執事（依頼21）",""],["研究者（依頼32)",""],["おっぱいマニア（依頼18）",""],["鉤爪捜索メッセージ表示",""],["竜の鉤爪があるかもしれない\\C[17]ドゥブカ島\\C[0]について、町の\n人々から情報を集めよう。",""],["漁師",""],["海産物売買フキダシ",""],["淫行男2",""],["卑屈な男",""],["「おいテメェ！　いまオレのこと笑っただろ！\n　チクショウが！！」\\nw[\\v[1655]]",""],["「女なんてのはなぁ、どいつもこいつもただのメスなんだ！\n　分かるか、おい？」\\nw[\\v[1655]]",""],["\\N[2]をこの男と\\C[27]売春\\C[0]させますか？",""],["売春させる",""],["やめておく",""],["淫行表示",""],["淫行男1",""],["胡散臭い男",""],["「見ねぇ顔だな、おい。\n　裏の顔役のオレ様に、挨拶でもしに来たのか？」\\nw[\\v[1655]]",""],["「その猫人の奴隷、見たことあるぜ。\n　街でちょっと評判だった美少女じゃねぇか」\\nw[\\v[1655]]",""],["通行遮断",""],["馬車",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["ボート",""],["通行不可",""],["食料品店",""],["子供1",""],["「ドゥブカ島？\n　ううん、知らなーい！」\\nw[男の子]",""],["「ボクも大きくなったら、父ちゃんみたいな船乗りに\n　なるんだ！」\\nw[男の子]",""],["男性市民3",""],["「初めて聞く名前の島だね。\n　ちょっと分からないな。」\\nw[赤髪の男]",""],["「この島にはハーピーが棲息してるんだ。\n　ときどき街の方にも飛んでくるよ」\\nw[赤髪の男]",""],["浮気調査（依頼13・14・15）",""],["景気ランタン",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 0 51",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ターゲット表示",""],["水夫（海賊島の話）",""],["「ドゥブカ島？\n　それって確か、例の\\C[17]海賊島\\C[0]の古い名前じゃなかったっけ？」\\nw[水夫]",""],["「えっ、海賊島ってあの！？」\\nw[\\N[2]]",""],["「どういうことだ？」\\nw[\\N[1]]",""],["「あのですね、この辺りを荒らし回っている海賊の\n　本拠地が海賊島と呼ばれる島なんです。」\\nw[\\N[2]]",""],["「みんな海賊島としか呼ばないんで、古い正式な名前が\n　あるなんて地元民でも知らなかったんですけど――」\\nw[\\N[2]]",""],["「それがドゥブカ島だったわけか。\n　ってことはだ、俺たちは海賊がウヨウヨいる島に\n　乗り込まなきゃならないのか？」\\nw[\\N[1]]",""],["「そうなりますね……」\\nw[\\N[2]]",""],["「しかし、ひょっとすると手間が省けるかもしれんぞ」\\nw[\\N[1]]",""],["「え？　どういうことですか？」\\nw[\\N[2]]",""],["「仮に俺がメスガキの立場だったら、また海賊と協力して\n　島内にある鉤爪を捜索させるだろうな。\\nw[\\N[1]]",""],["「つまり海賊どもの動向を探れば、おのずと――」\\nw[\\N[1]]",""],["「竜の鉤爪の場所もわかる！？」\\nw[\\N[2]]",""],["「なあ水夫さん、その海賊島まで船を出してくれる\n　船乗りっていないか？」\\nw[\\N[1]]",""],["「いるわけないだろ、そんなヤツ。\n　なにを好き好んで、自分から海賊の本拠地に――。\\nw[水夫]",""],["「いやまて、交渉次第じゃ船を出すかもしれない\n　物好きが一人だけいるな」\\nw[水夫]",""],["「えっ、それってまさか……！？」\\nw[\\N[2]]",""],["「そう、\\C[17]ザーボ船長\\C[0]だ。\n　別名『クレイジー・ザーボ』」\\nw[水夫]",""],["「頭のネジが何本か抜けてるって有名な船長ですよ！」\\nw[\\N[2]]",""],["「ほほう……クレイジー・ザーボ、いいじゃないか。\n　そのイカレた船長を見つけて、海賊島まで船を出して\n　もらおう」\\nw[\\N[1]]",""],["「本気か？\n　あんたもネジが緩んでるんじゃないか？\\nw[水夫]",""],["「まあザーボ船長はこの時間なら、港の方にいるだろう\n　から、会いたいなら行くといい」\\nw[水夫]",""],["\n\\>　　　　　\\C[17]※　港にいるザーボ船長を探そう　※\\C[0]",""],["「ザーボ船長なら、\\C[17]港\\C[0]の方にいるはずだぜ」\\nw[水夫]",""],["浮気相手(依頼11)",""],["船長",""],["船マーク",""],["EV069",""],["ユマ（里帰りEv）",""],["海賊戦闘イベント終了後",""],["P_D_FILENAME name_town\\V[101]",""],["勝利時",""],["「お前たちのお陰で、無事シーグヌースまで来ることが\n　できた。礼を言うぜ」\\nw[船長]",""],["「構わんさ。こっちとしても運んでもらえて助かったからな。\n　ボーナスも貰ったことだし」\\nw[\\N[1]]",""],["「これで海賊も、しばらくは大人しくなりますよね？」\\nw[\\N[2]]",""],["「おそらくな。船舶の往来も元に戻るはずだ」\\nw[船長]",""],["海上輸送が再開されました。\n\\C[17]運賃を払えば船に乗って移動\\C[0]することができます。",""],["「それじゃオレは、次の航海に行くぜ。あばよ！」\\nw[船長]",""],["「で、お前の故郷に着いたわけだが……。",""],["「ここが\\C[17]島の町シーグヌース\\C[0]か。\n　さすがに港がでかいな」\\nw[\\N[1]]",""],["「でしょう？\n　時期によってはもっと船が停泊してることも\n　あるんですけど」\\nw[\\N[2]]",""],["敗北時",""],["「生きてシーグヌースには着いたが……くそっ！\n　お前らがしくじったせいで大損害だ！」\\nw[船長]",""],["「あんな不良品の大砲で、人間を狙撃しろってのが無茶\n　だったんだ！　采配ミスをこっちのせいにするな！」\\nw[\\N[1]]",""],["「はぁ……責任を押し付け合っても、奪われたものは返って\n　きませんよ……？」\\nw[\\N[2]]",""],["「えぇい！　忌々しい！\n　お前らの顔など二度と見たくない！」\\nw[船長]",""],["「しかし負けたとはいえ、海賊どもにもある程度の損害は\n　与えられたからな。\n　しばらくはヤツラも大人しくなるだろ」\\nw[\\N[1]]",""],["「不幸中の幸いですね。\n　これで船の往来が元に戻ってくれれば……」\\nw[\\N[2]]",""],["「でも、どうしましょう？\n　所持金を全部奪われて無一文になってしまいましたよ？」\\nw[\\N[2]]",""],["「おいおい、本当に有り金全部を差し出したわけないだろ。\n　半分は海賊どもに見つからないよう隠しておいたさ」\\nw[\\N[1]]",""],["「そっ、そうなんですか！？\\nw[\\N[2]]",""],["「良かったぁ～。半分とはいえ手元に残ってたんですね」\\nw[\\N[2]]",""],["\\C[17]所持金の半分は残っていた！\\C[0]",""],["「\\N[2]お前、なかなか面白いところで生まれ育った\n　んだな」\\nw[\\N[1]]",""],["「ええ、毎日楽しかったですよ。\n　父の仕事の手伝いは大変でしたけど」\\nw[\\N[2]]",""],["「それがまた、どうして奴隷身分なんかに落ちたんだ？」\\nw[\\N[1]]",""],["「実は……その原因も\\C[17]海賊\\C[0]でして。\\nw[\\N[2]]",""],["「ウチが所有してた商船が海賊に襲われて、荷を略奪された\n　うえに船は沈没したんです。その結果、破産を……。\\nw[\\N[2]]",""],["「それで負債をなんとか処理しようと、家財を全部\n　売り払ってお金を作ったんですけど……」\\nw[\\N[2]]",""],["「それでも金が足りなくて、お前は奴隷に売られたと？」\\nw[\\N[1]]",""],["「……はい」\\nw[\\N[2]]",""],["「うーむ……。\\nw[\\N[1]]",""],["「だがそれは、おかしくないか？\n　借金のカタに人身売買をやるのは、法で禁止されてる\n　はずだ。\\nw[\\N[1]]",""],["「闇でやってる連中もいるだろうが、お前みたいな\n　そこそこ大きな商家の人間が、違法奴隷なんかに\n　されるものか？」\\nw[\\N[1]]",""],["「それが、わたしは正規の手続きで奴隷身分に\n　なったんです。\\nw[\\N[2]]",""],["「どうしてそうなっちゃったのか、わたし自身もよく\n　分からないんですけど……」\\nw[\\N[2]]",""],["「分からないって、なんだそりゃ？\n　ずいぶんといい加減な話だな」\\nw[\\N[1]]",""],["「返す言葉もありません……」\\nw[\\N[2]]",""],["「なにか裏がありそうだな。\\nw[\\N[1]]",""],["「……まあ、ここでグダグダ話していても始まらんか。\n　顔を出したい場所があるんだろ？」\\nw[\\N[1]]",""],["「あ、はい。\n　とりあえず、前に私が住んでいた家へ行きましょう。\\nw[\\N[2]]",""],["「その近所に、わたしの友達や知人も住んでいるので。\n　家は\\C[17]町の北側\\C[0]にあります」\\nw[\\N[2]]",""],["\n　　　 ※　\\C[17]町の北側\\C[0]にある\\N[2]の生家へ行こう　※",""],["ユマ（生家イベント）",""],["「ここです！\n　ここがわたしの家――。\\nw[\\N[2]]",""],["「――だったんですけど……」\\nw[\\N[2]]",""],["「いまや、他人の手に渡って売り家か」\\nw[\\N[1]]",""],["「うぅ……わたしのおうちぃ……。\\nw[\\N[2]]",""],["「でも、くじけません！\n　命さえあれば、いつかまたこの家を取り戻すことだって\n　できるかも！」\\nw[\\N[2]]",""],["「そうだな。\n　お前が俺を手伝って大儲けできれば、家を買い戻す\n　ことだって不可能じゃないかもな」\\nw[\\N[1]]",""],["「はいっ、わたし頑張ります！」\\nw[\\N[2]]",""],["「それで、友人だか知人だかのところに、生存報告に\n　行くんだろ？」\\nw[\\N[1]]",""],["「はい、まずは一番仲の良かった友達の――」\\nw[\\N[2]]",""],["「うそっ！　\\N[2]？！\n　なんでここにいるの！？」\\nw[\\N[3]]",""],["「\\C[17]\\N[3]\\C[0]！？\\nw[\\N[2]]",""],["「わぁっ、\\N[3]だ！\n　良かった、こんなすぐに会えるなんて！」\\nw[\\N[2]]",""],["「お前の知り合いか？」\\nw[\\N[1]]",""],["「はいっ！\n　わたしの一番の友達の\\N[3]です！\\nw[\\N[2]]",""],["「彼女も商家の娘で、わたしの幼馴染なんですよ。\n　ウチが破産したときには、事後処理を色々と手伝って\n　くれて――」\\nw[\\N[2]]",""],["「\\N[2]、どういうことなの？\n　あんた奴隷になって遠くへ売られていったはずじゃ？」\\nw[\\N[3]]",""],["「う、うん……そうなんだけど……\\nw[\\N[2]]",""],["「でもこの人に買われて、今はお仕事の手伝いを\n　しながら、あちこち旅して回ってるの」\\nw[\\N[2]]",""],["「はぁ？　仕事の手伝い？\n　暗殺でもやってるの？」\\nw[\\N[3]]",""],["「俺はアサシンじゃねぇッ！！」\\nw[\\N[1]]",""],["「お、落ち着いてください、\\N[1]さん。\n　\\N[3]なりのジョークですよ、きっと」\\nw[\\N[2]]",""],["「ジョークはあんたよ。\n　てっきり、どこかの豚親父の性奴隷にでもなってる\n　もんだとばかり思ってたけど――。\\nw[\\N[3]]",""],["「それが平気な顔して帰ってくるなんて。\n　ずいぶんとヌルい環境にいるみたいじゃないの？」\\nw[\\N[3]]",""],["「わたしもどんな酷い目に遭わされるのか不安だったけど、\n　必死にお願いして、孕ませおじさんコースだけは\n　回避できたんだ」\\nw[\\N[2]]",""],["「こうしてまた\\N[3]と会えて嬉しいよ」\\nw[\\N[2]]",""],["「――チッ！\n　嬉しいのはあんただけよ。こっちはガッカリだわ」\\nw[\\N[3]]",""],["「え……？」\\nw[\\N[2]]",""],["「まだ気づかないの、このマヌケ！\n　誰もあんたが帰ってくることなんて、望んじゃいな\n　かったのよ！」\\nw[\\N[3]]",""],["「ってか、あんたが奴隷身分に落ちるよう裏で細工\n　したのは、何を隠そうこのあたしなんだけどぉ！」\\nw[\\N[3]]",""],["「う……うそっ……？\n　なに言ってるの、\\N[3]……そんなわけ……」\\nw[\\N[2]]",""],["「ウソなもんですか。\\nw[\\N[3]]",""],["「あんたも、あんたの親父も、ウチの商会に言われるが\n　まま負債の整理を手伝わせるんだもの。\n　好意でそんな親切すると思った？\\nw[\\N[3]]",""],["「書類を改ざんして、架空の詐欺罪で罪人に仕立てあげる\n　のは簡単だったわよ！\\nw[\\N[3]]",""],["「罪人であれば奴隷身分に落として売り飛ばせる\n　ものね！\n　あーはっはっはっ！！」\\nw[\\N[3]]",""],["「そんな……なんで……？」\\nw[\\N[2]]",""],["「おい、お前。\\N[2]の友達じゃなかったのか？\n　それともこいつに恨みでもあったのか？」\\nw[\\N[1]]",""],["「恨みですって！？\n　ええ、あるわよ！　数えきれないくらいにね！\\nw[\\N[3]]",""],["「子供のころ好きだった男子は、\\N[2]にばかり\n　夢中だったし！\\nw[\\N[3]]",""],["「町の美少女コンテストで優勝しても『\\N[2]ちゃんが\n　出場してたら結果は違ってただろう』とか言われるし！\\nw[\\N[3]]",""],["「そのくせ\\N[2]本人はヘラヘラ笑って、あたしのことを\n　親友だとか言って……ずっと我慢ならなかったわ！\\nw[\\N[3]]",""],["「完全に逆恨みじゃねーか！」\\nw[\\N[1]]",""],["「だから奴隷にしてやったのに、豚親父の性玩具になる\n　どころか、平気な顔して戻ってくるなんて……！\n　期待外れもいいところだわ！」\\nw[\\N[3]]",""],["「\\N[3]……一番の友達だって思ってたのに……」\\nw[\\N[2]]",""],["「話は分かった。\n　つまり\\N[2]は冤罪で奴隷身分にされたんだな？」\\nw[\\N[1]]",""],["「それがなんだっていうの？\n　言っておくけど、訴え出たって無駄よ。\\nw[\\N[3]]",""],["「証拠はもう処分してあるからね！」\\nw[\\N[3]]",""],["「お前を締め上げて、法務官の前で洗いざらい\n　吐かせるって方法もあるぞ？」\\nw[\\N[1]]",""],["「あはっ☆　バカが考えそうなことね！\\nw[\\N[3]]",""],["「\\C[17]\\N[4]！\\C[0]」\\nw[\\N[3]]",""],["「お呼びでしょうか、お嬢様？」\\nw[\\N[4]]",""],["「ええ、\\N[4]。\n　そこのバカがね、腕力を振りかざそうとしてるのよ」\\nw[\\N[3]]",""],["「なんだあの野郎は？\n　突然出てきやがって」\\nw[\\N[1]]",""],["「わ、わかりません……。\n　\\N[3]の商会に、あんな使用人はいなかったと\n　思います」\\nw[\\N[2]]",""],["「わたしに手を出そうっていうなら、この\\N[4]が\n　黙ってないわよ！」\\nw[\\N[3]]",""],["「ゆえあって\\N[3]お嬢様の執事をしております、\n　\\N[4]と申します」\\nw[\\N[4]]",""],["「お嬢様を害そうというのなら、僭越ながら私がお相手を\n　させていただきますが？」\\nw[\\N[4]]",""],["「あの男、かなり強そうだな。\n　執事とか抜かしてるが、ありゃあ用心棒だろ。\\nw[\\N[1]]",""],["「まともにはやり合いたくないな……」\\nw[\\N[1]]",""],["「\\N[2]、あんたが精液まみれのボロクソになって\n　なかったのは残念だけど、\\nw[\\N[3]]",""],["「あんたのトコの商会が潰れてくれたお陰で、ウチの\n　商会は急成長したわ！\\nw[\\N[3]]",""],["「いまや、\\C[17]王族\\C[0]とも取り引きするほどの大商会よ！\\nw[\\N[3]]",""],["「さ・ら・に、なーんと\\C[17]武器商ギルド\\C[0]の幹部クラスにも\n　なっちゃったわ！」\\nw[\\N[3]]",""],["「武器商ギルド！？\n　\\N[3]のところは、ウチと同じで商業ギルドの会員\n　だったんじゃ……！？」\\nw[\\N[2]]",""],["「鞍替えしたのよ！\n　これからは武器商ギルドの時代だからね！\\nw[\\N[3]]",""],["「いまは武器の取り扱いが主だけど、いずれ商業ギルドの\n　縄張り全部、武器商ギルドがいただくわよ！」\\nw[\\N[3]]",""],["「お嬢様、そろそろ船が出る時間です」\\nw[\\N[4]]",""],["「そうだったわね。\n　奴隷とアサシンに構ってて乗り遅れたら大変だわ」\\nw[\\N[3]]",""],["「このっ、腐れメスガキッ……！」\\nw[\\N[1]]",""],["「それじゃあ、もう行くわ。\n　せいぜい、あたしが\\C[17]王都\\C[0]で出世していくのを、指を\n　くわえて眺めてなさい」\\nw[\\N[3]]",""],["「では、これにて失礼いたします」\\nw[\\N[4]]",""],["「おい執事、雌犬のしつけをしておかないと、そのうち\n　痛い目を見るかもしれないぜ？」\\nw[\\N[1]]",""],["「やってみろ、アサシン。\n　その前に貴様の首をはねてやる」\\nw[\\N[4]]",""],["「\\N[3]……なんで……」\\nw[\\N[2]]",""],["「なんでもクソもあるか。\n　くだらねぇ逆恨みだって、本人が言ってただろうが。\\nw[\\N[1]]",""],["「それでどうすんだ、お前？」\\nw[\\N[1]]",""],["「どう、って言われても……」\\nw[\\N[2]]",""],["「濡れ衣着せられたままでいいのか？\n　このままじゃ、あのメスガキの一人勝ちだぞ」\\nw[\\N[1]]",""],["「そんなこと言われても……わたしになにが出来るって\n　言うんですか！？」\\nw[\\N[2]]",""],["「\\N[2]お嬢！？」\\nw[水夫]",""],["「こりゃ驚いた！　やっぱり\\N[2]お嬢じゃねぇですかい！\n　ご無事だったとは！」\\nw[水夫]",""],["「あなたは！　ウチの商船の水夫だった――」\\nw[\\N[2]]",""],["「いやぁ、旦那様もお嬢も奴隷にされちまって、もう\n　二度とお目にかかれないものと思ってやしたが、\\nw[水夫]",""],["「まさか戻っていらっしゃるたぁ、驚いた！」\\nw[水夫]",""],["「お前の商会の人間か？」\\nw[\\N[1]]",""],["「はい。\n　海賊に襲われたウチの商船の、数少ない生き残りの\n　一人です」\\nw[\\N[2]]",""],["「なら丁度いい。\n　おいあんた、海賊に襲われたときのこと、ちょっと\n　聞かせてもらえるか？」\\nw[\\N[1]]",""],["「ああん？　なんだって今更？\n　まぁ、別にいいけどよぉ」\\nw[水夫]",""],["「\\N[1]さん……？」\\nw[\\N[2]]",""],["「襲って来た海賊たちに、不審な点はなかったか？」\\nw[\\N[1]]",""],["「不審な点？　海賊なんざ、不審者ばかりだぞ。\n　そんなもん――。\\nw[水夫]",""],["「ああ、そういやぁ、ひとつ腑に落ちねぇことが\n　あったな」\\nw[水夫]",""],["「なんだ？」\\nw[\\N[1]]",""],["「ヤツラ、えらい正確にオレたちの船を見つけて、\n　襲って来たんだ。\\nw[水夫]",""],["「まるで最初から、こっちの出航時間や航路を全部\n　知ってたみたいに」\\nw[水夫]",""],["「ほう？\n　じゃあ、誰かが事前に海賊へ教えてたってことは？」\\nw[\\N[1]]",""],["「なんだと！？　ふざけんな！\n　航海予定を知ってたのは身内だけなんだぞ！\n　海の男が仲間を裏切ったりするか！」\\nw[水夫]",""],["「そいつは悪かった。\n　でも、予定を知ってたのは本当に身内だけか？」\\nw[\\N[1]]",""],["「それは……そういえば、他の商会の荷も臨時で\n　ちょっとだけ積むことになったんで、その相手\n　商会にだけは話を……」\\nw[水夫]",""],["「そ、その商会って、\\N[3]のところです……」\\nw[\\N[2]]",""],["「なるほどな」\\nw[\\N[1]]",""],["「まさか\\N[3]たちが海賊に情報を漏らしたって\n　いうんですか！？」\\nw[\\N[2]]",""],["「なっ、なんだってー！？」\\nw[水夫]",""],["「断定はできないが、可能性はありそうだな。\\nw[\\N[1]]",""],["「お前の商会の船が襲われてから、メスガキ商会が\n　成り上がるまでがスムーズすぎる。\\nw[\\N[1]]",""],["「最初から、全部詳細に組み立てられてた陰謀だったと\n　したら……」\\nw[\\N[1]]",""],["「そんな……」\\nw[\\N[2]]",""],["「もしそうなら、メスガキどもと海賊の裏の繋がりを\n　立証することで、お前の冤罪を晴らせるかもな」\\nw[\\N[1]]",""],["「えっ！？\\nw[\\N[2]]",""],["「も、もしかして、わたしのために冤罪をどうにか\n　しようと……？」\\nw[\\N[2]]",""],["「陰謀を暴いて、あのメスガキを絶望のどん底に堕として\n　やったら、さぞかし気分がいいだろうなぁ……！」\\nw[\\N[1]]",""],["「あっ、わたしのためとかじゃないんですねー。\n　そうですかー」\\nw[\\N[2]]",""],["「おいおい、あんた不穏なこと言ってるが、\n　なにをやらかすつもりだ？」\\nw[水夫]",""],["「バカ正直に問い質してもムダだろうからな。\n　ここはひとつ、\\C[17]裏社会の人間から情報を集めたい\\C[0]\n　ところだが……。\\nw[\\N[1]]",""],["「顔の広い裏の人間に渡りをつけたいな。\n　あてはぜんぜん無いが」\\nw[\\N[1]]",""],["「ないんですか……」\\nw[\\N[2]]",""],["「だったら、役に立つかもしれない話がありますぜ、\n　お嬢！\\nw[水夫]",""],["「船に乗せた客から聞いた話なんですがね、なんでも\n　\\C[17]王都の貧民街\\C[0]に巣食ってる\\C[17]犯罪集団のボス\\C[0]は、すごい\n　情報通らしいんでさ。\\nw[水夫]",""],["「ただし、小物は相手にしないって話ですから、いきなり\n　行って会えるかどうかは分かりませんがね」\\nw[水夫]",""],["「貧民街のボスか。\n　そういや俺もそんな噂は聞いたことあったな。\\nw[\\N[1]]",""],["「よしっ、それでいこう！\n　ボスに接触して情報を得るぞ！」\\nw[\\N[1]]",""],["「えぇ～？！\n　で、でも、会ってもらえるでしょうか……？」\\nw[\\N[2]]",""],["「小物に用はないっていうなら、奴隷商人としての\n　名を広めてから、乗り込んでやればいい」\\nw[\\N[1]]",""],["「結局これまで通り、奴隷狩りは続けるんですね……」\\nw[\\N[2]]",""],["メインシナリオ\\C[17]『里帰り』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["「まず当面は、\\C[17]奴隷を欲しいって客の依頼\\C[0]をバンバン\n　さばいていくぞ！」\\nw[\\N[1]]",""],["「俺の名前が、貧民街のボスの耳に届くまでな！」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『名声アップ』\\C[0]を受けた！",""],["\\>　※　\\C[27]ハートマーク\\C[0]のついた個別依頼を、\\C[17]３件以上達成\\C[0]　※\n\\>　※　してから、王都の貧民街を訪ねよう！　　　　　　※",""],["エルラ（生家イベント）",""],["バルコルド（生家Eイベント）",""],["水夫（生家イベント）",""],["個別依頼19",""],["珍ペット募集",""],["「私は動物が好きでね、異国からも色々と珍しい動物を\n　輸入しては飼育してきたんだ」\\nw[好事家]",""],["「へぇー、いろんな動物と触れ合えるなんてステキですね」\\nw[\\N[2]]",""],["「しかし最近は、これといって珍しい動物が入って\n　こなくてね。退屈していたんだ。\\nw[好事家]",""],["「そんなとき気づいたんだ。\n　まだ\\C[17]ハーピー\\C[0]を飼ったことが無かった、と」\\nw[好事家]",""],["「えっ！？」\\nw[\\N[2]]",""],["「そこできみたちに、ハーピー奴隷を注文したいのだ。\n　下品な乳袋はいらんから、\\C[17]ツルッとスリムなボディ\\C[0]の\n　個体を頼みたい」\\nw[好事家]",""],["「なるほど。\n　それで報酬の方はいかほどに？」\\nw[\\N[1]]",""],["「\\C[17]８０００Ｇ\\C[0]と、価値があるかどうか不明だが\n　この\\C[17]不思議な玉\\C[0]でどうだろうか？」\\nw[好事家]",""],["個別依頼『珍ペット募集』を受けますか？",""],["受ける",""],["受けない",""],["風の塔・4階",""],["魔巣の灯台",""],["個別依頼\\C[17]『珍ペット募集』\\C[0]を受けた！",""],["\\C[17]『\\in[137]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「注文のハーピー奴隷だ。\n　ちゃんと乳袋の無いヤツを選んできたぞ」\\nw[\\N[1]]",""],["「おぉっ！　これがハーピーか！\n　いまから飼育するのが楽しみだ……フフフ」\\nw[好事家]",""],["個別依頼\\C[17]『珍ペット募集』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「ハーピーの飼育、いまから楽しみだよ。\n　健康な個体を連れてきてくれたまえ」\\nw[好事家]",""],["依頼マーク",""],["ザーボ（海賊島案内Ev）",""],["「とうとう来たか、アサシン……俺を殺しに！」\\nw[ザーボ船長]",""],["「アサシンじゃないが、ちょっと殺してやりたくなったぞ」\\nw[\\N[1]]",""],["「\\N[1]さん、ここは抑えてください。\n　こういう人なんですよ。\\nw[\\N[2]]",""],["「あの、ザーボ船長。\n　わたしたちどうしてもドゥブカ島――海賊島に行か\n　なくちゃならないんです。\\nw[\\N[2]]",""],["「無理を承知でお願いしますが、どうか海賊島まで\n　船を出してもらえないでしょうか？」\\nw[\\N[2]]",""],["「……アサシンじゃないのか？」\\nw[ザーボ船長]",""],["「違うって言ってるだろが！」\\nw[\\N[1]]",""],["「そうか……俺の悪運もまだ尽きていないようだ。\n　無垢なる月と星に感謝を！」\\nw[ザーボ船長]",""],["「おい、こいつホントに大丈夫か？\n　ネジどころか、脳みそをどっかに落としてるんじゃ\n　ないか？」\\nw[\\N[1]]",""],["「ああっ……潮騒の歌も俺を祝福している！」\\nw[ザーボ船長]",""],["「ザーボ船長、あのぅ……わたしたちの話を……」\\nw[\\N[2]]",""],["「聞いてるぞ、海賊島に行きたいんだろ？\\nw[ザーボ船長]",""],["「あそこは無数の岩礁と渦で守られているから、正確な\n　海路を知っていなきゃ、近づくことさえできない。\\nw[ザーボ船長]",""],["「本拠地が知れていながら、いまだに海賊がのうのうと\n　活動してるのも、討伐艦隊があの島に近づけない\n　からだ」\\nw[ザーボ船長]",""],["「つまり、こっそり島に近づいて上陸するのは無理って\n　ことか？」\\nw[\\N[1]]",""],["「普通の船乗りにはな。\n　だが俺になら可能だ。海に愛されたこの俺になら！」\\nw[ザーボ船長]",""],["「じゃ、じゃあ、船を出してもらえますか！？」\\nw[\\N[2]]",""],["「そうだな……その仕事、受けてやってもいいが、\n　お前らは対価に何を支払える？　金ならいらんぞ」\\nw[ザーボ船長]",""],["「金以外を要求するのか？\n　ほんとに変なヤツだな。\\nw[\\N[1]]",""],["「俺は奴隷商人だから、奴隷で支払うってのはどうだ？\n　言ってくれれば、好みの奴隷を連れてくるぜ」\\nw[\\N[1]]",""],["「奴隷か……それも一興だな。\n　ならば、海のように\\C[17]青い髪\\C[0]を持った\\C[17]人間の女\\C[0]を希望する」\\nw[ザーボ船長]",""],["「ＯＫだ。\n　必ず連れてくるから、出航の準備をしておけよ？」\\nw[\\N[1]]",""],["水の塔・3階",""],["雪賊の隠れ家",""],["\\>　　　※　ザーボ船長の希望する\\C[17]奴隷\\C[0]を渡して、　※\n\\>　　　※　ドゥブカ島まで船を出してもらおう　　※",""],["\\C[17]『\\in[108]』\\C[0]をザーボ船長に渡しますか？",""],["「お望みの、髪が青い奴隷を連れてきたぞ」\\nw[\\N[1]]",""],["「おおっ、まさしく！\n　これこそ海にふさわしい女だ！」\\nw[ザーボ船長]",""],["ザーボ船長に奴隷を渡した！",""],["「髪が青いから海にふさわしいって、安直じゃないか？」\\nw[\\N[1]]",""],["「機嫌を損ねると面倒くさそうですから、ツッコミは\n　やめときましょうよ」\\nw[\\N[2]]",""],["「対価はいただいた。ならば俺も船を出そう！\n　たとえ行き先が見果てぬ水平線の先だとしても！」\\nw[ザーボ船長]",""],["「いや、行くのは海賊島だぞ？\n　ホントに分かってるんだろうな？」\\nw[\\N[1]]",""],["「任せておけ！\n　では早速、出航するか？」\\nw[ザーボ船長]",""],["出航する",""],["まだしない",""],["「海のように青い髪の人間の女だ。\n　そういう奴隷を連れて来られたら、船を出してやる」\\nw[ザーボ船長]",""],["「海賊島に向けて出航するか？」\\nw[ザーボ船長]",""],["「ぃよーしッ！\n　帆を張れ！　錨を上げろ！　出航だ！！」\\nw[ザーボ船長]",""],["EV080",""],["民家",""],["作業員（港）1",""],["「ドゥブカ島？　聞いたことないな。\n　よっぽど小さい、無名の島なんじゃないか？」\\nw[作業員]",""],["「毎日大量の荷が届くんで、運ぶだけでも大変だよ」\\nw[作業員]",""],["作業員（港）2",""],["「なんだって？　ドゥブカ島？\n　いいや、聞いたことも無い島だな」\\nw[作業員]",""],["「他と比べると、ここはまだ新しい街だけど、\n　貿易拠点として広く名前が知られてるんだぜ」\\nw[作業員]",""],["女性市民1",""],["「ドゥブカ島？\n　さあ？　この辺にはそんな島ないんじゃない？」\\nw[女性]",""],["「海は好きだけど、潮風のせいで髪が傷みやすいのが\n　ちょっとね……」\\nw[女性]",""],["男性市民1",""],["「すまない。地元育ちの人間じゃないんで、\n　島の名前を聞かれてもちょっと分からないな」\\nw[男性]",""],["「他の土地から引っ越してきたんだけど、海のそばは\n　いいね。気分が開放的になる」\\nw[男性]",""],["EV085",""],["娼館",""],["男性市民2",""],["「島を探してるって？\n　それよりケンカ中の妻と仲直りする方法を探してくれよ！」\\nw[男性]",""],["「家に帰りたくない……妻とケンカ中でね……」\\nw[男性]",""],["女性市民2",""],["「王都で悪竜が暴れたり、王と姫が死んだりしたという\n　話は伝わってきてますが、どこまで本当なんでしょうね？」\\nw[女性]",""],["「島……ですか？　ドゥブカ島？\n　いいえ、耳にした覚えはありませんね」\\nw[女性]",""],["「父が若かったころは、まだこんなに沢山の倉庫は\n　建っていなかったんですって」\\nw[女性]",""],["水夫1",""],["「航海図は毎日目にしてるけど、ドゥブカ島なんて名前が\n　載ってるのは見たことないな」\\nw[水兵]",""],["「海賊に商船の情報を流してた武器商ギルドの商人が\n　いたらしいぞ。王都で捕まったって話だが」\\nw[水夫]",""],["「水の積込量を間違えると、大変なことになるから\n　何重にもチェックしないと――」\\nw[水夫]",""],["兵士（追跡）2",""],["「もし海賊が街へ攻めてきたら、全員ひっ捕らえて\n　やるんだがなぁ」\\nw[兵士]",""],["個別依頼06",""],["灯台守の手記",""],["「私は、このシーグヌースの歴史をまとめて\n　出版しようと計画しているのだが……。\\nw[郷土史家]",""],["「実はひとつ、足りない資料があるのだ」\\nw[郷土史家]",""],["「どんな資料なんですか？」\\nw[\\N[2]]",""],["「島の東に古い灯台があるだろう？\n　そこの灯台守をしていた男の書いた\\C[17]手記\\C[0]が\n　必要なのだ。\\nw[郷土史家]",""],["「しかし灯台はいまやモンスターの巣窟となっていて、\n　気軽に手記を取りに行くこともできん。\\nw[郷土史家]",""],["「どうしたものかと、ずっと悩んでいるのだ」\\nw[郷土史家]",""],["個別依頼『灯台守の手記』を受けますか？",""],["「ダンジョン化した灯台か、面白そうじゃないか。\n　俺たちがその手記を取ってきてやってもいいぞ」\\nw[\\N[1]]",""],["「本当かね？　ぜひ頼むよ！\\nw[郷土史家]",""],["「もし無事に手記を持ち帰ってくれたら、お礼にそちらの\n　お嬢さんに似合いそうな\\C[17]『メイド服』\\C[0]を進呈しよう！」\\nw[郷土史家]",""],["「な、なぜにメイド服なんですか！？」\\nw[\\N[2]]",""],["「私の趣味だ……！」\\nw[郷土史家]",""],["「趣味って、誰かに着させるのか？\n　それとも自分で……いや、いい。言わなくていい」\\nw[\\N[1]]",""],["個別依頼\\C[17]『灯台守の手記』\\C[0]を受けた！",""],["「手記を取ってきたぞ。\n　これでいいか確認してくれ」\\nw[\\N[1]]",""],["「これで間違いない！\n　ありがとう、助かったよ！\\nw[郷土史家]",""],["「約束通り、このメイド服を受け取ってくれたまえ」\\nw[郷土史家]",""],["PNDK_LC getSurplusWeights 15",""],["個別依頼\\C[17]『灯台守の手記』\\C[0]を達成した！",""],["報酬として\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！\n\\N[2]の信頼度が\\C[17]「８」\\C[0]上がった！",""],["報酬として\\C[17]『\\an[\\v[191]]』\\C[0]をもらったが、\\C[18]積載可能な\n重量をオーバー\\C[0]しているため受け取れなかった。",""],["「『灯台守の手記』は、島の東に建っている\\C[17]魔巣の灯台\\C[0]に\n　あるはずだ」\\nw[郷土史家]",""],["\\>重量オーバーのため入手できなかった、個別依頼06の報酬だ。\n\\>拾いますか？\n\\>（必要とする積載重量の空き：\\C[17]５Ｗ\\C[0]）",""],["拾う",""],["拾わない",""],["\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！",""],["\\C[18]積載可能な重量をオーバー\\C[0]しているため入手できない。",""],["奴隷市",""],["奴隷市（フキダシ）",""],["奴隷市（通行不可）",""],["EV098",""],["女の子",""],["「あたし船乗りはキライだけど、船は好きよ」\\nw[女の子]",""],["EV100",""],["売り家表示",""],["ユマ生家買い戻しEv",""],["「やったぁ！　わたしの家！\n　わたしの家が戻ってきたぁ！」\\nw[\\N[2]]",""],["「家主は俺だけどな」\\nw[\\N[1]]",""],["「いいんです！\n　\\N[1]さんのものは、わたしのもの！」\\nw[\\N[2]]",""],["「普通それ逆だろうが。\n　自分が奴隷だってこと、ちゃんと覚えてるか？」\\nw[\\N[1]]",""],["「おうち～♪　ひっさしぶりの我が家～♪」\\nw[\\N[2]]",""],["「ダメだ、聞いちゃいねぇ……」\\nw[\\N[1]]",""],["「早く入りましょうよ、\\N[1]さん！」\\nw[\\N[2]]",""],["「急かすな急かすな」\\nw[\\N[1]]",""],["戦闘マーク",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["街中盗賊出没",""],["奴隷1",""],["「オレはずっと南方から連れられて来たんだ。\n　島のことなんて何も知るもんか」\\nw[奴隷]",""],["「隣りのヤツと同じ仕事だと思うか？\n　でも俺たち奴隷は、倍の量働かされるんだぜ！」\\nw[奴隷]",""],["奴隷2",""],["「くくく……自分の運命の変転に、我がことながら呆れる。\n　この私が奴隷とはな！」\\nw[悪魔奴隷]",""],["奴隷3",""],["「人間ごときを殺したからといって、この高貴なエルフの\n　身を奴隷に堕とすとは……おのれ！」\\nw[悪魔奴隷]",""],["奴隷4",""],["「ニンゲン、ころす。\n　もっともっと、ころしてやる」\\nw[鬼奴隷]",""],["奴隷5",""],["「あっしはケチな詐欺師でして、こんな危ない連中と\n　一緒に売られるなんて、何かの間違いじゃ……？」\\nw[人間奴隷]",""],["水夫2",""],["「ドゥブカ島ねぇ？\n　俺は全然聞いたことないなぁ」\\nw[水兵]",""],["「こいつらは、奴隷兵士として海外に売り飛ばされるんだ。\n　最前線で肉の壁にされるのさ」\\nw[水夫]",""],["猫",""],["ザーボ船長（エンディング）",""],["自宅入り口",""],["自宅","Player home"],["EV116",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["ロープ(下)",""],["マストに登りますか？",""],["登る",""],["登らない",""],["ロープ",""],["依頼01・02戦闘",""],["依頼を引き受けている場合、暴漢と戦闘",""],["「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]",""],["\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]",""],["暴漢と戦闘",""],["「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]",""],["襲ってきた暴漢を街の警備兵に引き渡した。",""],["暴漢",""],["レイプ魔",""],["レイプ被害者",""],["レイプマーク",""],["レイプEv向き合わせ",""],["レイプEv発生制御",""],["レイプ現場遭遇",""],["街中淫行制御",""],["エンディング1（ユマ）",""],["\n　　　\\N[6]の討伐に成功してから数ヶ月後――。",""],["「それじゃ、お買い物にいってくるねー」\\nw[\\N[2]]",""],["「今日はいい天気だなぁ。お洗濯物もよく乾きそう」\\nw[\\N[2]]",""],["「ちょっと待つニャ、\\N[2]！」\\nw[\\N[2]の父]",""],["「茶葉がもう無くなってたの、すっかり忘れてたニャ！\n　悪いけどついでに買ってきてくれるかニャ」\\nw[\\N[2]の父]",""],["「それはいいけどさ……父さん。その格好で家の外に\n　出るのはやめてって言ったよね？」\\nw[\\N[2]]",""],["「まだそんなこと言ってるのニャ？\n　これからはメイド服が仕事着ニャのに！」\\nw[\\N[2]の父]",""],["「だからってずっと着てる必要ないでしょ！\n　あと化粧も！」\\nw[\\N[2]]",""],["「ハイハイ、わかったニャ。\n　家に引っ込むから茶葉は頼んだニャ」\\nw[\\N[2]の父]",""],["「まったくもう、父さんは。隣り近所でどれだけ噂されて\n　るのか、気にもしないんだから」\\nw[\\N[2]]",""],["「……あの日々が嘘だったみたいに、毎日が平和だなぁ。\\nw[\\N[2]]",""],["「\\N[1]さん、今頃どこで何してるんだろう……」\\nw[\\N[2]]",""],["\\N[6]を倒したあと、わたしと父さんは奴隷身分から解放\nされて、故郷であるこのシーグヌースに帰ってきました。\\nw[\\N[2]]",""],["でも父さんは商会経営の仕事に戻るつもりは無いと言って、\n奴隷だったときの経験を生かした女装バーを開業しようと\nしています。\\nw[\\N[2]]",""],["できればやめて欲しいけれど、結局わたしも手伝わされ、\n準備は着々と進んでしまっており……。\\nw[\\N[2]]",""],["「まっ、\\N[1]さんのことだから、きっと元気に\n　やってるよね。\\nw[\\N[2]]",""],["「さて、買い物に行かなきゃ」\\nw[\\N[2]]",""],["「ザーボ船長！　お久しぶりですね。\\nw[\\N[2]]",""],["「海賊島のときはありがとうございました」\\nw[\\N[2]]",""],["「例のアサシンから、お前宛ての\\C[17]手紙\\C[0]を預かってきた」\\nw[ザーボ船長]",""],["「アサシンって……\\N[1]さんですか！？」\\nw[\\N[2]]",""],["「そうだ。ここに\\C[17]とある奴隷船の売買情報\\C[0]が同封して\n　あるから、好きなように使えということだ」\\nw[ザーボ船長]",""],["「奴隷船……？\\nw[\\N[2]]",""],["「あっ、まさか\\N[3]の売られた先を！？」\\nw[\\N[2]]",""],["「確かに渡したからな。\n　では俺はあの紺碧の海に戻る！　さらば！」\\nw[ザーボ船長]",""],["「\\N[3]……」\\nw[\\N[2]]",""],["「あのあと悪事が露見して奴隷身分に落とされたけど、\n　誰に売られてどうなったかは分からなかった……。\\nw[\\N[2]]",""],["「でも\\N[3]の居場所が分かるなら……。\n　うん、やっぱりこのまま見捨ててはおけない！\\nw[\\N[2]]",""],["「王国からもらった口止め料がまだあるから、奴隷の一人\n　くらいなら買えるし。\\nw[\\N[2]]",""],["「よし決めた！　\\N[3]を引き取りに行こう！」\\nw[\\N[2]]",""],["C_ENABLE_WEATHER",""],["エンディングロール\n↓　　↓　　↓",""],["↑　　↑　　↑\nエンディングロール",""],["ユマ父（エンディング）",""],["ユマ父",""],["「やっぱり故郷が一番ニャ。\n　でも昔からの知り合いが、みんな変な目で見てくるのは\n　どうにかニャらないかニャ」\\nw[\\N[2]の父]",""],["船長（海賊戦闘後）",""],["見張り台(降り口)",""],["マストを降りますか？",""],["降りる",""],["降りない",""],["フクロウ",""],["マップ取得",""],["FocusCamera 36 25 120",""],["ZoomOut 3 120",""],["\\C[17]\\V[908]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["水柱1",""],["掲示板依頼初期化おばあちゃん",""],["<TE:110>",""],["四聖教メッセンジャー",""],["<TE:112>",""],["会話マーク(EX)",""],["<TE:113>",""],["修正用",""],["Ver.1.0.4更新で誤ってスイッチ1141をOFFにする処理を入れてしまったので、\nここで修正をほどこす。",""]],"context":[["Map052/events/1/name"],["Map052/events/1/pages/0/list/3/comment","Map052/events/2/pages/0/list/3/comment","Map052/events/3/pages/0/list/3/comment","Map052/events/4/pages/0/list/3/comment","Map052/events/5/pages/0/list/3/comment","Map052/events/6/pages/0/list/3/comment","Map052/events/67/pages/0/list/0/comment"],["Map052/events/1/pages/0/list/10/comment","Map052/events/2/pages/0/list/10/comment","Map052/events/3/pages/0/list/10/comment","Map052/events/4/pages/0/list/10/comment","Map052/events/5/pages/0/list/10/comment","Map052/events/6/pages/0/list/10/comment","Map052/events/67/pages/0/list/7/comment"],["Map052/events/2/name"],["Map052/events/3/name"],["Map052/events/4/name"],["Map052/events/5/name"],["Map052/events/6/name"],["Map052/events/7/name"],["Map052/events/7/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map052/events/8/name"],["Map052/events/8/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map052/events/9/name"],["Map052/events/9/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map052/events/10/name"],["Map052/events/10/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map052/events/11/name"],["Map052/events/11/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map052/events/12/name"],["Map052/events/12/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiter