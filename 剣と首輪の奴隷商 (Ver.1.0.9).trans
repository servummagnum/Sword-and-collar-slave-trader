aderIndex":15,"headerParam":["依頼を引き受けている場合、暴漢と戦闘"]}],[{"headerIndex":47,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,1]}],[{"headerIndex":54,"headerParam":["暴漢と戦闘"]}],[{"headerIndex":58,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098094364752.js","start":0,"end":8,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098094365146.js","start":0,"end":8,"leftHand":{"type":"","context":[]}}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]},{"headerIndex":4,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"attachment":"scriptCommand/16944098094361420.js","start":0,"end":8,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098094371712.js","start":0,"end":8,"leftHand":{"type":"","context":[]}}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"attachment":"scriptCommand/16944098094375852.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,null,null,[{"headerIndex":10,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":26,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":28,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"EV006":5,"EV007":6,"商業ギルド":7,"EV008":8,"宿屋":9,"EV009":10,"武器防具店":11,"EV010":12,"アクセサリ店":13,"EV011":14,"魔法具店":15,"EV012":16,"卸売商会":17,"EV013":18,"聖堂":19,"EV014":20,"馬車屋":21,"王国官吏（依頼30）":22,"依頼を出している場合":23,"女性":24,"「神様、神様、どうか彼とあの女の仲を引き裂いて\n　ください……」\\nw[信心深い女]":25,"依頼フキダシ":26,"男性":27,"「よそから来た人は、坂道が多いって文句を言うけど、\n　それこそがこの町の個性なのさ」\\nw[地元の男]":28,"「ここから北へ行くと\\C[17]水の塔\\C[0]というダンジョンがあるんだ。\n　若い頃はそこで腕を磨いたものさ。\n　最上階まで行けたためしは無かったけど……」\\nw[元冒険者]":29,"「この町、店の位置が分かりにくいのよね。\n　だいぶ歩き回っちゃったわ」\\nw[冒険者]":30,"工事監督官（依頼31）":31,"執事（依頼21）":32,"EV028":33,"民家":34,"レイプ現場遭遇":35,"スケベじじい（依頼19）":36,"馬車":37,"通行遮断":38,"研究者（依頼32)":39,"おっぱいマニア（依頼18）":40,"街ズームアウト":41,"P_D_FILENAME name_town\\V[101]":42,"「こんな丘陵地帯にも町があったんですねぇ」\\nw[\\N[2]]":43,"「家屋を建てるのにはあまり適してなさそうだが、\n　外敵からは守りやすそうだな」\\nw[\\N[1]]":44,"個別依頼16":45,"臨床試験体":46,"「家に閉じこもって薬品の開発ばかりやってると、\n　どうしても体が鈍っちゃうんだよね。\\nw[研究者]":47,"「だからこうして、たまには外出するんだ」\\nw[研究者]":48,"「薬の研究者か。\n　どういった薬品の開発を？」\\nw[\\N[1]]":49,"「媚薬とか精力剤だよ」\\nw[研究者]":50,"「そいつは素晴らしい仕事だ」\\nw[\\N[1]]":51,"「ええ、とっても素敵なお仕事ですね。\n　そのお薬、ちょっと試してみたいなぁ\\I[29]」\\nw[\\N[2]]":52,"「ぜんぜんまったく素晴らしくないです」\\nw[\\N[2]]":53,"「ところで新しい薬品を開発するために、臨床試験用の\n　奴隷が欲しいんだ。頼めるかな？」\\nw[研究者]":54,"「どんな奴隷がいいんだ？」\\nw[\\N[1]]":55,"「そこらにいるような\\C[17]普通の人間の女\\C[0]でいいよ。\n　ただし僕、おっぱいが嫌いなんで\\C[17]貧乳\\C[0]がいいな」\\nw[研究者]":56,"「おっぱい嫌いとは珍しい。\n　好みは人それぞれだから、別にいいが」\\nw[\\N[1]]":57,"「ちなみに、お代は現物支払いで。\n　僕の書いた\\C[17]\\in[49]\\C[0]と\\C[17]\\in[22]２個\\C[0]を進呈するよ」\\nw[研究者]":58,"個別依頼『臨床試験体』を受けますか？":59,"受ける":60,"受けない":61,"地下遺跡・2層":62,"大山脈西洞窟":63,"個別依頼\\C[17]『臨床試験体』\\C[0]を受けた！":64,"\\C[17]『\\in[101]』\\C[0]を依頼者に渡しますか？":65,"渡す":66,"渡さない":67,"依頼条件達成":68,"「ほらよ。頼まれてた貧乳奴隷だ」\\nw[\\N[1]]":69,"「いやぁ、助かるよ。\n　これで新しい薬の開発に着手できる。\\nw[研究者]":70,"「ありがとう、奴隷商人さん。\n　それじゃこれ、お礼の品ね」\\nw[研究者]":71,"個別依頼\\C[17]『臨床試験体』\\C[0]を達成した！":72,"\nここからエッチイベント\n↓　　↓　　↓":73,"↓プレーヤー位置強制中央":74,"SFC_ENABLE_RESERVE":75,"依頼条件未達成":76,"「奴隷の件、頼むよ。\n　連れてきてもらわないと、研究が始められないから」\\nw[研究者]":77,"依頼掲示板":78,"掲示板マーク":79,"兵士":80,"兵士（追跡）":81,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":82,"依頼マーク":83,"聖堂通行不可スイッチ":84,"食料品店":85,"通行不可":86,"浮気調査（依頼13・14・15）":87,"尾行対象（依頼13・14・15）":88,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":89,"難易度ノーマル用":90,"難易度イージー用（振り向く前に立ち止まる時間が倍）":91,"視界範囲に引っかかったとき":92,"SmartPath 0 12 0":93,"周囲2マス圏内に侵入したとき":94,"尾行に気づいて逃走":95,"浮気相手の元へゴールしたとき":96,"ターゲット表示":97,"浮気相手(依頼11)":98,"「今日も平和だなぁ」\\nw[兵士]":99,"奴隷市":100,"奴隷市（フキダシ）":101,"奴隷市（通行不可）":102,"EV071":103,"市民（男）":104,"「うぅ……腹がギュルギュル鳴ってる……。\n　嫁のメシを食ったせいで……」\\nw[金髪の男]":105,"市民（老人）":106,"「おいおい、大丈夫かね？」\\nw[老人]":107,"男の子":108,"「かくれんぼ中だから、こっち来ないで！」\\nw[男の子]":109,"女の子":110,"「どこ行ったんだろ？\n　あの子ったら、かくれんぼ上手すぎるのよ！」\\nw[女の子]":111,"水兵":112,"「なんで船乗りの格好をしてるのかって？\n　俺は水兵だからさ。\n　休暇中でも心は海の男ってね」\\nw[水兵]":113,"奴隷2":114,"「窃盗がバレて奴隷に堕ちたのは運がなかったけど、\n　売られた先の主人は金持ちだったわ。\n　どうにかして財産を奪ってやる……！」\\nw[女奴隷]":115,"市民（主婦）1":116,"「この前うちの主人ったら、盗賊に追っかけられたのよ。\n　足が速いから逃げ切れたけど、下手をしたら今頃は\n　死んでたかも」\\nw[主婦]":117,"「王様が替わったそうだけど、今度はちゃんと盗賊や\n　危険亜人を取り締まってくれるかしら？」\\nw[主婦]":118,"「最近、盗賊や危険な亜人が増えてきたわね。\n　王様がちゃんとしないからだって、噂になってるわ」\\nw[主婦]":119,"市民（男性）1":120,"「旅の最中に聞いたのだが、王都で退治された悪竜は\n　\\N[5]姫に化けていたそうだ。\n　いったいいつから入れ替わっていたんだろうな？」\\nw[男性]":121,"「旅のついでに寄ったのだが、この町はなかなか\n　住みやすそうだ。\n　移住先として考えてみても、いいかもしれんな」\\nw[男性]":122,"「かくれんぼマスターのわたしを、よく見つけられ\n　ましたね。\n　あなたはもしや、キング・オブ・かくれんぼ？」\\nw[女の子]":123,"売り家表示":124,"自宅入り口":125,"自宅":126,"EV085":127,"EV086":128,"ＢＧＭ変更":129,"夜間用ＢＧＭ演奏":130,"夜→昼":131,"最初から昼":132,"昼→夜":133,"最初から夜":134,"盗賊1":135,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":136,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":137,"「邪魔をするなら殺す！」\\nw[蛮族]":138,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":139,"奴隷化性別：0=女、1=男、2=男女ランダム":140,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":141,"戦闘マーク":142,"景気ランタン":143,"落ちてる精霊石（街）":144,"依頼01・02戦闘":145,"依頼を引き受けている場合、暴漢と戦闘":146,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":147,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":148,"暴漢と戦闘":149,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":150,"襲ってきた暴漢を街の警備兵に引き渡した。":151,"暴漢":152,"犬":153,"レイプ魔":154,"レイプ被害者":155,"レイプマーク":156,"レイプEv向き合わせ":157,"レイプEv発生制御":158,"街中盗賊出没":159,"淫行男1":160,"ガラの悪い男":161,"「オレに用でもあんのか？\n　用もないのに声かけたんならブン殴るぞ？」\\nw[\\v[1655]]":162,"「ぐへへ……いいメス奴隷連れてんじゃねぇか。\n　見たところ調教済みか？」\\nw[\\v[1655]]":163,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":164,"売春させる":165,"やめておく":166,"淫行表示":167,"街中淫行制御":168,"淫行男2":169,"顔を隠した男":170,"「しっ！　しっ！　寄ってくんな！\n　野良犬みてぇな野郎め！」\\nw[\\v[1655]]":171,"「そういや最近、女を抱いてねぇな。\n　……その女奴隷、レンタルしてるか？」\\nw[\\v[1655]]":172,"EV108":173,"娼館":174,"マップ取得":175,"FocusCamera 25 20 120":176,"ZoomOut 2.5 120":177,"\\C[17]\\V[905]の地図\\C[0]を取得した！":178,"ResetZoom 60":179,"ResetFocus 60":180,"街中イーグルダイブ":181,"ここから飛び降りますか？":182,"飛び降りる":183,"やめる":184,"藁山":185,"フクロウ":186,"掲示板依頼初期化おばあちゃん":187,"<TE:110>":188,"侵入不可":189,"四聖教メッセンジャー":190,"<TE:112>":191,"会話マーク(EX)":192,"<TE:113>":193},"extension":"json","dataType":"map","filename":"Map048","basename":"Map048.json","path":"data/Map048.json","relPath":"data/Map048.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":194,"percent":1.0309278350515463},"cellInfo":[]},"data/Map049.json":{"data":[["EV001",""],["商業ギルド",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["EV008",""],["宿屋",""],["EV009",""],["武器防具店",""],["EV010",""],["アクセサリ店",""],["EV011",""],["魔法具店",""],["EV012",""],["卸売商会",""],["EV013",""],["聖堂",""],["EV014",""],["馬車屋","Stagecoach shop"],["奴隷2",""],["「もうやだ！　奴隷身分なんて耐えられない！\n　なんで男を騙して財産かすめ取ったくらいで、こんな目に\n　遭うの！？」\\nw[奴隷]",""],["EV016",""],["美術館",""],["女性",""],["「芸術の町の聖堂にしては変わり映えしないって批判も\n　あるけど、ここは祈りの場だからそれでいいと思うの」\\nw[信心深い女]",""],["王国官吏（依頼30）",""],["依頼を出している場合",""],["男性",""],["「この丁寧に掘り出された毛並みの美しさときたら……。\n　はぁ～……思わずため息が出てしまうよ」\\nw[地元の男]",""],["依頼フキダシ",""],["「西の山の抜け道を占領していた鬼が、誰かに倒された\n　らしい。\n　どこかの冒険者が退治したんだろうか？」\\nw[元冒険者]",""],["「\\C[17]西の山には抜け道がある\\C[0]んだけど、最近は鬼が出没する\n　んで通行止め状態なんだ。\\nw[元冒険者]",""],["「ボクが冒険者を引退した身でなければ、退治しに行ってた\n　かもね」\\nw[元冒険者]",""],["工事監督官（依頼31）",""],["「見た目がいいだけのナマクラな剣や鎧を買わされないよう、\n　注意した方がいいぞ。そういうのはディスプレイ用\n　だからな」\\nw[冒険者]",""],["研究者（依頼32)",""],["執事（依頼21）",""],["おっぱいマニア（依頼18）",""],["スケベじじい（依頼19）",""],["街ズームアウト",""],["P_D_FILENAME name_town\\V[101]",""],["「芸術の町！\n　ここで作られた彫像や絵画を、ウチの商会で運んだ\n　こともありましたよ！」\\nw[\\N[2]]",""],["「俺はまったく扱ったことが無いな。\n　贋作も多いから、経験の浅い人間は手が出しにくくてな」\\nw[\\N[1]]",""],["「買い付ける気があるなら、わたし手伝いますよ。\n　こう見えて審美眼には自信ありますから！」\\nw[\\N[2]]",""],["「じゃあ、とびきり卑猥な裸婦画でも仕入れるか？」\\nw[\\N[1]]",""],["「やっぱり手伝いません！！」\\nw[\\N[2]]",""],["EV035",""],["奴隷市",""],["奴隷市（フキダシ）",""],["奴隷市（通行不可）",""],["奴隷市（通行不可）＋モブ群衆",""],["芸術家1",""],["「王都の悪竜騒動からこっち、\\N[6]をモチーフに\n　した作品が増えておるようだ。\n　まったく、安直な者が多すぎるわい」\\nw[芸術家]",""],["「知ったような口振りで、芸術について語る輩の\n　なんと多いことか」\\nw[芸術家]",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["馬車",""],["通行遮断",""],["食料品店",""],["「この曲線、官能的すぎる！\n　ちょっと興奮してきたぞ……」\\nw[男性]",""],["淫行男2",""],["陰気な男",""],["「芸術なんてくだらねぇ……！\n　なにもかもブチ壊してやりてぇぜ……」\\nw[\\v[1655]]",""],["「絵や彫刻に勃起するクソどもと、オレは違うんだよ！\n　欲しいのは生身の女だ！」\\nw[\\v[1655]]",""],["\\N[2]をこの男と\\C[27]売春\\C[0]させますか？",""],["売春させる",""],["やめておく",""],["浮気調査（依頼13・14・15）",""],["淫行表示",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 0 0",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ターゲット表示",""],["淫行男1",""],["目つきの悪い男",""],["「クスリが欲しいんなら他を当たんな。\n　オレは売人じゃねぇよ」\\nw[\\v[1655]]",""],["「その女の目……色狂いの目だ。\n　男なら誰でも咥えこんじまうんだろ？」\\nw[\\v[1655]]",""],["浮気相手(依頼11)",""],["個別依頼17",""],["アートな奴隷",""],["「アートってのはなぁ、反骨精神を忘れたら\n　終わりなんだよォッ！」\\nw[芸術家]",""],["「いきなりそんなこと言われても、わけがわからん」\\nw[\\N[1]]",""],["「固定観念にとらわれたバカ野郎どもを見返すために、\n　オレは奴隷アートを作ることにしたんだッ！」\\nw[芸術家]",""],["「それなら分かる。\n　お前さんのアートに使う奴隷を、俺に注文するって\n　いうんだな？」\\nw[\\N[1]]",""],["「その通りだッ！　鬼の赤肌がいいッ！\n　\\C[17]鬼奴隷\\C[0]を一人連れてきてくれッ！」\\nw[芸術家]",""],["「鬼という以外に、なにか好みとかは……？」\\nw[\\N[2]]",""],["「リビドーを爆発させたいから、\\C[17]巨乳\\C[0]だッ！\n　予算は\\C[17]７０００Ｇ\\C[0]で頼んだぜッ！\n　ついでにこの\\C[17]変な玉っころ\\C[0]もくれてやるから！」\\nw[芸術家]",""],["個別依頼『アートな奴隷』を受けますか？",""],["受ける",""],["受けない",""],["迷いの森・湖畔",""],["峠の抜け道",""],["個別依頼\\C[17]『アートな奴隷』\\C[0]を受けた！",""],["\\C[17]『\\in[135]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「鬼を捕まえてきたぞ。\n　どう使うんだか知らんが、これでいいよな？」\\nw[\\N[1]]",""],["「いいぞ、いいぞ！\n　この赤い肌がオレのキャンパスだッ！」\\nw[芸術家]",""],["個別依頼\\C[17]『アートな奴隷』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「オレの奴隷アートのためにッ、さあ走れッ！\n　鬼を連れてくるんだッ！」\\nw[芸術家]",""],["\n\\>　　　　　～　芸術の町ペイサーの広場にて　～",""],["「さあ、見る目のあるヤツは集まりやがれ！\n　このオレの新作お披露目だッ！！」\\nw[芸術家]",""],["「なんだなんだ？　イベントでもあるのか？」\\nw[見物人Ａ]",""],["「おい、あいつは確か態度ばかりデカいって悪名高い\n　芸術家の――」\\nw[見物人Ｂ]",""],["「ああ、“イキリ芸術家”なんて呼ばれてるヤツだな」\\nw[見物人Ｃ]",""],["「誰がイキリだ！！　いいか大衆ども！\n　今日はお前らに、本物の芸術ってものを教えてやる！」\\nw[芸術家]",""],["「ふんっ、また大言壮語が始まったぞ」\\nw[見物人Ｂ]",""],["「どうせロクでもない物なんだろ？\n　まあ話のタネに見てやってもいいけど」\\nw[見物人Ａ]",""],["「本物の感動を味わいやがれ！\n　これがオレの芸術の神髄だぁッ！！」\\nw[芸術家]",""],["「なぜか大盛況だが、これはオレの望んでいたもの\n　じゃない！　なんでこうなったァ！？」\\nw[芸術家]",""],["「貴様ッ！！　公共の場でなにをしている！？\n　公然わいせつ罪で現行犯逮捕だッ！！」\\nw[警備兵]",""],["「ち、ちがうっ！　誤解だ！\n　これは正当な文化的活動で――」\\nw[芸術家]",""],["「なぁにが文化的活動だ！\n　これでお縄にされるのは何度目だと思っている！\\nw[警備兵]",""],["「毎回毎回、面倒をかけおって！\n　来いっ！　ブタ箱にブチ込んでやる」\\nw[警備兵]",""],["「いやぁ、すごいもの見れたなぁ」\\nw[見物人Ａ]",""],["「そして毎度おなじみの逮捕オチだったな」\\nw[見物人Ｂ]",""],["「連行された芸術家先生の次回作に期待しようぜ」\\nw[見物人Ｃ]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『アートな奴隷』の達成報酬として\\C[17]７０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["依頼マーク",""],["「もし美術品強盗の情報があれば、すぐ知らせるように」\\nw[兵士]",""],["個別依頼07",""],["地上絵の野望",""],["「次回作は\\C[17]巨大な地上絵\\C[0]と決めているのだが、\n　これを作るには大量の奴隷が必要なのだ。\\nw[外道アーティスト]",""],["「奴隷商人なら、必要な奴隷その他もろもろを用意して\n　くれないか？\\nw[外道アーティスト]",""],["「まず欲しいのは肉体労働用の奴隷２人。\n　予算は１００００Ｇで」\\nw[外道アーティスト]",""],["「おっ！　キミキミ！　そこのキミィ！」\\nw[外道アーティスト]",""],["「ん？　俺のことか？」\\nw[\\N[1]]",""],["「実にいい！　素晴らしいね！\n　デッサンするからポーズをとってくれないか！」\\nw[外道アーティスト]",""],["「そ、そうか？\n　まあちょっとくらいなら構わないが……」\\nw[\\N[1]]",""],["（まんざらでもなさそう……）\\nw[\\N[2]]",""],["「いいよ、いいよぉ！\n　もっと足を開いて腰を落として！　そう！」\\nw[外道アーティスト]",""],["「こんな感じか？」\\nw[\\N[1]]",""],["「いいね！　じゃあ、右手に刃物を持ってると想像して！\n　その手を顔の前に！　目つきは猛禽のように鋭く！」\\nw[外道アーティスト]",""],["「刃物？　……ちょっと待て、いったいどういう\n　目的のデッサンなんだ、これは？」\\nw[\\N[1]]",""],["「アサシンの冷徹な狂気を絵にしようって試みさ！\n　タイトルはそうだな……『暗殺者の信条』！」\\nw[外道アーティスト]",""],["「あぁっ！　\\N[1]さんに対する一番の禁句を……」\\nw[\\N[2]]",""],["「またかッ！　お前もかッ！\n　俺は奴隷商人だ！　異論は許さんッ！！」\\nw[\\N[1]]",""],["「ほう！　奴隷商人！\n　そいつはいい。実にいいね！」\\nw[外道アーティスト]",""],["「あ゛ぁん！？」\\nw[\\N[1]]",""],["「奴隷商人なら、必要な奴隷その他もろもろを用意して\n　くれないか？」\\nw[外道アーティスト]",""],["「フンッ！　仕事なら受けてやらんでもないが……\n　なにがどれくらい必要になるんだ？」\\nw[\\N[1]]",""],["「それがはっきりと分からないんだ。\n　なにせ初めてのことで、手探り状態で作業を進めて\n　いくんでね。\\nw[外道アーティスト]",""],["「必要に応じてその都度、追加発注させてもらうよ。\\nw[外道アーティスト]",""],["「まず欲しいのは\\C[17]肉体労働用の奴隷２人\\C[0]だ。\n　予算は\\C[17]１００００Ｇ\\C[0]で」\\nw[外道アーティスト]",""],["個別依頼『地上絵の野望』を受けますか？\n（※この依頼は数回に渡って商品を届けることになります）",""],["個別依頼\\C[17]『地上絵の野望』\\C[0]を受けた！",""],["「ＯＫ！　契約成立だ！\n　よろしく頼んだよ！」\\nw[外道アーティスト]",""],["依頼品：肉体労働用の奴隷２人",""],["配送先：芸術の町ペイサー",""],["10000G",""],["「\\C[17]肉体労働用の奴隷２人\\C[0]、持ってきてくれたのかい？」\\nw[外道アーティスト]",""],["労働奴隷を所持しているかチェック",""],["肉体労働用の奴隷",""],["奴隷が規定人数以上あるとき",""],["奴隷が規定人数以下のとき",""],["「早いところ頼むよぉ！\n　奴隷が届いたらすぐにでも、地上絵の製作にとりかかる\n　つもりだから」\\nw[外道アーティスト]",""],["「ほらよ。ご注文の品だ」\\nw[\\N[1]]",""],["「いいね！　よく働いてくれそうだ！」\\nw[外道アーティスト]",""],["依頼者に肉体労働用の奴隷２人を渡した！\n報酬として\\C[17]１００００Ｇ\\C[0]を入手した！",""],["「では私は早速、地上絵の製作に取りかかるとするよ。\\nw[外道アーティスト]",""],["「作業場所は\\C[17]大聖堂の西方に広がる草原\\C[0]だ！\n　次の奴隷はそこへ連れてきて欲しい」\\nw[外道アーティスト]",""],["「次の奴隷？」\\nw[\\N[2]]",""],["「補充用さ。\n　その奴隷が到着する頃には、今回買った奴隷は使い潰して\n　いるだろうからね」\\nw[外道アーティスト]",""],["「お前が外道呼ばわりされている理由が、よくわかったぜ」\\nw[\\N[1]]",""],["（外道ぶりなら\\N[1]さんも負けてないと思うけど、\n　言えば怒られるから黙ってよう）\\nw[\\N[2]]",""],["「次は\\C[17]肉体労働用の奴隷２人\\C[0]を\\C[17]１２０００Ｇ\\C[0]で頼むよ！」\\nw[外道アーティスト]",""],["個別依頼\\C[17]『地上絵の野望』\\C[0]の追加発注を受けた！",""],["「では私は現場へ向かうので、奴隷の手配はよろしく！」\\nw[外道アーティスト]",""],["配送先：大聖堂西方の草原地帯",""],["12000G",""],["街中淫行制御",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["芸術家2",""],["\\{「うんちょろぼげぇ～ッ！！」\\}\\nw[芸術家]",""],["「……ハッ？！　す、すまない。\n　いいアイディアが思い浮かんだもので、つい叫んで\n　しまったよ」\\nw[芸術家]",""],["観光客",""],["「芸術のことはよく分からないけど、なかなか\n　楽しい町だったわ」\\nw[観光客]",""],["案内板",""],["\\>　↑　広場\n\n\\>　↓　ペイサー美術館",""],["戦闘マーク",""],["街中盗賊出没",""],["奴隷1",""],["「町中の像を磨くのが俺の仕事なんだ。\n　奴隷の仕事としては、マシな部類だろうぜ」\\nw[奴隷]",""],["売り家表示",""],["EV077",""],["EV078",""],["EV079",""],["民家",""],["EV080",""],["市民（主婦）",""],["「町の美術館って、地元の人間はあまり行かないのよね。\n　観光施設なんてそんなものよ」\\nw[主婦]",""],["EV082",""],["女の子",""],["「わたしもおっきくなったら、ゲージュツカになるの！\n　お絵かきとくいだから！」\\nw[女の子]",""],["自宅入り口",""],["自宅","Player home"],["景気ランタン",""],["通行不可",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["フクロウ",""],["\\>\\{　　　　　≪ペイサー美術館≫\n\\>\\}　　　　　　　　開館時間 07：00～19:00",""],["落ちてる精霊石（街）",""],["依頼01・02戦闘",""],["依頼を引き受けている場合、暴漢と戦闘",""],["「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]",""],["\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]",""],["暴漢と戦闘",""],["「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]",""],["襲ってきた暴漢を街の警備兵に引き渡した。",""],["暴漢",""],["猫",""],["アヒル",""],["レイプ魔",""],["レイプ被害者",""],["レイプマーク",""],["レイプEv向き合わせ",""],["レイプEv発生制御",""],["レイプ現場遭遇",""],["マップ取得",""],["FocusCamera 25 24 120",""],["ZoomOut 3 120",""],["\\C[17]\\V[906]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["屋根通行不可",""],["水柱1",""],["HEv17用鬼奴隷",""],["警備兵（個別依頼17用）",""],["EV116",""],["娼館",""],["掲示板依頼初期化おばあちゃん",""],["<TE:110>",""],["四聖教メッセンジャー",""],["<TE:112>",""],["会話マーク(EX)",""],["<TE:113>",""]],"context":[["Map049/events/1/name"],["Map049/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map049/events/35/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/2/name"],["Map049/events/3/name"],["Map049/events/4/name"],["Map049/events/5/name"],["Map049/events/6/name"],["Map049/events/7/name"],["Map049/events/8/name"],["Map049/events/8/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/9/name"],["Map049/events/9/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/10/name"],["Map049/events/10/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/11/name"],["Map049/events/11/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/12/name"],["Map049/events/12/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/13/name"],["Map049/events/13/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map049/events/14/name"],["Map049/events/14/pages/0/list/3/Control V