d"],["gold"],null,null,null,null,null,null,null,null,null,null,["red"],["blue"],null,null,["gold"],["gold"],["gold"],["red"],["gold"],["gold"],["gold"],["gold"]],"parameters":[null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["企画モノ娼婦Ｃ"]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":38,"headerParam":["",0,0,2]}],[{"headerIndex":46,"headerParam":["",0,0,2]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":61,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":71,"headerParam":["",0,0,2]}],[{"headerIndex":75,"headerParam":["",0,0,2]}],null,null,[{"attachment":"scriptCommand/16944098124227296.js","start":0,"end":12,"leftHand":{"type":"","context":[]}}],[{"attachment":"scriptCommand/16944098124229368.js","start":0,"end":7,"leftHand":{"type":"","context":[]}}],[{"headerIndex":107,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":11,"headerParam":["依頼条件達成"]}],[{"headerIndex":26,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":55,"headerParam":["",0,0,2]}],[{"headerIndex":60,"headerParam":[""]}],[{"headerIndex":71,"headerParam":["↓プレーヤー位置強制中央"]}],null,[{"headerIndex":80,"headerParam":["依頼条件未達成"]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":8,"headerParam":["",0,1,1]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":26,"headerParam":["",0,0,2]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":32,"headerParam":["",0,0,2]}],[{"headerIndex":55,"headerParam":["",0,0,2]}],[{"headerIndex":58,"headerParam":["",0,0,2]}],[{"headerIndex":66,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":85,"headerParam":["",0,0,2]}],[{"headerIndex":88,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":2,"headerParam":["依頼を出している場合"]},{"headerIndex":11,"headerParam":["依頼を出している場合"]},{"headerIndex":20,"headerParam":["依頼を出している場合"]},{"headerIndex":29,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]}]],"indexIds":{"EV001":0,"客1":1,"「長期の航海に出る前には、必ずここで空っぽになるまで\n　ヌイていくんだ」\\nw[客]":2,"EV003":3,"窃盗用下着3":4,"<TE:118>":5,"EV005":6,"娼婦":7,"「さすがに一日で７人相手にするのは辛いわ……。\n　お金が必要だから仕方ないんだけど」\\nw[娼婦]":8,"「船乗りって情熱的な人が多いのよね」\\nw[娼婦]":9,"ドア":10,"部屋の中でお楽しみ中のようだ。":11,"燭台":12,"下着":13,"客2":14,"光":15,"EV015":16,"娼館従業員":17,"個別依頼28":18,"企画モノ娼婦Ｃ":19,"「ウチの店も、なにを考えているのかしらね。\n　企画物サービスに\\C[17]ハーピー\\C[0]を使おうだなんて」\\nw[娼婦]":20,"「娼館にハーピーを置くってだけでも珍しいのに、\n　企画物だと？　なにをやらせるんだ？」\\nw[\\N[1]]":21,"「\\C[27]『鳥娘との禁断ケダモノＳＥＸ！　オレの卵を産め！\n　　膣内射精で有精卵出荷！』\\C[0]」\\nw[娼婦]":22,"「素晴らしい企画ですね\\I[29]」\\nw[\\N[2]]":23,"「まさか同意が返ってくるとは思わなかったわ……」\\nw[娼婦]":24,"「…………」\\nw[\\N[2]]":25,"「い、言いたいことは分かるわ。\n　だからそんな目で見るのはやめて……」\\nw[娼婦]":26,"「インパクトはあるが、一般受けするかどうか疑問な\n　内容だなぁ」\\nw[\\N[1]]":27,"「そうなのよ！\n　だから見た目はできるだけ\\C[17]普通\\C[0]の、なるべく一般受け\n　しそうなハーピーを連れてきてちょうだい！」\\nw[娼婦]":28,"「ハーピー自体が一般受けしないって言ってるんだが……\n　まあいい、事情は分かった」\\nw[\\N[1]]":29,"「ハーピーの相場なんて知らないけど、\\C[17]５０００Ｇ\\C[0]\n　までなら出せるわ。それで足りなければ\\C[17]\\in[46]も１個\\C[0]\n　つけてあげる」\\nw[娼婦]":30,"個別依頼『企画モノ娼婦Ｃ』を受けますか？":31,"受ける":32,"受けない":33,"ハイエルフの森・1層":34,"魔巣の灯台":35,"個別依頼\\C[17]『企画モノ娼婦Ｃ』\\C[0]を受けた！":36,"\\C[17]『\\in[138]』\\C[0]を依頼者に渡しますか？":37,"渡す":38,"渡さない":39,"依頼条件達成":40,"「ハーピーを獲ってきたが、これでいいか？」\\nw[\\N[1]]":41,"「ええ、問題ないわ。\n　……むしろ問題はこれからね。\\nw[娼婦]":42,"「お客さんの相手ができるよう、この娘をしつけなきゃ\n　ならないの。\n　ハァ……なんであたしが教育係なのよ……」\\nw[娼婦]":43,"個別依頼\\C[17]『企画モノ娼婦Ｃ』\\C[0]を達成した！":44,"\nここでエッチイベント\n↓　　↓　　↓":45,"↓プレーヤー位置強制中央":46,"SFC_ENABLE_RESERVE":47,"依頼条件未達成":48,"「わたしは気乗りしないけど、店の方針だからハーピーの\n　件よろしくね」\\nw[娼婦]":49,"掲示板マーク":50,"男":51,"\n\\>　　　　　　　　～　娼館の一室にて　～":52,"「ハーピーまでいるなんて、この娼館はすごいな！」\\nw[男性客]":53,"「ピィッ！\n　オキャク！　オキャク！　エッチスル？」\\nw[奴隷ハーピー]":54,"「そ、そうだね、これからエッチするんだよ。\n　一応たしかめておくけど、エッチの意味分かってる？」\\nw[男性客]":55,"「コウビ！　オチンチン、アナ、イレル！」\\nw[奴隷ハーピー]":56,"「よかった、ちゃんと分かってたか……」\\nw[男性客]":57,"「タマゴ、ウム！　オキャクノタマゴ！」\\nw[奴隷ハーピー]":58,"「タマゴ？　ああ、そういうプレイだったっけ。\n　よーし！　ハーピーちゃんに有精卵産ませちゃうぞぉ！」\\nw[男性客]":59,"「タマゴ、ウマレタ！　ゴホービ！　ゴホービ！」\\nw[奴隷ハーピー]":60,"「どどど、どうしたら！？\n　温めるのか！？　温めればボクのヒナが孵るのかぁ！？」\\nw[男性客]":61,"↓プレーヤー位置強制中央解除":62,"SFC_DISABLE_RESERVE":63,"個別依頼『企画モノ娼婦Ｃ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[46]１個\\C[0]を入手した！":64,"\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！":65,"卵":66,"EV023":67,"娼館の客（依頼22~25)":68,"依頼を出している場合":69,"依頼フキダシ":70,"娼館支配人（依頼20）":71,"奴隷市（フキダシ）":72,"薄衣購入フキダシ":73},"extension":"json","dataType":"map","filename":"Map430","basename":"Map430.json","path":"data/Map430.json","relPath":"data/Map430.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":74,"percent":0},"cellInfo":[]},"data/Map431.json":{"data":[["EV001",""],["客1",""],["「稼いだ金はパァーッと使う！\n　それが冒険者ってもんだろ？」\\nw[客]",""],["EV003",""],["窃盗用下着3",""],["<TE:118>",""],["EV005",""],["娼婦",""],["「冒険者の筋肉目当てで娼婦になったんだけど、誰もが\n　マッチョってわけじゃないのよねぇ」\\nw[娼婦]",""],["「冒険者のお客さんは、パタリと来なくなっちゃうことが\n　よくあるのよね。きっと冒険の途中で……」\\nw[娼婦]",""],["ドア",""],["部屋の中でお楽しみ中のようだ。",""],["燭台",""],["下着",""],["客2",""],["光",""],["EV015",""],["娼館従業員",""],["個別依頼26",""],["企画モノ娼婦Ａ",""],["「支配人がね～、今の時代フツーのサービスじゃお客を\n　集められない～って言って、企画物をやるとか\n　言い出したのぉ～」\\nw[娼婦]",""],["「ふむふむ？\n　どんな企画なんだ？」\\nw[\\N[1]]",""],["「\\C[27]『囚われのエルフ姫凌辱！　妊娠するまで中出し\n　　１００連発！　人間チンポで屈辱姫アクメ！』\\C[0]」\\nw[娼婦]",""],["「…………\\I[29]\\I[29]」\\nw[\\N[2]]",""],["「なんであんた、興奮してるのぉ～？\\nw[娼婦]",""],["「…………」\\nw[\\N[2]]",""],["「そんな顔しないでよぉ～。\n　こういうお仕事なんだからさぁ～。\\nw[娼婦]",""],["「それでねぇ～、お姫様役をやる\\C[17]エルフ\\C[0]を店に連れてきて\n　ほしいんだぁ～。\\nw[娼婦]",""],["「エルフと一口に言っても色々だが、どういうのが\n　いいんだ？」\\nw[\\N[1]]",""],["「だからお姫様っぽい娘～。\n　\\C[17]お肌が白く\\C[0]てぇ～、\\C[17]おっぱい大きく\\C[0]てぇ～」\\nw[娼婦]",""],["「おっぱいデカいのがお姫様っぽいかどうかは分からんが、\n　要求は理解した」\\nw[\\N[1]]",""],["「いい娘を連れてきてくれたらぁ、\\C[17]５０００Ｇ\\C[0]と、あと\n　\\C[17]\\in[20]も１個\\C[0]あげちゃうからぁ～」\\nw[娼婦]",""],["個別依頼『企画モノ娼婦Ａ』を受けますか？",""],["受ける",""],["受けない",""],["地の洞窟・地下5層",""],["ハイエルフの隠れ家",""],["個別依頼\\C[17]『企画モノ娼婦Ａ』\\C[0]を受けた！",""],["\\C[17]『\\in[127]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「とりあえずそれっぽいエルフ奴隷を連れてきたぞ。\n　お姫様役が合うかどうかは知らんが」\\nw[\\N[1]]",""],["「わぁ～、キレー！　おっぱいもおっきい～。\n　これならお姫様やれるよぉ～。\\nw[娼婦]",""],["「ありがとぉ～。いいコ見つけて来てくれてぇ～」\\nw[娼婦]",""],["個別依頼\\C[17]『企画モノ娼婦Ａ』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「お姫様っぽいエルフ、ちゃんと見つけてきてねぇ～」\\nw[娼婦]",""],["支配人（エルフEv）",""],["男C（エルフEv）",""],["男A（エルフEv）",""],["\n\\>　　　　　　　　～　娼館の一室にて　～",""],["「常連の皆様、ようこそおいでくださいました！\\nw[支配人]",""],["「本日はスペシャル企画である、\\C[17]エルフ姫の集団凌辱\\C[0]を\n　ぜひともお楽しみください！」\\nw[支配人]",""],["「集団でのプレイは初めてだなぁ。\n　ちょっとドキドキするよ」\\nw[男性客Ａ]",""],["「巨乳エルフの凌辱……考えただけで勃起しちまうぜ！」\\nw[男性客Ｂ]",""],["「ごっこ遊びもたまには新鮮でいいかもな」\\nw[男性客Ｃ]",""],["「くっ……！　薄汚い人間どもめ！\n　その卑猥な目つきでわたしを見るな！」\\nw[奴隷娼婦]",""],["「おおっ、さっそく役に入り込んでるようだね！\n　囚われの身になった高慢ちきなエルフ姫って感じだ！」\\nw[男性客Ａ]",""],["（実は演技じゃないんだよなぁ……。\\nw[支配人]",""],["（このエルフ奴隷、反抗してばかりでちっとも娼婦の仕事を\n　しようとしないし……結局、ぶっつけ本番でのイベント\n　投入になってしまったわけだが……）\\nw[支配人]",""],["「わたしを犯すつもりだろうが、そんなことで誇りある\n　ハイエルフの尊厳まで奪えるなどと思うな！」\\nw[奴隷娼婦]",""],["「これは迫真の演技だ。\n　良いねぇ、なかなか楽しめそうじゃないか」\\nw[男性客Ｃ]",""],["「そ、それでは皆様！\n　虜囚のエルフ姫に肉棒でのおしおきをどうぞ！」\\nw[支配人]",""],["「エ……エルフは……人間なんかに……屈しは……」\\nw[奴隷娼婦]",""],["「まだ姫エルフの演技してるよ。\n　すごい役者魂だ！」\\nw[男性客Ａ]",""],["「このエルフ気に入ったぞ！\n　予約するから、次は新妻役での甘々エッチプレイを\n　頼む！」\\nw[男性客Ｃ]",""],["「オレも予約を入れてくぜ！\n　催眠での言いなりプレイにしてくれ！」\\nw[男性客Ｂ]",""],["「え、ええと、その……」\\nw[支配人]",""],["（いまさらこのエルフは演技もできないヘッポコだとは\n　言えないし、ど、どうしよう……）\\nw[支配人]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『企画モノ娼婦Ａ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[20]１個\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！",""],["男B（エルフEv）",""],["EV025",""],["掲示板マーク",""],["娼館の客（依頼22~25)",""],["依頼を出している場合",""],["依頼フキダシ",""],["娼館支配人（依頼20）",""],["奴隷市（フキダシ）",""],["薄衣購入フキダシ",""]],"context":[["Map431/events/1/name"],["Map431/events/2/name"],["Map431/events/2/pages/0/list/0/message/noPicture/bottom"],["Map431/events/3/name"],["Map431/events/4/name"],["Map431/events/4/note"],["Map431/events/5/name"],["Map431/events/6/name","Map431/events/7/name"],["Map431/events/6/pages/0/list/0/message/noPicture/bottom"],["Map431/events/7/pages/0/list/8/message/noPicture/bottom"],["Map431/events/8/name","Map431/events/27/name"],["Map431/events/8/pages/0/list/0/message/noPicture/bottom","Map431/events/27/pages/0/list/0/message/noPicture/bottom"],["Map431/events/9/name","Map431/events/12/name","Map431/events/17/name","Map431/events/19/name"],["Map431/events/10/name"],["Map431/events/11/name"],["Map431/events/13/name","Map431/events/14/name","Map431/events/18/name"],["Map431/events/15/name"],["Map431/events/16/name"],["Map431/events/20/name"],["Map431/events/20/pages/0/list/0/comment"],["Map431/events/20/pages/0/list/4/message/noPicture/bottom"],["Map431/events/20/pages/0/list/21/message/noPicture/bottom"],["Map431/events/20/pages/0/list/25/message/noPicture/bottom"],["Map431/events/20/pages/0/list/34/message/noPicture/bottom"],["Map431/events/20/pages/0/list/38/message/noPicture/bottom"],["Map431/events/20/pages/0/list/46/message/noPicture/bottom"],["Map431/events/20/pages/0/list/50/message/noPicture/bottom"],["Map431/events/20/pages/0/list/55/message/noPicture/bottom"],["Map431/events/20/pages/0/list/60/message/noPicture/bottom"],["Map431/events/20/pages/0/list/64/message/noPicture/bottom"],["Map431/events/20/pages/0/list/68/message/noPicture/bottom"],["Map431/events/20/pages/0/list/72/message/noPicture/bottom"],["Map431/events/20/pages/0/list/75/message/noPicture/bottom"],["Map431/events/20/pages/0/list/