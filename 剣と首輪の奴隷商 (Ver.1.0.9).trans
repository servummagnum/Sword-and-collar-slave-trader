rIndex":8,"headerParam":["",0,0,1]}],[{"headerIndex":14,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":14,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":28,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],null,[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":70,"headerParam":["",0,0,2]}],[{"headerIndex":78,"headerParam":["",0,0,2]}],[{"headerIndex":98,"headerParam":["",0,0,2]}],[{"headerIndex":105,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"燭台":1,"光":2,"バルコルド":3,"メイド":4,"敵索敵スタート":5,"PSS start":6,"エルラ邸１階":7,"PSS stop":8,"フキダシ1":9,"汚れ":10,"使用人":11,"<PsensorS:\\V[1166] Td1 SwA Rv\\S[22]>":12,"探索範囲にプレイヤー侵入":13,"プレイヤー捕捉":14,"「な、なんだお前は！？\n　どこから入ってきた！？」\\nw[使用人]":15,"「まずい、見つかった！　撤退だっ！」\\nw[\\N[1]]":16,"屋敷への潜入に失敗してしまった……。\nもう一度、\\C[17]再チャレンジ\\C[0]しよう！":17,"EV023":18,"玄関口":19,"正面玄関は閉まっている。":20,"気を引くEv":21,"清掃してる使用人Evへ":22,"バルコルド発見Evへ":23,"「あー！　くそっ！\n　なんて頑固な汚れだ！　全然落ちない！」\\nw[使用人]":24,"「おいおい、あんなところで熱心に掃除されてちゃ、\n　二階に上がれないぞ」\\nw[\\N[1]]":25,"「すぐには動きそうにないですね」\\nw[\\N[2]]":26,"「執事野郎といい、邪魔くさいヤツラだ。\\nw[\\N[1]]":27,"「なんとか\\C[17]あの使用人の気を逸らして\\C[0]、その隙に二階へ\n　上がれないものか」\\nw[\\N[1]]":28,"\\>　　※　使用人の気を逸らせるのに役立ちそうな　※\n\\>　　※　\\C[17]アイテム\\C[0]を探そう！　　　　　　　　　　※\\<":29,"「二階へ行くのは後回しにして、先に一階の他の\n　部屋を見て回るか？」\\nw[\\N[1]]":30,"「そうした方がいいかもしれませんね」\\nw[\\N[2]]":31,"「待て、曲がり角の先から話し声がするぞ。\\nw[\\N[1]]":32,"「くそっ、執事野郎がいるみたいだ！」\\nw[\\N[1]]":33,"「もしあの人に見つかったら、問答無用で戦闘に\n　なっちゃうかも」\\nw[\\N[2]]":34,"「そんな騒ぎを起こすわけにはいかん。\n　仕方ない、この先へ行くのはあきらめよう」\\nw[\\N[1]]":35,"「でも階段の方にも人がいるし……これじゃ\n　どこにも行けませんよ？」\\nw[\\N[2]]":36,"「なんとか\\C[17]階段前の使用人の気を逸らして\\C[0]、その隙に二階へ\n　上がれないものか」\\nw[\\N[1]]":37,"「それじゃあ別の場所へ行ってみましょうか」\\nw[\\N[2]]":38,"バルコルド除け":39,"「この先へ行くのはダメだな。\n　なんとか\\C[17]階段前の使用人の気を逸らして\\C[0]、その隙に二階へ\n　上がれないものか……」\\nw[\\N[1]]":40,"\\>　　※　使用人の気を逸らせるのに役立ちそうな　※\n\\>　　※　\\C[17]アイテム\\C[0]を、この近くで探そう！　　　　※\\<":41,"\\N[4]に見つかるわけにはいかない。\nこの先へは行かないでおこう。":42,"廊下にメイドがいる。\nこの先へは行かないでおこう。":43,"「この先へ行くのはダメだな。\n　なんとか\\C[17]階段前の使用人の気を逸らして\\C[0]、その隙に二階へ\n　上がれないものか」\\nw[\\N[1]]":44,"本":45,"本で注意を逸らすのは、難しいのではないか……？":46,"花瓶":47,"花瓶を割って大きな音を立てれば、注意を引けそうだが\n\\N[4]まで呼び寄せてしまいそうだ。":48,"ぬいぐるみ":49,"ぬいぐるみの愛らしさに夢中になって、気が逸れたりする\nことは……ないか。":50,"鉢植え":51,"鉢植えでブン殴って気絶させる……のはダメだ。\n近づく途中で絶対に気づかれるだろう。":52,"像1":53,"像を倒せば使用人も驚いてその場を離れるだろうが、\n侵入者がいるとバレてしまうかも。":54,"像2":55,"ワイン":56,"「このワイン瓶を割って、注意を引けば……」\\nw[\\N[2]]":57,"「デカい音なんて立てたら、あの執事野郎まで\n　呼び寄せちまうかもしれん」\\nw[\\N[1]]":58,"「これもダメですか……。\n　じゃあ、他になにか使えそうなものは……」\\nw[\\N[2]]":59,"「いやちょっと待て。\n　このワイン、使えるかもしれないぞ」\\nw[\\N[1]]":60,"「え、どう使うんですか？」\\nw[\\N[2]]":61,"「見てりゃ分かるさ。\n　とりあえず玄関ホールに戻るぞ」\\nw[\\N[1]]":62,"アイテム\\C[17]『ワイン瓶』\\C[0]を入手した！":63,"ワイン使用Ev":64,"「持ってきたワインを、そーっとここに垂らして……」\\nw[\\N[1]]":65,"「えぇ……なにを……？」\\nw[\\N[2]]":66,"「よし、隠れるぞ」\\nw[\\N[1]]":67,"「なっ、なんだ！？　像のあの染みは？！\n　いつの間に……！\\nw[使用人]":68,"「こんな目立つところが汚れてたら、職務怠慢だって\n　怒られちゃうじゃないか！」\\nw[使用人]":69,"「早く消さないと！　くっそぉー！！」\\nw[使用人]":70,"「うまくいったな。\n　この隙に階段まで行くぞ！」\\nw[\\N[1]]":71,"「はい！」\\nw[\\N[2]]":72,"ワイン使用Ev矢印":73,"使用人（移動後）":74,"<PsensorF:\\V[1166] Td1 SwA Rv\\S[22]>":75,"EV043":76,"EV044":77,"EV045":78,"EV046":79},"extension":"json","dataType":"map","filename":"Map345","basename":"Map345.json","path":"data/Map345.json","relPath":"data/Map345.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":80,"percent":0},"cellInfo":[]},"data/Map346.json":{"data":[["EV001",""],["燭台",""],["光",""],["敵索敵スタート",""],["エルラ邸２階",""],["鍵",""],["アイテム\\C[17]『\\in[69]』\\C[0]を拾った。",""],["移動可能椅子1",""],["移動後椅子1",""],["移動可能椅子2",""],["移動後椅子2",""],["移動可能椅子3",""],["移動可能椅子4",""],["移動可能椅子5",""],["移動可能椅子6",""],["移動可能椅子7",""],["EV023",""],["EV024",""],["宝箱（装飾品正面開き）",""],["<TE:7>",""],["ドア（エルラ部屋）",""],["\\C[17]『\\in[69]』\\C[0]を使ってドアを開けた。",""],["鍵がかっていて開かない。",""],["二階Ev",""],["「２階はずいぶんと散らかっていますね」\\nw[\\N[2]]",""],["「まだ引っ越し作業が終わっていないようだな。\\nw[\\N[1]]",""],["「さすが成金商人。\n　引っ越しの荷物も多いと見えるぜ」\\nw[\\N[1]]",""],["引っ越し業者2",""],["「奥の部屋は優先して荷解きと整理を終わらせてるから、\n　放っておいて大丈夫だ。\n　……っていうか、近づかないようにしろ。\\nw[引っ越し業者]",""],["「あの口うるさいお嬢様の部屋だから、下手に入ったり\n　すると即刻クビにされるかもしれないぜ？」\\nw[引っ越し業者]",""],["移動可能木箱",""],["木箱から何か落ちた。",""],["引っ越し業者1",""],["「\\C[17]木箱\\C[0]を隣の部屋へ運んでくれ」\\nw[引っ越し業者]",""],["「やれやれ。\n　荷物が多すぎて、梱包を解くだけでもひと仕事だよ」\\nw[引っ越し業者]",""],["引っ越し業者Ev",""],["「なんだ、あんたら？\n　屋敷の使用人……じゃないよな？」\\nw[引っ越し業者]",""],["「えっ、えっと、わたしたちは――」\\nw[\\N[2]]",""],["「ああ、もしかして頼んでおいた引っ越しの\n　アルバイトか？」\\nw[引っ越し業者]",""],["「そ、そうだ！　その通り！\n　ここで仕事を手伝えって言われて来たんだ！」\\nw[\\N[1]]",""],["「そいつは助かった。\n　見ての通り片付けなきゃならない荷物が山積みでな。\\nw[引っ越し業者]",""],["「それじゃあ、まずそこにある\\C[17]木箱\\C[0]を隣の部屋まで\n　運んでくれ」\\nw[引っ越し業者]",""],["「りょ、了解しましたぁ～」\\nw[\\N[2]]",""],["引っ越し業者3",""],["「やべぇ……預かってた部屋の合鍵、どっかに落とし\n　ちまった……」\\nw[引っ越し業者]",""],["木箱マーク1",""],["木箱マーク2",""],["エルラ部屋入室Ev",""],["「ここが\\N[3]の部屋なのかな……？\n　うわぁ～、すごいなぁ～」\\nw[\\N[2]]",""],["「感心してる場合じゃないぞ。\n　早いところ、メスガキの弱味を探すんだ」\\nw[\\N[1]]",""],["「そう言われても、いったいどこをどう探せば？」\\nw[\\N[2]]",""],["「怪しそうなところを手当たり次第に調べるぞ。\n　例えば、ああいうタンスや戸棚とか」\\nw[\\N[1]]",""],["エルラ部屋マーク1",""],["定規",""],["定規（アイテム）",""],["アイテム\\C[17]『\\in[70]』\\C[0]を拾った。",""],["エルラ部屋漁りEv（調査箇所1）",""],["戸棚を調べますか？",""],["調べる",""],["やめておく",""],["「ん……あれ？　開かないぞ？\n　中でなにか引っかかってるのか？」\\nw[\\N[1]]",""],["「さっき拾った\\C[17]定規\\C[0]を、棚の隙間に入れて動かして\n　みたらどうですか？」\\nw[\\N[2]]",""],["「おっ、そうだな。どれどれ……」\\nw[\\N[1]]",""],["「よしっ、引っかかりが外れたぞ！\n　それじゃ開けてみるか。何が入ってるかな」\\nw[\\N[1]]",""],["「……別に変わったものはありませんね。\n　リボン、櫛、手鏡、ブローチ……」\\nw[\\N[2]]",""],["「いや、よく見ろ。ここに手帳があるぞ。\n　中身は……どれどれ――」\\nw[\\N[1]]",""],["「なんだこりゃ！？」\\nw[\\N[1]]",""],["「なんです？\n　何が書かれてるんですか？」\\nw[\\N[2]]",""],["「いやはや、こいつは驚いたぜ。\n　まさか――」\\nw[\\N[1]]",""],["FocusCamera 35 15 120",""],["\\{「いつまでやってるのよ！？\n　まだ片付かないの！！」\\}\\nw[\\N[3]]",""],["「ただいま全力で作業してますので、もうしばらく……」\\nw[引っ越し業者]",""],["\\{「フンッ！　まったく使えない業者ね！」\\}\\nw[\\N[3]]",""],["ResetFocus 120",""],["「あのヒステリックな大声はメスガキだな。\n　この部屋に来るつもりか？」\\nw[\\N[1]]",""],["「ま、まずいですよ！\n　このままじゃ見つかっちゃいます！」\\nw[\\N[2]]",""],["「仕方ない。\n　そこのクローゼットに隠れるぞ」\\nw[\\N[1]]",""],["「まったく……ほんとイライラするわね！\\nw[\\N[3]]",""],["鉤爪捜索で顔を合わせている場合",""],["「それもこれも、全部\\N[2]とフード野郎のせいよ！\\nw[\\N[3]]",""],["「あいつら、今度会ったら再起不能にしてやる\n　んだからッ！！」\\nw[\\N[3]]",""],["まだ鉤爪捜索で顔を合わせていない場合",""],["「ああっ、もう！\n　この溜まりに溜まったストレスを解消するには……\n　やっぱりアレね」\\nw[\\N[3]]",""],["ここからエルラＨシーン\n↓　　↓　　↓",""],["↑　　↑　　↑\nここまでエルラＨシーン",""],["「あぁ……きもちよかったぁ\\I[29]\\nw[\\N[3]]",""],["「やっぱりストレス解消はこれが一番ね\\I[29]」\\nw[\\N[3]]",""],["「そういえばこの後、貴族のパーティーに行く予定が\n　あったけ！」\\nw[\\N[3]]",""],["「ボンボンどものご機嫌取りして、ウチに投資させなきゃ！\n　遅れたら大変だわ！」\\nw[\\N[3]]",""],["「そうだ、日記帳！\\nw[\\N[3]]",""],["「……まっ、記録するのは後でいいか。\n　今は急がなきゃだし」\\nw[\\N[3]]",""],["「ふぅ～、見つからずに済みましたね。\n　よかったぁ～。\\nw[\\N[2]]",""],["「でも\\N[3]の、あんなコトしてる現場に遭遇しちゃう\n　なんて……\\I[29]」\\nw[\\N[2]]",""],["「でも\\N[3]の、あ、あんなコトしてる現場に遭遇しちゃう\n　なんて……」\\nw[\\N[2]]",""],["「なかなかのオナニーっぷりだったな。\n　性根は腐り果ててるが、体はなかなかのモンじゃないか」\\nw[\\N[1]]",""],["「はいはい、貧相な胸ですみませんね……」\\nw[\\N[2]]",""],["「誰もそんなこと言ってないだろう。\n　すねるなよ」\\nw[\\N[1]]",""],["「あっ、そうだ。\n　\\N[3]が日記帳とか言ってましたけど、もしかして\n　その手帳が？\\nw[\\N[2]]",""],["「何か重要なことでも書かれているんですか？」\\nw[\\N[2]]",""],["「実に面白い記録だ。\n　ほれ、自分の目で確かめてみろ」\\nw[\\N[1]]",""],["『○月△日\n　今日はクリトリスを中心に弄った。\n　いままでで一番たくさん潮が出たかもしれない』",""],["『○月Ｘ日\n　おまんことアナルをダブルで弄った。\n　お尻に指を挿れるのは、やっぱりまだ怖いわ』",""],["「えっ、これ……うわぁ……\\I[29]」\\nw[\\N[2]]",""],["「なっ、なっ……なんですかこれぇ？！」\\nw[\\N[2]]",""],["「あのメスガキ、自分のオナニーを記録してるんだよ。\n　さしずめ\\C[27]『オナニー日記』\\C[0]だな」\\nw[\\N[1]]",""],["「\\N[3]ったら、ほんとにエッチなんだから\\I[29]\n　わたしも真似してみようかな\\I[29]」\\nw[\\N[2]]",""],["「えぇ～？！」\\nw[\\N[2]]",""],["「ご丁寧に自筆の署名まで入っていやがる。\n　これなら脅迫の材料として十分だ」\\nw[\\N[1]]",""],["アイテム\\C[17]『\\in[71]』\\C[0]を入手した！",""],["「これで目的は達した。ずらかるぞ！」\\nw[\\N[1]]",""],["\\>　※　依頼者のところへ\\C[17]『オナニー日記』\\C[0]を届けて　※\n\\>　※　報告しよう！　　　　　　　　　　　　　　　※\\<",""],["「揺すってみたらどうです？」\\nw[\\N[2]]",""],["「うーん……ダメっぽいな。\\nw[\\N[1]]",""],["「ここに隙間があるから、なにか\\C[17]長くて平べったい物\\C[0]でも\n　あれば、差し込んで中の邪魔なものを動かせそうだが……」\\nw[\\N[1]]",""],["エルラ",""],["業者（エルラと会話）",""],["エルラ部屋マーク2",""],["エルラ部屋マーク3",""],["調査箇所2",""],["タンスを調べますか？",""],["「おい見ろ！\n　バカみたいに布面積が少ない水着があるぞ！」\\nw[\\N[1]]",""],["「\\N[3]ったら、こんな大胆な水着を……\\I[29]」\\nw[\\N[2]]",""],["「なにを見つけてるんですか！？\n　真面目にやってくださいよ！」\\nw[\\N[2]]",""],["「この水着以外、特に目につくものはないか。\n　ここはハズレだな。\\nw[\\N[1]]",""],["「……………………。\\nw[\\N[1]]",""],["「よしっ、行きがけの駄賃だ。\n　この水着はいただいておこう！」\\nw[\\N[1]]",""],["アイテム\\C[17]『\\in[55]』\\C[0]をこっそり盗んだ！",""],["ここには特に見るべきものは無い。",""],["「なにやってるんですか！？　もうっ！」\\nw[\\N[2]]",""],["調査箇所3",""],["キャビネットを調べますか？",""],["「おっ、こんなところに\\C[17]精霊石\\C[0]が。\n　よしよし、俺が有意義に使ってやろう」\\nw[\\N[1]]",""],["「あからさまな窃盗じゃないですか」\\nw[\\N[2]]",""],["「いいんだよ。\n　メスガキから受けた精神的苦痛に対する慰謝料だ」\\nw[\\N[1]]",""],["アイテム\\C[17]『\\in[46]』\\C[0]を入手した。",""],["「精霊石の他は……大したものありませんね。\n　ここは空振りみたいです」\\nw[\\N[2]]",""],["バルコルド（後日談Ev）",""],["「あーっ！　もうっ！\n　ムカつく！　ムカつくぅーッ！！\\nw[\\N[3]]",""],["「あんな貧乏商人に脅されて、巻き上げた権利証を\n　返すハメになるなんてぇーッ！！」\\nw[\\N[3]]",""],["「お嬢様、そうまでして取り返したあの手帳とは\n　一体どのような……？」\\nw[\\N[4]]",""],["「えっ！？　そ、それは……\\nw[\\N[3]]",""],["「別になんでもないわよ！\n　ただのスケジュール帳だから！」\\nw[\\N[3]]",""],["「そ、そうなのですか？\\nw[\\N[4]]",""],["「では、私はこれで失礼いたします」\\nw[\\N[4]]",""],["「これ、やっぱり中身は見られちゃったわよね？\\nw[\\N[3]]",""],["「たかが貧乏行商人ひとりに知られたからって、あたしは\n　全然気にしないけど……。\\nw[\\N[3]]",""],["「でも、どこまで読まれたんだろ？　全部かしら？」\\nw[\\N[3]]",""],["「ちょっ、なにこれ！？\n　ページがひっついて、ガビガビになってるじゃない！\n　変な匂いもするし！\\nw[\\N[3]]",""],["「あの行商人！　あたしの日記帳になにしたのよぉッ？！」\\nw[\\N[3]]",""],["個別依頼『正義の脅迫』の達成報酬として\\C[17]\\in[50]\\C[0]を\n入手した！",""],["\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！\n\\N[2]の発情度が\\C[17]「７」\\C[0]上がった！",""],["窃盗用下着4",""],["<TE:119>",""]],"context":[["Map346/events/1/name"],["Map346/events/2/name","Map346/events/4/name","Map346/events/8/name","Map346/events/18/name","Map346/events/20/name","Map346/events/26/name"],["Map346/events/3/name","Map346/events/5/name","Map346/events/9/name","Map346/events/19/name","Map346/events/21/name","Map346/events/27/name"],["Map346/events/6/name"],["Map346/events/6/pages/0/list/6/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map346/events/7/name"],["Map346/events/7/pages/0/list/4/message/noPicture/bottom"],["Map346/events/10/name"],["Map346/events/11/name"],["Map346/events/12/name"],["Map346/events/13/name","Map346/events/32/name"],["Map346/events/14/name"],["Map346/events/15/name"],["Map346/events/16/name"],["Map346/events/17/name"],["Map346/events/22/name"],["Map346/events/23/name"],["Map346/events/24/name"],["Map346/events/25/name"],["Map346/events/25/note"],["Map346/events/28/name"],["Map346/events/28/pages/0/list/6/message/noPicture/bottom"],["Map346/events/28/pages/0/list/22/message/noPicture/bottom"],["Map346/events/29/name"],["Map346/events/29/pages/0/list/14/message/noPicture/bottom"],["Map346/events/29/pages/0/list/18/message/noPicture/bottom"],["Map346/events/29/pages/0/list/21/message/noPicture/bottom"],["Map346/events/30/name"],["Map346/events/30/pages/0/list/0/message/noPicture/bottom"],["Map346/events/30/pages/0/list/4/message/noPicture/bottom"],["Map346/events/31/name"],["Map346/events/31/pages/1/list/13/message/noPicture/bottom"],["Map346/events/33/name"],["Map346/events/33/pages/0/list/1/message/noPicture/bottom"],["Map346/events/33/pages/0/list/5/message/noPicture/bottom"],["Map346/events/34/name"],["Map346/events/34/pages/0/list/6/message/noPicture/bottom"],["Map346/events/34/pages/0/list/23/message/noPicture/bottom"],["Map346/events/34/pages/0/list/27/message/noPicture/bottom"],["Map346/events/34/pages/0/list