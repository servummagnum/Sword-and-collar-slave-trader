{"headerIndex":110,"headerParam":["敗北（ユマ凌辱）"]}],[{"headerIndex":112,"headerParam":["",0,0,2]}],[{"headerIndex":135,"headerParam":["",0,0,2]}],[{"headerIndex":137,"headerParam":["",0,0,2]}],[{"headerIndex":141,"headerParam":["",0,0,2]}],[{"headerIndex":144,"headerParam":["",0,0,2]}],[{"headerIndex":160,"headerParam":["",0,0,2]}],[{"headerIndex":162,"headerParam":["",0,0,2]}],[{"headerIndex":171,"headerParam":["",0,0,2]}],[{"headerIndex":173,"headerParam":["",0,0,2]}],[{"headerIndex":180,"headerParam":["↓SEループのコモンEv開始"]}],[{"headerIndex":188,"headerParam":["",0,0,2]}],[{"headerIndex":190,"headerParam":["",0,0,2]}],[{"headerIndex":193,"headerParam":["",0,0,2]}],[{"headerIndex":195,"headerParam":["",0,0,2]}],[{"headerIndex":203,"headerParam":["",0,0,2]}],[{"headerIndex":205,"headerParam":["",0,0,2]}],[{"headerIndex":208,"headerParam":["",0,0,2]}],[{"headerIndex":211,"headerParam":["",0,0,2]}],[{"headerIndex":216,"headerParam":["↓SEループのコモンEv停止"]}],[{"headerIndex":230,"headerParam":["",0,0,2]}],[{"headerIndex":237,"headerParam":["",0,0,2]}],[{"headerIndex":242,"headerParam":["",0,0,2]}],[{"headerIndex":245,"headerParam":["全消去"]}],[{"headerIndex":255,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["現金を賭けての勝負（繰り返し）"]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],null,[{"headerIndex":12,"headerParam":["現金がある"]}],[{"headerIndex":15,"headerParam":["現金なし"]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["勝利（賭け金ゲット）"]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["敗北（賭け金没収）"]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":2,"headerParam":["依頼を出している場合"]},{"headerIndex":11,"headerParam":["依頼を出している場合"]},{"headerIndex":20,"headerParam":["依頼を出している場合"]},{"headerIndex":29,"headerParam":["依頼を出している場合"]}]],"indexIds":{"EV001":0,"EV002":1,"火":2,"光":3,"宿屋の主人":4,"料理1":5,"漁師":6,"「今まで獲った中で一番大きいマグロは、この宿くらい\n　あったな。\n　本当だぜ？」\\nw[漁師]":7,"「この人の言うこと信じちゃダメよ。\n　ホラ吹き男なんだから」\\nw[女性]":8,"ギャンブラー":9,"特定アイテムを賭けての勝負\n↓　　↓　　↓":10,"「デュエルしようぜ！　奴隷カードでの勝負だよ！\n　あんたが勝ったら\\C[17]装飾品\\C[0]をプレゼントだ！\\nw[ギャンブラー]":11,"「でもオレが勝ったら、そこの奴隷娘に\\C[27]おしゃぶり\\C[0]して\n　もらうからね！」\\nw[ギャンブラー]":12,"勝負を受ける":13,"やめておく":14,"奴隷カードの説明":15,"PNDK_LC getSurplusWeights 15":16,"↓積載重量空きOK":17,"賞品の重量が\\C[18]\\v[17]Ｗ\\C[0]オーバーしてしまうため、勝負を\n受けられません。\n積載重量に余裕を作ってください。":18,"「よしっ、勝負だ！！」\\nw[ギャンブラー]":19,"勝利（戦利品ゲット）":20,"「負けたぁ！　くやしいっ！\n　しょうがない、こいつは持っていきな！」\\nw[ギャンブラー]":21,"Lv1~4":22,"装飾品\\C[17]『\\an[212]』\\C[0]を手に入れた！":23,"Lv5~7":24,"装飾品\\C[17]『\\an[220]』\\C[0]を手に入れた！":25,"Lv8~10":26,"装飾品\\C[17]『\\an[230]』\\C[0]を手に入れた！":27,"Lv11~13":28,"装飾品\\C[17]『\\an[241]』\\C[0]を手に入れた！":29,"Lv14~16":30,"装飾品\\C[17]『\\an[251]』\\C[0]を手に入れた！":31,"Lv17以上":32,"装飾品\\C[17]『\\an[255]』\\C[0]を手に入れた！":33,"引き分け":34,"「引き分けかぁ！\n　お互い残念だったね！」\\nw[ギャンブラー]":35,"敗北（ユマ凌辱）":36,"「大・勝・利！\n　それじゃオレのをしゃぶってもらおうかな！」\\nw[ギャンブラー]":37,"「わたし、おしゃぶりは上手なんですよ\\I[29]」\\nw[\\N[2]]":38,"「それは期待大だなぁ！　では――」\\nw[ギャンブラー]":39,"「ほ、ほんとに、その、アレを口でやらなきゃダメ\n　なんですか……？」\\nw[\\N[2]]":40,"「そういう賭けだったからね、仕方ないね。\n　それでは――」\\nw[ギャンブラー]":41,"「はむっ……んぢゅっ……\\I[29]」\\nw[\\N[2]]":42,"「いいね、いいね。\n　咥えさせただけでもエロい口だって分かるよ！」\\nw[ギャンブラー]":43,"「んぶっ？！　ん゛んんっ……！！」\\nw[\\N[2]]":44,"「ダメだよ、そんなイヤそうな顔しちゃ。\n　ほら舌を使って！」\\nw[ギャンブラー]":45,"↓SEループのコモンEv開始":46,"「びちゃっ\\I[29]　ぢゅるっ\\I[29]　ぬちゅるっ\\I[29]　ぴちゃ\\I[29]」\\nw[\\N[2]]":47,"「舌の動き、いやらっしぃー！！\n　マジでプロ並みかそれ以上だよ、コレは！」\\nw[ギャンブラー]":48,"「ちゅるるっ\\I[29]　ぴちゃっ\\I[29]　ぬちゅるっ\\I[29]」\\nw[\\N[2]]":49,"「あっー！　これ無理！　すぐ出ちゃうわー！\n　ってか、もう出すよ！」\\nw[ギャンブラー]":50,"「ちゅっ……ちゅる……くちゅ……」\\nw[\\N[2]]":51,"「はいはい、もっと元気に舌を動かして！\n　オレが出さないことには終わらないんだからね！」\\nw[ギャンブラー]":52,"「ちゅるっ……くちゅっ、ぢゅるっ、にちゃっ、ちゅぐっ、\n　ぴちゅっ、ちゅうぅ……」\\nw[\\N[2]]":53,"「おぉー……良くなってきた！　その調子！\n　おぅっ、出るよ！　出すよ！」\\nw[ギャンブラー]":54,"↓SEループのコモンEv停止":55,"「んふううぅうううぅぅっ\\I[29]\\I[29]」\\nw[\\N[2]]":56,"「ん゛んっ！　ん゛んんんんんーーっ？！！」\\nw[\\N[2]]":57,"「あぁ～、出るぅ～！\n　飲んで！　ゴクゴクいっちゃって！」\\nw[ギャンブラー]":58,"全消去":59,"\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下が