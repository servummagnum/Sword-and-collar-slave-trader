,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"商業ギルド":2,"ドアは堅く閉ざされている。":3,"EV003":4,"武器防具店":5,"EV004":6,"宿屋":7,"EV005":8,"アクセサリ店":9,"EV006":10,"卸売商会":11,"EV007":12,"聖堂":13,"EV008":14,"魔法具店":15,"EV009":16,"馬車屋":17,"EV010":18,"娼館":19,"EV011":20,"PSS stop":21,"PSS reset C":22,"↓敵の追跡を停止":23,"SmartPath 188 cancel":24,"SmartPath 189 cancel":25,"SmartPath 190 cancel":26,"SmartPath 191 cancel":27,"SmartPath 192 cancel":28,"clear_all_weathers":29,"EV012":30,"EV013":31,"EV014":32,"EV015":33,"EV016":34,"EV017":35,"EV018":36,"EV019":37,"EV020":38,"EV021":39,"EV022":40,"女性":41,"「悪竜が滅びたのは神様のおかげに違いないわ！」\\nw[信心深い女]":42,"「神様に祈ったおかげで、モンスターの襲撃からも生き延び\n　られたわ♪」\\nw[信心深い女]":43,"「辛いことがあったときは、いつもここに来て神様に\n　お祈りするの」\\nw[信心深い女]":44,"炎":45,"男性":46,"「昔、ここが王国の首都だった時期もあったんだよ。\n　チェリア様が女王になったんだから、またここを首都に\n　すればいいのに」\\nw[地元の男]":47,"「このパルフュークがモンスターに襲われるなんて！\n　それにあの赤い竜を見たかい？\n　恐ろしいなんてもんじゃなかったよ！」\\nw[地元の男]":48,"「ここが王国の首都だった時期もあったんだよ。\n　昔の話だけどね」\\nw[地元の男]":49,"「悪竜が死んでも油断はならん。\n　この街の被害のほとんどは、その他のモンスターによる\n　ものだからな」\\nw[元冒険者]":50,"「モンスターの襲撃で久々に剣を取ったが、儂もまだ\n　衰えておらんかったよ」\\nw[元冒険者]":51,"「儂が若い頃は、この辺りにも時々オークが出没して\n　おったよ。最近はとんと見んようになったが」\\nw[元冒険者]":52,"「我が手に合う魔剣さえあれば、街を襲ったモンスター\n　など一捻りだったのだが……」\\nw[冒険者]":53,"「ここの武器屋では、我が手に合う魔剣は置いて\n　いなかった……」\\nw[冒険者]":54,"王国官吏（依頼30）":55,"依頼を出している場合":56,"依頼フキダシ":57,"執事（依頼21）":58,"工事監督官（依頼31）":59,"おっぱいマニア（依頼18）":60,"兵士（擾乱）":61,"「これ以上、火の手を広げるな！」\\nw[兵士]":62,"「俺の火消し魂を見せてやる！」\\nw[兵士]":63,"水桶（擾乱）":64,"モンスター（擾乱）":65,"死体":66,"すでにこと切れている。":67,"依頼掲示板":68,"掲示板マーク":69,"兵士":70,"兵士（追跡）":71,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":72,"通行遮断":73,"馬車":74,"食料品店":75,"研究者（依頼32)":76,"浮気調査（依頼13・14・15）":77,"尾行対象（依頼13・14・15）":78,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":79,"難易度ノーマル用":80,"難易度イージー用（振り向く前に立ち止まる時間が倍）":81,"視界範囲に引っかかったとき":82,"SmartPath 0 14 65":83,"周囲2マス圏内に侵入したとき":84,"尾行に気づいて逃走":85,"浮気相手の元へゴールしたとき":86,"ターゲット表示":87,"浮気相手(依頼11)":88,"障害物":89,"建国王像":90,"『建国王リジェルダの像』と台座に彫ってある。":91,"個別依頼13":92,"実験素体の調達":93,"「私は魔術師として、この身を知識の探求に捧げている。\n　思索と研究こそ、我が本懐なのだ」\\nw[魔術師]":94,"「そいつぁ、勉強熱心なことだな」\\nw[\\N[1]]":95,"「そして研究には様々なものが必要となる。\n　薬品、鉱物、書物……それに実験用の奴隷」\\nw[魔術師]":96,"「実験……どんなエッチな目に遭わされちゃうんだろ？\n　想像しただけで……はぁ～\\I[29]」\\nw[\\N[2]]":97,"「うわぁ……人体実験とか……」\\nw[\\N[2]]":98,"「奴隷商人よ。\n　今度の魔術実験には\\C[17]女の悪魔\\C[0]が素体として必要なのだ。\\nw[魔術師]":99,"「早急に用立てて欲しい。\n　報酬として、私が合成した\\C[17]筋肉増強剤\\C[0]と\\C[17]魔力増強剤\\C[0]を\n　渡そう」\\nw[魔術師]":100,"「女の悪魔奴隷なら、どんなのでもいいのか？」\\nw[\\N[1]]":101,"「\\C[17]平均的な体格\\C[0]が望ましい」\\nw[魔術師]":102,"「なら、巨乳や貧乳は避けた方がいいな」\\nw[\\N[1]]":103,"個別依頼『魔術実験』を受けますか？":104,"受ける":105,"受けない":106,"古代遺跡・転送部屋":107,"悪魔の館":108,"個別依頼\\C[17]『魔術実験』\\C[0]を受けた！":109,"\\C[17]『\\in[122]』\\C[0]を依頼者に渡しますか？":110,"渡す":111,"渡さない":112,"依頼条件達成":113,"「ご注文の悪魔奴隷を連れてきたぞ。どうだ？」\\nw[\\N[1]]":114,"「うむ、問題なさそうだ。\n　実験素体としては十分だな。\\nw[魔術師]":115,"「世話になったな、奴隷商人」\\nw[魔術師]":116,"個別依頼\\C[17]『魔術実験』\\C[0]を達成した！":117,"\nここでエッチイベント\n↓　　↓　　↓":118,"↓プレーヤー位置強制中央":119,"SFC_ENABLE_RESERVE":120,"依頼条件未達成":121,"「女悪魔がこないと実験を始められん。\n　はやく調達してきてくれ」\\nw[魔術師]":122,"依頼マーク":123,"ＢＧＭ変更":124,"夜間用ＢＧＭ演奏":125,"夜→昼":126,"最初から昼":127,"昼→夜":128,"最初から夜":129,"盗賊1":130,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":131,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":132,"「邪魔をするなら殺す！」\\nw[蛮族]":133,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":134,"奴隷化性別：0=女、1=男、2=男女ランダム":135,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":136,"戦闘マーク1":137,"副都擾乱BGM演奏":138,"weather : 1 : 3 : 80 : 50 : 1 : Rain_01B : 1 : 30":139,"weather : 2 : 1 : 30 : 100 : 1 : Light_01C : 1 : 30":140,"アヒル":141,"池の岩":142,"男性市民1（広場）":143,"「チェリア姫が女王になって王都へ行っちゃうとは。\n　戻ってきてほしいなぁ」\\nw[メガネの男]":144,"「チェリア姫をはげましてあげたいけど、ただの庶民に\n　できることなんて無いもんなぁ……」\\nw[メガネの男]":145,"「\\N[5]姫も可愛いけど、やっぱりチェリア姫だろ」\\nw[メガネの男]":146,"男性市民2（広場）":147,"「\\N[5]姫が死んだなんて信じないぞ！\n　きっとどこかで生きてる……と思いたい！」\\nw[猫人の男]":148,"「父親を亡くされて、チェリア姫もさぞ悲しんでる\n　だろうな……」\\nw[猫人の男]":149,"「いやいや、やっぱり\\N[5]姫だろ。\n　チェリア姫も可愛いとは思うけどさ」\\nw[猫人の男]":150,"女性市民1（広場）":151,"「モンスターが暴れたせいで、ウチの外壁はボロボロよ！\n　相手が人間じゃないから賠償請求もできやしないのに！」\\nw[主婦]":152,"「献立を考えるの面倒だから、今日もシチューでいいかしら。\n　もう７日間連続でシチューだけど」\\nw[主婦]":153,"血糊":154,"女性市民3":155,"「チェリア様が女王だなんて、地元の人間として\n　誇らしいわ」\\nw[女性]":156,"「竜とモンスターのせいで、たくさんの人が犠牲に\n　なってしまったわ」\\nw[女性]":157,"「王家の血筋って美人が多いのかしら？\n　パルフューク宮のチェリア様も美しい方なのよ」\\nw[女性]":158,"市民（擾乱）":159,"「ありがとうございます！\n　おかげで命拾いしました！\\nw[メイド]":160,"「なにかお礼を――ああ、でも今は何も持ってなくて、\n　すみません。\\nw[メイド]":161,"「もしまたお会いすることがあれば、必ずお礼をさせて\n　いただきます。それでは」\\nw[メイド]":162,"「なにかお礼を――ああ、でも今は何も持ってなくて……」\\nw[メイド]":163,"「そうだわ！\n　もしよろしければ、この\\C[17]メイド服\\C[0]を受け取ってください」\\nw[メイド]":164,"PNDK_LC getSurplusWeights 15":165,"メイドを助けたお礼として\\C[17]『\\an[\\v[191]]』\\C[0]をもらった！":166,"メイドを助けたお礼として\\C[17]『\\an[\\v[191]]』\\C[0]をもらったが、\n\\C[18]積載可能な重量をオーバー\\C[0]しているため受け取れなかった。":167,"「それではわたしはこれで。\n　本当にありがとうございました」\\nw[メイド]":168,"\\>重量オーバーのため入手できなかった、メイド救助の報酬だ。\n\\>拾いますか？\n\\>（必要とする積載重量の空き：\\C[17]５Ｗ\\C[0]）":169,"拾う":170,"拾わない":171,"\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！":172,"\\C[18]積載可能な重量をオーバー\\C[0]しているため入手できない。":173,"EV129":174,"盗賊":175,"「邪魔をするな！」\\nw[盗賊]":176,"「くそっ……この混乱に乗じて略奪しまくってやる\n　つもりだったのに……」\\nw[盗賊]":177,"「くそっ……盗賊一筋15年のオレがこんなところで……」\\nw[盗賊]":178,"盗賊表示":179,"バリケード":180,"バリケードが組まれている。":181,"「市民は家の中に避難するんだ！」\\nw[兵士]":182,"淫行男2":183,"怪しい男":184,"「………………………………失せろ」\\nw[\\v[1655]]":185,"「テメェ、女を売り歩いてでもいやがるのか？」\\nw[\\v[1655]]":186,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":187,"売春させる":188,"やめておく":189,"淫行表示":190,"街中盗賊出没":191,"スケベじじい（依頼19）":192,"街ズームアウト":193,"P_D_FILENAME name_town\\V[101]":194,"「ここが王国第二の都市パルフュークですか！」\\nw[\\N[2]]":195,"「ああ、別名『副都』。\n　国王の弟であるパルフューク大公が治める街だ」\\nw[\\N[1]]":196,"「その大公様はどこに住んでるんですか？」\\nw[\\N[2]]":197,"「街の北西にあるパルフューク宮だが……俺たちみたいな\n　庶民は当然入れないぞ？」\\nw[\\N[1]]":198,"「や、やだなぁ。わかってますよ。\n　ちょっと聞いてみただけですってば」\\nw[\\N[2]]":199,"EV175":200,"マップ取得":201,"FocusCamera 38 35 120":202,"ZoomOut 3 120":203,"\\C[17]\\V[902]の地図\\C[0]を取得した！":204,"ResetZoom 60":205,"ResetFocus 60":206,"街中イーグルダイブ":207,"ここから飛び降りますか？":208,"飛び降りる":209,"やめる":210,"進入禁止用":211,"EV179":212,"EV180":213,"フクロウ":214,"「ひっ！？　モンスター！？\\nw[男性]":215,"「……じゃないのか。\n　脅かさないでくれよぉ！」\\nw[男性]":216,"「いやあぁぁっ！！\n　来ないで！　来ないでえぇ！！」\\nw[女性]":217,"女性は錯乱している。":218,"「頼むッ、開けてくれぇ！！」\\nw[男性]":219,"民家入り口":220,"民家":221,"民家2入り口":222,"民家3入り口":223,"敵01":224,"<PsensorS:\\V[1166] Rv\\S[22]>":225,"探索範囲にプレイヤー侵入":226,"SmartPath 0 -1":227,"追跡しているプレイヤーと接触":228,"SmartPath 0 cancel":229,"敵に見つかっている場合の戦闘":230,"勝利したとき":231,"PSS t_stop":232,"逃げたとき":233,"戦闘から離脱したときの処理":234,"PSS t_start":235,"敵がプレイヤーを見失ったときの処理":236,"敵02":237,"敵03":238,"敵04":239,"敵05":240,"敵索敵スタート":241,"PSS start":242,"騎士（擾乱会話Ev）":243,"「おいっ、大丈夫か！？」\\nw[\\N[1]]":244,"「うぅ……な、なんとか……。\n　おかげで助かった……」\\nw[騎士]":245,"「アルテトが――赤い竜がここに来ただろう？\n　あいつはどこへ行った？」\\nw[\\N[1]]":246,"「あの恐ろしい竜……ヤツがいきなり街を襲って、直後に\n　モンスターの群れもやってきて……。\\nw[騎士]":247,"「でも赤い竜は消えてしまったんだ」\\nw[騎士]":248,"「消えた！？　どういうことですか？」\\nw[\\N[2]]":249,"「私にも分からんのだ……。\n　ただ、\\C[17]宮殿\\C[0]の上空で光ったかと思うと、跡形もなく\n　姿が消え失せていた」\\nw[騎士]":250,"「宮殿……」\\nw[\\N[1]]":251,"「そ、そうだ……！\n　キミたちを勇士と見込んで頼みたいことがある！」\\nw[騎士]":252,"「な、なんかイヤな予感が……」\\nw[\\N[2]]":253,"「街の\\C[17]北東の隅\\C[0]に\\C[17]涸れ井戸\\C[0]があるんだが、その\n　そばにモンスターがいないか確認してくれないか？\\nw[騎士]":254,"「そしてもしモンスターがいたなら、倒して安全を確保\n　して欲しいのだ」\\nw[騎士]":255,"「どうしてそんなことを？」\\nw[\\N[1]]":256,"「その涸れ井戸は、宮殿から通じている\\C[17]秘密の脱出路\\C[0]の\n　出口なのだ。\\nw[騎士]":257,"「万が一のときに大公様やチェリア様を逃がせるよう、\n　井戸の安全を確保するのが私の任務だったのだが……」\\nw[騎士]":258,"「また秘密の通路か。\n　王族ってやつは、そういうのを作るのが大好きみたいだな。\\nw[\\N[1]]":259,"「まあいいぜ、分かった。\n　あんたの任務、俺たちが引き継いでやるよ」\\nw[\\N[1]]":260,"「か、かたじけない！\n　よろしく頼む、勇士たちよ！」\\nw[騎士]":261,"\\>　　　　※　街の\\C[17]北東の隅\\C[0]にある\\C[17]涸れ井戸\\C[0]から、※\n\\>　　　　※　宮殿の中へ入ろう！　　　　　　　※":262,"「街の\\C[17]北東の隅\\C[0]にある\\C[17]涸れ井戸\\C[0]が、宮殿からの脱出口に\n　なっている。\n　どうかその周辺の安全確保を……」\\nw[騎士]":263,"副都擾乱遭遇Ev":264,"「なんだこの騒ぎは！？」\\nw[\\N[1]]":265,"「街中でモンスターが暴れてる！？」\\nw[\\N[2]]":266,"「そういや伝説じゃ、アルテトはモンスターに命じて\n　人間を襲わせたこともあったらしいな」\\nw[\\N[1]]":267,"「じゃあこれも、アルテトの仕業ってことですか……」\\nw[\\N[2]]":268,"「そのアルテトはどこだ？\n　あの馬鹿デカい図体なら、目立つはずだが」\\nw[\\N[1]]":269,"「上空には見当たりませんから、街の中に降りたんで\n　しょうか？」\\nw[\\N[2]]":270,"「よし、探すぞ。\n　見つけた後のことは、そのとき考える」\\nw[\\N[1]]":271,"モンスター（Ev戦闘）":272,"涸れ井戸":273,"宮殿":274,"井戸マーク":275,"モンスター（Ev戦闘）2":276,"藁山":277,"EV207":278,"屋根通行止め":279,"ユマ（宮殿脱出）":280,"「会話を引き延ばしてるあいだに、兵が駆けつけて\n　くれて助かったぜ」\\nw[\\N[1]]":281,"「でもあの兵隊さんたち、きっと\\N[5]姫に……。\\nw[\\N[2]]":282,"「わたしたち、結局なにも出来ませんでしたね……」\\nw[\\N[2]]":283,"「いや、そうでもないぞ。\n　\\N[5]の正体と目的をつかめただろう。\\nw[\\N[1]]":284,"「これで対策が立てられる……かもしれん」\\nw[\\N[1]]":285,"「かもって……そんな曖昧な……。\n　あの悪竜\\N[6]に有効な対策なんてあるんですか？」\\nw[\\N[2]]":286,"「それはこれから考えるんだよ！」\\nw[\\N[1]]":287,"「\\N[6]が宮殿から飛び立った！？\n　じゃあ、あれが\\N[5]姫の本当の姿……」\\nw[\\N[2]]":288,"「今度こそ王都に戻るみたいだな。\\nw[\\N[1]]":289,"「街中で暴れてたモンスターどもも、討たれるか逃げるか\n　して一段落ついたようだし――。\\nw[\\N[1]]":290,"「副都の騒乱は、ひとまずこれで終わったみたいだな。\\nw[\\N[1]]":291,"「次は王都が同じ目に遭うかもしれんが」\\nw[\\N[1]]":292,"「そんなっ！？　王都には父さんがいるのに！」\\nw[\\N[2]]":293,"「\\N[1]さん！　王都に戻りましょう！」\\nw[\\N[2]]":294,"「ああ、そうしよう。\n　もし王都が無事なら、そこで体勢を立て直すとするか」\\nw[\\N[1]]":295,"メインシナリオ\\C[17]『副都擾乱』\\C[0]を達成した！":296,"\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！":297,"メインシナリオ\\C[17]『\\N[6]対策』\\C[0]を受けた！":298,"\n\\>　※　\\C[17]王都貧民街\\C[0]にいる\\N[2]の父親のところへ戻ろう！　※":299,"門番1":300,"「ここは亡き大公殿下の住まわれていた宮殿だ。\n　用もないのに近づかないように」\\nw[門番兵]":301,"「ここはパルフューク大公殿下のおわす宮殿だ。\n　用もないのに近づかないように」\\nw[門番兵]":302,"門番2":303,"「ここはチェリア姫様のおわす宮殿だ。\n　用もないのに近づかないように」\\nw[門番兵]":304,"宮殿門進入禁止":305,"「勝手に入ってはならん！\n　不審な動きをする者は、ひっ捕らえるぞ！」\\nw[門番兵]":306,"「ここは通用門だ。\n　許可のない者は通せんぞ」\\nw[門番兵]":307,"門番3":308,"男性市民3（宮殿前）":309,"「大公様を反逆者扱いしたヤツらを、俺は絶対に\n　許さねぇ！」\\nw[猫人の男]":310,"「大公様は良い領主だったのに……」\\nw[猫人の男]":311,"「王都の王宮ほど大きくはないけど、\n　このパルフューク宮もなかなかのもんだろ？」\\nw[猫人の男]":312,"女性市民2":313,"「チェリア様、まだお若いのに女王だなんて大丈夫かしら？\n　心配だわ」\\nw[女性]":314,"「大公様とたくさんの兵士たちが死んでしまったわ。\n　これからの街の治安が心配……」\\nw[女性]":315,"「他の街に比べたら、ここは暮らしやすい所だと思うわ」\\nw[女性]":316,"冒険者":317,"「ここと違って、王都での悪竜被害はそれほどでもなかった\n　そうだな」\\nw[冒険者の男]":318,"「先のモンスター襲撃時には、及ばずながら剣を振るった。\n　しかし助けられなかった者も多かったよ」\\nw[冒険者の男]":319,"「この街は平和だが、外へ出ればやはり危険は多いものだ」\\nw[冒険者の男]":320,"子供1":321,"「兵士の人、モンスターと戦ってすごい怪我してた。\n　やっぱオレ、兵士になるのやめようかな……」\\nw[男の子]":322,"「オレ、大きくなったら兵士になるんだ！\n　だってカッコイイだろ！」\\nw[男の子]":323,"子供2":324,"「桶に入れておいた金魚、モンスターに食べられちゃった」\\nw[女の子]":325,"「この桶で金魚を飼おうとしたら、お母さんに怒られたの」\\nw[女の子]":326,"騎士":327,"「私もできればチェリア様とともに王宮へ行きたかったが、\n　こちらの警備もあるので断念したのだ」\\nw[騎士]":328,"「うおおおぉぉッ！！\n　みすみす大公殿下を討たれてしまうとはッ！！\n　私は騎士失格だああぁぁッ！！」\\nw[騎士]":329,"「大公殿下は国王陛下の弟君なのだ。\n　あまり大きな声では言えんが、兄よりもだいぶ\n　優秀な弟でな」\\nw[騎士]":330,"兵士（追跡）2":331,"「副都の治安は俺が守る！」\\nw[兵士]":332,"個別依頼10":333,"姫の身代わり":334,"「邪悪な魔術師からチェリア様を守るため、身代わりと\n　なる女奴隷を用意してもらえないか？」\\nw[騎士]":335,"「貴殿は奴隷商人だと聞いた。\n　そこでひとつ、助力を仰ぎたいのだが」\\nw[騎士]":336,"「騎士様がかしこまって頼み事とは珍しい。\n　厄介事か？」\\nw[\\N[1]]":337,"「うむ。\n　ここだけの話なのだが、実は大公殿下のご息女が\n　邪悪な魔術師に狙われているのだ」\\nw[騎士]":338,"「ご息女って、美人で有名なあのチェリア姫ですか！？」\\nw[\\N[2]]":339,"「そうだ。\n　大公殿下に恨みを持つその魔術師が、チェリア様の\n　誘拐を企んでいるという情報が入ってきたのだ」\\nw[騎士]":340,"「大公はもう死んだっていうのに、執念深いこったな。\n　それで？　その話と俺たちがどう繋がるんだ？」\\nw[\\N[1]]":341,"「なるほど、そいつは大変だな。\n　それで？　その話と俺たちがどう繋がるんだ？」\\nw[\\N[1]]":342,"「魔術師は凄腕なので、警備を厳重にしても防ぎきれぬ\n　かもしれん。\\nw[騎士]":343,"「そこで万が一の事態を考え、チェリア様の身代わりを\n　立てようということになったのだ」\\nw[騎士]":344,"「もしかしてその身代わりを、わたしたちに用意しろと？」\\nw[\\N[2]]":345,"「うむ、その通りだ。\n　チェリア様に容姿の似ている女奴隷を連れてきて\n　欲しい。\\nw[騎士]":346,"「もし協力してくれるなら代金として\\C[17]５０００Ｇ\\C[0]と、\n　それに加えて特製の\\C[17]メイド服\\C[0]を進呈しよう」\\nw[騎士]":347,"「代金はいいとして、なんでメイド服を？」\\nw[\\N[1]]":348,"「それがしの趣味だ！\n　女性に最も似合う服はメイド服である！」\\nw[騎士]":349,"「なんです、その偏った意見は……？」\\nw[\\N[2]]":350,"「あんたの趣味はさておき、話は了解した。\n　さて、どうしたものか……」\\nw[\\N[1]]":351,"個別依頼『姫の身代わり』を受けますか？":352,"氷雪の神殿・東側":353,"風の塔":354,"個別依頼\\C[17]『姫の身代わり』\\C[0]を受けた！":355,"「貴殿らの協力に感謝する！」\\nw[騎士]":356,"「チェリア姫に似た奴隷ということですけど、たしか\n　姫様の容姿は――」\\nw[\\N[2]]":357,"「\\C[17]肌は色白\\C[0]で\\C[17]髪色は白\\C[0]、そして当然ながら\\C[17]種族は人間\\C[0]だ」\\nw[騎士]":358,"「分かった。\n　その条件でなるべくチェリア姫に似た顔の奴隷を\n　探してこよう」\\nw[\\N[1]]":359,"「よろしく頼んだぞ、奴隷商人殿」\\nw[騎士]":360,"\\C[17]『\\in[106]』\\C[0]を依頼者に渡しますか？\n\\C[18]（※注意※　戦闘イベントがあります）\\C[18]":361,"「この奴隷でどうだ？\n　化粧させればチェリア姫っぽく見えると思うんだが」\\nw[\\N[1]]":362,"「ううむ……どうだろうな？\n　似ているといえば似ているが。\\nw[騎士]":363,"「とりあえずチェリア様付きのメイドに頼んで、\n　チェリア様と同じ格好をさせてみるか。\\nw[騎士]":364,"「貴殿らも一緒に来られよ」\\nw[騎士]":365,"「えっ！？\n　一緒にって、パルフューク宮にですか！？」\\nw[\\N[2]]":366,"「それがしが同行していれば問題ない。\n　さあ、ともに参ろう」\\nw[騎士]":367,"「チェリア様と似た、色白で白髪の女奴隷を頼むぞ」\\nw[騎士]":368,"奴隷市":369,"奴隷市（フキダシ）":370,"奴隷市（通行不可）":371,"奴隷1":372,"「お屋敷の家事は大変よ。\n　一日中働きっぱなしで、もうクタクタ」\\nw[女奴隷]":373,"奴隷2":374,"「オレのことを性的な目で見てた女主人が、モンスターに\n　大怪我を負わされちまったんだ。\n　これでしばらく貞操の危機を心配しなくて済むよ」\\nw[奴隷]":375,"「女主人が、いやらしい目でオレのこと見てくるんだ。\n　奴隷の身じゃ逆らえないし、どうしよう……」\\nw[奴隷]":376,"奴隷3":377,"「ひたすら草取り。雑草を引き抜く毎日。\n　頭がおかしくなりそうだよ……」\\nw[奴隷]":378,"売り家表示":379,"自宅入り口":380,"自宅":381,"自宅に引きこもっている場合ではない！":382,"EV242":383,"EV243":384,"物乞い3":385,"\\C[17]※ 注意 ※\\C[0]\nこれ以上、物乞いにお金をあげてもイベントは発生しません。":386,"「善行を積むと思って、この恵まれない女にちょいと\n　ばかり金を恵んでくれないかい？」\\nw[物乞い]":387,"100Ｇ渡す":388,"500Ｇ渡す":389,"1000Ｇ渡す":390,"5000Ｇ渡す":391,"無視する":392,"「恩に着るよ、旦那！」\\nw[物乞い]":393,"景気ランタン":394,"レイプEv発生制御":395,"落ちてる精霊石（街）":396,"依頼01・02戦闘":397,"依頼を引き受けている場合、暴漢と戦闘":398,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":399,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":400,"暴漢と戦闘":401,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":402,"襲ってきた暴漢を街の警備兵に引き渡した。":403,"暴漢":404,"猫":405,"魔術師1（広場）":406,"「伝説の悪竜がいまだ健在だったとは！\n　不謹慎を承知で言わせてもらうと……研究したい！」\\nw[魔術師]":407,"「十数年も前に国外追放になった魔術師が、復讐のために\n　舞い戻ってきたそうだ。\n　ただ、すぐに討伐されたらしいけど」\\nw[魔術師]":408,"「ここ副都は、昔から魔術の研究が盛んな都市なんだ。\n　でも中には禁忌の魔術に手を染める輩もいたりしてね。\n　同じ魔術師として迷惑な話さ」\\nw[魔術師]":409,"レイプ魔":410,"レイプ被害者":411,"レイプマーク":412,"掲示板依頼初期化おばあちゃん":413,"<TE:110>":414,"レイプEv向き合わせ":415,"レイプ現場遭遇":416,"盗賊2":417,"戦闘マーク2":418,"淫行男1":419,"野卑な男":420,"「テメェ、なにガンつけてんだ？\n　やるかコラ！？」\\nw[\\v[1655]]":421,"「股の緩そうな女だなぁ。\n　オレの息子を突っ込んでやろうか？」\\nw[\\v[1655]]":422,"街中淫行制御":423,"淫行男3":424,"挙動不審な男":425,"「んだコラ？\n　オレがどこでなにしようと、勝ってだろうが！」\\nw[\\v[1655]]":426,"「見るからにスケベそうな女だな。\n　で、一発いくらだ？」\\nw[\\v[1655]]":427,"EV272":428,"通行止め":429,"通行不可":430,"四聖教メッセンジャー":431,"<TE:112>":432,"会話マーク(EX)":433,"<TE:113>":434},"extension":"json","dataType":"map","filename":"Map054","basename":"Map054.json","path":"data/Map054.json","relPath":"data/Map054.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":435,"percent":0.45977011494252873},"cellInfo":[]},"data/Map055.json":{"data":[["商人ギルド入り口",""],["商業ギルド",""],["武器屋入り口",""],["武器防具店",""],["宿屋入り口",""],["宿屋",""],["アクセサリ店",""],["魔法具店",""],["卸売商会",""],["聖堂",""],["馬車屋入り口",""],["馬車屋","Stagecoach shop"],["娼館",""],["EV010",""],["EV011",""],["EV012",""],["EV013",""],["EV014",""],["EV015",""],["EV016",""],["EV017",""],["EV018",""],["女性",""],["「日々の祈りこそが、いつの日か救いになるのよ」\\nw[信心深い女]",""],["鳥",""],["男性",""],["「聞いたか！？　悪竜を倒した謎の冒険者の話だよ！\n　すげぇぜ！　伝説の冒険者の再来だ！」\\nw[地元の男]",""],["「この像は伝説の冒険者のものなんだ。\n　圧倒的な強さを誇る怪物を倒した英雄さ」\\nw[地元の男]",""],["淫行男1",""],["悪辣な男",""],["「このまえ借金を返さないクズ男の妻と娘を、目の前で\n　犯してやったのさ。楽しかったぜぇ」\\nw[\\v[1655]]",""],["「お前の連れの女、いい声で鳴きそうだなぁ。\n　目の前で犯してやろうか？」\\nw[\\v[1655]]",""],["\\N[2]をこの男と\\C[27]売春\\C[0]させますか？",""],["売春させる",""],["やめておく",""],["「冒険者ギルドなら、街の南側にあるよ」\\nw[元冒険者]",""],["淫行表示",""],["「モンスターの多い僻地にいくほど、俺たち冒険者の\n　価値は上がるってものさ」\\nw[冒険者]",""],["EV026",""],["依頼フキダシ",""],["工事監督官（依頼31）",""],["依頼を出している場合",""],["執事（依頼21）",""],["研究者（依頼32)",""],["スケベじじい（依頼19）",""],["王国官吏（依頼30）",""],["おっぱいマニア（依頼18）",""],["矢印マーク",""],["街ズームアウト",""],["P_D_FILENAME name_town\\V[101]",""],["「冒険者が集まる町だって聞きましたけど、なんで\n　ここに？\n　冒険がいっぱいありそうには見えませんけど」\\nw[\\N[2]]",""],["「さあな、理由は俺もよく知らん。\n　だが冒険者の仕事の半分以上は、冒険とは無関係の\n　労働だ。\\nw[\\N[1]]",""],["「もしかしたら、王都と南都の中間地点だから仕事を\n　受けやすいってだけかもな」\\nw[\\N[1]]",""],["「夢がありませんねぇ」\\nw[\\N[2]]",""],["落ちてる精霊石（街）",""],["レイプEv発生制御",""],["通行不可",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["馬車",""],["通行遮断",""],["食料品店",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 7 39",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["浮気調査（依頼13・14・15）",""],["浮気相手(依頼11)",""],["「パトロール異常なし！\n　今日も町は平和であります！」\\nw[兵士]",""],["ターゲット表示",""],["個別依頼18",""],["召喚の生贄",""],["「故郷を飛び出して冒険者になったけど、うちのパーティは\n　みんな弱いんで、苦労してばかりなんだ。\\nw[三流冒険者]",""],["「でも挫けないよ！\n　絶対に強くなって、伝説の冒険者のような偉業を\n　成すんだ！」\\nw[三流冒険者]",""],["「頑張り屋さんですね。\n　わたしも応援しますから、良い冒険者になってください」\\nw[\\N[2]]",""],["「ありがとう、猫の人！\n　それじゃあ力を貸して欲しいんだけど」\\nw[三流冒険者]",""],["「どういうことだ？\n　言っておくが、訓練の相手とかなら他の連中を\n　当たってくれよ」\\nw[\\N[1]]",""],["「はははっ、違いますよ！\n　お願いしたいのは、奴隷の調達です。\\nw[三流冒険者]",""],["「邪神召喚を行うための生贄用に、\\C[17]エルフの奴隷\\C[0]を\n　売ってくれませんか？」\\nw[三流冒険者]",""],["「……はい？\n　じゃしん……しょうかん……？」\\nw[\\N[2]]",""],["「そうです！\n　召喚した邪神と取り引きして、一気にズバーンッと\n　強くなるんですよ！」\\nw[三流冒険者]",""],["「なにこの人……？\n　爽やかな顔して、とんでもなく邪悪なこと言い出した\n　んですけど……」\\nw[\\N[2]]",""],["「邪神の好みが分からないんで、とりあえずエルフ奴隷の\n　容姿はノーマルな感じでお願いします。\n　\\C[17]おっぱいの大きさとか普通\\C[0]で。\\nw[三流冒険者]",""],["「あと\\C[17]肌は白い\\C[0]方がいいかな？\n　そっちのほうが生贄っぽいしね！\\nw[三流冒険者]",""],["「ああそれと、召喚には\\C[17]サファイアも一個\\C[0]必要なんだっけ。\n　一緒に持ってきてくれます？」\\nw[三流冒険者]",""],["「いいぜ、払うもんさえ払ってくれればな」\\nw[\\N[1]]",""],["「現金はあまりないんで、報酬はこの前ダンジョンで\n　見つけたこの\\C[17]精霊石5個\\C[0]と\\C[17]怪しい玉\\C[0]でどうでしょう？」\\nw[三流冒険者]",""],["個別依頼『召喚の生贄』を受けますか？",""],["受ける",""],["受けない",""],["大山脈東洞窟・1層",""],["ハイエルフの森",""],["個別依頼\\C[17]『召喚の生贄』\\C[0]を受けた！",""],["\\C[17]『\\in[126]』\\C[0]と\\C[17]『\\in[305]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「エルフ奴隷を連れてきたぞ。\n　それとサファイアもだ」\\nw[\\N[1]]",""],["「どうもありがとう！\n　これで邪神召喚ができます！」\\nw[三流冒険者]",""],["\\}「ちょっと\\N[1]さん！　いいんですか！？\n　邪神召喚の手伝いなんかしちゃって」\\{\\nw[\\N[2]]",""],["\\}「大丈夫だって。邪神なんて本当に呼び出せるかよ。\n　どうせ『ごっこ遊び』をやってお終いだ」\\{\\nw[\\N[1]]",""],["「どうかしましたか？」\\nw[三流冒険者]",""],["「いやいや、こっちの話だ。\n　それじゃあ、邪神の召喚がんばってくれな！」\\nw[\\N[1]]",""],["「はいっ、ありがとうございました！」\\nw[三流冒険者]",""],["個別依頼\\C[17]『召喚の生贄』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「邪神を召喚して絶対に強くなるんだ！\n　そのための生贄と宝石、お願いしますね」\\nw[三流冒険者]",""],["冒険者ギルド",""],["奴隷市",""],["奴隷市（フキダシ）",""],["奴隷市（通行不可）",""],["犬",""],["亀",""],["冒険者1",""],["「悪竜を倒した冒険者の話を聞いてたらやる気が出て\n　きたぜ！　オレだっていつかきっと有名になってやる！」\\nw[若い冒険者]",""],["「姉ちゃんの反対を押し切って冒険者になった手前、\n　なにかデッカイ手柄を立てて見返してやらないと！」\\nw[若い冒険者]",""],["女性1",""],["「この町は沼地が近いせいで、カエルやヘビがよく出るのよ。\n　もう慣れちゃったけど」\\nw[主婦]",""],["女性2",""],["「冒険者の町なんて言われてるけど、ならず者の町の\n　間違いじゃないかしら？」\\nw[主婦]",""],["冒険者2",""],["「やんのかコラ！\n　相手になってやるぞ！」\\nw[冒険者]",""],["冒険者3",""],["「上等だコラ！\n　かかってこいやッ！」\\nw[冒険者]",""],["冒険者4",""],["「名もなき伝説の冒険者がこうして語り継がれているように、\n　悪竜退治の英雄も伝説になるんだろうね」\\nw[冒険者]",""],["「この町に冒険者が集まるようになったのは、\n　やはりその像の男――伝説の冒険者のせいだろうね。\\nw[冒険者]",""],["「その功績にあやかろうと人が集まってきて、\n　とうとう冒険者ギルドまで作っちまったのさ」\\nw[冒険者]",""],["学者",""],["「この辺りは、水棲動物や昆虫の生息地として\n　貴重なのだよ」\\nw[学者]",""],["男の子1",""],["「おじゃまたくし！　おじゃまたくしがいるよ！」\\nw[男の子]",""],["奴隷1",""],["「奴隷になったときはどうしようかと思ったけど、\n　家事をやってれば普通にゴハンが食べられるから\n　よかったわ」\\nw[女奴隷]",""],["民家",""],["売り家表示",""],["EV092",""],["自宅入り口",""],["自宅","Player home"],["EV094",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["戦闘マーク1",""],["景気ランタン",""],["EV101",""],["台座に『伝説の冒険者』と彫られている。",""],["依頼01・02戦闘",""],["依頼を引き受けている場合、暴漢と戦闘",""],["「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]",""],["\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]",""],["暴漢と戦闘",""],["「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]",""],["襲ってきた暴漢を街の警備兵に引き渡した。",""],["暴漢",""],["アヒル",""],["レイプ魔",""],["レイプ被害者",""],["レイプマーク",""],["レイプEv向き合わせ",""],["掲示板依頼初期化おばあちゃん",""],["<TE:110>",""],["レイプ現場遭遇",""],["街中盗賊出没",""],["欲深な男",""],["「悪事ってぇのは金になる。その気さえありゃな」\\nw[\\v[1655]]",""],["「金があればよぉ、女だって自由に抱ける！\n　お前のその女も買ってやろうか？」\\nw[\\v[1655]]",""],["街中淫行制御",""],["通行不可スイッチ",""],["フクロウ",""],["マップ取得",""],["FocusCamera 31 19 120",""],["ZoomOut 2.8 120",""],["\\C[17]\\V[907]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["藁山",""],["四聖教メッセンジャー",""],["<TE:112>",""],["会話マーク(EX)",""],["<TE:113>",""]],"context":[["Map055/events/1/name","Map055/events/69/name","Map055/events/90/name"],["Map055/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map055/events/2/name","Map055/events/4/name","Map055/events/5/name","Map055/events/6/name","Map055/events/7/name"],["Map055/events/2/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map055/events/3/name","Map055/events/9/name"],["Map055/events/3/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map055/events/4/pag