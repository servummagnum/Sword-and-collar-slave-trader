,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"舟":0,"ニワトリ":1,"EV003":2,"EV004":3,"湖の漁師":4,"湖について質問しますか？":5,"ここはどういう湖？":6,"湖の中央の島はなに？":7,"島まで舟で渡れる？":8,"質問しない":9,"「ここはクルバ湖。\n　王国で一番大きな湖さ。\\nw[湖の漁師]":10,"「魚は豊富とはいえないが、それでもなんとか\n　生活していける程度には獲れるよ」\\nw[湖の漁師]":11,"「あの島こそ、建国王リジェルダが邪悪な竜アルテトを\n　討ち滅ぼした場所だ。\\nw[湖の漁師]":12,"「その名を『竜の寝床』という。\n　火山島で、いまも時々噴煙を上げているよ。\\nw[湖の漁師]":13,"「大昔には古代竜の繁殖地だった、とも言われているが、\n　果たして本当の話かどうか」\\nw[湖の漁師]":14,"「おいおい、それは無理ってもんだ。\n　あの島はモンスターが跋扈していて、おまけに毒沼からは\n　瘴気が湧き出してる魔境だぞ？」\\nw[湖の漁師]":15,"「ちょっといいかな？」\\nw[\\N[1]]":16,"「なんだい、あんたらは？」\\nw[湖の漁師]":17,"「わたしたち、湖の中央にある島まで渡りたいんですけど、\n　舟を出してもらえませんか？」\\nw[\\N[2]]":18,"「なんだって？\n　それは本気で言ってるのか？」\\nw[湖の漁師]":19,"「ああ、本気だ。\n　なにかおかしいか？」\\nw[\\N[1]]":20,"「おかしいに決まってる！\n　あの『竜の寝床』って島は、モンスターの巣窟だぞ？\\nw[湖の漁師]":21,"「たまに向こう見ずな冒険者が渡っていくことも\n　あるが、決まって戻ってきたためしが無いんだ。\\nw[湖の漁師]":22,"「死にに行くようなもんだぞ？」\\nw[湖の漁師]":23,"「だと思いました。\n　でもどうしても、行かなくちゃならないんです」\\nw[\\N[2]]":24,"「おっ、今回はやっぱりやめようとか言わないんだな？」\\nw[\\N[1]]":25,"「いくら言ってもムダだって、いっぱい学習しました\n　から……」\\nw[\\N[2]]":26,"「なんだか分からないが、止めてもムダらしいな。\\nw[湖の漁師]":27,"「それなら舟を出してやってもいいが、ひとつ\n　条件がある」\\nw[湖の漁師]":28,"「金か？　それなら――」\\nw[\\N[1]]":29,"「いいや、金はいらない。\n　代わりにそっちの女の子――」\\nw[湖の漁師]":30,"「はい？　わたしですか？」\\nw[\\N[2]]":31,"「その子のおっぱいを揉みたい！」\\nw[湖の漁師]":32,"「わ、わたしのおっぱいですか？」\\nw[\\N[2]]":33,"「はぁっ！？」\\nw[\\N[2]]":34,"「こんなところで一人暮らしをしていると、若い女の子と\n　接する機会も少なくてね。\\nw[湖の漁師]":35,"「触れるときに触っておきたいんだ」\\nw[湖の漁師]":36,"「わたしは全然かまいませんけど？\n　むしろ望むところです\\I[29]」\\nw[\\N[2]]":37,"「――ということらしいんで、どうぞ」\\nw[\\N[1]]":38,"「なんなんですかそれ！？」\\nw[\\N[2]]":39,"「島へ渡してもらうために必要なら、やむを得ないか」\\nw[\\N[1]]":40,"「いっ、イヤですよわたしは！」\\nw[\\N[2]]":41,"「これも自由を勝ち取るための試練だと思え。\\nw[\\N[1]]":42,"「――ということで、どうぞ」\\nw[\\N[1]]":43,"「うひょひょーい！\n　久々のパイタッチだー！」\\nw[湖の漁師]":44,"パイタッチＨシーン\n↓　　↓　　↓":45,"「はい、どうぞ\\I[29]」\\nw[\\N[2]]":46,"「いやぁっ！！」\\nw[\\N[2]]":47,"「ちょっと物足りない大きさだけど、女の子のおっぱいって\n　だけで興奮するなぁ」\\nw[湖の漁師]":48,"「大きさのことは言わないでくださいよ\\I[29]\n　いい形してるって、みんな褒めてくれるんですから\\I[29]」\\nw[\\N[2]]":49,"「バカにしてるんですか！？」\\nw[\\N[2]]":50,"「では早速タッチをば――」\\nw[湖の漁師]":51,"「んっ\\I[29]　んぁっ\\I[29]　ふああぁ\\I[29]」\\nw[\\N[2]]":52,"「ひっ……やだっ、こんなの……んんっ……！」\\nw[\\N[2]]":53,"「ふふぉ～！　やっこいなぁ～！\n　やっぱり女の肌はいいもんだぁ」\\nw[湖の漁師]":54,"「はぁっ\\I[29]　んぁっ\\I[29]　あぁっ\\I[29]　もっとぉっ\\I[29]\n　好きにおっぱい弄ってぇ\\I[29]」\\nw[\\N[2]]":55,"「ああっ、弄り倒してやるぞ！　この淫乱娘め！」\\nw[湖の漁師]":56,"「んああぁっ\\I[29]　そこっ\\I[29]　乳首いいのぉ\\I[29]\n　ふああぁあああぁぁっ\\I[29]\\I[29]」\\nw[\\N[2]]":57,"「も、もういいでしょ！　手を離してください！」\\nw[\\N[2]]":58,"「まて、もうちょっと！\n　あとちょっとだけ楽しませてくれ！\\nw[湖の漁師]":59,"「一番好きな乳首責めを今――」\\nw[湖の漁師]":60,"「んひいいぃっ？　だめっ！　乳首はだめぇっ！\n　ひいいいぃいいぃぃっ？！！」\\nw[\\N[2]]":61,"「ふああぁあぁぁ……\\I[29]\\I[29]\n　知らないおじさんの指で……イカされちゃったぁ……\\I[29]」\\nw[\\N[2]]":62,"「うぅ……ぐすっ……。\n　乳首弄りで無理矢理イカされてちゃうなんて……」\\nw[\\N[2]]":63,"↑　　↑　　↑\nパイタッチＨシーン":64,"「ふぅー！　楽しかったぁ！\n　これで１年間はオカズに困らないな」\\nw[湖の漁師]":65,"「ずいぶん長持ちだな……」\\nw[\\N[1]]":66,"「お役に立てて良かったです\\I[29]」\\nw[\\N[2]]":67,"「うぅ……島に渡る前から、モチベーション下がりまくり\n　ですよぉ……！」\\nw[\\N[2]]":68,"漁師の舟で\\C[17]『竜の寝床』\\C[0]へ渡れるようになった！":69,"「竜の寝床まで舟を出すかい？」\\nw[湖の漁師]":70,"舟を出してもらう":71,"やめておく":72,"トークマーク":73},"extension":"json","dataType":"map","filename":"Map316","basename":"Map316.json","path":"data/Map316.json","relPath":"data/Map316.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":74,"percent":0},"cellInfo":[]},"data/Map317.json":{"data":[["EV001",""],["イージー",""],["ノーマル",""],["竜の寝床のどこへ行きますか？",""],["火山への道",""],["火山の洞窟",""],["入らない",""],["死毒の沼",""],["EV002",""],["湖の漁師",""],["「湖畔の小屋まで舟を出すかい？」\\nw[湖の漁師]",""],["舟を出してもらう",""],["やめておく",""],["EV004",""],["舟",""],["トークマーク",""],["竜の寝床上陸Ev",""],["P_D_FILENAME name_dungeon\\V[91]",""],["「ここが『竜の寝床』か」\\nw[\\N[1]]",""],["「すごく荒涼としてますね。\n　湖の周りは緑豊かなのに、なんでこの島だけ……？」\\nw[\\N[2]]",""],["「これから俺たちが向かう\\C[17]死毒の沼\\C[0]の毒気のせいか――。\\nw[\\N[1]]",""],["「でなけりゃ、それこそ悪竜の呪いかもな」\\nw[\\N[1]]",""],["「こ、怖いこと言わないでくださいよ……！」\\nw[\\N[2]]",""],["「実際は呪いなんかより、モンスターの方がよっぽど\n　脅威だがな。\\nw[\\N[1]]",""],["「だから気をつけて進むぞ」\\nw[\\N[1]]",""]],"context":[["Map317/events/1/name"],["Map317/events/1/pages/0/list/3/comment","Map317/events/2/pages/0/list/3/comment","Map