0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],[{"headerIndex":48,"headerParam":["鉱山のモンスター退治が終了してるとき"]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":55,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":72,"headerParam":["",0,0,2]}],[{"headerIndex":77,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":93,"headerParam":["",0,0,2]}],[{"headerIndex":101,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["",0,0,2]}],[{"headerIndex":115,"headerParam":["",0,0,2]}],[{"headerIndex":122,"headerParam":["",0,0,2]}],[{"headerIndex":125,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":3,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":8,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":10,"headerParam":["↓アイテムの重量を変数に入力する"]}],null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"ギルド通信を読むまで出られない":1,"「おっと、出る前に\\C[17]ギルド通信\\C[0]を見ておかないと」\\nw[\\N[1]]":2,"EV002":3,"EV003":4,"火":5,"商人":6,"「武器商ギルドの勢いにも、とうとう陰りが見え始めたな。\n　巻き返しのチャンス到来というわけだ」\\nw[商人]":7,"「我々と対立する武器商ギルドは、新興ながら勢いが\n　すごいんだ。王様が特権を与えたせいでね」\\nw[商人]":8,"仲買人（依頼05）":9,"依頼を出している場合":10,"依頼を出していない場合":11,"「農作物を仕入れるなら、豊作のところへ行かないと。\n　不作の村だと、高いこと高いこと……」\\nw[仲買人]":12,"依頼フキダシ":13,"チェック":14,"ギルド通信":15,"下水道掃除の依頼を受注するイベント":16,"「ここに掲示されてる\\C[17]ギルド通信\\C[0]に、盗賊なんかの\n　目撃情報が載ってるんだ」\\nw[\\N[1]]":17,"「そうなんですか。\n　意外と簡単に手に入る情報なんですね」\\nw[\\N[2]]":18,"「ギルド会費を払ってやってるんだから、これくらいの\n　情報は提供してもらわないと割にあわんさ」\\nw[\\N[1]]":19,"\\{「おいっ、\\N[1]！！」\\}\\nw[？？？]":20,"「これはこれは、\\C[17]ギルド長\\C[0]。\n　どしたんだ、そんな怖い顔して？」\\nw[\\N[1]]":21,"「どうしたもこうしたもあるか！\n　すっとぼけるのも大概にしておけ！\\nw[ギルド長]":22,"「お前な、いい加減\\C[18]ギルド会費の未払い\\C[0]をどうにかしろ！\n　どれだけ溜まってるか分かってるのか！？」\\nw[ギルド長]":23,"「うわっ……会費を滞納してたくせに、割に合わないとか\n　偉そうに言ってたんですか？」\\nw[\\N[2]]":24,"「うるさい黙れ。\n　それはそれ、これはこれ、だ」\\nw[\\N[1]]":25,"「いやいや、別問題じゃないでしょう？\n　会費払わずにサービスだけ受けようなんて、ダメダメ\n　じゃないですか」\\nw[\\N[2]]":26,"「その通りだ！\n　未払いの会費を持ってくるまで、お前はギルドの\n　\\C[18]サービス全般を利用禁止\\C[0]だ！\\nw[ギルド長]":27,"「ギルド通信の閲覧も許さんからな！」\\nw[ギルド長]":28,"「ちょ、ちょっと待ってくれ！\n　実はいま、大きな買い物をした直後であまり金が無いんだ。\\nw[\\N[1]]":29,"「今度来たとき絶対に払うから、今日は見逃してくれ。\n　頼む！」\\nw[\\N[1]]":30,"「そう言って、毎度毎度逃げおって！\n　今回ばかりはダメだ！\\nw[ギルド長]":31,"「お前も商人なら、払うべきものはキッチリ払え！」\\nw[ギルド長]":32,"「そう言われても、無い袖は振れないしなぁ……」\\nw[\\N[1]]":33,"「ならば、こうしよう。\n　緊急性が高くて報酬も悪くないのに、引き受け手が\n　見つからん仕事がある。\\nw[ギルド長]":34,"「お前がその仕事をこなしてくれたら、会費の件は\n　チャラにしてやろう」\\nw[ギルド長]":35,"「なんだその仕事ってのは？\n　誰も引き受けないってことは、どうせロクでもない\n　ことだろ？」\\nw[\\N[1]]":36,"「この町の下水道に棲みついている\\C[17]害獣の駆除\\C[0]だ。\\nw[ギルド長]":37,"「町長が冒険者に駆除の依頼を出しているのに\n　見向きもされなくて、ちょうど困っていたんだ」\\nw[ギルド長]":38,"「ドブ浚いかよ！\n　……だが、仕事を選べる状況でもないか」\\nw[\\N[1]]":39,"「受けるんですか？」\\nw[\\N[2]]":40,"「ああ。\n　考えようによっちゃ、戦闘訓練になるだろうし、\n　やって損になることも無いだろ」\\nw[\\N[1]]":41,"「じゃあ頼んだぞ、\\N[1]。\n　下水道には\\C[17]町の東側の階段\\C[0]から下りられるからな」\\nw[ギルド長]":42,"メインシナリオ\\C[17]『商業ギルドへ』\\C[0]を達成した！":43,"\\N[2]の信頼度が\\C[17]「１」\\C[0]上がった！":44,"メインシナリオ\\C[17]『下水の害獣駆除』\\C[0]を受けた！":45,"「さて……。\n　まずは装備を整えて、それから下水道へ向かうとするか」\\nw[\\N[1]]":46,"\n\\>　　※　町の店舗で\\C[17]買い物\\C[0]ができるようになった！　※":47,"「\\N[2]を買ったせいで金欠だから、購入するものは\n　慎重に選ばないとな」\\nw[\\N[1]]":48,"下水道の害獣駆除が終わるまで、ギルド通信の閲覧は\nできない。":49,"「今週のギルド通信の\\C[17]治安情報\\C[0]にも、盗賊どもの\n　情報が載ってるな」\\nw[\\N[1]]":50,"「じゃあ、さっそく奴隷狩りに？」\\nw[\\N[2]]":51,"「そうしてもいいが、装備が整わないまま猪突猛進して\n　返り討ちにあうのも考えものだ。\\nw[\\N[1]]":52,"「いままで通り行商による\\C[17]交易\\C[0]で金を稼いで、先に装備を\n　整えるか……。\\nw[\\N[1]]":53,"「それとも\\C[17]ダンジョン\\C[0]で、冒険者みたいに宝箱から\n　武器防具を調達するか……。\\nw[\\N[1]]":54,"「ま、そのへんは状況を見て、臨機応変にいこう」\\nw[\\N[1]]":55,"「それは行き当たりばったりと言うのでは？」\\nw[\\N[2]]":56,"「お～い！　\\N[1]！！」\\nw[ギルド長]":57,"「ギルド長？\n　どうした、まだ何か用でも？」\\nw[\\N[1]]":58,"「実はお前に、もうひとつ頼みたいことが出来たんだ。\n　報酬は払うから、引き受けてくれんか？」\\nw[ギルド長]":59,"「そりゃあ内容によるな。\n　いったい、どんな依頼を？」\\nw[\\N[1]]":60,"「\\C[17]鉱山\\C[0]の様子を見てきてほしいのだ」\\nw[ギルド長]":61,"「鉱山？」\\nw[\\N[2]]":62,"「このラノティカの町から北に行った、山向こう側に鉱山が\n　あるんだ。\\nw[\\N[1]]":63,"「そこで掘り出された鉱石は、この町で精錬されて\n　インゴットに加工されたあと、各地に売られて\n　いくんだ」\\nw[\\N[1]]":64,"「その通りなのだが……実はその鉱山が\\C[17]操業停止状態\\C[0]らしい\n　のだ。おかげで鉱石がまったく入ってこない」\\nw[ギルド長]":65,"「それで様子を見てこいってわけか。\n　いいぜ、それくらいなら請け負ってやっても」\\nw[\\N[1]]":66,"「報酬として\\C[17]１０００Ｇ\\C[0]払うから、頼んだぞ」\\nw[ギルド長]":67,"メインシナリオ\\C[17]『鉱山視察』\\C[0]を受けた！":68,"\n\\>　　　\\C[17]※　町の外に出られるようになった！　※\\C[0]":69,"実績 1":70,"豪商":71,"「ギルド通信の市場ニュースは、気にかけておいた方が\n　いい。\\nw[豪商]":72,"「不景気な街でモノを売ろうとしても、利益は出ないからな。\n　売るなら景気のいいところにしないと」\\nw[豪商]":73,"ギルド長":74,"まだ駆除が終わってない":75,"「下水道には\\C[17]町の東側の階段\\C[0]から下りられる。\n　きちんと全部駆除するんだぞ」\\nw[ギルド長]":76,"駆除完了":77,"「ギルド長、下水の害獣駆除終わったぜ。\\nw[\\N[1]]":78,"「これで滞納分のギルド会費はチャラってことで\n　いいな？」\\nw[\\N[1]]":79,"「ほう。もう終わったのか。\n　商売人より冒険者の方が向いてるんじゃないか？」\\nw[ギルド長]":80,"「大きなお世話だ。\\nw[\\N[1]]":81,"「ともかく、仕事は終えたんだから\\C[17]ギルド通信\\C[0]を\n　見せてもらうぜ」\\nw[\\N[1]]":82,"「よかろう。\n　ついでにボーナスでこれもつけてやる」\\nw[ギルド長]":83,"アイテム\\C[17]『精霊石』\\C[0]をもらった！":84,"「それ\\C[17]精霊石\\C[0]ですか？\n　わぁ、綺麗ですね」\\nw[\\N[2]]":85,"「受付カウンターでの\\C[17]精霊石交換サービス\\C[0]も再開して\n　いるから、帰りに寄っていってみるといい。\\nw[ギルド長]":86,"「ではご苦労だったな。\n　次の会費徴収からは、くれぐれも滞納しないように」\\nw[ギルド長]":87,"「へいへい。気をつけますよ」\\nw[\\N[1]]":88,"メインシナリオ\\C[17]『下水の害獣駆除』\\C[0]を達成した！":89,"\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！":90,"\n\\>\\C[17]※　商業ギルドの各種サービスが利用可能になった！　※\\C[0]":91,"実績 2":92,"「\\C[17]鉱山\\C[0]がどうなっているか、見てきてくれ。\n　操業停止だなんて……悪いことが起きていなければ\n　いいが……」\\nw[ギルド長]":93,"鉱山視察の報告":94,"鉱山のモンスター退治が終わっていないとき":95,"「調べてきたぜ、ギルド長。\n　操業停止の原因はモンスターの発生だ」\\nw[\\N[1]]":96,"「なんだと！？」\\nw[ギルド長]":97,"「鉱山の坑道の中にモンスターが湧いて、作業が\n　まったく出来ないそうです。\\nw[\\N[2]]":98,"「駆除がいつごろ終了するかは、見通しが\n　立たない、ということらしく……」\\nw[\\N[2]]":99,"「なんということだ……。\n　この損失は大きなものになるぞ！\\nw[ギルド長]":100,"「……ともあれ、よく調べてきてくれたな。\n　助かったぞ。これが約束の報酬だ」\\nw[ギルド長]":101,"鉱山のモンスター退治が終了してるとき":102,"「そんでもって、そのモンスターは俺たちが\n　残らず倒してきた」\\nw[\\N[1]]":103,"「倒した！？　お前が！？\n　まさか、私をかついでるわけじゃ――」\\nw[ギルド長]":104,"「いえいえ、これが本当でして。\n　わたしも付き合わされて大変だったんですよ～」\\nw[\\N[2]]":105,"「そういうわけで、もう鉱山は操業を再開してるぞ。\n　鉱石もすぐ町へ入ってくるようになるはずだ」\\nw[\\N[1]]":106,"「驚いたな……お前、ほんとうに商人より冒険者の方が\n　向いてるんじゃないか？」\\nw[ギルド長]":107,"「大きなお世話だ！\n　それより報酬だ、報酬」\\nw[\\N[1]]":108,"「わかっとるから、急かすな。ほれ」\\nw[ギルド長]":109,"メインシナリオ\\C[17]『鉱山視察』\\C[0]を達成した！\n報酬として\\C[17]１０００Ｇ\\C[0]をもらった！":110,"「それとこれはモンスターを退治して、早期に操業を\n　再開させてくれ礼だ。遠慮せずとっておけ」\\nw[ギルド長]":111,"追加の報酬として\\C[17]精霊石を２個\\C[0]をもらった！":112,"「おっ、ラッキー！」\\nw[\\N[1]]":113,"「じゃ、俺は自分の商売に戻らせてもらうぞ」\\nw[\\N[1]]":114,"「うむ、ご苦労だったな」\\nw[ギルド長]":115,"ギルド職員":116,"ユマ":117,"ギルド長（OPイベント用）":118,"行商人":119,"「ギルド通信の治安情報に出ている場所のそばには、\n　だいたい盗賊や亜人の隠れ家があるんだ。\\nw[行商人]":120,"「うっかり近づかないよう、気をつけないと」\\nw[行商人]":121,"「砂漠の町で売ってる古代の遺物なんかは利益率が\n　高いんだが、いかんせん重くってなぁ」\\nw[商人]":122,"新米商人":123,"「なにを売買すれば、手っ取り早く儲けられるんで\n　しょうかね？」\\nw[新米商人]":124,"料理1":125,"宝箱":126,"※\nアイテム：火炎瓶\n※":127,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":128,"↓アイテムのIDNo.を変数に入力する":129,"↓アイテムの入手個数を変数に入力する":130,"↓アイテムの重量を変数に入力する":131,"本":132,"MWL_行数変更 16":133,"\\>　　　　　　『サバイバル行商入門』\n\\>\n\\>『……このように行商人の大半は護衛を雇えるほどの\n\\>　収入がないため、自分の身は自分で守るしかない。\n\\>\n\\>　本書では自衛のために知っておくべき知識のうち、\n\\>　一般常識に属するもの――例えば火属性の怪物に\n\\>　は水属性の攻撃を、風属性には地属性を――は割愛\n\\>　し、より実践的な学びを目指すこととする。\n\\>　\n\\>　自分は剣も弓も扱えない、と早くも諦め半分の読者\n\\>　諸兄は安心してほしい。\n\\>　そのような武器がなくとも身を守ることはできる。\n\\>　そう、ガムテープさえあればね。":134,"MWL_行数リセット":135,"女商人":136,"「弱ったからといって、武器商ギルドが無くなることは\n　ないでしょうね」\\nw[女商人]":137,"「わたしたちのギルドが力を持ち過ぎたから、王様は\n　武器商ギルドを対抗勢力に育ててる……って話だけど、\n　本当なのかしら？」\\nw[女商人]":138},"extension":"json","dataType":"map","filename":"Map009","basename":"Map009.json","path":"data/Map009.json","relPath":"data/Map009.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":139,"percent":0},"cellInfo":[]},"data/Map010.json":{"data":[["EV001",""],["EV002",""],["店員",""],["依頼フキダシ