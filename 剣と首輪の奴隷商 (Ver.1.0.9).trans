019",""],["ジャンプ表示",""],["EV021",""],["EV022",""],["EXIT",""],["EV024",""],["門番エルフ1",""],["門番エルフ2",""],["門番エルフ1脇",""],["「行くなら行け」\\nw[門番エルフ男]",""],["「ふんっ、人間ごときと交わす言葉などない」\\nw[門番エルフ男]",""],["門番エルフ2脇",""],["「森の奥までやってきた、その度胸だけは褒めてあげる」\\nw[門番エルフ女]",""],["「こんな森の奥まで人間が来るなんて……。\n　よくモンスターにやられなかったわね」\\nw[門番エルフ女]",""],["追い返されEv",""],["「それ以上近づくなッ、人間！」\\nw[門番エルフ女]",""],["「ここから先は我ら\\C[17]ハイエルフの里\\C[0]だ！\n　何用があってきた！？」\\nw[門番エルフ男]",""],["「あんたらの里を、観光させてもらうわけには――」\\nw[\\N[1]]",""],["「ふざけているのか！？\n　一歩でも近づいたら矢を射かけるぞ！」\\nw[門番エルフ男]",""],["「友好的にふるまってもダメか。\n　かなり警戒されてるな」\\nw[\\N[1]]",""],["「エルフの人間嫌いは有名ですからね。\n　無理せずに引き返しましょ？」\\nw[\\N[2]]",""],["「仕方ない、そうするか」\\nw[\\N[1]]",""],["入れる条件が整っているとき",""],["「ハイエルフの族長に話があってきた。\n　通してもらいたい」\\nw[\\N[1]]",""],["「族長が人間風情にお会いになるものか！」\\nw[門番エルフ女]",""],["「怪我をしないうちに森を出ていけ！\n　去るならば追わん！」\\nw[門番エルフ男]",""],["「ダークエルフに関する、耳寄りな話を持って\n　きたんだがなぁ？」\\nw[\\N[1]]",""],["「ダークエルフって言葉に、敏感に反応しましたね」\\nw[\\N[2]]",""],["「その言葉が嘘でないなら、族長もお会いになるだろう」\\nw[門番エルフ男]",""],["「ただし、つまらない話だったら命の保証はできないわよ」\\nw[門番エルフ女]",""],["「自信があるから、こうして来たんだ。\n　それじゃ通るぜ」\\nw[\\N[1]]",""],["「族長はこの先にある巨木の根元におられる。\n　くれぐれも粗相のないよう、気をつけろ」\\nw[門番エルフ男]",""],["「あれっ！？\n　そういえば\\C[17]交渉用のダークエルフ奴隷\\C[0]、連れてきて\n　ないですよ！」\\nw[\\N[2]]",""],["「しまった！　忘れてた！\n　交渉材料がいなけりゃ、話にならんのに！」\\nw[\\N[1]]",""],["障害物",""],["壁ひび",""],["※\nアイテム：精霊石\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["回復魔法陣",""]],"context":[["Map298/events/1/name"],["Map298/events/2/name"],["Map298/events/3/name"],["Map298/events/3/pages/0/list/0/Plugin Command"],["Map298/events/3/pages/0/list/2/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map298/events/4/name"],["Map298/events/4/note"],["Map298/events/5/name"],["Map298/events/5/pages/0/list/4/comment","Map298/events/6/pages/0/list/4/comment"],["Map298/events/5/pages/0/list/7/Plugin Command","Map298/events/6/pages/0/list/7/Plugin Command"],["Map298/events/6/name"],["Map298/events/7/name"],["Map298/events/7/note"],