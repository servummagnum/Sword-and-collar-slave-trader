]}],[{"headerIndex":312,"headerParam":["",0,0,2]}],[{"headerIndex":316,"headerParam":["",0,0,2]}],[{"headerIndex":330,"headerParam":["",0,0,2]}],[{"headerIndex":354,"headerParam":["",0,0,2]}],[{"headerIndex":359,"headerParam":["",0,0,2]}],[{"headerIndex":362,"headerParam":["",0,0,2]}],[{"headerIndex":367,"headerParam":[""]}],[{"headerIndex":397,"headerParam":["↑　　↑　　↑"]}],[{"headerIndex":412,"headerParam":["",0,0,2]}],[{"headerIndex":418,"headerParam":["",0,0,2]}],[{"headerIndex":421,"headerParam":["",0,0,2]}],[{"headerIndex":430,"headerParam":["",0,0,2]}],[{"headerIndex":446,"headerParam":["",0,0,2]}],[{"headerIndex":450,"headerParam":["",0,0,1]}],[{"headerIndex":461,"headerParam":["",0,0,2]}],[{"headerIndex":469,"headerParam":["",0,0,2]}],[{"headerIndex":475,"headerParam":["",0,0,2]}],[{"headerIndex":481,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"影":0,"木":1,"通行止め":2,"森へ":3,"抜け道":4,"clear_all_weathers":5,"Ｄエルフ族長":6,"交渉用の\\C[17]ハイエルフ奴隷\\C[0]がいないと、長老と話しても\nムダだ……。":7,"すでにハイエルフの里で交渉済みの場合":8,"\n　　　　～　ダークエルフの族長と交渉中　～":9,"「人間がなにをしに来た？\n　歓迎されるとでも思ったか？」\\nw[ダークエルフ族長]":10,"「まさか。\n　だがどうしても、あんたたちに会わなきゃならん\n　事情があってな。\\nw[\\N[1]]":11,"「ぶっちゃけると、エルフだけが持ってるっていう\n　『精霊性具』とやらが欲しいんだ。\\nw[\\N[1]]":12,"「一つくれないか？\n　いくつ持ってるのか知らないが、一つくらい\n　いいだろ？　な？」\\nw[\\N[1]]":13,"「ちょっとぉ？！\n　そんな雑な交渉、まずいですよぉ！」\\nw[\\N[2]]":14,"「我らエルフの至宝である精霊性具が欲しいだと？\n　痴れ者どもが！」\\nw[ダークエルフ族長]":15,"「至宝なのか、大人のオモチャが……」\\nw[\\N[1]]":16,"「族長！　こんな人間の相手などする必要はない！\n　さっさとブッ殺しましょう！」\\nw[ダークエルフ男]":17,"「そうですよ！\n　見せしめとして、斬り落とした首を森の入り口に\n　吊るしてやりましょう！」\\nw[ダークエルフ女]":18,"「あわわわっ……！」\\nw[\\N[2]]":19,"「まあまあ、そんなに殺気立つなよ。\n　なにもタダでくれと言ってるわけじゃないんだ。\\nw[\\N[1]]":20,"「とりあえず、こいつを見てくれ」\\nw[\\N[1]]":21,"「そやつは、憎きハイエルフではないか！？」\\nw[ダークエルフ族長]":22,"「この奴隷は手土産だ。\n　好きに扱ってくれて構わないぜ」\\nw[\\N[1]]":23,"「ふぅむ……首輪つきのハイエルフを持ってきたその\n　センスは認めてやろう」\\nw[ダークエルフ族長]":24,"（認めるんだ……）\\nw[\\N[2]]":25,"「しかし、そやつ一匹と精霊性具を交換とは、虫の\n　良すぎる話だ。\\nw[ダークエルフ族長]":26,"「精霊性具とは、それほど安いモノではないぞ？」\\nw[ダークエルフ族長]":27,"「なにもこのハイエルフと、物々交換してくれってわけ\n　じゃない。\\nw[\\N[1]]":28,"「こいつは手付け金みたいなものだ。\\nw[\\N[1]]":29,"「精霊性具を一つもらえるなら、今後も継続的に\n　ハイエルフの奴隷を売りにきてやろうじゃないか」\\nw[\\N[1]]":30,"「つまり奴隷売買の契約の証として、精霊性具を渡せと？」\\nw[ダークエルフ族長]":31,"「ああ、その通りだ。\\nw[\\N[1]]":32,"「俺は奴隷が売り捌けるし、あんたらは大嫌いな\n　ハイエルフをこき使える。\\nw[\\N[1]]":33,"「お互いに利のある提案だと思うんだが？」\\nw[\\N[1]]":34,"「ぬぅ……」\\nw[ダークエルフ族長]":35,"「そこの男エルフ！\n　屈辱に顔を歪めるハイエルフの女を犯したくないか！？」\\nw[\\N[1]]":36,"「そ、それは……」\n（めっちゃやりてぇー！）\\nw[ダークエルフ男]":37,"「そっちの女エルフ！\n　ハイエルフのイケメンを全裸にひん剥いて、\n　犬みたいに飼いたくないか！？」\\nw[\\N[1]]":38,"「な、なによそれ……」\n（イケメンを飼うとか……興奮するわ！）\\nw[ダークエルフ女]":39,"「俺をダークエルフの里の御用商人にしてくれれば、\n　ハイエルフを捕まえて奴隷として持ってきてやる。\\nw[\\N[1]]":40,"「さあどうだ、返答を聞かせてくれ」\\nw[\\N[1]]":41,"「ぞ、族長……やっぱりブッ殺すのはやめにしましょう。\n　いえ、別にハイエルフ娘とヤリたいからってわけじゃ\n　ないですけどね」\\nw[ダークエルフ男]":42,"「そ、そうね。\n　考えてみれば、精霊性具ってそんなに貴重でもないし、\n　ひとつくらいあげたって……」\\nw[ダークエルフ女]":43,"「えっ！？\n　至宝じゃなかったんですか、精霊性具！？」\\nw[\\N[2]]":44,"「製法は門外不出の秘伝だが、出来上がった性具自体は\n　特別貴重というわけでもないのだ」\\nw[ダークエルフ族長]":45,"「それなら――」\\nw[\\N[1]]":46,"「………………\\!よかろう。\\nw[ダークエルフ族長]":47,"「不倶戴天の敵であるハイエルフを捕え、奴隷にして\n　売ってくれるというなら、人間のお前とでも取り引き\n　してやろう」\\nw[ダークエルフ族長]":48,"「ただし我々は人間の貨幣を使わん。\n　\\C[17]支払いは精霊石\\C[0]になるぞ？」\\nw[ダークエルフ族長]":49,"「問題ないさ。これで契約成立だな」\\nw[\\N[1]]":50,"（口八丁で話をまとめちゃった……なんなのこの人？\n　すごいんだか、すごくないんだか……）\\nw[\\N[2]]":51,"「では渡す前に、この奴隷を使って精霊性具の持つ力を\n　見せてやろう」\\nw[ダークエルフ族長]":52,"「ひっ……！？\n　い、いやっ！　やめてっ！！」\\nw[ハイエルフ奴隷]":53,"「とくと目に焼き付けるといい。\n　これが精霊性具の力だ！」\\nw[ダークエルフ族長]":54,"「よかろう、お前と取り引きしてやる」\\nw[ダークエルフ族長]":55,"「では渡す前に、ハイエルフの奴隷を使って精霊性具の\n　持つ力を見せてやろう」\\nw[ダークエルフ族長]":56,"\nここでエッチイベント\n↓　　↓　　↓":57,"↑　　↑　　↑\nここでエッチイベント\n　":58,"「うわぁ……。\n　見なくていいもの見ちゃった……」\\nw[\\N[2]]":59,"「なかなか面白いじゃないか、精霊性具」\\nw[\\N[1]]":60,"「では先に話した通り、この精霊性具を与えよう。\n　これをもって奴隷売買契約の証とする」\\nw[ダークエルフ族長]":61,"「くれるのはいいが、汁くらい拭き取ってからにして\n　くれよ……」\\nw[\\N[1]]":62,"アイテム\\C[17]『精霊性具』\\C[0]を入手した！":63,"\\>　　※　ダークエルフの里で\\C[17]ハイエルフ奴隷の売買\\C[0]が　※\n\\>　　※　できるようになった！　　　　　　　　　　　※\\<":64,"「色々と大変でしたけど、これであのボスから情報が\n　引き出せますね」\\nw[\\N[2]]":65,"「そうだな。\n　じゃあ王都に戻るとするか」\\nw[\\N[1]]":66,"「森の外へ出るなら、\\C[17]右側奥の抜け道\\C[0]を使うといい。\n　簡単に行き来できるぞ」\\nw[ダークエルフ族長]":67,"「そいつはありがたい。使わせてもらうよ」\\nw[\\N[1]]":68,"ユマ":69,"エルフ1":70,"「ハイエルフの女なんて、どうでもいいんだぜ？\n　興味なんて……まあちょっとくらいは……」\\nw[ダークエルフ男]":71,"エルフ2":72,"「おい、イケメンのハイエルフは連れてきたか？」\\nw[ダークエルフ女]":73,"「里から出る裏道なら、右手の奥の方にあるぞ」\\nw[ダークエルフ女]":74,"ハイエルフ奴隷":75,"トークマーク":76,"エルフ2（門番）":77,"「人間が里でなにをしている？\n　ウロチョロするな！」\\nw[ダークエルフ女]":78,"落ちてる精霊石（街）":79,"エルフ男性":80,"「ハイエルフは大嫌いだね。\n　あいつら、俺たちのことを“闇肌”なんて呼んで見下し\n　てやがるんだ！」\\nw[エルフの男]":81,"「お前がハイエルフの奴隷を連れてくるって？\n　なら、せいぜい可愛がってやるさ」\\nw[エルフの男]":82,"エルフ女性":83,"「弟は人間と戦うと言って、森を飛び出していって\n　しまった。無事だといいんだけど……」\\nw[エルフの女]":84,"「ハイエルフの奴隷を売りにくるって？\n　そんなこと言って、裏じゃダークエルフをあいつらに\n　売りつけてんじゃないだろうね？」\\nw[エルフの女]":85,"「我々エルフは、人間が移住してくるよりはるか昔から\n　この地に根を下ろしているのだ。\n　森も、川も、我々のものなのだ！」\\nw[エルフの男]":86,"「我々とハイエルフの仲が悪い理由？\n　同種同士で争うなど、貴様ら人間もよくやっているでは\n　ないか」\\nw[エルフの男]":87,"「この里に人間が足を踏み入れるなんて、何十年ぶりの\n　ことかしら。\n　あなた、なかなか度胸のある男ね」\\nw[エルフの女]":88,"「ハイエルフの男奴隷……。\n　フフフ……あの白い肌を鞭打ったらどうなるかしら」\\nw[エルフの女]":89,"ウサギ":90,"狐":91,"リス":92,"EXIT":93},"extension":"json","dataType":"map","filename":"Map062","basename":"Map062.json","path":"data/Map062.json","relPath":"data/Map062.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":94,"percent":0},"cellInfo":[]},"data/Map063.json":{"data":[["影",""],["木",""],["通行止め",""],["ライティング",""],["森へ",""],["Ｈエルフ長老",""],["交渉用の\\C[17]ダークエルフ奴隷\\C[0]がいないと、長老と話しても\nムダだ……。",""],["すでにダークエルフの里で交渉済みの場合",""],["\n　　　　～　ハイエルフの族長と交渉中　～",""],["「この里に人間が来るなど、何十年ぶりか。\n　前回来た者は、生きて森を出ることはなかったがな」\\nw[ハイエルフ族長]",""],["「脅しはよしてくれ。\n　なにもケンカをしに来たわけじゃないんだからな」\\nw[\\N[1]]",""],["「ハイエルフの族長よ、あんたたちはダークエルフと\n　違って、品格と礼節を持っているはずだ。\\nw[\\N[1]]",""],["「だから俺はダークエルフの森には行かず、ここに来た」\\nw[\\N[1]]",""],["「それで褒めているつもりか、人間よ？\n　……まあよい、話すだけ話してみよ」\\nw[ハイエルフ族長]",""],["「エルフのみが持つという、『精霊性具』が欲しい」\\nw[\\N[1]]",""],["「精霊性具だと！？\n　それが目的か、強欲な人間め！」\\nw[ハイエルフ男]",""],["「族長、これ以上話を聞く必要などありません！\n　殺して森の外へ捨ててしまいましょう！」\\nw[ハイエルフ女]",""],["「あわわわっ……！\n　\\N[1]さん、まずいですよコレ！」\\nw[\\N[2]]",""],["「エルフってのは血の気が多いな。\n　最後まで話を聞くだけの忍耐もないのか？」\\nw[\\N[1]]",""],["「なんだとぉ！？」\\nw[ハイエルフ男]",""],["「話を聞かないっていうなら、先にモノを見せようか。\n　続きはそれからだ」\\nw[\\N[1]]",""],["「そやつは、忌むべき闇肌ではないか！？\n　しかも金髪！！」\\nw[ハイエルフ族長]",""],["（き、金髪好きって事前情報はホントだったんだ……）\\nw[\\N[2]]",""],["「そいつは手土産だ。\n　煮るなり焼くなり、好きにしてくれ」\\nw[\\N[1]]",""],["「我々にとって闇肌ども――つまりダークエルフどもは、\n　仇敵であると同時に家畜のようなものだ。\\nw[ハイエルフ族長]",""],["「家畜の贈り物は礼に適ってはいる……が。\\nw[ハイエルフ族長]",""],["「さすがにこの奴隷一人と精霊性具とを交換では、\n　価値が釣り合わんぞ？」\\nw[ハイエルフ族長]",""],["「まあ、そりゃそうだろうな。\n　俺も奴隷一人分の価値しかない物のために、こんな\n　遠方まで足を運んだりはしないさ。\\nw[\\N[1]]",""],["「そのダークエルフは、こちらからの誠意の証だと\n　思ってくれ。\\nw[\\N[1]]",""],["「俺は奴隷商人だからな、ダークエルフの奴隷は今後\n　いくらでも取り扱う機会がある。\\nw[\\N[1]]",""],["「もし精霊性具をもらえるなら、何度でもここへ\n　ダークエルフ奴隷を売りに来ようじゃないか」\\nw[\\N[1]]",""],["「無料とはいかないが、原価ギリギリの大特価で\n　お渡ししちゃうぜ？」\\nw[\\N[1]]",""],["\\}「もちろん、金髪奴隷を優先的に連れてくるから（こっそり）」\\{\\nw[\\N[1]]",""],["「うむむむ……悪くない話のようにも……\\}きんぱつ……\\{」\\nw[ハイエルフ族長]",""],["「ところでそこの男エルフ！　女の好みは？」\\nw[\\N[1]]",""],["「え……きょ、巨乳……かな……」\\nw[ハイエルフ男]",""],["「そっちの女エルフ！　どんな男がいい？」\\nw[\\N[1]]",""],["「い、いきなり聞かれても……背が高くて筋肉質とか……」\\nw[ハイエルフ女]",""],["「ならば、巨乳女も筋肉男も、首に鎖をつけて連れてきて\n　やろう！\\nw[\\N[1]]",""],["「好き勝手していい家畜同然のダークエルフが\n　里に増えるぞ！」\\nw[\\N[1]]",""],["「\\N[1]さん……。\n　普段から悪い顔してますけど、今回は一段と悪辣な\n　お顔ですね……」\\nw[\\N[2]]",""],["「うるさい、黙れ。\n　俺の高度な交渉術を邪魔するな」\\nw[\\N[1]]",""],["「ぞ、族長……こいつの提案は……その、悪くないかもなぁ\n　なんて……」\n（巨乳奴隷！　巨乳奴隷ぇッ！）\\nw[ハイエルフ男]",""],["「ちょっとくらい耳を傾けてあげても……まあ……」\n（マッチョ奴隷にやりたい放題ッ……！）\\nw[ハイエルフ女]",""],["「そうだな……精霊性具も極秘の製法さえ外に漏れな\n　ければ、現物自体を渡すことにさほどの問題は\n　ないし……」\\nw[ハイエルフ族長]",""],["「だったら――」\\nw[\\N[1]]",""],["「奴隷の積極的な買い取りは、闇肌どもの力を削ぐこと\n　にも繋がろう。\\nw[ハイエルフ族長]",""],["「あえてお前の話に乗ってやる、人間の奴隷商人よ。\n　いつでもこの里に闇肌奴隷を連れてくるがいい」\\nw[ハイエルフ族長]",""],["「そう言ってくれると思ってたぜ！」\\nw[\\N[1]]",""],["「ただし我々は、貨幣を使わない。物々交換が基本なのだ。\n　よって支払いには\\C[17]精霊石\\C[0]を使うことになるが？」\\nw[ハイエルフ族長]",""],["「まったく構わないさ。じゃあこれで契約成立だな」\\nw[\\N[1]]",""],["（無理な交渉だと思ってたけど、あれよあれよと\n　まとまったちゃった……。嘘みたい……）\\nw[\\N[2]]",""],["「それではまず、精霊性具の使い方を見せよう。\n　ちょうどそこに、手頃な奴隷もいることだし」\\nw[ハイエルフ族長]",""],["「ひっ……！？\n　い、いやっ！　やめてっ！！」\\nw[ダークエルフ奴隷]",""],["「精霊性具の神秘の力、とくと見よ！」\\nw[ハイエルフ族長]",""],["「いいだろう、お前の提案を受け入れるとしよう」\\nw[ハイエルフ族長]",""],["「では渡す前に、闇肌奴隷を使って精霊性具の真価を\n　教えてやろう」\\nw[ダークエルフ族長]",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↑　　↑　　↑\nここでエッチイベント\n　",""],["「うわぁ……。\n　ひどいものを見ちゃった……」\\nw[\\N[2]]",""],["「精霊性具、なるほど大したオモチャだ」\\nw[\\N[1]]",""],["「さあ受け取れ。この精霊性具を取り引きの証として\n　お前にゆずろう」\\nw[ハイエルフ族長]",""],["「ベタベタしてて使用感がスゴイが……礼を言わせて\n　もらうぜ、ありがとう」\\nw[\\N[1]]",""],["アイテム\\C[17]『精霊性具』\\C[0]を入手した！",""],["\\>　　※　ハイエルフの里で\\C[17]ダークエルフ奴隷の売買\\C[0]が　※\n\\>　　※　できるようになった！　　　　　　　　　　　※\\<",""],["「色々と大変でしたけど、これであのボスから情報が\n　引き出せますね」\\nw[\\N[2]]",""],["「そうだな。\n　じゃあ王都に戻るとするか」\\nw[\\N[1]]",""],["「森の外へ出るなら、\\C[17]奥にある洞窟の道\\C[0]を使うといい。\n　簡単に行き来できるぞ」\\nw[ハイエルフ族長]",""],["「そいつはありがたい。使わせてもらうよ」\\nw[\\N[1]]",""],["トークマーク",""],["エルフ1",""],["「巨乳じゃなきゃダメってわけじゃないんだ。\n　ただ、どっちかっていうと大きい方が、って話で……」\\nw[ハイエルフ男]",""],["エルフ2",""],["「男の筋肉を見てると、たまらなくなっちゃって……」\\nw[ハイエルフ女]",""],["「里から出る裏道を使うなら、右奥の方にある洞窟を\n　抜けていきなさい」\\nw[ハイエルフ女]",""],["ユマ",""],["Dエルフ奴隷",""],["抜け道",""],["clear_all_weathers",""],["エルフ2（門番）",""],["「人間よ、立ち去りなさい。\n　ここはお前たちが来ていい場所ではない」\\nw[ハイエルフ女]",""],["落ちてる精霊石（街）",""],["エルフ女性",""],["「美しい景色でしょう？\n　でもここと同じような森を、人間はどんどん切り拓いて\n　いってるのよ」\\nw[エルフの女]",""],["「闇肌の奴隷で族長を釣ったの？\n　……あのエロじじいめ」\\nw[エルフの女]",""],["「人間のことはキライだけど、闇肌はもっとキライ。\n　あ、闇肌っていうのは、あんたたち人間が言うところの\n　ダークエルフのことよ」\\nw[エルフの女]",""],["「闇肌を売りに来たんですって？\n　人間はほんとに商売熱心ね」\\nw[エルフの女]",""],["エルフ男性",""],["「俺の父は人間の兵士に殺されたんだ。\n　いまでもその恨みは忘れていないぞ」\\nw[エルフの男]",""],["「人間に父を殺された恨みはあるが、しかしお前が殺した\n　わけでもないからな……。つまり、その……俺にも\n　闇肌奴隷を売ってくれていいんだぞ？」\\nw[エルフの男]",""],["「争いは好まないけど、人間と戦うため森を出て行った\n　仲間たちの気持ちも分かるよ」\\nw[エルフの男]",""],["「ダークエルフとの間に子供ができたらどうするかって？\n　そんな汚らわしいことにならないよう、避妊魔法を\n　使うのさ」\\nw[エルフの男]",""],["EV088",""],["EV089",""],["鹿",""],["侵入防止",""],["EV095",""],["particles : 0 : 30 : 1 : 0 : -3.5 : 1 : Waterfall_0",""],["EXIT",""]],"context":[["Map063/events/1/name","Map063/events/2/name","Map063/events/3/name","Map063/events/4/name","Map063/events/5/name","Map063/events/6/name","Map063/events/7/name","Map063/events/30/name","Map063/events/37/name","Map063/events/42/name","Map063/events/45/name","Map063/events/48/name","Map063/events/63/name"],["Map063/events/8/name","Map063/events/10/name","Map063/events/12/name","Map063/events/14/name","Map063/events/16/name","Map063/events/18/name","Map063/events/20/name","Map063/events/22/name","Map063/events/24/name","Map063/events/26/name","Map063/events/28/name","Map063/events/31/name","Map063/events/33/name","Map063/events/35/name","Map063/events/38/name","Map063/events/40/name","Map063/events/43/name","Map063/events/46/name","Map063/events/49/name","Map063/events/51/name","Map063/events/53/name","Map063/events/55/name","Map063/events/57/name","Map063/events/59/name","Map063/events/61/name","Map063/events/64/name","Map063/events/66/name","Map063/events/68/name","Map063/events/70/name"],["Map063/events/9/name","Map063/events/11/name","Map063/events/13/name","Map063/events/15/name","Map063/events/17/name","Map063/events/19/name","Map063/events/21/name","Map063/events/23/name","Map063/events/25/name","Map063/events/27/name","Map063/events/29/name","Map063/events/32/name","Map063/events/34/name","Map063/events/36/name","Map063/events/39/name","Map063/events/41/name","Map063/events/44/name","Map063/events/47/name","Map063/events/50/name","Map063/events/52/name","Map063/events/54/name","Map063/events/56/name","Map063/events/58/name","Map063/events/60/name","Map063/events/62/name","Map063/events/65/name","Map063/events/67/name","Map063/events/69/name","Map063/events/71/name"],["Map063/events/72/name"],["Map063/events/