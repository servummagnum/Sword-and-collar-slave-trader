rIndex":56,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":12,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["窃盗の難しさ（1=簡単、2=難しい、3=高難度）"]}],[{"headerIndex":2,"headerParam":["手薄な時間帯（1=昼、2=夜）"]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}]],"indexIds":{"宿屋の主人":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"火":5,"ギャンブラー":6,"特定アイテムを賭けての勝負\n↓　　↓　　↓":7,"「暇つぶしに奴隷カードで遊ばないか？\n　あんたが勝ったら\\C[17]ステータス増強薬\\C[0]をあげよう。\\nw[ギャンブラー]":8,"「逆にオレが勝ったなら、一緒にいるその猫人の娘の\n　\\C[27]おまんこを観察\\C[0]させてもらおう」\\nw[ギャンブラー]":9,"勝負を受ける":10,"やめておく":11,"奴隷カードの説明":12,"PNDK_LC getSurplusWeights 15":13,"↓積載重量空きOK":14,"賞品の重量が\\C[18]\\v[17]Ｗ\\C[0]オーバーしてしまうため、勝負を\n受けられません。\n積載重量に余裕を作ってください。":15,"「よしっ、勝負だ！！」\\nw[ギャンブラー]":16,"勝利（戦利品ゲット）":17,"「あんた強いな、大したものだ。\n　こちらの負けだから、約束通りステータス増強薬を\n　進呈しよう」\\nw[ギャンブラー]":18,"アイテム\\C[17]『\\in[25]』『\\in[26]』\\C[0]を手に入れた！":19,"引き分け":20,"「なんだ、引き分けか。\n　白黒つけたかったんだがな」\\nw[ギャンブラー]":21,"敗北（ユマ凌辱）":22,"「オレの勝ちだから、おまんこを公開してもらおう。\n　さあ、さあ！」\\nw[ギャンブラー]":23,"「そんなにがっつかなくても、ほら\\I[29]\n　心ゆくまで観察してくださいね\\I[29]」\\nw[\\N[2]]":24,"「うぅむ、淫乱の気配がありながら、黒ずみも型崩れも\n　ないとは……」\\nw[ギャンブラー]":25,"「こっ、これでいいですか！？\n　もういいですよね！？　終わりでいいですよね！？」\\nw[\\N[2]]":26,"「もう少しゆっくり観察したいんだが……。\n　ほうほう、歪みのない良いスジだ」\\nw[ギャンブラー]":27,"\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下がった！":28,"現金を賭けての勝負（繰り返し）\n↓　　↓　　↓":29,"「現金を賭けて勝負するかい？」\n（※賭け金は\\C[17]『\\v[1170]G』\\C[0]です）\\nw[ギャンブラー]":30,"賭ける":31,"現金がある":32,"現金なし":33,"「おいおい、金がないんじゃ勝負が成立しないぜ」\\nw[ギャンブラー]":34,"勝利（賭け金ゲット）":35,"「くそっ、今日はツイてねぇぜ……！」\\nw[ギャンブラー]":36,"\\C[17]『\\v[1170]G』\\C[0]を手に入れた！":37,"敗北（賭け金没収）":38,"「へへっ！　悪く思うなよ。\n　こっちにツキがあったんだ」\\nw[ギャンブラー]":39,"\\C[9]『\\v[1170]G』\\C[0]を失った！":40,"宿屋の女将":41,"「いらっしゃい！\n　ウチは南都で一番いい宿だよ！」\\nw[宿屋の女将]":42,"宿泊客（依頼06）":43,"依頼を出している場合":44,"依頼を出していない場合":45,"「ここには所用があって初めて来たのだが……なんとも\n　険しい場所に街をつくったものだと感心したよ」\\nw[宿泊客]":46,"男":47,"「悪竜\\N[6]かぁ……。\n　本物だったなら、見てみたかったなぁ」\\nw[酒飲みの男]":48,"「南の砂漠には、昔すごく大きな国が栄えていた\n　らしいが……今となっちゃただの伝説だな」\\nw[酒飲みの男]":49,"光":50,"ギャンブルふきだし":51,"依頼フキダシ":52,"トイレドア（排泄Ev）":53,"トイレで用を足しますか？":54,"入る":55,"入らない":56,"いまのところ用を足す必要は無い。":57,"トイレマーク（屋内用）":58,"<TE:84>":59,"ユマ（トイレ）":60,"絶倫おじさん（依頼16）":61,"吟遊詩人（依頼15）":62,"料理1":63,"料理2":64,"娼婦":65,"「まったく、これくらいで情けないわね。\n　そんなんでアッチの方は大丈夫なの？」\\nw[娼婦]":66,"男性客":67,"「ぐえぇ……もう飲めない……無理だぁ……。\n　くそぉ、なんて強い女なんだ……」\\nw[酔った男]":68,"女性客":69,"「彼女、夫に浮気されて自暴自棄になりかけてるのよ。\n　かわいそうに……」\\nw[女性]":70,"「あのクサレチンポ男ォッ！！\n　こうなったら離婚……いやその前にあたしも浮気して\n　やるぅ！！」\\nw[女性]":71,"現金（窃盗用）":72,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":73,"手薄な時間帯（1=昼、2=夜）":74,"チェック":75,"女性":76,"「ここから南に行くと、\\C[17]火の洞窟\\C[0]や\\C[17]古代遺跡\\C[0]といった\n　ダンジョンがあるの。\n　私はどっちを探索しようかしら」\\nw[冒険者]":77,"EV029":78,"「街道を外れて東の方角へ向かうと、火山があるんだ。\n　その火山のふもとにあるダンジョンは\\C[17]火の洞窟\\C[0]と\n　呼ばれているらしい」\\nw[男性客]":79,"変態紳士（依頼17）":80,"「幼馴染ですっげぇ不細工な男がいるんだけど、いま\n　オヤジさんが必死で嫁探ししてるんだ。\\nw[男性客]":81,"「嫁と引き換えなら\\C[17]伝家の宝玉\\C[0]も譲り渡す、とか言ってる\n　けど、その宝玉ってのに本当に価値があるのかどうか」\\nw[男性客]":82,"「幼馴染の不細工野郎が、とうとう嫁をめとったんだ。\n　奴隷を無理やり嫁にしたって話だけど、なんか意外と\n　うまく行ってるみたいなんだよな」\\nw[男性客]":83},"extension":"json","dataType":"map","filename":"Map0