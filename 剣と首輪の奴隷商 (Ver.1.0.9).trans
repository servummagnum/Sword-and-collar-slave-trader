]}],[{"headerIndex":137,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":150,"headerParam":["",0,0,2]}],[{"headerIndex":157,"headerParam":["",0,0,2]}],[{"headerIndex":170,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["依頼条件達成"]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["依頼条件未達成"]}],[{"headerIndex":66,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["夜間用ＢＧＭ演奏"]}],[{"headerIndex":1,"headerParam":["夜→昼"]}],[{"headerIndex":11,"headerParam":["最初から昼"]}],[{"headerIndex":1,"headerParam":["昼→夜"]}],[{"headerIndex":11,"headerParam":["最初から夜"]}],null,null,null,null,null,null,null,null,null,[{"headerIndex":10,"headerParam":["",0,0,2]}]],"indexIds":{"農民":0,"牛":1,"逃走防止用":2,"宿屋入り口":3,"宿屋":4,"EV011":5,"民家":6,"EV012":7,"EV013":8,"ニワトリ":9,"EV016":10,"EV017":11,"EV018":12,"EV019":13,"EV020":14,"EV021":15,"家具職人":16,"蜂":17,"羊":18,"個別依頼02":19,"山脈の抜け道Ａ":20,"「\\C[17]山の抜け道\\C[0]が使えなくなってから、王都方面への\n　行き来がすっかり難しくなってしまった……」\\nw[村民]":21,"「抜け道？\n　そんなものがあるんですか？」\\nw[\\N[2]]":22,"「ああ、ここから\\C[17]北へ行ったところに洞窟\\C[0]があって、\n　そこが大山脈の反対側にまで通じているんだ」\\nw[村民]":23,"すでに岩を除去して抜け道が通行できるとき":24,"「もしかして、岩で塞がれていたヤツか？\n　それだったら、俺たちが岩をどかして通れるように\n　しといたぞ」\\nw[\\N[1]]":25,"「ほっ、本当なのかっ、その話！？」\\nw[村民]":26,"「ほんとうですよ。\n　偶然あそこを通ることになって、そうしたら岩が邪魔\n　だったので」\\nw[\\N[2]]":27,"「そいつは素晴らしい！\n　\\C[17]報酬５０００Ｇ\\C[0]で岩除去の依頼を出しても、誰も\n　来てくれなかったんだが――」\\nw[村民]":28,"「その５０００Ｇは、当然俺たちにくれるんだよな？」\\nw[\\N[1]]":29,"「えっ……いや、それは……あんたに依頼したわけじゃ\nないし……」\\nw[村民]":30,"「じゃあ抜け道を埋め戻してくるか」\\nw[\\N[1]]":31,"「ちょ、ちょ、ちょっ、ちょっと待った！\n　払う！　払いますからァ！！」\\nw[村民]":32,"個別依頼\\C[17]『山脈の抜け道Ａ』\\C[0]を達成した！":33,"報酬として\\C[17]５０００Ｇ\\C[0]入手した！\n\\N[2]の信頼度が\\C[17]「９」\\C[0]上がった！":34,"ver.1.0.3での修正前に、個別依頼02を受け無い状態で東洞窟をクリアしてしまうと\nダンジョンクリアのフラグが立たない。その場合ここでフラグを立てる。":35,"まだ抜け道通行不可のとき":36,"「あの邪魔くさい大山脈を、ショートカットできるって\n　いうのか！？　そいつはスゴイな！」\\nw[\\N[1]]":37,"「ただし、洞窟にはモンスターが巣食っている。\n　だから地元の人間が長年かけて、安全に迂回できる\n　抜け道を掘ったんだ」\\nw[村民]":38,"「ところがその便利な抜け道が使えなくなって\n　しまった、と？」\\nw[\\N[1]]":39,"「そうなんだ。\n　天井の一部が崩落して、抜け道の出入り口が岩で\n　塞がれてしまってな。\\nw[村民]":40,"「岩をどかしたくても、モンスターのそばで復旧作業は\n　危険だし……。\\nw[村民]":41,"「かと言って、冒険者を雇って作業してもらおうにも、\n　予算が\\C[17]５０００Ｇ\\C[0]では誰も来てくれない……。\n　ハァ……困ったものだ」」\\nw[村民]":42,"個別依頼『山脈の抜け道Ａ』を受けますか？":43,"受ける":44,"受けない":45,"「よしっ！　その作業依頼、俺たちが引き受けた！」\\nw[\\N[1]]":46,"「また安請け合いして、大丈夫ですかぁ？」\\nw[\\N[2]]":47,"個別依頼\\C[17]『山脈の抜け道Ａ』\\C[0]を受けた！":48,"依頼条件達成":49,"「抜け道を塞いでいる邪魔な岩をどかしてきたぞ。\n　これで大山脈の北側までショートカット可能だ」\\nw[\\N[1]]":50,"「ありがとう！　本当に助かった！\n　村を代表してお礼を言わせてもらうよ！」\\nw[村民]":51,"依頼条件未達成":52,"「抜け道のある洞窟は、ここから北に行ったところだ。\n　邪魔な岩の除去、よろしく頼んだよ」\\nw[村民]":53,"依頼マーク":54,"養蜂箱":55,"ハチミツを採るための養蜂箱だ。":56,"村人（奴隷買い取り）":57,"奴隷買い取り（フキダシ）":58,"農作物売買フキダシ":59,"女の子":60,"「だいじょうぶ。\n　わるいことしなきゃ、さされないよ」\\nw[女の子]":61,"農婦":62,"「王都でモンスターが暴れたんですって？\n　え、暴れたのは悪竜？　あれはおとぎ話でしょ？」\\nw[農婦]":63,"「ここは海から遠いから、あまりお魚を食べられないのが\n　残念ね」\\nw[農婦]":64,"「別の大型のハチが巣を襲って、女王蜂を殺して\n　しまうこともあるんだ。\n　もちろんミツバツも抵抗して戦うがね」\\nw[養蜂家]":65,"奴隷2":66,"「断言できるね。\n　牛のフンをひたすら回収するこの仕事は、野盗以下の\n　最低な仕事だ！」\\nw[奴隷]":67,"男の子":68,"「井戸って、オバケがでてきそうでこわいなぁ」\\nw[男の子]":69,"ＢＧＭ変更":70,"夜間用ＢＧＭ演奏":71,"夜→昼":72,"最初から昼":73,"昼→夜":74,"最初から夜":75,"屋外トイレドア（排泄Ev）":76,"<TE:80>":77,"トイレマーク":78,"景気ランタン":79,"落ちてる精霊石（街）":80,"犬":81,"マップ取得":82,"FocusCamera 20 15 120":83,"ZoomOut 2.3 120":84,"\\C[17]\\V[914]の地図\\C[0]を取得した！":85,"ResetZoom 60":86,"ResetFocus 60":87},"extension":"json","dataType":"map","filename":"Map022","basename":"Map022.json","path":"data/Map022.json","relPath":"data/Map022.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBui