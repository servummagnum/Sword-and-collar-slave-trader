rIndex":277,"headerParam":["",0,0,2]}],[{"headerIndex":284,"headerParam":["",0,0,2]}],[{"headerIndex":290,"headerParam":["",0,0,2]}],[{"headerIndex":296,"headerParam":["",0,0,2]}],[{"headerIndex":303,"headerParam":["",0,0,2]}],[{"headerIndex":313,"headerParam":["",0,0,2]}],[{"headerIndex":318,"headerParam":["",0,0,2]}],[{"headerIndex":323,"headerParam":["",0,0,2]}],[{"headerIndex":326,"headerParam":["",0,0,2]}],[{"headerIndex":331,"headerParam":["",0,0,2]}],[{"headerIndex":347,"headerParam":["",0,0,2]}],[{"headerIndex":351,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}]],"indexIds":{"燭台":0,"光":1,"防壁":2,"血糊":3,"EV019":4,"EV020":5,"EV021":6,"死体":7,"すでにこと切れている。":8,"ラーナ":9,"大公":10,"主人公（身代わり）":11,"乱入兵士1":12,"乱入兵士2":13,"乱入兵士3":14,"乱入兵士4":15,"ユマ（姫vs大公Ev）":16,"「こ、これはどういうことだ！？\n　答えろ！　\\N[5]！」\\nw[パルフューク大公]":17,"「いやですわ、叔父上。\n　挨拶に立ち寄っただけなのに、そんな怖い顔なさるなんて」\\nw[\\N[5]]":18,"「ふざけるな！\n　お前は……お前はなんなのだ！？\\nw[パルフューク大公]":19,"「突然一人で現れたかと思ったら、あっという間に\n　護衛の兵を皆殺しにするなど――。\\nw[パルフューク大公]":20,"「人間の所業とは思えぬ……！\n　本当に\\N[5]なのか！？」\\nw[パルフューク大公]":21,"「ええ、もちろん。\n　あなたの可愛い姪っ子の、\\N[5]ですわ\\I[29]」\\nw[\\N[5]]":22,"「わたし、とても悲しく思っていますのよ？\\nw[\\N[5]]":23,"「簒奪のために悪竜アルテトを甦らせ、わたしと父上を\n　殺そうだなんて――本当に叔父上は酷い人♪」\\nw[\\N[5]]":24,"「簒奪！？　なにをバカなことを！」\\nw[パルフューク大公]":25,"「バカなのは叔父上でしょう？\\nw[\\N[5]]":26,"「甦らせたアルテトを御しきれず、逆に襲われて\n　こんな有様に……うふふ♪」\\nw[\\N[5]]":27,"「私に悪竜復活の罪をなすりつけるつもりか！？\n　そのために街の人間まで巻き込んで……おのれっ！\\nw[パルフューク大公]":28,"「何が目的だ！？\n　次の王位が約束されていながら、なぜこのような暴挙を\n　行う！？\\nw[パルフューク大公]":29,"「私が本当に簒奪するのではないかと、疑心暗鬼に\n　駆られたか！？」\\nw[パルフューク大公]":30,"「叔父上は勘違いをされています。\n　王位のことなど、まったく関係ありませんのに」\\nw[\\N[5]]":31,"「な、なに……？　では一体……」\\nw[パルフューク大公]":32,"「……少し、昔話をいたしましょうか」\\nw[\\N[5]]":33,"createFilter 1 shockwave 0":34,"setFilter 1 408 312 -1 30 160 1":35,"moveFilter 1 408 312 -1 50 250 2 120":36,"eraseFilter 1":37,"「およそ５００年前のこと。\\nw[\\N[5]]":38,"「悪逆非道の限りを尽くした古代竜アルテトは、\n　人間たちの指導者であったリジェルダによって\n　追い詰められていました」\\nw[\\N[5]]":39,"createFilter 1 dot 0":40,"setFilter 1 5 3":41,"「世間で噂される通り、アルテトの呪いは現代に到るまで\n　続いているのですよ。\\nw[\\N[5]]":42,"「現在の国王――父上も、すでに余命幾ばくもないでしょう」\\nw[\\N[5]]":43,"「陛下の健康に不安があることなど、とうに承知して\n　いる！\\nw[パルフューク大公]":44,"「私が聞きたいのは――」\\nw[パルフューク大公]":45,"「叔父上。\n　建国王リジェルダに撃ち込まれたアルテトの魂の一部は、\n　その後どうなったと思います？」\\nw[\\N[5]]":46,"「な、なに……？」\\nw[パルフューク大公]":47,"「アルテトの魂の欠片は、リジェルダの血とともに、\n　その子々孫々の身体へと受け継がれていったのです。\\nw[\\N[5]]":48,"「内部からリジェルダの子孫の寿命を奪いつつ、少しずつ\n　少しずつ力を蓄えていったアルテトの魂――。\\nw[\\N[5]]":49,"「最初は意識すらない弱々しい欠片でした。\\nw[\\N[5]]":50,"「でも、５００年の刻を費やしてついに、リジェルダの\n　末孫の中で自我を得るまでに成長できました」\\nw[\\N[5]]":51,"「で、ではっ……まさかお前がっ！？\n　\\N[5]ッ、お前が……！」\\nw[パルフューク大公]":52,"「はい。\n　\\C[17]わたしこそが伝説の悪竜\\C[0]ですわ\\I[29]」\\nw[\\N[5]]":53,"「その姿は！？　その四本の角はッ！！」\\nw[パルフューク大公]":54,"「改めましてごきげんよう、叔父上。\\nw[\\N[5]]":55,"「\\C[27]わたしは\\N[5]。\\C[0]\n　\\C[18]そして\\N[6]。\\C[0]\\nw[\\N[5]]":56,"「\\C[27]あなたたちの血族にして、\\C[18]お前たちの血の宿敵\\C[0]」\\nw[\\N[5]=\\N[6]]":57,"「こっ、こんな……なんたることだ！\\nw[パルフューク大公]":58,"「次の王たる者が、あの悪竜だというのかぁッ！！？」\\nw[パルフューク大公]":59,"「その悪竜を甦らせた極悪人の叔父上には、ここで死んで\n　もらいます♪\\nw[\\N[5]=\\N[6]]":60,"「そして５００年ぶりに再開される『悪竜アルテト』との\n　戦争では、女王たるわたしが指揮を執ることとなり\n　ましょう」\\nw[\\N[5]=\\N[6]]":61,"「流れる血と悲鳴、恐怖にゆがむ顔と心。\n　\\C[27]わたし\\C[0]の命令で、皆が\\C[18]わたし\\C[0]に殺されていくのです。\\nw[\\N[5]=\\N[6]]":62,"「最高の娯楽である人間の絶望を、今度こそ\n　心ゆくまで味わわせてもらいますわ\\I[29]」\\nw[\\N[5]=\\N[6]]":63,"「そんな茶番の惨劇を仕組むために、お前はお前の本体を\n　甦らせたのか！？\\nw[パルフューク大公]":64,"「このッ……バケモノめぇッ！！\n　くらえッ！！」\\nw[パルフューク大公]":65,"「どうだッ！\n　遠祖リジェルダより伝わりし必殺の剣の味は！」\\nw[パルフューク大公]":66,"「必殺の剣？　これが？\\nw[\\N[5]=\\N[6]]":67,"「あははははっ！\n　子孫がこのていたらくでは、リジェルダのやつも\n　浮かばれないでしょうね！」\\nw[\\N[5]=\\N[6]]":68,"「そんなッ？！　効いていないのか！？」\\nw[パルフューク大公]":69,"「では次はこちらの番ですわね。\n　――さようなら、叔父上」\\nw[\\N[5]=\\N[6]]":70,"FocusCamera 17 19 40":71,"「チッ！　まずいっ！」\\nw[\\N[1]]":72,"FocusCamera 18 27 40":73,"「逃げろ！　大公！\n　はやく――」\\nw[\\N[1]]":74,"「こんがり焼けましたわね、叔父上。\n　おいしそうな匂いですこと♪\\nw[\\N[5]=\\N[6]]":75,"「さあて、焼かなければならない虫がもう一匹……\n　いえ、二匹かしら？\n　ノコノコと現れたようね。\\nw[\\N[5]=\\N[6]]":76,"「せっかく拾った命を、自分から捨てにくるなんて\n　物好きなこと。うふふふ……」\\nw[\\N[5]=\\N[6]]":77,"FocusCamera 17 23 70":78,"「\\N[5]……いや、\\N[6]！\n　お前は人間のことを見くびり過ぎだ！\\nw[\\N[1]]":79,"「建国王に敗れておきながら、まだ分かってない\n　ようだな！」\\nw[\\N[1]]":80,"「あらあら、もしかしてわたしに勝てる気でいるのかしら？\\nw[\\N[5]=\\N[6]]":81,"「竜の寝床では、尻尾を巻いて無様に逃げ出したくせに」\\nw[\\N[5]=\\N[6]]":82,"「だがお前は俺たちを殺しきれなかった。\n　たかだか商人と奴隷の二人をな」\\nw[\\N[1]]":83,"「…………」\\nw[\\N[5]=\\N[6]]":84,"（たしかにあれは妙だったわ……。\n　なにかカラクリがあるのかしら？）\\nw[\\N[5]=\\N[6]]":85,"「それと、お前自身が\\N[6]であるなら、なぜさっさと\n　鉤爪を壊して復活せず、わざわざ竜の寝床にまで\n　運ばせた？\\nw[\\N[1]]":86,"「壊さずに封印を解かなきゃならん理由でもあったか？\n　だとすれば、そこにお前の弱味が――」\\nw[\\N[1]]":87,"「ハッ！　くだらないわね！\n　妄想を垂れ流すのはそこまでにしてくれる？\\nw[\\N[5]=\\N[6]]":88,"「希望を持とうとしてもムダよ！\n　あなたたちが圧倒的に矮小で、取るに足りない存在で\n　あることに変わりはないのだから！」\\nw[\\N[5]=\\N[6]]":89,"「なら試してみるか？　腹黒メスドラゴン！」\\nw[\\N[1]]":90,"「……口が悪い男ね。\n　いいわ、跡形もなく燃やし尽くしてあげましょう！」\\nw[\\N[5]=\\N[6]]":91,"「おっとその前に、お前はあいつらの相手をしないと\n　いけないんじゃないか？」\\nw[\\N[1]]":92,"「なんですって？」\\nw[\\N[5]=\\N[6]]":93,"「なにがあった！？\n　あの爆音はなんだ！？」\\nw[警備兵]":94,"「たっ、大公殿下が！？\n　おのれっ、貴様のせいか！？」\\nw[警備兵]":95,"「今頃になって雑魚がワラワラと……。\\nw[\\N[5]=\\N[6]]":96,"「でもこのくらいの兵力、あなたたちともども、まとめて\n　焼き払って――。\\nw[\\N[5]=\\N[6]]":97,"「はっ！？」\\nw[\\N[5]=\\N[6]]":98,"「あんな大見得を切っておいて逃げた！？\\nw[\\N[5]=\\N[6]]":99,"「よ……よくもコケにしてくれたわねぇッ！！」\\nw[\\N[5]=\\N[6]]":100,"乱入兵士5":101,"乱入兵士6":102,"引き返し":103,"兵士に見つかると騒ぎになってしまう。\nこの先へ行くのはやめておこう。":104,"爆撃目標地点":105},"extension":"json","dataType":"map","filename":"Map326","basename":"Map326.json","path":"data/Map326.json","relPath":"data/Map326.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":106,"percent":0},"cellInfo":[]},"data/Map327.json":{"data":[["火",""],["光",""],["EV003",""],["主婦",""],["「王都で悪竜が退治されたっていうけど、本当なのかしら？」\\nw[主婦]",""],["「襲撃があった日、誰かがドアを叩いてたけど、\n　怖くて開けられなかったわ」\\nw[主婦]",""],["「ちょっと買いすぎちゃったかしら……」\\nw[主婦]",""],["亭主",""],["「大公様が悪竜を復活させたというデマを、悪竜自身が\n　\\N[5]姫に化けて広めていたらしい。ひどい話だよ」\\nw[眼鏡の男]",""],["「モンスターは宮殿の手前で押し返されてたらしい。\n　じゃあなんで、大公様は死んでしまったんだ？」\\nw[眼鏡の男]",""],["「かみさんの前では言えないけど、俺の理想の女性は\n　チェリア姫なんだ」\\nw[眼鏡の男]",""],["「街にモンスターが雪崩こんで来たときには、もう\n　命は無いものと覚悟したよ」\\nw[男性客]",""],["「弟の大公殿下は良くできた人なのに、なんで\n　兄の国王はあんなポンコツなんだろな？」\\nw[男性客]",""],["現金（窃盗用）",""],["窃盗の難しさ（1=簡単、2=難しい、3=高難度）",""],["手薄な時間帯（1=昼、2=夜）",""],["チェック",""]],"context":[["Map327/events/1/name"],["Map327/events/2/name"],["Map327/events/3/name"],["Map327/events/4/name"],["Map327/events/4/pages/0/list/1/message/noPicture/bottom"],["Map327/events/4/pages/0/list/7/message/noPicture/bottom"],["Map327/events/4/pages/0/list/12/message/noPicture/bottom"],["Map327/events/5/name"],["Map327/events/5/pages/0/list/1/message/noPicture/bottom","Map327/events/5/pages/2/list/1/message/noPicture/bottom"],["Map327/events/5/pages/0/list/8/message/noPicture/bottom"],["Map327/events/5/pages/0/list/13/message/noPicture/bottom"],["Map327/events/5/pages/2/list/8/message/noPicture/bottom"],["Map327/events/5/pages/2/list/13/message/noPicture/bottom"],["Map327/events/6/name"],["Map327/events/6/pages/0/list/0/comment"],["Map327/events/6/pages/0/list/2/comment"],["Map327/events/7/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,null,null,["gold"],null,null,null,null,null,["gold"],["red"],["red"],["gold"]],"parameters":[null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["窃盗の難しさ（1=簡単、2=難しい、3=高難度）"]}],[{"headerIndex":2,"headerParam":["手薄な時間帯（1=昼、2=夜）"]}]],"indexIds":{"火":0,"光":1,"EV003":2,"主婦":3,"「王都で悪竜が退治されたっていうけど、本当なのかしら？」\\nw[主婦]":4,"「襲撃があった日、誰かがドアを叩いてたけど、\n　怖くて開けられなかったわ」\\nw[主婦]":5,"「ちょっと買いすぎちゃったかしら……」\\nw[主婦]":6,"亭主":7,"「大公様が悪竜を復活させたというデマを、悪竜自身が\n　\\N[5]姫に化けて広めていたらしい。ひどい話だよ」\\nw[眼鏡の男]":8,"「モンスターは宮殿の手前で押し返されてたらしい。\n　じゃあなんで、大公様は死んでしまったんだ？」\\nw[眼鏡の男]":9,"「かみさんの前では言えないけど、俺の理想の女性は\n　チェリア姫なんだ」\\nw[眼鏡の男]":10,"「街にモンスターが雪崩こんで来たときには、もう\n　命は無いものと覚悟したよ」\\nw[男性客]":11,"「弟の大公殿下は良くできた人なのに、なんで\n　兄の国王はあんなポンコツなんだろな？」\\nw[男性客]":12,"現金（窃盗用）":13,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":14,"手薄な時間帯（1=昼、2=夜）":15,"チェック":16},"extension":"json","dataType":"map","filename":"Map327","basename":"Map327.json","path":"data/Map327.json","relPath":"data/Map327.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":17,"percent":0},"cellInfo":[]},"data/Map328.json":{"data":[["火",""],["光",""],["EV003",""],["主婦",""],["「空を飛んでいたあの巨大な竜が、一介の冒険者に討たれた\n　なんて、ちょっと信じられないわ」\\nw[主婦]",""],["「竜が空を飛んでいるところなんて、初めて見たわ」\\nw[主婦]",""],["「主人が家事手伝い用の女奴隷を欲しがってるんだけど、\n　浮気が目的じゃないかって思うの」\\nw[主婦]",""],["亭主",""],["「悪竜は死んだって？　やれやれ、一安心だ」\\nw[猫人の男]",""],["「いきなり竜が現れたと思ったら、その次にモンスターの\n　大群だよ。焦ったのなんのって！」\\nw[猫人の男]",""],["「友達とよく、\\N[5]姫派かチェリア姫派かって話に\n　なるんだけど、僕は断然\\N[5]姫派だね」\\nw[猫人の男]",""],["宝箱（消耗品右開き）",""],["<TE:14>",""],["窃盗用下着2",""],["<TE:117>",""]],"context":[["Map328/events/1/name"],["Map328/events/2/name"],["Map328/events/3/name"],["Map328/events/4/name"],["Map328/events/4/pages/0/list/1/message/noPicture/bottom"],["Map328/events/4/pages/0/list/8/message/noPicture/bottom"],["Map328/events/4/pages/0/list/12/message/noPicture/bottom"],["Map328/events/5/name"],["Map328/events/5/pages/0/list/1/message/noPicture/bottom","Map328/events/5/pages/2/list/1/message/noPicture/bottom"],["Map328/events/5/pages/0/list/7/message/noPicture/bottom","Map328/events/5/pages/2/list/7/message/noPicture/bottom"],["Map328/events/5/pages/0/list/12/message/noPicture/bottom","Map328/events/5/pages/2/list/12/message/noPicture/bottom"],["Map328/events/6/name"],["Map328/events/6/note"],["Map328/events/7/name"],["Map328/events/7/note"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,null,null,["go