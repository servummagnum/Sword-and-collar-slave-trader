rParam":["",0,0,2]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":72,"headerParam":["",0,0,2]}],[{"headerIndex":77,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":86,"headerParam":["",0,0,2]}],[{"headerIndex":89,"headerParam":["",0,0,2]}],[{"headerIndex":119,"headerParam":["",0,0,2]}],[{"headerIndex":122,"headerParam":["",0,0,2]}],[{"headerIndex":125,"headerParam":["",0,0,2]}],[{"headerIndex":129,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":28,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":82,"headerParam":["",0,0,2]}],[{"headerIndex":88,"headerParam":["",0,0,2]}],[{"headerIndex":151,"headerParam":["",0,0,2]}],[{"headerIndex":170,"headerParam":["",0,0,2]}],[{"headerIndex":176,"headerParam":["",0,0,2]}],[{"headerIndex":180,"headerParam":["",0,0,2]}],[{"headerIndex":183,"headerParam":["",0,0,2]}],[{"headerIndex":189,"headerParam":["",0,0,2]}],[{"headerIndex":195,"headerParam":["",0,0,2]}],[{"headerIndex":200,"headerParam":["",0,0,2]}],[{"headerIndex":209,"headerParam":["",0,0,2]}],[{"headerIndex":213,"headerParam":["",0,0,2]}],[{"headerIndex":216,"headerParam":["",0,0,2]}],[{"headerIndex":234,"headerParam":["",0,0,2]}],[{"headerIndex":245,"headerParam":["ボス戦"]}],[{"headerIndex":283,"headerParam":["",0,0,2]}],[{"headerIndex":289,"headerParam":["",0,0,2]}],[{"headerIndex":293,"headerParam":["",0,0,2]}],[{"headerIndex":306,"headerParam":["",0,0,2]}],[{"headerIndex":389,"headerParam":["",0,0,2]}],[{"headerIndex":392,"headerParam":["",0,0,2]}],[{"headerIndex":426,"headerParam":["最初の鉤爪のとき"]}],[{"headerIndex":432,"headerParam":["",0,0,2]},{"headerIndex":479,"headerParam":["",0,0,2]}],[{"headerIndex":436,"headerParam":["",0,0,2]}],[{"headerIndex":460,"headerParam":["",0,0,2]}],[{"headerIndex":467,"headerParam":["",0,0,2]}],[{"headerIndex":473,"headerParam":["二度目以降の鉤爪のとき"]}],[{"headerIndex":483,"headerParam":["",0,0,2]}],[{"headerIndex":506,"headerParam":["",0,0,2]}],[{"headerIndex":509,"headerParam":["",0,0,2]}],[{"headerIndex":515,"headerParam":["",0,0,2]}],[{"headerIndex":523,"headerParam":["",0,0,2]}],[{"headerIndex":529,"headerParam":["",0,0,2]}],[{"headerIndex":531,"headerParam":["",0,0,2]}],[{"headerIndex":536,"headerParam":["",0,0,2]}],[{"headerIndex":539,"headerParam":["",0,0,2]}],[{"headerIndex":569,"headerParam":["",0,0,2]}],[{"headerIndex":574,"headerParam":["",0,0,2]}],[{"headerIndex":595,"headerParam":["",0,0,2]}],[{"headerIndex":620,"headerParam":["",0,0,2]}],[{"headerIndex":637,"headerParam":["",0,0,2]}],[{"headerIndex":642,"headerParam":["",0,0,2]}],[{"headerIndex":646,"headerParam":["",0,0,2]}],[{"headerIndex":651,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":3,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":8,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":10,"headerParam":["↓アイテムの重量を変数に入力する"]}],null,null,[{"headerIndex":0,"headerParam":["↓金額おまかせの場合は変数を「0」のままに。"]}]],"indexIds":{"ボート制御→":0,"石碑1":1,"蜘蛛の巣に覆われた古い石碑がある。":2,"『ただ一人、不屈にして折れざる者よ。\n　その足でどこまでも歩め。\n　太陽の昇る果ての地までも』":3,"「この石碑、気になりますね。\n　これが手がかりってことは？」\\nw[\\N[2]]":4,"「どうだろうな？\n　全然関係のない文章にも思えるが」\\nw[\\N[1]]":5,"「やっぱり気になります、この石碑。\n　きっとこれが鉤爪の埋まっている場所を示すヒント\n　なんですよ！」\\nw[\\N[2]]":6,"「お前、適当な思いつきで言ってないか？」\\nw[\\N[1]]":7,"「まあ、根拠は無いんですけど……。\\nw[\\N[2]]":8,"「でも、こういうときのわたしの勘、けっこう当たる\n　んですよ」\\nw[\\N[2]]":9,"「じゃあその勘で、さっさとこの石碑のヒントを解読\n　してほしいもんだな」\\nw[\\N[1]]":10,"「うっ……それは……。\n　また別の話でして……」\\nw[\\N[2]]":11,"「あっ、分かった！　分かっちゃいましたよ！\n　鉤爪の埋まってる場所！」\\nw[\\N[2]]":12,"「なにっ、本当か！？　どこだ！？」\\nw[\\N[1]]":13,"「『\\N[2]ちゃん、教えてください\\I[29]』ってお願いして\n　くれたら、教えてあげます♪」\\nw[\\N[2]]":14,"お願いする":15,"自分で考える":16,"「くだらない真似を……ったく！\n　\\N[2]チャン、オシエテクダサイ――これでいいか？」\\nw[\\N[1]]":17,"「えー！　全然、心がこもってませんよぉ～」\\nw[\\N[2]]":18,"「いいから早く言え！\n　俺の堪忍袋の緒が切れないうちに！」\\nw[\\N[1]]":19,"「仕方ないですね、ではお答えしましょう！」\\nw[\\N[2]]":20,"「『ただ一人、不屈にして折れざる者』とは、\n　あの祭壇を囲む柱の――」\\nw[\\N[2]]":21,"「あっ、そうか！\\nw[\\N[1]]":22,"「あそこにある柱の中で、一本だけ折れずに残ってるのが\n　『折れざる者』。\\nw[\\N[1]]":23,"「そして『太陽の昇る果ての地まで』とは、東の方向へ\n　どこまでも、ということ。\\nw[\\N[1]]":24,"「つまり\\C[17]折れてない柱の根元から、東へ行けるところまで\n　行った先\\C[0]――そこに鉤爪が埋まってるわけだ！」\\nw[\\N[1]]":25,"「……え？　なんで言っちゃうんですか？\n　わたしが説明してる最中だったのに……。\\nw[\\N[2]]":26,"「しかも、さも自分が一人で考えついたようなドヤ顔\n　までさらして……」\\nw[\\N[2]]":27,"「細かいことは気にするな！\n　さあ、俺たちで鉤爪を掘り出すぞ！」\\nw[\\N[1]]":28,"「誰がそんなこと言うか！\n　お前は口をつぐんでろ！　自力で解読してやるから！」\\nw[\\N[1]]":29,"「あーあ、意固地になっちゃって」\\nw[\\N[2]]":30,"「『\\N[2]ちゃん、教えてください\\I[29]』ってお願いして\n　くれたら、教えてあげますよ？」\\nw[\\N[2]]":31,"「くそっ……これで勝ったと思うなよ！\n　\\N[2]チャン……オシエテクダサイ――」\\nw[\\N[1]]":32,"「つまり\\C[17]折れてない柱の根元から、東へ行けるところまで\n　行った先\\C[0]――そこに鉤爪が埋まってるわけだな」\\nw[\\N[1]]":33,"ボート":34,"水没行き止まりEv":35,"ボートに乗って戻りますか？":36,"乗る":37,"乗らない":38,"水路":39,"空の宝箱":40,"宝箱の底に文字が彫られている。":41,"『竜の鉤爪を求めし者よ。其は宝にあらず。\n　故にこの地へ埋めたり。欲するものは汝の足下に』":42,"「宝箱を用意しておきながら、わざと地面に埋めたって\n　いうのか？　何のつもりだ？」\\nw[\\N[1]]":43,"「『宝にあらず』って書いてありますから、竜の鉤爪の\n　価値を勘違いするなっていう警告じゃないでしょうか？」\\nw[\\N[2]]":44,"「なるほど。\n　金銭的な価値があるだけの単なる骨董品じゃない\n　ってことか」\\nw[\\N[1]]":45,"「でも埋めた場所の手がかりは、どこにも書いて\n　ありませんね」\\nw[\\N[2]]":46,"「他の場所を探してみるか」\\nw[\\N[1]]":47,"宝箱の底に文字が掘られている。":48,"敵索敵スタート":49,"PSS start":50,"アジト":51,"海賊休憩退去":52,"洞窟出口":53,"この先に海賊たちの住処があるようだ。\n見つかるとまずいので進まずにおこう。":54,"岩石で出入口が塞がれてしまっている。\n海賊たちが封鎖したようだ。":55,"ボート矢印":56,"海賊穴掘り発見Ev":57,"「誰かいるぞ。\n　あの風体……海賊みたいだな」\\nw[\\N[1]]":58,"「じゃあ、本当に海賊のアジトまで来ちゃったんですか？」\\nw[\\N[2]]":59,"「そのようだな。\n　よし、隠れて様子をうかがうぞ」\\nw[\\N[1]]":60,"「あの海賊たち、みんなで地面を掘り返してますけど、\n　どうしてあんなことを？」\\nw[\\N[2]]":61,"「さあな？\n　こっちが教えてもらいたいぜ」\\nw[\\N[1]]":62,"「あっ……！　\\N[1]さん！\n　あそこに\\C[17]\\N[3]\\C[0]と\\C[17]執事の人\\C[0]がいますよ！」\\nw[\\N[2]]":63,"「なにっ！？　どこだ！？」\\nw[\\N[1]]":64,"FocusCamera 40 19 90":65,"「まだ見つからないのっ！？」\\nw[\\N[3]]":66,"「見ての通り、手下どもを動員して掘り続けてるが、\n　なにせこの広さだ。そう簡単にはいかん」\\nw[海賊船長]":67,"「確かに時間がかかるのは仕方のないところでしょう。\\nw[\\N[4]]":68,"「場所が場所だけに、人夫を大勢やとって働かせる\n　わけにもいきませんし」\\nw[\\N[4]]":69,"「ああっ、もぅっ！\n　イライラするわね！」\\nw[\\N[3]]":70,"「そもそも、本当にこの場所に\\C[17]『竜の鉤爪』\\C[0]とやらが\n　あるのか？\\nw[海賊船長]":71,"「俺たちがここを略奪品の倉庫として使い始めたときから、\n　その宝箱は空だったってぇのに」\\nw[海賊船長]":72,"「でも空っぽの宝箱の底に\\C[17]『鉤爪はこの地に埋めた』\\C[0]って\n　書いてあったんだから、信じるしかないでしょ！」\\nw[\\N[3]]":73,"「やれやれ……これで何も出てこなかったら、骨折り損の\n　くたびれ儲けってだけじゃ済まねぇぜ？」\\nw[海賊船長]":74,"「だが、成果が上がった場合の利益は大きい。\n　それを忘れないでいただきたい」\\nw[\\N[4]]":75,"「わかってるさ。……しかし嘘じゃないんだろうな？\n　海賊の頭目でしかない俺が、\\C[17]王国の海軍大将\\C[0]になれる\n　なんて」\\nw[海賊船長]":76,"「あの方の言う通りに動けば、必ずなれるわ。\\nw[\\N[3]]":77,"「あんたはこの北海における最高権力者として、\n　往来する船から合法的に通行税や輸入税をガッポリ\n　徴収できるのよ」\\nw[\\N[3]]":78,"「ふへへへっ！\n　まったく夢のある話だぜ」\\nw[海賊船長]":79,"「あたしを信じなさい。\n　\\N[2]のとこの商船を襲わせたときだって、情報は\n　正確だったでしょ？」\\nw[\\N[3]]":80,"「そうだったな。あれはかなり儲かった」\\nw[海賊船長]":81,"「今度も儲けさせてあげるわ。\n　そのためには絶対に、鉤爪を見つけなきゃいけないの」\\nw[\\N[3]]":82,"「わかった、わかった。\n　でも手下どもも長時間の作業で疲れきってる。\\nw[海賊船長]":83,"「ここらで休憩を取らせにゃ、ブッ倒れちまうぜ」\\nw[海賊船長]":84,"最初の鉤爪探索のとき":85,"「チッ……仕方ないわね！」\\nw[\\N[3]]":86,"二つ目以降の鉤爪探索のとき":87,"「チッ……仕方ないわね！\\nw[\\N[3]]":88,"「でもなるべく早く、作業を再開させてよ！\\nw[\\N[3]]":89,"「時間をかけてると、またあの忌々しい二人組みが\n　鉤爪を狙って来るかもしれないから！」\\nw[\\N[3]]":90,"「誰のことだか知らねぇが、俺ら以外にこの島へ\n　近づけるヤツはいねぇから安心しな」\\nw[海賊船長]":91,"「おーい、オメェら！！\n　休憩だー！　作業中断しろー！」\\nw[海賊船長]":92,"ResetFocus 60":93,"「なにを話してたかよく聞こえなかったが、竜の鉤爪を\n　探してることだけは確かなようだ」\\nw[\\N[1]]":94,"「地面のどこかに埋まってるとして、あのペースじゃ\n　いつになったら見つかるか分かりませんよ？」\\nw[\\N[2]]":95,"「そうだな。\n　無闇やたらとあちこち掘り返してるところを見ると、\n　場所の見当もついてないようだし。\\nw[\\N[1]]":96,"「海賊どもが休憩してる今のうちに、ちょっくら\n　見て回るか。\\nw[\\N[1]]":97,"「あの脳筋野郎どもが見落としてる\\C[17]手がかり\\C[0]が、どこかに\n　あるかもしれないからな」\\nw[\\N[1]]":98,"\n\\>　　※　\\C[17]竜の鉤爪\\C[0]が埋まっている場所を探そう！　※":99,"エルラ":100,"バルコルド":101,"海賊船長":102,"ユマ":103,"海賊1":104,"海賊2":105,"海賊3":106,"海賊4":107,"海賊5":108,"海賊6":109,"海賊7":110,"石碑2":111,"まだ建てられたばかりらしい石碑がある。":112,"『島への上陸を記念してこの碑を記す。\n\\>　　　　　　　　　　　　　\\<世界一の海賊船長』":113,"どこかから盗んできたらしい石碑が置かれている。":114,"『この公共広場の整備に尽力いただいた方々を、ここに\n　顕彰するものである』":115,"柱1":116,"柱だ。これ一本だけ折れずに残っている。":117,"一本だけ折れずに残っている柱だ。\nここから東へ歩いていった先に、竜の鉤爪はあるはずだ。":118,"柱2":119,"柱だ。根本近くから折れてしまっている。":120,"柱3":121,"柱4":122,"鉤爪埋設場所":123,"「おっ、ここの土、よく見ると少し色が違うな。\n　よし、掘るぞ」\\nw[\\N[1]]":124,"「でも、そろそろ\\N[3]や海賊が戻って来るんじゃ？」\\nw[\\N[2]]":125,"「だからさっさと掘るんだ。\n　ほら、お前もスコップを持て」\\nw[\\N[1]]":126,"「見ろ！　出てきたぞ！」\\nw[\\N[1]]":127,"初めての鉤爪発見":128,"「これが……竜の鉤爪？」\\nw[\\N[2]]":129,"「鉤爪の形をしてるし、間違いなさそうだ。\n　メスガキを出し抜いてやれたな」\\nw[\\N[1]]":130,"二度目以降の鉤爪発見":131,"「やったぁ！　二つ目の鉤爪ですね！」\\nw[\\N[2]]":132,"「ああ、またメスガキを出し抜いてやれたな」\\nw[\\N[1]]":133,"「砂漠の古代遺跡でもチラリと見たが、確かに同じものだ。\n　これで間違いないな。\\nw[\\N[1]]":134,"「ようやくメスガキを出し抜いてやれたぜ」\\nw[\\N[1]]":135,"\\C[17]『竜の鉤爪』\\C[0]を手に入れた！":136,"「じゃあ早くここを出ましょう。\n　だいぶ時間をつかっちゃったから、そろそろ海賊が\n　戻ってくるかも――」\\nw[\\N[2]]":137,"\\{「なっ、なんだテメェらは！？」\\}\\nw[海賊船長]":138,"「どこから入り込んできやがった！？」\\nw[海賊船長]":139,"「チッ！　もう戻ってきたのか！\n　海賊のくせに真面目なヤツラめ！」\\nw[\\N[1]]":140,"「にっ、逃げないと！」\\nw[\\N[2]]":141,"「ちょっと待てコラ！\n　その手に持ってるのはまさか――！」\\nw[海賊船長]":142,"「そのまさかだ。\n　竜の鉤爪は俺たちがいただいた！」\\nw[\\N[1]]":143,"「なっ、なんだとォ！！」\\nw[海賊船長]":144,"「ムダな穴掘りご苦労さん！\n　それじゃアバヨ！　海賊のとっつぁん！」\\nw[\\N[1]]":145,"「オメェら！　なにボーッとしてやがる！\n　追え！　絶対に逃がすな！\\nw[海賊船長]":146,"「それと\\C[17]例のアレ\\C[0]を起動して、ヤツラにぶつけろ！」\\nw[海賊船長]":147,"「れ、例のアレをですか！？\n　しかし暴走の危険が――」\\nw[手下海賊]":148,"「かまわねぇからやれ！\n　とにかくあの盗人どもを逃がすな！　行け！」\\nw[海賊船長]":149,"EV031":150,"石像だ。たぶん略奪品だろう。":151,"EV032":152,"壁掛け時計だ。たぶん略奪品だろう。":153,"ボス戦Ev":154,"「よし、あとはあのボートで逃げれば――」\\nw[\\N[1]]":155,"「\\N[1]さん！\n　後ろからなにか――！？」\\nw[\\N[2]]":156,"「なっ、なんだコイツは！？」\\nw[\\N[1]]":157,"「モ……モンスター！？」\\nw[\\N[2]]":158,"「がっはっはっ！\n　追い詰めたぞ、この盗人ども！」\\nw[海賊船長]":159,"「フンッ！　海賊にだけは言われたくないな」\\nw[\\N[1]]":160,"「どどどっ、どうしましょう！？\n　挟まれちゃいましたよ！？」\\nw[\\N[2]]":161,"「その巨人は、この島で見つけた古代の魔法兵器だ！\n　俺の命令ひとつでお前らに襲いかかるぞ！\\nw[海賊船長]":162,"「死にたくなけりゃ、鉤爪を手放して降伏しろ！」\\nw[海賊船長]":163,"「わ、わたしとしては、降伏するって選択もアリなんじゃ\n　ないかなぁ～って……」\\nw[\\N[2]]":164,"「バカ言うな！\n　鉤爪を手放した途端に、殺されるのがオチだぞ！」\\nw[\\N[1]]":165,"「こうなったらもう戦うしか道は残されてない。\n　覚悟を決めろ！」\\nw[\\N[1]]":166,"「ひーん！」\\nw[\\N[2]]":167,"「どうやら死にてぇらしいな。\n　なら望み通りにしてやる！\\nw[海賊船長]":168,"「巨人よ！　その二人を始末しろ！」\\nw[海賊船長]":169,"「来るぞッ！！」\\nw[\\N[1]]":170,"ボス戦\n↓　　↓　　↓":171,"「なんだコイツ？　様子がおかしいぞ」\\nw[\\N[1]]":172,"「手ごたえはありましたけど、まだ動くんでしょうか？」\\nw[\\N[2]]":173,"「なにをしてやがる！　このデクノボウ！\n　早くそいつらを叩き潰せ！」\\nw[海賊船長]":174,"「なにかヤバそうだな……」\\nw[\\N[1]]":175,"「ぼっ、暴走だァーッ！！」\\nw[手下海賊]":176,"「だから巨人を使うのは危険だって言ったのにぃーッ！」\\nw[手下海賊]":177,"最初の鉤爪のとき":178,"「あんたたち、いったい何を騒いで――」\\nw[\\N[3]]":179,"「\\N[2]とフード男！？\n　なんでここに！？」\\nw[\\N[3]]":180,"「よおメスガキ！\n　お前が探してた竜の鉤爪は、俺たちがいただいたぜ！」\\nw[\\N[1]]":181,"「\\N[3]！\n　わたし、あなたの思い通りにはさせないって決めたから！」\\nw[\\N[2]]":182,"二度目以降の鉤爪のとき":183,"「\\N[2]とフード男！？\\nw[\\N[3]]":184,"「よおメスガキ！\n　再会したばかりでなんだが、俺たちは帰らせてもうらぜ！\\nw[\\N[1]]":185,"「竜の鉤爪は入手できたんでな！」\\nw[\\N[1]]":186,"「\\N[3]！\n　この鉤爪は、あなたには渡さないから！」\\nw[\\N[2]]":187,"「なっ……\\N[2]のくせにぃっ！！」\\nw[\\N[3]]":188,"「なにをしているのだ！　不甲斐ない海賊どもめ！\\nw[\\N[4]]":189,"「敵に侵入を許した挙句、獲物を横取りされて\n　ただで帰す気か！？」\\nw[\\N[4]]":190,"「そ、そんなこと言ったって、あの巨人が暴走しちまって\n　近づけねぇんだよ！\\nw[手下海賊]":191,"「親分はこの通り、気絶しちまってるしよぉ！」\\nw[手下海賊]":192,"「あんなデカブツが何だって言うのよ！\n　気合いで突撃しなさい！」\\nw[\\N[3]]":193,"「無茶言うな！」\\nw[手下海賊]":194,"「危ないっ！\n　お嬢様、お下がりください！」\\nw[\\N[4]]":195,"「ひぃっ？！」\\nw[\\N[3]]":196,"「じゃあな！　メスガキと執事野郎！\n　お前らはそのポンコツと遊んでろ！」\\nw[\\N[1]]":197,"「あっ！？　待て、フード野郎！」\\nw[\\N[3]]":198,"「いけません、お嬢様！\n　まずはあの巨人を止めてからでないと！」\\nw[\\N[4]]":199,"「くっそおおおぉぉっ！！」\\nw[\\N[3]]":200,"島の巨人":201,"回復魔法陣":202,"壁ひび":203,"※\nアイテム：筋肉増強剤\n※":204,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":205,"↓アイテムのIDNo.を変数に入力する":206,"↓アイテムの入手個数を変数に入力する":207,"↓アイテムの重量を変数に入力する":208,"宝箱（お金左開き）":209,"<TE:18>":210,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":211,"野外トイレ（排泄Ev）":212,"<TE:82>":213,"トイレマーク":214,"<TE:84>":215},"extension":"json","dataType":"map","filename":"Map312","basename":"Map312.json","path":"data/Map312.json","relPath":"data/Map312.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":216,"percent":0},"cellInfo":[]},"data/Map313.json":{"data":[["EV001",""],["脱出用魔法陣",""],["ダンジョンの外へ脱出しますか？",""],["脱出する",""],["脱出しない",""],["createFilter 1 twist 2",""],["setFilter 1 408 312 416 0",""],["moveFilter 1 408 312 816 13 120",""],["eraseFilter 1",""],["ユマ",""],["EXIT",""],["発掘現場通行Ev",""],["「なんだキミたちは？」\\nw[護衛の冒険者]",""],["「この遺跡で発掘作業をしてるっていう伝承学者の先生に\n　会いに来たんだ。知っているか？」\\nw[\\N[1]]",""],["「先生ならこの先におられるが、要件はなんだ？」\\nw[護衛の冒険者]",""],["「わたしたち、先生が前に興味を持っていらっしゃった\n　竜の鉤爪を所持しているんです。\\nw[\\N[2]]",""],["「それについてお話をうかがいたくて」\\nw[\\N[2]]",""],["「その鉤爪のことなら、以前先生が話していたな。\n　現物を見られるとなれば、きっと喜ぶだろう。\\nw[護衛の冒険者]",""],["「分かった、通っていいぞ」\\nw[護衛の冒険者]",""],["「ありがとうございます」\\nw[\\N[2]]",""],["粘土板の解読を待たなければ。",""],["護衛冒険者",""],["「発掘の護衛は危険な仕事だが、そのぶん報酬はいいぞ」\\nw[護衛の冒険者Ａ]",""],["「すまん……俺としたことが、賊の一撃で昏倒して\n　しまうとは……」\\nw[護衛の冒険者Ａ]",""],["「結局あの暗殺者は、誰が何のために寄越したんだろう？\n　先生はなにか知っているようだけど……」\\nw[護衛の冒険者Ａ]",""],["労働奴隷",""],["「モンスターだらけの遺跡で穴掘りなんて、危険すぎて\n　シャレになんねーぜ……」\\nw[人間奴隷]",""],["「さっきのあれ、盗賊か？\n　風みたいにビューッと走って行って、すごかったな」\\nw[人間奴隷]",""],["護衛冒険者2",""],["「あの先生、基本的にケチだけど、あたしらへの報酬は\n　しっかり払ってくれるのよ」\\nw[護衛の冒険者Ｂ]",""],["「ケチらずに高い防具をつけてたおかげで、致命傷には\n　ならなかったよ……でも防具はボロボロ……」\\nw[護衛の冒険者Ｂ]",""],["「二度と暗殺者なんかに遅れをとらないよう、これまで\n　以上にしっかり警備しないと」\\nw[護衛の冒険者Ｂ]",""],["「窃盗１００件くらいで奴隷に落とされるなんて、\n　信じらんねぇ！」\\nw[猫人奴隷]",""],["「モンスターやら盗賊やら、くそっ、やってらんねぇぜ！」\\nw[猫人奴隷]",""],["「アナホリ……モウアキタ……」\\nw[鬼奴隷]",""],["「オレモシヌナラ、タタカッテシニタイ……」\\nw[鬼奴隷]",""],["伝承学者（会話Ev）",""],["↓奴隷譲渡処理",""],["肉体労働用の奴隷",""],["↑ここまで",""],["奴隷不足のとき",""],["\\C[18]※　注意　※\\C[0]\n　伝承学者に手土産として渡す\\C[17]奴隷の数が不足\\C[0]しています。",""],["必要な奴隷を連れてこないと……。",""],["奴隷OKのとき",""],["「あんたが伝承学者の先生か？」\\nw[\\N[1]]",""],["「なんだね、キミたちは？\n　借金取りなら間に合ってるよ」\\nw[伝承学者]",""],["「い、いえ。\n　わたしたちは竜の鉤爪について、先生から話を――」\\nw[\\N[2]]",""],["「竜の鉤爪だって！？\n　もしかして、何か新しい発見でもあったのか！？」\\nw[伝承学者]",""],["「発見も何も、ここに現物を持ってきてあるぜ」\\nw[\\N[1]]",""],["「なんだと！？　見せてみろ！」\\nw[伝承学者]",""],["「こ、これは本物なのか……？\n　ううむ……」\\nw[伝承学者]",""],["「先生、竜の鉤爪とは何なんでしょうか？\\nw[\\N[2]]",""],["「大聖堂の閉架書庫で見た資料には、建国王が倒した\n　古代竜アルテトの爪かもしれないと、書いて\n　ありましたけど……」\\nw[\\N[2]]",""],["「そうか、キミたちは大聖堂の資料を見て、これを探し\n　出したのか」\\nw[伝承学者]",""],["「興味は無かったが、色々あってやむなく集めたんだ」\\nw[\\N[1]]",""],["「ふぅむ……これはアルテトの爪ではないな。\\nw[伝承学者]",""],["「成竜だったアルテトの爪にしては小さすぎる」\\nw[伝承学者]",""],["「え、そうなんですか？\\nw[\\N[2]]",""],["「しかしながら、古代竜の爪ではあるようだ。\n　おそらくは幼竜のものだろう」\\nw[伝承学者]",""],["「実は竜の鉤爪と一緒に、こんな粘土板も見つけたんだ。\\nw[\\N[1]]",""],["「専門家のあんたになら解読できるんじゃないかと\n　思って、わざわざここまで来たんだが」\\nw[\\N[1]]",""],["「興味深いな。\n　どれどれ……これは古代文字か。\\nw[伝承学者]",""],["「確かにこの種類の文字なら、多少時間はかかるが\n　翻訳は可能だ」\\nw[伝承学者]",""],["「本当ですか！？　じゃあこれの解読を――」\\nw[\\N[2]]",""],["「いや、いますぐに解読するのは無理だぞ？\n　なにせ私はここの発掘調査の真っ最中だから。\\nw[伝承学者]",""],["「発掘というのは時間と金がかかるんだ。\n　別のことに労力を割いている暇はない。\\nw[伝承学者]",""],["「もっとも……キミたちの出方次第では、\n　考えてやらないでもないが？（チラリ）」\\nw[伝承学者]",""],["「そうくると思って、肉体労働用の奴隷を３人連れて\n　きたぞ。\\nw[\\N[1]]",""],["「奴隷購入の費用が浮いて、発掘スピードも上がる。\n　これでどうだ？」\\nw[\\N[1]]",""],["「すぐに解読作業を始めよう」\\nw[伝承学者]",""],["（現金な人だなぁ……）\\nw[\\N[2]]",""],["伝承学者に\\C[17]奴隷３人\\C[0]と\\C[17]古代の粘土板\\C[0]を渡した。",""],["「解読が終わるまで、その辺りを見学しているといい。\\nw[伝承学者]",""],["「ただし、そこの\\C[17]魔法陣\\C[0]の中には入らないでくれ。\\nw[伝承学者]",""],["「まだ安全が確認できていないんだ。\n　なにが起こるか分からないのでね」\\nw[伝承学者]",""],["「じゃあお言葉に甘えて、発掘の見学といくか」\\nw[\\N[1]]",""],["発掘現場を見て回ろう！",""],["「今のは……」\\nw[\\N[1]]",""],["「オイッ！　魔法陣に入るなって言っただろうが！\n　バカかお前は！？」\\nw[伝承学者]",""],["「ん？　あれ？　いつの間に……？」\\nw[\\N[1]]",""],["「だ、大丈夫ですか、\\N[1]さん？\\nw[\\N[2]]",""],["「光が見えるとか言ったり、急に黙って魔法陣に入ったり、\n　さっきから様子が変ですよ？」\\nw[\\N[2]]",""],["「あー……大丈夫だ、問題ない。\n　ちょっと足元がフラついて、中に入っちまっただけだ」\\nw[\\N[1]]",""],["「まったく、気をつけてくれよ！\n　爆発でもしてたら、私たち全員あの世行きだったぞ！」\\nw[伝承学者]",""],["「悪かったよ、先生。\n　まあ何も起きなかったんだから、大目に見てくれ」\\nw[\\N[1]]",""],["「いい加減な男だな、キミは！」\\nw[伝承学者]",""],["「ところでちょっと聞きたいんだが、この遺跡は建国王と\n　なにか関係あったりするのか？」\\nw[\\N[1]]",""],["「ん？　うむ、遺跡自体は古代人の手によるものだが、\n　この空間は後から建国王が掘らせた可能性が高い。\\nw[伝承学者]",""],["「ただ、用途については不明だ。\n　その魔法陣が関係しているのだろうが……」\\nw[伝承学者]",""],["「なるほど……」\\nw[\\N[1]]",""],["「それより解読は終わったから、結果を読んだらさっさと\n　帰ってくれないか？」\\nw[伝承学者]",""],["「なに？　もう終わったのか？」\\nw[\\N[1]]",""],["「解読された内容は、これだそうです」\\nw[\\N[2]]",""],["『無垢なる幼き竜の爪三つより作りし魔法の呪物。\n　同種を縛り、封じるためにこれを生み出せり。",""],["『霊気宿る地にて力を集むるならば、\n　竜の使役もまた能うなり』",""],["「つまり竜の鉤爪とは、古代人が\\C[17]竜を封じたり操るため\\C[0]に\n　生み出したマジックアイテムってわけだ。\\nw[伝承学者]",""],["「建国王がこれを所持していたのなら、きっと\n　古代竜アルテトの討伐時に使ったのだろう」\\nw[伝承学者]",""],["「じゃあ、竜の鉤爪でアルテトの力を封じて、\n　そこを仕留めたんですか？」\\nw[\\N[2]]",""],["「たぶんそうだろうね。\\nw[伝承学者]",""],["「しかし古代竜が絶滅している現代では、歴史的な価値\n　こそあれ、マジックアイテムとしては無用の長物だな」\\nw[伝承学者]",""],["「いや、違う。\n　アルテトは封じられはしたが――」\\nw[\\N[1]]",""],["「\\N[1]さん？」\\nw[\\N[2]]",""],["「おい先生、大事な質問がある。\n　答えてくれ」\\nw[\\N[1]]",""],["「なんだ一体？　急に怖い顔をして」\\nw[伝承学者]",""],["「この竜の鉤爪、ブッ壊せば機能は失われるのか？」\\nw[\\N[1]]",""],["「そりゃ壊せば使えなくなる。当然だ」\\nw[伝承学者]",""],["「じゃあ、封印が機能し続けていた場合はどうだ？」\\nw[\\N[1]]",""],["「そりゃあ……封印が解けるんじゃないか？」\\nw[伝承学者]",""],["「かぁーっ！　やっぱりか！\n　となると、迂闊に壊して捨てることもできねぇ！」\\nw[\\N[1]]",""],["「歴史的な遺物を捨てるだと！？\n　ふざけたことを抜かすな！」\\nw[伝承学者]",""],["「さっきから何なんですか？\n　普段とは違った意味で変ですよ？」\\nw[\\N[2]]",""],["「うるさい、色々あるんだよ！\n　それと俺は平均的な成年男子で、どこも変じゃない」\\nw[\\N[1]]",""],["「キミは一度、平均の意味を辞書で引いてみるといい」\\nw[伝承学者]",""],["「\\N[2]、すぐに王都の貧民街へ戻るぞ。\n　あそこなら身をひそめるのに丁度いいからな」\\nw[\\N[1]]",""],["「はい？」\\nw[\\N[2]]",""],["「それと学者先生、あんたは竜の鉤爪や粘土板のことを\n　口外するな。命に関わるかもしれん」\\nw[伝承学者]",""],["「な、なんだと？　冗談を言うな」\\nw[伝承学者]",""],["「いいから信じろ。\n　今日会ったばかりのヤツでも、死なれたら寝覚めが\n　悪くなる」\\nw[\\N[1]]",""],["「わけが分かりませんよ。\n　なにか事情があるなら、ちゃんと説明を――」\\nw[\\N[2]]",""],["\\{「何だキサマッ？！」\\}\\nw[護衛の冒険者Ａ]",""],["\\{「ぐわああぁぁっ！！」\\}\\nw[護衛の冒険者Ａ]",""],["「くっ、曲者！？　遺跡荒らしの盗賊か！？」\\nw[伝承学者]",""],["アサシンとの戦闘\n↓　　↓　　↓",""],["「ふーっ……危ない危ない。いきなり襲ってきやがって」\\nw[\\N[1]]",""],["「な、なんだったんですかコイツ？！　強盗？」\\nw[\\N[2]]",""],["「いや、たぶん刺客だろう。\n　竜の鉤爪の回収と、事情を知る俺たちの暗殺が目的か」\\nw[\\N[1]]",""],["「まさか\\N[3]が雇ったんですか！？」\\nw[\\N[2]]",""],["「どうかな？\n　むしろ、その裏側にいるヤツの方が怪しいと思うぞ」\\nw[\\N[1]]",""],["「さっき言ってた命に関わるって、こういうことか！？\n　何が起こってるんだ！？」\\nw[伝承学者]",""],["「あんたは知らずにいた方がいい。\n　これ以上巻き込まれたくはないだろ？\\nw[\\N[1]]",""],["「それじゃこの黒づくめ野郎から、裏にいる人間の名前を\n　聞き出すか」\\nw[\\N[1]]",""],["「あっ！？　この人、死んでますよ！？」\\nw[\\N[2]]",""],["「くそっ、毒を飲んだか！\n　いらんプロ根性を発揮しやがって！」\\nw[\\N[1]]",""],["「最初から危険は承知してましたけど、こんな暗殺者まで\n　出てくるなんて、そこまでする価値が竜の鉤爪に\n　あるんですか？」\\nw[\\N[2]]",""],["「あるから寄越したんだろうよ。\\nw[\\N[1]]",""],["「このまま放置しておけば、第二第三の刺客が\n　来るかもな」\\nw[\\N[1]]",""],["「そんな！？」\\nw[\\N[2]]",""],["「……ともかく、ここを出て\\C[17]貧民街の酒場\\C[0]に戻るぞ。\n　詳しい話はそこでする。いいな？」\\nw[\\N[1]]",""],["「は……はい……」\\nw[\\N[2]]",""],["メインシナリオ\\C[17]『粘土板解読』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！",""],["メインシナリオ\\C[17]『黒幕は誰だ？』\\C[0]を受けた。",""],["「えらいことに巻き込んでくれたようだな」\\nw[伝承学者]",""],["「ここにはまだ、建国王が何かを残しているかもしれん。\n　徹底的に発掘してやる！」\\nw[伝承学者]",""],["魔法陣",""],["中に入るなと言われている。",""],["発掘助手",""],["「聞きたいことがあれば、どうぞ。\n　解説してさしあげますよ」\\nw[助手]",""],["この地下遺跡は何だ？",""],["なにを発掘しているんだ？",""],["あの学者先生はどういう人物？",""],["「ここは相当に古い遺跡で、王国成立よりずっと昔に\n　栄えていた古代人が造ったものと思われます。\\nw[助手]",""],["「ただし、いま我々がいるこの空間だけは後から掘られた\n　比較的新しいものですね」\\nw[助手]",""],["「建国王がこの遺跡に手を加えたらしいという記録が\n　見つかり、それを手掛かりに発掘したところ、ここ\n　を見つけたんです。\\nw[助手]",""],["「その魔法陣や壁の碑文などは、建国王の命令で設置\n　されたのでしょう。\n　信じられないほどの大発見ですよ！」\\nw[助手]",""],["「先生は行動する伝承学者なんです。\n　普通の伝承学者は文献調査ばかりしていますが、先生は\n　こうして大掛かりな発掘も行う。\\nw[助手]",""],["「伝承が真実かどうかを、自分の目で確かめないと気が\n　済まないのですよ。\\nw[助手]",""],["「ただ、発掘に私財を投じ過ぎたせいで、日々の生活にも\n　困窮する有様なんですが……」\\nw[助手]",""],["「賊ごときで、僕の探求心は止められませんよ！\n　さあ、聞きたいことがあればどうぞ！」\\nw[助手]",""],["碑文",""],["崩れた碑文がある。",""],["『この…………し魔…陣は、我…………の血を\n　……く……し者に……反応し……する。",""],["『後……秘事が伝わ…………た場合を……、これ……す\n　こと……る』",""],["「これじゃまったく意味が分からんな」\\nw[\\N[1]]",""],["「魔法陣について書いてあるんでしょうか？\\nw[\\N[2]]",""],["「なんとなく、重要そうな文面に思えますが……」\\nw[\\N[2]]",""],["伝承学者（作業中）",""],["「なにがあるか分からないから、魔法陣の中には\n　入らないように」\\nw[伝承学者]",""],["石柱",""],["「石柱だ。特に目を引くところはない」",""],["謎の光",""],["魔法陣Ev",""],["「な、なんだ！？　あの光は？\n　さっきまであんなもの無かったのに！？」\\nw[\\N[1]]",""],["「光？　どこですか？」\\nw[\\N[2]]",""],["「魔法陣の中心にあるだろうが！\n　ほれ、あれだ！」\\nw[\\N[1]]",""],["「え～？　分かんないです。\n　光なんてどこにもありませんよ？」\\nw[\\N[2]]",""],["「そんなわけ――」\\nw[\\N[1]]",""],["（そういや周りの人間も、まったく気づいた様子がないぞ。\n　まさか俺にしか見えてないのか？）\\nw[\\N[1]]",""],["「くっ！？　なんだっ、近づいて――」\\nw[\\N[1]]",""],["アサシン",""],["マーク",""],["回復魔法陣",""],["敵索敵スタート",""],["５層（発掘現場）",""]],"context":[["Map313/events/1/name"],["Map313/events/2/name"],["Map313/events/2/pages/0/list/0/message/noPicture/bottom"],["Map313/events/2/pages/0/list/2/Show Choices/2/1from2"],["Map313/events/2/pages/0/list/2/Show Choices/2/2from2"],["Map313/events/2/pages/0/list/18/Plugin Command"],["Map313/events/2/pages/0/list/19/Plugin Command"],["Map313/events/2/pages/0/list/20/Plugin Command"],["Map313/events/2/pages/0/list/24/Plugin Command"],["Map313/events/3/name"],["Map313/events/4/name"],["Map313/events/5/name"],["Map313/events/5/pages/0/list/2/message/noPicture/bottom"],["Map313/events/5/pages/0/list/17/mess