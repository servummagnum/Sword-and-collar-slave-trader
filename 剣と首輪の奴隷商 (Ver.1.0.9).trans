ages/0/list/19/comment"],["Map127/events/11/pages/0/list/21/message/noPicture/bottom"],["Map127/events/11/pages/0/list/26/message/noPicture/bottom"],["Map127/events/12/name"],["Map127/events/13/name"],["Map127/events/13/note"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":26,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"司祭":3,"EV005":4,"EV006":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「祈りましょう。\n　二度とモンスターがこの地を荒らさぬように」\\nw[尼僧]":11,"「今日も平穏で満ち足りた一日であらんことを」\\nw[尼僧]":12,"依頼フキダシ":13,"宝箱（消耗品正面開き）":14,"<TE:13>":15},"extension":"json","dataType":"map","filename":"Map127","basename":"Map127.json","path":"data/Map127.json","relPath":"data/Map127.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":16,"percent":0},"cellInfo":[]},"data/Map128.json":{"data":[["EV001",""],["EV002",""],["学僧",""],["「たとえ悪竜が死んでも、襲撃で殺された友人は生き返り\n　はしないんだ。はぁ……なんと虚しい……」\\nw[学僧]",""],["「友人の学僧がモンスターに殺されてしまった……。\n　信仰は無力なのか……」\\nw[学僧]",""],["「覚えなきゃならないことが多くて、ホントまいるよ」\\nw[学僧]",""],["「われわれ四聖教の総本山である\\C[17]大聖堂\\C[0]には、大規模な\n　写本室があるんだ。\n　そこで作られた写本は一般にも販売されているんだよ」\\nw[学僧]",""],["光",""],["燭台",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　『司教クラウハスの公開書簡』\n\\>\n\\>『……ゆえに、民無くして領主は無い。\n\\>　しかるに昨今の領主は重税を常のものとし、不作の\n\\>　ときにも平時と変わらぬ率をかける。\n\\>　\n\\>　北方の何某なる伯爵など「平民は飢えにも痛みにも\n\\>　強いから、酷使をためらう必要などない」と放言し\n\\>　たと聞く。\n\\>　まことに慈悲の欠片もなく、四聖神の教えにも背く\n\\>　言動と言わざるを得ない。\n\\>　\n\\>　この憂慮すべき現状をどう考え、どう改めるべきか。\n\\>　そも、改める意思があるのかを問うため、この公開\n\\>　書簡を王陛下に奉ずるものである』",""],["MWL_行数リセット",""],["\\>　　　　　　『異端審問官の心得』\n\\>\n\\>『殺人は背教と並び、戒律で最も厳しく戒められている\n\\>　のは誰もが知る通りである。\n\\>　故に、異端を疑われる者を取り調べるときは、相手が\n\\>　死んでしまわぬよう極力留意しなればならない。\n\\>　\n\\>　命を奪わずに最大限の苦痛を与えて自白を引き出す\n\\>　方法は、実のところそれほど多くない。\n\\>　ときに人間は信じがたいほど耐え忍び、自らの罪を\n\\>　隠し通そうとすることがあって――』",""]],"context":[["Map128/events/1/name"],["Map128/events/2/name"],["Map128/events/3/name","Map128/events/4/name"],["Map128/events/3/pages/0/list/1/message/noPicture/bottom"],["Map128/events/3/pages/0/list/8/message/noPicture/bottom"],["Map128/events/3/pages/0/list/13/message/noPicture/bottom"],["Map128/events/4/pages/0/list/0/message/noPicture/bottom"],["Map128/events/5/name"],["Map128/events/6/name"],["Map128/events/7/name","Map128/events/8/name"],["Map128/events/7/pages/0/list/2/Plugin Command","Map128/events/7/pages/1/list/2/Plugin Command","Map128/events/8/pages/0/list/2/Plugin Command","Map128/events/8/pages/1/list/2/Plugin Command"],["Map128/events/7/pages/0/list/3/scrollingMessage","Map128/events/7/pages/1/list/3/scrollingMessage"],["Map128/events/7/pages/0/list/19/Plugin Command","Map128/events/7/pages/1/list/19/Plugin Command","Map128/events/8/pages/0/list/15/Plugin Command","Map128/events/8/pages/1/list/15/Plugin Command"],["Map128/events/8/pages/0/list/3/scrollingMessage","Map128/events/8/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],null,null,null,null,["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"学僧":2,"「たとえ悪竜が死んでも、襲撃で殺された友人は生き返り\n　はしないんだ。はぁ……なんと虚しい……」\\nw[学僧]":3,"「友人の学僧がモンスターに殺されてしまった……。\n　信仰は無力なのか……」\\nw[学僧]":4,"「覚えなきゃならないことが多くて、ホントまいるよ」\\nw[学僧]":5,"「われわれ四聖教の総本山である\\C[17]大聖堂\\C[0]には、大規模な\n　写本室があるんだ。\n　そこで作られた写本は一般にも販売されているんだよ」\\nw[学僧]":6,"光":7,"燭台":8,"本":9,"MWL_行数変更 16":10,"\\>　　　　　『司教クラウハスの公開書簡』\n\\>\n\\>『……ゆえに、民無くして領主は無い。\n\\>　しかるに昨今の領主は重税を常のものとし、不作の\n\\>　ときにも平時と変わらぬ率をかける。\n\\>　\n\\>　北方の何某なる伯爵など「平民は飢えにも痛みにも\n\\>　強いから、酷使をためらう必要などない」と放言し\n\\>　たと聞く。\n\\>　まことに慈悲の欠片もなく、四聖神の教えにも背く\n\\>　言動と言わざるを得ない。\n\\>　\n\\>　この憂慮すべき現状をどう考え、どう改めるべきか。\n\\>　そも、改める意思があるのかを問うため、この公開\n\\>　書簡を王陛下に奉ずるものである』":11,"MWL_行数リセット":12,"\\>　　　　　　『異端審問官の心得』\n\\>\n\\>『殺人は背教と並び、戒律で最も厳しく戒められている\n\\>　のは誰もが知る通りである。\n\\>　故に、異端を疑われる者を取り調べるときは、相手が\n\\>　死んでしまわぬよう極力留意しなればならない。\n\\>　\n\\>　命を奪わずに最大限の苦痛を与えて自白を引き出す\n\\>　方法は、実のところそれほど多くない。\n\\>　ときに人間は信じがたいほど耐え忍び、自らの罪を\n\\>　隠し通そうとすることがあって――』":13},"extension":"json","dataType":"map","filename":"Map128","basename":"Map128.json","path":"data/Map128.json","relPath":"data/Map128.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":14,"percent":0},"cellInfo":[]},"data/Map129.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["司祭",""],["燭台",""],["光",""],["尼僧（依頼01・02）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「聖堂はいつでもあなた方に開かれています」\\nw[尼僧]",""],["依頼フキダシ",""],["女性",""],["「神様、どうか私をいびってくる姑に罰を下して\n　ください……」\\nw[女性]",""],["男",""],["「この前、骨董店で綺麗な玉を見つけたんで、行きつけの\n　娼館の娘にプレゼントしたんだ。\n　喜び方が微妙だったのが気になるけど……。\\nw[男性]",""],["「え？　\\C[17]ポータル球\\C[0]の可能性？\n　あははっ、本当にそうだったら凄いね」\\nw[男性]",""],["「娼館に行ったあとは、必ずここへ来るんだ。\n　ほら、なんていうか……金で女を抱くって、ちょっと\n　罪悪感があるでしょ？　だからね」\\nw[男性]",""]],"context":[["Map129/events/1/name"],["Map129/events/2/name"],["Map129/events/3/name"],["Map129/events/4/name"],["Map129/events/5/name"],["Map129/events/6/name"],["Map129/events/7/name","Map129/events/8/name"],["Map129/events/9/name","Map129/events/10/name"],["Map129/events/11/name"],["Map129/events/11/pages/0/list/0/comment"],["Map129/events/11/pages/0/list/19/comment"],["Map129/events/11/pages/0/list/20/message/noPicture/bottom"],["Map129/events/12/name"],["Map129/events/13/name"],["Map129/events/13/pages/1/list/0/message/noPicture/bottom"],["Map129/events/14/name"],["Map129/events/14/pages/0/list/1/message/noPicture/bottom"],["Map129/events/14/pages/0/list/5/message/noPicture/bottom"],["Map129/events/14/pages/0/list/10/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["gold"],["gold"],null,["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":10,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"司祭":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「聖堂はいつでもあなた方に開かれています」\\nw[尼僧]":11,"依頼フキダシ":12,"女性":13,"「神様、どうか私をいびってくる姑に罰を下して\n　ください……」\\nw[女性]":14,"男":15,"「この前、骨董店で綺麗な玉を見つけたんで、行きつけの\n　娼館の娘にプレゼントしたんだ。\n　喜び方が微妙だったのが気になるけど……。\\nw[男性]":16,"「え？　\\C[17]ポータル球\\C[0]の可能性？\n　あははっ、本当にそうだったら凄いね」\\nw[男性]":17,"「娼館に行ったあとは、必ずここへ来るんだ。\n　ほら、なんていうか……金で女を抱くって、ちょっと\n　罪悪感があるでしょ？　だからね」\\nw[男性]":18},"extension":"json","dataType":"map","filename":"Map129","basename":"Map129.json","path":"data/Map129.json","relPath":"data/Map129.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":19,"percent":0},"cellInfo":[]},"data/Map130.json":{"data":[["EV001",""],["EV002",""],["学僧",""],["「知っているかい？\n　死霊系モンスターに効く魔法は\\C[17]火魔法\\C[0]だけど、\n　悪魔系モンスターに効くのは\\C[17]地魔法\\C[0]なんだ。\\nw[学僧]",""],["「死霊も悪魔も似たようなものだと油断していると、\n　属性攻撃がうまく当たらないかもよ？」\\nw[学僧]",""],["燭台",""],["光",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　　　『聖句読解』\n\\>\n\\>『現代を生きる我々には古語で書かれた聖句が理解でき\n\\>　ず、なにやら神秘的な呪文であるかのように思って\n\\>　いることが往々にしてある。\n\\>　\n\\>　たとえば信徒の多くは『四聖神頌歌』に記されている\n\\>　あの有名な句「ハァ＝ドッコイショ、ドッコイショ」\n\\>　を、神々を讃える意味なのだろうと勘違いしている。\n\\>　しかしこれは大きな誤りだ。\n\\>　\n\\>　ドッコイショとは神々に己の罪を許してもらえるよう\n\\>　伏して懇願するための言葉なのである』",""],["MWL_行数リセット",""]],"context":[["Map130/events/1/name"],["Map130/events/2/name"],["Map130/events/3/name"],["Map130/events/3/pages/0/list/0/message/noPicture/bottom"],["Map130/events/3/pages/0/list/4/message/noPicture/bottom"],["Map130/events/4/name"],["Map130/events/5/name"],["Map130/events/6/name"],["Map130/events/6/note"],["Map130/events/7/name"],["Map130/events/7/pages/0/list/2/Plugin Command","Map130/events/7/pages/1/list/2/Plugin Command"],["Map130/events/7/pages/0/list/3/scrollingMessage","Map130/events/7/pages/1/list/3/scrollingMessage"],["Map130/events/7/pages/0/list/17/Plugin Command","Map130/events/7/pages/1/list/17/Plugin Command"]],"tags":[["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],null,["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],null,null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"学僧":2,"「知っているかい？\n　死霊系モンスターに効く魔法は\\C[17]火魔法\\C[0]だけど、\n　悪魔系モンスターに効くのは\\C[17]地魔法\\C[0]なんだ。\\nw[学僧]":3,"「死霊も悪魔も似たようなものだと油断していると、\n　属性攻撃がうまく当たらないかもよ？」\\nw[学僧]":4,"燭台":5,"光":6,"宝箱（消耗品正面開き）":7,"<TE:13>":8,"本":9,"MWL_行数変更 16":10,"\\>　　　　　　　　　『聖句読解』\n\\>\n\\>『現代を生きる我々には古語で書かれた聖句が理解でき\n\\>　ず、なにやら神秘的な呪文であるかのように思って\n\\>　いることが往々にしてある。\n\\>　\n\\>　たとえば信徒の多くは『四聖神頌歌』に記されている\n\\>　あの有名な句「ハァ＝ドッコイショ、ドッコイショ」\n\\>　を、神々を讃える意味なのだろうと勘違いしている。\n\\>　しかしこれは大きな誤りだ。\n\\>　\n\\>　ドッコイショとは神々に己の罪を許してもらえるよう\n\\>　伏して懇願するための言葉なのである』":11,"MWL_行数リセット":12},"extension":"json","dataType":"map","filename":"Map130","basename":"Map130.json","path":"data/Map130.json","relPath":"data/Map130.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":13,"percent":0},"cellInfo":[]},"data/Map131.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["司祭",""],["燭台",""],["光",""],["尼僧（依頼01・02）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「真剣に祈れば、願いは通じるものですよ」\\nw[尼僧]",""],["依頼フキダシ",""],["男",""],["「広場でやたらとイキがってる芸術家がいるだろ？\n　あの野郎、変な玉っころを\\C[17]伝説のポータル球\\C[0]だとか\n　ぬかして俺に売りつけようとしやがったんだぜ」\\nw[男性]",""],["「イキリ芸術家がまた逮捕されたらしいな。\n　ざまぁないぜ！　……っと、神前で悪口はまずいな」\\nw[男性]",""]],"context":[["Map131/events/1/name"],["Map131/events/2/name"],["Map131/events/3/name"],["Map131/events/4/name"],["Map131/events/5/name"],["Map131/events/6/name"],["Map131/events/7/name","Map131/events/8/name"],["Map131/events/9/name","Map131/events/10/name"],["Map131/events/11/name"],["Map131/events/11/pages/0/list/0/comment"],["Map131/events/11/pages/0/list/19/comment"],["Map131/events/11/pages/0/list/20/message/noPicture/bottom"],["Map131/events/12/name"],["Map131/events/13/name"],["Map131/events/13/pages/0/list/1/message/noPicture/bottom"],["Map131/events/13/pages/0/list/7/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"司祭":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「真剣に祈れば、願いは通じるものですよ」\\nw[尼僧]":11,"依頼フキダシ":12,"男":13,"「広場でやたらとイキがってる芸術家がいるだろ？\n　あの野郎、変な玉っころを\\C[17]伝説のポータル球\\C[0]だとか\n　ぬかして俺に売りつけようとしやがったんだぜ」\\nw[男性]":14,"「イキリ芸術家がまた逮捕されたらしいな。\n　ざまぁないぜ！　……っと、神前で悪口はまずいな」\\nw[男性]":15},"extension":"json","dataType":"map","filename":"Map131","basename":"Map131.json","path":"data/Map131.json","relPath":"data/Map131.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":16,"percent":0},"cellInfo":[]},"data/Map132.json":{"data":[["EV001",""],["EV002",""],["燭台",""],["光",""],["学僧",""],["「聖堂で売っていない薬には\\C[17]筋肉増強剤\\C[0]や\\C[17]瞬発剤\\C[0]といった\n　強化薬のたぐいがある。\n　これらはステータスを底上げしてくれる貴重な品なんだよ」\\nw[学僧]",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　『四聖教絵画の図像学』\n\\>\n\\>『……とりわけ好んで象徴的に描かれることが多いのが\n\\>　地の神のシンボルである乙女、あるいは女性形の天使\n\\>　である。\n\\>　\n\\>　農業を基盤とする社会では、豊穣に関与する地の神と\n\\>　水の神への崇敬が篤くなることは当然といえようが、\n\\>　女性のシンボルが特に好まれる背景には、四聖教とは\n\\>　異なる信仰体系に由来する大地母神の影響を考える\n\\>　必要があるかもしれない。\n\\>\n\\>　古い絵画や彫刻の乙女ほど控えめな胸に表現されて\n\\>　おり、時代が下るほどに巨乳化していくのは、象徴\n\\>　としての在り様が乙女から母へと変化していったため\n\\>　だと考えれば……』",""],["MWL_行数リセット",""]],"context":[["Map132/events/1/name"],["Map132/events/2/name"],["Map132/events/3/name"],["Map132/events/4/name"],["Map132/events/5/name"],["Map132/events/5/pages/0/list/0/message/noPicture/bottom"],["Map132/events/6/name"],["Map132/events/6/pages/0/list/2/Plugin Command","Map132/events/6/pages/1/list/2/Plugin Command"],["Map132/events/6/pages/0/list/3/scrollingMessage","Map132/events/6/pages/1/list/3/scrollingMessage"],["Map132/events/6/pages/0/list/20/Plugin Command","Map132/events/6/pages/1/list/20/Plugin Command"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"燭台":2,"光":3,"学僧":4,"「聖堂で売っていない薬には\\C[17]筋肉増強剤\\C[0]や\\C[17]瞬発剤\\C[0]といった\n　強化薬のたぐいがある。\n　これらはステータスを底上げしてくれる貴重な品なんだよ」\\nw[学僧]":5,"本":6,"MWL_行数変更 16":7,"\\>　　　　　　『四聖教絵画の図像学』\n\\>\n\\>『……とりわけ好んで象徴的に描かれることが多いのが\n\\>　地の神のシンボルである乙女、あるいは女性形の天使\n\\>　である。\n\\>　\n\\>　農業を基盤とする社会では、豊穣に関与する地の神と\n\\>　水の神への崇敬が篤くなることは当然といえようが、\n\\>　女性のシンボルが特に好まれる背景には、四聖教とは\n\\>　異なる信仰体系に由来する大地母神の影響を考える\n\\>　必要があるかもしれない。\n\\>\n\\>　古い絵画や彫刻の乙女ほど控えめな胸に表現されて\n\\>　おり、時代が下るほどに巨乳化していくのは、象徴\n\\>　としての在り様が乙女から母へと変化していったため\n\\>　だと考えれば……』":8,"MWL_行数リセット":9},"extension":"json","dataType":"map","filename":"Map132","basename":"Map132.json","path":"data/Map132.json","relPath":"data/Map132.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":10,"percent":0},"cellInfo":[]},"data/Map133.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["司祭",""],["燭台",""],["光",""],["尼僧（依頼01・02）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「ここは水の神と精霊の力が強い土地です。\n　ぜひ水神に祈りを」\\nw[尼僧]",""],["依頼フキダシ",""],["女",""],["「よく港のあたりを散策してる好事家の人が、先日すごく\n　きれいな球体を見せてくれたのよ。\\nw[女性]",""],["「\\C[17]伝説のポータル球\\C[0]かもって言ってたけど、さすがに\n　それはないわよねぇ」\\nw[女性]",""],["「神々に航海の無事を祈っても、結局海は気まぐれで\n　沈むときは沈むのよね……」\\nw[女性]",""]],"context":[["Map133/events/1/name"],["Map133/events/2/name"],["Map133/events/3/name"],["Map133/events/4/name"],["Map133/events/5/name"],["Map133/events/6/name"],["Map133/events/7/name","Map133/events/8/name"],["Map133/events/9/name","Map133/events/10/name"],["Map133/events/11/name"],["Map133/events/11/pages/0/list/0/comment"],["Map133/events/11/pages/0/list/19/comment"],["Map133/events/11/pages/0/list/20/message/noPicture/bottom"],["Map133/events/12/name"],["Map133/events/13/name"],["Map133/events/13/pages/0/list/1/message/noPicture/bottom"],["Map133/events/13/pages/0/list/4/message/noPicture/bottom"],["Map133/events/13/pages/0/list/9/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"司祭":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「ここは水の神と精霊の力が強い土地です。\n　ぜひ水神に祈りを」\\nw[尼僧]":11,"依頼フキダシ":12,"女":13,"「よく港のあたりを散策してる好事家の人が、先日すごく\n　きれいな球体を見せてくれたのよ。\\nw[女性]":14,"「\\C[17]伝説のポータル球\\C[0]かもって言ってたけど、さすがに\n　それはないわよねぇ」\\nw[女性]":15,"「神々に航海の無事を祈っても、結局海は気まぐれで\n　沈むときは沈むのよね……」\\nw[女性]":16},"extension":"json","dataType":"map","filename":"Map133","basename":"Map133.json","path":"data/Map133.json","relPath":"data/Map133.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":17,"percent":0},"cellInfo":[]},"data/Map134.json":{"data":[["EV001",""],["EV002",""],["学僧",""],["「僕は歴史を学びたくて四聖教の僧侶になったんだ。\n　子供のときに読んだ、建国王の竜退治の物語がきっかけ\n　でね」\\nw[学僧]",""],["燭台",""],["光",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　『不可解な乙女・ハーピー』\n\\>\n\\>『……この「ハーピー亜人説」は、議論の中心であった\n\\>　博物学界の枠を超えて、大きな論争を巻き起こした。\n\\>　\n\\>　特に否定的な反応を示して亜人説を批難したのは、\n\\>　他でもない商人たちだった。\n\\>　当時はハーピーの羽根が高値で取り引きされており、\n\\>　この羽根を目的とした乱獲が横行していたのだ。\n\\>　\n\\>　もしハーピーが魔物ではないということになれば、\n\\>　法によって利益目的の捕獲は禁止されることになる。\n\\>　それを恐れた商人たちは……』",""],["MWL_行数リセット",""]],"context":[["Map134/events/1/name"],["Map134/events/2/name"],["Map134/events/3/name"],["Map134/events/3/pages/0/list/0/message/noPicture/bottom"],["Map134/events/4/name"],["Map134/events/5/name"],["Map134/events/6/name"],["Map134/events/6/pages/0/list/2/Plugin Command","Map134/events/6/pages/1/list/2/Plugin Command"],["Map134/events/6/pages/0/list/3/scrollingMessage","Map134/events/6/pages/1/list/3/scrollingMessage"],["Map134/events/6/pages/0/list/17/Plugin Command","Map134/events/6/pages/1/list/17/Plugin Command"]],"tags":[["gold"],["gold"],["gold"],null,["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"学僧":2,"「僕は歴史を学びたくて四聖教の僧侶になったんだ。\n　子供のときに読んだ、建国王の竜退治の物語がきっかけ\n　でね」\\nw[学僧]":3,"燭台":4,"光":5,"本":6,"MWL_行数変更 16":7,"\\>　　　　　　『不可解な乙女・ハーピー』\n\\>\n\\>『……この「ハーピー亜人説」は、議論の中心であった\n\\>　博物学界の枠を超えて、大きな論争を巻き起こした。\n\\>　\n\\>　特に否定的な反応を示して亜人説を批難したのは、\n\\>　他でもない商人たちだった。\n\\>　当時はハーピーの羽根が高値で取り引きされており、\n\\>　この羽根を目的とした乱獲が横行していたのだ。\n\\>　\n\\>　もしハーピーが魔物ではないということになれば、\n\\>　法によって利益目的の捕獲は禁止されることになる。\n\\>　それを恐れた商人たちは……』":8,"MWL_行数リセット":9},"extension":"json","dataType":"map","filename":"Map134","basename":"Map134.json","path":"data/Map134.json","relPath":"data/Map134.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":10,"percent":0},"cellInfo":[]},"data/Map135.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["司祭",""],["EV005",""],["EV006",""],["燭台",""],["光",""],["尼僧（依頼01・02）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「神のご加護があれば、悪竜など恐るるに足りません」\\nw[尼僧]",""],["「大司教様は背教の疑いで拘束されてしまいました……。\n　ああ、なんてこと……\\}いい気味だわ！　あのエロおやじ！」\\nw[尼僧]",""],["「総本山の大聖堂ほどではありませんが、この王都聖堂も\n　なかなかのものでしょう？」\\nw[尼僧]",""],["依頼フキダシ",""],["僧侶",""],["所持金不足",""],["\\C[17]１０万Ｇ\\C[0]を寄付するのに、所持金が足りない。",""],["「しまった！　つい他のことに使っちまって……。\n　急いで１０万Ｇまで金を貯めないと」\\nw[\\N[1]]",""],["「うへへへっ、ちょっといいっすかねぇ？」\\nw[\\N[1]]",""],["「はい、なんでしょうか？」\\nw[僧侶]",""],["「あっしは\\N[1]っていう、しがない奴隷商人\n　なんですがね、ぜひ大司教様に商売の成功を\n　祈っていただきたいんでさぁ」\\nw[\\N[1]]",""],["（ゲスな演技が、すごい板についてる……）\\nw[\\N[2]]",""],["「この通り、聖堂への寄付金も持ってきてるんで」\\nw[\\N[1]]",""],["「それはそれは、ご丁寧に……」\\nw[僧侶]",""],["（まぁーた、大司教様に取り入ろうって輩か。\n　こういう怪しいヤツばかり、よく来るよなぁ）\\nw[僧侶]",""],["「寄付金はありがたいのですが、大司教様は多忙なため、\n　直接お会いになるのは無理でして――」\\nw[僧侶]",""],["「１０万Ｇ用意してきたんですがねぇ、\n　会えないなら仕方ねぇや。\n　今日は帰らせてもらいましょうかね」\\nw[\\N[1]]",""],["「じっ、じうまん！？\n　えっと、ちょっと待って――お待ちください！\\nw[僧侶]",""],["「ただいま大司教様のご予定を確認してきますので！」\\nw[僧侶]",""],["「奴隷二人の連れ込みは、聖堂の裏口からお願いします。\n　正面からだと目立つので」\\nw[僧侶]",""],["トークマーク",""],["大司教（寄付Ev）",""],["「わははっ、お待たせしましたね。\n　なんでも１０万Ｇもの寄付をしてくれるとか？」\\nw[大司教]",""],["「ええ！\n　あっしは信心深い男でして、ぜひに大司教様の\n　お祈りを受けたいと思いましてね。\\nw[\\N[1]]",""],["「特に商売繁盛！\n　そう、商売繁盛のお祈りをね！」\\nw[\\N[1]]",""],["「そうですか、そうですか。\n　１０万Ｇの寄付とは良い心がけですね。\\nw[大司教]",""],["「神々もきっと、あなたの誠心を祝福されるでしょう！\\nw[大司教]",""],["「私もあなたの商売の成功を口利き――ではなくて、祈りで\n　応援するとしましょう」\\nw[大司教]",""],["「うぇへへへっ！\n　ありがとうごぜぇます！」\\nw[\\N[1]]",""],["\\C[17]１０万Ｇ\\C[0]を王都聖堂に寄付した！",""],["（こんなところで、癒着が生まれる瞬間を見るなんて……。\n　\\N[3]もこういうこと、やってるのかなぁ……？）\\nw[\\N[2]]",""],["「それと大司教様に、ひとつお願いしたいことが」\\nw[\\N[1]]",""],["「なんですか？」\\nw[大司教]",""],["「実はあっしの扱ってる奴隷の中に、信仰心の篤い女が\n　いましてね。\\nw[\\N[1]]",""],["「その女奴隷にひとつ、ありがたい説教をしてやっちゃ\n　もらえませんか？\\nw[\\N[1]]",""],["「そんで、もしよければ、そのまま王都聖堂の飼い犬――\n　もとい、使用人にしていただければと」\\nw[\\N[1]]",""],["「ほっほぅ！　それは素晴らしい心がけだ！\n　いいでしょう、連れてきなさい！\\nw[大司教]",""],["「誠意をこめて、セック……じゃなくて説教して\n　あげましょう！」\\nw[大司教]",""],["「ありがとうごぜぇます！」\\nw[\\N[1]]",""],["「ところで、そっちの猫人の娘も奴隷かね？」\\nw[大司教]",""],["「え？　ええ……まあ……」\\nw[\\N[1]]",""],["「なら、その娘も一緒に私のところへ来させなさい。\n　二人まとめて、せっｋ……きょうしてあげましょう」\\nw[大司教]",""],["「えっ…………わ、わたしも？」\\nw[\\N[2]]",""],["「えっ…………\\{はぁっ！？\\}」\\nw[\\N[2]]",""],["「い……いやいや、大司教様、この娘は礼儀知らずの\n　山猫で、とてもおそばに上げるわけには――」\\nw[\\N[1]]",""],["「かまいませんとも。\n　そういう娘をしつけるのも、聖職者の務めです」\\nw[大司教]",""],["「そうそう、奴隷二人を連れてくるときは、\\C[17]聖堂の裏口\\C[0]\n　から入るように。\\nw[大司教]",""],["「信徒に見られるとマズいのでね。\n　なにがとは言わんけど。\\nw[大司教]",""],["「では、楽しみに待っていますよ」\\nw[大司教]",""],["「ちょっ……大司教さまっ！？」\\nw[\\N[1]]",""],["「これってもしかして、わたしもあの脂ぎった大司教に\n　エッチなことされちゃうんですかぁ\\I[29]」\\nw[\\N[2]]",""],["「ええぇぇっ！？\n　ちょっと、これどうするんですかぁ！？」\\nw[\\N[2]]",""],["\n\\>　　　※　一度、\\C[17]スパイ尼僧\\C[0]のところへ戻ろう　※",""],["ユマ",""],["裏口",""],["鍵がかかっていて開かない。",""],["通行禁止",""],["奴隷を連れていく先は聖堂の２階だ。",""],["目立つ正面入り口の方へ出るわけにはいかない。",""],["僧侶（警告）",""],["「大司教様が欲得にまみれた俗物なのは、薄々わかって\n　いました。\n　しかし背教者として弾劾されるほどとは……」\\nw[僧侶]",""],["「写本作りは忍耐心との勝負ですよ」\\nw[僧侶]",""],["「二階は大司教様の私室ですので、上がらないで\n　ください」\\nw[僧侶]",""],["商人",""],["「大司教の失脚に加えて悪竜だと！？\n　ああもうっ、オレの商売が滅茶苦茶だ……！」\\nw[怪しい商人]",""],["「大司教が失脚しやがった！　くそっ、役立たずめ！！\n　なんのためにせっせと賄賂を贈ってきたと思ってんだ！」\\nw[怪しい商人]",""],["「この大聖堂へはかなりの額を寄付したよ。\n　尽くす者に、神は大きなリターンをくださるからねぇ」\\nw[怪しい商人]",""],["尼僧",""],["「\\N[6]が甦ったという話が本当だとしても、\n　神が必ずや我々を守ってくださいます」\\nw[尼僧]",""],["「大司教様が背教の疑いで拘束されたとか……。\n　まったく嘆かわしいことです」\\nw[尼僧]",""],["「ここは遠方から来られた信者のための宿泊室です。\n　あなた方には……必要ないようですね」\\nw[尼僧]",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　『死霊・死体モンスター概論』\n\\>\n\\>『……次に耐性についてだが、これら死霊・死体系の\n\\>　モンスターには毒と睡眠がまったく効かない。\n\\>　\n\\>　死んでいるから毒が回らないし、睡眠をとることも\n\\>　ないのだろうが、では混乱や魅了が有効なのはなぜ\n\\>　なのか？\n\n\\>　これに関しては様々な説がある。\n\\>　いまだに魂の一部が残っているため、感情の働きが\n\\>　あって魅了されるのだと主張する者もいるし……』",""],["MWL_行数リセット",""],["\\>　　　　　　『暴れん坊司教　第四巻』\n\\>\n\\>『「この顔を見忘れたか！」\n\\>　\n\\>　そう一喝された問屋の旦那は、男の顔をまじまじと\n\\>　見直し、そして突如として顔色を変えた。\n\\>　\n\\>　「おっ、お前はあのときの遊び人に尻を貸していた\n\\>　　男娼！？」\n\\>　「ようやく思い出したか。貴様の悪事、しかとこの\n\\>　　目で確かめていたぞ！」\n\\>　　\n\\>　これには居並ぶ悪党ども驚き、皆の視線が司教の尻\n\\>　に集中したのだった』",""],["武器商ギルド秘密文書（縦）",""],["<TE:74>",""],["出口マーク",""],["女",""],["「物乞いにお金をあげるなんて無駄だって言う人もいる\n　けど、わたしは巡り巡って自分にも良い事が返ってくる\n　と思うの」\\nw[女性客]",""],["「噂じゃ最近、物乞いの人に大金を配る義賊が出没してる\n　らしいわ」\\nw[女性客]",""]],"context":[["Map135/events/1/name"],["Map135/events/2/name"],["Map135/events/3/name"],["Map135/events/4/name"],["Map135/events/5/name"],["Map135/events/6/name"],["Map135/events/7/name","Map135/events/8/name","Map135/events/9/name","Map135/events/10/name","Map135/events/24/name"],["Map135/events/11/name","Map135/events/12/name","Map135/events/13/name","Map135/events/14/name","Map135/events/25/name"],["Map135/events/15/name"],["Map135/events/15/pages/0/list/0/comment"],["Map135/events/15/pages/0/list/19/comment"],["Map135/events/15/pages/0/list/21/message/noPicture/bottom"],["Map135/events/15/pages/0/list/27/message/noPicture/bottom"],["Map135/events/15/pages/0/list/32/message/noPicture/bottom"],["Map135/events/16/name"],["Map135/events/17/name"],["Map135/events/17/pages/0/list/2/comment"],["Map135/events/17/pages/0/list/4/message/noPicture/bottom"],["Map135/events/17/pages/0/list/10/message/noPicture/bottom"],["Map135/events/17/pages/0/list/35/message/noPicture/bottom"],["Map135/events/17/pages/0/list/39/message/noPicture/bottom"],["Map135/events/17/pages/0/list/43/message/noPicture/bottom"],["Map135/events/17/pages/0/list/50/message/noPicture/bottom"],["Map135/events/17/pages/0/list/54/message/noPicture/bottom"],["Map135/events/17/pages/0/list/57/message/noPictur