:6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":19,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":21,"headerParam":["↓アイテムの重量を変数に入力する"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"兵士":0,"メイド1":1,"「この使用人部屋に引き篭もってれば、大丈夫……\n　きっと大丈夫よ……」\\nw[メイド]":2,"「大公様が……そんな……。\n　これから私のお給金は誰が払ってくれるの……？」\\nw[メイド]":3,"「チェリア様が王都へ行ってしまったから、宮殿内が\n　なんだか寂しくなってしまったわ」\\nw[メイド]":4,"燭台":5,"光":6,"EV016":7,"EV017":8,"EV018":9,"EV019":10,"EV020":11,"EV021":12,"引き返し":13,"兵士に見つかると騒ぎになってしまう。\nこの先へ行くのはやめておこう。":14,"メイド（恩返し前）":15,"「あなたたちは、私を盗賊から救ってくれた……！？\n　どうして宮殿の中に？\\nw[メイド]":16,"「いえ、詮索はよしておきましょう。\n　それよりも、今度会ったらお礼をすると約束しました\n　よね。\\nw[メイド]":17,"「大したものではありませんが、どうぞ、\n　そちらの\\C[17]宝箱\\C[0]を」\\nw[メイド]":18,"EV034":19,"宝箱（防具）":20,"※\n防具：メイド服\n※":21,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":22,"↓アイテムのIDNo.を変数に入力する":23,"↓アイテムの入手個数を変数に入力する":24,"↓アイテムの重量を変数に入力する":25,"メイド（恩返し後）":26,"「命の恩人ですからここは見て見ぬふりしますが、\n　警備兵に見つかる前に逃げてくださいね」\\nw[メイド]":27,"「命の恩人ですからここは見て見ぬふりしますが、\n　勝手に入ってきたらダメですよ」\\nw[メイド]":28,"防壁":29,"使用人2":30,"「兵士がバリケードを構築してるけど、この宮殿の中に\n　までモンスターが入ってくるのだろうか？」\\nw[使用人]":31,"「モンスターには襲われずに済んだけど、まさか大公様が\n　お亡くなりになってしまうなんて……」\\nw[使用人]":32},"extension":"json","dataType":"map","filename":"Map325","basename":"Map325.json","path":"data/Map325.json","relPath":"data/Map325.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":33,"percent":0},"cellInfo":[]},"data/Map326.json":{"data":[["燭台",""],["光",""],["防壁",""],["血糊",""],["EV019",""],["EV020",""],["EV021",""],["死体",""],["すでにこと切れている。",""],["ラーナ",""],["大公",""],["主人公（身代わり）",""],["乱入兵士1",""],["乱入兵士2",""],["乱入兵士3",""],["乱入兵士4",""],["ユマ（姫vs大公Ev）",""],["「こ、これはどういうことだ！？\n　答えろ！　\\N[5]！」\\nw[パルフューク大公]",""],["「いやですわ、叔父上。\n　挨拶に立ち寄っただけなのに、そんな怖い顔なさるなんて」\\nw[\\N[5]]",""],["「ふざけるな！\n　お前は……お前はなんなのだ！？\\nw[パルフューク大公]",""],["「突然一人で現れたかと思ったら、あっという間に\n　護衛の兵を皆殺しにするなど――。\\nw[パルフューク大公]",""],["「人間の所業とは思えぬ……！\n　本当に\\N[5]なのか！？」\\nw[パルフューク大公]",""],["「ええ、もちろん。\n　あなたの可愛い姪っ子の、\\N[5]ですわ\\I[29]」\\nw[\\N[5]]",""],["「わたし、とても悲しく思っていますのよ？\\nw[\\N[5]]",""],["「簒奪のために悪竜アルテトを甦らせ、わたしと父上を\n　殺そうだなんて――本当に叔父上は酷い人♪」\\nw[\\N[5]]",""],["「簒奪！？　なにをバカなことを！」\\nw[パルフューク大公]",""],["「バカなのは叔父上でしょう？\\nw[\\N[5]]",""],["「甦らせたアルテトを御しきれず、逆に襲われて\n　こんな有様に……うふふ♪」\\nw[\\N[5]]",""],["「私に悪竜復活の罪をなすりつけるつもりか！？\n　そのために街の人間まで巻き込んで……おのれっ！\\nw[パルフューク大公]",""],["「何が目的だ！？\n　次の王位が約束されていながら、なぜこのような暴挙を\n　行う！？\\nw[パルフューク大公]",""],["「私が本当に簒奪するのではないかと、疑心暗鬼に\n　駆られたか！？」\\nw[パルフューク大公]",""],["「叔父上は勘違いをされています。\n　王位のことなど、まったく関係ありませんのに」\\nw[\\N[5]]",""],["「な、なに……？　では一体……」\\nw[パルフューク大公]",""],["「……少し、昔話をいたしましょうか」\\nw[\\N[5]]",""],["createFilter 1 shockwave 0",""],["setFilter 1 408 312 -1 30 160 1",""],["moveFilter 1 408 312 -1 50 250 2 120",""],["eraseFilter 1",""],["「およそ５００年前のこと。\\nw[\\N[5]]",""],["「悪逆非道の限りを尽くした古代竜アルテトは、\n　人間たちの指導者であったリジェルダによって\n　追い詰められていました」\\nw[\\N[5]]",""],["createFilter 1 dot 0",""],["setFilter 1 5 3",""],["「世間で噂される通り、アルテトの呪いは現代に到るまで\n　続いているのですよ。\\nw[\\N[5]]",""],["「現在の国王――父上も、すでに余命幾ばくもないでしょう」\\nw[\\N[5]]",""],["「陛下の健康に不安があることなど、とうに承知して\n　いる！\\nw[パルフューク大公]",""],["「私が聞きたいのは――」\\nw[パルフューク大公]",""],["「叔父上。\n　建国王リジェルダに撃ち込まれたアルテトの魂の一部は、\n　その後どうなったと思います？」\\nw[\\N[5]]",""],["「な、なに……？」\\nw[パルフューク大公]",""],["「アルテトの魂の欠片は、リジェルダの血とともに、\n　その子々孫々の身体へと受け継がれていったのです。\\nw[\\N[5]]",""],["「内部からリジェルダの子孫の寿命を奪いつつ、少しずつ\n　少しずつ力を蓄えていったアルテトの魂――。\\nw[\\N[5]]",""],["「最初は意識すらない弱々しい欠片でした。\\nw[\\N[5]]",""],["「でも、５００年の刻を費やしてついに、リジェルダの\n　末孫の中で自我を得るまでに成長できました」\\nw[\\N[5]]",""],["「で、ではっ……まさかお前がっ！？\n　\\N[5]ッ、お前が……！」\\nw[パルフューク大公]",""],["「はい。\n　\\C[17]わたしこそが伝説の悪竜\\C[0]ですわ\\I[29]」\\nw[\\N[5]]",""],["「その姿は！？　その四本の角はッ！！」\\nw[パルフューク大公]",""],["「改めましてごきげんよう、叔父上。\\nw[\\N[5]]",""],["「\\C[27]わたしは\\N[5]。\\C[0]\n　\\C[18]そして\\N[6]。\\C[0]\\nw[\\N[5]]",""],["「\\C[27]あなたたちの血族にして、\\C[18]お前たちの血の宿敵\\C[0]」\\nw[\\N[5]=\\N[6]]",""],["「こっ、こんな……なんたることだ！\\nw[パルフューク大公]",""],["「次の王たる者が、あの悪竜だというのかぁッ！！？」\\nw[パルフューク大公]",""],["「その悪竜を甦らせた極悪人の叔父上には、ここで死んで\n　もらいます♪\\nw[\\N[5]=\\N[6]]",""],["「そして５００年ぶりに再開される『悪竜アルテト』との\n　戦争では、女王たるわたしが指揮を執ることとなり\n　ましょう」\\nw[\\N[5]=\\N[6]]",""],["「流れる血と悲鳴、恐怖にゆがむ顔と心。\n　\\C[27]わたし\\C[0]の命令で、皆が\\C[18]わたし\\C[0]に殺されていくのです。\\nw[\\N[5]=\\N[6]]",""],["「最高の娯楽である人間の絶望を、今度こそ\n　心ゆくまで味わわせてもらいますわ\\I[29]」\\nw[\\N[5]=\\N[6]]",""],["「そんな茶番の惨劇を仕組むために、お前はお前の本体を\n　甦らせたのか！？\\nw[パルフューク大公]",""],["「このッ……バケモノめぇッ！！\n　くらえッ！！」\\nw[パルフューク大公]",""],["「どうだッ！\n　遠祖リジェルダより伝わりし必殺の剣の味は！」\\nw[パルフューク大公]",""],["「必殺の剣？　これが？\\nw[\\N[5]=\\N[6]]",""],["「あははははっ！\n　子孫がこのていたらくでは、リジェルダのやつも\n　浮かばれないでしょうね！」\\nw[\\N[5]=\\N[6]]",""],["「そんなッ？！　効いていないのか！？」\\nw[パルフューク大公]",""],["「では次はこちらの番ですわね。\n　――さようなら、叔父上」\\nw[\\N[5]=\\N[6]]",""],["FocusCamera 17 19 40",""],["「チッ！　まずいっ！」\\nw[\\N[1]]",""],["FocusCamera 18 27 40",""],["「逃げろ！　大公！\n　はやく――」\\nw[\\N[1]]",""],["「こんがり焼けましたわね、叔父上。\n　おいしそうな匂いですこと♪\\nw[\\N[5]=\\N[6]]",""],["「さあて、焼かなければならない虫がもう一匹……\n　いえ、二匹かしら？\n　ノコノコと現れたようね。\\nw[\\N[5]=\\N[6]]",""],["「せっかく拾った命を、自分から捨てにくるなんて\n　物好きなこと。うふふふ……」\\nw[\\N[5]=\\N[6]]",""],["FocusCamera 17 23 70",""],["「\\N[5]……いや、\\N[6]！\n　お前は人間のことを見くびり過ぎだ！\\nw[\\N[1]]",""],["「建国王に敗れておきながら、まだ分かってない\n　ようだな！」\\nw[\\N[1]]",""],["「あらあら、もしかしてわたしに勝てる気でいるのかしら？\\nw[\\N[5]=\\N[6]]",""],["「竜の寝床では、尻尾を巻いて無様に逃げ出したくせに」\\nw[\\N[5]=\\N[6]]",""],["「だがお前は俺たちを殺しきれなかった。\n　たかだか商人と奴隷の二人をな」\\nw[\\N[1]]",""],["「…………」\\nw[\\N[5]=\\N[6]]",""],["（たしかにあれは妙だったわ……。\n　なにかカラクリがあるのかしら？）\\nw[\\N[5]=\\N[6]]",""],["「それと、お前自身が\\N[6]であるなら、なぜさっさと\n　鉤爪を壊して復活せず、わざわざ竜の寝床にまで\n　運ばせた？\\nw[\\N[1]]",""],["「壊さずに封印を解かなきゃならん理由でもあったか？\n　だとすれば、そこにお前の弱味が――」\\nw[\\N[1]]",""],["「ハッ！　くだらないわね！\n　妄想を垂れ流すのはそこまでにしてくれる？\\nw[\\N[5]=\\N[6]]",""],["「希望を持とうとしてもムダよ！\n　あなたたちが圧倒的に矮小で、取るに足りない存在で\n　あることに変わりはないのだから！」\\nw[\\N[5]=\\N[6]]",""],["「なら試してみるか？　腹黒メスドラゴン！」\\nw[\\N[1]]",""],["「……口が悪い男ね。\n　いいわ、跡形もなく燃やし尽くしてあげましょう！」\\nw[\\N[5]=\\N[6]]",""],["「おっとその前に、お前はあいつらの相手をしないと\n　いけないんじゃないか？」\\nw[\\N[1]]",""],["「なんですって？」\\nw[\\N[5]=\\N[6]]",""],["「なにがあった！？\n　あの爆音はなんだ！？」\\nw[警備兵]",""],["「たっ、大公殿下が！？\n　おのれっ、貴様のせいか！？」\\nw[警備兵]",""],["「今頃になって雑魚がワラワラと……。\\nw[\\N[5]=\\N[6]]",""],["「でもこのくらいの兵力、あなたたちともども、まとめて\n　焼き払って――。\\nw[\\N[5]=\\N[6]]",""],["「はっ！？」\\nw[\\N[5]=\\N[6]]",""],["「あんな大見得を切っておいて逃げた！？\\nw[\\N[5]=\\N[6]]",""],["「よ……よくもコケにしてくれたわねぇッ！！」\\nw[\\N[5]=\\N[6]]",""],["乱入兵士5",""],["乱入兵士6",""],["引き返し",""],["兵士に見つかると騒ぎになってしまう。\nこの先へ行くのはやめておこう。",""],["爆撃目標地点",""]],"context":[["Map326/events/1/name","Map326/events/3/name","Map326/events/7/name","Map326/events/8/name","Map326/events/9/name","Map326/events/10/name","Map326/events/11/name","Map326/events/22/name","Map326/events/34/name","Map326/events/35/name","Map326/events/36/name","Map326/events/38/name"],["Map326/events/2/name","Map326/events/6/name","Map326/events/12/name","Map326/events/13/name","Map326/events/14/name","Map326/events/15/name","Map326/events/23/name","Map326/events/24/name","Map326/events/39/name","Map326/events/40/name","Map326/events/41/name","Map326/events/42/name"],["Map326/events/4/name","Map326/events/5/name","Map326/events/16/name","Map326/events/60/name","Map326/events/61/name","Map326/events/62/name"],["Map326/events/17/name","Map326/events/18/name","Map326/events/26/name","Map326/events/27/name","Map326/events/28/name","Map326/events/37/name"],["Map326/events/19/name"],["Map326/events/20/name"],["Map326/events/21/name"],["Map326/events/25/name","Map326/events/29/name","Map326/events/32/name","Map326/events/33/name","Map326/events/49/name"],["Map326/events/25/pages/0/list/0/message/noPicture/bottom","Map326/events/29/pages/0/list/0/message/noPicture/bottom","Map326/events/32/pages/0/list/0/message/noPicture/bottom","Map326/events/33/pages/0/list/0/message/noPicture/bottom","Map326/events/49/pages/0/list/0/message/noPicture/bottom"],["Map326/events/30/name"],["Map326/events/31/name"],["Map326/events/43/name"],["Map326/events/44/name"],["Map326/events/45/name"],["Map326/events/46/name"],["Map326/events/47/name"],["Map326/events/48/name"],["Map326/eve