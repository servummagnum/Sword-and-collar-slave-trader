卸売商会":11,"神殿入り口":12,"聖堂":13,"厩舎入り口":14,"馬車屋":15,"自宅入り口":16,"自宅":17,"EV011":18,"EV012":19,"EV013":20,"EV014":21,"EV015":22,"EV016":23,"EV017":24,"依頼掲示板":25,"女性":26,"「罪を背負っていない人間などいない。\n　あなたも聖堂で神々に罪の浄化を願うといいわ」\\nw[女性]":27,"男性":28,"「砂漠ほどじゃないが、この街でも水は貴重なもの\n　なんだ」\\nw[地元の男]":29,"「南の砂漠は危険が多い。\n　街道を外れないよう気をつけるんだね」\\nw[元冒険者]":30,"「この街は四方を山や崖に囲まれている、天然の要塞\n　なのさ」\\nw[冒険者]":31,"娼館入り口":32,"娼館":33,"魔法具店":34,"王国官吏（依頼30）":35,"依頼を出している場合":36,"依頼フキダシ":37,"工事監督官（依頼31）":38,"研究者（依頼32)":39,"執事（依頼21）":40,"おっぱいマニア（依頼18）":41,"スケベじじい（依頼19）":42,"街ズームアウト":43,"　\n↓プラグインでピクチャ番号を変数に設定（専用変数No.68）":44,"P_VARIABLE_VALID":45,"P_D_FILENAME name_town\\V[101]":46,"P_VARIABLE_INVALID":47,"↑プラグインコマンドでのピクチャ設定ここまで\n　":48,"「すっごく乾燥してますね。\n　途中、ほとんど草木も生えてませんでしたし。\\nw[\\N[2]]":49,"「なのに、こんなに大きな街があるなんて……」\\nw[\\N[2]]":50,"「南方との貿易で栄えてきた重要な流通拠点だから、\n　都市と呼べるくらい人が集まってきたんだ」\\nw[\\N[1]]":51,"「南へ行くと、乾燥に加えて気温も上がるんですよね？\n　ちょっと想像できない過酷さだなぁ」\\nw[\\N[2]]":52,"「ここも十分に過酷だがな。\n　水源が止まりでもしたら、あっという間に干上がっちまう\n　だろうさ」\\nw[\\N[1]]":53,"男の子1":54,"「見て見て、リスだよ！」\\nw[男の子]":55,"リス":56,"門番2":57,"「ここはご領主様のお屋敷だ。\n　関係者以外、入ってはならん」\\nw[門番兵]":58,"EV042":59,"抜け穴":60,"塔入口":61,"物見塔に登りますか？":62,"登る":63,"登らない":64,"物見塔を降りますか？":65,"降りる":66,"降りない":67,"「この物見塔は外敵の侵入に備えて建てられたそうだが、\n　もう何十年も使われておらんのだ」\\nw[男性]":68,"通行不可":69,"掲示板マーク":70,"兵士":71,"兵士（追跡）":72,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":73,"馬車":74,"通行遮断":75,"尾行対象（依頼13・14・15）":76,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":77,"難易度ノーマル用":78,"難易度イージー用（振り向く前に立ち止まる時間が倍）":79,"視界範囲に引っかかったとき":80,"SmartPath 0 37 6":81,"周囲2マス圏内に侵入したとき":82,"尾行に気づいて逃走":83,"浮気相手の元へゴールしたとき":84,"ターゲット表示":85,"浮気調査（依頼13・14・15）":86,"浮気相手(依頼11)":87,"個別依頼14":88,"息子の嫁探し":89,"「ワシの息子は、顔が悪い上にスケベすぎて、どこからも\n　嫁が来てくれんのだ」\\nw[父親]":90,"「そ、それは大変ですね……」\\nw[\\N[2]]":91,"「だからもういっそ、女奴隷を買って嫁にしてしまおうかと\n　思ってな」\\nw[父親]":92,"「ナイスアイディア！」\\nw[\\N[1]]":93,"「ブ男のお嫁さんにされて、夜ごと無理矢理……。\n　ちょっと興奮するシチュエーションかも……\\I[29]」\\nw[\\N[2]]":94,"「どこがですか！？」\\nw[\\N[2]]":95,"「そういうわけなんで、息子が好きそうな\\C[17]褐色肌でボインな\n　人間の奴隷\\C[0]を紹介してくれんか？\\nw[父親]":96,"「あとついでに、二人の子作り用の\\C[17]ベッド\\C[0]も一緒に\n　買ってきて欲しいのだが。\\nw[父親]":97,"「用意してもらえるなら、\\C[17]７０００Ｇ\\C[0]出そうじゃないか。\n　それでも不足なら、この代々家に伝わる\\C[17]宝玉\\C[0]もつけよう」\\nw[父親]":98,"個別依頼『息子の嫁探し』を受けますか？":99,"受ける":100,"受けない":101,"大山脈西洞窟・地下3層":102,"火の洞窟":103,"個別依頼\\C[17]『息子の嫁探し』\\C[0]を受けた！":104,"\\C[17]『\\in[113]』\\C[0]と\\C[17]『\\in[355]』\\C[0]を依頼者に渡しますか？":105,"渡す":106,"渡さない":107,"依頼条件達成":108,"「依頼された褐色ボイン奴隷とベッドだ。\n　確認してくれ」\\nw[\\N[1]]":109,"「おおっ、いかにも息子が好きそうな女だ！\n　ベッドも大きくて綺麗で、子作りに丁度良さそうだし」\\nw[父親]":110,"「これで来年には孫の顔が見れるな！\n　ありがとう、いい買い物ができたよ」\\nw[父親]":111,"個別依頼\\C[17]『息子の嫁探し』\\C[0]を達成した！":112,"\nここからエッチイベント\n↓　　↓　　↓":113,"↓プレーヤー位置強制中央":114,"SFC_ENABLE_RESERVE":115,"依頼条件未達成":116,"「奴隷とベッド、両方とも頼んだよ」\\nw[父親]":117,"兵士（追跡）2":118,"「暑い……しかしこの鎧を脱ぐわけには……」\\nw[兵士]":119,"個別依頼09":120,"湖畔の覗き魔":121,"「裏道から忍んでいって、警備兵を倒して美少女三姉妹の\n　水浴びを覗く！\\nw[冒険者]":122,"「どうだい、やってやろうって気にならないか？\n　さあ、俺に力を貸してくれ！」\\nw[冒険者]":123,"「あんたらの噂は聞いてるぜ。\n　その腕を見込んで、ひとつ頼みたいことがあるんだ。\\nw[冒険者]":124,"「\\C[17]覗き\\C[0]を手伝ってくれないか？」\\nw[冒険者]":125,"「お前、藪から棒になにを――」\\nw[\\N[1]]":126,"「まあ待て、話を聞いてくれ。\\nw[冒険者]":127,"「この街を治めてる領主には三人の娘がいるんだ。\n　評判の美少女三姉妹さ。\\nw[冒険者]":128,"「その三姉妹は、街の水源にもなっている湖で水浴びする\n　のが日課なんだが、それを覗こうって計画なのさ。\\nw[冒険者]":129,"「どうだい？　チャレンジしてみたいと思わないか？\n　美少女の裸三人分だぜ？」\\nw[冒険者]":130,"「なるほど、それは興味深い」\\nw[\\N[1]]":131,"「\\N[1]さんなら、そう言うだろうと思いました」\\nw[\\N[2]]":132,"「\\N[1]さん！」\\nw[\\N[2]]":133,"「へへっ！　そうこなくっちゃな！\\nw[冒険者]":134,"「ただし覗きは簡単じゃないぜ。\n　湖に通じる本道には、常に厳重な警備が布かれてるんだ。\\nw[冒険者]":135,"「正面突破はまず無理だろう。\n　だから警戒が薄い\\C[17]裏道\\C[0]から回り込むんだ」\\nw[冒険者]":136,"「その裏道に警備は？」\\nw[\\N[1]]":137,"「いるよ。ただし本道の方に比べればずっと少ない。\n　俺たち全員でかかれば、なんとかなるはずだ」\\nw[冒険者]":138,"「でも、そこまでする価値が姉妹の裸にはあるんですか？\n　娼館に行くのとちがって、見るだけなのに？」\\nw[\\N[2]]":139,"「覗き見るからいいんだろうが！」\\nw[冒険者]":140,"「その通りだ！」\\nw[\\N[1]]":141,"「そ、そうですか……」\\nw[\\N[2]]":142,"「警備兵を敵に回すってことですよね？\n　そうまでして女性の裸を見たいんですか？」\\nw[\\N[2]]":143,"「見たいさ。当たり前だろ？」\\nw[冒険者]":144,"「当たり前だよなぁ？」\\nw[\\N[1]]":145,"「…………」\\nw[\\N[2]]":146,"「もし手伝ってくれるなら、そっちの女の子に似合いそうな\n　\\C[17]ビキニ鎧\\C[0]を報酬として提供するぜ。\\nw[冒険者]":147,"「さあ、どうする？\n　あんたも男ならウンと言ってくれ！」\\nw[冒険者]":148,"個別依頼『湖畔の覗き魔』を受けますか？":149,"個別依頼\\C[17]『湖畔の覗き魔』\\C[0]を受けた！":150,"「あーあ……こんなくだらない依頼、受けちゃって……」\\nw[\\N[2]]":151,"「うっさい。\n　女に男のロマンが分かるもんか」\\nw[\\N[1]]":152,"「その通りだ！」\\nw[冒険者]":153,"「で、肝心の裏道っていうのはどう行けばいいんだ？」\\nw[\\N[1]]":154,"「ガケに阻まれているから、普通に行こうとしても裏道には\n　出られない。\\nw[冒険者]":155,"「ただし\\C[17]聖堂の地下室\\C[0]から抜け穴が通じてるんで、\n　そこを通っていけばたどり着ける。\\nw[冒険者]":156,"「準備ができたら\\C[17]昼間\\C[0]のうちに聖堂へ来てくれ。\n　俺はそこで待ってるから」\\nw[冒険者]":157,"\\>　※　準備ができたら\\C[17]昼間のうちに聖堂の地下室\\C[0]へ※\n\\>　※　向かおう！　　　　　　　　　　　　　　　※\\<":158,"依頼マーク":159,"EV072":160,"水源地":161,"警備兵（湖）1":162,"「ここは立ち入り禁止だ」\\nw[兵士]":163,"警備兵（湖）2":164,"警備兵（湖）3":165,"「お嬢様たちの水浴びを盗み見るとは、なんて羨ま……\n　いや、けしからんヤツラだ！」」\\nw[兵士]":166,"「湖に近づけるのは、ご領主様の許可を得た者だけだ」\\nw[兵士]":167,"警備兵（湖）4":168,"「こともあろうにお嬢様たちの水浴びを覗いた\n　不埒者が出没したのだ！\\nw[警備隊長]":169,"「もし何か知っていたら、包み隠さず言うのだ！\n　犯人は必ず捕まえてくれる！」\\nw[警備隊長]":170,"「この先にあるのは街の水源となっている湖だ。\n　大切な場所なので、一般人の立ち入りは禁じられている」\\nw[警備隊長]":171,"ＢＧＭ変更":172,"夜間用ＢＧＭ演奏":173,"夜→昼":174,"最初から昼":175,"昼→夜":176,"最初から夜":177,"盗賊1":178,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":179,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":180,"「邪魔をするなら殺す！」\\nw[蛮族]":181,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":182,"奴隷化性別：0=女、1=男、2=男女ランダム":183,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":184,"戦闘マーク1":185,"門番1":186,"門番":187,"EV084":188,"奴隷市":189,"奴隷市（フキダシ）":190,"奴隷市（通行不可）":191,"鳥":192,"男性（広場）1":193,"「\\N[5]姫は美しかったらしいけど、ここの侯爵家の\n　三姉妹も別嬪ぞろいだよ！」\\nw[男性]":194,"「この南都を治める侯爵様には、三人の娘がいるんだ。\n　どの娘も美しいって評判だけど、王都や副都の姫様と\n　比べたら、どっちが上かな？」\\nw[男性]":195,"女性（広場）1":196,"「雨が少ないのは昔からだけど、この頃ますます\n　降らなくなってない？」\\nw[主婦]":197,"女性（広場）2":198,"「今日も湿気がなくて埃っぽいわね。\n　もう何ヶ月、雨が降ってないのかしら？」\\nw[主婦]":199,"男の子（広場）1":200,"「リンゴおいしそう……。\n　ママにたのんで買ってもらお」\\nw[男の子]":201,"男性1":202,"「もうちょっと金を貯めたら、俺も南のオアシスに\n　行って褐色肌の踊り子とロマンスしてくるんだ！」\\nw[男性]":203,"男性2":204,"「街の水源は、領主様によって厳しく管理されてるんだ。\n　よそ者だからって、うっかり近づくと逮捕されるかも\n　しれないぞ」\\nw[男性]":205,"藁山":206,"女の子1":207,"「ここから、アンアンって声が聞こえてくるの。\n　なんのお店なんだろ？」\\nw[女の子]":208,"女性1":209,"「この街、洗濯物の乾きは早いのよね」\\nw[主婦]":210,"女性2":211,"「ここより上流で洗濯するのは禁止よ。\n　飲み水にも使われているから」\\nw[主婦]":212,"冒険者1":213,"「仕事を探しに来たんだけど、あまりパッとした依頼は\n　無いなぁ」\\nw[冒険者]":214,"冒険者2":215,"「冒険者になりたいなら、街道を東へ行くがいい。\n　ハリエーツという町に冒険者ギルドがあるぞ」\\nw[冒険者]":216,"男性3":217,"「こういう井戸は街のあちこちにあるが、実はあまり\n　水が湧いていないんだ。\n　生活用水は、ほとんど川に頼っているのさ」\\nw[男性]":218,"女性3":219,"「\\N[6]の件で領主様は慌てて王都に向かったけど、\n　着いた頃にはもう悪竜は倒されてたんだって」\\nw[領主のメイド]":220,"「ちょっと息抜き中。\n　お屋敷の仕事は疲れるのよ」\\nw[領主のメイド]":221,"奴隷1":222,"「奴隷になってやる仕事が、娼館の呼び込みだとは\n　思わなかったよ」\\nw[奴隷]":223,"奴隷2":224,"「女奴隷イコール慰み者、って考えるヤツ多過ぎよ！\n　わたしはそんな目に遭ったことないわ。\\nw[奴隷]":225,"「……いま『魅力が無いせいだ』って思ったでしょ？」\\nw[奴隷]":226,"民家入り口":227,"民家":228,"売り家表示":229,"EV114":230,"物乞い4":231,"\\C[17]※ 注意 ※\\C[0]\nこれ以上、物乞いにお金をあげてもイベントは発生しません。":232,"「この老体を憐れむなら、わずかでもいいので\n　慈悲をくだされ」\\nw[物乞い]":233,"100Ｇ渡す":234,"500Ｇ渡す":235,"1000Ｇ渡す":236,"5000Ｇ渡す":237,"無視する":238,"「感謝いたしますぞ」\\nw[物乞い]":239,"EV116":240,"EV117":241,"EV118":242,"景気ランタン":243,"依頼01・02戦闘":244,"依頼を引き受けている場合、暴漢と戦闘":245,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":246,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":247,"暴漢と戦闘":248,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":249,"襲ってきた暴漢を街の警備兵に引き渡した。":250,"暴漢":251,"犬":252,"レイプ魔":253,"レイプ被害者":254,"レイプマーク":255,"レイプEv向き合わせ":256,"レイプEv発生制御":257,"レイプ現場遭遇":258,"街中盗賊出没":259,"盗賊2":260,"戦闘マーク2":261,"淫行男1":262,"腕に自信のある男":263,"「金さえ積めば、誰が相手だろうとブッ殺してやるぜ？\n　もちろん、安くはねぇがな」\\nw[\\v[1655]]":264,"「いいメス連れてんじゃねぇか、兄ちゃんよぉ。\n　そのまんこ、いくらで貸す？」\\nw[\\v[1655]]":265,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":266,"売春させる":267,"やめておく":268,"淫行表示":269,"街中淫行制御":270,"淫行男2":271,"姑息な男":272,"「夜の街を観察してるとなぁ、人の弱みを握れることが\n　けっこうあんだよ。ひひっ」\\nw[\\v[1655]]":273,"「その猫人奴隷、どうせ性処理用だろ？\n　オレにもちっと使わせろよ」\\nw[\\v[1655]]":274,"淫行男3":275,"野卑な男":276,"「おうおう、女連れて夜のお散歩か？\n　いいご身分だなぁ、おい」\\nw[\\v[1655]]":277,"「テメェが連れてるその肉便器、具合はどうだ？\n　ちょっと試させろよ」\\nw[\\v[1655]]":278,"EV141":279,"フクロウ":280,"マップ取得":281,"FocusCamera 39 27 120":282,"ZoomOut 3 120":283,"\\C[17]\\V[903]の地図\\C[0]を取得した！":284,"ResetZoom 60":285,"ResetFocus 60":286,"街中イーグルダイブ":287,"ここから飛び降りますか？":288,"飛び降りる":289,"やめる":290,"掲示板依頼初期化おばあちゃん":291,"<TE:110>":292,"四聖教メッセンジャー":293,"<TE:112>":294,"会話マーク(EX)":295,"<TE:113>":296,"未取得アイテム":297,"\\>重量オーバーのため入手できなかった、個別依頼09の報酬だ。\n\\>拾いますか？\n\\>（必要とする積載重量の空き：\\C[17]８Ｗ\\C[0]）":298,"拾う":299,"拾わない":300,"PNDK_LC getSurplusWeights 15":301,"\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！":302,"\\C[18]積載可能な重量をオーバー\\C[0]しているため入手できない。":303},"extension":"json","dataType":"map","filename":"Map026","basename":"Map026.json","path":"data/Map026.json","relPath":"data/Map026.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":304,"percent":0.6578947368421052},"cellInfo":[],"cacheResetOnChange":{}},"data/Map027.json":{"data":[["宿屋の主人",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["火",""],["ギャンブラー",""],["特定アイテムを賭けての勝負\n↓　　↓　　↓",""],["「暇つぶしに奴隷カードで遊ばないか？\n　あんたが勝ったら\\C[17]ステータス増強薬\\C[0]をあげよう。\\nw[ギャンブラー]",""],["「逆にオレが勝ったなら、一緒にいるその猫人の娘の\n　\\C[27]おまんこを観察\\C[0]させてもらおう」\\nw[ギャンブラー]",""],["勝負を受ける",""],["やめておく",""],["奴隷カードの説明",""],["PNDK_LC getSurplusWeights 15",""],["↓積載重量空きOK",""],["賞品の重量が\\C[18]\\v[17]Ｗ\\C[0]オーバーしてしまうため、勝負を\n受けられません。\n積載重量に余裕を作ってください。",""],["「よしっ、勝負だ！！」\\nw[ギャンブラー]",""],["勝利（戦利品ゲット）",""],["「あんた強いな、大したものだ。\n　こちらの負けだから、約束通りステータス増強薬を\n　進呈しよう」\\nw[ギャンブラー]",""],["アイテム\\C[17]『\\in[25]』『\\in[26]』\\C[0]を手に入れた！",""],["引き分け",""],["「なんだ、引き分けか。\n　白黒つけたかったんだがな」\\nw[ギャンブラー]",""],["敗北（ユマ凌辱）",""],["「オレの勝ちだから、おまんこを公開してもらおう。\n　さあ、さあ！」\\nw[ギャンブラー]",""],["「そんなにがっつかなくても、ほら\\I[29]\n　心ゆくまで観察してくださいね\\I[29]」\\nw[\\N[2]]",""],["「うぅむ、淫乱の気配がありながら、黒ずみも型崩れも\n　ないとは……」\\nw[ギャンブラー]",""],["「こっ、これでいいですか！？\n　もういいですよね！？　終わりでいいですよね！？」\\nw[\\N[2]]",""],["「もう少しゆっくり観察したいんだが……。\n　ほうほう、歪みのない良いスジだ」\\nw[ギャンブラー]",""],["\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下がった！",""],["現金を賭けての勝負（繰り返し）\n↓　　↓　　↓",""],["「現金を賭けて勝負するかい？」\n（※賭け金は\\C[17]『\\v[1170]G』\\C[0]です）\\nw[ギャンブラー]",""],["賭ける",""],["現金がある",""],["現金なし",""],["「おいおい、金がないんじゃ勝負が成立しないぜ」\\nw[ギャンブラー]",""],["勝利（賭け金ゲット）",""],["「くそっ、今日はツイてねぇぜ……！」\\nw[ギャンブラー]",""],["\\C[17]『\\v[1170]G』\\C[0]を手に入れた！",""],["敗北（賭け金没収）",""],["「へへっ！　悪く思うなよ。\n　こっちにツキがあったんだ」\\nw[ギャンブラー]",""],["\\C[9]『\\v[1170]G』\\C[0]を失った！",""],["宿屋の女将",""],["「いらっしゃい！\n　ウチは南都で一番いい宿だよ！」\\nw[宿屋の女将]",""],["宿泊客（依頼06）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「ここには所用があって初めて来たのだが……なんとも\n　険しい場所に街をつくったものだと感心したよ」\\nw[宿泊客]",""],["男",""],["「悪竜\\N[6]かぁ……。\n　本物だったなら、見てみたかったなぁ」\\nw[酒飲みの男]",""],["「南の砂漠には、昔すごく大きな国が栄えていた\n　らしいが……今となっちゃただの伝説だな」\\nw[酒飲みの男]",""],["光",""],["ギャンブルふきだし",""],["依頼フキダシ",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["ユマ（トイレ）",""],["絶倫おじさん（依頼16）",""],["吟遊詩人（依頼15）",""],["料理1",""],["料理2",""],["娼婦",""],["「まったく、これくらいで情けないわね。\n　そんなんでアッチの方は大丈夫なの？」\\nw[娼婦]",""],["男性客",""],["「ぐえぇ……もう飲めない……無理だぁ……。\n　くそぉ、なんて強い女なんだ……」\\nw[酔った男]",""],["女性客",""],["「彼女、夫に浮気されて自暴自棄になりかけてるのよ。\n　かわいそうに……」\\nw[女性]",""],["「あのクサレチンポ男ォッ！！\n　こうなったら離婚……いやその前にあたしも浮気して\n　やるぅ！！」\\nw[女性]",""],["現金（窃盗用）",""],["窃盗の難しさ（1=簡単、2=難しい、3=高難度）",""],["手薄な時間帯（1=昼、2=夜）",""],["チェック",""],["女性",""],["「ここから南に行くと、\\C[17]火の洞窟\\C[0]や\\C[17]古代遺跡\\C[0]といった\n　ダンジョンがあるの。\n　私はどっちを探索しようかしら」\\nw[冒険者]",""],["EV029",""],["「街道を外れて東の方角へ向かうと、火山があるんだ。\n　その火山のふもとにあるダンジョンは\\C[17]火の洞窟\\C[0]と\n　呼ばれているらしい」\\nw[男性客]",""],["変態紳士（依頼17）",""],["「幼馴染ですっげぇ不細工な男がいるんだけど、いま\n　オヤジさんが必死で嫁探ししてるんだ。\\nw[男性客]",""],["「嫁と引き換えなら\\C[17]伝家の宝玉\\C[0]も譲り渡す、とか言ってる\n　けど、その宝玉ってのに本当に価値があるのかどうか」\\nw[男性客]",""],["「幼馴染の不細工野郎が、とうとう嫁をめとったんだ。\n　奴隷を無理やり嫁にしたって話だけど、なんか意外と\n　うまく行ってるみたいなんだよな」\\nw[男性客]",""]],"context":[["Map027/events/1/name"],["Map027/events/2/name"],["Map027/events/3/name"],["Map027/events/4/name"],["Map027/events/5/name"],["Map027/events/6/name"],["Map027/events/7/name"],["Map027/events/7/pages/0/list/0/comment"],["Map027/events/7/pages/0/list/4/message/noPicture/bottom"],["Map027/events/7/pages/0/list/7/message/noPicture/bottom"],["Map027/events/7/pages/0/list/10/Show Choices/10/1from3"],["Map027/events/7/pages/0/list/10/Show Choices/10/2from3","Map027/events/7/pages/1/list/7/Show Choices/7/2from3"],["Map027/events/7/pages/0/list/10/Show Choices/10/3from3","Map027/events/7/pages/1/list/7/Show Choices/7/3from3"],["Map027/events/