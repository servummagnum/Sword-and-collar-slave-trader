erParam":["",0,0,2]}],[{"headerIndex":150,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":22,"headerParam":["",0,0,2]}],[{"headerIndex":91,"headerParam":["",0,0,2]}],[{"headerIndex":96,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["",0,0,2]}],[{"headerIndex":108,"headerParam":["",0,0,2]}],[{"headerIndex":125,"headerParam":["",0,0,2]}],[{"headerIndex":132,"headerParam":["",0,0,2]}],[{"headerIndex":135,"headerParam":["",0,0,2]}],[{"headerIndex":156,"headerParam":["",0,0,2]}],[{"headerIndex":161,"headerParam":["",0,0,2]}],[{"headerIndex":167,"headerParam":["",0,0,2]}],[{"headerIndex":170,"headerParam":["",0,0,2]}],[{"headerIndex":176,"headerParam":["",0,0,2]}],null,[{"headerIndex":191,"headerParam":["エンディングロール"]}],[{"headerIndex":195,"headerParam":["↑　　↑　　↑"]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,[{"headerIndex":8,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":24,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":26,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["Ver.1.0.4更新で誤ってスイッチ1141をOFFにする処理を入れてしまったので、"]}]],"indexIds":{"EV001":0,"↓再現性の無い左移動し続けるバグに対しての対症療法処理(Ver.1.0.4で追加)":1,"↑ここまで":2,"EV002":3,"EV003":4,"EV004":5,"EV005":6,"EV006":7,"EV007":8,"宿屋":9,"EV008":10,"魔法具店":11,"EV009":12,"アクセサリ店":13,"EV010":14,"武器防具店":15,"EV011":16,"卸売商会":17,"EV012":18,"聖堂":19,"EV013":20,"商業ギルド":21,"EV014":22,"馬車屋":23,"スケベじじい（依頼19）":24,"依頼を出している場合":25,"EV016":26,"EV017":27,"EV018":28,"EV019":29,"EV020":30,"EV021":31,"女性":32,"「夫が無事に航海から帰ってくるよう、毎日お祈りに\n　通っているの」\\nw[信心深い女]":33,"依頼フキダシ":34,"男性":35,"ドゥブカ島について":36,"「は？　ドゥブカ島だって？\n　この北海にそんな間の抜けた名前の島、ないと思うぞ？」\\nw[地元の男]":37,"通常会話":38,"「この町は、ここ数十年のあいだに急速に発展したんだ。\n　だから余所から移り住んできた者も多いんだよ」\\nw[地元の男]":39,"落ちてる精霊石（街）":40,"「謎の冒険者が王都で悪竜を倒したという話だけど、\n　僕の経験からいって有り得ないね。\n　百人がかりだって相手になるかどうか」\\nw[元冒険者]":41,"「この辺りの海で長いこと冒険をしてきたけど、\n　ドゥブカという島はちょっと聞いたことないね」\\nw[元冒険者]":42,"「海のモンスターは水属性の攻撃を多用する。\n　けど、そればかりに気を取られてると、別のところで\n　痛い目を見るかもしれないよ？」\\nw[元冒険者]":43,"王国官吏（依頼30）":44,"「うーん……少しは地理に詳しいつもりだけど、\n　ドゥブカなんて島は記憶にないわねぇ」\\nw[冒険者]":45,"「冒険者がこの島で稼ぐなら、船の護衛か、東の灯台での\n　モンスター退治ね」\\nw[冒険者]":46,"工事監督官（依頼31）":47,"執事（依頼21）":48,"研究者（依頼32)":49,"おっぱいマニア（依頼18）":50,"鉤爪捜索メッセージ表示":51,"竜の鉤爪があるかもしれない\\C[17]ドゥブカ島\\C[0]について、町の\n人々から情報を集めよう。":52,"漁師":53,"海産物売買フキダシ":54,"淫行男2":55,"卑屈な男":56,"「おいテメェ！　いまオレのこと笑っただろ！\n　チクショウが！！」\\nw[\\v[1655]]":57,"「女なんてのはなぁ、どいつもこいつもただのメスなんだ！\n　分かるか、おい？」\\nw[\\v[1655]]":58,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":59,"売春させる":60,"やめておく":61,"淫行表示":62,"淫行男1":63,"胡散臭い男":64,"「見ねぇ顔だな、おい。\n　裏の顔役のオレ様に、挨拶でもしに来たのか？」\\nw[\\v[1655]]":65,"「その猫人の奴隷、見たことあるぜ。\n　街でちょっと評判だった美少女じゃねぇか」\\nw[\\v[1655]]":66,"通行遮断":67,"馬車":68,"依頼掲示板":69,"掲示板マーク":70,"兵士":71,"兵士（追跡）":72,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":73,"ボート":74,"通行不可":75,"食料品店":76,"子供1":77,"「ドゥブカ島？\n　ううん、知らなーい！」\\nw[男の子]":78,"「ボクも大きくなったら、父ちゃんみたいな船乗りに\n　なるんだ！」\\nw[男の子]":79,"男性市民3":80,"「初めて聞く名前の島だね。\n　ちょっと分からないな。」\\nw[赤髪の男]":81,"「この島にはハーピーが棲息してるんだ。\n　ときどき街の方にも飛んでくるよ」\\nw[赤髪の男]":82,"浮気調査（依頼13・14・15）":83,"景気ランタン":84,"尾行対象（依頼13・14・15）":85,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":86,"難易度ノーマル用":87,"難易度イージー用（振り向く前に立ち止まる時間が倍）":88,"視界範囲に引っかかったとき":89,"SmartPath 0 0 51":90,"周囲2マス圏内に侵入したとき":91,"尾行に気づいて逃走":92,"浮気相手の元へゴールしたとき":93,"ターゲット表示":94,"水夫（海賊島の話）":95,"「ドゥブカ島？\n　それって確か、例の\\C[17]海賊島\\C[0]の古い名前じゃなかったっけ？」\\nw[水夫]":96,"「えっ、海賊島ってあの！？」\\nw[\\N[2]]":97,"「どういうことだ？」\\nw[\\N[1]]":98,"「あのですね、この辺りを荒らし回っている海賊の\n　本拠地が海賊島と呼ばれる島なんです。」\\nw[\\N[2]]":99,"「みんな海賊島としか呼ばないんで、古い正式な名前が\n　あるなんて地元民でも知らなかったんですけど――」\\nw[\\N[2]]":100,"「それがドゥブカ島だったわけか。\n　ってことはだ、俺たちは海賊がウヨウヨいる島に\n　乗り込まなきゃならないのか？」\\nw[\\N[1]]":101,"「そうなりますね……」\\nw[\\N[2]]":102,"「しかし、ひょっとすると手間が省けるかもしれんぞ」\\nw[\\N[1]]":103,"「え？　どういうことですか？」\\nw[\\N[2]]":104,"「仮に俺がメスガキの立場だったら、また海賊と協力して\n　島内にある鉤爪を捜索させるだろうな。\\nw[\\N[1]]":105,"「つまり海賊どもの動向を探れば、おのずと――」\\nw[\\N[1]]":106,"「竜の鉤爪の場所もわかる！？」\\nw[\\N[2]]":107,"「なあ水夫さん、その海賊島まで船を出してくれる\n　船乗りっていないか？」\\nw[\\N[1]]":108,"「いるわけないだろ、そんなヤツ。\n　なにを好き好んで、自分から海賊の本拠地に――。\\nw[水夫]":109,"「いやまて、交渉次第じゃ船を出すかもしれない\n　物好きが一人だけいるな」\\nw[水夫]":110,"「えっ、それってまさか……！？」\\nw[\\N[2]]":111,"「そう、\\C[17]ザーボ船長\\C[0]だ。\n　別名『クレイジー・ザーボ』」\\nw[水夫]":112,"「頭のネジが何本か抜けてるって有名な船長ですよ！」\\nw[\\N[2]]":113,"「ほほう……クレイジー・ザーボ、いいじゃないか。\n　そのイカレた船長を見つけて、海賊島まで船を出して\n　もらおう」\\nw[\\N[1]]":114,"「本気か？\n　あんたもネジが緩んでるんじゃないか？\\nw[水夫]":115,"「まあザーボ船長はこの時間なら、港の方にいるだろう\n　から、会いたいなら行くといい」\\nw[水夫]":116,"\n\\>　　　　　\\C[17]※　港にいるザーボ船長を探そう　※\\C[0]":117,"「ザーボ船長なら、\\C[17]港\\C[0]の方にいるはずだぜ」\\nw[水夫]":118,"浮気相手(依頼11)":119,"船長":120,"船マーク":121,"EV069":122,"ユマ（里帰りEv）":123,"海賊戦闘イベント終了後":124,"P_D_FILENAME name_town\\V[101]":125,"勝利時":126,"「お前たちのお陰で、無事シーグヌースまで来ることが\n　できた。礼を言うぜ」\\nw[船長]":127,"「構わんさ。こっちとしても運んでもらえて助かったからな。\n　ボーナスも貰ったことだし」\\nw[\\N[1]]":128,"「これで海賊も、しばらくは大人しくなりますよね？」\\nw[\\N[2]]":129,"「おそらくな。船舶の往来も元に戻るはずだ」\\nw[船長]":130,"海上輸送が再開されました。\n\\C[17]運賃を払えば船に乗って移動\\C[0]することができます。":131,"「それじゃオレは、次の航海に行くぜ。あばよ！」\\nw[船長]":132,"「で、お前の故郷に着いたわけだが……。":133,"「ここが\\C[17]島の町シーグヌース\\C[0]か。\n　さすがに港がでかいな」\\nw[\\N[1]]":134,"「でしょう？\n　時期によってはもっと船が停泊してることも\n　あるんですけど」\\nw[\\N[2]]":135,"敗北時":136,"「生きてシーグヌースには着いたが……くそっ！\n　お前らがしくじったせいで大損害だ！」\\nw[船長]":137,"「あんな不良品の大砲で、人間を狙撃しろってのが無茶\n　だったんだ！　采配ミスをこっちのせいにするな！」\\nw[\\N[1]]":138,"「はぁ……責任を押し付け合っても、奪われたものは返って\n　きませんよ……？」\\nw[\\N[2]]":139,"「えぇい！　忌々しい！\n　お前らの顔など二度と見たくない！」\\nw[船長]":140,"「しかし負けたとはいえ、海賊どもにもある程度の損害は\n　与えられたからな。\n　しばらくはヤツラも大人しくなるだろ」\\nw[\\N[1]]":141,"「不幸中の幸いですね。\n　これで船の往来が元に戻ってくれれば……」\\nw[\\N[2]]":142,"「でも、どうしましょう？\n　所持金を全部奪われて無一文になってしまいましたよ？」\\nw[\\N[2]]":143,"「おいおい、本当に有り金全部を差し出したわけないだろ。\n　半分は海賊どもに見つからないよう隠しておいたさ」\\nw[\\N[1]]":144,"「そっ、そうなんですか！？\\nw[\\N[2]]":145,"「良かったぁ～。半分とはいえ手元に残ってたんですね」\\nw[\\N[2]]":146,"\\C[17]所持金の半分は残っていた！\\C[0]":147,"「\\N[2]お前、なかなか面白いところで生まれ育った\n　んだな」\\nw[\\N[1]]":148,"「ええ、毎日楽しかったですよ。\n　父の仕事の手伝いは大変でしたけど」\\nw[\\N[2]]":149,"「それがまた、どうして奴隷身分なんかに落ちたんだ？」\\nw[\\N[1]]":150,"「実は……その原因も\\C[17]海賊\\C[0]でして。\\nw[\\N[2]]":151,"「ウチが所有してた商船が海賊に襲われて、荷を略奪された\n　うえに船は沈没したんです。その結果、破産を……。\\nw[\\N[2]]":152,"「それで負債をなんとか処理しようと、家財を全部\n　売り払ってお金を作ったんですけど……」\\nw[\\N[2]]":153,"「それでも金が足りなくて、お前は奴隷に売られたと？」\\nw[\\N[1]]":154,"「……はい」\\nw[\\N[2]]":155,"「うーむ……。\\nw[\\N[1]]":156,"「だがそれは、おかしくないか？\n　借金のカタに人身売買をやるのは、法で禁止されてる\n　はずだ。\\nw[\\N[1]]":157,"「闇でやってる連中もいるだろうが、お前みたいな\n　そこそこ大きな商家の人間が、違法奴隷なんかに\n　されるものか？」\\nw[\\N[1]]":158,"「それが、わたしは正規の手続きで奴隷身分に\n　なったんです。\\nw[\\N[2]]":159,"「どうしてそうなっちゃったのか、わたし自身もよく\n　分からないんですけど……」\\nw[\\N[2]]":160,"「分からないって、なんだそりゃ？\n　ずいぶんといい加減な話だな」\\nw[\\N[1]]":161,"「返す言葉もありません……」\\nw[\\N[2]]":162,"「なにか裏がありそうだな。\\nw[\\N[1]]":163,"「……まあ、ここでグダグダ話していても始まらんか。\n　顔を出したい場所があるんだろ？」\\nw[\\N[1]]":164,"「あ、はい。\n　とりあえず、前に私が住んでいた家へ行きましょう。\\nw[\\N[2]]":165,"「その近所に、わたしの友達や知人も住んでいるので。\n　家は\\C[17]町の北側\\C[0]にあります」\\nw[\\N[2]]":166,"\n　　　 ※　\\C[17]町の北側\\C[0]にある\\N[2]の生家へ行こう　※":167,"ユマ（生家イベント）":168,"「ここです！\n　ここがわたしの家――。\\nw[\\N[2]]":169,"「――だったんですけど……」\\nw[\\N[2]]":170,"「いまや、他人の手に渡って売り家か」\\nw[\\N[1]]":171,"「うぅ……わたしのおうちぃ……。\\nw[\\N[2]]":172,"「でも、くじけません！\n　命さえあれば、いつかまたこの家を取り戻すことだって\n　できるかも！」\\nw[\\N[2]]":173,"「そうだな。\n　お前が俺を手伝って大儲けできれば、家を買い戻す\n　ことだって不可能じゃないかもな」\\nw[\\N[1]]":174,"「はいっ、わたし頑張ります！」\\nw[\\N[2]]":175,"「それで、友人だか知人だかのところに、生存報告に\n　行くんだろ？」\\nw[\\N[1]]":176,"「はい、まずは一番仲の良かった友達の――」\\nw[\\N[2]]":177,"「うそっ！　\\N[2]？！\n　なんでここにいるの！？」\\nw[\\N[3]]":178,"「\\C[17]\\N[3]\\C[0]！？\\nw[\\N[2]]":179,"「わぁっ、\\N[3]だ！\n　良かった、こんなすぐに会えるなんて！」\\nw[\\N[2]]":180,"「お前の知り合いか？」\\nw[\\N[1]]":181,"「はいっ！\n　わたしの一番の友達の\\N[3]です！\\nw[\\N[2]]":182,"「彼女も商家の娘で、わたしの幼馴染なんですよ。\n　ウチが破産したときには、事後処理を色々と手伝って\n　くれて――」\\nw[\\N[2]]":183,"「\\N[2]、どういうことなの？\n　あんた奴隷になって遠くへ売られていったはずじゃ？」\\nw[\\N[3]]":184,"「う、うん……そうなんだけど……\\nw[\\N[2]]":185,"「でもこの人に買われて、今はお仕事の手伝いを\n　しながら、あちこち旅して回ってるの」\\nw[\\N[2]]":186,"「はぁ？　仕事の手伝い？\n　暗殺でもやってるの？」\\nw[\\N[3]]":187,"「俺はアサシンじゃねぇッ！！」\\nw[\\N[1]]":188,"「お、落ち着いてください、\\N[1]さん。\n　\\N[3]なりのジョークですよ、きっと」\\nw[\\N[2]]":189,"「ジョークはあんたよ。\n　てっきり、どこかの豚親父の性奴隷にでもなってる\n　もんだとばかり思ってたけど――。\\nw[\\N[3]]":190,"「それが平気な顔して帰ってくるなんて。\n　ずいぶんとヌルい環境にいるみたいじゃないの？」\\nw[\\N[3]]":191,"「わたしもどんな酷い目に遭わされるのか不安だったけど、\n　必死にお願いして、孕ませおじさんコースだけは\n　回避できたんだ」\\nw[\\N[2]]":192,"「こうしてまた\\N[3]と会えて嬉しいよ」\\nw[\\N[2]]":193,"「――チッ！\n　嬉しいのはあんただけよ。こっちはガッカリだわ」\\nw[\\N[3]]":194,"「え……？」\\nw[\\N[2]]":195,"「まだ気づかないの、このマヌケ！\n　誰もあんたが帰ってくることなんて、望んじゃいな\n　かったのよ！」\\nw[\\N[3]]":196,"「ってか、あんたが奴隷身分に落ちるよう裏で細工\n　したのは、何を隠そうこのあたしなんだけどぉ！」\\nw[\\N[3]]":197,"「う……うそっ……？\n　なに言ってるの、\\N[3]……そんなわけ……」\\nw[\\N[2]]":198,"「ウソなもんですか。\\nw[\\N[3]]":199,"「あんたも、あんたの親父も、ウチの商会に言われるが\n　まま負債の整理を手伝わせるんだもの。\n　好意でそんな親切すると思った？\\nw[\\N[3]]":200,"「書類を改ざんして、架空の詐欺罪で罪人に仕立てあげる\n　のは簡単だったわよ！\\nw[\\N[3]]":201,"「罪人であれば奴隷身分に落として売り飛ばせる\n　ものね！\n　あーはっはっはっ！！」\\nw[\\N[3]]":202,"「そんな……なんで……？」\\nw[\\N[2]]":203,"「おい、お前。\\N[2]の友達じゃなかったのか？\n　それともこいつに恨みでもあったのか？」\\nw[\\N[1]]":204,"「恨みですって！？\n　ええ、あるわよ！　数えきれないくらいにね！\\nw[\\N[3]]":205,"「子供のころ好きだった男子は、\\N[2]にばかり\n　夢中だったし！\\nw[\\N[3]]":206,"「町の美少女コンテストで優勝しても『\\N[2]ちゃんが\n　出場してたら結果は違ってただろう』とか言われるし！\\nw[\\N[3]]":207,"「そのくせ\\N[2]本人はヘラヘラ笑って、あたしのことを\n　親友だとか言って……ずっと我慢ならなかったわ！\\nw[\\N[3]]":208,"「完全に逆恨みじゃねーか！」\\nw[\\N[1]]":209,"「だから奴隷にしてやったのに、豚親父の性玩具になる\n　どころか、平気な顔して戻ってくるなんて……！\n　期待外れもいいところだわ！」\\nw[\\N[3]]":210,"「\\N[3]……一番の友達だって思ってたのに……」\\nw[\\N[2]]":211,"「話は分かった。\n　つまり\\N[2]は冤罪で奴隷身分にされたんだな？」\\nw[\\N[1]]":212,"「それがなんだっていうの？\n　言っておくけど、訴え出たって無駄よ。\\nw[\\N[3]]":213,"「証拠はもう処分してあるからね！」\\nw[\\N[3]]":214,"「お前を締め上げて、法務官の前で洗いざらい\n　吐かせるって方法もあるぞ？」\\nw[\\N[1]]":215,"「あはっ☆　バカが考えそうなことね！\\nw[\\N[3]]":216,"「\\C[17]\\N[4]！\\C[0]」\\nw[\\N[3]]":217,"「お呼びでしょうか、お嬢様？」\\nw[\\N[4]]":218,"「ええ、\\N[4]。\n　そこのバカがね、腕力を振りかざそうとしてるのよ」\\nw[\\N[3]]":219,"「なんだあの野郎は？\n　突然出てきやがって」\\nw[\\N[1]]":220,"「わ、わかりません……。\n　\\N[3]の商会に、あんな使用人はいなかったと\n　思います」\\nw[\\N[2]]":221,"「わたしに手を出そうっていうなら、この\\N[4]が\n　黙ってないわよ！」\\nw[\\N[3]]":222,"「ゆえあって\\N[3]お嬢様の執事をしております、\n　\\N[4]と申します」\\nw[\\N[4]]":223,"「お嬢様を害そうというのなら、僭越ながら私がお相手を\n　させていただきますが？」\\nw[\\N[4]]":224,"「あの男、かなり強そうだな。\n　執事とか抜かしてるが、ありゃあ用心棒だろ。\\nw[\\N[1]]":225,"「まともにはやり合いたくないな……」\\nw[\\N[1]]":226,"「\\N[2]、あんたが精液まみれのボロクソになって\n　なかったのは残念だけど、\\nw[\\N[3]]":227,"「あんたのトコの商会が潰れてくれたお陰で、ウチの\n　商会は急成長したわ！\\nw[\\N[3]]":228,"「いまや、\\C[17]王族\\C[0]とも取り引きするほどの大商会よ！\\nw[\\N[3]]":229,"「さ・ら・に、なーんと\\C[17]武器商ギルド\\C[0]の幹部クラスにも\n　なっちゃったわ！」\\nw[\\N[3]]":230,"「武器商ギルド！？\n　\\N[3]のところは、ウチと同じで商業ギルドの会員\n　だったんじゃ……！？」\\nw[\\N[2]]":231,"「鞍替えしたのよ！\n　これからは武器商ギルドの時代だからね！\\nw[\\N[3]]":232,"「いまは武器の取り扱いが主だけど、いずれ商業ギルドの\n　縄張り全部、武器商ギルドがいただくわよ！」\\nw[\\N[3]]":233,"「お嬢様、そろそろ船が出る時間です」\\nw[\\N[4]]":234,"「そうだったわね。\n　奴隷とアサシンに構ってて乗り遅れたら大変だわ」\\nw[\\N[3]]":235,"「このっ、腐れメスガキッ……！」\\nw[\\N[1]]":236,"「それじゃあ、もう行くわ。\n　せいぜい、あたしが\\C[17]王都\\C[0]で出世していくのを、指を\n　くわえて眺めてなさい」\\nw[\\N[3]]":237,"「では、これにて失礼いたします」\\nw[\\N[4]]":238,"「おい執事、雌犬のしつけをしておかないと、そのうち\n　痛い目を見るかもしれないぜ？」\\nw[\\N[1]]":239,"「やってみろ、アサシン。\n　その前に貴様の首をはねてやる」\\nw[\\N[4]]":240,"「\\N[3]……なんで……」\\nw[\\N[2]]":241,"「なんでもクソもあるか。\n　くだらねぇ逆恨みだって、本人が言ってただろうが。\\nw[\\N[1]]":242,"「それでどうすんだ、お前？」\\nw[\\N[1]]":243,"「どう、って言われても……」\\nw[\\N[2]]":244,"「濡れ衣着せられたままでいいのか？\n　このままじゃ、あのメスガキの一人勝ちだぞ」\\nw[\\N[1]]":245,"「そんなこと言われても……わたしになにが出来るって\n　言うんですか！？」\\nw[\\N[2]]":246,"「\\N[2]お嬢！？」\\nw[水夫]":247,"「こりゃ驚いた！　やっぱり\\N[2]お嬢じゃねぇですかい！\n　ご無事だったとは！」\\nw[水夫]":248,"「あなたは！　ウチの商船の水夫だった――」\\nw[\\N[2]]":249,"「いやぁ、旦那様もお嬢も奴隷にされちまって、もう\n　二度とお目にかかれないものと思ってやしたが、\\nw[水夫]":250,"「まさか戻っていらっしゃるたぁ、驚いた！」\\nw[水夫]":251,"「お前の商会の人間か？」\\nw[\\N[1]]":252,"「はい。\n　海賊に襲われたウチの商船の、数少ない生き残りの\n　一人です」\\nw[\\N[2]]":253,"「なら丁度いい。\n　おいあんた、海賊に襲われたときのこと、ちょっと\n　聞かせてもらえるか？」\\nw[\\N[1]]":254,"「ああん？　なんだって今更？\n　まぁ、別にいいけどよぉ」\\nw[水夫]":255,"「\\N[1]さん……？」\\nw[\\N[2]]":256,"「襲って来た海賊たちに、不審な点はなかったか？」\\nw[\\N[1]]":257,"「不審な点？　海賊なんざ、不審者ばかりだぞ。\n　そんなもん――。\\nw[水夫]":258,"「ああ、そういやぁ、ひとつ腑に落ちねぇことが\n　あったな」\\nw[水夫]":259,"「なんだ？」\\nw[\\N[1]]":260,"「ヤツラ、えらい正確にオレたちの船を見つけて、\n　襲って来たんだ。\\nw[水夫]":261,"「まるで最初から、こっちの出航時間や航路を全部\n　知ってたみたいに」\\nw[水夫]":262,"「ほう？\n　じゃあ、誰かが事前に海賊へ教えてたってことは？」\\nw[\\N[1]]":263,"「なんだと！？　ふざけんな！\n　航海予定を知ってたのは身内だけなんだぞ！\n　海の男が仲間を裏切ったりするか！」\\nw[水夫]":264,"「そいつは悪かった。\n　でも、予定を知ってたのは本当に身内だけか？」\\nw[\\N[1]]":265,"「それは……そういえば、他の商会の荷も臨時で\n　ちょっとだけ積むことになったんで、その相手\n　商会にだけは話を……」\\nw[水夫]":266,"「そ、その商会って、\\N[3]のところです……」\\nw[\\N[2]]":267,"「なるほどな」\\nw[\\N[1]]":268,"「まさか\\N[3]たちが海賊に情報を漏らしたって\n　いうんですか！？」\\nw[\\N[2]]":269,"「なっ、なんだってー！？」\\nw[水夫]":270,"「断定はできないが、可能性はありそうだな。\\nw[\\N[1]]":271,"「お前の商会の船が襲われてから、メスガキ商会が\n　成り上がるまでがスムーズすぎる。\\nw[\\N[1]]":272,"「最初から、全部詳細に組み立てられてた陰謀だったと\n　したら……」\\nw[\\N[1]]":273,"「そんな……」\\nw[\\N[2]]":274,"「もしそうなら、メスガキどもと海賊の裏の繋がりを\n　立証することで、お前の冤罪を晴らせるかもな」\\nw[\\N[1]]":275,"「えっ！？\\nw[\\N[2]]":276,"「も、もしかして、わたしのために冤罪をどうにか\n　しようと……？」\\nw[\\N[2]]":277,"「陰謀を暴いて、あのメスガキを絶望のどん底に堕として\n　やったら、さぞかし気分がいいだろうなぁ……！」\\nw[\\N[1]]":278,"「あっ、わたしのためとかじゃないんですねー。\n　そうですかー」\\nw[\\N[2]]":279,"「おいおい、あんた不穏なこと言ってるが、\n　なにをやらかすつもりだ？」\\nw[水夫]":280,"「バカ正直に問い質してもムダだろうからな。\n　ここはひとつ、\\C[17]裏社会の人間から情報を集めたい\\C[0]\n　ところだが……。\\nw[\\N[1]]":281,"「顔の広い裏の人間に渡りをつけたいな。\n　あてはぜんぜん無いが」\\nw[\\N[1]]":282,"「ないんですか……」\\nw[\\N[2]]":283,"「だったら、役に立つかもしれない話がありますぜ、\n　お嬢！\\nw[水夫]":284,"「船に乗せた客から聞いた話なんですがね、なんでも\n　\\C[17]王都の貧民街\\C[0]に巣食ってる\\C[17]犯罪集団のボス\\C[0]は、すごい\n　情報通らしいんでさ。\\nw[水夫]":285,"「ただし、小物は相手にしないって話ですから、いきなり\n　行って会えるかどうかは分かりませんがね」\\nw[水夫]":286,"「貧民街のボスか。\n　そういや俺もそんな噂は聞いたことあったな。\\nw[\\N[1]]":287,"「よしっ、それでいこう！\n　ボスに接触して情報を得るぞ！」\\nw[\\N[1]]":288,"「えぇ～？！\n　で、でも、会ってもらえるでしょうか……？」\\nw[\\N[2]]":289,"「小物に用はないっていうなら、奴隷商人としての\n　名を広めてから、乗り込んでやればいい」\\nw[\\N[1]]":290,"「結局これまで通り、奴隷狩りは続けるんですね……」\\nw[\\N[2]]":291,"メインシナリオ\\C[17]『里帰り』\\C[0]を達成した！":292,"\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！":293,"「まず当面は、\\C[17]奴隷を欲しいって客の依頼\\C[0]をバンバン\n　さばいていくぞ！」\\nw[\\N[1]]":294,"「俺の名前が、貧民街のボスの耳に届くまでな！」\\nw[\\N[1]]":295,"メインシナリオ\\C[17]『名声アップ』\\C[0]を受けた！":296,"\\>　※　\\C[27]ハートマーク\\C[0]のついた個別依頼を、\\C[17]３件以上達成\\C[0]　※\n\\>　※　してから、王都の貧民街を訪ねよう！　　　　　　※":297,"エルラ（生家イベント）":298,"バルコルド（生家Eイベント）":299,"水夫（生家イベント）":300,"個別依頼19":301,"珍ペット募集":302,"「私は動物が好きでね、異国からも色々と珍しい動物を\n　輸入しては飼育してきたんだ」\\nw[好事家]":303,"「へぇー、いろんな動物と触れ合えるなんてステキですね」\\nw[\\N[2]]":304,"「しかし最近は、これといって珍しい動物が入って\n　こなくてね。退屈していたんだ。\\nw[好事家]":305,"「そんなとき気づいたんだ。\n　まだ\\C[17]ハーピー\\C[0]を飼ったことが無かった、と」\\nw[好事家]":306,"「えっ！？」\\nw[\\N[2]]":307,"「そこできみたちに、ハーピー奴隷を注文したいのだ。\n　下品な乳袋はいらんから、\\C[17]ツルッとスリムなボディ\\C[0]の\n　個体を頼みたい」\\nw[好事家]":308,"「なるほど。\n　それで報酬の方はいかほどに？」\\nw[\\N[1]]":309,"「\\C[17]８０００Ｇ\\C[0]と、価値があるかどうか不明だが\n　この\\C[17]不思議な玉\\C[0]でどうだろうか？」\\nw[好事家]":310,"個別依頼『珍ペット募集』を受けますか？":311,"受ける":312,"受けない":313,"風の塔・4階":314,"魔巣の灯台":315,"個別依頼\\C[17]『珍ペット募集』\\C[0]を受けた！":316,"\\C[17]『\\in[137]』\\C[0]を依頼者に渡しますか？":317,"渡す":318,"渡さない":319,"依頼条件達成":320,"「注文のハーピー奴隷だ。\n　ちゃんと乳袋の無いヤツを選んできたぞ」\\nw[\\N[1]]":321,"「おぉっ！　これがハーピーか！\n　いまから飼育するのが楽しみだ……フフフ」\\nw[好事家]":322,"個別依頼\\C[17]『珍ペット募集』\\C[0]を達成した！":323,"\nここでエッチイベント\n↓　　↓　　↓":324,"↓プレーヤー位置強制中央":325,"SFC_ENABLE_RESERVE":326,"依頼条件未達成":327,"「ハーピーの飼育、いまから楽しみだよ。\n　健康な個体を連れてきてくれたまえ」\\nw[好事家]":328,"依頼マーク":329,"ザーボ（海賊島案内Ev）":330,"「とうとう来たか、アサシン……俺を殺しに！」\\nw[ザーボ船長]":331,"「アサシンじゃないが、ちょっと殺してやりたくなったぞ」\\nw[\\N[1]]":332,"「\\N[1]さん、ここは抑えてください。\n　こういう人なんですよ。\\nw[\\N[2]]":333,"「あの、ザーボ船長。\n　わたしたちどうしてもドゥブカ島――海賊島に行か\n　なくちゃならないんです。\\nw[\\N[2]]":334,"「無理を承知でお願いしますが、どうか海賊島まで\n　船を出してもらえないでしょうか？」\\nw[\\N[2]]":335,"「……アサシンじゃないのか？」\\nw[ザーボ船長]":336,"「違うって言ってるだろが！」\\nw[\\N[1]]":337,"「そうか……俺の悪運もまだ尽きていないようだ。\n　無垢なる月と星に感謝を！」\\nw[ザーボ船長]":338,"「おい、こいつホントに大丈夫か？\n　ネジどころか、脳みそをどっかに落としてるんじゃ\n　ないか？」\\nw[\\N[1]]":339,"「ああっ……潮騒の歌も俺を祝福している！」\\nw[ザーボ船長]":340,"「ザーボ船長、あのぅ……わたしたちの話を……」\\nw[\\N[2]]":341,"「聞いてるぞ、海賊島に行きたいんだろ？\\nw[ザーボ船長]":342,"「あそこは無数の岩礁と渦で守られているから、正確な\n　海路を知っていなきゃ、近づくことさえできない。\\nw[ザーボ船長]":343,"「本拠地が知れていながら、いまだに海賊がのうのうと\n　活動してるのも、討伐艦隊があの島に近づけない\n　からだ」\\nw[ザーボ船長]":344,"「つまり、こっそり島に近づいて上陸するのは無理って\n　ことか？」\\nw[\\N[1]]":345,"「普通の船乗りにはな。\n　だが俺になら可能だ。海に愛されたこの俺になら！」\\nw[ザーボ船長]":346,"「じゃ、じゃあ、船を出してもらえますか！？」\\nw[\\N[2]]":347,"「そうだな……その仕事、受けてやってもいいが、\n　お前らは対価に何を支払える？　金ならいらんぞ」\\nw[ザーボ船長]":348,"「金以外を要求するのか？\n　ほんとに変なヤツだな。\\nw[\\N[1]]":349,"「俺は奴隷商人だから、奴隷で支払うってのはどうだ？\n　言ってくれれば、好みの奴隷を連れてくるぜ」\\nw[\\N[1]]":350,"「奴隷か……それも一興だな。\n　ならば、海のように\\C[17]青い髪\\C[0]を持った\\C[17]人間の女\\C[0]を希望する」\\nw[ザーボ船長]":351,"「ＯＫだ。\n　必ず連れてくるから、出航の準備をしておけよ？」\\nw[\\N[1]]":352,"水の塔・3階":353,"雪賊の隠れ家":354,"\\>　　　※　ザーボ船長の希望する\\C[17]奴隷\\C[0]を渡して、　※\n\\>　　　※　ドゥブカ島まで船を出してもらおう　　※":355,"\\C[17]『\\in[108]』\\C[0]をザーボ船長に渡しますか？":356,"「お望みの、髪が青い奴隷を連れてきたぞ」\\nw[\\N[1]]":357,"「おおっ、まさしく！\n　これこそ海にふさわしい女だ！」\\nw[ザーボ船長]":358,"ザーボ船長に奴隷を渡した！":359,"「髪が青いから海にふさわしいって、安直じゃないか？」\\nw[\\N[1]]":360,"「機嫌を損ねると面倒くさそうですから、ツッコミは\n　やめときましょうよ」\\nw[\\N[2]]":361,"「対価はいただいた。ならば俺も船を出そう！\n　たとえ行き先が見果てぬ水平線の先だとしても！」\\nw[ザーボ船長]":362,"「いや、行くのは海賊島だぞ？\n　ホントに分かってるんだろうな？」\\nw[\\N[1]]":363,"「任せておけ！\n　では早速、出航するか？」\\nw[ザーボ船長]":364,"出航する":365,"まだしない":366,"「海のように青い髪の人間の女だ。\n　そういう奴隷を連れて来られたら、船を出してやる」\\nw[ザーボ船長]":367,"「海賊島に向けて出航するか？」\\nw[ザーボ船長]":368,"「ぃよーしッ！\n　帆を張れ！　錨を上げろ！　出航だ！！」\\nw[ザーボ船長]":369,"EV080":370,"民家":371,"作業員（港）1":372,"「ドゥブカ島？　聞いたことないな。\n　よっぽど小さい、無名の島なんじゃないか？」\\nw[作業員]":373,"「毎日大量の荷が届くんで、運ぶだけでも大変だよ」\\nw[作業員]":374,"作業員（港）2":375,"「なんだって？　ドゥブカ島？\n　いいや、聞いたことも無い島だな」\\nw[作業員]":376,"「他と比べると、ここはまだ新しい街だけど、\n　貿易拠点として広く名前が知られてるんだぜ」\\nw[作業員]":377,"女性市民1":378,"「ドゥブカ島？\n　さあ？　この辺にはそんな島ないんじゃない？」\\nw[女性]":379,"「海は好きだけど、潮風のせいで髪が傷みやすいのが\n　ちょっとね……」\\nw[女性]":380,"男性市民1":381,"「すまない。地元育ちの人間じゃないんで、\n　島の名前を聞かれてもちょっと分からないな」\\nw[男性]":382,"「他の土地から引っ越してきたんだけど、海のそばは\n　いいね。気分が開放的になる」\\nw[男性]":383,"EV085":384,"娼館":385,"男性市民2":386,"「島を探してるって？\n　それよりケンカ中の妻と仲直りする方法を探してくれよ！」\\nw[男性]":387,"「家に帰りたくない……妻とケンカ中でね……」\\nw[男性]":388,"女性市民2":389,"「王都で悪竜が暴れたり、王と姫が死んだりしたという\n　話は伝わってきてますが、どこまで本当なんでしょうね？」\\nw[女性]":390,"「島……ですか？　ドゥブカ島？\n　いいえ、耳にした覚えはありませんね」\\nw[女性]":391,"「父が若かったころは、まだこんなに沢山の倉庫は\n　建っていなかったんですって」\\nw[女性]":392,"水夫1":393,"「航海図は毎日目にしてるけど、ドゥブカ島なんて名前が\n　載ってるのは見たことないな」\\nw[水兵]":394,"「海賊に商船の情報を流してた武器商ギルドの商人が\n　いたらしいぞ。王都で捕まったって話だが」\\nw[水夫]":395,"「水の積込量を間違えると、大変なことになるから\n　何重にもチェックしないと――」\\nw[水夫]":396,"兵士（追跡）2":397,"「もし海賊が街へ攻めてきたら、全員ひっ捕らえて\n　やるんだがなぁ」\\nw[兵士]":398,"個別依頼06":399,"灯台守の手記":400,"「私は、このシーグヌースの歴史をまとめて\n　出版しようと計画しているのだが……。\\nw[郷土史家]":401,"「実はひとつ、足りない資料があるのだ」\\nw[郷土史家]":402,"「どんな資料なんですか？」\\nw[\\N[2]]":403,"「島の東に古い灯台があるだろう？\n　そこの灯台守をしていた男の書いた\\C[17]手記\\C[0]が\n　必要なのだ。\\nw[郷土史家]":404,"「しかし灯台はいまやモンスターの巣窟となっていて、\n　気軽に手記を取りに行くこともできん。\\nw[郷土史家]":405,"「どうしたものかと、ずっと悩んでいるのだ」\\nw[郷土史家]":406,"個別依頼『灯台守の手記』を受けますか？":407,"「ダンジョン化した灯台か、面白そうじゃないか。\n　俺たちがその手記を取ってきてやってもいいぞ」\\nw[\\N[1]]":408,"「本当かね？　ぜひ頼むよ！\\nw[郷土史家]":409,"「もし無事に手記を持ち帰ってくれたら、お礼にそちらの\n　お嬢さんに似合いそうな\\C[17]『メイド服』\\C[0]を進呈しよう！」\\nw[郷土史家]":410,"「な、なぜにメイド服なんですか！？」\\nw[\\N[2]]":411,"「私の趣味だ……！」\\nw[郷土史家]":412,"「趣味って、誰かに着させるのか？\n　それとも自分で……いや、いい。言わなくていい」\\nw[\\N[1]]":413,"個別依頼\\C[17]『灯台守の手記』\\C[0]を受けた！":414,"「手記を取ってきたぞ。\n　これでいいか確認してくれ」\\nw[\\N[1]]":415,"「これで間違いない！\n　ありがとう、助かったよ！\\nw[郷土史家]":416,"「約束通り、このメイド服を受け取ってくれたまえ」\\nw[郷土史家]":417,"PNDK_LC getSurplusWeights 15":418,"個別依頼\\C[17]『灯台守の手記』\\C[0]を達成した！":419,"報酬として\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！\n\\N[2]の信頼度が\\C[17]「８」\\C[0]上がった！":420,"報酬として\\C[17]『\\an[\\v[191]]』\\C[0]をもらったが、\\C[18]積載可能な\n重量をオーバー\\C[0]しているため受け取れなかった。":421,"「『灯台守の手記』は、島の東に建っている\\C[17]魔巣の灯台\\C[0]に\n　あるはずだ」\\nw[郷土史家]":422,"\\>重量オーバーのため入手できなかった、個別依頼06の報酬だ。\n\\>拾いますか？\n\\>（必要とする積載重量の空き：\\C[17]５Ｗ\\C[0]）":423,"拾う":424,"拾わない":425,"\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！":426,"\\C[18]積載可能な重量をオーバー\\C[0]しているため入手できない。":427,"奴隷市":428,"奴隷市（フキダシ）":429,"奴隷市（通行不可）":430,"EV098":431,"女の子":432,"「あたし船乗りはキライだけど、船は好きよ」\\nw[女の子]":433,"EV100":434,"売り家表示":435,"ユマ生家買い戻しEv":436,"「やったぁ！　わたしの家！\n　わたしの家が戻ってきたぁ！」\\nw[\\N[2]]":437,"「家主は俺だけどな」\\nw[\\N[1]]":438,"「いいんです！\n　\\N[1]さんのものは、わたしのもの！」\\nw[\\N[2]]":439,"「普通それ逆だろうが。\n　自分が奴隷だってこと、ちゃんと覚えてるか？」\\nw[\\N[1]]":440,"「おうち～♪　ひっさしぶりの我が家～♪」\\nw[\\N[2]]":441,"「ダメだ、聞いちゃいねぇ……」\\nw[\\N[1]]":442,"「早く入りましょうよ、\\N[1]さん！」\\nw[\\N[2]]":443,"「急かすな急かすな」\\nw[\\N[1]]":444,"戦闘マーク":445,"盗賊1":446,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":447,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":448,"「邪魔をするなら殺す！」\\nw[蛮族]":449,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":450,"奴隷化性別：0=女、1=男、2=男女ランダム":451,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":452,"街中盗賊出没":453,"奴隷1":454,"「オレはずっと南方から連れられて来たんだ。\n　島のことなんて何も知るもんか」\\nw[奴隷]":455,"「隣りのヤツと同じ仕事だと思うか？\n　でも俺たち奴隷は、倍の量働かされるんだぜ！」\\nw[奴隷]":456,"奴隷2":457,"「くくく……自分の運命の変転に、我がことながら呆れる。\n　この私が奴隷とはな！」\\nw[悪魔奴隷]":458,"奴隷3":459,"「人間ごときを殺したからといって、この高貴なエルフの\n　身を奴隷に堕とすとは……おのれ！」\\nw[悪魔奴隷]":460,"奴隷4":461,"「ニンゲン、ころす。\n　もっともっと、ころしてやる」\\nw[鬼奴隷]":462,"奴隷5":463,"「あっしはケチな詐欺師でして、こんな危ない連中と\n　一緒に売られるなんて、何かの間違いじゃ……？」\\nw[人間奴隷]":464,"水夫2":465,"「ドゥブカ島ねぇ？\n　俺は全然聞いたことないなぁ」\\nw[水兵]":466,"「こいつらは、奴隷兵士として海外に売り飛ばされるんだ。\n　最前線で肉の壁にされるのさ」\\nw[水夫]":467,"猫":468,"ザーボ船長（エンディング）":469,"自宅入り口":470,"自宅":471,"EV116":472,"ＢＧＭ変更":473,"夜間用ＢＧＭ演奏":474,"夜→昼":475,"最初から昼":476,"昼→夜":477,"最初から夜":478,"ロープ(下)":479,"マストに登りますか？":480,"登る":481,"登らない":482,"ロープ":483,"依頼01・02戦闘":484,"依頼を引き受けている場合、暴漢と戦闘":485,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":486,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":487,"暴漢と戦闘":488,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":489,"襲ってきた暴漢を街の警備兵に引き渡した。":490,"暴漢":491,"レイプ魔":492,"レイプ被害者":493,"レイプマーク":494,"レイプEv向き合わせ":495,"レイプEv発生制御":496,"レイプ現場遭遇":497,"街中淫行制御":498,"エンディング1（ユマ）":499,"\n　　　\\N[6]の討伐に成功してから数ヶ月後――。":500,"「それじゃ、お買い物にいってくるねー」\\nw[\\N[2]]":501,"「今日はいい天気だなぁ。お洗濯物もよく乾きそう」\\nw[\\N[2]]":502,"「ちょっと待つニャ、\\N[2]！」\\nw[\\N[2]の父]":503,"「茶葉がもう無くなってたの、すっかり忘れてたニャ！\n　悪いけどついでに買ってきてくれるかニャ」\\nw[\\N[2]の父]":504,"「それはいいけどさ……父さん。その格好で家の外に\n　出るのはやめてって言ったよね？」\\nw[\\N[2]]":505,"「まだそんなこと言ってるのニャ？\n　これからはメイド服が仕事着ニャのに！」\\nw[\\N[2]の父]":506,"「だからってずっと着てる必要ないでしょ！\n　あと化粧も！」\\nw[\\N[2]]":507,"「ハイハイ、わかったニャ。\n　家に引っ込むから茶葉は頼んだニャ」\\nw[\\N[2]の父]":508,"「まったくもう、父さんは。隣り近所でどれだけ噂されて\n　るのか、気にもしないんだから」\\nw[\\N[2]]":509,"「……あの日々が嘘だったみたいに、毎日が平和だなぁ。\\nw[\\N[2]]":510,"「\\N[1]さん、今頃どこで何してるんだろう……」\\nw[\\N[2]]":511,"\\N[6]を倒したあと、わたしと父さんは奴隷身分から解放\nされて、故郷であるこのシーグヌースに帰ってきました。\\nw[\\N[2]]":512,"でも父さんは商会経営の仕事に戻るつもりは無いと言って、\n奴隷だったときの経験を生かした女装バーを開業しようと\nしています。\\nw[\\N[2]]":513,"できればやめて欲しいけれど、結局わたしも手伝わされ、\n準備は着々と進んでしまっており……。\\nw[\\N[2]]":514,"「まっ、\\N[1]さんのことだから、きっと元気に\n　やってるよね。\\nw[\\N[2]]":515,"「さて、買い物に行かなきゃ」\\nw[\\N[2]]":516,"「ザーボ船長！　お久しぶりですね。\\nw[\\N[2]]":517,"「海賊島のときはありがとうございました」\\nw[\\N[2]]":518,"「例のアサシンから、お前宛ての\\C[17]手紙\\C[0]を預かってきた」\\nw[ザーボ船長]":519,"「アサシンって……\\N[1]さんですか！？」\\nw[\\N[2]]":520,"「そうだ。ここに\\C[17]とある奴隷船の売買情報\\C[0]が同封して\n　あるから、好きなように使えということだ」\\nw[ザーボ船長]":521,"「奴隷船……？\\nw[\\N[2]]":522,"「あっ、まさか\\N[3]の売られた先を！？」\\nw[\\N[2]]":523,"「確かに渡したからな。\n　では俺はあの紺碧の海に戻る！　さらば！」\\nw[ザーボ船長]":524,"「\\N[3]……」\\nw[\\N[2]]":525,"「あのあと悪事が露見して奴隷身分に落とされたけど、\n　誰に売られてどうなったかは分からなかった……。\\nw[\\N[2]]":526,"「でも\\N[3]の居場所が分かるなら……。\n　うん、やっぱりこのまま見捨ててはおけない！\\nw[\\N[2]]":527,"「王国からもらった口止め料がまだあるから、奴隷の一人\n　くらいなら買えるし。\\nw[\\N[2]]":528,"「よし決めた！　\\N[3]を引き取りに行こう！」\\nw[\\N[2]]":529,"C_ENABLE_WEATHER":530,"エンディングロール\n↓　　↓　　↓":531,"↑　　↑　　↑\nエンディングロール":532,"ユマ父（エンディング）":533,"ユマ父":534,"「やっぱり故郷が一番ニャ。\n　でも昔からの知り合いが、みんな変な目で見てくるのは\n　どうにかニャらないかニャ」\\nw[\\N[2]の父]":535,"船長（海賊戦闘後）":536,"見張り台(降り口)":537,"マストを降りますか？":538,"降りる":539,"降りない":540,"フクロウ":541,"マップ取得":542,"FocusCamera 36 25 120":543,"ZoomOut 3 120":544,"\\C[17]\\V[908]の地図\\C[0]を取得した！":545,"ResetZoom 60":546,"ResetFocus 60":547,"街中イーグルダイブ":548,"ここから飛び降りますか？":549,"飛び降りる":550,"やめる":551,"水柱1":552,"掲示板依頼初期化おばあちゃん":553,"<TE:110>":554,"四聖教メッセンジャー":555,"<TE:112>":556,"会話マーク(EX)":557,"<TE:113>":558,"修正用":559,"Ver.1.0.4更新で誤ってスイッチ1141をOFFにする処理を入れてしまったので、\nここで修正をほどこす。":560},"extension":"json","dataType":"map","filename":"Map052","basename":"Map052.json","path":"data/Map052.json","relPath":"data/Map052.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":561,"percent":0.35650623885918004},"cellInfo":[]},"data/Map053.json":{"data":[["EV001",""],["入り口",""],["商業ギルド",""],["武器屋入り口",""],["武器防具店",""],["アクセサリ店",""],["魔法具店入り口",""],["魔法具店",""],["卸売商会",""],["宿屋",""],["馬車屋","Stagecoach shop"],["EV009",""],["EV010",""],["EV011",""],["EV012",""],["EV013",""],["EV014",""],["まず、ユマの父親のいる店に行かなければ。",""],["EV015",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["EV022",""],["EV023",""],["EV024",""],["EV025",""],["EV026",""],["EV027",""],["EV028",""],["EV029",""],["景気ランタン",""],["EV031",""],["EV032",""],["EV033",""],["EV035",""],["EV036",""],["EV037",""],["EV038",""],["EV039",""],["EV040",""],["EV041",""],["女性",""],["「たとえ\\N[6]が襲い来るとしても、きっと四聖神が\n　守ってくださるわ……」\\nw[信心深い女]",""],["「大司教様が背教したという噂が流れているけれど、\n　きっと何かの間違いだわ」\\nw[信心深い女]",""],["「あなた商人なの？\n　儲けているんなら、ちゃんと聖堂に寄付しなさいよ」\\nw[信心深い女]",""],["男性市民（闘技場）",""],["「おい聞いたか！？\n　伝説の悪竜が甦って、パルフュークを攻撃したって！」\\nw[男性]",""],["「剣闘試合は賭けの対象になってるから、みんな熱く\n　なりやすいんだよなぁ」\\nw[男性]",""],["「あんた、なかなか強そうだな。\n　\\C[17]闘技場\\C[0]で剣闘試合に出てみたらどうだい？」\\nw[男性]",""],["男性",""],["「チェリア様の即位で、これから王国は良くなっていくと\n　信じてるよ」\\nw[地元の男]",""],["「嘘か本当か分からんが、大公が反乱を目論んで\n　悪竜を復活させたとか。世も末だぜ」\\nw[地元の男]",""],["「王都に来ることを夢見る田舎者は多いらしいが、そんなに\n　憧れるほどのもんかねぇ？」\\nw[地元の男]",""],["女性市民（闘技場）",""],["「パルフューク大公がアルテトを甦らせたって\n　聞いたけど、本当なのかしら？」\\nw[女性]",""],["「また剣闘試合が原因で、観客の乱闘騒ぎがあったん\n　ですって。まったく、バカみたい」\\nw[女性]",""],["「もしかして剣闘試合の観戦にきたの？\n　やめときなさいよ、あんな暴力的なもの」\\nw[女性]",""],["「悪竜アルテトの復活と聞いて、冒険者の血がひさびさに\n　うずき出してきたぜ」\\nw[元冒険者]",""],["「今度、冒険で稼いだ金を元手にして宿屋を開くんだ。\n　冒険者ってのも一生続けられる仕事じゃないからね」\\nw[元冒険者]",""],["女性市民（公園）",""],["「悪竜は死んだっていうし、ようやく外で子供を遊ばせ\n　られるわ」\\nw[母親]",""],["「副都は悪竜とモンスターに襲われて大変なことに\n　なったらしいけど、王都は大丈夫かしら？」\\nw[母親]",""],["「子供はちっとも、じっとしてないんだから」\\nw[母親]",""],["「悪竜が相手じゃ、あたしみたいな普通の冒険者風情には\n　出る幕が無さそうだね」\\nw[冒険者]",""],["「王都は規模の割に、冒険の依頼はそれほど多くないんだ。\n　雑用みたいな仕事の依頼はたくさん来るけど」\\nw[冒険者]",""],["公園猫",""],["依頼フキダシ",""],["工事監督官（依頼31）",""],["依頼を出している場合",""],["執事（依頼21）",""],["研究者（依頼32)",""],["スケベじじい（依頼19）",""],["男性市民（公園）",""],["「大公殿下が悪竜を甦らせたというデマを、ワシは信じて\n　しまったのだ。なんと愚かだったことか……」\\nw[老人]",""],["「国王と違って、大公殿下は分別のある方だとおもって\n　おったが……悪竜を甦らせるとは、なんとバカげた\n　行いをしたものか」\\nw[老人]",""],["「散歩の途中に、ここに立ち寄るのが日課でね」\\nw[老人]",""],["子供（公園）",""],["「アヒルさん、こっち向いて！\n　ぐわっ！　ぐわっ！」\\nw[女の子]",""],["公園アヒル",""],["公園看板",""],["『王都中央公園』",""],["女の子（道端）",""],["「あくりゅうって、おっきいんでしょ？\n　あたし見てみたい！」\\nw[女の子]",""],["「だいじょうぶ！　迷子じゃないよ！\n　ほんとだよ！」\\nw[女の子]",""],["「悪竜が空を飛ぼうが、大公が反逆しようが、\n　変わらずオレの腹は減るんだよなぁ……」\\nw[薄汚い男]",""],["「あぁクソッ！　腹減ったなぁ……。\n　どうせお前らはいいモン食ってんだろ？」\\nw[薄汚い男]",""],["「……なにもかも、どうでもいい」\\nw[愛想のない男]",""],["「……話す気分じゃない。放っておいてくれ」\\nw[愛想のない男]",""],["光",""],["EV066",""],["犬",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["馬車",""],["通行遮断",""],["食料品店",""],["おっぱいマニア（依頼18）",""],["浮気調査（依頼13・14・15）",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 14 20",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ター