dex":20,"headerParam":["依頼を出している場合"]},{"headerIndex":29,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]},{"headerIndex":1,"headerParam":["依頼を出している場合"]}]],"indexIds":{"EV001":0,"客1":1,"「思い出作りに田舎から遊びに出てきたんだども……\n　やっぱり街の女は綺麗だべなぁ」\\nw[客]":2,"EV003":3,"EV004":4,"EV005":5,"娼婦":6,"「以前ここにいた奴隷娼婦は、うまいこと客をつかんで\n　身請けされていったわ。今じゃ船長夫人だって」\\nw[娼婦]":7,"「水夫の客は多いけど、中には酔って暴れるようなヤツも\n　いるの。このあいだもそれで出禁になったのがいたわ」\\nw[娼婦]":8,"ドア":9,"部屋の中でお楽しみ中のようだ。":10,"燭台":11,"窃盗用下着3":12,"<TE:118>":13,"客2":14,"光":15,"EV015":16,"娼館従業員":17,"個別依頼30":18,"道具遊びＢ":19,"「まいったわぁー……。\n　変な客に目をつけられちゃって、難儀してるのよ」\\nw[娼婦]":20,"「そいつは大変だな、それじゃ」\\nw[\\N[1]]":21,"「待って待って！\n　話くらい聞いていってよぉ！\\nw[娼婦]":22,"「あのね、猫人が好きだっていうお客なんだけど、\n　そいつが執拗に\\C[17]お尻でのプレイ\\C[0]を要求してくるの。\\nw[娼婦]":23,"「あたしはアナルＮＧだって言ってるのに、全然\n　あきらめてくれなくてさぁ」\\nw[娼婦]":24,"「それはお気の毒に」\\nw[\\N[2]]":25,"「あっ、そうだあんた！\n　あたしの代わりにそのお客と、アナルプレイして\n　みない？\\nw[娼婦]":26,"「ちょっとお尻の穴に、アナルビーズとか入れられる\n　だけだからさ」\\nw[娼婦]":27,"「やってもいいですよ\\I[29]\n　\\N[1]さんの許可さえあればですけど」\\nw[\\N[2]]":28,"「却下だ。こいつは重要な戦力なんだよ。\n　娼館で客待ちをさせとくわけにはいかん」\\nw[\\N[1]]":29,"「絶対にイヤです♪」\\nw[\\N[2]]":30,"「じゃあさ、じゃあさ、支配人が店に新しく奴隷娼婦を\n　入れたいって言ってたから、あたしと似た感じの\\C[17]猫人\\C[0]を\n　売り込んでよ」\\nw[娼婦]":31,"「そいつに客の相手を押しつける気だな。\n　しかしお前に似たっていうと……\\C[17]貧乳\\C[0]な娘ってことか？」\\nw[\\N[1]]":32,"「うっ、うっさいわね！　でもそういうことよ！\n　おっぱいバインバインなフェロモン系の女なんか\n　連れてきちゃダメだからね！\\nw[娼婦]":33,"「店からは\\C[17]５０００Ｇ\\C[0]が出ると思うけど、それに加えて\n　あたしから\\C[17]\\in[52]\\C[0]をプレゼントしちゃうわ。\\nw[娼婦]":34,"「お客からのプレゼントの横流し品だけど」\\nw[娼婦]":35,"個別依頼『道具遊びＢ』を受けますか？":36,"受ける":37,"受けない":38,"水の塔・2階":39,"迷いの森":40,"個別依頼\\C[17]『道具遊びＢ』\\C[0]を受けた！":41,"\\C[17]『\\in[116]』\\C[0]を依頼者に渡しますか？":42,"渡す":43,"渡さない":44,"依頼条件達成":45,"「ほら、お前と似た体形の貧乳猫人奴隷、連れてきて\n　やったぞ」\\nw[\\N[1]]":46,"「言い方はムカつくけど、助かったわ！\n　これであの客の、強引なアナル要求から逃げられる！」\\nw[娼婦]":47,"個別依頼\\C[17]『道具遊びＢ』\\C[0]を達成した！":48,"\nここでエッチイベント\n↓　　↓　　↓":49,"↓プレーヤー位置強制中央":50,"SFC_ENABLE_RESERVE":51,"依頼条件未達成":52,"「猫人の奴隷、ちゃんと見つけてきてよ！\n　なるべくあたしと似た感じの娘をお願いよ！」\\nw[娼婦]":53,"依頼マーク":54,"男":55,"\n\\>　　　　　　　　～　娼館の一室にて　～":56,"「いやぁ、キミは\\C[17]アナルプレイＯＫ\\C[0]なんだって？\n　そいつは楽しみだなぁ」\\nw[男性客]":57,"「やりたくってやるワケじゃないわ！\n　それに言っておくけど、あたし、お尻は未経験で\n　なんの準備もできていないからね！」\\nw[奴隷娼婦]":58,"「そこはまかせといて！\n　尻アクメをキメられるよう、僕が開発してあげるから！」\\nw[男性客]":59,"「い、いいわよ開発なんかしなくったって！」\\nw[奴隷娼婦]":60,"「まあまあ、そう警戒せずに。\\nw[男性客]":61,"「さあ、それじゃベッドで四つん這いになってお尻を\n　出してくれるかい？」\\nw[男性客]":62,"「アナルセックスが、こんなにいいなんてぇ……\\I[29]」\\nw[奴隷娼婦]":63,"「キミは素質があるよ！\n　よければ今後も指名して、僕がアナル開発をして\n　あげたいんだけど？」\\nw[男性客]":64,"「おっ、お願いします！\n　もっとあたしのお尻使ってください\\I[29]」\\nw[奴隷娼婦]":65,"↓プレーヤー位置強制中央解除":66,"SFC_DISABLE_RESERVE":67,"個別依頼『道具遊びＢ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[52]\\C[0]を入手した！":68,"\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！":69,"セックス中":70,"娼館の客（依頼22~25)":71,"依頼を出している場合":72,"依頼フキダシ":73,"娼館支配人（依頼20）":74,"奴隷市（フキダシ）":75,"薄衣購入フキダシ":76},"extension":"json","dataType":"map","filename":"Map432","basename":"Map432.json","path":"data/Map432.json","relPath":"data/Map432.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":77,"percent":0},"cellInfo":[]},"data/MapInfos.json":{"data":[["MAP001","MAP001","","",""],["ゲーム開始用","For starting the game","","",""],["回想用","For reminiscence","","",""],["フィールドマップ左","Field map left","","",""],["フィールドマップ右","Field map right","","",""],["開幕の町ラノティカ-No.4","Opening Town Lanotica-No.4","","",""],["精錬所","smelter","","",""],["宿屋","inn","","",""],["商業ギルド","Commerce Guild","","",""],["武器防具屋","Weapon and armor shop","","",""],["アクセサリ屋","accessory shop","","",""],["大聖堂地下1","Cathedral basement 1","","",""],["卸売商会","Wholesale Chamber of Commerce","","",""],["神殿","temple","","",""],["厩舎","stable","","",""],["自宅","Player home","","",""],["西グレド村-No.15","West Gredo Village-No.15","","",""],["村長宅","Village chief's house","","",""],["豚小屋","pigpen","","",""],["東グレド村-No.14","Higashigredo Village-No.14","","",""],["南都タータミア-No.3","Nanto Tatamia-No.3","","",""],["宿屋二階","Inn second floor","","",""],["醸造所","Brewery","","",""],["商業ギルド二階","Commerce Guild second floor","","",""],["娼館","brothel","","",""],["二階","Upstair