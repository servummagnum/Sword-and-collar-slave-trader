headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":60,"headerParam":["",0,0,2]}],[{"headerIndex":63,"headerParam":["",0,0,2]},{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":71,"headerParam":["",0,0,2]},{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":79,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["",0,0,2]}],[{"headerIndex":53,"headerParam":["",0,0,2]}],null,[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":10,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":59,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":75,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":99,"headerParam":["",0,0,2]}],[{"headerIndex":102,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"燭台":1,"光":2,"敵索敵スタート":3,"エルラ邸２階":4,"鍵":5,"アイテム\\C[17]『\\in[69]』\\C[0]を拾った。":6,"移動可能椅子1":7,"移動後椅子1":8,"移動可能椅子2":9,"移動後椅子2":10,"移動可能椅子3":11,"移動可能椅子4":12,"移動可能椅子5":13,"移動可能椅子6":14,"移動可能椅子7":15,"EV023":16,"EV024":17,"宝箱（装飾品正面開き）":18,"<TE:7>":19,"ドア（エルラ部屋）":20,"\\C[17]『\\in[69]』\\C[0]を使ってドアを開けた。":21,"鍵がかっていて開かない。":22,"二階Ev":23,"「２階はずいぶんと散らかっていますね」\\nw[\\N[2]]":24,"「まだ引っ越し作業が終わっていないようだな。\\nw[\\N[1]]":25,"「さすが成金商人。\n　引っ越しの荷物も多いと見えるぜ」\\nw[\\N[1]]":26,"引っ越し業者2":27,"「奥の部屋は優先して荷解きと整理を終わらせてるから、\n　放っておいて大丈夫だ。\n　……っていうか、近づかないようにしろ。\\nw[引っ越し業者]":28,"「あの口うるさいお嬢様の部屋だから、下手に入ったり\n　すると即刻クビにされるかもしれないぜ？」\\nw[引っ越し業者]":29,"移動可能木箱":30,"木箱から何か落ちた。":31,"引っ越し業者1":32,"「\\C[17]木箱\\C[0]を隣の部屋へ運んでくれ」\\nw[引っ越し業者]":33,"「やれやれ。\n　荷物が多すぎて、梱包を解くだけでもひと仕事だよ」\\nw[引っ越し業者]":34,"引っ越し業者Ev":35,"「なんだ、あんたら？\n　屋敷の使用人……じゃないよな？」\\nw[引っ越し業者]":36,"「えっ、えっと、わたしたちは――」\\nw[\\N[2]]":37,"「ああ、もしかして頼んでおいた引っ越しの\n　アルバイトか？」\\nw[引っ越し業者]":38,"「そ、そうだ！　その通り！\n　ここで仕事を手伝えって言われて来たんだ！」\\nw[\\N[1]]":39,"「そいつは助かった。\n　見ての通り片付けなきゃならない荷物が山積みでな。\\nw[引っ越し業者]":40,"「それじゃあ、まずそこにある\\C[17]木箱\\C[0]を隣の部屋まで\n　運んでくれ」\\nw[引っ越し業者]":41,"「りょ、了解しましたぁ～」\\nw[\\N[2]]":42,"引っ越し業者3":43,"「やべぇ……預かってた部屋の合鍵、どっかに落とし\n　ちまった……」\\nw[引っ越し業者]":44,"木箱マーク1":45,"木箱マーク2":46,"エルラ部屋入室Ev":47,"「ここが\\N[3]の部屋なのかな……？\n　うわぁ～、すごいなぁ～」\\nw[\\N[2]]":48,"「感心してる場合じゃないぞ。\n　早いところ、メスガキの弱味を探すんだ」\\nw[\\N[1]]":49,"「そう言われても、いったいどこをどう探せば？」\\nw[\\N[2]]":50,"「怪しそうなところを手当たり次第に調べるぞ。\n　例えば、ああいうタンスや戸棚とか」\\nw[\\N[1]]":51,"エルラ部屋マーク1":52,"定規":53,"定規（アイテム）":54,"アイテム\\C[17]『\\in[70]』\\C[0]を拾った。":55,"エルラ部屋漁りEv（調査箇所1）":56,"戸棚を調べますか？":57,"調べる":58,"やめておく":59,"「ん……あれ？　開かないぞ？\n　中でなにか引っかかってるのか？」\\nw[\\N[1]]":60,"「さっき拾った\\C[17]定規\\C[0]を、棚の隙間に入れて動かして\n　みたらどうですか？」\\nw[\\N[2]]":61,"「おっ、そうだな。どれどれ……」\\nw[\\N[1]]":62,"「よしっ、引っかかりが外れたぞ！\n　それじゃ開けてみるか。何が入ってるかな」\\nw[\\N[1]]":63,"「……別に変わったものはありませんね。\n　リボン、櫛、手鏡、ブローチ……」\\nw[\\N[2]]":64,"「いや、よく見ろ。ここに手帳があるぞ。\n　中身は……どれどれ――」\\nw[\\N[1]]":65,"「なんだこりゃ！？」\\nw[\\N[1]]":66,"「なんです？\n　何が書かれてるんですか？」\\nw[\\N[2]]":67,"「いやはや、こいつは驚いたぜ。\n　まさか――」\\nw[\\N[1]]":68,"FocusCamera 35 15 120":69,"\\{「いつまでやってるのよ！？\n　まだ片付かないの！！」\\}\\nw[\\N[3]]":70,"「ただいま全力で作業してますので、もうしばらく……」\\nw[引っ越し業者]":71,"\\{「フンッ！　まったく使えない業者ね！」\\}\\nw[\\N[3]]":72,"ResetFocus 120":73,"「あのヒステリックな大声はメスガキだな。\n　この部屋に来るつもりか？」\\nw[\\N[1]]":74,"「ま、まずいですよ！\n　このままじゃ見つかっちゃいます！」\\nw[\\N[2]]":75,"「仕方ない。\n　そこのクローゼットに隠れるぞ」\\nw[\\N[1]]":76,"「まったく……ほんとイライラするわね！\\nw[\\N[3]]":77,"鉤爪捜索で顔を合わせている場合":78,"「それもこれも、全部\\N[2]とフード野郎のせいよ！\\nw[\\N[3]]":79,"「あいつら、今度会ったら再起不能にしてやる\n　んだからッ！！」\\nw[\\N[3]]":80,"まだ鉤爪捜索で顔を合わせていない場合":81,"「ああっ、もう！\n　この溜まりに溜まったストレスを解消するには……\n　やっぱりアレね」\\nw[\\N[3]]":82,"ここからエルラＨシーン\n↓　　↓　　↓":83,"↑　　↑　　↑\nここまでエルラＨシーン":84,"「あぁ……きもちよかったぁ\\I[29]\\nw[\\N[3]]":85,"「やっぱりストレス解消はこれが一番ね\\I[29]」\\nw[\\N[3]]":86,"「そういえばこの後、貴族のパーティーに行く予定が\n　あったけ！」\\nw[\\N[3]]":87,"「ボンボンどものご機嫌取りして、ウチに投資させなきゃ！\n　遅れたら大変だわ！」\\nw[\\N[3]]":88,"「そうだ、日記帳！\\nw[\\N[3]]":89,"「……まっ、記録するのは後でいいか。\n　今は急がなきゃだし」\\nw[\\N[3]]":90,"「ふぅ～、見つからずに済みましたね。\n　よかったぁ～。\\nw[\\N[2]]":91,"「でも\\N[3]の、あんなコトしてる現場に遭遇しちゃう\n　なんて……\\I[29]」\\nw[\\N[2]]":92,"「でも\\N[3]の、あ、あんなコトしてる現場に遭遇しちゃう\n　なんて……」\\nw[\\N[2]]":93,"「なかなかのオナニーっぷりだったな。\n　性根は腐り果ててるが、体はなかなかのモンじゃないか」\\nw[\\N[1]]":94,"「はいはい、貧相な胸ですみませんね……」\\nw[\\N[2]]":95,"「誰もそんなこと言ってないだろう。\n　すねるなよ」\\nw[\\N[1]]":96,"「あっ、そうだ。\n　\\N[3]が日記帳とか言ってましたけど、もしかして\n　その手帳が？\\nw[\\N[2]]":97,"「何か重要なことでも書かれているんですか？」\\nw[\\N[2]]":98,"「実に面白い記録だ。\n　ほれ、自分の目で確かめてみろ」\\nw[\\N[1]]":99,"『○月△日\n　今日はクリトリスを中心に弄った。\n　いままでで一番たくさん潮が出たかもしれない』":100,"『○月Ｘ日\n　おまんことアナルをダブルで弄った。\n　お尻に指を挿れるのは、やっぱりまだ怖いわ』":101,"「えっ、これ……うわぁ……\\I[29]」\\nw[\\N[2]]":102,"「なっ、なっ……なんですかこれぇ？！」\\nw[\\N[2]]":103,"「あのメスガキ、自分のオナニーを記録してるんだよ。\n　さしずめ\\C[27]『オナニー日記』\\C[0]だな」\\nw[\\N[1]]":104,"「\\N[3]ったら、ほんとにエッチなんだから\\I[29]\n　わたしも真似してみようかな\\I[29]」\\nw[\\N[2]]":105,"「えぇ～？！」\\nw[\\N[2]]":106,"「ご丁寧に自筆の署名まで入っていやがる。\n　これなら脅迫の材料として十分だ」\\nw[\\N[1]]":107,"アイテム\\C[17]『\\in[71]』\\C[0]を入手した！":108,"「これで目的は達した。ずらかるぞ！」\\nw[\\N[1]]":109,"\\>　※　依頼者のところへ\\C[17]『オナニー日記』\\C[0]を届けて　※\n\\>　※　報告しよう！　　　　　　　　　　　　　　　※\\<":110,"「揺すってみたらどうです？」\\nw[\\N[2]]":111,"「うーん……ダメっぽいな。\\nw[\\N[1]]":112,"「ここに隙間があるから、なにか\\C[17]長くて平べったい物\\C[0]でも\n　あれば、差し込んで中の邪魔なものを動かせそうだが……」\\nw[\\N[1]]":113,"エルラ":114,"業者（エルラと会話）":115,"エルラ部屋マーク2":116,"エルラ部屋マーク3":117,"調査箇所2":118,"タンスを調べますか？":119,"「おい見ろ！\n　バカみたいに布面積が少ない水着があるぞ！」\\nw[\\N[1]]":120,"「\\N[3]ったら、こんな大胆な水着を……\\I[29]」\\nw[\\N[2]]":121,"「なにを見つけてるんですか！？\n　真面目にやってくださいよ！」\\nw[\\N[2]]":122,"「この水着以外、特に目につくものはないか。\n　ここはハズレだな。\\nw[\\N[1]]":123,"「……………………。\\nw[\\N[1]]":124,"「よしっ、行きがけの駄賃だ。\n　この水着はいただいておこう！」\\nw[\\N[1]]":125,"アイテム\\C[17]『\\in[55]』\\C[0]をこっそり盗んだ！":126,"ここには特に見るべきものは無い。":127,"「なにやってるんですか！？　もうっ！」\\nw[\\N[2]]":128,"調査箇所3":129,"キャビネットを調べますか？":130,"「おっ、こんなところに\\C[17]精霊石\\C[0]が。\n　よしよし、俺が有意義に使ってやろう」\\nw[\\N[1]]":131,"「あからさまな窃盗じゃないですか」\\nw[\\N[2]]":132,"「いいんだよ。\n　メスガキから受けた精神的苦痛に対する慰謝料だ」\\nw[\\N[1]]":133,"アイテム\\C[17]『\\in[46]』\\C[0]を入手した。":134,"「精霊石の他は……大したものありませんね。\n　ここは空振りみたいです」\\nw[\\N[2]]":135,"バルコルド（後日談Ev）":136,"「あーっ！　もうっ！\n　ムカつく！　ムカつくぅーッ！！\\nw[\\N[3]]":137,"「あんな貧乏商人に脅されて、巻き上げた権利証を\n　返すハメになるなんてぇーッ！！」\\nw[\\N[3]]":138,"「お嬢様、そうまでして取り返したあの手帳とは\n　一体どのような……？」\\nw[\\N[4]]":139,"「えっ！？　そ、それは……\\nw[\\N[3]]":140,"「別になんでもないわよ！\n　ただのスケジュール帳だから！」\\nw[\\N[3]]":141,"「そ、そうなのですか？\\nw[\\N[4]]":142,"「では、私はこれで失礼いたします」\\nw[\\N[4]]":143,"「これ、やっぱり中身は見られちゃったわよね？\\nw[\\N[3]]":144,"「たかが貧乏行商人ひとりに知られたからって、あたしは\n　全然気にしないけど……。\\nw[\\N[3]]":145,"「でも、どこまで読まれたんだろ？　全部かしら？」\\nw[\\N[3]]":146,"「ちょっ、なにこれ！？\n　ページがひっついて、ガビガビになってるじゃない！\n　変な匂いもするし！\\nw[\\N[3]]":147,"「あの行商人！　あたしの日記帳になにしたのよぉッ？！」\\nw[\\N[3]]":148,"個別依頼『正義の脅迫』の達成報酬として\\C[17]\\in[50]\\C[0]を\n入手した！":149,"\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！\n\\N[2]の発情度が\\C[17]「７」\\C[0]上がった！":150,"窃盗用下着4":151,"<TE:119>":152},"extension":"json","dataType":"map","filename":"Map346","basename":"Map346.json","path":"data/Map346.json","relPath":"data/Map346.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":153,"percent":0},"cellInfo":[]},"data/Map347.json":{"data":[["EV001",""],["奥の抜け穴を通って、湖へ行かなければ。",""],["一度地上へ戻る",""],["戻らない",""],["EV002",""],["鍵がかかっている。",""],["冒険者",""],["「準備はいいか？」\\nw[冒険者]",""],["大丈夫だ",""],["ちょっと待って",""],["「よし、それじゃあ顔がバレないよう、このマスクを\n　つけてくれ」\\nw[冒険者]",""],["「これで準備万端だな。\\nw[冒険者]",""],["「裏道はそこの抜け穴を通った先だ。\n　さあ行こうぜ！」\\nw[冒険者]",""],["抜け穴マーク",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""]],"context":[["Map347/events/1/name"],["Map347/events/1/pages/1/list/0/message/noPicture/bottom"],["Map347/events/1/pages/1/list/2/Show Choices/2/1from2"],["Map347/events/1/pages/1/list/2/Show Choices/2/2from2"],["Map347/events/2/name"],["Map347/events/2/pages/0/list/2/message/noPicture/bottom","Map347/events/2/pages/2/list/2/message/noPicture/bottom"],["Map347/events/3/name"],