:0,"headerParam":["敵がプレイヤーを見失ったときの処理"]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":4,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":7,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":42,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":44,"headerParam":["↓アイテムの重量を変数に入力する"]}],null,null,[{"headerIndex":0,"headerParam":["↓金額おまかせの場合は変数を「0」のままに。"]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":4,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":12,"headerParam":["",0,0,2]}],null,[{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":18,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":42,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":73,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"敵索敵スタート":0,"PSS start":1,"１階":2,"燭台":3,"EV003":4,"EV004":5,"EV005":6,"光":7,"敵01":8,"<PsensorS:\\V[1166] Rv\\S[22]>":9,"探索範囲にプレイヤー侵入":10,"SmartPath 0 -1":11,"SmartPath 0 cancel":12,"敵に見つかっている場合の戦闘":13,"勝利したとき":14,"PSS t_stop":15,"逃げたとき":16,"戦闘から離脱したときの処理":17,"PSS t_start":18,"敵がプレイヤーを見失ったときの処理":19,"敵02":20,"敵03":21,"火":22,"貴族1":23,"「結局、\\N[6]に対して対策を打つ前に騒動は収束して\n　しまったなぁ……」\\nw[田舎貴族]":24,"「\\N[6]の対策会議を開くというので、初めて王宮へ\n　来たが……なんとも豪華なものだな」\\nw[田舎貴族]":25,"宝箱（魔導書正面開き）":26,"<TE:10>":27,"宝箱（武器）":28,"※\n武器：剣（現在Lvより3上のランク）\n※":29,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":30,"↓アイテムのIDNo.を変数に入力する":31,"↓アイテムの入手個数を変数に入力する":32,"↓アイテムの重量を変数に入力する":33,"宝箱（お金正面開き）":34,"<TE:16>":35,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":36,"メイド":37,"「悪竜が退治されて良かったわぁ。\n　王宮が壊されてたら失業してたかもしれないもの」\\nw[メイド]":38,"「会議だとかで、ここのところ人の出入りが激しいの。\n　清掃にベッドメイクに、大忙しよ」\\nw[メイド]":39,"貴族2":40,"「急に王国存亡の危機が訪れたと思ったら、また急に\n　解決してしまって……なんのための対策会議だったのか」\\nw[貴族]":41,"「襟元よし！　ヒゲの形よし！\n　乱れた格好で姫様にお会いしては、失礼だからな」\\nw[貴族]":42,"EV026":43,"EV027":44,"EV028":45,"隊長":46,"「なんだ貴様は！？　招待客ではないな！\n　侵入者め、成敗してくれる！！」\\nw[隊長]":47,"「お前……いや、あなた様は！？\\nw[隊長]":48,"「ど、どうか黙って立ち去ってください！\n　あなたの正体がバレたら面倒なことになりますから！」\\nw[隊長]":49,"兵士":50,"「ぐぁっ……うぅ……」\\nw[兵士]":51,"敵侵入禁止":52,"鍵":53,"\\C[17]『王宮の鍵』\\C[0]を入手した。":54,"鍵目印":55,"騎士（倒れ）":56,"「うぐぐぐ……」\\nw[隊長]":57,"冒険者1":58,"「五本の指に入る冒険者だと自負しちゃいたが、\n　まさかこのオレが王国の\\N[6]対策会議に\n　招かれるとは……」\\nw[冒険者]":59,"「部屋を用意してくれるのはいいんだけど……なんで\n　あいつと同室なのよ！？\n　いまからでも勝負下着に履き替えないと……\\I[29]」\\nw[冒険者]":60,"トイレドア（排泄Ev）":61,"トイレで用を足しますか？":62,"入る":63,"入らない":64,"いまのところ用を足す必要は無い。":65,"助けた冒険者":66,"「きみたちは！？\n　まさか、こんなところで再会できるなんて！」\\nw[冒険者]":67,"「あっ！　たしか迷いの森で毒に倒れていたところを\n　助けた冒険者さん……？」\\nw[\\N[2]]":68,"「そうそう、覚えていてくれたかい！\n　あのときは本当に助かったよ」\\nw[冒険者]":69,"「元気なようで何よりだが、どうしてあんたが王宮に？」\\nw[\\N[1]]":70,"「実は\\N[5]姫主催で開かれる\\N[6]対策会議に\n　出席する予定でね」\\nw[冒険者]":71,"「へぇ、それで王宮から招待を？\n　あんた、そんなに凄い冒険者だったのか」\\nw[\\N[1]]":72,"「年の功というやつさ。\n　冒険歴だけは長いもんでね。\\nw[冒険者]":73,"「それで、きみたちも対策会議に呼ばれたのかな？」\\nw[冒険者]":74,"「え……ええ。そんなところです」\\nw[\\N[2]]":75,"「そうだ！　今度会ったら必ず\\C[17]お礼をする\\C[0]と言ったよね。\n　いまが正にそのときだ！」\\nw[冒険者]":76,"「おおっ、待ってました！」\\nw[\\N[1]]":77,"「\\N[1]さん……」\\nw[\\N[2]]":78,"「私が提供できる最高の武具だ。\n　どうか受け取ってほしい」\\nw[冒険者]":79,"冒険者が恩返しに\\C[17]宝箱\\C[0]を用意してくれた！":80,"「きみたちに命を救われた恩は、一生忘れないよ」\\nw[冒険者]":81,"宝箱目印":82,"会話マーク":83,"トイレマーク":84,"ユマ（トイレ）":85,"王宮売店":86,"「ようこそ王宮売店へ」\\nw[販売員]":87,"買う":88,"売る":89,"ShopInventory apply shop319":90,"ショップ拡張設定 購入/売却コマンド表示最適化":91,"ショップ拡張設定 購入価格レート 変数 #1":92,"ショップ拡張設定 売却のみ":93,"窃盗用下着4":94,"<TE:119>":95},"extension":"json","dataType":"map","filename":"Map336","basename":"Map336.json","path":"data/Map336.json","relPath":"data/Map336.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":96,"percent":2.083333333333333},"cellInfo":[]},"data/Map337.json":{"data":[["敵索敵スタート",""],["１階",""],["使用人",""],["「この先は王族のプライベートエリアです。\n　招待客といえど、入ることは厳禁となっております」\\nw[使用人]",""],["ゲート",""],["『王宮の鍵』を使って扉を開けますか？",""],["使う",""],["使わない",""],["王宮の奥へ続く扉が開いた！",""],["扉は固く閉ざされている。\n開けるには、鍵を探してこなければ。",""],["扉には鍵がかかっているようだ。",""],["「なにをしているのですか？」\\nw[使用人]",""],["「いや、ちょっと興味本位で。\n　この先はどうなってるのかなぁ～と……」\\nw[\\N[1]]",""],["「その扉の先は王族以外立ち入り禁止となっています。\n　どうかお引き取りください」\\nw[使用人]",""],["「アハハ……そ、そうなんですかぁ～。\n　失礼しましたぁ～」\\nw[\\N[2]]",""],["燭台",""],["光",""],["EV012",""],["EV013",""],["EV014",""]],"context":[["Map337/events/1/name"],["Map337/events/1/pages/0/list/0/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map337/events/2/name"],["Map337/events/2/pages/0/list/0/message/noPicture/bottom"],["Map337/events/3/name"],["Map337/events/3/pages/0/list/1/message/noPicture/bottom"],["Map337/events/3/pages/0/list/3/Show Choices/3/1from2"],["Map337/events/3/pages/0/list/3/Show Choices/3/2from2"],["Map337/events/3/pages/0/list/25/message/noPicture/bottom"],["Map337/events/3/pages/0/list/45/message/noPicture/bottom"],["Map337/events/3/pages/0/list/53/message/noPicture/bottom"],["Map337/events/3/pages/0/list/58/message/noPicture/bottom"],["Map337/events/3/pages/0/list/76/message/noPicture/bottom"],["Map337/events/3/pages/0/list/81/message/noPicture/bottom"],["Map337/events/3/pages/0/list/87/message/noPicture/bottom"],["Map337/events/6/name","Map337/events/10/name","Map337/events/11/name"],["Map337/events/7/name","Map337/events/8/name","Map337/events/9/name"],["Map337/events/12/name"],["Map337/events/13/name"],["Map337/events/14/name"]],"tags":[["gold"],["green"],["gold"],null,["gold"],null,null,null,null,null,null,null,null,null,null,["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[null,[{"attachment":"scriptCommand/16944098119442474.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":25,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],[{"headerIndex":53,"headerParam":["",0,0,2]}],[{"headerIndex":58,"headerParam":["",0,0,2]}],[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":87,"headerParam":["",0,0,2]}]],"indexIds":{"敵索敵スタート":0,"１階":1,"使用人":2,"「この先は王族のプライベートエリアです。\n　招待客といえど、入ることは厳禁となっております」\\nw[使用人]":3,"ゲート":4,"『王宮の鍵』を使って扉を開けますか？":5,"使う":6,"使わない":7,"王宮の奥へ続く扉が開いた！":8,"扉は固く閉ざされている。\n開けるには、鍵を探してこなければ。":9,"扉には鍵がかかっているようだ。":10,"「なにをしているのですか？」\\nw[使用人]":11,"「いや、ちょっと興味本位で。\n　この先はどうなってるのかなぁ～と……」\\nw[\\N[1]]":12,"「その扉の先は王族以外立ち入り禁止となっています。\n　どうかお引き取りください」\\nw[使用人]":13,"「アハハ……そ、そうなんですかぁ～。\n　失礼しましたぁ～」\\nw[\\N[2]]":14,"燭台":15,"光":16,"EV012":17,"EV013":18,"EV014":19},"extension":"json","dataType":"map","filename":"Map337","basename":"Map337.json","path":"data/Map337.json","relPath":"data/Map337.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":20,"percent":0},"cellInfo":[]},"data/Map338.json":{"data":[["敵索敵スタート",""],["PSS start",""],["１階（大広間）",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["EV003",""],["EV004",""],["EV005",""],["燭台",""],["光",""],["敵01",""],["<PsensorS:\\V[1166] Rv\\S[22]>",""],["探索範囲にプレイヤー侵入",""],["SmartPath 0 -1",""],["SmartPath 0 cancel",""],["敵に見つかっている場合の戦闘",""],["勝利したとき",""],["PSS t_stop",""],["逃げたとき",""],["戦闘から離脱したときの処理",""],["PSS t_start",""],["敵がプレイヤーを見失ったときの処理",""],["敵02",""],["敵03",""],["敵04",""],["敵05",""],["宝箱（防具正面開き）",""],["<TE:4>",""],["本",""],["MWL_行数変更 16",""],["\\>　　　『国民の王家に対する意識調査・522年版』\n\\>\n\\>『Ｑ．あなたは国王陛下を尊敬していますか？\n\\>\n\\>　　１.尊敬している　　　９．３％\n\\>　　２.尊敬していない　７６．６％\n\\>　　３.わからない　　　１４．１％\n\\>\n\\>\n\\>　Ｑ．あなたは\\N[5]殿下を尊敬していますか？\n\\>\n\\>　　１.尊敬している　　９５．７％\n\\>　　２.尊敬していない　　１．１％\n\\>　　３.わからない　　　　３．２％　　　　　　』",""],["MWL_行数リセット",""],["\\>　　　　　　　　『建国王記・初版』\n\\>\n\\>『……かくして竜の寝床へアルテトを追い詰めたリジェルダ\n\\>　は、仲間たちとともに最後の戦いへ挑んだ。\n\\>　\n\\>　あらゆる魔術の使い手であり、どんな獣より鋭い牙と爪を\n\\>　持ち、ミスリルに迫る硬さの鱗に守られた悪竜。\n\\>　その討伐は困難を極め、戦いは丸一昼夜のあいだ続いた\n\\>　という。\n\\>\n\\>　そして長き死闘はリジェルダたちの勝利に終わり、悪竜は\n\\>　彼らの足下に瀕死の巨体を横たえた。\n\\>　街を、畑を、人を、ことごとく焼き払った憎き敵は、あと\n\\>　一度剣を突き立てるだけで絶命するはずであった。\n\\>\n\\>　ところがここでリジェルダはためらう様子を見せ……』",""],["チェリア姫（ED2Ev）",""],["\n　　　\\N[6]の討伐に成功してから一ヶ月後――。",""],["「チェリア女王陛下、ご即位おめでとうございます！！」\\nw[参列者]",""],["「我ら一同、これより粉骨砕身して陛下にお仕えする\n　所存にございます」\\nw[参列者]",""],["「あ、ありがとうございます、皆さん。\\nw[チェリア女王]",""],["「本来であれば王弟であった父パルフューク大公が王位を\n　継ぐべきなのでしょうが、残念ながらあの悪竜によって\n　父は……。\\nw[チェリア女王]",""],["「未熟なわたくしの統治では国民も不安に思うでしょう。\n　ですから皆さん、どうかお力添えをお願いします」\\nw[チェリア女王]",""],["\\{「ハッ！　女王陛下の御為に！」\\}\\nw[参列者たち]",""],["王国を揺るがした悪竜\\N[6]が討伐された後、新王として\n即位したのはパルフューク大公の娘・チェリアだった。",""],["前王の独断的な采配に反感を募らせていた貴族や臣下が\n政治色の無い新王を求めた結果であったという。",""],["そして女王チェリアによる新体制のもと、王国は抱えていた\n政治や経済の問題解決に乗り出していった。",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["モブ貴族1",""],["モブ貴族2",""],["EV033",""],["EV034",""],["EV035",""],["モブ貴族3",""],["モブ貴族4",""],["モブ貴族5",""],["モブ貴族6",""],["モブ貴族7",""],["モブ貴族8",""],["モブ官僚1",""],["モブ官僚2",""],["モブ官僚3",""],["モブ官僚4",""],["モブ官僚5",""],["モブ官僚6",""],["モブ官僚7",""],["モブ官僚8",""],["モブ執事1",""],["モブ執事2",""],["モブ執事3",""],["モブ執事4",""],["モブ執事5",""],["モブ執事6",""],["モブ執事7",""],["モブ執事8",""],["モブ宮女1",""],["モブ宮女2",""],["モブ宮女3",""],["モブ宮女4",""],["モブ宮女5",""],["モ