["Map037/events/29/note"],["Map037/events/30/name"],["Map037/events/30/note"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],null,["gold"],["gold"],["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,["gold"]],"parameters":[],"indexIds":{"EV001":0,"EV002":1,"道具箱":2,"火":3,"光":4,"EV006":5,"チェック":6,"睡眠処理":7,"ユマH2(正常位)":8,"<TE:38>":9,"説明書":10,"説明書矢印":11,"ユマH1(尿道)":12,"<TE:37>":13,"ポスター5":14,"<TE:92>":15,"ユマH3(ディルドー)":16,"<TE:39>":17,"ユマH4(後背位)":18,"<TE:40>":19,"ユマH5(アナル)":20,"<TE:41>":21,"ユマH6(正常位2)":22,"<TE:42>":23,"ユマH7(クスコ)":24,"<TE:43>":25,"ユマH8(口奉仕)":26,"<TE:44>":27,"ユマH9(マイクロビキニ)":28,"<TE:45>":29,"ポスター4":30,"<TE:91>":31,"ポスター6":32,"<TE:93>":33,"ポスター1":34,"<TE:88>":35,"ポスター3":36,"<TE:90>":37,"ポスター2":38,"<TE:89>":39,"クリア後最終決戦やり直し":40,"<TE:100>":41},"extension":"json","dataType":"map","filename":"Map037","basename":"Map037.json","path":"data/Map037.json","relPath":"data/Map037.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":42,"percent":0},"cellInfo":[]},"data/Map038.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["娼婦",""],["「あんっ！　だめよ、こんなところで……\\I[29]\n　ちゃんとお部屋に行きましょ？」\\nw[娼婦]",""],["客",""],["燭台",""],["光",""],["娼館従業員",""],["娼館の客（依頼22~25)",""],["依頼を出している場合",""],["依頼フキダシ",""],["娼館支配人（依頼20）",""],["奴隷市（フキダシ）",""],["個別依頼29",""],["道具遊びＡ",""],["「道具を使いたがる客ってけっこういるんだけど、乱暴に\n　扱う人も多いんで、ちょっと怖いのよね。\\nw[娼婦]",""],["「だからウチの店じゃ今度から、道具プレイ専門の\n　奴隷娼婦を置くことにしたの」\\nw[娼婦]",""],["「奴隷なら少しくらい乱暴にされても構わないってか？\n　ハハッ、そいつはひどいな」」\\nw[\\N[1]]",""],["「それはお互い様でしょ、奴隷商人さん。\n　そういうわけで、適当な奴隷を用意してくれる？」\\nw[娼婦]",""],["「適当と言っても……どんな奴隷でもいいんですか？」\\nw[\\N[2]]",""],["「奇をてらっても仕方ないから、男が一番好みそうな\n　\\C[17]普通の人間の女の子\\C[0]がいいわね。\n　できれば\\C[17]胸は大きめ\\C[0]で。\\nw[娼婦]",""],["「予算は\\C[17]５０００Ｇ\\C[0]までしか出せないけど、代わりに\n　ウチで使ってた\\C[17]\\in[54]\\C[0]も一緒にあげるわ」\\nw[娼婦]",""],["個別依頼『道具遊びＡ』を受けますか？",""],["受ける",""],["受けない",""],["風の塔・2階",""],["大山脈西洞窟",""],["個別依頼\\C[17]『道具遊びＡ』\\C[0]を受けた！",""],["\\C[17]『\\in[103]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「人間の女奴隷だ、これで構わないな？」\\nw[\\N[1]]",""],["「ええ、申し分ないわ。\n　これから道具プレイに偏重したお客様の相手は、\n　この娘に担当してもらうわね」\\nw[娼婦]",""],["個別依頼\\C[17]『道具遊びＡ』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「身代わりの奴隷、お願いね。\n　ハードな道具プレイはみんなその娘に任せるから」\\nw[娼婦]",""],["男",""],["\n\\>　　　　　　　　～　娼館の一室にて　～",""],["「へぇ、キミ新人さんか。\n　なかなか可愛いじゃないか、うへへ」\\nw[男性客]",""],["「あ、ありがとうございまーす\\I[29]\\nw[奴隷娼婦]",""],["「今回が初めてのお仕事なんで、粗相があるかもしれま\n　せんけど、がんばりますんでお願いしまーす\\I[29]」\\nw[奴隷娼婦]",""],["「ハイハイ、よろしくー！\\nw[男性客]",""],["「それにしても、オレのところに新人娼婦が回されてくる\n　なんて珍しいな」\\nw[男性客]",""],["「そうなんですかぁ？」\\nw[奴隷娼婦]",""],["「オレは\\C[17]道具を使った責めのプレイ\\C[0]ばかりだから、経験の\n　少ない子はあてがえないって店側から言われてるんだ」\\nw[男性客]",""],["「えっ……？！\n　そ、そんなのわたし聞いてないんですけど！？」\\nw[奴隷娼婦]",""],["「だーいじょうぶ！　ビビる必要なんかないって。\n　あくまでただのお遊びだからさ」\\nw[男性客]",""],["「そ、そうですか……？」\\nw[奴隷娼婦]",""],["「ははっ、気楽に気楽に！\n　さ、ベッドに行こう！」\\nw[男性客]",""],["「うぅ……ずっとおまんこ開きっぱなしでお股が痛いよぉ。\n　娼婦って、こんなことまでしなきゃならないのぉ……？」\\nw[奴隷娼婦]",""],["「いやぁ、楽しかったよ！\n　次もキミを指名するから、今度は拘束二穴ディルドー責め\n　をやろうね！」\\nw[男性客]",""],["「いやああぁーーッ！！」\\nw[奴隷娼婦]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『道具遊びＡ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[54]\\C[0]入手した！",""],["\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！",""],["「このお客さん、さっきから寒い親父ギャグばっかり\n　とばしてくるの。\n　商売だから我慢してるけど……イライラするわ」\\nw[娼婦]",""],["「ただ抱くのではなく、こうして機知に富んだ会話も\n　楽しむのが、本当の女遊びってものさ」\\nw[客]",""],["「あいたたた……。\n　あの客、ダメだって言ってるのに、お尻に指突っ込んで\n　きやがってぇ……」\\nw[娼婦]",""],["「弟や妹を養うために、イヤイヤこの仕事を始めたけど、\n　思った以上に性に合ってたみたい」\\nw[娼婦]",""],["「へぇ、お店に娼婦を供給する奴隷商人なの？\n　業の深いお仕事ね」\\nw[娼婦]",""],["掲示板マーク",""],["EV029",""],["薄衣購入フキダシ",""],["窃盗用下着4",""],["<TE:119>",""],["EV032",""],["ドア",""],["部屋の中でお楽しみ中のようだ。",""],["EV036",""],["EV037",""]],"context":[["Map038/events/1/name"],["Map038/events/2/name"],["Map038/events/3/name"],["Map038/events