/30/name"],["Map135/events/30/note"],["Map135/events/31/name"],["Map135/events/32/name"],["Map135/events/32/pages/0/list/1/message/noPicture/bottom"],["Map135/events/32/pages/0/list/7/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,null,null,["gold"],["gold"],["red"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,["gold"],["gold"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["gold"],["gold"],null,["gold"],null,null,["gold"],null,null,null,["gold"],null,null,null,["gold"],null,null,null,["gold"],["blue"],null,["blue"],null,["gold"],null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":32,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":2,"headerParam":["所持金不足"]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":10,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":54,"headerParam":["",0,0,2]}],[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":60,"headerParam":["",0,0,2]}],[{"headerIndex":63,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":73,"headerParam":["",0,0,2]}],[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":48,"headerParam":["",0,0,2]}],[{"headerIndex":64,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":73,"headerParam":["",0,0,2]}],[{"headerIndex":76,"headerParam":["",0,0,2]}],[{"headerIndex":78,"headerParam":["",0,0,2]}],[{"headerIndex":84,"headerParam":["",0,0,2]}],[{"headerIndex":91,"headerParam":["",0,0,2]}],[{"headerIndex":98,"headerParam":["",0,0,2]}],[{"headerIndex":104,"headerParam":["",0,0,2]}],[{"headerIndex":108,"headerParam":["",0,0,2]}],[{"headerIndex":111,"headerParam":["",0,0,2]}],[{"headerIndex":114,"headerParam":["",0,0,2]}],[{"headerIndex":117,"headerParam":["",0,0,2]}],[{"headerIndex":122,"headerParam":["",0,0,2]}],[{"headerIndex":125,"headerParam":["",0,0,2]}],[{"headerIndex":130,"headerParam":["",0,0,2]}],[{"headerIndex":134,"headerParam":["",0,0,2]}],[{"headerIndex":139,"headerParam":["",0,0,2]}],[{"headerIndex":143,"headerParam":["",0,0,2]}],[{"headerIndex":151,"headerParam":["",0,0,2]}],[{"headerIndex":160,"headerParam":["",0,0,2]}],[{"headerIndex":167,"headerParam":["",0,0,2]}],[{"headerIndex":171,"headerParam":["",0,0,2]}],[{"headerIndex":174,"headerParam":["",0,0,2]}],[{"headerIndex":177,"headerParam":["",0,0,2]}],[{"headerIndex":180,"headerParam":["",0,0,2]}],[{"headerIndex":196,"headerParam":["",0,0,2]}],[{"headerIndex":221,"headerParam":["",0,0,2]}],[{"headerIndex":230,"headerParam":["",0,0,2]}],[{"headerIndex":252,"headerParam":["",0,0,1]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],null,[{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],null,[{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"司祭":3,"EV005":4,"EV006":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「神のご加護があれば、悪竜など恐るるに足りません」\\nw[尼僧]":11,"「大司教様は背教の疑いで拘束されてしまいました……。\n　ああ、なんてこと……\\}いい気味だわ！　あのエロおやじ！」\\nw[尼僧]":12,"「総本山の大聖堂ほどではありませんが、この王都聖堂も\n　なかなかのものでしょう？」\\nw[尼僧]":13,"依頼フキダシ":14,"僧侶":15,"所持金不足":16,"\\C[17]１０万Ｇ\\C[0]を寄付するのに、所持金が足りない。":17,"「しまった！　つい他のことに使っちまって……。\n　急いで１０万Ｇまで金を貯めないと」\\nw[\\N[1]]":18,"「うへへへっ、ちょっといいっすかねぇ？」\\nw[\\N[1]]":19,"「はい、なんでしょうか？」\\nw[僧侶]":20,"「あっしは\\N[1]っていう、しがない奴隷商人\n　なんですがね、ぜひ大司教様に商売の成功を\n　祈っていただきたいんでさぁ」\\nw[\\N[1]]":21,"（ゲスな演技が、すごい板についてる……）\\nw[\\N[2]]":22,"「この通り、聖堂への寄付金も持ってきてるんで」\\nw[\\N[1]]":23,"「それはそれは、ご丁寧に……」\\nw[僧侶]":24,"（まぁーた、大司教様に取り入ろうって輩か。\n　こういう怪しいヤツばかり、よく来るよなぁ）\\nw[僧侶]":25,"「寄付金はありがたいのですが、大司教様は多忙なため、\n　直接お会いになるのは無理でして――」\\nw[僧侶]":26,"「１０万Ｇ用意してきたんですがねぇ、\n　会えないなら仕方ねぇや。\n　今日は帰らせてもらいましょうかね」\\nw[\\N[1]]":27,"「じっ、じうまん！？\n　えっと、ちょっと待って――お待ちください！\\nw[僧侶]":28,"「ただいま大司教様のご予定を確認してきますので！」\\nw[僧侶]":29,"「奴隷二人の連れ込みは、聖堂の裏口からお願いします。\n　正面からだと目立つので」\\nw[僧侶]":30,"トークマーク":31,"大司教（寄付Ev）":32,"「わははっ、お待たせしましたね。\n　なんでも１０万Ｇもの寄付をしてくれるとか？」\\nw[大司教]":33,"「ええ！\n　あっしは信心深い男でして、ぜひに大司教様の\n　お祈りを受けたいと思いましてね。\\nw[\\N[1]]":34,"「特に商売繁盛！\n　そう、商売繁盛のお祈りをね！」\\nw[\\N[1]]":35,"「そうですか、そうですか。\n　１０万Ｇの寄付とは良い心がけですね。\\nw[大司教]":36,"「神々もきっと、あなたの誠心を祝福されるでしょう！\\nw[大司教]":37,"「私もあなたの商売の成功を口利き――ではなくて、祈りで\n　応援するとしましょう」\\nw[大司教]":38,"「うぇへへへっ！\n　ありがとうごぜぇます！」\\nw[\\N[1]]":39,"\\C[17]１０万Ｇ\\C[0]を王都聖堂に寄付した！":40,"（こんなところで、癒着が生まれる瞬間を見るなんて……。\n　\\N[3]もこういうこと、やってるのかなぁ……？）\\nw[\\N[2]]":41,"「それと大司教様に、ひとつお願いしたいことが」\\nw[\\N[1]]":42,"「なんですか？」\\nw[大司教]":43,"「実はあっしの扱ってる奴隷の中に、信仰心の篤い女が\n　いましてね。\\nw[\\N[1]]":44,"「その女奴隷にひとつ、ありがたい説教をしてやっちゃ\n　もらえませんか？\\nw[\\N[1]]":45,"「そんで、もしよければ、そのまま王都聖堂の飼い犬――\n　もとい、使用人にしていただければと」\\nw[\\N[1]]":46,"「ほっほぅ！　それは素晴らしい心がけだ！\n　いいでしょう、連れてきなさい！\\nw[大司教]":47,"「誠意をこめて、セック……じゃなくて説教して\n　あげましょう！」\\nw[大司教]":48,"「ありがとうごぜぇます！」\\nw[\\N[1]]":49,"「ところで、そっちの猫人の娘も奴隷かね？」\\nw[大司教]":50,"「え？　ええ……まあ……」\\nw[\\N[1]]":51,"「なら、その娘も一緒に私のところへ来させなさい。\n　二人まとめて、せっｋ……きょうしてあげましょう」\\nw[大司教]":52,"「えっ…………わ、わたしも？」\\nw[\\N[2]]":53,"「えっ…………\\{はぁっ！？\\}」\\nw[\\N[2]]":54,"「い……いやいや、大司教様、この娘は礼儀知らずの\n　山猫で、とてもおそばに上げるわけには――」\\nw[\\N[1]]":55,"「かまいませんとも。\n　そういう娘をしつけるのも、聖職者の務めです」\\nw[大司教]":56,"「そうそう、奴隷二人を連れてくるときは、\\C[17]聖堂の裏口\\C[0]\n　から入るように。\\nw[大司教]":57,"「信徒に見られるとマズいのでね。\n　なにがとは言わんけど。\\nw[大司教]":58,"「では、楽しみに待っていますよ」\\nw[大司教]":59,"「ちょっ……大司教さまっ！？」\\nw[\\N[1]]":60,"「これってもしかして、わたしもあの脂ぎった大司教に\n　エッチなことされちゃうんですかぁ\\I[29]」\\nw[\\N[2]]":61,"「ええぇぇっ！？\n　ちょっと、これどうするんですかぁ！？」\\nw[\\N[2]]":62,"\n\\>　　　※　一度、\\C[17]スパイ尼僧\\C[0]のところへ戻ろう　※":63,"ユマ":64,"裏口":65,"鍵がかかっていて開かない。":66,"通行禁止":67,"奴隷を連れていく先は聖堂の２階だ。":68,"目立つ正面入り口の方へ出るわけにはいかない。":69,"僧侶（警告）":70,"「大司教様が欲得にまみれた俗物なのは、薄々わかって\n　いました。\n　しかし背教者として弾劾されるほどとは……」\\nw[僧侶]":71,"「写本作りは忍耐心との勝負ですよ」\\nw[僧侶]":72,"「二階は大司教様の私室ですので、上がらないで\n　ください」\\nw[僧侶]":73,"商人":74,"「大司教の失脚に加えて悪竜だと！？\n　ああもうっ、オレの商売が滅茶苦茶だ……！」\\nw[怪しい商人]":75,"「大司教が失脚しやがった！　くそっ、役立たずめ！！\n　なんのためにせっせと賄賂を贈ってきたと思ってんだ！」\\nw[怪しい商人]":76,"「この大聖堂へはかなりの額を寄付したよ。\n　尽くす者に、神は大きなリターンをくださるからねぇ」\\nw[怪しい商人]":77,"尼僧":78,"「\\N[6]が甦ったという話が本当だとしても、\n　神が必ずや我々を守ってくださいます」\\nw[尼僧]":79,"「大司教様が背教の疑いで拘束されたとか……。\n　まったく嘆かわしいことです」\\nw[尼僧]":80,"「ここは遠方から来られた信者のための宿泊室です。\n　あなた方には……必要ないようですね」\\nw[尼僧]":81,"本":82,"MWL_行数変更 16":83,"\\>　　　　　『死霊・死体モンスター概論』\n\\>\n\\>『……次に耐性についてだが、これら死霊・死体系の\n\\>　モンスターには毒と睡眠がまったく効かない。\n\\>　\n\\>　死んでいるから毒が回らないし、睡眠をとることも\n\\>　ないのだろうが、では混乱や魅了が有効なのはなぜ\n\\>　なのか？\n\n\\>　これに関しては様々な説がある。\n\\>　いまだに魂の一部が残っているため、感情の働きが\n\\>　あって魅了されるのだと主張する者もいるし……』":84,"MWL_行数リセット":85,"\\>　　　　　　『暴れん坊司教　第四巻』\n\\>\n\\>『「この顔を見忘れたか！」\n\\>　\n\\>　そう一喝された問屋の旦那は、男の顔をまじまじと\n\\>　見直し、そして突如として顔色を変えた。\n\\>　\n\\>　「おっ、お前はあのときの遊び人に尻を貸していた\n\\>　　男娼！？」\n\\>　「ようやく思い出したか。貴様の悪事、しかとこの\n\\>　　目で確かめていたぞ！」\n\\>　　\n\\>　これには居並ぶ悪党ども驚き、皆の視線が司教の尻\n\\>　に集中したのだった』":86,"武器商ギルド秘密文書（縦）":87,"<TE:74>":88,"出口マーク":89,"女":90,"「物乞いにお金をあげるなんて無駄だって言う人もいる\n　けど、わたしは巡り巡って自分にも良い事が返ってくる\n　と思うの」\\nw[女性客]":91,"「噂じゃ最近、物乞いの人に大金を配る義賊が出没してる\n　らしいわ」\\nw[女性客]":92},"extension":"json","dataType":"map","filename":"Map135","basename":"Map135.json","path":"data/Map135.json","relPath":"data/Map135.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":93,"percent":0},"cellInfo":[]},"data/Map136.json":{"data":[["EV001",""],["EV002",""],["大司教(報告Ev)",""],["「だっ、大司教様！\n　おくつろぎのところ、申し訳ありません！」\\nw[僧侶]",""],["「どうした？」\\nw[大司教]",""],["「ただいま大司教様にお目通り願いたいという、\n　奴隷商人が来ておりまして――」\\nw[僧侶]",""],["「それがなんだというのだ？\n　いつものように、適当に追い返しておけ」\\nw[大司教]",""],["「はっ！\n　し、しかしその奴隷商人、１０万Ｇもの寄付金を\n　持参してきておりまして」\\nw[僧侶]",""],["「ほう、１０万Ｇだと？\\nw[大司教]",""],["「どうやらワシに会うにはどうしたらいいか、わきまえて\n　おる商人のようだな」\\nw[大司教]",""],["見張り1",""],["見張り2",""],["「ここは大司教様の私室だ」\\nw[見張り僧侶]",""],["大司教(エッチEv)",""],["「さあて、それでは二人まとめて――」\\nw[大司教]",""],["「お待ちになって、大司教様。\n　二人一緒だなんて雑な抱き方は、もったないですわ。\\nw[スパイ尼僧]",""],["「まずはわたしのご奉仕を、ぜひお受けいただけません？」\\nw[スパイ尼僧]",""],["「はははっ、ワシを独り占めしたいのか！？\n　この卑しいメス奴隷め！\\nw[大司教]",""],["「いいだろう、まずはお前からだ！」\\nw[大司教]",""],["「はいっ、楽しみですわぁ」\\nw[スパイ尼僧]",""],["\\}「\\N[2]さん、私が大司教の気を引いている隙に、『覚え書き』を探してください。\\{\\nw[スパイ尼僧]",""],["\\}「この部屋のどこかに、絶対にあるはずですから」\\{\\nw[スパイ尼僧]",""],["\\}「わ、わかりました……！」\\{\\nw[\\N[2]]",""],["「ではベッドへ上がる前に、裸になってこの頭巾を\n　かぶるのだ」\\nw[大司教]",""],["「これは……尼僧の頭巾では？」\\nw[スパイ尼僧]",""],["「そうだ。\n　尼僧を犯すことに興奮するというのに、最近は\n　色々あって手を出しにくくなってしまってな――。\\nw[大司教]",""],["「だからお前が尼僧となるのだ！」\\nw[大司教]",""],["（あの人、スパイだけど本職の尼僧でもあるよね？\n　精神的にキツくないかな……心配……）\\nw[\\N[2]]",""],["「わたし、尼僧になって犯されちゃうの？\n　ステキ\\I[29]　興奮しちゃうわ\\I[29]」\\nw[スパイ尼僧]",""],["（プロのスパイって、すごいなぁー……）\\nw[\\N[2]]",""],["「いいぞ、いいぞ！\n　ワシの聖なる肉棒もたぎってきおった！\\nw[大司教]",""],["「ヒィヒィ言わせてやるから、覚悟しろ！」\\nw[大司教]",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↑　　↑　　↑\nここでエッチイベント\n　",""],["「ふぅ～、満足させてもらったぞ。\n　さて次は、あの猫人の娘を――」\\nw[大司教]",""],["「まっ、待って大司教様！\n　こんなんじゃ足りないわ\\I[29]　もっとちょうだぁい\\I[29]」\\nw[スパイ尼僧]",""],["「あれだけ責めてやったのに、まだ足りないだと？\n　このド淫乱め！\\nw[大司教]",""],["「いいだろう！　イキ狂って気絶するまで犯してやる！」\\nw[大司教]",""],["「わぁ、またやっちゃうんだ\\I[29]\n　スパイさんのアソコ、あんなにグチョグチョで種まみれ\n　なのに……\\I[29]」\\nw[\\N[2]]",""],["「うわっ、まだやるの……？\n　スパイさんのアソコ、あんなにグチョグチョで種まみれ\n　なのに……」\\nw[\\N[2]]",""],["（\\N[2]さん、なにを見入っているんですか！？\n　早く、今のうちに捜索を……！）\\nw[スパイ尼僧]",""],["「んああぁああぁぁっ\\I[29]\n　大司教様のおちんぽぉ、きもちいいぃぃっ\\I[29]\\nw[スパイ尼僧]",""],["「もっと奥までぇ\\I[29]\n　わたしの感じるところ、おちんぽで\\C[17]探し当ててぇ\\C[0]\\I[29]」\\nw[スパイ尼僧]",""],["（ハッ！　そうだ！\n　ボーっとしてる場合じゃない！）\\nw[\\N[2]]",""],["（大司教がスパイさんに夢中になってるあいだに、\n　\\C[17]『覚え書き』\\C[0]を探さないと！）\\nw[\\N[2]]",""],["usefultimer timer width set 200",""],["usefultimer timer height set 120",""],["usefultimer timer fontsize set 60",""],["usefultimer timer x set 616",""],["usefultimer timer y set 0",""],["usefultimer timer start 20*60",""],["usefultimer timer pause",""],["\\>\\C[17]　※　２０秒以内に、部屋の中から『覚え書き』を　※\n\\>　※　見つけ出せ！　　　　　　　　　　　　　　　※\\C[0]\n\\> （見つけられなかったとき\\N[2]のエッチイベントあり）\\<",""],["\n\\>　　　　　 （決定ボタンを押してスタート）\\<",""],["usefultimer timer resume",""],["覚え書き捜索失敗のとき",""],["「おいっ！　なにをコソコソやってる！？」\\nw[大司教]",""],["「うぇっ？！\n　べ、別になにも探してませんよー？」\\nw[\\N[2]]",""],["「怪しい！　怪しすぎる！\n　まさかキサマ、大聖堂本部の回し者か！？」\\nw[大司教]",""],["「ちちち、違いますよっ！？\n　なんのことだかさっぱり！」\\nw[\\N[2]]",""],["「おいっ！」\\nw[大司教]",""],["「どうなさいました、大司教様？」\\nw[見張り僧侶Ａ]",""],["「この娘、不審すぎる！　スパイかもしれん！\n　ワシが直々に取り調べてやるから、服を剥ぎ取れ！」\\nw[大司教]",""],["「取り調べですか！　喜んでお手伝いいたします！」\\nw[見張り僧侶Ａ]",""],["「さあ、大司教様の前でその汚い服を脱ぐんだ！」\\nw[見張り僧侶Ｂ]",""],["「こ、こういうのはキライじゃないですけど、\n　いまはちょっとマズいというか……」\\nw[\\N[2]]",""],["「ま、待ってください！　いやあぁっ！？」\\nw[\\N[2]]",""],["（ごめんなさい、\\N[2]さん。\n　いまあなたを庇ったら私まで拘束されてしまうから、\n　見ているしかないの……）\\nw[スパイ尼僧]",""],["覚え書き発見したとき",""],["「やった！　見つけた！\n　あとはこれを持って外に出るだけ――。\\nw[\\N[2]]",""],["「でも、入り口には見張りがいるし、どうやって\n　逃げたらいいんだろ……？」\\nw[\\N[2]]",""],["「きゃああああぁあぁっ！？」\\nw[スパイ尼僧]",""],["「ど、どうした！？\n　いきなり悲鳴をあげて」\\nw[大司教]",""],["「いまっ……ま、窓の向こうから誰かがこっちを\n　覗いて……」\\nw[スパイ尼僧]",""],["「なんだとッ！？\n　さては大聖堂本部のスパイか！？」\\nw[大司教]",""],["「おいっ！　お前たち！\n　曲者が出たぞ！　聖堂の外を探してこい！」\\nw[大司教]",""],["「ハッ！　ただちに！」\\nw[見張り僧侶]",""],["「おのれ、しつこく嗅ぎ回りおって！\n　しかし絶対に証拠はつかませんぞ！」\\nw[大司教]",""],["\\}「\\N[2]さん、いまのうちに外へ！」\\{\\nw[スパイ尼僧]",""],["「あっ……\\}はいっ、わかりました！\\{」\\nw[\\N[2]]",""],["\n\\>　　　　　\\C[17]※　急いで聖堂の外へ逃げよう　※\\C[0]",""],["僧侶（言伝て）",""],["受け渡しEv",""],["「そこで止まりなさい」\\nw[見張り僧侶]",""],["「おお、来たか来たか。\n　ぐふふふ……二人とも部屋に入るがいい」\\nw[大司教]",""],["「どちらも上玉だな。\n　ちょうどこれまで使ってた女に、飽きてきたところだ。\\nw[大司教]",""],["「じっくり、たっぷりと、可愛がってやるからな」\\nw[大司教]",""],["「奴隷商人、お前はなかなか気の利くヤツだな。\n　今度、大きな仕事を回してやるから楽しみにしていろ。\\nw[大司教]",""],["「ではもう帰っていいぞ」\\nw[大司教]",""],["「ぐふふふっ……！」\\nw[大司教]",""],["ユマ",""],["スパイ尼僧",""],["注意",""],["\\C[17]※注意※\\C[0]\nここから先、しばらく『メニュー』が使えなくなります。\n必要であれば今のうちにセーブを行ってください。",""],["スパイ尼僧2",""],["覚え書き捜索タイマー",""],["usefultimer timer textcolor set #ff0000",""],["\n　　　　　　　\\C[10]※　タイムオーバー！　※\\C[0]",""],["usefultimer timer textcolor reset",""],["usefultimer timer stop",""],["覚え書き発見",""],["\n　　　\\C[17]※　『大司教の覚え書き』を見つけた！！　※\\C[0]",""],["覚え書き捜索先",""],["ここに『覚え書き』は無さそうだ。",""],["部屋脱出禁止",""],["「この部屋を出てはダメだ！」\\nw[見張り僧侶]",""],["奴隷引き渡し誘導",""],["大司教に見つからないよう、逃げなければ。",""]],"context":[["Map136/events/1/name"],["Map136/events/2/name"],["Map136/events/3/name"],["Map136/events/3/pages/0/list/20/message/noPicture/bottom"],["Map136/events/3/pages/0/list/26/message/noPicture/bottom"],["Map136/events/3/pages/0/list/28/message/noPicture/bottom"],["Map136/events/3/pages/0/list/32/message/noPicture/bottom"],["Map136/events/3/pages/0/list/36/message/noPicture/bottom"],["Map136/events/3/pages/0/list/41/message/noPicture/bottom"],["Map136/events/3/pages/0/list/43/message/noPicture/bottom"],["Map136/events/4/name"],["Map136/events/5/name"],["Map136/events/5/pages/1/list/0/message/noPicture/bottom"],["Map136/events/6/name"],["Map136/events/6/pages/1/list/12/message/noPicture/bottom"],["Map136/events/6/pages/1/list/20/message/noPicture/bottom"],["Map136/events/6/pages/1/list/24/message/noPicture/bottom"],["Map136/events/6/pages/1/list/27/message/noPicture/bottom"],["Map136/events/6/pages/1/list/30/message/noPicture/bottom"],["Map136/events/6/pages/1/list/33/message/noPicture/bottom"],["Map136/events/6/pages/1/list/37/message/noPicture/bottom"],["Map136/events/6/pages/1/list/39/message/noPicture/bottom"],["Map136/events/6/pages/1/li