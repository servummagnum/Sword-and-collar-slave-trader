04":29,"氷柱1":30,"押せば氷柱を倒せそうだ。":31,"押す":32,"押さない":33,"バルコルド":34,"遭遇Ev":35,"PSS stop":36,"「そこよっ、\\N[4]！\n　いけっ！　やれっ！　ブッ倒せぇッ！！」\\nw[\\N[3]]":37,"「ハァッ！　ヤァッ！　トウッ！！」\\nw[\\N[4]]":38,"「竜の鉤爪はすぐそこよ！\n　がんばれーッ！！」\\nw[\\N[3]]":39,"「メスガキと執事！\n　やっぱり来てやがったか！」\\nw[\\N[1]]":40,"「な、なんかスゴく強そうなモンスターと戦ってますけど、\n　あれ大丈夫なんでしょうか？」\\nw[\\N[2]]":41,"「あいつらのことは放っておけばいい。\n　それよりこの隙に、俺たちは別の道から先回りするぞ」\\nw[\\N[1]]":42,"「わ、わかりました！\n　\\N[3]たちより早く、鉤爪を手に入れましょう！」\\nw[\\N[2]]":43,"\\N[3]たちに気づかれないよう進まなければ。":44,"モンスター":45,"エルラ":46,"EV022":47,"氷柱2":48,"EV024":49,"EV025":50,"倒れ氷柱1":51,"倒れ氷柱2":52,"攻撃エフェクト1":53,"攻撃エフェクト2":54,"モンスター進入禁止1":55,"モンスター進入禁止2":56,"氷柱矢印表示":57,"矢印":58},"extension":"json","dataType":"map","filename":"Map303","basename":"Map303.json","path":"data/Map303.json","relPath":"data/Map303.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":59,"percent":0},"cellInfo":[]},"data/Map304.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["扉の外に雪が積もっていて開かない。",""],["EV008",""],["EV009",""],["脱出用魔法陣",""],["脱出する前に、竜の鉤爪を手に入れなければ。",""],["ダンジョンの外へ脱出しますか？",""],["脱出する",""],["脱出しない",""],["createFilter 1 twist 2",""],["setFilter 1 408 312 416 0",""],["moveFilter 1 408 312 816 13 120",""],["eraseFilter 1",""],["EXIT",""],["ボス（オーガ）",""],["回復魔法陣",""],["ボス戦Ev",""],["「うわあぁっ！？\n　あっ、あれなんですかっ！？」\\nw[\\N[2]]",""],["「俺に訊くな。\n　モンスターには違いないだろうが、見るからに普通じゃ\n　ないな。\\nw[\\N[1]]",""],["「まさか、竜の鉤爪を守ってるのか？」\\nw[\\N[1]]",""],["「あ、あれを倒さなきゃならないんですか！？\n　無理だと思うんですけどー？！」\\nw[\\N[2]]",""],["「俺もちょっと自信ないが、ここまで来て引き返す\n　わけにもいかないだろ？」\\nw[\\N[1]]",""],["「いつメスガキと執事が来るか分からないんだ。\n　腹をくくって戦うぞ！」\\nw[\\N[1]]",""],["「ひーん！\n　どうか見かけ倒しでありますようにぃー！」\\nw[\\N[2]]",""],["shatter_event_id : 12 : 1 : 1 : 1",""],["「な……なんとか倒せた……」\\nw[\\N[2]]",""],["「意外と、やれば出来るもんだな」\\nw[\\N[1]]",""],["「でもあのモンスター、なんだったんでしょうね？\n　ここにいたのは、たまたまでしょうか？」\\nw[\\N[2]]",""],["「いや、もしかしたら竜の鉤爪に惹き寄せられて\n　ここに巣食っていたのかもしれん。\\nw[\\N[1]]",""],["「強い魔力や呪力を持つ品は、モンスターや幽霊なんかを\n　呼び寄せやすいって言うしな」\\nw[\\N[1]]",""],["「じゃあ、竜の鉤爪もそういう特別な力を持っていると？」\\nw[\\N[2]]",""],["「そうであっても、おかしくはないだろ。\n　なにせ建国王由来のアイテムだからな。\\nw[\\N[1]]",""],["「なるほど、言われてみれば……」\\nw[\\N[2]]",""],["「それじゃあ、メスガキが来る前にお宝をいただくぞ！」\\nw[\\N[1]]",""],["「どうか、ちゃんと竜の鉤爪がありますように……」\\nw[\\N[2]]",""],["竜の鉤爪を手に入れなければ。",""],["宝箱（竜の鉤爪）",""],["\\C[17]『竜の鉤爪』\\C[0]を手に入れた！",""],["初めての鉤爪ダンジョン",""],["「これが竜の鉤爪ですか。\n　なんというか……骨董品？」\\nw[\\N[2]]",""],["「確かに古道具屋の片隅にでも転がっていそうだな。\\nw[\\N[1]]",""],["「見た目だけで言えば、さほど重要な物とも\n　思えないが……」\\nw[\\N[1]]",""],["古代遺跡のみクリア済み",""],["「これが竜の鉤爪で、間違いないんでしょうか？」\\nw[\\N[2]]",""],["「ああ、砂漠の古代遺跡でメスガキが鉤爪を持ち去るとき\n　チラリと見たが、これと同じ物だった」\\nw[\\N[1]]",""],["「いったいこれに、どういう秘密が……？」\\nw[\\N[2]]",""],["海賊島のみクリア済み",""],["「竜の鉤爪、これで２個目ですね！」\\nw[\\N[2]]",""],["「計画通り、順調に集まってるな。\n　やはり俺の日頃の行いがいいからだろう」\\nw[\\N[1]]",""],["「ど、どうでしょうかねぇ～」\\nw[\\N[2]]",""],["他二つの鉤爪ダンジョンクリア済み",""],["「やったぁ！\n　竜の鉤爪、これで２個目ですね！」\\nw[\\N[2]]",""],["「こちらに２個、メスガキのところに１個か。\n　完璧とはいかなかったが、まあ上出来だろう」\\nw[\\N[1]]",""],["「そうですよ、上出来です！\n　いーっぱい頑張りましたもん！」\\nw[\\N[2]]",""],["「\\{あ～～～～～ッ！！？」\\}\\nw[？？？]",""],["鉤爪ダンジョン初回",""],["「\\N[2]とフード男！？\\nw[\\N[3]]",""],["「な……なんであんたたちが、ここにいるのよ！？」\\nw[\\N[3]]",""],["「気にすんな。\n　ちょっと近くを通りがかっただけだから」\\nw[\\N[1]]",""],["「ふざけんなっ！」\\nw[\\N[3]]",""],["「おそらくこいつらは、私たちに意趣返しするつもりで、\n　鉤爪捜索の邪魔をしに来たのでしょう」\\nw[\\N[4]]",""],["「なんて性根の腐ったヤツラなのかしら！」\\nw[\\N[3]]",""],["「お前が言うか……」\\nw[\\N[1]]",""],["「\\N[3]、あなたたちが海賊とグルになって、ウチの\n　商会を破産に追い込んだことは分かってる！\\nw[\\N[2]]",""],["「わたし、絶対に泣き寝入りなんてしないから！」\\nw[\\N[2]]",""],["「あーあー、泣き虫\\N[2]がイキがっちゃって！\n　あんたがどうあがいた所で、もう勝敗はついてるって\n　いうのに」\\nw[\\N[3]]",""],["「そいつは早計だぜ？\n　俺たちは勝負をひっくり返すために来たんだからな。\\nw[\\N[1]]",""],["「現に竜の鉤爪は、すでに俺たちが手にした。\n　どうだメスガキ、これが無いと困るんじゃないか？」\\nw[\\N[1]]",""],["「くっ……このクソザコの分際でぇッ！」\\nw[\\N[3]]",""],["「やってくれたな、アサシン！\n　コソコソと人の目を盗むのだけは得意なようだ」\\nw[\\N[4]]",""],["「だから誰がアサシンだ！\n　どこからどう見ても商人だろうが！」\\nw[\\N[1]]",""],["「あの、\\N[1]さん……いまはそういう話をしてる\n　場合じゃ……」\\nw[\\N[2]]",""],["鉤爪ダンジョン二ヶ所目・三ヶ所目",""],["「あっ、あんたたち！\\nw[\\N[3]]",""],["「ッ……またかァ！！」\\nw[\\N[3]]",""],["「俺たちに会えて、そんなに嬉しいか？\n　生憎とこっちは全然嬉しくないんだがなぁ」\\nw[\\N[1]]",""],["「あたしだって嬉しくないわよ！\n　ムキイイィィーーッ！！」\\nw[\\N[3]]",""],["「\\N[3]！\n　ここの鉤爪はわたしたちがもらったから！\\nw[\\N[2]]",""],["「何でもあなたの思い通りになると思ったら、\n　間違いだからね！」\\nw[\\N[2]]",""],["「貧乳メス猫の分際でええぇぇっ！！」\\nw[\\N[3]]",""],["「お嬢様、どうかお気を鎮めてください。\n　あいつらのペースに乗せられてはいけません」\\nw[\\N[4]]",""],["「そんなこと分かってるわよ！\n　目的を果たすことが最優先って言うんでしょ！\\nw[\\N[3]]",""],["「あんたたち！　竜の鉤爪を置いていきなさい！\n　でないとタダじゃ置かないわよ！」\\nw[\\N[3]]",""],["「具体的には、私がキサマらを縊り殺すッ！」\\nw[\\N[4]]",""],["「おっと動くなよ？\n　それ以上近づいたら、この鉤爪をブッ壊すぞ？」\\nw[\\N[1]]",""],["「なっ！？」\\nw[\\N[3]]",""],["「俺たちにとっちゃ、どうでもいい代物だから、\n　壊すと言ったら本当に壊すぜ？\\nw[\\N[1]]",""],["「それが嫌ならこの場から失せろ。\n　取り引きも駆け引きも、ムダだと思え」\\nw[\\N[1]]",""],["「くっ……こいつっ……！」\\nw[\\N[3]]",""],["「お嬢様、鉤爪が壊れてしまっては元も子もありません。\n　ここは一旦退くしか――」\\nw[\\N[4]]",""],["「キイイィィーー！！\n　\\N[2]のくせに！　フード野郎のくせにぃ！！\\nw[\\N[3]]",""],["「見てなさいよ！\n　あとで絶対に吠え面かかせてやるんだからァ！！」\\nw[\\N[3]]",""],["「はぁ～……。\n　どうなることかと思いましたよぉ……」\\nw[\\N[2]]",""],["「モンスターに比べりゃチョロイもんだ。\\nw[\\N[1]]",""],["「じゃあ俺たちも帰るとするか」\\nw[\\N[1]]",""],["「わたし、もうクタクタです。\n　早くベッドに入って寝たい～」\\nw[\\N[2]]",""],["メインシナリオ\\C[17]『氷雪は阻む』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["以下、三ヶ所ともクリアした場合のイベント\n↓　　↓　　↓",""],["「結局、竜の鉤爪は３個中の２個を手に入れましたけど、\n　これからどうします……？」\\nw[\\N[2]]",""],["「どうにかして、古代遺跡で見つけた粘土板に書かれている\n　文章を解読したいな。\\nw[\\N[1]]",""],["「内容によっちゃ、メスガキどもを更に追い詰めて\n　やれるかもしれないぞ。\\nw[\\N[1]]",""],["「あと、メスガキどもがこれからどう動くかも気になるな」\\nw[\\N[1]]",""],["「じゃあ一度、王都の貧民街にいる父のところへ\n　行きませんか？\\nw[\\N[2]]",""],["「なにか新しい情報が入っているかもしれませんし」\\nw[\\N[2]]",""],["「そうだな、王都へ向かうか」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『粘土板解読』\\C[0]を受けた！",""],["\\>　　　※　\\C[17]王都貧民街の酒場\\C[0]にいる、\\N[2]の父親の　※\n\\>　　　※　ところへ行こう。　　　　　　　　　　　※\\<",""],["ユマ",""],["エルラ",""],["バルコルド",""],["敵索敵スタート",""],["最奥部１階",""]],"context":[["Map304/events/1/name"],["Map304/events/2/name"],["Map304/events/3/name"],["Map304/events/4/name"],["Map304/events/5/name"],["Map304/events/6/name"],["Map304/events/7/name"],["Map304/events/7/pages/0/list/0/message/noPicture/bottom","Map304/events/8/pages/0/list/0/message/noPicture/bottom","Map304/even