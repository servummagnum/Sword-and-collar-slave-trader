erIndex":98,"headerParam":["引き分け"]},{"headerIndex":40,"headerParam":["引き分け"]}],[{"headerIndex":99,"headerParam":["",0,0,2]},{"headerIndex":41,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["敗北（ユマ凌辱）"]}],[{"headerIndex":108,"headerParam":["",0,0,2]}],[{"headerIndex":137,"headerParam":["",0,0,2]}],[{"headerIndex":140,"headerParam":["",0,0,2]}],[{"headerIndex":144,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["",0,0,2]}],[{"headerIndex":156,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["現金を賭けての勝負（繰り返し）"]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],null,[{"headerIndex":12,"headerParam":["現金がある"]}],[{"headerIndex":15,"headerParam":["現金なし"]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["勝利（賭け金ゲット）"]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["敗北（賭け金没収）"]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["↓金額おまかせの場合は変数を「0」のままに。"]}]],"indexIds":{"火":0,"光":1,"ベッドの男":2,"EV004":3,"EV005":4,"指名手配されているので、外へ出るわけにはいかない。":5,"EV006":6,"燭台":7,"犯罪者1":8,"「実行するときは声をかけな。\n　いまから準備はしておくから――」\\nw[怪しい女]":9,"「いよいよだね。\n　金庫の中にいくら入ってるか楽しみだよ」\\nw[怪しい女]":10,"「火事場泥棒ってのは、趣味じゃないんだけどねぇ」\\nw[怪しい女]":11,"「結局、悪竜が暴れたのは王宮の辺りだけだったから、\n　火事場泥棒をする暇もなかったねぇ」\\nw[怪しい女]":12,"犯罪者2":13,"「あの家に隠し金庫があるって情報、ウラが取れたぜ。\n　あとは留守になれば――」\\nw[怪しい男]":14,"「決行日が決まったぞ。\n　その日、標的の家は留守になるはずだ」\\nw[怪しい男]":15,"「もしモンスターの襲撃で街が大混乱になったら、その時\n　こそ盗みのチャンスだぜ」\\nw[怪しい男]":16,"「ボスの命令で騒動を起こしてたときに悪竜が出現した\n　けど、あれはただの偶然だったのか……？」\\nw[怪しい男]":17,"ドア":18,"中から男女の甘い声が聞こえる。\nお楽しみ中のようだ。":19,"犯罪者3":20,"「ね、ねぇ、そんなことして大丈夫なの？\n　もし衛兵に見つかったら――」\\nw[挙動不審な女]":21,"「ほ、ほんとにやるの？\n　もし見つかったら、よくて奴隷、下手したら縛り首\n　なんだよ？」\\nw[挙動不審な女]":22,"「モ、モンスターが来たら、わたしは逃げるわよ！\n　命が惜しいもの！」\\nw[挙動不審な女]":23,"「悪竜は出たみたいだけど、モンスターの群れは来なかった\n　から良かったわ」\\nw[挙動不審な女]":24,"犯罪者4":25,"「姐さんのおかげで、仕事は万事順調でさぁ。\n　うぇへへへ……」\\nw[狡そうな男]":26,"「姐さん姐さん！\n　実はまたトラブルが起きちまって、助けてくれませんか？」\\nw[狡そうな男]":27,"「姐さん！　もし噂されてるみてぇに、悪竜が王都へ\n　来ちまったらどうしやしょう？！」\\nw[狡そうな男]":28,"「悪竜に街が壊されることも無かったし、これでまた\n　姐さんと一緒に後ろ暗い商売ができまさぁ」\\nw[狡そうな男]":29,"犯罪者5":30,"「またトラブったら、いつでも相談しな。\n　あたしのシマで勝手な真似するヤツは、絶対に許しちゃ\n　おかないからね！」\\nw[貫禄のある女]":31,"「詳しく話してごらん。\n　なぁに、イキがってる連中なんて、あたしがみんな\n　黙らしてやるよ」\\nw[貫禄のある女]":32,"「悪竜相手じゃあたしがメンチきっても無駄だろうしねぇ。\n　そんときゃ逃げるが勝ちさ」\\nw[貫禄のある女]":33,"「悪竜は倒されたけど、王様が替わっちまったからねぇ。\n　あたしらの商売、やりにくくなるかもよ？」\\nw[貫禄のある女]":34,"犯罪者6":35,"「ほ、ほんとに証拠は残らないんでしょうね……？」\\nw[怯えている女]":36,"「お陰で遺産は手に入れられたけど……ほんとに\n　バレない？　だいじょうぶかしら……」\\nw[怯えている女]":37,"「せっかく遺産を自分のものにできたのに、もしアルテト\n　なんかが来て、全部ダメになっちゃったら……」\\nw[怯えている女]":38,"「そ、そんなぁ！　約束が違うわ！\n　\\N[6]から財産を守ってくれるっていうから\n　預けたのに！」\\nw[怯えている女]":39,"犯罪者7":40,"「お前は主人の食事に薬を混ぜるだけでいい。\n　あとは我々に任せておけ」\\nw[陰気な男]":41,"「怯えることはない。\n　お前を疑う者など誰もいないさ」\\nw[陰気な男]":42,"「遺産の保全が心配なら、半分ほど預かってやろうか？\n　手数料はいただくがな」\\nw[陰気な男]":43,"「文句を言うのはお門違いだぞ？\n　預かり手数料が日毎に５割増になることは、契約書にも\n　ちゃんと書いてあるからな」\\nw[陰気な男]":44,"EV021":45,"『倉庫はいつも整理整頓！\n　できないヤツはブッ殺す！！』":46,"犯罪者8":47,"「俺は今まで、３桁の人間を殺してきた。\n　最初の一人を殺っちまえば、どうってことねぇのさ」\\nw[粗野な男]":48,"「俺が実戦の中で編み出した殺人術は、おいそれとは\n　教えられねぇな！」\\nw[粗野な男]":49,"「まあ俺が本気を出せば、伝説の悪竜も無事じゃ済まない\n　だろうな」\\nw[粗野な男]":50,"「悪竜を倒したのは謎の冒険者だって言われてるだろ？\n　何を隠そう実は……このオレなんだぜ？」\\nw[粗野な男]":51,"犯罪者9":52,"「３桁って、殺しのプロフェッショナルじゃねぇか……！\n　マジすげぇぜ！」\\nw[軽薄な男]":53,"「すげぇ！　殺人術だってよ！\n　俺にも教えてくれないかなぁ」\\nw[軽薄な男]":54,"「アルテトとも戦えるなんて、この人まじパネェぜ！」\\nw[軽薄な男]":55,"「アルテトを倒したってマジっすか！？\n　パネェや！」\\nw[軽薄な男]":56,"犯罪者10":57,"「その男、殺しに慣れているようなことを言ってるが、\n　全部ウソだぞ。信じるな」\\nw[冷淡な女]":58,"「あいつの腕の傷、自分の剣でうっかりつけたんだぞ。\n　まったく、大した殺人術だよ」\\nw[冷淡な女]":59,"「悪竜どころか、毒グモ相手に必死こいてた男が\n　なにを言ってるんだか……」\\nw[冷淡な女]":60,"「わたしにも勝てん男が、どうやって悪竜を倒したという\n　のやら。まったく……」\\nw[冷淡な女]":61,"プレイヤー1":62,"「なんで勝てないんだ！？\n　クソがっ！　イカサマしてんじゃねぇのか！？」\\nw[煩い男]":63,"「くそっ、またダメだッ！\n　今日はとことんツイてねぇぜ！！」\\nw[煩い男]":64,"プレイヤー2":65,"「フフフ……確率のなんたるかも知らないド素人に、\n　このボクが負けるはずもない」\\nw[得意げな男]":66,"「確率を考慮するボクは、今日もトータルでプラス収支さ。\n　すでに３０Ｇも儲けているよ」\\nw[得意げな男]":67,"観客1":68,"「なんだか分かんないけど、スゴーイ！\n　もっと勝って、そのお金で指輪買ってー\\I[29]」\\nw[色っぽい女]":69,"「なぁーんかさ、この人、勝つには勝つんだけど、\n　稼ぎ方がみみっちいのよね」\\nw[色っぽい女]":70,"観客2":71,"「なんで裸なのかって？\n　それは服まで賭けて、ボロ負けしたからだよ！」\\nw[裸の男]":72,"「今日もボロ負けして、服まで取られたんだ。\n　もう家のクローゼットにはパンツしか残ってないよ……」\\nw[裸の男]":73,"観客3":74,"「気をつけろ。\n　ここでイカサマをすると指を斬り落とされるぞ」\\nw[フードの男]":75,"「いまのところ、イカサマをしている者はいないようだ。\n　代償が指の切断となれば、誰でも躊躇するだろうからな」\\nw[フードの男]":76,"ボス":77,"「あんたがこの貧民街のボスか？\n　俺は――」\\nw[\\N[1]]":78,"「知っている。\n　ここへ来たのは、商船を襲った海賊について聞きたい\n　からだな？」\\nw[貧民街のボス]":79,"「えっ！？　どうしてそれを！？」\\nw[\\N[2]]":80,"「なにを驚く。\n　俺のこの情報収集力を頼って、ここまで来たのだろう？」\\nw[貧民街のボス]":81,"「それはそうなんだが……こんなに耳が早いとは、さすがに\n　驚いたぜ」\\nw[\\N[1]]":82,"「時間を無駄にするのは嫌いなのでな、結論から言うぞ。\\nw[貧民街のボス]":83,"「お前たちが欲しがっている情報には、心当たりがある」\\nw[貧民街のボス]":84,"「本当か！？」\\nw[\\N[1]]":85,"「その情報を教えてやってもいいが――」\\nw[貧民街のボス]":86,"「交換条件があるんだろ？\n　裏社会のボスから、タダで情報がもらえるとは\n　思っちゃいないさ」\\nw[\\N[1]]":87,"「話が早い男で助かる。\n　条件というのは、\\C[17]奴隷を使った交渉事\\C[0]だ」\\nw[貧民街のボス]":88,"「交渉？\n　誰かと奴隷の売買をしろということですか？」\\nw[\\N[2]]":89,"「少し違う。\n　奴隷を持参して、ある物と交換してきて欲しいのだ」\\nw[貧民街のボス]":90,"「相手はどこの誰だ？」\\nw[\\N[1]]":91,"「森に住まう、\\C[17]エルフの族長\\C[0]だ」\\nw[貧民街のボス]":92,"「なに！？\n　エルフの森に行って来いっていうのか！？」\\nw[\\N[1]]":93,"「それは無理ですよ！\n　エルフが人間や猫人を嫌っていることは、誰だって\n　知ってることです！」\\nw[\\N[2]]":94,"「しかも交渉相手が族長だなんて、絶対に会ってもらえま\n　せんよ！」\\nw[\\N[2]]":95,"「だからこその、奴隷の手土産だ。\\nw[貧民街のボス]":96,"「ハイエルフとダークエルフのあいだにある確執は\n　知っているか？」\\nw[貧民街のボス]":97,"「詳しくは知らんが、大昔にあったゴタゴタのせいで、\n　殺し合いをするほど反目し合ってるらしいな」\\nw[\\N[1]]":98,"「その通りだ。\n　奴らは人間に対する以上の憎しみを、肌の色が違う同族\n　に抱いている。\\nw[貧民街のボス]":99,"「そこを利用するのだ。\\nw[貧民街のボス]":100,"「敵対するエルフ族の奴隷を連れていけば、話くらいは聞いて\n　もらえるだろう。\\nw[貧民街のボス]":101,"「そこからの交渉は、お前たち次第だ」\\nw[貧民街のボス]":102,"「で、でも、下手するとエルフに集団で殺されちゃう\n　可能性もあるんじゃ……」\\nw[\\N[2]]":103,"「しくじれば、そうなるかもな。\\nw[\\N[1]]":104,"「で、そんな危険を冒してまで、なにが欲しいんだ？\n　よっぽどスゴイ物なんだろうな？」\\nw[\\N[1]]":105,"「持ち帰ってほしいのは、エルフのみが所有するという\n　\\C[17]『精霊性具』\\C[0]だ」\\nw[貧民街のボス]":106,"「せ、せいぐ……？\n　って、もしかして……」\\nw[\\N[2]]":107,"「俗に言う、大人のオモチャだな」\\nw[貧民街のボス]":108,"「おいおい、命がけで大人のオモチャをもらって\n　来いってか？」\\nw[\\N[1]]":109,"「大人のオモチャだろうが子供のオモチャだろうが、\n　金になるなら入手するまでだ。\\nw[貧民街のボス]":110,"「精霊性具を欲しいという好きモノの金持ちは、\n　この王都内だけですら、両手の指に余るほどいるのだ」\\nw[貧民街のボス]":111,"「確かに珍しい性具なら、使ってみたくもなりますよね\\I[29]」\\nw[\\N[2]]":112,"「世の中、変態だらけですね……」\\nw[\\N[2]]":113,"「お前たちならば、気難しいエルフとも交渉ができそう\n　だと、そう判断した。\\nw[貧民街のボス]":114,"「海賊に関する情報が欲しければ、精霊性具を入手\n　してこい」\\nw[貧民街のボス]":115,"「それが条件と言うなら、呑むしかないか。\n　いいだろう、交渉してきてやるよ。\\nw[\\N[1]]":116,"「そうそう、ひとつ大事なことを聞き忘れてた。\\nw[\\N[1]]":117,"「交渉相手のエルフってのは、どっちだ？\n　\\C[17]ハイエルフ\\C[0]か、それとも\\C[17]ダークエルフ\\C[0]か？」\\nw[\\N[1]]":118,"「\\C[17]どちらでもいい。\\C[0]\n　精霊性具は両方のエルフとも持っているはずだ。\\nw[貧民街のボス]":119,"「ちなみに集めた情報によれば、ハイエルフの長老は\n　\\C[17]金髪が好き\\C[0]で、ダークエルフの長老は\\C[17]貧乳好き\\C[0]らしいぞ。\\nw[貧民街のボス]":120,"「連れていく奴隷の選定に役立てるといい」\\nw[貧民街のボス]":121,"「お、おう……」\\nw[\\N[1]]":122,"「あ、あの、実はもうひとつお願いしたいことが\n　あるんですけど……」\\nw[\\N[2]]":123,"「なんだ？」\\nw[貧民街のボス]":124,"「\\C[17]わたしの父の行方\\C[0]についても、調べて欲しいんです。\n　別々に奴隷として売られたあと、どうなったか分から\n　なくて……」\\nw[\\N[2]]":125,"「人探しか。\n　情報が出てくるか確約はできないが、ついでに調べて\n　おいてやろう」\\nw[貧民街のボス]":126,"「あ、ありがとうございます！」\\nw[\\N[2]]":127,"「では行け。\n　吉報を待っているぞ」\\nw[貧民街のボス]":128,"氷雪の神殿・中央部":129,"ハイエルフの森":130,"地下遺跡・1層":131,"ダークエルフの森":132,"メインシナリオ\\C[17]『名声アップ』\\C[0]を達成した！":133,"\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！":134,"メインシナリオ\\C[17]『エルフとの交渉』\\C[0]を受けた！":135,"「さて、どちらのエルフ族と交渉するか……。\n　連れていく奴隷を間違えないよう気をつけないとな」\\nw[\\N[1]]":136,"「相手の好みを外して、交渉決裂にでもなったら\n　大変ですもんね」\\nw[\\N[2]]":137,"「行き先はハイエルフの森でも、ダークエルフの森でも\n　構わない。\n　精霊性具さえ持ち帰ってくればな」\\nw[貧民街のボス]":138,"精霊性具を持っていないとき":139,"「仰せの通り、エルフと交渉して譲ってもらったぜ。\n　これが\\C[17]精霊性具\\C[0]だ」\\nw[\\N[1]]":140,"「人間嫌いのエルフを相手に、五体満足で入手してきたか。\n　正直、少し驚いたぞ」\\nw[貧民街のボス]":141,"「俺たちなら交渉可能だって言ったのは、あんただろうが。\n　それに言うほど簡単じゃなかったんだぜ？」\\nw[\\N[1]]":142,"「そうですよ！\n　森はモンスターだらけだし、エルフはわたしたちのこと\n　殺す気満々でいるし！」\\nw[\\N[2]]":143,"「しかし目的を果たして、無事に戻ってきた。\n　お前たちには、それだけの力があったということだ。\\nw[貧民街のボス]":144,"「要求した通りに精霊性具を持ち帰ってきたからには、\n　こちらも約束を果たさねばな」\\nw[貧民街のボス]":145,"「じゃあ、海賊の件で有望な情報をもらえるのか？」\\nw[\\N[1]]":146,"「ああ。\n　結論から言うと、その猫人の父娘に濡れ衣をかけたという\n　商会は、裏で海賊どもと繋がっている」\\nw[貧民街のボス]":147,"「そんなっ、本当に……！？\n　\\N[3]が海賊なんかと……」\\nw[\\N[2]]":148,"「やっぱりか。そうだと思ってたぜ。\\nw[\\N[1]]":149,"「あのメスガキの商会は商売敵を潰せるし、海賊は\n　航海予定を教えられて簡単に獲物を襲える。\\nw[\\N[1]]":150,"「両方に利のある裏取引をしたわけだ」\\nw[\\N[1]]":151,"「そういうことになるな。\n　だが情報はこれで終わりではない。\\nw[貧民街のボス]":152,"「その\\N[3]という女、武器商ギルドのコネクションや\n　海賊どもまで動員して、何かを探しているようなのだ」\\nw[貧民街のボス]":153,"「探す？　いったい何をだ？」\\nw[\\N[1]]":154,"「詳しいことはつかめていない。\n　ただそれは\\C[17]『竜の鉤爪』\\C[0]という名の、古い道具かなにか\n　らしい」\\nw[貧民街のボス]":155,"「竜の……鉤爪……？」\\nw[\\N[2]]":156,"「そしてこれもあやふやな情報ではあるが、竜の鉤爪の\n　捜索は、\\C[17]王族の誰か\\C[0]の意向によるものらしい」\\nw[貧民街のボス]":157,"「なんだとっ？！　そりゃ本当か？」\\nw[\\N[1]]":158,"「そういえば\\N[3]、シーグヌースで会ったときに\n　王族とも取り引きしてるって自慢してましたよね」\\nw[\\N[2]]":159,"「竜の鉤爪というのは、よほど貴重なものらしい。\n　捜索にはかなり力を入れている様子だ。\\nw[貧民街のボス]":160,"「そのせいで、こちらにも情報が流れてきたのだ」\\nw[貧民街のボス]":161,"「なぁ、その捜索を命じた王族ってのが誰か、\n　調べることは出来るか？」\\nw[\\N[1]]":162,"「調べてどうする？\n　下手に首を突っ込むと、王族の権力によって潰される\n　かもしれんぞ」\\nw[貧民街のボス]":163,"「その権力を、逆手に取ってやろうっていうのさ。\\nw[\\N[1]]":164,"「メスガキより早く、俺たちが竜の鉤爪とやらを\n　見つけて持ち去ったら、どうなると思う？\\nw[\\N[1]]":165,"「役立たずのメスガキどもは王族の怒りを買って、\n　商会の経営にも大きな打撃を受けるんじゃないか？\\nw[\\N[1]]":166,"「そこで海賊との裏取引の事実を暴露してやれば、\n　一気に潰すことだって可能かもしれない」\\nw[\\N[1]]":167,"「落ち目になった商会に、海賊との密約疑惑が出れば\n　庇う者など誰もいない、というわけか」\\nw[貧民街のボス]":168,"「そうそう。\n　世間の信用を失えば、あっという間に終わりだ」\\nw[\\N[1]]":169,"「面白い話だ。\n　せいぜい頑張って竜の鉤爪を探すといい。\\nw[貧民街のボス]":170,"「だが、我々の助力は期待するな」\\nw[貧民街のボス]":171,"「おいおい、そりゃないだろ？\n　あんたらがうまく立ち回れば、傾いたメスガキの商会から\n　ガッポリいただくことだって、出来るはずだ」\\nw[\\N[1]]":172,"「だとしても、王族を敵に回しかねないとあっては\n　リスクが大きすぎる。\\nw[貧民街のボス]":173,"「その話には乗れないな。\n　提供できる情報もここまでだ」\\nw[貧民街のボス]":174,"「期待外れだぜ。\n　貧民街のボスともあろう者が、そんな臆病でいいのか？」\\nw[\\N[1]]":175,"「安い挑発に乗るつもりはない。\n　他に儲け話があるなら聞いてやってもいいが、\n　この件は終わりだ、いいな？」\\nw[貧民街のボス]":176,"「チッ……！」\\nw[\\N[1]]":177,"「あの……」\\nw[\\N[2]]":178,"「そうだったな。\n　もうひとつ、渡しておくべき情報があった。\\nw[貧民街のボス]":179,"「お前の父親だが、居所がつかめたぞ」\\nw[貧民街のボス]":180,"「ほっ、本当ですか！？　父はどこに！？」\\nw[\\N[2]]":181,"「意外にもすぐ近くにいて、見つけるのは簡単だった。\n　今は\\C[17]この貧民街にある小さな酒場\\C[0]で働いている」\\nw[貧民街のボス]":182,"「この街に！？\n　じゃあ、これからすぐ会いに行けるんですね！？」\\nw[\\N[2]]":183,"「ここを出て少し北に行ったところにある、\\C[17]緑の屋根の\n　建物\\C[0]がその酒場だ」\\nw[貧民街のボス]":184,"「良かったじゃないか。\n　奴隷身分のままじゃ、また一緒に暮らすってわけには\n　いかんだろうが」\\nw[\\N[1]]":185,"「それでも、生きて再会できるだけで嬉しいです！」\\nw[\\N[2]]":186,"「約束は果たした。\n　これでお前たちとの仕事は終わりだ」\\nw[貧民街のボス]":187,"「欲しいモノは手に入ったから、もう用無しってか？」\\nw[\\N[1]]":188,"「いいや、お前らが使えることは十分にわかったからな。\n　今後とも付き合いは続けていきたいと思っている」\\nw[貧民街のボス]":189,"「そいつはどうも」\\nw[\\N[1]]":190,"「もし他にも金になる話があれば、いつでもこのアジトの\n　入り口をくぐるがいい」\\nw[貧民街のボス]":191,"「ああ。次は俺の口車に乗ってくれることを期待しとくぜ」\\nw[\\N[1]]":192,"「フン……。\n　リスクとリターンの天秤が釣り合うなら、そのときは\n　考えてやろう」\\nw[貧民街のボス]":193,"メインシナリオ\\C[17]『エルフとの交渉』\\C[0]を達成した！":194,"\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！":195,"「それじゃ早速、お前の親父に会いに行くか。\n　俺も挨拶しておきたいしな」\\nw[\\N[1]]":196,"「えぇっ！？\n　挨拶って、\\N[1]さん？　も、もしかして……\n　\\}娘さんをください的な……ゴニョゴニョ……\\{」\\nw[\\N[2]]":197,"「娘さんのアソコの具合は最高です――と、ちゃんと\n　褒めておいてやるからな」\\nw[\\N[1]]":198,"「じゃあわたしも、\\N[1]さんのオチンチンの具合\n　を、父にいっぱい語って聞かせます\\I[29]」\\nw[\\N[2]]":199,"「お前の親父に殺されたくはないから、やっぱりそういう\n　話は無しでいこう。な？」\\nw[\\N[1]]":200,"「やめてください。\n　\\N[1]さん刺したあと、わたしも自刃して\n　果てますよ？」\\nw[\\N[2]]":201,"「じょ、冗談だ冗談。\n　よく出来た娘さんだって褒めておくから、怒るな」\\nw[\\N[1]]":202,"\\>　　※　貧民街にいるユマの父親のところへ行こう。　※\n\\>　　※　\\C[17]緑の屋根の小さな酒場\\C[0]にいるらしい。　　　　※\\<":203,"「ここを出て少し北に行ったところにある、\\C[17]緑の屋根の\n　建物\\C[0]が目的の酒場だ。\n　猫人娘の父親はそこにいるはずだ」\\nw[貧民街のボス]":204,"「金になる話は持ってきたか？\n　無いのなら去れ。時間を浪費させるな」\\nw[貧民街のボス]":205,"アジト":206,"「このアジトは自由に使ってかまわん。\n　ただし街中へは出るな」\\nw[貧民街のボス]":207,"「分かってるさ。\n　俺たちの変装は通用しないようだからな」\\nw[\\N[1]]":208,"「向こうにある倉庫に、\\C[17]密輸用の抜け穴\\C[0]がある。\n　移動したいときは、そこを使え。\\nw[貧民街のボス]":209,"「悪竜と戦う準備が整ったら、俺に知らせろ。\n　約束通りサポートをしてやる」\\nw[貧民街のボス]":210,"「ああ、頼むぜ」\\nw[\\N[1]]":211,"\\>　　※　決戦の準備ができたら、\\C[17]貧民街のボス\\C[0]に　※\n\\>　　※　話しかけよう。　　　　　　　　　　　　※\\<":212,"「戦いの準備はもういいのか？」\n\\>　\\C[18]※ここから先、ゲームクリアまで行動が制限されます※\\C[0]\n\\>　\\C[18]※悪竜討伐が終わるまで戻ることはできません　　　※\\C[0]\\nw[貧民街のボス]":213,"決戦に行く":214,"まだ行かない":215,"推奨レベル未満":216,"最終決戦は\\C[17]レベル１４以上推奨\\C[0]となります。\nこのまま行きますか？":217,"行く":218,"行かない":219,"「作戦は単純だ。\\nw[\\N[1]]":220,"「あんたら貧民街のヤクザ者が、王都の各所で騒動を\n　起こして、兵士たちを混乱させる。\\nw[\\N[1]]":221,"「その隙に俺たちが王宮へ入り、\\N[6]を倒す」\\nw[\\N[1]]":222,"「ふぅむ……。\\nw[貧民街のボス]":223,"「だが、そう簡単に王宮へ入れるか？」\\nw[貧民街のボス]":224,"「そこは任せておけ」\\nw[\\N[1]]":225,"「必ず\\N[1]さんとわたしで、\\N[6]を\n　倒してきます！」\\nw[\\N[2]]":226,"「いいだろう、すでにお前たちに賭けると決めた身だ。\n　その言葉を信じて動いてやる」\\nw[貧民街のボス]":227,"「\\N[2]、どうしても行くのニャ？」\\nw[\\N[2]の父]":228,"「うん。自分で決めたことだから」\\nw[\\N[2]]":229,"「私もついて行ってやりたいけど……腰が……。\n　役に立たない父親でごめんニャ……」\\nw[\\N[2]の父]":230,"「後でとびきりいい酒を奢ってあげるから、あんたたち\n　必ず帰ってきなさいよ」\\nw[マスター]":231,"「お前たちが勝たないと、私の学者生命まで終わりなんだ\n　からな！　本当に頼んだぞ！」\\nw[伝承学者]":232,"「任せておけ。\n　俺の人生、これまで成るように成ってきたんだ。\\nw[\\N[1]]":233,"「今回だってどうにかなるさ」\\nw[\\N[1]]":234,"「とてつもなく不安ニャ……」\\nw[\\N[2]の父]":235,"「だがこの男しか、悪竜に勝つ見込みのある者はいない\n　のだろう？\\nw[貧民街のボス]":236,"「サイコロはすでに振った。\n　あとは期待して出目を待つしかない」\\nw[貧民街のボス]":237,"「ああ、期待しとけ。\n　ここにあるのはイカサマを仕込んだサイコロだからな」\\nw[\\N[1]]":238,"C_ADD_TIME \\V[1]":239,"「フン……王になれるチャンスを棒に振るとはな。\n　もっともお前がその器だとも思えんが」\\nw[貧民街のボス]":240,"トークマーク":241,"ユマ":242,"EV035":243,"密輸通路入り口":244,"どこへ行きますか？":245,"王都の外":246,"自宅if(s[1461])":247,"闘技場":248,"自宅":249,"EXITマーク":250,"ユマ父":251,"「私たちは大丈夫ニャから、自分のことだけ考えて\n　無茶をしないようにするんニャよ？」\\nw[\\N[2]の父]":252,"マスター":253,"「私たちも兵士から、反逆者の一味扱いされちゃってね。\n　ボスに頼んでここに匿ってもらってるの」\\nw[マスター]":254,"伝承学者":255,"「不本意だが、いまは雌伏のときだ。\n　さっさと\\N[6]を倒してきてくれ」\\nw[伝承学者]":256,"睡眠処理":257,"ギャンブラー":258,"「そのうち気が向いたら、あんたとも勝負をして\n　やろうかの」\\nw[ギャンブラー]":259,"特定アイテムを賭けての勝負\n↓　　↓　　↓":260,"「この老体とギャンブルをやってみるかね？\n　もしキミが勝ったら\\C[17]戦斧\\C[0]をあげよう。\\nw[ギャンブラー]":261,"「だがワシが勝ったときは、その猫人の美少女の\n　\\C[27]お尻を見せてもらおうかね。\\C[0]かまわんかな？」\\nw[ギャンブラー]":262,"勝負を受ける":263,"やめておく":264,"奴隷カードの説明":265,"PNDK_LC getSurplusWeights 15":266,"↓積載重量空きOK":267,"賞品の重量が\\C[18]\\v[17]Ｗ\\C[0]オーバーしてしまうため、勝負を\n受けられません。\n積載重量に余裕を作ってください。":268,"「よしっ、勝負じゃ！！」\\nw[ギャンブラー]":269,"勝利（戦利品ゲット）":270,"「ワシも老いたかのぅ。\n　負けは負けじゃ、この戦斧を持っていきなされ」\\nw[ギャンブラー]":271,"Lv1~6":272,"武器\\C[17]『\\wn[98]』\\C[0]を手に入れた！":273,"Lv6~9":274,"武器\\C[17]『\\wn[103]』\\C[0]を手に入れた！":275,"Lv9~11":276,"武器\\C[17]『\\wn[106]』\\C[0]を手に入れた！":277,"Lv12~14":278,"武器\\C[17]『\\wn[111]』\\C[0]を手に入れた！":279,"Lv15~":280,"武器\\C[17]『\\wn[115]』\\C[0]を手に入れた！":281,"引き分け":282,"「引き分けとは残念じゃな。\n　まあ、こういうこともあるわい」\\nw[ギャンブラー]":283,"敗北（ユマ凌辱）":284,"「ほっほう！　ワシが勝ってしまったね。\n　ではお尻を見せてくれるかな？」\\nw[ギャンブラー]":285,"「はい、若い女の子のお尻ですよぉ～\\I[29]\n　じっくり見て、オチンチン元気にしてくださいね\\I[29]」\\nw[\\N[2]]":286,"「恥じらいのないスケベ娘らしい、スケベな尻じゃな！」\\nw[ギャンブラー]":287,"「いい歳してお尻見せろとか……バカみたい！\n　これでいいですか！？　満足しました！？」\\nw[\\N[2]]":288,"「そう怒らんと、もうちょっと見せい。\n　やはり若い尻は良いものじゃなぁ」\\nw[ギャンブラー]":289,"\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下がった！":290,"現金を賭けての勝負（繰り返し）\n↓　　↓　　↓":291,"「現金を賭けて勝負するかい？」\n（※賭け金は\\C[17]『\\v[1170]G』\\C[0]です）\\nw[ギャンブラー]":292,"賭ける":293,"現金がある":294,"現金なし":295,"「おいおい、金がないんじゃ勝負が成立せんぞ」\\nw[ギャンブラー]":296,"勝利（賭け金ゲット）":297,"「ふぅむ、今日はツイておらんな……」\\nw[ギャンブラー]":298,"\\C[17]『\\v[1170]G』\\C[0]を手に入れた！":299,"敗北（賭け金没収）":300,"「ワシの勝ちじゃ。\n　まあこちとら年季が違うからの」\\nw[ギャンブラー]":301,"\\C[9]『\\v[1170]G』\\C[0]を失った！":302,"EV045":303,"EV046":304,"EV047":305,"ギャンブルふきだし":306,"宝箱（お金右開き）":307,"<TE:17>":308,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":309,"EV050":310},"extension":"json","dataType":"map","filename":"Map300","basename":"Map300.json","path":"data/Map300.json","relPath":"data/Map300.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":1,"length":311,"percent":0.3215434083601286},"cellInfo":[]},"data/Map301.json":{"data":[["EV001",""],["EV002",""],["酔った客",""],["「アルテトォ？　それがどうしたぁ！\n　そんなことより酒だぁ！」\\nw[酔った客]",""],["「酒だぁー！　もっと酒をくれぇ！」\\nw[酔った客]",""],["「日のあるうちから飲んで、なにが悪いってんだぁー！？」\\nw[酔った客]",""],["マスター",""],["「いらっしゃぁい\\I[29]\n　あら、この辺じゃ見かけないお兄さんね？」\\nw[マスター]",""],["「ああ、王都の人間じゃないんでな。\n　実は人を探していて、ここまで来たんだ」\\nw[\\N[1]]",""],["「あのっ、このお店に猫人の奴隷がいるって聞いて\n　来たんです！」\\nw[\\N[2]]",""],["「そうなの？\n　確かにウチには、奴隷の従業員がいるけど」\\nw[マスター]",""],["「よし、情報に間違いはなかったようだな。\\nw[\\N[1]]",""],["「マスター、その猫人奴隷に会わせてもらえないか？」\\nw[\\N[1]]",""],["「お安い御用よ。いま呼んであげるわ\\I[29]」\\nw[マスター]",""],["「良かった……やっと父さんと会える……」\\nw[\\N[2]]",""],["「ミニャニャちゃーん！　ご指名よー！\\I[29]」\\nw[マスター]",""],["「はーい\\I[29]」\\nw[？？？]",""],["「いらっしゃいませニャ！\n　ご指名いただきました、ミニャニャですニャ\\I[29]」\\nw[ミニャニャ]",""],["「おいおいマスター、違うぞ。\n　俺たちが探してるのは、中年の男で――」\\nw[\\N[1]]",""],["\\{「父さんっ？！」\\}\\nw[\\N[2]]",""],["\\{「なにぃっ！？\\!　　\n　　　　　\\}\\}あっ、よく見たら無精ヒゲが……！\\{\\{」\\nw[\\N[1]]",""],["「\\N[2]ッ！？\n　ほんとうに\\N[2]なのかニャッ！？\\nw[ミニャニャ]",""],["「まさか無事な姿で、また会えるにゃんて……！」\\nw[ミニャニャ]",""],["「ち……ちがう……父さんじゃない……」\\nw[\\N[2]]",""],["「なにを言ってるのニャ、\\N[2]？\n　ほら、父さんにゃよ？」\\nw[ミニャニャ]",""],["\\{「ちがうもんっ！\\}\\nw[\\N[2]]",""],["\\{「わたしの父さんは、語尾に『ニャ』とか\n　つけないもんッ！」\\}\\nw[\\N[2]]",""],["「そんにゃーっ！？」\\nw[ミニャニャ]",""],["「お、おい\\N[2]、とりあえず落ち着け。\\nw[\\N[1]]",""],["「現実を見たくない気持ちは分かるが、どうやらコレが\n　お前の父親らしいぞ？」\\nw[\\N[1]]",""],["\\{「ちがうもんっ！」\\}\\nw[\\N[2]]",""],["「仕方ない……とりあえず、ここは俺が話を聞こう。\n　あんたが\\N[2]の父親で間違いないんだな？」\\nw[\\N[1]]",""],["「……そうだにゃん。\n　いまちょっと自信が揺らいでるけど」\\nw[ミニャニャ]",""],["「いったい、なにがあってチンコを切る羽目に\n　なったんだ？」\\nw[\\N[1]]",""],["「別にチンコはとってないニャ。\n　女装してるだけにゃよ。\\nw[ミニャニャ]",""],["「奴隷に堕ちて売られた先が、このちょっと特殊な酒場\n　だったから、店のノリに合わせてるだけニャ」\\nw[ミニャニャ]",""],["「ミニャニャちゃん、お客さんからの評判も良くってね。\n　きっとこのお仕事が天職なのよ\\I[29]」\\nw[マスター]",""],["「そんにゃ……マスターが丁寧に仕事を教えてくれる\n　おかげニャ\\I[29]」\\nw[ミニャニャ]",""],["「……まあ、幸せそうで良かったよ」\\nw[\\N[1]]",""],["「おい\\N[2]、そろそろ現実に戻って来い。\n　どうあがいたって、これがお前の父親だぞ」\\nw[\\N[1]]",""],["「わかってます……わたしの知ってる父さんはもうどこにも\n　いないって……」\\nw[\\N[2]]",""],["「だから父さんはココにいるんにゃけど！？」\\nw[ミニャニャ]",""],["「そっちの子がミニャニャちゃんの娘だっていうのは\n　分かったけど、じゃあ、あなたはどういう関係なの？」\\nw[マスター]",""],["「そうニャ！\n　あんたはどこの誰ニャ！？」\\nw[ミニャニャ]",""],["「慌てるな。\n　いまイチから説明してやるから」\\nw[\\N[1]]",""],["\n\\>　　　　　～　これまでの事情を説明中　～\\<",""],["「やはりあいつらに裏切られていたのか！\n　くそぉっ！\\nw[\\N[2]の父]",""],["「海賊の襲撃が、タイミング良すぎたから\n　おかしいと思っていたんだ！」\\nw[\\N[2]の父]",""],["「おっ、口調がまともになったな」\\nw[\\N[1]]",""],["「ミニャニャだった期間が長すぎて自然と語尾がニャに\n　なってたが、それも怒りで吹き飛んだぞ！」\\nw[\\N[2]の父]",""],["「\\N[3]とかいうメスガキの商会が元凶だと、\n　気づいていたのか？」\\nw[\\N[1]]",""],["「薄々はな。\n　だが信頼していた相手だから、まさかという思いも\n　あったんだが……。\\nw[\\N[2]の父]",""],["「くそっ！\n　俺が不甲斐ないばかりに、\\N[2]まで奴隷にして\n　しまった……。\\nw[\\N[2]の父]",""],["「すまん、\\N[2]！」\\nw[\\N[2]の父]",""],["「父さん……」\\nw[\\N[2]]",""],["「だいじょうぶ、父さんは悪くない。\n　悪いのは\\N[3]たちだもん。ちゃんと分かってるよ」\\nw[\\N[2]]",""],["「\\N[2]……ありがとう……」\\nw[\\N[2]の父]",""],["「いい話ね、泣けるわぁ」\\nw[マスター]",""],["「いや、泣いてばかりもいられん！\n　娘ともども奴隷身分にされた恨み……晴らさずには\n　おかんぞ！」\\nw[\\N[2]の父]",""],["「その意気があるなら、俺たちを手伝ってくれないか？」\\nw[\\N[1]]",""],["「是非ともそうしたいが……実は腰が悪くて……。\n　とてもじゃないが、戦闘の役には立てそうにないんだ」\\nw[\\N[2]の父]",""],["「そ、そうか。\n　腰は……まあ仕方ないよな。\\nw[\\N[1]]",""],["「だが戦闘以外でも仕事はあるだろ。\n　たとえば情報収集とか。\\nw[\\N[1]]",""],["「これから俺たちは、『竜の鉤爪』って代物の情報を集め\n　ようとしてるところなんだ。\\nw[\\N[1]]",""],["「それをメスガキより先に入手できれば、あいつの\n　商会ごとブッ潰せるかもしれないんだが」\\nw[\\N[1]]",""],["「竜の鉤爪……？\n　どこかで聞いたことがあるような……」\\nw[\\N[2]の父]",""],["「なに、本当か！？」\\nw[\\N[1]]",""],["「昔、たまたま酒場で知り合った学者が、そんなような\n　話をしてた……と思うが……。\\nw[\\N[2]の父]",""],["「しかしなにぶん、酔ってたんでほとんど覚えてないんだ。\n　確かその学者は、こう愚痴ってたような――。\\nw[\\N[2]の父]",""],["「必要な資料が\\C[17]大聖堂の書庫\\C[0]にあるはずなのに、\n　いくら頼んでも見せてもらえない――と」\\nw[\\N[2]の父]",""],["「竜の鉤爪に関する資料が、大聖堂に？」\\nw[\\N[2]]",""],["「それなら、次の行き先は決まりだな。\n　大聖堂へ行って、竜の鉤爪について調べるぞ」\\nw[\\N[1]]",""],["「そうしてくれるのはありがたいが、あんたはどうして\n　そこまで深入りしようとするんだ？\\nw[\\N[2]の父]",""],["「一介の奴隷商人には荷の重い話のはずだ。\n　我々父娘を助ける義理だって無いだろうに」\\nw[\\N[2]の父]",""],["「それについては、以前\\N[2]にも言ったが、\n　あの気にくわないメスガキに、地獄を見せて\n　やりたいからさ」\\nw[\\N[1]]",""],["「そ、そうかい……あまり健全な動機じゃなさそうだが、\n　あんたがそれでいいと言うなら……」\\nw[\\N[2]の父]",""],["（なんてな。最初の動機はそうだったが、いまは別に気に\n　なることがあるから動いてるだけだ。\\nw[\\N[1]]",""],["（メスガキをアゴで使ってる王族――そいつは誰なんだ？）\\nw[\\N[1]]",""],["「父さん、わたし行ってくる。\n　奴隷身分から解放されるために、竜の鉤爪を見つけ出し\n　てくるよ！」\\nw[\\N[2]]",""],["「分かった。\n　それなら父さんはここで、敵の動向を探ろう。\\nw[\\N[2]の父]",""],["「ヤツラの商会は王都に進出して、かなり手広く\n　商取引をしているらしいからな」\\nw[\\N[2]の父]　",""],["「そういうことなら、王都の方はミニャニャちゃんに\n　任せるとするか」\\nw[\\N[1]]",""],["「ガンバルにゃん\\I[29]」\\nw[\\N[2]の父]",""],["メインシナリオ\\C[17]『大聖堂の書庫』\\C[0]を受けた！",""],["「あたしは何も聞かなかったことにしてあげるから、\n　好きなようにやるといいわ」\\nw[マスター]",""],["「一杯おごるから、私にも旅の話を聞かせてちょうだいよ」\\nw[マスター]",""],["「詮索はしないわよ。\n　この街じゃ、誰もが厄介事を抱えているからね」\\nw[マスター]",""],["「誰も彼もが悪竜アルテトの話をしてるわ。\n　みんな不安なのね」\\nw[マスター]",""],["「ミニャニャちゃんが奴隷身分から解放されて良かったわ。\n　故郷でも元気にやってるかしら？」」\\nw[マスター]",""],["火",""],["光",""],["トークマーク",""],["ユマ父1",""],["「竜の鉤爪は、\\C[17]封印された古代竜アルテトを目覚めさせ、\n　操るためのマジックアイテム\\C[0]だった」\\nw[\\N[1]]",""],["「あの伝説の悪竜が生きてる！？」\\nw[\\N[2]の父]",""],["「それ、本当なんですか！？\n　でもどこでそんな話を？」\\nw[\\N[2]]",""],["「それについては内緒だ。\n　だが、まず間違いはない。\\nw[\\N[1]]",""],["「王族の誰かがアルテトの力を自分のものにするため、\n　メスガキを使って鉤爪を集めさせていたんだ」\\nw[\\N[1]]",""],["「それを信じるとして……なんのためにアルテトを？」\\nw[\\N[2]の父]",""],["「決まってる。\n　玉座を奪って、自分が王になるためだ」\\nw[\\N[1]]",""],["「えええぇぇっ！？」\\nw[\\N[2]]",""],["「今の国王の役立たずっぷりは有名だろ？\\nw[\\N[1]]",""],["「あんなアホに国の行く末を任せるくらいなら、\n　いっそ自分が――と考える他の王族がいても\n　おかしくはない」\\nw[\\N[1]]",""],["「国王自身が、鉤爪を探させてたって可能性はニャいか？」\\nw[\\N[2]の父]",""],["「いや、それなら普通に兵隊なり役人なりを動員して\n　捜索させるだろ？\\nw[\\N[1]]",""],["「堂々と鉤爪捜索をすると、謀反の疑いがかかるかも\n　しれない他の王族だからこそ、メスガキを使うなんて\n　面倒な方法をとっているんだ」\\nw[\\N[1]]",""],["「じゃあ、鉤爪はクーデター計画の要だから、\n　あんな刺客まで送り込んで取り戻そうとしたんですか？」\\nw[\\N[2]]",""],["「そう考えると、しっくりくるだろ？\n　忌々しいことにな」\\nw[\\N[1]]",""],["「これはもう、私たちの手に負える規模の話じゃニャい\n　と思うニャー。\\nw[\\N[2]の父]",""],["「いっそ鉤爪といまの話を王宮に持って行って、\n　王様を味方につけちゃったらどうニャ？」\\nw[\\N[2]の父]",""],["「あっ、それいいかも！\n　王様の鶴の一声があれば、すぐに奴隷から解放して\n　もらえるかもしれないし！」\\nw[\\N[2]]",""],["「アホ王が聞く耳を持ってくれれば、の話だがな。\\nw[\\N[1]]",""],["「だが一歩間違えると、不敬罪や騒乱罪で処刑コース\n　かもしれんぞ？」\\nw[\\N[1]]",""],["「そ、そんなぁ……」\\nw[\\N[2]]",""],["「だが、考え方は悪くない。\\nw[\\N[1]]",""],["「もし、黒幕でないと確信できる王族の誰かを味方に\n　つけられれば――」\\nw[\\N[1]]",""],["「メイドさん？\n　これはまた珍しいお客さんが来たわねぇ」\\nw[マスター]",""],["「こちらの店主の方でしょうか？\n　少々お伺いしたいのですが」\\nw[メイド]",""],["「なぁに？\n　スリーサイズ以外なら教えちゃうわよ\\I[29]」\\nw[マスター]",""],["「こちらに\\N[1]という名の奴隷商人がいると\n　思うのですが」\\nw[メイド]",""],["「ま、まさか、また刺客が……！？」\\nw[\\N[2]]",""],["「いや、そういう感じではなさそうだぞ？\n　だがこちらの居所をつかんでるなら、油断はできんな」\\nw[\\N[1]]",""],["「\\N[1]？\n　ウチの店にはいろんなお客がくるんで、名前なんて\n　いちいち覚えてないわぁ」\\nw[マスター]",""],["「では手紙を置いていきますので、来店したら\n　お渡ししてください。\\nw[メイド]",""],["「それと伝言もおねがいします。\\nw[メイド]",""],["「あなたたちが抱えている問題。それを解決するための\n　糸口を、我々は提供できる――と」\\nw[メイド]",""],["「ではこれで、失礼いたします」\\nw[メイド]",""],["「これがメイドの置いていった手紙ニャ」\\nw[\\N[2]の父]",""],["\n\\C[17]『日が落ちてから、闘技場北の公園まで来られたし』\\C[0]",""],["「これだけ？　差出人の名前もない」\\nw[\\N[2]]",""],["「あからさまに怪しいな」\\nw[\\N[1]]",""],["「行った先で、敵が待ち伏せしてるかもニャ」\\nw[\\N[2]の父]",""],["「その可能性もあるが……俺は行ってみようと思う」\\nw[\\N[1]]",""],["「き、危険ですよ！」\\nw[\\N[2]]",""],["「今更だろうが。\n　それにただ何もせずにいれば、危険が向こうから\n　押しかけて来るだろうよ」\\nw[\\N[1]]",""],["「虎穴に入らずんば虎児を得ず、かニャ？」\\nw[\\N[2]の父]",""],["「そういうことだ。\n　手紙の誘いに乗ってやろう」\\nw[\\N[1]]",""],["「だいじょぶかなぁ～？」\\nw[\\N[2]]",""],["\\>　　※　\\C[17]夜\\C[0]になったら、闘技場の北にある\\C[17]公園\\C[0]へ　※\n\\>　　※　行ってみよう。　　　　　　　　　　　　※\\<",""],["「誰かと思えば、学者先生じゃないか」\\nw[\\N[1]]",""],["「ああそうだ。\n　キミたちのお陰で厄介事に巻き込まれて、発掘作業が\n　中断中の学者だよ！」\\nw[伝承学者]",""],["「そ、その節はたいへんご迷惑をおかけして……」\\nw[\\N[2]]",""],["「なんだ、わざわざ文句を言いに来たのか？」\\nw[\\N[1]]",""],["「それもあるが、それだけじゃない！\n　この騒ぎについて言いたいことと、訊きたいことが\n　あるからだ！」\\nw[伝承学者]",""],["「噂が爆発的に広がって、いまや王都はアルテト関連の\n　話題で持ちきりニャからね」\\nw[\\N[2]の父]",""],["「その噂、意図的に広められたんじゃないか？\n　たとえばメスガキの商会あたりが中心になって」\\nw[\\N[1]]",""],["「確かにその形跡はあったニャ！\n　でもなんでそんなことを？」\\nw[\\N[2]の父]",""],["「えっと……実は……」\\nw[\\N[2]]",""],["\n\\>　　　　　　※　ここまでの経緯を説明中　※",""],["「……というわけでして」\\nw[\\N[2]]",""],["「やはり竜の鉤爪が使われてしまったのか！\n　しかも王族である\\N[5]姫がアルテトの化身だとは！」\\nw[伝承学者]",""],["「滅茶苦茶な話ニャ！\n　娘の口から聞いたんでなきゃ、とても信じられないニャ！」\\nw[\\N[2]の父]",""],["「そう、この事実を俺たちがいくら叫んだところで、\n　荒唐無稽すぎて誰も信じやしないだろう。\\nw[\\N[1]]",""],["「パルフューク大公が反逆を企んでアルテトを\n　甦らせ、制御に失敗して自滅――。\\nw[\\N[1]]",""],["「それが『真実』として、王都中に広まっちまってる。\n　\\N[5]の指示で、メスガキがやったに違いない」\\nw[\\N[1]]",""],["「今度こそもう、私たちには手に負えない話ニャ。\\nw[\\N[2]の父]",""],["「あきらめて、どこかに逃げるか隠れるかするのが\n　賢明だと思うニャ」\\nw[\\N[2]の父]",""],["「そんな！？\n　\\N[6]が復活したのは、わたしたちが騙されたせいでも\n　あるのに……！」\\nw[\\N[2]]",""],["「だからと言って、ほぼ孤立無援のキミたちになにが\n　できる？」\\nw[伝承学者]",""],["「そ、それは……」\\nw[\\N[2]]",""],["「ミニャニャちゃんや学者先生の言う通りだ。\n　\\N[2]、お前は父親と一緒に身を隠せ」\\nw[\\N[1]]",""],["「お前は……って、\\N[1]さんはどうする\n　つもりなんですか！？」\\nw[\\N[2]]",""],["「言っただろう。\n　やられっぱなしは性に合わないって。\\nw[\\N[1]]",""],["「あの腹黒ドラゴン姫をブッ潰す方法を、なんとか\n　探し出してやるさ」\\nw[\\N[1]]",""],["「そんな、どうして自分だけ！？\n　これまで一緒にやってきたのに！\\nw[\\N[2]]",""],["「だいたい、\\N[6]と戦ってもお金にならないのに、\n　そこまで執着するなんて……\\N[1]さん、\n　なにか変ですよ！？」\\nw[\\N[2]]",""],["「…………」\\nw[\\N[1]]",""],["「もしかしてキミが\\N[6]との戦いから逃げないのは、\n　\\C[17]血筋\\C[0]に対して責任を感じているからか？」\\nw[伝承学者]",""],["「血筋……？」\\nw[\\N[2]]",""],["「なんのことニャ？」\\nw[\\N[2]の父]",""],["「実は、あの地下遺跡にあった壊れた碑文を復元して\n　みたのだ。\\nw[伝承学者]",""],["「そこに\\C[17]魔法陣\\C[0]の効果について記述があった。\n　そう、その男がうっかり起動させてしまった、あの\n　大型魔法陣だ」\\nw[伝承学者]",""],["「あのときは何も起こらなくて、\\N[1]さんが\n　先生に怒られただけでしたよね？」\\nw[\\N[2]]",""],["「我々にとってはそうだったが、彼にとっては違う体験が\n　あったかもしれない」\\nw[伝承学者]",""],["「意味が分からないニャ？」\\nw[\\N[2]の父]",""],["「碑文には、魔法陣が建国王リジェルダによって作られた\n　ある種の情報伝達装置であると記されていた。\\nw[伝承学者]",""],["「そして魔法陣を起動できるのは、\\C[17]リジェルダの血\\C[0]を\n　色濃く継ぐ者のみであるとも」\\nw[伝承学者]",""],["「\\N[1]、率直に問おう。\n　キミは\\C[17]王族\\C[0]なのではないかね？」\\nw[伝承学者]",""],["「俺が王族？\n　バカも休み休み言えって」\\nw[\\N[1]]",""],["「そ、そうですよ！\n　こんな品のないドスケベ人間が、王族なわけないですよ」\\nw[\\N[2]]",""],["「\\N[2]の偏見に満ちた評価はともかくとして、\n　俺は断じて王族なんかじゃないからな」\\nw[\\N[1]]",""],["「本当かね？」\\nw[伝承学者]",""],["「ああ、本当だとも。\n　ただ\\C[17]父親がアホ王\\C[0]ってだけであって、俺自身は\n　正真正銘の庶民だ！」\\nw[\\N[1]]",""],["「へぇー。お父さんが王様なんですかぁー」\\nw[\\N[2]]",""],["「…………」\\nw[\\N[2]]",""],["\\{「それって王族ってことでしょー？！！」\\}\\nw[\\N[2]]",""],["「いや違うな。\n　王族ってのは血筋じゃなくて、制度に基づく身分だ。\\nw[\\N[1]]",""],["「だから俺は庶民。王族じゃない。\n　以上証明終了」\\nw[\\N[1]]",""],["「へりくつー！！\\nw[\\N[2]]",""],["「……って、えっ、あっ？\n　ほ、ほんとの本当に、王様の子供なんですか？\\nw[\\N[2]]",""],["「つまり……王子様？」\\nw[\\N[2]]",""],["「王子様？」\\nw[\\N[2]の父]",""],["「王子様？」\\nw[伝承学者]",""],["「『王子様』って言葉に対する侮辱ですよ、存在自体が」\\nw[\\N[2]]",""],["「冗談抜きでブン殴るぞ？」\\nw[\\N[1]]",""],["「す、すみません。\n　あまりのことに混乱して、つい本音が……」\\nw[\\N[2]]",""],["「ふむ……あの国王に男児がいたなどという話は\n　聞いたこともないから、とするとキミは当然――」\\nw[伝承学者]",""],["「ああ、庶子――つまり私生児だ。\\nw[\\N[1]]",""],["「王宮で侍女をやってた俺のお袋に、アホ王が手をつけて\n　身籠らせたんだ。\\nw[\\N[1]]",""],["「それも、半年後には他国の姫を正妃として迎え入れるって\n　タイミングでな」\\nw[\\N[1]]",""],["「それって最悪じゃニャいの？」\\nw[\\N[2]の父]",""],["「最悪も最悪。\n　表沙汰にはできない話さ。\\nw[\\N[1]]",""],["「だから腹に俺を抱えたお袋に金品をあてがって、\n　こっそり実家に送り返したんだ。\\nw[\\N[1]]",""],["「以降、アホ王からの接触は一切なし。\n　俺は成人するまでずっと、父親が誰かも知らないまま\n　育てられたよ」\\nw[\\N[1]]",""],["「そ、そんな生い立ちが……」\\nw[\\N[2]]",""],["「言っておくが、俺は自分の境遇に対して不満は\n　感じてないぞ？\\nw[\\N[1]]",""],["「アホ王の血を引いてるって点だけは、残念に思うがな」\\nw[\\N[1]]",""],["「じゃ、じゃあ、\\N[5]姫のことは？\n　腹違いの妹なんですよね？」\\nw[\\N[2]]",""],["「……いまになって、兄だ妹だと言うつもりはない。\\nw[\\N[1]]",""],["「ただ、あんなんでも一応は身内ってことになるからな。\n　他にやれそうなヤツがいない以上、俺が始末をつける\n　しかないだろ」\\nw[\\N[1]]",""],["「じゃ、じゃあ、わたしも手伝います！\n　だってわたしはまだ、\\N[1]さんの\n　奴隷ですから！」\\nw[\\N[2]]",""],["「…………物好きなヤツだな。\n　勝手にすりゃいい」\\nw[\\N[1]]",""],["「はい、勝手にします！」\\nw[\\N[2]]",""],["「自分の娘ながら、まったく損な生き方を選ぶ子ニャー」\\nw[\\N[2]の父]",""],["「しかし始末をつけると言って、なにか具体策は\n　あるのか？」\\nw[伝承学者]",""],["「そんなものはない！\n　……が、気になることが二つある。\\nw[\\N[1]]",""],["「ひとつは、どうして\\N[6]を復活させるのに、\n　\\N[5]のヤツは竜の鉤爪を壊さなかったのか」\\nw[\\N[1]]",""],["「\\N[6]を制御するためには壊しちゃダメって話\n　でしたけど、姫自身が\\N[6]の分身なら鉤爪なんて\n　必要ないですよね？」\\nw[\\N[2]]",""],["「ああ、そのはずだ。\n　そして二つ目の気になる点――。\\nw[\\N[1]]",""],["「『竜の寝床』で\\N[6]に襲われたとき、あれだけの\n　力の差があったのに、なぜ俺たちは逃げ延びることが\n　できたのか？\\nw[\\N[1]]",""],["「副都でもそうだ。\n　虚を突いたとはいえ意外とあっさり逃げることができた。\\nw[\\N[1]]",""],["「なんとなくだが……\\N[6]の動きには制限がかかって\n　いるような、妙な感じがあった」\\nw[\\N[1]]",""],["「壊されなかった竜の鉤爪と、\\N[6]の見せた\n　謎の隙……か。\\nw[伝承学者]",""],["「それならばひとつ、可能性のある推測が立てられるぞ」\\nw[伝承学者]",""],["「ホントですか！？」\\nw[\\N[2]]",""],["「だが、あまり期待しないでくれ。\n　確証はまったくないんだからな」\\nw[伝承学者]",""],["「それでもいい、聞かせてくれ」\\nw[\\N[1]]",""],["「……もしかしたら、死毒の沼に投げ入れられた竜の\n　鉤爪は、三つ揃ったことで今も正常に機能し続けて\n　いるのかもしれない」\\nw[伝承学者]",""],["「どういうことだ？」\\nw[\\N[1]]",""],["「鉤爪が機能しているからこそ、少しだけどキミは\n　無意識に\\N[6]を操れて、窮地を脱することが\n　できたんじゃないか？\\nw[伝承学者]",""],["「竜の鉤爪は本来、子孫に悪竜を操る力を与えようとして\n　リジェルダが用意したものだ。\\nw[伝承学者]",""],["「まさに直系の子孫であるキミのために用意された\n　ようなモノだろう」\\nw[伝承学者]",""],["「なるほど、言われてみれば確かに」\\nw[\\N[1]]",""],["「そしてその“操る力”を\\N[5]姫も必要としているのかも\n　しれない」\\nw[伝承学者]",""],["「えっ、でも、\\N[5]姫が\\N[6]なわけですから……」\\nw[\\N[2]]",""],["「考えてもみたまえ。姫と悪竜が同じ魂を持つとはいえ、\n　存在が二つに分かれてから５００年もの歳月が経って\n　いるんだぞ？\\nw[伝承学者]",""],["「それに\\N[5]姫の体には、悪竜のものだけでなく\n　人間としての魂も同時に存在しているはずだ。\\nw[伝承学者]",""],["「いわば\\N[5]姫は、竜と人間の複合体とでも呼ぶべき\n　未知の生物と言えよう。\\nw[伝承学者]",""],["「そんな異質な存在が、長年に渡って分かたれていた\n　悪竜本体と、スムーズに同化できるものだろうか？」\\nw[伝承学者]",""],["「そうか……本体と分身の同化を確実に行うために、\n　竜の鉤爪の“操る力”が必要だったんだな？\\nw[\\N[1]]",""],["「たとえ分身であっても、確実に同化するには本体を\n　操って自分の支配下に置く必要があったと」\\nw[\\N[1]]",""],["「ああ、私はそう推測する。\n　そしてその同化作業は、まだ完全には終わっていない\n　のかもしれない」\\nw[伝承学者]",""],["「二度も\\N[6]の前から逃げられたのは、あいつが\n　まだ本調子じゃなかったからってワケだ」\\nw[\\N[1]]",""],["「まあ、希望的観測かもしれないがね。\n　ともあれ、もし毒沼の底でいまも本当に鉤爪が作動して\n　いるとしたら――\\N[1]。\\nw[伝承学者]",""],["「キミの中に流れるリジェルダの血の力を高めることで、\n　今度は意識的に\\C[17]\\N[6]をコントロールできるように\n　なる\\C[0]かもしれない」\\nw[伝承学者]",""],["「どういうことだ？　血の力を高めるだと？」\\nw[\\N[1]]",""],["「そう、\\C[17]『地母神の乳』\\C[0]を使えば、あるいは血の力を\n　覚醒させられる可能性が……」\\nw[伝承学者]",""],["「ちょっと待て、いったい何の話だ！？　乳？」\\nw[\\N[1]]",""],["「『地母神の乳』だ。\n　飲めば自分の血の中に眠っている才覚や能力が\n　活性化するという、伝説の泉の水だ」\\nw[伝承学者]",""],["「そんなお伽話に出てきそうな泉、実在するんですか？」」\\nw[\\N[2]]",""],["「存在をほのめかす伝承ならいくつもある。\n　だが実物となると――探してみないことには、なんとも\n　言えないな。\\nw[伝承学者]",""],["「伝わるところによれば、この王都から北へ行った先に\n　ある\\C[17]『迷いの森』\\C[0]の奥に、それは湧き出ているのだと\n　いう」\\nw[伝承学者]",""],["「つまりそいつでご先祖様の血の力を強くして、\\N[6]を\n　屈服させろと」\\nw[\\N[1]]",""],["「でも\\N[5]姫だって、直系の子孫ニャわけでしょ？\n　力の綱引きになったら勝てるのニャ？」\\nw[\\N[2]の父]",""],["「そう言われると……\\N[5]姫本人が悪竜\\N[6]でも\n　あるわけだから、こっちが大分不利なような……」\\nw[\\N[2]]",""],["「そこは、地母神の乳でどれだけ能力を活性化できるかに\n　賭かっているとしか――」\\nw[伝承学者]",""],["「他に案がないなら、それで行くしかないだろ。\n　ダメだったら、そのときまた考えりゃいいんだよ」\\nw[\\N[1]]",""],["「羨ましい性格ニャー」\\nw[\\N[2]の父]",""],["「そうだ、『迷いの森』へ行くなら、\\C[17]生贄\\C[0]を用意して\n　おかないとダメだぞ」\\nw[伝承学者]",""],["「いっ、いけにえ！？」\\nw[\\N[2]]",""],["「これも伝承にあるのだが、迷いの森の最深部へ行くには、\n　この地の先住民である\\C[17]猫人\\C[0]を生贄として捧げる必要がある\n　のだそうだ。\\nw[伝承学者]",""],["「それも種族として最も純血種に近い、\\C[17]茶色髪の猫人\\C[0]を\n　捧げるべきだと」\\nw[伝承学者]",""],["「なんだ、じゃあ\\N[2]じゃダメなのか」\\nw[\\N[1]]",""],["「わたしでもＯＫだったら生贄にするんですか！？\n　ひどい！」\\nw[\\N[2]]",""],["「なら、そこは奴隷で用意するとして」\\nw[\\N[1]]",""],["「必要なら、躊躇なく奴隷を生贄にしちゃうのニャ。\n　そういうとこ、\\N[5]姫との血のつながりを感じる\n　のニャ」\\nw[\\N[2]の父]",""],["「フンッ！　一緒にするな。\n　俺は好き好んで、残虐な真似なんかしないぞ」\\nw[\\N[1]]",""],["「ん？　なんか店の外が騒がしくないか？」\\nw[\\N[1]]",""],["「酔っぱらいがケンカでもしてるんじゃニャいかな？」\\nw[\\N[2]の父]",""],["「な、なに？\n　兵隊さんがウチみたいな店になんのご用？」\\nw[マスター]",""],["「我々は王都近衛隊である！\\nw[近衛兵]",""],["「この店に、反逆者パルフューク大公の協力者が匿われて\n　いるとの情報が寄せられた！\\nw[近衛兵]",""],["「よって、これより強制捜査を行う！\n　全員その場から動かぬように！」\\nw[近衛兵]",""],["「こ、これってもしかして、わたしたちのこと\n　探してるんじゃ！？」\\nw[\\N[2]]",""],["「だろうな。\n　\\N[5]の差し金に違いない」\\nw[\\N[1]]",""],["「二人とも、裏口から逃げるニャ！」\\nw[\\N[2]の父]",""],["「ここで捕まっては\\N[6]の思う壺だぞ。\n　さあ、早く！」」\\nw[伝承学者]",""],["「わかった。じゃあな！」\\nw[\\N[1]]",""],["「父さん、また後でね！」\\nw[\\N[2]]",""],["ユマ",""],["ユマ父2",""],["「\\N[2]、気をつけて行動するんにゃよ？」\\nw[\\N[2]の父]",""],["「\\N[2]ッ、おかえりニャン！\n　父さん心配だったニャ！」\\nw[\\N[2]の父]",""],["「う、うん……大変だったけど、わたしは大丈夫だよ」\\nw[\\N[2]]",""],["「……どうやらまだ、今の父さんに抵抗があるようだニャ？\\nw[\\N[2]の父]",""],["「それならいっそ、母さんと呼んでも――」\\nw[\\N[2]の父]",""],["\\>「絶対よばない」\\nw[\\N[2]]",""],["「それでミニャニャちゃんよ、こっちは収穫があったん\n　だが、そっちはどうだ？　進展はあったか？」\\nw[\\N[1]]",""],["「そうそう、話さなきゃならないことがあるニャ！\\nw[\\N[2]の父]",""],["「まず、私たちをハメたあの商会だけど、王都や副都を\n　中心にどんどん商売の手を広げていってるニャ！\\nw[\\N[2]の父]",""],["「あきらかに不自然な成長っぷりで、経営努力だけじゃ\n　説明がつかないニャ」\\nw[\\N[2]の父]",""],["「\\N[3]に指示を出してる王族の誰かが、裏から援助を？」\\nw[\\N[2]]",""],["「おそらくな。\\nw[\\N[1]]",""],["「だがメスガキが竜の鉤爪をひとつしか入手できなかった\n　と知れば、その援助もいつまで続くか。見ものだな」\\nw[\\N[1]]",""],["「そうニャ！　竜の鉤爪についてもひとつ、いい知らせ\n　があるニャ！\\nw[\\N[2]の父]",""],["「私が前に会った、鉤爪について調査してるっていう\n　伝承学者にゃんだけど、彼の居所が分かったのニャ！」\\nw[\\N[2]の父]",""],["「大神殿の書庫に入れてもらえない、って愚痴ってたって\n　いう学者か？」\\nw[\\N[1]]",""],["「その学者先生ニャ。\n　彼はいま、この王都の近くにある\\C[17]地下遺跡の最深部\\C[0]で、\n　発掘作業をしているらしいニャ」\\nw[\\N[2]の父]",""],["「その学者の人に竜の鉤爪と粘土板を見せれば、なにか\n　分かるかもしれませんね」\\nw[\\N[2]]",""],["「ああ、地下遺跡に行ってみるか」\\nw[\\N[1]]",""],["「でもいきなり訪ねて質問しても、親切に答えてくれる\n　とは限らないニャ。\\nw[\\N[2]の父]",""],["「あの学者先生はケチだから。\n　手土産くらい持って行った方がいいと思うニャ」\\nw[\\N[2]の父]",""],["「手土産って……お菓子の詰め合わせとか？」\\nw[\\N[2]]",""],["「奴隷商人なんだから、労働用の奴隷とかどうニャ？\\nw[\\N[2]の父]",""],["「発掘作業は重労働で、奴隷を何人も使うそうだから、\n　きっと喜ばれるニャ」\\nw[\\N[2]の父]",""],["「それなら\\C[17]肉体労働用の奴隷\\C[0]を\\C[17]３人\\C[0]ばかり連れていくか」\\nw[\\N[1]]",""],["「３人とは太っ腹ニャ！\n　それならあのケチンボな学者先生も、口が緩むニャ」\\nw[\\N[2]の父]",""],["\\>　※　\\C[17]肉体労働用の奴隷を３人\\C[0]用意して、地下遺跡の　※\n\\>　※　最深部にいる伝承学者を訪ねよう。　　　　　　※\\<",""],["「学者先生は地下遺跡の最深部にいるニャ。\n　モンスターの出没する場所だから、気をつけるニャよ？」\\nw[\\N[2]の父]",""],["「おかえりニャ。\n　伝承学者の先生には会えたかニャ？」\\nw[\\N[2]の父]",""],["「それについてなんだが……。\n　どこか人のいないところで話せるか？」\\nw[\\N[1]]",""],["「別にここでも、誰も聞いてニャいと思うけど？」\\nw[\\N[2]の父]",""],["「用心のためだ」\\nw[\\N[1]]",""],["「じゃあ、店の倉庫の方に行くニャ」\\nw[\\N[2]の父]",""],["「急いで副都へ行く？\n　なんだか分からニャいけど、無理はしちゃダメにゃよ？」\\nw[\\N[2]の父]",""],["「罠かもしれニャいから、くれぐれも気をつけるんニャよ？」\\nw[\\N[2]の父]",""],["「鉤爪を捨てに行く！？\n　……わかったニャ、必ず無事に帰ってくるんニャよ？」\\nw[\\N[2]の父]",""],["「無事に戻ってきてくれたのは嬉しいけど……\n　なんでアルテトが復活したなんて話になってるニャ！？」\\nw[\\N[2]の父]",""],["「色々とあったんだよ！\n　ここじゃアレだから、説明は別室でするぞ」\\nw[\\N[1]]",""],["「だったらついでに、キミを訪ねてきたお客さんも\n　紹介するニャ」\\nw[\\N[2]の父]",""],["「俺に客だと？」\\nw[\\N[1]]",""],["「まさか、また刺客じゃ？」\\nw[\\N[2]]",""],["「それは無いから安心していいニャ」\\nw[\\N[2]の父]",""],["客1",""],["「くっそぉー！　ミニャニャちゃん戻ってきてくれぇ！」\\nw[客]",""],["「ミニャニャちゃん、まじ天使。\n　無精ひげ生えてるけど」\\nw[客]",""],["客2",""],["「ミニャニャちゃんがいないなんて！\n　この店での楽しみが半減……いや九割減だよ！」\\nw[客]",""],["「ミニャニャちゃんはみんなの愚痴を、嫌な顔ひとつ\n　しないで聞いてくれるんだ」\\nw[客]",""],["料理1",""],["料理2",""],["客3",""],["「副都には知り合いがいるんだが、無事だろうか……」\\nw[客]",""],["「ここはいい店だよ。\n　貧民街にあるのに、ぼったくりもしないし」\\nw[客]",""],["客4",""],["「副都はモンスターとの戦闘で、かなりの兵力を失った\n　らしいね」\\nw[客]",""],["「女の子のいる店より、こういうところの方が\n　なんだかくつろげるんだよね」\\nw[客]",""],["客5",""],["「ミニャニャちゃん、お店やめちゃったんだって？\n　ちょっと残念だなぁ」\\nw[客]",""],["「王都にもアルテトが来るなら、その前にさっさと\n　地方へ逃げるかな」\\nw[客]",""],["「ミニャニャちゃんって、前に取り引きのあった商会の\n　経営者に似てるんだけど……まさかね」\\nw[客]",""],["客6",""],["「長く平穏な時が続いてきたが、そろそろ動乱の時代が\n　くるのかもな」\\nw[客]",""],["「この店はお気に入りでな、週に一度は飲みに来ているよ」\\nw[客]",""],["料理3",""],["料理4",""],["メイド",""],["伝承学者",""],["近衛隊兵士1",""],["近衛隊兵士2",""],["近衛隊兵士3",""],["裏口",""],["手紙",""]],"context":[["Map301/events/1/name"],["Map301/events/2/name"],["Map301/events/3/name"],["Map301/events/3/pages/0/list/1/message/noPicture/bottom","Map301/events/3/pages/1/list/1/message/noPicture/bottom","Map301/events/3/pages/2/list/1/message/noPicture/bottom"],["Map301/events/3/pages/0/list/7/message/noPicture/bottom","Map301/events/3/pages/2/list/7/message/noPicture/bottom"],["Map301/events/3/pages/1/list/7/message/noPicture/bottom"],["Map301/events/4/name"],["Map301/events/4/pages/0/list/48/message/noPicture/bottom"],["Map301/events/4/pages/0/list/62/message/noPicture/bottom"],["Map301/events/4/pages/0/list/69/message/noPicture/bottom"],["Map301/events/4/pages/0/list/73/message/noPicture/bottom"],["Map301/events/4/pages/0/list/77/message/noPicture/bottom"],["Map301/events/4/pages/0/list/79/message/noPicture/bottom"],["Map301/events/4/pages/0/list/82/message/noPicture/bottom"],["Map301/events/4/pages/0/list/88/message/noPicture/bottom"],["Map301/events/4/pages/0/list/96/message/noPicture/bottom"],["Map301/events/4/pages/0/list/99/message/noPicture/bottom"],["Map301/events/4/pages/0/list/111/message/noPicture/bottom"],["Map301/events/4/pages/0/list/116/message/noPicture/bottom"],["Map301/events/4/pages/0/list/124/message/noPicture/bottom"],["Map301/events/4/pages/0/list/133/message/noPicture/bottom"],["Map301/events/4/pages/0/list/141/message/noPicture/bottom"],[