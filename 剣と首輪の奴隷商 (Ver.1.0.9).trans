0,"headerParam":["試合の進行度別に、敵との戦闘を実行"]}],[{"headerIndex":0,"headerParam":["試合に勝利したとき"]}],[{"headerIndex":10,"headerParam":["",0,0,1]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["エルラと賭けをしないまま全試合終了してしまった場合"]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["全試合勝利後"]}],[{"headerIndex":60,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":71,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["試合に負けたとき"]}],[{"headerIndex":7,"headerParam":["",0,0,1]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":22,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"試合開始イベント":5,"\n　　　　　　　\\{特別試合　開始！！\\}":6,"\n　　　　　　　\\{第\\v[1]試合　開始！！\\}":7,"賭け実施時のHP/MP半減処理":8,"どこからともなく飛んできた魔法によって、\\C[18]ＨＰとＭＰが\n半分\\C[0]になってしまった！":9,"試合の進行度別に、敵との戦闘を実行":10,"試合に勝利したとき":11,"\n　　　　　　　\\C[17]※　試合に勝利した！！　※\\C[0]":12,"特別試合に勝利した！！\nやっぱりあなたがこの闘技場の\\C[17]『王者』\\C[0]だ！！":13,"エルラと賭けをしないまま全試合終了してしまった場合":14,"全ての試合に勝利した！！\nあなたがこの闘技場の\\{\\C[17]『王者』\\C[0]\\}だ！！":15,"全試合勝利後":16,"\\{「すげぇぞーッ！　新チャンピオン！！」\\}\\nw[観客]":17,"\\{「かっこいいッ！　ステキィッ！！」\\}\\nw[観客]":18,"このまま次の試合を行いますか？":19,"試合を続ける":20,"試合を続けない":21,"実績 30":22,"試合に負けたとき":23,"\n　　　　　※　試合に負けてしまった……　※":24,"闘技場敵":25,"観客（貴族）":26,"観客":27,"「悪竜との試合も、ここで見てみたいもんだぜ！\n　がはははっ！！」\\nw[観客男性]":28,"「おっ！？　チャンピオンじゃねぇか！\n　あんたの戦い最高だぜ！！」\\nw[観客男性]":29,"「剣闘は、血湧き肉躍る最高のエンターテイメントだぜ！」\\nw[観客男性]":30,"「あんた、闘技場のチャンピオンらしいな？\n　だがオレに言わせれば、所詮は猿山の大将だ」\\nw[冒険者]":31,"「所詮は見世物だな。\n　ダンジョンでの本物の死闘に比べれば、児戯に等しい」\\nw[冒険者]":32,"「いずれこういった戦いが、王都の市街で繰り広げられる\n　かもしれん。備えなければな」\\nw[冒険者]":33,"「ほう、チャンピオンに会えるとは思わなかった。\n　あなたの戦い方は常道から外れているが、そこがいい」\\nw[冒険者]":34,"「質の高い戦いを見ることもまた、訓練のひとつだ」\\nw[冒険者]":35,"「ぬぅ～。前の人が邪魔でよく見えない～」\\nw[観客女性]":36,"「くそっ、もう９連続で外してるんだ。\n　次こそは絶対に当てる！」\\nw[観客男性]":37,"「もうちょっと早く来れば良かった。\n　今からじゃ、いい席で見れないなぁ……」\\nw[観客男性]":38,"「とにかく見てごらんよ。絶対に面白いから！」\\nw[観客男性]":39,"「わたし、あんまりこういうの好きじゃないんだけど」\\nw[観客女性]":40,"「いけえぇっ！　斬れ！　刺せ！\n　そこだっ！　必殺技だああぁっ！！」\\nw[観客男性]":41,"BGS":42,"観戦ポイント":43,"試合を観戦しますか？":44,"観戦する":45,"観戦しない":46,"「やってる、やってる。\n　どうやら人気の剣闘士の試合らしいな」\\nw[\\N[1]]":47,"「すごく激しいですね……。\n　うわっ、危ない！」\\nw[\\N[2]]":48,"「剣闘士には奴隷も多いが、職業としてやってるヤツや\n　腕試しの冒険者なんかも結構出てるそうだ」\\nw[\\N[1]]":49,"「奴隷でもないのに、わざわざこんな所で戦うなんて\n　気が知れませんよ」\\nw[\\N[2]]":50,"「俺たちも剣闘士の端くれになったんだ。\n　参考に他人の試合を見ておくか」\\nw[\\N[1]]":51,"「わたしは剣闘なんて、まったくこれっぽちも\n　やりたくないんですけど……」\\nw[\\N[2]]":52,"「そう言うな。戦闘訓練として丁度いいんだから」\\nw[\\N[1]]":53,"「商人が戦闘訓練すること自体、おかしいと思いません？\n　……って今更言ってもムダですよね」\\nw[\\N[2]]":54,"剣闘士（デモ）":55,"モンスター（デモ）":56,"剣闘デモンストレーション":57,"EV216":58,"指名手配されているので、外へ出るわけにはいかない。":59},"extension":"json","dataType":"map","filename":"Map217","basename":"Map217.json","path":"data/Map217.json","relPath":"data/Map217.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":60,"percent":0},"cellInfo":[]},"data/Map218.json":{"data":[["宝箱（お金）",""],["まだ開けられません。",""],["↓ここに金額を入力",""],["イージー",""],["\\C[17]「\\v[1]Ｇ」\\C[0]を入手した！",""],["係員",""],["「こちらでは、剣闘試合の賞品をお渡ししております。\n　試合に勝つごとに、開けられる宝箱が増えていきます\n　ので、ぜひ頑張ってください」\\nw[係員]",""],["宝箱check",""],["EV026",""],["EV027",""],["宝箱（装飾品）",""],["※\n装飾品：剛力の腕輪\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓防具のIDNo.を変数に入力する",""],["↓防具の入手個数を変数に入力する",""],["↓防具の重量を変数に入力する",""],["※\n装飾品：熟練者の手袋\n※",""],["※\n装飾品：馬鹿力の腕輪\n※",""],["※\n装飾品：精霊水晶\n※",""],["宝箱（防具）",""],["※\n防具：火炎の革鎧\n※",""],["燭台",""],["光",""],["※\n防具：薔薇のマスク\n※",""],["※\n防具：蒸気の盾\n※",""],["※\n防具：ビキニ鎧\n※",""],["↓ビキニ鎧種類チェック",""],["宝箱（武器）",""],["※\n武器：脇差\n※",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["※\n武器：獅子の戦斧\n※",""],["※\n武器：ファルシオン\n※",""],["※\n武器：フェイルノート\n※",""],["※\n装飾品：隊長の徽章\n※",""],["※\n装飾品：将軍の徽章\n※",""],["※\n防具：鳳凰の鎧\n※",""],["宝箱（鍵）",""],["※\nアイテム：神々の宝蔵の鍵\n※",""]],"context":[["Map218/events/1/name","Map218/events/23/name","Map218/events/24/name","Map218/events/25/name"],["Map218/events/1/pages/0/list/0/message/noPicture/bottom","Map218/events/23/pages/0/list/0/message/noPicture/bottom","Map218/events/24/pages/0/list/0/message/noPicture/bottom","Map218/events/25/pages/0/list/0/message/noPicture/bottom","Map218/events/28/pages/0/list/0/message/noPicture/bottom","Map218/events/29/pages/0/list/0/message/noPicture/bottom","Map218/events/30/pages/0/list/0/message/noPicture/bottom","Map218/events/31/pages/0/list/0/message/noPicture/bottom","Map218/events/32/pages/0/list/0/message/noPicture/bottom","Map218/events/39/pages/0/list/0/message/noPicture/bottom","Map218/events/40/pages/0/list/0/message/noPicture/bottom","Map218/events/41/pages/0/list/0/message/noPicture/bottom","Map218/events/42/pages/0/list/0/message/noPicture/bottom","Map218/events/43/pages/0/list/0/message/noPicture/bottom","Map218/events/44/pages/0/list/0/message/noPicture/bottom","Map218/events/45/pages/0/list/0/message/noPicture/bottom","Map218/events/46/pages/0/list/0/message/noPicture/bottom","Map218/events/47/pa