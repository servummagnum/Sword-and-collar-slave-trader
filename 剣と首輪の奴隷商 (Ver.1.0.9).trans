ntext":[]}}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"attachment":"scriptCommand/16944098097995184.js","start":0,"end":4,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098097994522.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["夜間用ＢＧＭ演奏"]}],[{"headerIndex":1,"headerParam":["夜→昼"]}],null,[{"headerIndex":12,"headerParam":["最初から昼"]}],[{"headerIndex":1,"headerParam":["昼→夜"]}],[{"headerIndex":12,"headerParam":["最初から夜"]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":23,"headerParam":["",0,0,2]}],[{"headerIndex":31,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":46,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,[{"headerIndex":11,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":28,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}]],"indexIds":{"武器屋入り口":0,"宿屋":1,"雑貨店":2,"EV003":3,"EV004":4,"EV005":5,"EV006":6,"EV007":7,"EV008":8,"EV009":9,"EV010":10,"clear_all_weathers":11,"通行防止":12,"EV013":13,"EV014":14,"EV015":15,"EV016":16,"EV017":17,"EV018":18,"EV019":19,"EV020":20,"EV021":21,"個別依頼21":22,"族長の愛人探し":23,"「我々、砂漠に暮らす民のあいだで、一夫多妻の家庭は\n　ごく当たり前のものだ。\\nw[砂漠の民]":24,"「族長ともなれば、１０人を超える数の妻や愛人を囲って\n　いて当然というもの」\\nw[砂漠の民]":25,"「まさにハーレムだな。羨ましいもんだ」\\nw[\\N[1]]":26,"「その族長が、普通の女は飽きたと言って、私に新しい\n　愛人の調達を命じたのだ。\\nw[砂漠の民]":27,"「奴隷商人よ、ひとつ我らが族長のために普通でない\n　女を用意してもらえんか？」\\nw[砂漠の民]":28,"「普通でない、って言ってもなぁ……」\\nw[\\N[1]]":29,"「亜人がいいんでしょうか？\n　例えば\\C[17]鬼\\C[0]とか――」\\nw[\\N[2]]":30,"「ほう、鬼とな……？\n　それは中々、普通でなくて良さそうだ！\\nw[砂漠の民]":31,"「ならば鬼の奴隷を頼もう。\n　それと\\C[17]胸は小さめ\\C[0]でお願いしたい。\\nw[砂漠の民]":32,"「小さめ？　なんでだ？」\\nw[\\N[1]]":33,"「族長の周囲は胸の大きい女性ばかりなのでな」\\nw[砂漠の民]":34,"「貧乳が“普通でない”ってわけか」\\nw[\\N[1]]":35,"「そちらの王国の貨幣はあまり持っておらんので、\n　代金の代わりに\\C[17]\\in[19]４個\\C[0]で取り引きしてくれ」\\nw[砂漠の民]":36,"個別依頼『族長の愛人探し』を受けますか？":37,"受ける":38,"受けない":39,"火の洞窟・地下2層":40,"鬼の隠れ家":41,"個別依頼\\C[17]『族長の愛人探し』\\C[0]を受けた！":42,"\\C[17]『\\in[133]』\\C[0]を依頼者に渡しますか？":43,"渡す":44,"渡さない":45,"依頼条件達成":46,"「こいつが頼まれてた鬼の奴隷だ。\n　あんたの族長様のお眼鏡にかないそうか？」\\nw[\\N[1]]":47,"「これが鬼……初めて見たが本当に角があるとは……。\n　うむ、これなら族長も満足されるだろう。\\nw[砂漠の民]":48,"「手間をかけさせたな、奴隷商人。\n　礼を言うぞ」\\nw[砂漠の民]":49,"個別依頼\\C[17]『族長の愛人探し』\\C[0]を達成した！":50,"\nここでエッチイベント\n↓　　↓　　↓":51,"↓プレーヤー位置強制中央":52,"SFC_ENABLE_RESERVE":53,"依頼条件未達成":54,"「族長の命令を果たせないと一族の中でまずい立場に\n　なってしまうのだ。\n　鬼奴隷の件、くれぐれもよろしく頼むぞ」\\nw[砂漠の民]":55,"掲示板マーク":56,"奴隷買い取り（フキダシ）":57,"村人（奴隷買い取り）":58,"砂漠の住民":59,"「この水が尽きない限り、サンドボウは栄え続けるさ」\\nw[オアシスの民]":60,"「ここには隊商がさまざまな交易品を運んでくる。\n　中にはわけの分からんものもあるな」\\nw[オアシスの民]":61,"「武器商ギルドは、いまや落日の様相を呈してるって\n　いうじゃないか。\n　支払いは本当に大丈夫なんだろうな？」\\nw[砂漠の商人]":62,"「おいおい、それっぽっちの値段じゃ売れねぇぜ」\\nw[砂漠の商人]":63,"商人":64,"「た、たしかに僕は武器商ギルドの会員だけど、心配は\n　いらんさ！　ギルドはびくともしてないよ、ハハッ！」\\nw[王国の商人]":65,"「ちょっと待ってくれ！\n　頼むからこれくらいで売ってくれないか？」\\nw[王国の商人]":66,"テント入り口":67,"テント":68,"「ときどきね、すっごい砂嵐がくるんだよ。\n　家のなかにいないと飛ばされちゃうの」\\nw[女の子]":69,"「今回もいい取り引きができたわ。\n　出所がわからない商品でもいいから、また持ってきて\n　くださいな」\\nw[女商人]":70,"「あなたとの取り引きでは、いつも儲けさせてもらって\n　ますからね。\n　次もおねがいしますよ」\\nw[王国商人]":71,"「太古の昔、この砂漠にも文明が栄えていたらしいけど、\n　どうして滅びちゃったのかしらね」\\nw[オアシスの民]":72,"ラクダ":73,"民家":74,"「ラクダはねぇ、赤ちゃんのときにはコブがないんだよ」\\nw[女の子]":75,"ＢＧＭ変更":76,"夜間用ＢＧＭ演奏":77,"夜→昼":78,"weather : 0 : 21 : 15 : 100 : 1 : SunLight_01B":79,"最初から昼":80,"昼→夜":81,"最初から夜":82,"屋外トイレドア（排泄Ev）":83,"<TE:80>":84,"トイレマーク":85,"落ちてる精霊石（街）":86,"「砂漠から出てくる\\in[364]って、重くて役にも立たない\n　のに、北の王国じゃ高級インテリアとして人気なんで\n　すって」\\nw[女性]":87,"街ズームアウト":88,"P_D_FILENAME name_town\\V[101]":89,"「こんな砂漠の真ん中に、水と緑が！？」\\nw[\\N[2]]":90,"「これほどたくさんの水が湧いているオアシスは、他には\n　ないそうだ。\n　だから隊商が集まってくる」\\nw[\\N[1]]":91,"「南から隊商が運んできた商品は、ここを通って王国に\n　向かうんですね。へぇ～、すごいなぁ」\\nw[\\N[2]]":92,"「王国の奴隷も、このオアシスから南方諸国に売られて\n　いくんだぞ。\\nw[\\N[1]]":93,"「ひとつ間違えば、お前も今頃ここから南へ向かって\n　いたかもな」\\nw[\\N[1]]":94,"「ちょっとぉ……嫌なこと思い出させないでくださいよぉ」\\nw[\\N[2]]":95,"陽射し表示用":96,"通行不可スイッチ":97,"通行不可":98,"通行不可2スイッチ":99,"通行不可2":100,"マップ取得":101,"FocusCamera 22 19 120":102,"ZoomOut 2.5 120":103,"\\C[17]\\V[920]の地図\\C[0]を取得した！":104,"ResetZoom 60":105,"ResetFocus 60":106,"街中イーグルダイブ":107,"ここから飛び降りますか？":108,"飛び降りる":109,"やめる":110,"藁山":111,"フクロウ":112,"「王国は王様の死や怪物騒ぎで大変だったそうだな。\n　ま、オレにはどうでもいいことだが」\\nw[砂漠の商人]":113,"「あんたらも王国の商人かい？\n　言っとくが、ここでの値段交渉はシビアだぜ」\\nw[砂漠の商人]":114},"extension":"json","dataType":"map","filename":"Map060","basename":"Map060.json","path":"data/Map060.json","relPath":"data/Map060.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":115,"percent":0},"cellInfo":[]},"data/Map061.json":{"data":[["EV001",""],["宿屋",""],["EV002",""],["醸造所",""],["EV003",""],["雑貨店",""],["EV004",""],["clear_all_weathers",""],["disable_footsteps",""],["EV005",""],["個別依頼22",""],["娯楽用奴隷",""],["「ここは雪に閉ざされる時間が長すぎて、しかも娯楽って\n　ものがほとんど無いんだ。\\nw[里の男]",""],["「冬のあいだは暇で暇で、ほんとうにウンザリするよ」\\nw[里の男]",""],["「田舎の娯楽っていったら、酒と博打と、あとはベッドで\n　嫁さんとズッコンバッコンやるくらいか？」\\nw[\\N[1]]",""],["「エッチは最高の娯楽ですもんね\\I[29]」\\nw[\\N[2]]",""],["「言い方が下品ですよ！　もうっ！」\\nw[\\N[2]]",""],["「いや、まさにその通りなんだ！\n　だから俺たち里の男は考えた。\\nw[里の男]",""],["「数少ない娯楽であるセックスを、もっと楽しめるように\n　しようと！」\\nw[里の男]",""],["「と、言いますと？」\\nw[\\N[2]]",""],["「はぁ？」\\nw[\\N[2]]",""],["「みんなで相談して、共用の性奴隷を買うことにしたのさ！\\nw[里の男]",""],["「そうすれば未婚でも恋人がいなくても、ズッコンバッコン\n　やり放題だろ！」\\nw[里の男]",""],["「そういうことか、話は分かった。\n　しかしどんな女がいいんだ？」\\nw[\\N[1]]",""],["「\\C[17]エルフ\\C[0]がいい！\n　美人エルフの噂はよく聞くから、みんな一度はヤッて\n　みたいって夢見てるんだ！」\\nw[里の男]",""],["「たしかにエルフって綺麗な人が多いですもんね\\I[29]」\\nw[\\N[2]]",""],["「不美人がいないわけじゃないけどな。\\nw[\\N[1]]",""],["「クソみたいな夢ですね」\\nw[\\N[2]]",""],["「言い方が下品だぞ、\\N[2]。\\nw[\\N[1]]",""],["「それで、エルフって以外に要望はあるか？」\\nw[\\N[1]]",""],["「\\C[17]胸はでかい\\C[0]方がいいな。\n　それと生白い女は見飽きてるんで、ハイエルフよりも\n　\\C[17]ダークエルフ\\C[0]がいい。\\nw[里の男]",""],["「ただ、金はあんまり無いんで……みんなから集めた\n　\\C[17]８０００Ｇ\\C[0]と、この\\C[17]\\in[51]\\C[0]でどうにかならない\n　かな？」\\nw[里の男]",""],["個別依頼『娯楽用奴隷』を受けますか？",""],["受ける",""],["受けない",""],["火の洞窟・地下4層",""],["ダークエルフの森",""],["個別依頼\\C[17]『娯楽用奴隷』\\C[0]を受けた！",""],["\\C[17]『\\in[131]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「欲しがってた巨乳エルフ奴隷、用意してやったぞ」\\nw[\\N[1]]",""],["「すごい！　モノホンのエルフだ！\n　これから毎日、この娘をズッコンバッコンできるなんて\n　夢のようだ！\\nw[里の男]",""],["「ありがとう！　奴隷商人さん！」\\nw[里の男]",""],["個別依頼\\C[17]『娯楽用奴隷』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「男たちみんなが期待と股間をふくらませて待ってるんで、\n　巨乳ダークエルフの奴隷お願いしますよ！」\\nw[里の男]",""],["依頼マーク",""],["村人（奴隷買い取り）",""],["奴隷買い取り（フキダシ）",""],["村人",""],["「しまった！\n　このままだと薪が足りなくなるぞ！」\\nw[村人]",""],["「この里の特産品の雪中酒は、一度飲んだらやみつきに\n　なるわよぉ」\\nw[村人]",""],["男の子",""],["「さっき、あっちの方にオオカミがいたんだ！\n　すぐにいなくなっちゃったけど」\\nw[男の子]",""],["「村の特産品を買いたきゃ、そこの雑貨屋に行きな」\\nw[村人]",""],["「あぁっ、もうっ！　冷たい！　寒い！\n　雪なんてダイッキライ！！」\\nw[村娘]",""],["EV015",""],["民家",""],["EV016",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["屋外トイレドア（排泄Ev）",""],["<TE:80>",""],["トイレマーク",""],["落ちてる精霊石（街）",""],["「雪原の南の方には\\C[17]氷雪の神殿\\C[0]があるけど、村では昔から\n　絶対に近づいてはならないって言われてるんだ。\n　何人もの冒険者が挑んでは、バタバタ死んでるらしい」\\nw[村人]",""],["街ズームアウト",""],["P_D_FILENAME name_town\\V[101]",""],["「あぁ、寒いぃ～。\n　よくこんな場所に人が住んでられますね」\\nw[\\N[2]]",""],["「ただ雪深いだけなら人も集まらんだろうが、ここには\n　この地でしか採れないものや作れないものがあるからな」\\nw[\\N[1]]",""],["「氷雪の里の特産品ですか？」\\nw[\\N[2]]",""],["「ああ、そうだ。\n　あと、意外と奴隷の需要も多いそうだぞ」\\nw[\\N[1]]",""],["通行不可",""],["雪山",""],["フクロウ",""],["disable_footstep",""],["マップ取得",""],["FocusCamera 20 17 120",""],["ZoomOut 2.5 120",""],["\\C[17]\\V[921]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["weather : 0 : 9 : 20 : 70 : 0 : Snow_01",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["通行不可スイッチ",""]],"context":[["Map061/events/1/name"],["Map061/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map061/events/2/name"],["Map061/events/2