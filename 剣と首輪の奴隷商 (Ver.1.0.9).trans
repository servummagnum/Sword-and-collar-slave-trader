ex":332,"headerParam":["",0,0,2]}],[{"headerIndex":337,"headerParam":["",0,0,2]}],[{"headerIndex":342,"headerParam":["",0,0,2]}],[{"headerIndex":360,"headerParam":["↑　　↑　　↑"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":12,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098106495238.js","start":0,"end":5,"leftHand":{"type":"","context":[]}}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}]],"indexIds":{"展示モンスター1":0,"展示モンスター2":1,"展示モンスター3":2,"展示モンスター4":3,"注意書き":4,"『\\C[18]※注意※\\C[0]\n　檻をつかまないでください。\n　展示モンスターに指を食い千切られる危険があります』":5,"燭台":6,"光":7,"EV024":8,"指名手配されているので、外へ出るわけにはいかない。":9,"EV025":10,"EV026":11,"EV031":12,"EV032":13,"係員":14,"「ここはＶＩＰ専用の入り口となっておりますので、\n　申し訳ありませんがご遠慮ください」\\nw[係員]":15,"売店員":16,"「えー、お酒におつまみ、いかがですかー？\n　観戦のお供におひとつどうぞー」\\nw[売店員]":17,"観戦客":18,"「こいつらは恐ろしいバケモンだけど、アルテトは\n　それ以上の怪物なんだよな……」\\nw[観戦客]":19,"「あのモンスターに犯されてた女の子……すごかったなぁ！\n　思い出すたびに股間がエレクトしちまうよ！」\\nw[観戦客]":20,"「こんな化け物と戦うなんて、ゾッとするぜ。\n　まあそれを観に来たんだけどな」\\nw[観戦客]":21,"「注目の剣闘士といえば、やはり“滅多突きのゲラン”\n　だろう」\\nw[観戦客]":22,"「なにやら腕っぷしの強い商人が、剣闘士として試合に\n　出ているらしいぞ」\\nw[観戦客]":23,"「例の商人剣闘士、快進撃が続いているらしいな。\n　こいつは要チェックだ」\\nw[観戦客]":24,"「チャンピオン・\\N[1]！\n　キミの戦いは実にエキサイティングだ！」\\nw[観戦客]":25,"「商人剣闘士\\N[1]！\n　私はすっかり彼のファンになってしまったよ。\n　……って本人！？」\\nw[観戦客]":26,"「ひとつ賭けをしないかね？\n　悪竜が王都まで来るかどうか、という内容で。\n　私は来ると睨んでいるよ」\\nw[観戦客]":27,"「僕が思うに、一番注目すべき剣闘士はグールをやすやすと\n　倒したあの“戦斧のトード”ですよ」\\nw[観戦客]":28,"「商人が新人剣闘士として出場している？\n　ふんっ、“戦斧のトード”と比べたら大したこと\n　ありませんよ」\\nw[観戦客]":29,"「なるほど、確かに噂の商人剣闘士は頑張っているようだ。\n　しかし、ボロが出るのも時間の問題でしょう」\\nw[観戦客]":30,"「私の一押し剣闘士“戦斧のトード”ですら敵わなかった\n　モンスターを倒すとは……。\n　確かにあんたがチャンピオンだ！」\\nw[観戦客]":31,"「\\N[1]なる商人剣闘士……\n　予想外に活躍しているようですね。\n　でもまさか“戦斧のトード”より強いなんてことは……」\\nw[観戦客]":32,"「私は王都にアルテトが来ることはないと思って\n　いますよ。その前に軍が退治するでしょう」\\nw[観戦客]":33,"「ここのメシは高い割りにいまいちだけど、料理店じゃ\n　ないから仕方ないか……」\\nw[観戦客]":34,"「噂は噂よ、悪竜復活だなんてバカバカしい。\n　それより注目の剣闘士の話をしましょ！」\\nw[観戦客]":35,"「亭主が働いてるあいだに、お酒飲んで剣闘観戦……\n　サイッコーね！」\\nw[観戦客]":36,"「悪竜やモンスターが来るかもしれないのに、\n　剣闘試合なんて見てていいのかって、不安になるわ」\\nw[観戦客]":37,"「わたしも亭主が仕事へ行ってるあいだに来たんだけど、\n　今月分の食費を半分以上スッちゃって……どうしよう」\\nw[観戦客]":38,"「ここに出場する剣闘士たち全員でかかれば、悪竜の\n　一匹くらい倒せるんじゃないかね？」\\nw[観戦客]":39,"「４０年間、この闘技場で賭け続けてきたワシの収支を\n　教えてやろうか？\\nw[観戦客]":40,"「＋１００Ｇじゃよ！」\\nw[観戦客]":41,"「データさえあれば、悪竜が王都を襲う確率を弾き出せる\n　のだがね」\\nw[観戦客]":42,"「統計学を駆使して、理論的に賭けていけば、\n　必ず儲けを出すことができるのだよ。\\nw[観戦客]":43,"「統計データがないので、いますぐは無理だけどね！」\\nw[観戦客]":44,"「悪竜と戦うより、ここでモンスターを相手にする方が\n　簡単なはず……でもやっぱり怖いなぁ……」\\nw[冒険者]":45,"「腕試しに出場してみるべきか……。\n　でもこんなところで大怪我でもしちゃったら……」\\nw[冒険者]":46,"「こいつったら、いっつもこんな調子で決断できないの。\n　そんなだから三流冒険者のままなのよ？」\\nw[冒険者]":47,"剣闘士":48,"「俺はやれば出来る子だ……そうだ、アルテトと戦う\n　わけじゃないんだ、これくらい簡単簡単……」\\nw[冒険者]":49,"「大丈夫だ……俺はやれば出来る子。\n　俺はやれば出来る子……」\\nw[冒険者]":50,"「本当にアルテトが甦ったのなら、一度戦ってみたい\n　もんだぜ。クククククッ……」\\nw[滅多突きのゲラン]":51,"「よう、チャンピオン。さすがの戦いぶりだったな。\n　だがその座、すぐにオレがいただくぜ」\\nw[滅多突きのゲラン]":52,"「くくっ……自分の戦いが始まるのを待っている\n　この時間、たまんねぇぜ」\\nw[滅多突きのゲラン]":53,"奴隷":54,"「自由の身になる前に、悪竜が襲ってきたりしない\n　だろうな……？　それだけは勘弁してくれよ」\\nw[奴隷剣闘士]":55,"「あと３回……あと３回勝てば、晴れて自由の身に\n　なれるんだ！」\\nw[奴隷剣闘士]":56,"「くそっ、盗賊の仲間なんかになっちまったせいで、\n　こんな羽目に……！　死にたくねぇよぉ……」\\nw[奴隷剣闘士]":57,"「あっ、ダメですよ～。\n　この先は試合出場者しか入れませんので～。\n　出場したいなら、受付へ行ってください～」\\nw[係員]":58,"「闘技場へようこそ！\n　観戦ですか？　それとも出場をご希望で？」\\nw[係員]":59,"観戦したい":60,"出場したい":61,"闘技場のルールについて":62,"やめておく":63,"「観戦は無料ですので、通路右奥の階段から観覧席へ\n　どうぞ」\\nw[係員]":64,"「出場をご希望ですね？\n　では初回登録を行いますので、こちらにサインを……\n　はい、結構です。\\nw[係員]":65,"「闘技場のルールについては、そこにある\\C[17]ルールブック\\C[0]に\n　書いてありますので、一度は目を通してください。\\nw[係員]":66,"「それでは左手奥の剣闘士用出入口へどうぞ。\n　次回からはこちらに声をかけずとも、出場できますよ」\\nw[係員]":67,"闘技場のルール":68,"MWL_行数変更 16":69,"\\>　　　　　　　　　『闘技場のルール』\n\\>\n\\>・戦えるのは主人公か\\N[2]のどちらか一人だけ。\n\\>\n\\>・１試合終わるごとに、そこでやめるか続けるか選択できる。\n\\>　連戦の場合、前の試合のダメージは残ったまま。\n\\>\n\\>・敗北したら剣闘試合は終了。\n\\>　次回は負けた相手との再試合からスタート。\n\\>\n\\>・一試合勝つごとに、賞品がひとつもらえる。\n\\>":70,"MWL_行数リセット":71,"「いらっしゃいませ。\n　観戦ですか？　それとも出場をご希望で？」\\nw[係員]":72,"「すでに出場登録はされているようですね。\n　左手奥の剣闘士用出入口へ、どうぞお進みください」\\nw[係員]":73,"闘技場ルール":74,"「剣闘試合に出場するなら、左奥の出場口へ\n　どうぞ～」\\nw[係員]":75,"係員（剣闘試合へ）":76,"エルラのところへ\\C[17]勝利を報告\\C[0]しに行かなければ。":77,"エルラのところへ\\C[18]敗北を報告\\C[0]しに行かなければ。":78,"全試合勝利後":79,"「新王者のあなたと戦えるような強いモンスターは、\n　すでにおりませんが、\\N[3]様のご要望により特別\n　試合を組ませていただきました」\\nw[係員]":80,"「新王者のあなたと戦えるような強いモンスターは、\n　すでにおりません」\\nw[係員]":81,"↓初回試合が第何試合になるか\n　（例：LV10で初試合なら第八試合（試合進行度7）から）":82,"「剣闘試合に出場しますか？」\n（出場する試合は第\\v[3]試合となります）\\nw[係員]":83,"出場する":84,"出場しない":85,"どちらが出場しますか？":86,"\\N[1]":87,"\\N[2]":88,"「ＨＰを回復されてから出場したほうが良いのでは？」\\nw[係員]":89,"EV056":90,"EV057":91,"「剣闘試合に出場する方は真っすぐ奥へお進みください。\n　賞品の受け渡しはこちらの部屋で行っております」\\nw[係員]":92,"BGS消去":93,"料理1":94,"料理（昼）1":95,"料理（昼）2":96,"冒険者":97,"「悪竜の噂が本当なら、そろそろ王都を離れるべきかも\n　しれんな」\\nw[冒険者]":98,"「夜間の剣闘観戦は楽しいのぅ！\n　酒もうまいわい！」\\nw[冒険者]":99,"「夜間の闘技観戦は楽しいのぅ！\n　酒もうまいわい！」\\nw[冒険者]":100,"老人":101,"「悪竜復活を天罰だと言う者もいるが、そんなわけ\n　あるものか」\\nw[老人]":102,"「また朝帰りで嫁にどやされてしまうが、こればっかりは\n　やめられんのだ」\\nw[老人]":103,"エルラ":104,"これまだ甦った\\N[6]が退治される前の話――。":105,"「げっ！？　\\N[2]とクソ雑魚フード男！\n　なんでこんな所に！」\\nw[\\N[3]]":106,"「そりゃこっちのセリフだ、メスガキ」\\nw[\\N[1]]":107,"「今日は\\N[3]一人なの？\n　あの執事の人がいないみたいだけど？」\\nw[\\N[2]]":108,"「\\N[4]は別の仕事に行ってるのよ。\n　ウチの商会はあんたらと違って暇じゃないんでね！」\\nw[\\N[3]]":109,"「そう言うお前はサボって剣闘観戦か？\n　けっこうなご身分だな」\\nw[\\N[1]]":110,"「はぁ！？　ふざけんじゃないわよ！\n　あたしだって仕事で来てんのよ！\\nw[\\N[3]]":111,"「剣闘試合に使われるモンスターを納品しに来たの！」\\nw[\\N[3]]":112,"「ええっ！？\n　\\N[3]、モンスターまで商品として扱ってるの！？」\\nw[\\N[2]]":113,"「そうよ！\n　ウチの商会は扱う品をどんどん広げていってるの！\\nw[\\N[3]]":114,"「いえ、ウチだけじゃないわ。\n　武器商ギルド自体があらゆる分野の売買に進出して\n　いってるのよ！\\nw[\\N[3]]":115,"「そう遠くないうちに商業ギルドは潰れて、あたしたち\n　武器商ギルドの天下が来るわ！」\\nw[\\N[3]]":116,"「王に媚びて武器流通の特権を握ったのも、そのための\n　布石ってわけか。\\nw[\\N[1]]":117,"「だがそううまく行くかな？」\\nw[\\N[1]]":118,"「行かせるのよ、このあたしがね！」\\nw[\\N[3]]":119,"「すごい自信……」\\nw[\\N[2]]":120,"「自信だけは、な」\\nw[\\N[1]]":121,"「で、あんたらは何をしに闘技場まで来たのよ？\n　まさか剣闘試合に出るつもりじゃないでしょうね？」\\nw[\\N[3]]":122,"「なんだ、知らなかったのか？\n　俺たちは人気急上昇中の新人剣闘士だぞ」\\nw[\\N[1]]":123,"「はあぁっ？！　あんたらがぁ！？\n　冗談でしょ！\\nw[\\N[3]]":124,"「あんたらみたいな素人が、あたしの調達してきた\n　凶悪モンスターに勝てるわけないじゃない！」\\nw[\\N[3]]":125,"「そ、そんなことないよ！\n　わたしたちだって、経験を積んで強くなってるんだから！」\\nw[\\N[2]]":126,"「だったら賭けでもしてみる？\n　もし次の試合であんたらが負けたら――。\\nw[\\N[3]]":127,"「\\N[2]が\\C[17]全裸でその檻の中へ入ってモンスターにタッチ\n　してくる\\C[0]ってのはどう？」\\nw[\\N[3]]":128,"「ぜ、全裸でって……そんなのどうなっちゃうか……\n　考えただけで、あぁ……\\I[29]」\\nw[\\N[2]]":129,"「ぜ、全裸でって……そんなの無理っ！\n　無理ムリむりぃっ！！」\\nw[\\N[2]]":130,"「その賭け乗った！」\\nw[\\N[1]]":131,"「本気ですか、\\N[1]さん！？\n　ど、どうしよ～\\I[29]」\\nw[\\N[2]]":132,"「ええええぇええぇっ！！？」\\nw[\\N[2]]":133,"「ただし俺たちが勝った場合は、当然同じことをお前に\n　してもらうぞ」\\nw[\\N[1]]":134,"「別にいいけどぉ～。\n　どうせあんたらに勝つ見込みなんて無いんだしぃ～」\\nw[\\N[3]]":135,"（そもそも、あたしってば闘技場の運営者とはズブズブの\n　間柄だからね）\\nw[\\N[3]]":136,"（それとなく妨害行為を加えるくらい、朝飯前よ！）\\nw[\\N[3]]":137,"「なら、賭けは成立だな。\n　不都合な結果になったからといって、逃げるなよ？」\\nw[\\N[1]]":138,"「そっちこそね。\n　\\N[2]が全裸でモンスターと戯れるところ、じっくり\n　眺めてやるから！」\\nw[\\N[3]]":139,"（負けたらモンスターに……じゃあ無理に勝たなくても\\I[29]\n　でも\\N[3]とモンスターの絡みも見てみたいなぁ\\I[29]）\\nw[\\N[2]]":140,"「やだぁっ！\n　そんな賭け、わたしはやりたくないですよぉっ！！」\\nw[\\N[2]]":141,"\\>\\C[17]　※　次の剣闘試合で\\N[3]との賭けが行われます。　※\\C[0]\n （主人公側が敗北したときは\\N[2]のエッチイベントあり）":142,"「次の剣闘試合であんたらが負けたら、\\N[2]は\\C[17]全裸で\n　モンスターの檻の中\\C[0]行きよ！」\\nw[\\N[3]]":143,"「俺たちが勝ったらメスガキ、お前が檻の中だ。\n　忘れるなよ？」\\nw[\\N[1]]":144,"会話マーク":145,"闘技場賭け結果Ev":146,"賭けに勝利・エルラ異種姦":147,"「なんであんたらが勝ってんのよ！？\n　こ……こんなはずじゃ……」\\nw[\\N[3]]":148,"「逃げなかったとは感心だな。\n　それじゃ全裸で檻の中へ入って、モンスターにタッチ\n　して来てもらおうか？」\\nw[\\N[1]]":149,"「\\N[3]……。\\nw[\\N[2]]":150,"「ね、\\N[1]さんに謝ろ？\n　土下座して陳謝すれば、きっと許してくれるよ」\\nw[\\N[2]]":151,"「ど、土下座ですって！？　このあたしが！？\n　こんな道端の犬の糞みたいな男に！？」\\nw[\\N[3]]":152,"「その犬の糞に負けたクソ以下の存在がお前なんだよ。\n　さっさと服を脱いで檻に入りやがれ！」\\nw[\\N[1]]":153,"「\\N[3]、そこまですることないよ！\n　自分が悪かったって謝ってくれれば――」\\nw[\\N[2]]":154,"「うるさいうるさい！\n　だっ、誰が謝ったりするもんですか！\\nw[\\N[3]]":155,"「あんたらに頭を下げるくらいなら、あたしは檻の中に\n　入ってやるッ！！\\nw[\\N[3]]":156,"「みっ、見てなさいよ！」\\nw[\\N[3]]":157,"「なんだなんだ？　この騒ぎは？」\\nw[観戦客Ａ]":158,"「すげえぞっ！\n　女の子が全裸でモンスターのいる檻の中に入った！」\\nw[観戦客Ｂ]":159,"「ひぇ～！\n　あの子、頭おかしいんじゃないの？」\\nw[観戦客Ｃ]":160,"「は……ははっ……。\n　な、なによ、大したことないじゃない……！\\nw[\\N[3]]":161,"「ほらっ！　入ったわよ！\n　あとはちょっと、モンスターに触ってやれば……」\\nw[\\N[3]]":162,"「ひっ！？　や、やめっ……近づくなぁ！\n　こ、この下等モンスター！」\\nw[\\N[3]]":163,"「くるなっ！\n　ひいいぃっ！？　さわるなぁっ！\\nw[\\N[3]]":164,"「いやあああぁぁっ？！！」\\nw[\\N[3]]":165,"エルラ異種姦Ev\n↓　　↓　　↓":166,"\\N[3]との賭けに勝った！\n\\N[2]の信頼度が\\C[17]「１０」\\C[0]上がった！":167,"「うぐぐ……おのれっ、フード男と\\N[2]めぇ……！\n　この借りは絶対に……ぜぇーったいに返してやるッ！！」\\nw[\\N[3]]":168,"↑　　↑　　↑\nエルラ異種姦Ev":169,"賭けに敗北・ユマ異種姦":170,"「あっはははっ！！　負けてやんの！\n　無様すぎるぅ～！！」\\nw[\\N[3]]":171,"「くそっ……！\n　魔法を使った妨害行為がなけりゃ……！\\nw[\\N[1]]":172,"「おいメスガキ！\n　あの魔法はお前の差し金だろ！？」\\nw[\\N[1]]":173,"「はぁ？　なんのことかしら？\n　この期に及んで言い訳とか、見苦しいんですけどぉ？」\\nw[\\N[3]]":174,"「ま、負けちゃった……。\n　全裸であの檻に……わたしどうなっちゃうのぉ\\I[29]」\\nw[\\N[2]]":175,"「ま、負けちゃった……。\n　全裸であの檻に……いやあぁ……」\\nw[\\N[2]]":176,"「さあ、約束を果たしてもらいましょうか？\n　ほらっ、ほらっ！　はーやーくぅー！！」\\nw[\\N[3]]":177,"「チッ！　仕方ない……行け\\N[2]！\n　ちょっと入ってモンスターにタッチすれば済む話だ」\\nw[\\N[1]]":178,"「あ、言っておくけど、檻の外から助けに入るのはナシよ！\n　ちゃんと自力で出てくること！」\\nw[\\N[3]]":179,"「し、仕方ないなぁ\\I[29]\n　約束だもんね、入らなきゃ……うふふ……\\I[29]」\\nw[\\N[2]]":180,"「そんなあああぁぁっ！！？」\\nw[\\N[2]]":181,"「はぁ……はぁ……\\I[29]\n　闘技場のお客さんにすっごく見られてる\\I[29]\\nw[\\N[2]]":182,"「お客さんだけじゃない……モンスターもわたしの\n　体を見てる……\\I[29]」\\nw[\\N[2]]":183,"「あ……あぁ……ひいぃぃ……。\\nw[\\N[2]]":184,"「ちょ、ちょっと触ったらダッシュで逃げますからね！\n　檻の出入り口、開けておいてくださいよ！」\\nw[\\N[2]]":185,"「わぁっ！？　近づいてきたぁ\\I[29]」\\nw[\\N[2]]":186,"「うわっ、わわわっ！？\n　こ、来ないで！　いやっ！！」\\nw[\\N[2]]":187,"「ど、どうなっちゃうの？\n　わたし、どうされちゃうのぉ\\I[29]」\\nw[\\N[2]]":188,"「いっ、いやっ！　近づかないで！\n　わたしもう外に出るんだから！　出るんだからぁっ！！\\nw[\\N[2]]":189,"「いやあああぁああぁぁっ！！？」\\nw[\\N[2]]":190,"ユマ異種姦Ev\n↓　　↓　　↓":191,"「\\N[2]の淫乱ぶり、あれは何よ！　ドン引きだわ！\n　でも勝ったのはあたしだからね！　あんたらの負け！」\\nw[\\N[3]]":192,"「おぉ～ほっほっほっ！　いいものが見れたわぁ。\n　ざまぁないわね、\\N[2]！」\\nw[\\N[3]]":193,"「モンスターに犯されるなんて初めてでしたけど、\n　すっごく興奮しちゃいましたぁ\\I[29]」\\nw[\\N[2]]":194,"「そ、そうか？　まあなんだ……お前が気にしていない\n　のなら、それでいいが……」\\nw[\\N[2]]":195,"\\N[3]との賭けに負けてしまった！\n\\N[2]の信頼度が\\C[18]「５」\\C[0]下がった！\n\\N[2]の発情度が\\C[18]「１０」\\C[0]上がった！":196,"「こんな酷い目に遭ったのも、全部\\N[1]さんが\n　賭けを受けたりしたから……恨みますよ……」\\nw[\\N[2]]":197,"「わ、悪かった。今回ばかりは俺の落ち度だ。\n　ほんとうにスマン……」\\nw[\\N[2]]":198,"\\N[3]との賭けに負けてしまった！\n\\N[2]の信頼度が\\C[18]「４０」\\C[0]下がった！":199,"↑　　↑　　↑\nユマ異種姦Ev":200,"闘技場売店":201,"「試合前に回復薬の補充はいかがでしょう？」\\nw[係員]":202,"ShopInventory apply shop309":203,"ショップ拡張設定 購入/売却コマンド表示最適化":204,"ショップ拡張設定 購入価格レート 変数 #1":205,"ユマ（闘技場）":206,"EV071":207,"EV072":208,"EV073":209,"EV074":210,"EV075":211,"EV076":212,"EV077":213,"檻出入り口":214,"トイレドア（排泄Ev）":215,"トイレで用を足しますか？":216,"入る":217,"入らない":218,"いまのところ用を足す必要は無い。":219,"EV080":220,"トイレマーク（屋内用）":221,"<TE:84>":222,"ユマ（トイレ）":223,"闘技場職員（奴隷買い取り）":224,"奴隷市（フキダシ）":225,"秘密の出入口":226,"アジト":227,"EXITマーク":228,"「悪竜\\N[6]か……一度でいいからオレの斧を\n　叩き込んでやりたいもんだ」\\nw[戦斧のトード]":229,"「おいチャンピオン、勘違いするなよ？\n　オレがトップの座に興味が無いから、お前はその地位に\n　いられるだけなんだぞ」\\nw[戦斧のトード]":230,"「モンスターの肉をぶった斬る感触が好きで、オレは\n　剣闘を続けているのさ」\\nw[戦斧のトード]":231},"extension":"json","dataType":"map","filename":"Map216","basename":"Map216.json","path":"data/Map216.json","relPath":"data/Map216.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":232,"percent":0},"cellInfo":[]},"data/Map217.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["試合開始イベント",""],["\n　　　　　　　\\{特別試合　開始！！\\}",""],["\n　　　　　　　\\{第\\v[1]試合　開始！！\\}",""],["賭け実施時のHP/MP半減処理",""],["どこからともなく飛んできた魔法によって、\\C[18]ＨＰとＭＰが\n半分\\C[0]になってしまった！",""],["試合の進行度別に、敵との戦闘を実行",""],["試合に勝利したとき",""],["\n　　　　　　　\\C[17]※　試合に勝利した！！　※\\C[0]",""],["特別試合に勝利した！！\nやっぱりあなたがこの闘技場の\\C[17]『王者』\\C[0]だ！！",""],["エルラと賭けをしないまま全試合終了してしまった場合",""],["全ての試合に勝利した！！\nあなたがこの闘技場の\\{\\C[17]『王者』\\C[0]\\}だ！！",""],["全試合勝利後",""],["\\{「すげぇぞーッ！　新チャンピオン！！」\\}\\nw[観客]",""],["\\{「かっこいいッ！　ステキィッ！！」\\}\\nw[観客]",""],["このまま次の試合を行いますか？",""],["試合を続ける",""],["試合を続けない",""],["実績 30",""],["試合に負けたとき",""],["\n　　　　　※　試合に負けてしまった……　※",""],["闘技場敵",""],["観客（貴族）",""],["観客",""],["「悪竜との試合も、ここで見てみたいもんだぜ！\n　がはははっ！！」\\nw[観客男性]",""],["「おっ！？　チャンピオンじゃねぇか！\n　あんたの戦い最高だぜ！！」\\nw[観客男性]",""],["「剣闘は、血湧き肉躍る最高のエンターテイメントだぜ！」\\nw[観客男性]",""],["「あんた、闘技場のチャンピオンらしいな？\n　だがオレに言わせれば、所詮は猿山の大将だ」\\nw[冒険者]",""],["「所詮は見世物だな。\n　ダンジョンでの本物の死闘に比べれば、児戯に等しい」\\nw[冒険者]",""],["「いずれこういった戦いが、王都の市街で繰り広げられる\n　かもしれん。備えなければな」\\nw[冒険者]",""],["「ほう、チャンピオンに会えるとは思わなかった。\n　あなたの戦い方は常道から外れているが、そこがいい」\\nw[冒険者]",""],["「質の高い戦いを見ることもまた、訓練のひとつだ」\\nw[冒険者]",""],["「ぬぅ～。前の人が邪魔でよく見えない～」\\nw[観客女性]",""],["「くそっ、もう９連続で外してるんだ。\n　次こそは絶対に当てる！」\\nw[観客男性]",""],["「もうちょっと早く来れば良かった。\n　今からじゃ、いい席で見れないなぁ……」\\nw[観客男性]",""],["「とにかく見てごらんよ。絶対に面白いから！」\\nw[観客男性]",""],["「わたし、あんまりこういうの好きじゃないんだけど」\\nw[観客女性]",""],["「いけえぇっ！　斬れ！　刺せ！\n　そこだっ！　必殺技だああぁっ！！」\\nw[観客男性]",""],["BGS",""],["観戦ポイント",""],["試合を観戦しますか？",""],["観戦する",""],["観戦しない",""],["「やってる、やってる。\n　どうやら人気の剣闘士の試合らしいな」\\nw[\\N[1]]",""],["「すごく激しいですね……。\n　うわっ、危ない！」\\nw[\\N[2]]",""],["「剣闘士には奴隷も多いが、職業としてやってるヤツや\n　腕試しの冒険者なんかも結構出てるそうだ」\\nw[\\N[1]]",""],["「奴隷でもないのに、わざわざこんな所で戦うなんて\n　気が知れませんよ」\\nw[\\N[2]]",""],["「俺たちも剣闘士の端くれになったんだ。\n　参考に他人の試合を見ておくか」\\nw[\\N[1]]",""],["「わたしは剣闘なんて、まったくこれっぽちも\n　やりたくないんですけど……」\\nw[\\N[2]]",""],["「そう言うな。戦闘訓練として丁度いいんだから」\\nw[\\N[1]]",""],["「商人が戦闘訓練すること自体、おかしいと思いません？\n　……って今更言ってもムダですよね」\\nw[\\N[2]]",""],["剣闘士（デモ）",""],["モンスター（デモ）",""],["剣闘デモンストレーション",""],["EV216",""],["指名手配されているので、外へ出るわけにはいかない。",""]],"context":[["Map217/events/1/name"],["Map217/events/2/name"],["Map217/events/3/name"],["Map217/events/4/name"],["Map217/events/5/name"],["Map217/events/6/name"],["Map217/events/6/pages/0/list/28/message/noPicture/middle"],["Map217/events/6/pages/0/list/33/message/noPicture/middle"],["Map217/events/6/pages/0/list/39/comment"],["Map217/events/6/pages/0/list/63/message/noPicture/bottom"],["Map217/events/6/pages/1/list/0/comment"],["Map217/events/6/pages/2/list/0/comment"],["Map217/events/6/pages/2/list/10/message/noPicture/middle"],["Map217/events/6/pages/2/list/21/message/noPicture/bottom"],["Map217/events/6/pages/2/list/25/comment"],["Map217/events/6/pages/2/list/36/message/noPicture/bottom"],["Map217/events/6/pages/2/list/47/comment"],["Map217/events/6/pages/2/list/60/message/noPicture/bottom"],["Map217/events/6/pages/2/list/62/message/noPicture/bottom"],["Map217/events/6/pages/2/list/71/message/noPicture/bottom"],["Map217/events/6/pages/2/list/73/Show Choices/73/1from2"],["Map217/events/6/pages/2/list/73/Show Choices/73/2from2"],["Map217/events/6/pages/2/list/126/Plugin Command"],["Map217/even