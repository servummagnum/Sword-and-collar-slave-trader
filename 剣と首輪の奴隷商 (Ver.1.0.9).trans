,["「これが北の王国より取り寄せた“鬼”という亜人だ」\\nw[族長]",""],["「なんと、角が生えている！」\\nw[部族の男Ｃ]",""],["「それに赤銅色の肌とは、確かにこれは珍しい！」\\nw[部族の男Ｂ]",""],["「取り寄せたばかりでワシもまだよく見ておらんのでな、\n　ここで人との違いをじっくり検分しようではないか」\\nw[族長]",""],["「この鬼の服を脱がせよ」\\nw[族長]",""],["「アァ……ウウゥ……\\I[29]」\\nw[奴隷鬼]",""],["「ふぅっ。玉がスッカラカンになってしまったぞ。\n　しかし良きアソコであった」\\nw[族長]",""],["「見ていたら、久々に勃ってしまった」\\nw[部族の男Ａ]",""],["「鬼娘、なかなかに良さそうではないか。\n　オレも買い付けてみようか……」\\nw[部族の男Ｂ]",""],["「おい、自分でも買うつもりなのか？\n　だったら頼む、オレの分もついでに調達してくれ！」\\nw[部族の男Ｃ]",""],["「だ、だったらオレも！」\\nw[部族の男Ｄ]",""],["「やれやれ、珍しい女を連れて来させたというのに。\n　このままでは希少価値がなくなってしまいそうだ」\\nw[族長]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『族長の愛人探し』の達成報酬として\n\\C[17]\\in[19]４個\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["奴隷",""],["客1",""],["客2",""],["客3",""],["客4",""],["客5",""],["客6",""],["愛妾1",""],["愛妾2",""],["愛妾3",""],["愛妾4",""],["使用人1",""],["使用人2",""],["警備兵1",""],["警備兵2",""]],"context":[["Map420/events/1/name"],["Map420/events/1/pages/0/list/5/message/noPicture/middle"],["Map420/events/1/pages/0/list/25/message/noPicture/bottom"],["Map420/events/1/pages/0/list/31/message/noPicture/bottom"],["Map420/events/1/pages/0/list/39/message/noPicture/bottom"],["Map420/events/1/pages/0/list/41/message/noPicture/bottom"],["Map420/events/1/pages/0/list/45/message/noPicture/bottom"],["Map420/events/1/pages/0/list/47/message/noPicture/bottom"],["Map420/events/1/pages/0/list/54/message/noPicture/bottom"],["Map420/events/1/pages/0/list/57/message/noPicture/bottom"],["Map420/events/1/pages/0/list/62/message/noPicture/bottom"],["Map420/events/1/pages/0/list/135/message/noPicture/bottom"],["Map420/events/1/pages/0/list/138/message/noPicture/bottom"],["Map420/events/1/pages/0/list/141/message/noPicture/bottom"],["Map420/events/1/pages/0/list/147/message/noPicture/bottom"],["Map420/events/1/pages/0/list/155/message/noPicture/bottom"],["Map420/events/1/pages/0/list/179/message/noPicture/bottom"],["Map420/events/1/pages/0/list/182/message/noPicture/bottom"],["Map420/events/1/pages/0/list/186/message/noPicture