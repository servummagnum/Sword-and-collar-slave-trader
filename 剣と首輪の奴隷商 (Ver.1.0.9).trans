tr":"Map006/events/132/pages/0/list/171/message/noPicture/bottom","translation":""}],[{"headerIndex":174,"headerParam":["",0,0,2],"contextStr":"Map006/events/132/pages/0/list/174/message/noPicture/bottom","translation":""}],[{"headerIndex":187,"headerParam":["",0,0,2],"contextStr":"Map006/events/132/pages/0/list/187/message/noPicture/bottom","translation":""}],[{"headerIndex":204,"headerParam":["",0,0,2],"contextStr":"Map006/events/132/pages/0/list/204/message/noPicture/bottom","translation":""}],[{"contextStr":"Map006/events/134/name","translation":""}],[{"contextStr":"Map006/events/135/name","translation":""}],[{"contextStr":"Map006/events/137/name","translation":""}],[{"contextStr":"Map006/events/138/name","translation":""}],[{"contextStr":"Map006/events/139/name","translation":""},{"contextStr":"Map006/events/140/name","translation":""},{"contextStr":"Map006/events/148/name","translation":""}],[{"contextStr":"Map006/events/147/name","translation":""}]],"indexIds":{"500":24,"1000":25,"5000":26,"10000":27,"100000":28,"食料品店":0,"下水道掃除の仕事を受けるまでは入れない":1,"「買い物は後だ。\n　今は商業ギルドへ行かないと」\\nw[\\N[1]]":2,"EV002":3,"どれ？":4,"売買率パターン町":5,"売買率パターン都市":6,"貿易品をもらう":7,"イベントフラグを立てる":8,"盗賊隠れ家出現":9,"衣装変更":10,"SFC_DISABLE_RESERVE":11,"CommonSave save":12,"どの衣装？":13,"裸":14,"私服":15,"軽装鎧":16,"ローブ":17,"ビキニアーマー":18,"メイド服":19,"スキルをもらう":20,"発情度+150":21,"経験値をもらう":22,"最大HPを減らす":23,"EV003":29,"OPイベントが一通り終わるまでは外に行けない":30,"※　注意　※\nまだ町の外へはいけません。\n町の中でイベントを進めてください。":31,"EV004":32,"EV005":33,"EV006":34,"EV007":35,"EV008":36,"EV009":37,"商業ギルド":38,"EV010":39,"宿屋":40,"精錬所入り口":41,"精錬所":42,"老人":43,"「オレの若い頃には、まだ今ほど鉱山から資源は採れて\n　なかったな」\\nw[老人]":44,"EV013":45,"武器防具店":46,"EV014":47,"アクセサリ店":48,"EV015":49,"卸売商会":50,"EV016":51,"「聖堂で祈ってる暇はない。\n　今は商業ギルドへ行かないと」\\nw[\\N[1]]":52,"聖堂":53,"厩舎入り口":54,"「馬車をいじるのは後だ。\n　今は商業ギルドへ行かないと」\\nw[\\N[1]]":55,"馬車屋":56,"開始時設定":57,"EV019":58,"自宅":59,"馬車":60,"通行遮断":61,"依頼掲示板":62,"下水道掃除の仕事を完了するまでは見られない":63,"「これは依頼用の掲示板だが、見るのは後回しだ。\n　先に用事を済ませないと」\\nw[\\N[1]]":64,"女の子":65,"「お花きれーだよ。ほら！」\\nw[女の子]":66,"女性（依頼02）":67,"「皆もっと聖堂に足を運ぶべきなのに。\n　不信心者が多くて嘆かわしいわ」\\nw[信心深い女]":68,"男性":69,"「このラノティカの町では、鉱山から掘り出された鉱石の\n　精錬を一手に引き受けているんだ」\\nw[地元の男]":70,"「膝に矢を受けてなければ、私だって悪竜と戦って\n　いたかもしれませんねぇ」\\nw[元冒険者]":71,"「冒険者ギルド？\n　そういえばハリエーツの町にそういうのが出来たそうだね」\\nw[元冒険者]":72,"「膝に矢を受けてなければ、この辺りのモンスター\n　なんて今でも一捻りなんですけどねぇ」\\nw[元冒険者]":73,"男性（依頼04）":74,"「冒険者ギルドならハリエーツの町にあるぞ。\n　加入すればダンジョンの位置が記してあるマップも\n　もらえるから、入って損はないな」\\nw[冒険者]":75,"「装備品を買うなら、こういう田舎の町がいい。\n　景気がいい時の王都なんかで買おうとすると、かなりの\n　割高になってしまうんだよ」\\nw[冒険者]":76,"娼館入り口":77,"「娼館に行ってる暇はない。\n　今は商業ギルドへ行かないと」\\nw[\\N[1]]":78,"娼館":79,"研究者（依頼32)":80,"依頼を出している場合":81,"依頼フキダシ":82,"おっぱいマニア（依頼18）":83,"兵士":84,"EV035":85,"魔法具店":86,"EV037":87,"どうする？":88,"掲示板依頼初期化":89,"ゲームデータ表示":90,"装備変数代入確認":91,"掲示板初期化":92,"ゲームデータ":93,"プレイ時間：\\v[1]\n戦闘回数：　\\v[2]\n勝利回数：　\\v[3]":94,"現在ユマが身体に装備中の防具のIDは「\\v[1]」":95,"兵士（追跡）":96,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":97,"EV039":98,"アイテムもらう":99,"全回復":100,"任意のレベルに変更":101,"特定アイテム":102,"ユマのHPを増やす":103,"どのレベル？":104,"レベル1相当":105,"レベル2相当":106,"レベル3相当":107,"レベル4相当":108,"レベル5相当":109,"レベル6相当":110,"レベル7相当":111,"レベル8相当":112,"レベル9相当":113,"レベル10相当":114,"レベル11相当":115,"レベル12相当":116,"レベル13相当":117,"レベル14相当":118,"レベル15相当":119,"レベル16相当":120,"レベル17相当":121,"レベル18相当":122,"レベル19相当":123,"+200":124,"+400":125,"+600":126,"+800":127,"+1000":128,"尾行対象(依頼13・14・15)":129,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":130,"難易度ノーマル用":131,"難易度イージー用（振り向く前に立ち止まる時間が倍）":132,"視界範囲に引っかかったとき":133,"SmartPath 0 30 1":134,"周囲2マス圏内に侵入したとき":135,"尾行に気づいて逃走":136,"浮気相手の元へゴールしたとき":137,"浮気相手(依頼11)":138,"浮気調査（依頼13・14・15）":139,"ターゲット表示":140,"スケベじじい（依頼19）":141,"矢印マーク":142,"EV048":143,"執事（依頼21）":144,"EV052":145,"先制攻撃の確率は？":146,"味方100％先制":147,"敵100％先制":148,"先制無し":149,"カスタマイズ":150,"どれと戦う？":151,"盗賊（普通）":152,"盗賊（白肌）":153,"蛮族":154,"猫人":155,"悪魔":156,"ハイエルフ":157,"Lv3":158,"Lv5":159,"Lv7":160,"Lv9":161,"Lv11":162,"Lv13":163,"Lv15":164,"Lv17":165,"Lv19":166,"ダークエルフ":167,"鬼":168,"ハーピー":169,"バルコルド":170,"オーガ":171,"島の巨人":172,"Lv4":173,"Lv10":174,"Lv16":175,"Lv8":176,"Lv14":177,"Lv20":178,"刺客":179,"警備兵":180,"邪悪なる魔術師":181,"その他ボス":182,"Lv6":183,"Lv12":184,"Lv18":185,"ファイアキメラ":186,"リバイアサン":187,"ガルーダ":188,"アースエンジェル":189,"甲殻飛蚊":190,"ガーゴイル":191,"アルテト（竜の寝床）":192,"アルテト（最終決戦）":193,"ラーナ＝アルテト":194,"テストモンスター":195,"工事監督官（依頼31）":196,"落ちてる精霊石（街）":197,"EV056":198,"煙":199,"EV058":200,"街ズームアウト":201,"P_D_FILENAME name_town\\V[101]":202,"マップ取得":203,"FocusCamera 28 16 120":204,"ZoomOut 3 120":205,"\\C[17]\\V[904]の地図\\C[0]を取得した！":206,"ResetZoom 60":207,"ResetFocus 60":208,"街中イーグルダイブ":209,"ここから飛び降りますか？":210,"飛び降りる":211,"やめる":212,"EV063":213,"EV064":214,"EV065":215,"EV066":216,"掲示板マーク":217,"EV068":218,"EV069":219,"EV070":220,"猫":221,"EV073":222,"↓海賊船戦闘初期化":223,"↑海賊船戦闘初期化":224,"建国王像":225,"『建国王リジェルダの像』と台座に彫ってある。":226,"EV075":227,"EV076":228,"奴隷商人（オープニング実行）":229,"FocusCamera 28 16 90":230,"「さあっ！　よってらっしゃい、見てらっしゃい！\n　掘り出しモノの奴隷が勢ぞろいだよ！\\nw[奴隷商人]":231,"「力仕事に家事手伝い、危険作業に老人介護！\n　みなさまの暮らしをサポートする優秀な奴隷が\n　ここにおりますよ！\\nw[奴隷商人]":232,"「そこの美しい奥さん！\n　どうです、ためしに一人買ってみては？\n　お安くしておきますよ」\\nw[奴隷商人]":233,"「そうねぇ……お隣の家でも奴隷を使ってるし、\n　ウチにも一人くらいいても、悪くないかも……」\\nw[奥さん]":234,"「そうでしょう！　そうでしょう！」\\nw[奴隷商人]":235,"「例えばこの蛮族の男。\n　力持ちでタフですから、こき使っても全然へっちゃら！」\\nw[奴隷商人]":236,"「こっちの女は家事が得意。\n　料理、洗濯、裁縫、どれもお手の物ですよ！」\\nw[奴隷商人]":237,"「くそっ！　あの奴隷商め！\n　人のこと、果物みたいに並べて売りやがって！\\nw[蛮族奴隷]":238,"「鎖につながれてさえなきゃ、この手でブッ殺して\n　やるのによぉ！」\\nw[蛮族奴隷]":239,"「ムカつくったらねぇよな？　よぉ」\\nw[蛮族奴隷]":240,"　\n↓↓　立ち絵表示初期設定　↓↓":241,"「えっ！？　わっ、わたしですか？」\\nw[\\N[2]]":242,"「他に誰がいるってんだ？\\nw[蛮族奴隷]":243,"「どんな悪事を働いて奴隷身分に落とされたのか\n　知らねぇが、お前もあの奴隷商には頭にキてんだろ？」\\nw[蛮族奴隷]":244,"「ち、ちがいます！\n　わたしは悪いことなんてしてません！\\nw[\\N[2]]":245,"「わたしが奴隷になったのは――」\\nw[\\N[2]]":246,"「さあてお次はこの奴隷！\n　猫人のカワイイお嬢ちゃんの紹介です！」\\nw[奴隷商人]":247,"「なるほど、奴隷市が立っていたのか。\n　この\\C[17]ラノティカ\\C[0]の町じゃ久しぶりだな。\\nw[\\N[1]]":248,"「…………。\\nw[\\N[1]]":249,"「奴隷か……。":250,"「人間を扱うのは面倒くさそうだから、これまで奴隷売買\n　には手を出さなかったが……。\\nw[\\N[1]]":251,"「でも奴隷は儲かるって話も聞くよなぁ。\n　うーむ……」\\nw[\\N[1]]":252,"「いかがですか、滅多に出回らない美少女奴隷ですよ！」\\nw[奴隷商人]":253,"「び、美少女だなんて、そんな……」\\nw[\\N[2]]":254,"「胸の方がちょっと残念なのが、玉に瑕ですけど」\\nw[奴隷商人]":255,"「なっ……！？」\\nw[\\N[2]]":256,"「しかも正真正銘の生娘です！\\nw[奴隷商人]":257,"「愛人にしてよし！　娼婦として働かせてよし！\\nw[奴隷商人]":258,"「さあさあ、この機を逃したら二度とこれほどの\n　上物は手に入りませんよ！」\\nw[奴隷商人]":259,"「生娘だと？　そんな証拠がどこにある！\n　値を吊り上げるために吹いてるだけだろ！」\\nw[見物人Ａ]":260,"「そうだそうだ！　怪しいもんだぜ！」\\nw[見物人Ｂ]":261,"「疑われるとは心外ですな！\n　よろしい！　ならば証拠を見せましょう！」\\nw[奴隷商人]":262,"「おい、お前」\\nw[奴隷商人]":263,"「はい？」\\nw[\\N[2]]":264,"「ちょっとおまんこ広げて、お客様たちに処女膜を\n　見せてやれ」\\nw[奴隷商人]":265,"「はぁっ？！\n　そ、そんな真似、出来るわけないでしょ！」\\nw[\\N[2]]":266,"「出来る出来ないじゃねぇ。\n　やれと言ってるんだ。\\nw[奴隷商人]":267,"「お前ら奴隷に拒否権なんて無いんだ。\n　オラッ！　さっさとメス穴おっぴろげろ！」\\nw[奴隷商人]":268,"「い、いやです！\n　絶対にそんなこと――」\\nw[\\N[2]]":269,"「なら、仕方ねぇ……力ずくだ！」\\nw[奴隷商人]":270,"「なにするんですか！？\n　きゃぁっ！　やめてーっ！！」\\nw[\\N[2]]":271,"\n↓　↓　↓\nここからエロシーン":272,"↑　↑　↑\nここまでエロシーン\n　":273,"「こんなのひどい……。\n　知らない人に中まで見られて……うぐ、ひっく……」\\nw[\\N[2]]":274,"「それでは生娘であることも証明されたところで、\n　購入希望者を募りたいと思います！\\nw[奴隷商人]":275,"「この猫人の娘を欲しい方はいらっしゃいますかな？」\\nw[奴隷商人]":276,"「買う買う！　オレが買うぜ！」\\nw[見物人Ｃ]":277,"「まて！　オレが買う！　オレだっ！」\\nw[見物人Ａ]":278,"「ふひひひ！　大人気ですなぁ。\\nw[奴隷商人]":279,"「では競売といきましょうか。\n　この娘は、一番多く払っていただいたお客様のものです」\\nw[奴隷商人]":280,"「確かにあれは上玉だな。\n　よぉし！　一か八かだ！\\nw[\\N[1]]":281,"「あの猫人の娘、俺が競り落としてやる！\\nw[\\N[1]]":282,"「大きな都市に連れていって、うまく娼館にでも転売して\n　やれば、きっと一度で大きく儲けられるはず！」\\nw[\\N[1]]":283,"「４０００ゴールド！\n　４０００だ！」\\nw[見物人Ａ]":284,"「だったらオレは６０００！」\\nw[見物人Ｃ]":285,"「くっ……それなら７０００だ！」\\nw[見物人Ｂ]":286,"「ぐぅっ！　生活費までかけるわけには……。\n　だが……ええいっ！　８０００だ！」\\nw[見物人Ａ]":287,"「ふひひっ！　８０００出ました！　８０００！\n　他にはいらっしゃいませんか？」\\nw[奴隷商人]":288,"「１００００ゴールド」\\nw[\\N[1]]":289,"「おおっと！\n　そちらの暗殺者風のお兄さんが１００００！」\\nw[奴隷商人]":290,"「誰が暗殺者だっ！」\\nw[\\N[1]]":291,"「１００００！　１００００ゴールド！\n　どうですか！？」\\nw[奴隷商人]":292,"「１００００はさすがに……」\\nw[見物人Ａ]":293,"「オレも無理だ……チクショウ……！」\\nw[見物人Ｃ]":294,"「では１００００ゴールドで、そちらのお客様の\n　落札です！」\\nw[奴隷商人]":295,"「ひぃっ！　\n　う、売られちゃったぁ……。\\nw[\\N[2]]":296,"「きっとヘンなことされちゃうんだ……！　\n　うええぇ～ん！！」\\nw[\\N[2]]":297,"「やだよぉ！\n　誰か助けてええぇ！！」\\nw[\\N[2]]":298,"OPバルーン表示用":299,"奴隷（ユマ）":300,"奴隷1":301,"奴隷2":302,"奴隷3":303,"群衆":304,"OPバルーン表示用2":305,"OPバルーン表示用3":306,"知り合い商人（ﾒｲﾝｼﾅﾘｵ4発生）":307,"「ギルド長のお仕事は終わりましたし、また奴隷狩りに\n　戻るんですか？」\\nw[\\N[2]]":308,"「そうだな。\n　装備を揃えつつ、奴隷候補の盗賊や亜人を追って、\n　王国内を回るぞ」\\nw[\\N[1]]":309,"「それならひとつ、お願いがあるんですけど」\\nw[\\N[2]]":310,"「なんだなんだ、金ならないぞ？」\\nw[\\N[1]]":311,"「そんなことは知ってます。\n　そうじゃなくて――。\\nw[\\N[2]]":312,"「王国のあちこちを旅するなら、その途中でわたしの\n　故郷にも寄って欲しいんです。\\nw[\\N[2]]":313,"「奴隷に売られていくわたしのことを、心配してくれた\n　人たちもいたので、故郷に戻って無事な姿を見せて\n　あげたいなって」\\nw[\\N[2]]":314,"「奴隷堕ちした姿を知り合いにさらしたいとか、\n　もしかしてお前、マゾか？」\\nw[\\N[1]]":315,"「なんでそう曲解するんですか！？\\nw[\\N[2]]":316,"「わたしは純粋に里帰りしたいだけです！」\\nw[\\N[2]]":317,"「分かったからキーキー騒ぐな。\n　で、お前の故郷ってのはどこだ？」\\nw[\\N[1]]":318,"「北の海に浮かぶ、\\C[17]島の町シーグヌース\\C[0]です！」\\nw[\\N[2]]":319,"「海洋貿易の中継点として有名な、あの島か。\n　いいぞ、ついでに立ち寄ってやる」\\nw[\\N[1]]":320,"「やったぁ！」\\nw[\\N[2]]":321,"「やあ、\\N[1]。もしかしてシーグヌースに行く\n　つもりなの？」\\nw[顔見知りの商人]":322,"「ああ、それがどうかしたか？」\\nw[\\N[1]]":323,"「聞いた話じゃ、ここ最近\\C[17]海賊\\C[0]が活発に動いてるせいで、\n　渡航用の船は全然出てないらしいよ」\\nw[顔見知りの商人]":324,"「えぇっ！？　じゃあシーグヌースに渡れないんですか！？」\\nw[\\N[2]]":325,"「うん、そういう話だよ。\\nw[顔見知りの商人]":326,"「王国軍が頼りにならないんで、\\C[17]護衛の冒険者\\C[0]を雇って\n　無理にでも渡ろうと計画してる商船もあるようだけど」\\nw[顔見知りの商人]":327,"「つまり冒険者なら、船に同乗してシーグヌースまで\n　行けるってワケか？」\\nw[\\N[1]]":328,"「まさか冒険者と名乗って乗り込むつもりかい？\n　でも自称冒険者じゃ、たぶん信用されないよ？」\\nw[顔見知りの商人]":329,"「いいや、俺たちはすでに冒険者ギルドへ加入済みだ。\n　ギルド会員ってことなら、きっと信用も得られるさ」\\nw[\\N[1]]":330,"「なんで商人のキミが冒険者になっているんだよ……？」\\nw[顔見知りの商人]":331,"「色々ありまして……」\\nw[\\N[2]]":332,"「よしっ、決まりだ！\n　護衛として船に乗り込んで、シーグヌースへ渡るぞ！」\\nw[\\N[1]]":333,"「なに！？　冒険者なんて自称が当たり前じゃないか！\n　資格や免許が必要なわけでも――。\\nw[\\N[1]]":334,"「――っと、そういえば何年か前に\\C[17]冒険者ギルド\\C[0]ができたん\n　だったか？」\\nw[\\N[1]]":335,"「そうそう、ソレ！\n　最近じゃ冒険者ギルドに加入してないと、雇ってもらえ\n　ないことが多いらしいね」\\nw[顔見知りの商人]":336,"「そ、そうなんですか……？\n　じゃあ結局、渡航はあきらめるしか……」\\nw[\\N[2]]":337,"「なに言ってる？　だったら\\C[17]冒険者ギルドに加入\\C[0]すりゃ\n　いいだけの話だろ？」\\nw[\\N[1]]":338,"「えぇ～！？」\\nw[\\N[2]]":339,"「異業種のギルドだったら掛け持ちもＯＫとはいえ、\n　本気かい？」\\nw[顔見知りの商人]":340,"「どうせこの先、戦闘する機会も多くなっていくんだ。\n　だったら冒険者としてギルドに所属しておいた方が\n　なにかと便利だろ？」\\nw[\\N[1]]":341,"「それは……まあ、そうかもしれませんけど……」\\nw[\\N[2]]":342,"「よしっ、決まりだ！\n　冒険者ギルドに加入してから、シーグヌースへ渡るぞ！」\\nw[\\N[1]]":343,"メインシナリオ\\C[17]『里帰り』\\C[0]を受けた！":344,"\\C[17]島の町ウェーベロイ\\C[0]へ行って、シーグヌースへ渡航予定の\n船を探そう！":345,"まずは\\C[17]冒険の町ハリエーツ\\C[0]へ行って、冒険者ギルドに\n加入しよう！":346,"個別依頼15":347,"猫耳娘ラブ":348,"「あーっ！　あんた！！」\\nw[男]":349,"「なんだなんだ！？　俺がどうした？」\\nw[\\N[1]]":350,"「その猫人の娘、オレが競り落とそうとしたのにぃ！」\\nw[男]":351,"「ああ……\\N[2]の競売に参加してたヤツか。\\nw[\\N[1]]":352,"「俺の方が高く値をつけたんだから、仕方ないだろうが」\\nw[\\N[1]]":353,"「それは分かってる！\n　でもオレだって猫耳の可愛い女の子が欲しいんだ！\\nw[男]":354,"「あんた奴隷売買を始めたそうじゃないか！\n　ならオレにも\\C[17]猫人の女奴隷\\C[0]を売ってくれよ！」\\nw[男]":355,"「それはいいが……ユマが好みってことは、貧乳希望か？」\\nw[\\N[1]]":356,"「いや、そこは\\C[17]巨乳\\C[0]で」\\nw[男]":357,"「…………」\\nw[\\N[2]]":358,"「でも金はあんまりないんで、予算は\\C[17]４０００Ｇ\\C[0]で頼む！\n　それとついでに物置きにあった\\C[17]変な玉\\C[0]もやるからさ！」\\nw[男]":359,"個別依頼『猫耳娘ラブ』を受けますか？":360,"受ける":361,"受けない":362,"ハイエルフの森・2層":363,"猫賊の隠れ家":364,"個別依頼\\C[17]『猫耳娘ラブ』\\C[0]を受けた！":365,"\\C[17]『\\in[118]』\\C[0]を依頼者に渡しますか？":366,"渡す":367,"渡さない":368,"依頼条件達成":369,"「ほらよ、ご希望の猫人奴隷だ。\n　\\N[2]と違って、ちゃんと巨乳だぞ」\\nw[\\N[1]]":370,"「うひょひょ～い！\n　これだよコレ！　猫耳はやっぱ可愛いなぁ～」\\nw[男]":371,"個別依頼\\C[17]『猫耳娘ラブ』\\C[0]を達成した！":372,"\nここでエッチイベント\n↓　　↓　　↓":373,"↓プレーヤー位置強制中央":374,"SFC_ENABLE_RESERVE":375,"依頼条件未達成":376,"「かわいい猫耳ちゃんを連れてきてくれよ！」\\nw[男]":377,"依頼マーク":378,"「夜中に街道を歩いていると、盗賊や危険亜人が襲ってくる\n　こともあるんだ。\\nw[男性]":379,"「腕に覚えがないなら、夜間の移動は避けるべきだね」\\nw[男性]":380,"女性1":381,"「そうよ、\\N[6]は王都で英雄さんが倒してくれたん\n　ですって」\\nw[主婦]":382,"「買えるわけないでしょ！\n　わがまま言ってると、洗濯物と一緒に干しちゃうわよ！」\\nw[主婦]":383,"少女":384,"「わるい竜がたいじされたの？」\\nw[女の子]":385,"「ねぇ～！　買ってよぉ～！\n　ねぇってばぁ～！　真珠の首飾りぃ～！！」\\nw[女の子]":386,"EV092":387,"民家":388,"EV093":389,"兵士（追跡）2":390,"「オレの目をもってすれば、どんな犯罪者も見逃さん！」\\nw[兵士]":391,"EV095":392,"奴隷市":393,"奴隷市（通行不可）":394,"奴隷市（フキダシ）":395,"EV101":396,"主婦1":397,"「町に住むと、やっぱり食費がかかるわね。\n　故郷の村じゃ、野菜なんてこの半額だったのに」\\nw[主婦]":398,"主婦2":399,"「浮気は絶対に許せないわね」\\nw[主婦]":400,"主婦3":401,"「南都に住んでる姉が、夫に浮気されて狂ったように\n　怒っちゃってね。\n　このままだと離婚かも」\\nw[主婦]":402,"「えっ！？　下水の害獣を駆除してくれたんスか！？\n　そいつは助かったッス！」\\nw[奴隷]":403,"「ここの下水掃除は奴隷の仕事なんスけど、最近\n　コウモリやらネズミやらが大量に湧いてて……。\n　正直入りたくないッス」\\nw[奴隷]":404,"EV106":405,"ＢＧＭ変更":406,"夜間用ＢＧＭ演奏":407,"夜→昼":408,"最初から昼":409,"昼→夜":410,"最初から夜":411,"レイプ現場遭遇":412,"EV109":413,"景気ランタン":414,"掲示板依頼初期化おばあちゃん":415,"<TE:110>":416,"レイプ魔":417,"レイプ被害者":418,"レイプEv発生制御":419,"依頼01・02戦闘":420,"依頼を引き受けている場合、暴漢と戦闘":421,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":422,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":423,"暴漢と戦闘":424,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":425,"襲ってきた暴漢を撃退し、街の警備兵に引き渡した。":426,"暴漢":427,"レイプEv向き合わせ":428,"四聖教メッセンジャー":429,"<TE:112>":430,"会話マーク(EX)":431,"<TE:113>":432,"レイプマーク":433,"盗賊1":434,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":435,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":436,"「邪魔をするなら殺す！」\\nw[蛮族]":437,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":438,"奴隷化性別：0=女、1=男、2=男女ランダム":439,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":440,"戦闘マーク":441,"街中盗賊出没":442,"街中淫行制御":443,"淫行男1":444,"粗暴な男":445,"「なにジロジロ見てやがる？　あぁ？\n　ブッ飛ばされたいのか？」\\nw[\\v[1655]]":446,"「いいメス奴隷を連れてんじゃねぇか。\n　ちょっとオレにも貸せよ」\\nw[\\v[1655]]":447,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":448,"売春させる":449,"やめておく":450,"淫行表示":451,"淫行男2":452,"横柄な男":453,"「黙って回れ右しろ。\n　それとも痛い目に遭いてぇのか？」\\nw[\\v[1655]]":454,"「ケッ……こんな時間に女を連れ歩くだと？\n　オレに買わせてぇのか？」\\nw[\\v[1655]]":455,"ギルド長（ED3Ev）":456,"悪竜\\N[6]の討伐に成功してから、約半月後――。":457,"「さて……ラノティカに戻ってはきたが、これから\n　どうするか。\\nw[\\N[1]]":458,"「しかし王都や副都であれだけ騒動があっても、ここは\n　変わらないな。\\nw[\\N[1]]":459,"「距離があるから当然と言えば当然だが」\\nw[\\N[1]]":460,"「よう、ご先祖様。\\nw[\\N[1]]":461,"「あんたが変な色気出して\\N[6]を使役しようなんて\n　考えたから、こっちは大変だったぜ。\\nw[\\N[1]]":462,"「あのアホ王がお袋に手をつけて俺が生まれてなきゃ、\n　王国が滅んでたところだ。\\nw[\\N[1]]":463,"「しかしひとつ、分からんことがある。\n　どうして俺でなく\\N[5]が悪竜の魂の器だった？\\nw[\\N[1]]":464,"「先に生まれた俺が\\N[6]であったほうが自然だと\n　思うんだが？\\nw[\\N[1]]":465,"「悪竜がメスだったからか？\n　それともまさか……全部あんたに仕組まれていたなんて\n　ことは――。\\nw[\\N[1]]":466,"「――いや、そんなわけないよな」\\nw[\\N[1]]":467,"「げっ？！　ギルド長……」\\nw[\\N[1]]":468,"「何が『げっ？！』だ。やましいことでもあるのか？」\\nw[ギルド長]":469,"「いやいや、そんな。\n　ギルド会費なら次もちゃんと払うぜ？」\\nw[\\N[1]]":470,"「そう願いたいものだな。\n　ところでお前、確か最近王都の方へ行ってたな？」\\nw[ギルド長]":471,"「ああ、今日戻ってきたところだが？」\\nw[\\N[1]]":472,"「なら丁度いい。王都の様子はどうだった？\n　悪竜が出たとか国王と姫が死んだとか、真偽不明の話\n　ばかり伝わってきているが」\\nw[ギルド長]":473,"「どっちも本当だ。\n　ただし悪竜はすぐにどこかの誰かが退治しちまったが」\\nw[\\N[1]]":474,"「誰か？　王都の兵士が倒したわけじゃないのか？」\\nw[ギルド長]":475,"「\\C[17]正体不明の謎の冒険者\\C[0]が、どこからともなく現れて\n　\\N[5]姫に化けていた悪竜を退治しちまったらしい」\\nw[\\N[1]]":476,"「なんだそれは？\n　おとぎ話じゃあるまいし、胡散臭い話だ」\\nw[ギルド長]":477,"「俺もそう思うが、事実なんだから仕方がない」\\nw[\\N[1]]":478,"「しかし悪竜が倒されても、国王ばかりか\\N[5]姫や\n　パルフューク大公まで死んでしまったとなると、次の\n　王はどうなるのか……」\\nw[ギルド長]":479,"「ああ、それなら大公の娘のチェリア姫を女王にするって\n　ことでほぼ決まったそうだぜ」\\nw[\\N[1]]":480,"「ほ、本当か！？　意外だが……しかし悪い考えでもないか。\n　成人男子の王族はロクでもないヤツが多いからな」\\nw[ギルド長]":481,"「それよりこっちの方が朗報だぜ。\n　\\C[17]武器商ギルドに与えられていた特権が撤回\\C[0]される見込みだ」\\nw[\\N[1]]":482,"「おっ……おおっ！　ついにか！」\\nw[ギルド長]":483,"「女王の即位後に施行されるだろうが、王都じゃすでに\n　武器商ギルドの求心力が急速に落ちてきてる。\\nw[\\N[1]]":484,"「ギルド会員の中には、夜逃げ同然に王都を去るヤツまで\n　出ている有様だ」\\nw[\\N[1]]":485,"「こうしちゃおれん！\n　武器商ギルドから客や販路を取り返す算段を立てないと！」\\nw[ギルド長]":486,"「張り切ってやがんなぁ。\n　……俺も自宅へ戻るとするか」\\nw[\\N[1]]":487,"フクロウ":488,"王国官吏（依頼30）":489,"通行不可スイッチ":490,"通行不可2スイッチ":491,"通行不可2":492,"藁山":493},"extension":"json","dataType":"map","filename":"Map006","basename":"Map006.json","path":"data/Map006.json","relPath":"data/Map006.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":33,"length":494,"percent":6.680161943319838},"cacheResetOnChange":{},"cellInfo":[[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{}],[null,{"t":"HU"}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{}],null,null,null,null,null,[null,{"t":"HU"}],[null,{"t":"HU"}],null,null,null,null,null,null,[null,{"t":"HU"}],null,[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"},{}],null,[null,{"t":"HU"}],null,[null,{"t":"HU"}],null,[null,{"t":"HU"}],null,[null,{"t":"HU"},{}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],null,[null,null,{"t":"HU"}]],"comments":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["Yuma's initial event"],null,null,null,null,[""]]},"data/Map007.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["作業員",""],["「この精錬所では、鉱石から金属のインゴットを作って\n　いるのだが……最近、その鉱石が運ばれてこなくなって\n　しまったのだ。\\nw[親方]",""],["「鉱山でなにかあったみたいだが、困ったことだ」\\nw[親方]",""],["奴隷1",""],["「砂漠生まれのオレでも、ここの炉の熱さには\n　参るぜ」\\nw[奴隷]",""],["奴隷2",""],["「盗賊やってた頃には、ここで作られた金塊を強奪した\n　こともあったんだぜ」\\nw[奴隷]",""],["奴隷3",""],["「こんな風にこき使われるくらいなら、オレも盗賊団の\n　仲間と一緒に、潔く散ってりゃ良かった……」\\nw[奴隷]",""],["従業員",""],["「\\C[17]ミスリル鍛冶師\\C[0]って知ってるか？\n　加工が難しいミスリルで上質な武具を作っていた\n　伝説の鍛冶師だよ。\\nw[従業員]",""],["「いつからか消息不明になっちまったが、その鍛冶師に\n　武具を打ってもらいたいって人間はいまだに多いぜ」\\nw[従業員]",""],["マーク",""]],"context":[["Map007/events/1/name"],["Map007/events/2/name"],["Map007/events/3/name"],["Map007/events/4/name"],["Map007/events/4/pages/0/list/4/message/noPicture/bottom"],["Map007/events/4/pages/0/list/8/message/noPicture/bottom"],["Map007/events/5/name"],["Map007/events/5/pages/0/list/0/message/noPicture/bottom"],["Map007/events/6/name"],["Map007/events/6/pages/0/list/0/message/noPicture/bottom"],["Map007/events/7/name"],["Map007/events/7/pages/0/list/0/message/noPicture/bottom"],["Map007/events/8/name"],["Map007/events/8/pages/0/list/0/message/noPicture/bottom"],["Map007/events/8/pages/0/list/4/message/noPicture/bottom"],["Map007/events/9/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,null,["gold"],null,["gold"],null,["gold"],null,["gold"],null,null,["gold"]],"parameters":[null,null,null,null,[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"作業員":3,"「この精錬所では、鉱石から金属のインゴットを作って\n　いるのだが……最近、その鉱石が運ばれてこなくなって\n　しまったのだ。\\nw[親方]":4,"「鉱山でなにかあったみたいだが、困ったことだ」\\nw[親方]":5,"奴隷1":6,"「砂漠生まれのオレでも、ここの炉の熱さには\n　参るぜ」\\nw[奴隷]":7,"奴隷2":8,"「盗賊やってた頃には、ここで作られた金塊を強奪した\n　こともあったんだぜ」\\nw[奴隷]":9,"奴隷3":10,"「こんな風にこき使われるくらいなら、オレも盗賊団の\n　仲間と一緒に、潔く散ってりゃ良かった……」\\nw[奴隷]":11,"従業員":12,"「\\C[17]ミスリル鍛冶師\\C[0]って知ってるか？\n　加工が難しいミスリルで上質な武具を作っていた\n　伝説の鍛冶師だよ。\\nw[従業員]":13,"「いつからか消息不明になっちまったが、その鍛冶師に\n　武具を打ってもらいたいって人間はいまだに多いぜ」\\nw[従業員]":14,"マーク":15},"extension":"json","dataType":"map","filename":"Map007","basename":"Map007.json","path":"data/Map007.json","relPath":"data/Map007.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":16,"percent":0},"cellInfo":[]},"data/Map008.json":{"data":[["EV001",""],["宿屋の主人",""],["下水道掃除の仕事を受けるまでは入れない",""],["「宿屋に泊まってどうする？\n　それより今は商業ギルドへ行かないと」\\nw[\\N[1]]",""],["EV003",""],["客",""],["「町を出て山沿いに北東の方へ行くと、ヤバイ\\C[17]洞窟\\C[0]が\n　あるんだよ。\\nw[男性客]",""],["「中にはモンスターがウジャウジャいてさ。\n　あれっていわゆる、ダンジョンなんじゃないか？」\\nw[男性客]",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["火",""],["宿屋の女将",""],["「ほらほら、商人ならもっと金を使っていきなよ！」\\nw[宿屋の女将]",""],["男",""],["「街道を西の方へ行くとナクル村があるんだ。\n　あそこじゃマツタケを栽培してるってな」\\nw[酒飲みの男]",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["ユマ（トイレ）",""],["依頼フキダシ",""],["燭台",""],["宿泊客（依頼06）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「私は農園を経営してるんだがね、そろそろ息子に全部\n　ゆだねて楽隠居するつもりなんだ」\\nw[宿泊客]",""],["絶倫おじさん（依頼16）",""],["変態紳士（依頼17）",""],["光",""],["吟遊詩人",""],["「\\C[17]ポータル球\\C[0]は実在すると思うかね？\n　私はあると思っているよ。鼻で笑う者もいるがね。\\nw[男性客]",""],["「そういえば広場にいた男が変な玉を見つけたようなことを\n　言っていたが……いや、そう都合よく出てくるはずは\n　ないか……」\\nw[男性客]",""],["「古代人は石碑にはめたポータル球の力で瞬間移動を\n　していたというが、私も一度でいいから体験して\n　みたいものだ」\\nw[男性客]",""],["料理1",""],["客1",""],["「ずっと西にいった先の森には、\\C[17]ダークエルフの里\\C[0]が\n　あるんだ。\n　不用意に踏み込むとモンスターに襲われるってさ」\\nw[男性客]",""],["客2",""],["「エルフと言えば、盗賊をやってるエルフもいるらしいぞ。\n　やつらは弓が得意だから、厄介だろうな」\\nw[男性客]",""],["客3",""],["「オレの若い頃には、まだ今ほど鉱山から資源は採れて\n　なかったな」\\nw[老人]",""],["料理2",""],["客4",""],["「一度でいいから、芸術の町に行ってみたいわ。\n　きっとステキなところなんでしょうね」\\nw[女性客]",""],["客5",""],["「旅行に行くなら、やっぱり王都がいいわね。\n　大都会を見てみたいの」\\nw[女性客]",""],["料理3",""],["客6",""],["「鬼っていう亜人を見たことあるか？\n　あれはヤバいぜ。特に男が」\\nw[労働者]",""],["客7",""],["「亜人っていうと、悪魔が一番怖いな。\n　邪神の眷属だっていうけど、本当なんだろうか？」\\nw[労働者]",""],["客8",""],["「ヤバイ亜人って言ったら、やっぱエルフだろ。\n　あいつら未だに『人間は侵略者だ』って言って\n　俺たちを目の敵にしてるんだぜ？」\\nw[労働者]",""]],"context":[["Map008/events/1/name"],["Map008/events/2/name"],["Map008/events/2/pages/0/list/1/comment"],["Map008/events/2/pages/0/list/5/message/noPicture/bottom"],["Map008/events/3/name"],["Map008/events/4/name"],["Map008/events/4/pages/0/list/0/message/noPicture/bottom"],["Map008/events/4/pages/0/list/3/message/noPicture/bottom"],["Map008/events/5/name"],["Map008/events/5/pages/1/list/0/message/noPicture/bottom"],["Map008/events/5/pages/1/list/2/Show Choices/2/1from2"],["Map008/events/5/pages/1/list/2/Show Choices/2/2from2"],["Map008/events/5/pages/1/list/12/message/noPicture/bottom"],["Map008/events/6/name"],["Map008/events/7/name"],["Map008/events/7/pages/0/list/0/message/noPicture/bottom"],["Map008/events/8/name","Map008/events/21/name"],["Map008/events/8/pages/0/list/0/message/noPicture/bottom"],["Map008/events/9/name"],["Map0