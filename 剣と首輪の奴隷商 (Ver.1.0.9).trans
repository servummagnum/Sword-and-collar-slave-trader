mand/16944098094617068.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"attachment":"scriptCommand/16944098094617616.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,null,null,[{"headerIndex":0,"headerParam":["夜間用ＢＧＭ演奏"]}],[{"headerIndex":1,"headerParam":["夜→昼"]}],[{"headerIndex":11,"headerParam":["最初から昼"]}],[{"headerIndex":1,"headerParam":["昼→夜"]}],[{"headerIndex":11,"headerParam":["最初から夜"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":15,"headerParam":["依頼を引き受けている場合、暴漢と戦闘"]}],[{"headerIndex":44,"headerParam":["",0,0,2]}],[{"headerIndex":48,"headerParam":["",0,0,1]}],[{"headerIndex":51,"headerParam":["暴漢と戦闘"]}],[{"headerIndex":55,"headerParam":["",0,0,2]}],[{"headerIndex":59,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":8,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":24,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":26,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098094646812.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}]],"indexIds":{"EV001":0,"商業ギルド":1,"EV002":2,"EV003":3,"EV004":4,"EV005":5,"EV006":6,"EV007":7,"EV008":8,"宿屋":9,"EV009":10,"武器防具店":11,"EV010":12,"アクセサリ店":13,"EV011":14,"魔法具店":15,"EV012":16,"卸売商会":17,"EV013":18,"聖堂":19,"EV014":20,"馬車屋":21,"奴隷2":22,"「もうやだ！　奴隷身分なんて耐えられない！\n　なんで男を騙して財産かすめ取ったくらいで、こんな目に\n　遭うの！？」\\nw[奴隷]":23,"EV016":24,"美術館":25,"女性":26,"「芸術の町の聖堂にしては変わり映えしないって批判も\n　あるけど、ここは祈りの場だからそれでいいと思うの」\\nw[信心深い女]":27,"王国官吏（依頼30）":28,"依頼を出している場合":29,"男性":30,"「この丁寧に掘り出された毛並みの美しさときたら……。\n　はぁ～……思わずため息が出てしまうよ」\\nw[地元の男]":31,"依頼フキダシ":32,"「西の山の抜け道を占領していた鬼が、誰かに倒された\n　らしい。\n　どこかの冒険者が退治したんだろうか？」\\nw[元冒険者]":33,"「\\C[17]西の山には抜け道がある\\C[0]んだけど、最近は鬼が出没する\n　んで通行止め状態なんだ。\\nw[元冒険者]":34,"「ボクが冒険者を引退した身でなければ、退治しに行ってた\n　かもね」\\nw[元冒険者]":35,"工事監督官（依頼31）":36,"「見た目がいいだけのナマクラな剣や鎧を買わされないよう、\n　注意した方がいいぞ。そういうのはディスプレイ用\n　だからな」\\nw[冒険者]":37,"研究者（依頼32)":38,"執事（依頼21）":39,"おっぱいマニア（依頼18）":40,"スケベじじい（依頼19）":41,"街ズームアウト":42,"P_D_FILENAME name_town\\V[101]":43,"「芸術の町！\n　ここで作られた彫像や絵画を、ウチの商会で運んだ\n　こともありましたよ！」\\nw[\\N[2]]":44,"「俺はまったく扱ったことが無いな。\n　贋作も多いから、経験の浅い人間は手が出しにくくてな」\\nw[\\N[1]]":45,"「買い付ける気があるなら、わたし手伝いますよ。\n　こう見えて審美眼には自信ありますから！」\\nw[\\N[2]]":46,"「じゃあ、とびきり卑猥な裸婦画でも仕入れるか？」\\nw[\\N[1]]":47,"「やっぱり手伝いません！！」\\nw[\\N[2]]":48,"EV035":49,"奴隷市":50,"奴隷市（フキダシ）":51,"奴隷市（通行不可）":52,"奴隷市（通行不可）＋モブ群衆":53,"芸術家1":54,"「王都の悪竜騒動からこっち、\\N[6]をモチーフに\n　した作品が増えておるようだ。\n　まったく、安直な者が多すぎるわい」\\nw[芸術家]":55,"「知ったような口振りで、芸術について語る輩の\n　なんと多いことか」\\nw[芸術家]":56,"依頼掲示板":57,"掲示板マーク":58,"兵士":59,"兵士（追跡）":60,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":61,"馬車":62,"通行遮断":63,"食料品店":64,"「この曲線、官能的すぎる！\n　ちょっと興奮してきたぞ……」\\nw[男性]":65,"淫行男2":66,"陰気な男":67,"「芸術なんてくだらねぇ……！\n　なにもかもブチ壊してやりてぇぜ……」\\nw[\\v[1655]]":68,"「絵や彫刻に勃起するクソどもと、オレは違うんだよ！\n　欲しいのは生身の女だ！」\\nw[\\v[1655]]":69,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":70,"売春させる":71,"やめておく":72,"浮気調査（依頼13・14・15）":73,"淫行表示":74,"尾行対象（依頼13・14・15）":75,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":76,"難易度ノーマル用":77,"難易度イージー用（振り向く前に立ち止まる時間が倍）":78,"視界範囲に引っかかったとき":79,"SmartPath 0 0 0":80,"周囲2マス圏内に侵入したとき":81,"尾行に気づいて逃走":82,"浮気相手の元へゴールしたとき":83,"ターゲット表示":84,"淫行男1":85,"目つきの悪い男":86,"「クスリが欲しいんなら他を当たんな。\n　オレは売人じゃねぇよ」\\nw[\\v[1655]]":87,"「その女の目……色狂いの目だ。\n　男なら誰でも咥えこんじまうんだろ？」\\nw[\\v[1655]]":88,"浮気相手(依頼11)":89,"個別依頼17":90,"アートな奴隷":91,"「アートってのはなぁ、反骨精神を忘れたら\n　終わりなんだよォッ！」\\nw[芸術家]":92,"「いきなりそんなこと言われても、わけがわからん」\\nw[\\N[1]]":93,"「固定観念にとらわれたバカ野郎どもを見返すために、\n　オレは奴隷アートを作ることにしたんだッ！」\\nw[芸術家]":94,"「それなら分かる。\n　お前さんのアートに使う奴隷を、俺に注文するって\n　いうんだな？」\\nw[\\N[1]]":95,"「その通りだッ！　鬼の赤肌がいいッ！\n　\\C[17]鬼奴隷\\C[0]を一人連れてきてくれッ！」\\nw[芸術家]":96,"「鬼という以外に、なにか好みとかは……？」\\nw[\\N[2]]":97,"「リビドーを爆発させたいから、\\C[17]巨乳\\C[0]だッ！\n　予算は\\C[17]７０００Ｇ\\C[0]で頼んだぜッ！\n　ついでにこの\\C[17]変な玉っころ\\C[0]もくれてやるから！」\\nw[芸術家]":98,"個別依頼『アートな奴隷』を受けますか？":99,"受ける":100,"受けない":101,"迷いの森・湖畔":102,"峠の抜け道":103,"個別依頼\\C[17]『アートな奴隷』\\C[0]を受けた！":104,"\\C[17]『\\in[135]』\\C[0]を依頼者に渡しますか？":105,"渡す":106,"渡さない":107,"依頼条件達成":108,"「鬼を捕まえてきたぞ。\n　どう使うんだか知らんが、これでいいよな？」\\nw[\\N[1]]":109,"「いいぞ、いいぞ！\n　この赤い肌がオレのキャンパスだッ！」\\nw[芸術家]":110,"個別依頼\\C[17]『アートな奴隷』\\C[0]を達成した！":111,"\nここでエッチイベント\n↓　　↓　　↓":112,"↓プレーヤー位置強制中央":113,"SFC_ENABLE_RESERVE":114,"依頼条件未達成":115,"「オレの奴隷アートのためにッ、さあ走れッ！\n　鬼を連れてくるんだッ！」\\nw[芸術家]":116,"\n\\>　　　　　～　芸術の町ペイサーの広場にて　～":117,"「さあ、見る目のあるヤツは集まりやがれ！\n　このオレの新作お披露目だッ！！」\\nw[芸術家]":118,"「なんだなんだ？　イベントでもあるのか？」\\nw[見物人Ａ]":119,"「おい、あいつは確か態度ばかりデカいって悪名高い\n　芸術家の――」\\nw[見物人Ｂ]":120,"「ああ、“イキリ芸術家”なんて呼ばれてるヤツだな」\\nw[見物人Ｃ]":121,"「誰がイキリだ！！　いいか大衆ども！\n　今日はお前らに、本物の芸術ってものを教えてやる！」\\nw[芸術家]":122,"「ふんっ、また大言壮語が始まったぞ」\\nw[見物人Ｂ]":123,"「どうせロクでもない物なんだろ？\n　まあ話のタネに見てやってもいいけど」\\nw[見物人Ａ]":124,"「本物の感動を味わいやがれ！\n　これがオレの芸術の神髄だぁッ！！」\\nw[芸術家]":125,"「なぜか大盛況だが、これはオレの望んでいたもの\n　じゃない！　なんでこうなったァ！？」\\nw[芸術家]":126,"「貴様ッ！！　公共の場でなにをしている！？\n　公然わいせつ罪で現行犯逮捕だッ！！」\\nw[警備兵]":127,"「ち、ちがうっ！　誤解だ！\n　これは正当な文化的活動で――」\\nw[芸術家]":128,"「なぁにが文化的活動だ！\n　これでお縄にされるのは何度目だと思っている！\\nw[警備兵]":129,"「毎回毎回、面倒をかけおって！\n　来いっ！　ブタ箱にブチ込んでやる」\\nw[警備兵]":130,"「いやぁ、すごいもの見れたなぁ」\\nw[見物人Ａ]":131,"「そして毎度おなじみの逮捕オチだったな」\\nw[見物人Ｂ]":132,"「連行された芸術家先生の次回作に期待しようぜ」\\nw[見物人Ｃ]":133,"↓プレーヤー位置強制中央解除":134,"SFC_DISABLE_RESERVE":135,"個別依頼『アートな奴隷』の達成報酬として\\C[17]７０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！":136,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":137,"依頼マーク":138,"「もし美術品強盗の情報があれば、すぐ知らせるように」\\nw[兵士]":139,"個別依頼07":140,"地上絵の野望":141,"「次回作は\\C[17]巨大な地上絵\\C[0]と決めているのだが、\n　これを作るには大量の奴隷が必要なのだ。\\nw[外道アーティスト]":142,"「奴隷商人なら、必要な奴隷その他もろもろを用意して\n　くれないか？\\nw[外道アーティスト]":143,"「まず欲しいのは肉体労働用の奴隷２人。\n　予算は１００００Ｇで」\\nw[外道アーティスト]":144,"「おっ！　キミキミ！　そこのキミィ！」\\nw[外道アーティスト]":145,"「ん？　俺のことか？」\\nw[\\N[1]]":146,"「実にいい！　素晴らしいね！\n　デッサンするからポーズをとってくれないか！」\\nw[外道アーティスト]":147,"「そ、そうか？\n　まあちょっとくらいなら構わないが……」\\nw[\\N[1]]":148,"（まんざらでもなさそう……）\\nw[\\N[2]]":149,"「いいよ、いいよぉ！\n　もっと足を開いて腰を落として！　そう！」\\nw[外道アーティスト]":150,"「こんな感じか？」\\nw[\\N[1]]":151,"「いいね！　じゃあ、右手に刃物を持ってると想像して！\n　その手を顔の前に！　目つきは猛禽のように鋭く！」\\nw[外道アーティスト]":152,"「刃物？　……ちょっと待て、いったいどういう\n　目的のデッサンなんだ、これは？」\\nw[\\N[1]]":153,"「アサシンの冷徹な狂気を絵にしようって試みさ！\n　タイトルはそうだな……『暗殺者の信条』！」\\nw[外道アーティスト]":154,"「あぁっ！　\\N[1]さんに対する一番の禁句を……」\\nw[\\N[2]]":155,"「またかッ！　お前もかッ！\n　俺は奴隷商人だ！　異論は許さんッ！！」\\nw[\\N[1]]":156,"「ほう！　奴隷商人！\n　そいつはいい。実にいいね！」\\nw[外道アーティスト]":157,"「あ゛ぁん！？」\\nw[\\N[1]]":158,"「奴隷商人なら、必要な奴隷その他もろもろを用意して\n　くれないか？」\\nw[外道アーティスト]":159,"「フンッ！　仕事なら受けてやらんでもないが……\n　なにがどれくらい必要になるんだ？」\\nw[\\N[1]]":160,"「それがはっきりと分からないんだ。\n　なにせ初めてのことで、手探り状態で作業を進めて\n　いくんでね。\\nw[外道アーティスト]":161,"「必要に応じてその都度、追加発注させてもらうよ。\\nw[外道アーティスト]":162,"「まず欲しいのは\\C[17]肉体労働用の奴隷２人\\C[0]だ。\n　予算は\\C[17]１００００Ｇ\\C[0]で」\\nw[外道アーティスト]":163,"個別依頼『地上絵の野望』を受けますか？\n（※この依頼は数回に渡って商品を届けることになります）":164,"個別依頼\\C[17]『地上絵の野望』\\C[0]を受けた！":165,"「ＯＫ！　契約成立だ！\n　よろしく頼んだよ！」\\nw[外道アーティスト]":166,"依頼品：肉体労働用の奴隷２人":167,"配送先：芸術の町ペイサー":168,"10000G":169,"「\\C[17]肉体労働用の奴隷２人\\C[0]、持ってきてくれたのかい？」\\nw[外道アーティスト]":170,"労働奴隷を所持しているかチェック":171,"肉体労働用の奴隷":172,"奴隷が規定人数以上あるとき":173,"奴隷が規定人数以下のとき":174,"「早いところ頼むよぉ！\n　奴隷が届いたらすぐにでも、地上絵の製作にとりかかる\n　つもりだから」\\nw[外道アーティスト]":175,"「ほらよ。ご注文の品だ」\\nw[\\N[1]]":176,"「いいね！　よく働いてくれそうだ！」\\nw[外道アーティスト]":177,"依頼者に肉体労働用の奴隷２人を渡した！\n報酬として\\C[17]１００００Ｇ\\C[0]を入手した！":178,"「では私は早速、地上絵の製作に取りかかるとするよ。\\nw[外道アーティスト]":179,"「作業場所は\\C[17]大聖堂の西方に広がる草原\\C[0]だ！\n　次の奴隷はそこへ連れてきて欲しい」\\nw[外道アーティスト]":180,"「次の奴隷？」\\nw[\\N[2]]":181,"「補充用さ。\n　その奴隷が到着する頃には、今回買った奴隷は使い潰して\n　いるだろうからね」\\nw[外道アーティスト]":182,"「お前が外道呼ばわりされている理由が、よくわかったぜ」\\nw[\\N[1]]":183,"（外道ぶりなら\\N[1]さんも負けてないと思うけど、\n　言えば怒られるから黙ってよう）\\nw[\\N[2]]":184,"「次は\\C[17]肉体労働用の奴隷２人\\C[0]を\\C[17]１２０００Ｇ\\C[0]で頼むよ！」\\nw[外道アーティスト]":185,"個別依頼\\C[17]『地上絵の野望』\\C[0]の追加発注を受けた！":186,"「では私は現場へ向かうので、奴隷の手配はよろしく！」\\nw[外道アーティスト]":187,"配送先：大聖堂西方の草原地帯":188,"12000G":189,"街中淫行制御":190,"盗賊1":191,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":192,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":193,"「邪魔をするなら殺す！」\\nw[蛮族]":194,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":195,"奴隷化性別：0=女、1=男、2=男女ランダム":196,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":197,"芸術家2":198,"\\{「うんちょろぼげぇ～ッ！！」\\}\\nw[芸術家]":199,"「……ハッ？！　す、すまない。\n　いいアイディアが思い浮かんだもので、つい叫んで\n　しまったよ」\\nw[芸術家]":200,"観光客":201,"「芸術のことはよく分からないけど、なかなか\n　楽しい町だったわ」\\nw[観光客]":202,"案内板":203,"\\>　↑　広場\n\n\\>　↓　ペイサー美術館":204,"戦闘マーク":205,"街中盗賊出没":206,"奴隷1":207,"「町中の像を磨くのが俺の仕事なんだ。\n　奴隷の仕事としては、マシな部類だろうぜ」\\nw[奴隷]":208,"売り家表示":209,"EV077":210,"EV078":211,"EV079":212,"民家":213,"EV080":214,"市民（主婦）":215,"「町の美術館って、地元の人間はあまり行かないのよね。\n　観光施設なんてそんなものよ」\\nw[主婦]":216,"EV082":217,"女の子":218,"「わたしもおっきくなったら、ゲージュツカになるの！\n　お絵かきとくいだから！」\\nw[女の子]":219,"自宅入り口":220,"自宅":221,"景気ランタン":222,"通行不可":223,"ＢＧＭ変更":224,"夜間用ＢＧＭ演奏":225,"夜→昼":226,"最初から昼":227,"昼→夜":228,"最初から夜":229,"フクロウ":230,"\\>\\{　　　　　≪ペイサー美術館≫\n\\>\\}　　　　　　　　開館時間 07：00～19:00":231,"落ちてる精霊石（街）":232,"依頼01・02戦闘":233,"依頼を引き受けている場合、暴漢と戦闘":234,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":235,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":236,"暴漢と戦闘":237,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":238,"襲ってきた暴漢を街の警備兵に引き渡した。":239,"暴漢":240,"猫":241,"アヒル":242,"レイプ魔":243,"レイプ被害者":244,"レイプマーク":245,"レイプEv向き合わせ":246,"レイプEv発生制御":247,"レイプ現場遭遇":248,"マップ取得":249,"FocusCamera 25 24 120":250,"ZoomOut 3 120":251,"\\C[17]\\V[906]の地図\\C[0]を取得した！":252,"ResetZoom 60":253,"ResetFocus 60":254,"街中イーグルダイブ":255,"ここから飛び降りますか？":256,"飛び降りる":257,"やめる":258,"屋根通行不可":259,"水柱1":260,"HEv17用鬼奴隷":261,"警備兵（個別依頼17用）":262,"EV116":263,"娼館":264,"掲示板依頼初期化おばあちゃん":265,"<TE:110>":266,"四聖教メッセンジャー":267,"<TE:112>":268,"会話マーク(EX)":269,"<TE:113>":270},"extension":"json","dataType":"map","filename":"Map049","basename":"Map049.json","path":"data/Map049.json","relPath":"data/Map049.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":271,"percent":0.7380073800738007},"cellInfo":[]},"data/Map050.json":{"data":[["EV001",""],["宿屋",""],["EV002",""],["家具職人",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["舟",""],["船頭",""],["「普段は運賃をもらって\\C[17]島の町シーグヌース\\C[0]まで\n　舟を渡してるんだがなぁ。\n　今は海賊が暴れ回っているから無理だ」\\nw[船頭]",""],["船マーク",""],["奴隷買い取り（フキダシ）",""],["村人（奴隷買い取り）",""],["屋外トイレドア（排泄Ev）",""],["<TE:80>",""],["トイレマーク",""],["ニワトリ",""],["海産物売買フキダシ",""],["漁師",""],["主婦",""],["「獲った魚の半分以上は、干したり塩漬けにしたりして、\n　保存食にするのよ」\\nw[主婦]",""],["男の子",""],["「あれ？　カニは？\n　さっきまでそこにいたのに」\\nw[男の子]",""],["「魚を獲ってると、たまに海の魔物と出会うことがある。\n　そういうときは、一も二もなく逃げるんだけどね」\\nw[漁師]",""],["EV020",""],["民家",""],["EV021",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["落ちてる精霊石（街）",""],["マップ取得",""],["FocusCamera 19 17 120",""],["ZoomOut 2.2 120",""],["\\C[17]\\V[916]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["景気ランタン",""],["猫",""]],"context":[["Map050/events/1/name"],["Map050/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map050/events/2/name"],["Map050/events/2/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map050/events/3/name"],["Map050/events/4/name"],["Map050/events/5/name"],["Map050/events/6/name"],["Map050/events/7/name"],["Map050/events/8/name"],["Map050/events/8/pages/0/list/4/message/noPicture/bottom"],["Map050/events/9/name"],["Map050/events/10/name"],["Map050/events/11/name"],["Map050/events/12/name"],["Map050/events/12/note"],["Map050/events/13/name"],["Map050/events/14/name"],["Map050/events/15/name"],["Map050/events/16/name","Map050/events/19/name"],["Map050/events/17/name"],["Map050/events/17/pages/1/list/0/message/noPicture/bottom"],["Map050/events/18/name"],["Map050/events/18/pages/1/list/0/message/noPicture/bottom"],["Map050/events/19/pages/1/list/0/message/noPicture/bottom"],["Map050/events/20/name"],["Map050/events/20/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0","Map050/events/21/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map050/events/21/name"],["Map050/events/22/name"],["Map050/events/22/pages/0/list/0/comment"],["Map050/events/22/pages/1/list/1/comment"],["Map050/events/22/pages/1/list/11/comment"],["Map050/events/22/pages/2/list/1/comment"],["Map050/events/22/pages/2/list/11/comment"],["Map050/events/23/name"],["Map050/events/24/name"],["Map050/events/24/pages/0/list/7/P