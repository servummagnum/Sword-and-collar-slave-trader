Break":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":17,"percent":0},"cellInfo":[]},"data/Map020.json":{"data":[["EV001",""],["EV002",""],["火",""],["光",""],["村長",""],["「あんた、確か前は普通の行商人だったよね？\n　奴隷商人に鞍替えしたって？\n　そりゃまた、思い切ったことを」\\nw[村長]",""],["窃盗用下着1",""],["<TE:116>",""]],"context":[["Map020/events/1/name"],["Map020/events/2/name"],["Map020/events/3/name"],["Map020/events/4/name"],["Map020/events/5/name"],["Map020/events/5/pages/0/list/0/message/noPicture/bottom"],["Map020/events/6/name"],["Map020/events/6/note"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"火":2,"光":3,"村長":4,"「あんた、確か前は普通の行商人だったよね？\n　奴隷商人に鞍替えしたって？\n　そりゃまた、思い切ったことを」\\nw[村長]":5,"窃盗用下着1":6,"<TE:116>":7},"extension":"json","dataType":"map","filename":"Map020","basename":"Map020.json","path":"data/Map020.json","relPath":"data/Map020.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":8,"percent":0},"cellInfo":[]},"data/Map021.json":{"data":[["豚",""],["EV007",""],["EV008",""]],"context":[["Map021/events/1/name","Map021/events/2/name","Map021/events/3/name","Map021/events/4/name","Map021/events/5/name","Map021/events/6/name"],["Map021/events/7/name"],["Map021/events/8/name"]],"tags":[["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"豚":0,"EV007":1,"EV008":2},"extension":"json","dataType":"map","filename":"Map021","basename":"Map021.json","path":"data/Map021.json","relPath":"data/Map021.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":3,"percent":0},"cellInfo":[]},"data/Map022.json":{"data":[["農民",""],["牛",""],["逃走防止用",""],["宿屋入り口",""],["宿屋",""],["EV011",""],["民家",""],["EV012",""],["EV013",""],["ニワトリ",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["家具職人",""],["蜂",""],["羊",""],["個別依頼02",""],["山脈の抜け道Ａ",""],["「\\C[17]山の抜け道\\C[0]が使えなくなってから、王都方面への\n　行き来がすっかり難しくなってしまった……」\\nw[村民]",""],["「抜け道？\n　そんなものがあるんですか？」\\nw[\\N[2]]",""],["「ああ、ここから\\C[17]北へ行ったところに洞窟\\C[0]があって、\n　そこが大山脈の反対側にまで通じているんだ」\\nw[村民]",""],["すでに岩を除去して抜け道が通行できるとき",""],["「もしかして、岩で塞がれていたヤツか？\n　それだったら、俺たちが岩をどかして通れるように\n　しといたぞ」\\nw[\\N[1]]",""],["「ほっ、本当なのかっ、その話！？」\\nw[村民]",""],["「ほんとうですよ。\n　偶然あそこを通ることになって、そうしたら岩が邪魔\n　だったので」\\nw[\\N[2]]",""],["「そいつは素晴らしい！\n　\\C[17]報酬５０００Ｇ\\C[0]で岩除去の依頼を出しても、誰も\n　来てくれなかったんだが――」\\nw[村民]",""],["「その５０００Ｇは、当然俺たちにくれるんだよな？」\\nw[\\N[1]]",""],["「えっ……いや、それは……あんたに依頼したわけじゃ\nないし……」\\nw[村民]",""],["「じゃあ抜け道を埋め戻してくるか」\\nw[\\N[1]]",""],["「ちょ、ちょ、ちょっ、ちょっと待った！\n　払う！　払いますからァ！！」\\nw[村民]",""],["個別依頼\\C[17]『山脈の抜け道Ａ』\\C[0]を達成した！",""],["報酬として\\C[17]５０００Ｇ\\C[0]入手した！\n\\N[2]の信頼度が\\C[17]「９」\\C[0]上がった！",""],["ver.1.0.3での修正前に、個別依頼02を受け無い状態で東洞窟をクリアしてしまうと\nダンジョンクリアのフラグが立たない。その場合ここでフラグを立てる。",""],["まだ抜け道通行不可のとき",""],["「あの邪魔くさい大山脈を、ショートカットできるって\n　いうのか！？　そいつはスゴイな！」\\nw[\\N[1]]",""],["「ただし、洞窟にはモンスターが巣食っている。\n　だから地元の人間が長年かけて、安全に迂回できる\n　抜け道を掘ったんだ」\\nw[村民]",""],["「ところがその便利な抜け道が使えなくなって\n　しまった、と？」\\nw[\\N[1]]",""],["「そうなんだ。\n　天井の一部が崩落して、抜け道の出入り口が岩で\n　塞がれてしまってな。\\nw[村民]",""],["「岩をどかしたくても、モンスターのそばで復旧作業は\n　危険だし……。\\nw[村民]",""],["「かと言って、冒険者を雇って作業してもらおうにも、\n　予算が\\C[17]５０００Ｇ\\C[0]では誰も来てくれない……。\n　ハァ……困ったものだ」」\\nw[村民]",""],["個別依頼『山脈の抜け道Ａ』を受けますか？",""],["受ける",""],["受けない",""],["「よしっ！　その作業依頼、俺たちが引き受けた！」\\nw[\\N[1]]",""],["「また安請け合いして、大丈夫ですかぁ？」\\nw[\\N[2]]",""],["個別依頼\\C[17]『山脈の抜け道Ａ』\\C[0]を受けた！",""],["依頼条件達成",""],["「抜け道を塞いでいる邪魔な岩をどかしてきたぞ。\n　これで大山脈の北側までショートカット可能だ」\\nw[\\N[1]]",""],["「ありがとう！　本当に助かった！\n　村を代表してお礼を言わせてもらうよ！」\\nw[村民]",""],["依頼条件未達成",""],["「抜け道のある洞窟は、ここから北に行ったところだ。\n　邪魔な岩の除去、よろしく頼んだよ」\\nw[村民]",""],["依頼マーク",""],["養蜂箱",""],["ハチミツを採るための養蜂箱だ。",""],["村人（奴隷買い取り）",""],["奴隷買い取り（フキダシ）",""],["農作物売買フキダシ",""],["女の子",""],["「だいじょうぶ。\n　わるいことしなきゃ、さされないよ」\\nw[女の子]",""],["農婦",""],["「王都でモンスターが暴れたんですって？\n　え、暴れたのは悪竜？　あれはおとぎ話でしょ？」\\nw[農婦]",""],["「ここは海から遠いから、あまりお魚を食べられないのが\n　残念ね」\\nw[農婦]",""],["「別の大型のハチが巣を襲って、女王蜂を殺して\n　しまうこともあるんだ。\n　もちろんミツバツも抵抗して戦うがね」\\nw[養蜂家]",""],["奴隷2",""],["「断言できるね。\n　牛のフンをひたすら回収するこの仕事は、野盗以下の\n　最低な仕事だ！」\\nw[奴隷]",""],["男の子",""],["「井戸って、オバケがでてきそうでこわいなぁ」\\nw[男の子]",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["屋外トイレドア（排泄Ev）",""],["<TE:80>",""],["トイレマーク",""],["景気ランタン",""],["落ちてる精霊石（街）",""],["犬",""],["マップ取得",""],["FocusCamera 20 15 120",""],["ZoomOut 2.3 120",""],["\\C[17]\\V[914]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""]],"context":[["Map022/events/1/name","Map022/events/51/name"],["Map022/events/2/name","Map022/events/3/name","Map022/events/4/name","Map022/events/5/name","Map022/events/6/name"],["Map022/events/7/name","Map022/events/8/name","Map022/events/9/name","Map022/events/23/name"],["Map022/events/10/name"],["Map022/events/10/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map022/events/11/name"],["Map022/events/11/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map022/events/12/name"],["Map022/events/13/name"],["Map022/events/14/name","Map022/events/15/name"],["Map022/events/16/name"],["Map022/events/17/name"],["Map022/events/18/name"],["Map022/events/19/name"],["Map022/events/20/name"],["Map022/events/21/name"],["Map022/events/21/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map022/events/22/name","Map022/events/29/name","Map022/events/30/name","Map022/events/31/name","Map022/events/32/name","Map022/events/33/name","Map022/events/34/name","Map022/events/35/name","Map022/events/36/name","Map022/events/43/name","Map022/events/44/name","Map022/events/45/name"],["Map022/events/24/name","Map022/events/25/name","Map022/events/26/name","Map022/events/27/name","Map022/events/28/name"],["Map022/events/37/name"],["Map022/events/37/pages/0/list/0/comment"],["Map022/events/37/pages/0/list/5/message/noPicture/bottom"],["Map022/events/37/pages/0/list/19/