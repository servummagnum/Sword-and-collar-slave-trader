17]『山脈の抜け道Ｂ』\\C[0]を受けた！":40,"依頼条件達成":41,"「鬼どもを残らず退治してきたぞ。\n　これで抜け道は往来可能だ」\\nw[\\N[1]]":42,"「す、すごい！　助かったよ！\n　ありがとう、ほんとうにありがとう！」\\nw[村民]":43,"依頼条件未達成":44,"「この村から\\C[17]東\\C[0]へ行けば抜け道がある。\n　退治して欲しい鬼はそこを占領してるんだ」\\nw[村民]":45,"掲示板マーク":46,"養蜂箱":47,"ハチミツを採るための養蜂箱だ。":48,"村人（奴隷買い取り）":49,"奴隷市（フキダシ）":50,"農民":51,"農作物売買フキダシ":52,"ニワトリ":53,"村長":54,"「最近雨が少ないから、作物の元気がないな。\n　そろそろひと降り来てもらいたいものだ」\\nw[村長]":55,"男の子":56,"「羊がにげないように、みはってるんだ！」\\nw[男の子]":57,"牧羊犬":58,"EV044":59,"民家":60,"主婦":61,"「あなたたちが鬼を倒した！？\n　信じられない！　ほんとなの！？」\\nw[農婦]":62,"「東の山には鬼がいるのよ。\n　無理に山道を通ろうとすると、襲ってくるの」\\nw[農婦]":63,"EV046":64,"ＢＧＭ変更":65,"夜間用ＢＧＭ演奏":66,"夜→昼":67,"最初から昼":68,"昼→夜":69,"最初から夜":70,"屋外トイレドア（排泄Ev）":71,"<TE:80>":72,"トイレマーク":73,"景気ランタン":74,"EV051":75,"家具職人":76,"落ちてる精霊石（街）":77,"マップ取得":78,"FocusCamera 17 17 120":79,"ZoomOut 2.3 120":80,"\\C[17]\\V[911]の地図\\C[0]を取得した！":81,"ResetZoom 60":82,"ResetFocus 60":83},"extension":"json","dataType":"map","filename":"Map047","basename":"Map047.json","path":"data/Map047.json","relPath":"data/Map047.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":84,"percent":0},"cellInfo":[]},"data/Map048.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["商業ギルド",""],["EV008",""],["宿屋",""],["EV009",""],["武器防具店",""],["EV010",""],["アクセサリ店",""],["EV011",""],["魔法具店",""],["EV012",""],["卸売商会",""],["EV013",""],["聖堂",""],["EV014",""],["馬車屋","Stagecoach shop"],["王国官吏（依頼30）",""],["依頼を出している場合",""],["女性",""],["「神様、神様、どうか彼とあの女の仲を引き裂いて\n　ください……」\\nw[信心深い女]",""],["依頼フキダシ",""],["男性",""],["「よそから来た人は、坂道が多いって文句を言うけど、\n　それこそがこの町の個性なのさ」\\nw[地元の男]",""],["「ここから北へ行くと\\C[17]水の塔\\C[0]というダンジョンがあるんだ。\n　若い頃はそこで腕を磨いたものさ。\n　最上階まで行けたためしは無かったけど……」\\nw[元冒険者]",""],["「この町、店の位置が分かりにくいのよね。\n　だいぶ歩き回っちゃったわ」\\nw[冒険者]",""],["工事監督官（依頼31）",""],["執事（依頼21）",""],["EV028",""],["民家",""],["レイプ現場遭遇",""],["スケベじじい（依頼19）",""],["馬車",""],["通行遮断",""],["研究者（依頼32)",""],["おっぱいマニア（依頼18）",""],["街ズームアウト",""],["P_D_FILENAME name_town\\V[101]",""],["「こんな丘陵地帯にも町があったんですねぇ」\\nw[\\N[2]]",""],["「家屋を建てるのにはあまり適してなさそうだが、\n　外敵からは守りやすそうだな」\\nw[\\N[1]]",""],["個別依頼16",""],["臨床試験体",""],["「家に閉じこもって薬品の開発ばかりやってると、\n　どうしても体が鈍っちゃうんだよね。\\nw[研究者]",""],["「だからこうして、たまには外出するんだ」\\nw[研究者]",""],["「薬の研究者か。\n　どういった薬品の開発を？」\\nw[\\N[1]]",""],["「媚薬とか精力剤だよ」\\nw[研究者]",""],["「そいつは素晴らしい仕事だ」\\nw[\\N[1]]",""],["「ええ、とっても素敵なお仕事ですね。\n　そのお薬、ちょっと試してみたいなぁ\\I[29]」\\nw[\\N[2]]",""],["「ぜんぜんまったく素晴らしくないです」\\nw[\\N[2]]",""],["「ところで新しい薬品を開発するために、臨床試験用の\n　奴隷が欲しいんだ。頼めるかな？」\\nw[研究者]",""],["「どんな奴隷がいいんだ？」\\nw[\\N[1]]",""],["「そこらにいるような\\C[17]普通の人間の女\\C[0]でいいよ。\n　ただし僕、おっぱいが嫌いなんで\\C[17]貧乳\\C[0]がいいな」\\nw[研究者]",""],["「おっぱい嫌いとは珍しい。\n　好みは人それぞれだから、別にいいが」\\nw[\\N[1]]",""],["「ちなみに、お代は現物支払いで。\n　僕の書いた\\C[17]\\in[49]\\C[0]と\\C[17]\\in[22]２個\\C[0]を進呈するよ」\\nw[研究者]",""],["個別依頼『臨床試験体』を受けますか？",""],["受ける",""],["受けない",""],["地下遺跡・2層",""],["大山脈西洞窟",""],["個別依頼\\C[17]『臨床試験体』\\C[0]を受けた！",""],["\\C[17]『\\in[101]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「ほらよ。頼まれてた貧乳奴隷だ」\\nw[\\N[1]]",""],["「いやぁ、助かるよ。\n　これで新しい薬の開発に着手できる。\\nw[研究者]",""],["「ありがとう、奴隷商人さん。\n　それじゃこれ、お礼の品ね」\\nw[研究者]",""],["個別依頼\\C[17]『臨床試験体』\\C[0]を達成した！",""],["\nここからエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「奴隷の件、頼むよ。\n　連れてきてもらわないと、研究が始められないから」\\nw[研究者]",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["依頼マーク",""],["聖堂通行不可スイッチ",""],["食料品店",""],["通行不可",""],["浮気調査（依頼13・14・15）",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 12 0",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ターゲット表示",""],["浮気相手(依頼11)",""],["「今日も平和だなぁ」\\nw[兵士]",""],["奴隷市",""],["奴隷市（フキダシ）",""],["奴隷市（通行不可）",""],["EV071",""],["市民（男）",""],["「うぅ……腹がギュルギュル鳴ってる……。\n　嫁のメシを食ったせいで……」\\nw[金髪の男]",""],["市民（老人）",""],["「おいおい、大丈夫かね？」\\nw[老人]",""],["男の子",""],["「かくれんぼ中だから、こっち来ないで！」\\nw[男の子]",""],["女の子",""],["「どこ行ったんだろ？\n　あの子ったら、かくれんぼ上手すぎるのよ！」\\nw[女の子]",""],["水兵",""],["「なんで船乗りの格好をしてるのかって？\n　俺は水兵だからさ。\n　休暇中でも心は海の男ってね」\\nw[水兵]",""],["奴隷2",""],["「窃盗がバレて奴隷に堕ちたのは運がなかったけど、\n　売られた先の主人は金持ちだったわ。\n　どうにかして財産を奪ってやる……！」\\nw[女奴隷]",""],["市民（主婦）1",""],["「この前うちの主人ったら、盗賊に追っかけられたのよ。\n　足が速いから逃げ切れたけど、下手をしたら今頃は\n　死んでたかも」\\nw[主婦]",""],["「王様が替わったそうだけど、今度はちゃんと盗賊や\n　危険亜人を取り締まってくれるかしら？」\\nw[主婦]",""],["「最近、盗賊や危険な亜人が増えてきたわね。\n　王様がちゃんとしないからだって、噂になってるわ」\\nw[主婦]",""],["市民（男性）1",""],["「旅の最中に聞いたのだが、王都で退治された悪竜は\n　\\N[5]姫に化けていたそうだ。\n　いったいいつから入れ替わっていたんだろうな？」\\nw[男性]",""],["「旅のついでに寄ったのだが、この町はなかなか\n　住みやすそうだ。\n　移住先として考えてみても、いいかもしれんな」\\nw[男性]",""],["「かくれんぼマスターのわたしを、よく見つけられ\n　ましたね。\n　あなたはもしや、キング・オブ・かくれんぼ？」\\nw[女の子]",""],["売り家表示",""],["自宅入り口",""],["自宅","Player home"],["EV085",""],["EV086",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["戦闘マーク",""],["景気ランタン",""],["落ちてる精霊石（街）",""],["依頼01・02戦闘",""],["依頼を引き受けている場合、暴漢と戦闘",""],["「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]",""],["\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]",""],["暴漢と戦闘",""],["「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]",""],["襲ってきた暴漢を街の警備兵に引き渡した。",""],["暴漢",""],["犬",""],["レイプ魔",""],["レイプ被害者",""],["レイプマーク",""],["レイプEv向き合わせ",""],["レイプEv発生制御",""],["街中盗賊出没",""],["淫行男1",""],["ガラの悪い男",""],["「オレに用でもあんのか？\n　用もないのに声かけたんならブン殴るぞ？」\\nw[\\v[1655]]",""],["「ぐへへ……いいメス奴隷連れてんじゃねぇか。\n　見たところ調教済みか？」\\nw[\\v[1655]]",""],["\\N[2]をこの男と\\C[27]売春\\C[0]させますか？",""],["売春させる",""],["やめておく",""],["淫行表示",""],["街中淫行制御",""],["淫行男2",""],["顔を隠した男",""],["「しっ！　しっ！　寄ってくんな！\n　野良犬みてぇな野郎め！」\\nw[\\v[1655]]",""],["「そういや最近、女を抱いてねぇな。\n　……その女奴隷、レンタルしてるか？」\\nw[\\v[1655]]",""],["EV108",""],["娼館",""],["マップ取得",""],["FocusCamera 25 20 120",""],["ZoomOut 2.5 120",""],["\\C[17]\\V[905]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],