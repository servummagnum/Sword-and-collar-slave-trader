ex":3,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["すでにダークエルフの里で交渉済みの場合"]}],[{"headerIndex":70,"headerParam":["",0,1,1]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":95,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":103,"headerParam":["",0,0,2]}],[{"headerIndex":106,"headerParam":["",0,0,2]}],[{"headerIndex":111,"headerParam":["",0,0,2]}],[{"headerIndex":119,"headerParam":["",0,0,2]}],[{"headerIndex":127,"headerParam":["",0,0,2]}],[{"headerIndex":135,"headerParam":["",0,0,2]}],[{"headerIndex":141,"headerParam":["",0,0,2]}],[{"headerIndex":146,"headerParam":["",0,0,2]}],[{"headerIndex":149,"headerParam":["",0,0,2]}],[{"headerIndex":168,"headerParam":["",0,0,2]}],[{"headerIndex":176,"headerParam":["",0,0,2]}],[{"headerIndex":180,"headerParam":["",0,0,2]}],[{"headerIndex":186,"headerParam":["",0,0,2]}],[{"headerIndex":189,"headerParam":["",0,0,2]}],[{"headerIndex":191,"headerParam":["",0,0,2]}],[{"headerIndex":196,"headerParam":["",0,0,2]}],[{"headerIndex":200,"headerParam":["",0,0,2]}],[{"headerIndex":204,"headerParam":["",0,0,2]}],[{"headerIndex":207,"headerParam":["",0,0,2]}],[{"headerIndex":210,"headerParam":["",0,0,2]}],[{"headerIndex":213,"headerParam":["",0,0,2]}],[{"headerIndex":219,"headerParam":["",0,0,2]}],[{"headerIndex":223,"headerParam":["",0,0,2]}],[{"headerIndex":227,"headerParam":["",0,0,2]}],[{"headerIndex":230,"headerParam":["",0,0,2]}],[{"headerIndex":234,"headerParam":["",0,0,2]}],[{"headerIndex":238,"headerParam":["",0,0,2]}],[{"headerIndex":241,"headerParam":["",0,0,2]}],[{"headerIndex":250,"headerParam":["",0,0,2]}],[{"headerIndex":257,"headerParam":["",0,0,2]}],[{"headerIndex":262,"headerParam":["",0,0,2]}],[{"headerIndex":267,"headerParam":["",0,0,2]}],[{"headerIndex":270,"headerParam":["",0,0,2]}],[{"headerIndex":276,"headerParam":["",0,0,2]}],[{"headerIndex":279,"headerParam":["",0,0,2]}],[{"headerIndex":282,"headerParam":["",0,0,2]}],[{"headerIndex":287,"headerParam":["",0,0,2]}],[{"headerIndex":290,"headerParam":["",0,0,2]}],[{"headerIndex":294,"headerParam":["",0,0,2]}],[{"headerIndex":301,"headerParam":["",0,0,2]}],[{"headerIndex":305,"headerParam":["",0,0,2]}],[{"headerIndex":319,"headerParam":["",0,0,2]}],[{"headerIndex":343,"headerParam":["",0,0,2]}],[{"headerIndex":347,"headerParam":["",0,0,2]}],[{"headerIndex":350,"headerParam":["",0,0,2]}],[{"headerIndex":355,"headerParam":[""]}],[{"headerIndex":387,"headerParam":["↑　　↑　　↑"]}],[{"headerIndex":402,"headerParam":["",0,0,2]}],[{"headerIndex":408,"headerParam":["",0,0,2]}],[{"headerIndex":411,"headerParam":["",0,0,2]}],[{"headerIndex":420,"headerParam":["",0,0,2]}],[{"headerIndex":436,"headerParam":["",0,0,2]}],[{"headerIndex":440,"headerParam":["",0,0,1]}],[{"headerIndex":451,"headerParam":["",0,0,2]}],[{"headerIndex":459,"headerParam":["",0,0,2]}],[{"headerIndex":465,"headerParam":["",0,0,2]}],[{"headerIndex":472,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["particles : 0 : 30 : 1 : 0 : -3.5 : 1 : Waterfall_0"]}]],"indexIds":{"影":0,"木":1,"通行止め":2,"ライティング":3,"森へ":4,"Ｈエルフ長老":5,"交渉用の\\C[17]ダークエルフ奴隷\\C[0]がいないと、長老と話しても\nムダだ……。":6,"すでにダークエルフの里で交渉済みの場合":7,"\n　　　　～　ハイエルフの族長と交渉中　～":8,"「この里に人間が来るなど、何十年ぶりか。\n　前回来た者は、生きて森を出ることはなかったがな」\\nw[ハイエルフ族長]":9,"「脅しはよしてくれ。\n　なにもケンカをしに来たわけじゃないんだからな」\\nw[\\N[1]]":10,"「ハイエルフの族長よ、あんたたちはダークエルフと\n　違って、品格と礼節を持っているはずだ。\\nw[\\N[1]]":11,"「だから俺はダークエルフの森には行かず、ここに来た」\\nw[\\N[1]]":12,"「それで褒めているつもりか、人間よ？\n　……まあよい、話すだけ話してみよ」\\nw[ハイエルフ族長]":13,"「エルフのみが持つという、『精霊性具』が欲しい」\\nw[\\N[1]]":14,"「精霊性具だと！？\n　それが目的か、強欲な人間め！」\\nw[ハイエルフ男]":15,"「族長、これ以上話を聞く必要などありません！\n　殺して森の外へ捨ててしまいましょう！」\\nw[ハイエルフ女]":16,"「あわわわっ……！\n　\\N[1]さん、まずいですよコレ！」\\nw[\\N[2]]":17,"「エルフってのは血の気が多いな。\n　最後まで話を聞くだけの忍耐もないのか？」\\nw[\\N[1]]":18,"「なんだとぉ！？」\\nw[ハイエルフ男]":19,"「話を聞かないっていうなら、先にモノを見せようか。\n　続きはそれからだ」\\nw[\\N[1]]":20,"「そやつは、忌むべき闇肌ではないか！？\n　しかも金髪！！」\\nw[ハイエルフ族長]":21,"（き、金髪好きって事前情報はホントだったんだ……）\\nw[\\N[2]]":22,"「そいつは手土産だ。\n　煮るなり焼くなり、好きにしてくれ」\\nw[\\N[1]]":23,"「我々にとって闇肌ども――つまりダークエルフどもは、\n　仇敵であると同時に家畜のようなものだ。\\nw[ハイエルフ族長]":24,"「家畜の贈り物は礼に適ってはいる……が。\\nw[ハイエルフ族長]":25,"「さすがにこの奴隷一人と精霊性具とを交換では、\n　価値が釣り合わんぞ？」\\nw[ハイエルフ族長]":26,"「まあ、そりゃそうだろうな。\n　俺も奴隷一人分の価値しかない物のために、こんな\n　遠方まで足を運んだりはしないさ。\\nw[\\N[1]]":27,"「そのダークエルフは、こちらからの誠意の証だと\n　思ってくれ。\\nw[\\N[1]]":28,"「俺は奴隷商人だからな、ダークエルフの奴隷は今後\n　いくらでも取り扱う機会がある。\\nw[\\N[1]]":29,"「もし精霊性具をもらえるなら、何度でもここへ\n　ダークエルフ奴隷を売りに来ようじゃないか」\\nw[\\N[1]]":30,"「無料とはいかないが、原価ギリギリの大特価で\n　お渡ししちゃうぜ？」\\nw[\\N[1]]":31,"\\}「もちろん、金髪奴隷を優先的に連れてくるから（こっそり）」\\{\\nw[\\N[1]]":32,"「うむむむ……悪くない話のようにも……\\}きんぱつ……\\{」\\nw[ハイエルフ族長]":33,"「ところでそこの男エルフ！　女の好みは？」\\nw[\\N[1]]":34,"「え……きょ、巨乳……かな……」\\nw[ハイエルフ男]":35,"「そっちの女エルフ！　どんな男がいい？」\\nw[\\N[1]]":36,"「い、いきなり聞かれても……背が高くて筋肉質とか……」\\nw[ハイエルフ女]":37,"「ならば、巨乳女も筋肉男も、首に鎖をつけて連れてきて\n　やろう！\\nw[\\N[1]]":38,"「好き勝手していい家畜同然のダークエルフが\n　里に増えるぞ！」\\nw[\\N[1]]":39,"「\\N[1]さん……。\n　普段から悪い顔してますけど、今回は一段と悪辣な\n　お顔ですね……」\\nw[\\N[2]]":40,"「うるさい、黙れ。\n　俺の高度な交渉術を邪魔するな」\\nw[\\N[1]]":41,"「ぞ、族長……こいつの提案は……その、悪くないかもなぁ\n　なんて……」\n（巨乳奴隷！　巨乳奴隷ぇッ！）\\nw[ハイエルフ男]":42,"「ちょっとくらい耳を傾けてあげても……まあ……」\n（マッチョ奴隷にやりたい放題ッ……！）\\nw[ハイエルフ女]":43,"「そうだな……精霊性具も極秘の製法さえ外に漏れな\n　ければ、現物自体を渡すことにさほどの問題は\n　ないし……」\\nw[ハイエルフ族長]":44,"「だったら――」\\nw[\\N[1]]":45,"「奴隷の積極的な買い取りは、闇肌どもの力を削ぐこと\n　にも繋がろう。\\nw[ハイエルフ族長]":46,"「あえてお前の話に乗ってやる、人間の奴隷商人よ。\n　いつでもこの里に闇肌奴隷を連れてくるがいい」\\nw[ハイエルフ族長]":47,"「そう言ってくれると思ってたぜ！」\\nw[\\N[1]]":48,"「ただし我々は、貨幣を使わない。物々交換が基本なのだ。\n　よって支払いには\\C[17]精霊石\\C[0]を使うことになるが？」\\nw[ハイエルフ族長]":49,"「まったく構わないさ。じゃあこれで契約成立だな」\\nw[\\N[1]]":50,"（無理な交渉だと思ってたけど、あれよあれよと\n　まとまったちゃった……。嘘みたい……）\\nw[\\N[2]]":51,"「それではまず、精霊性具の使い方を見せよう。\n　ちょうどそこに、手頃な奴隷もいることだし」\\nw[ハイエルフ族長]":52,"「ひっ……！？\n　い、いやっ！　やめてっ！！」\\nw[ダークエルフ奴隷]":53,"「精霊性具の神秘の力、とくと見よ！」\\nw[ハイエルフ族長]":54,"「いいだろう、お前の提案を受け入れるとしよう」\\nw[ハイエルフ族長]":55,"「では渡す前に、闇肌奴隷を使って精霊性具の真価を\n　教えてやろう」\\nw[ダークエルフ族長]":56,"\nここでエッチイベント\n↓　　↓　　↓":57,"↑　　↑　　↑\nここでエッチイベント\n　":58,"「うわぁ……。\n　ひどいものを見ちゃった……」\\nw[\\N[2]]":59,"「精霊性具、なるほど大したオモチャだ」\\nw[\\N[1]]":60,"「さあ受け取れ。この精霊性具を取り引きの証として\n　お前にゆずろう」\\nw[ハイエルフ族長]":61,"「ベタベタしてて使用感がスゴイが……礼を言わせて\n　もらうぜ、ありがとう」\\nw[\\N[1]]":62,"アイテム\\C[17]『精霊性具』\\C[0]を入手した！":63,"\\>　　※　ハイエルフの里で\\C[17]ダークエルフ奴隷の売買\\C[0]が　※\n\\>　　※　できるようになった！　　　　　　　　　　　※\\<":64,"「色々と大変でしたけど、これであのボスから情報が\n　引き出せますね」\\nw[\\N[2]]":65,"「そうだな。\n　じゃあ王都に戻るとするか」\\nw[\\N[1]]":66,"「森の外へ出るなら、\\C[17]奥にある洞窟の道\\C[0]を使うといい。\n　簡単に行き来できるぞ」\\nw[ハイエルフ族長]":67,"「そいつはありがたい。使わせてもらうよ」\\nw[\\N[1]]":68,"トークマーク":69,"エルフ1":70,"「巨乳じゃなきゃダメってわけじゃないんだ。\n　ただ、どっちかっていうと大きい方が、って話で……」\\nw[ハイエルフ男]":71,"エルフ2":72,"「男の筋肉を見てると、たまらなくなっちゃって……」\\nw[ハイエルフ女]":73,"「里から出る裏道を使うなら、右奥の方にある洞窟を\n　抜けていきなさい」\\nw[ハイエルフ女]":74,"ユマ":75,"Dエルフ奴隷":76,"抜け道":77,"clear_all_weathers":78,"エルフ2（門番）":79,"「人間よ、立ち去りなさい。\n　ここはお前たちが来ていい場所ではない」\\nw[ハイエルフ女]":80,"落ちてる精霊石（街）":81,"エルフ女性":82,"「美しい景色でしょう？\n　でもここと同じような森を、人間はどんどん切り拓いて\n　いってるのよ」\\nw[エルフの女]":83,"「闇肌の奴隷で族長を釣ったの？\n　……あのエロじじいめ」\\nw[エルフの女]":84,"「人間のことはキライだけど、闇肌はもっとキライ。\n　あ、闇肌っていうのは、あんたたち人間が言うところの\n　ダークエルフのことよ」\\nw[エルフの女]":85,"「闇肌を売りに来たんですって？\n　人間はほんとに商売熱心ね」\\nw[エルフの女]":86,"エルフ男性":87,"「俺の父は人間の兵士に殺されたんだ。\n　いまでもその恨みは忘れていないぞ」\\nw[エルフの男]":88,"「人間に父を殺された恨みはあるが、しかしお前が殺した\n　わけでもないからな……。つまり、その……俺にも\n　闇肌奴隷を売ってくれていいんだぞ？」\\nw[エルフの男]":89,"「争いは好まないけど、人間と戦うため森を出て行った\n　仲間たちの気持ちも分かるよ」\\nw[エルフの男]":90,"「ダークエルフとの間に子供ができたらどうするかって？\n　そんな汚らわしいことにならないよう、避妊魔法を\n　使うのさ」\\nw[エルフの男]":91,"EV088":92,"EV089":93,"鹿":94,"侵入防止":95,"EV095":96,"particles : 0 : 30 : 1 : 0 : -3.5 : 1 : Waterfall_0":97,"EXIT":98},"extension":"json","dataType":"map","filename":"Map063","basename":"Map063.json","path":"data/Map063.json","relPath":"data/Map063.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":99,"percent":0},"cellInfo":[]},"data/Map064.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["火",""],["商人",""],["「自分の店を持ちたいけど、なかなか開業資金が集まら\n　なくてね」\\nw[商人]",""],["光",""],["EV007",""],["EV008",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「一旗揚げてやろうと、商売の世界に飛び込んではみた\n　ものの……赤字の回避だけで一杯一杯だよ」\\nw[仲買人]",""],["依頼フキダシ",""],["矢印",""],["ギルド通信",""],["豪商（依頼14）",""],["「私も若い頃は馬車一台だけを元手に、行商で身を\n　立てていたものだよ」\\nw[豪商]",""],["ギルド職員",""],["行商人",""],["「王都には行ったことあるかい？\n　あそこの\\C[17]闘技場\\C[0]は、そりゃあもう立派なもんでね」\\nw[行商人]",""],["女商人",""],["「海辺の村じゃ、真珠採りは貴重な収入源なの。\n　それを買って回るのも私の仕事のひとつよ」\\nw[宝石商]",""]],"context":[["Map064/events/1/name"],["Map064/events/2/name"],["Map064/events/3/name"],["Map064/events/4/name"],["Map064/events/5/name"],["Map064/events/5/pages/0/list/0/message/noPicture/bottom"],["Map064/events/6/name"],["Map064/events/7/name"],["Map064/events/8/name"],["Map064/events/10/name"],["Map064/events/10/pages/0/list/0/comment"],["Map064/events/10/pages/0/list/10/comment"],["Map064/events/10/pages/0/list/11/message/noPicture/bottom"],["Map064/events/11/name"],["Map064/events/12/name"],["Map064/events/13/name"],["Map064/events/14/name"],["Map064/events/14/pages/0/list/0/message/noPicture/bottom"],["Map064/events/16/name"],["Map064/events/17/name"],["Map064/events/17/pages/0/list/0/message/noPicture/bottom"],["Map064/events/18/name"],["Map064/events/18/pages/0/list/0/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["gold"],["gold"],["gold"],["gold"],null,["gold"],["gold"],null,["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"火":3,"商人":4,"「自分の店を持ちたいけど、なかなか開業資金が集まら\n　なくてね」\\nw[商人]":5,"光":6,"EV007":7,"EV008":8,"仲買人（依頼05）":9,"依頼を出している場合":10,"依頼を出していない場合":11,"「一旗揚げてやろうと、商売の世界に飛び込んではみた\n　ものの……赤字の回避だけで一杯一杯だよ」\\nw[仲買人]":12,"依頼フキダシ":13,"矢印":14,"ギルド通信":15,"豪商（依頼14）":16,"「私も若い頃は馬車一台だけを元手に、行商で身を\n　立てていたものだよ」\\nw[豪商]":17,"ギルド職員":18,"行商人":19,"「王都には行ったことあるかい？\n　あそこの\\C[17]闘技場\\C[0]は、そりゃあもう立派なもんでね」\\nw[行商人]":20,"女商人":21,"「海辺の村じゃ、真珠採りは貴重な収入源なの。\n　それを買って回るのも私の仕事のひとつよ」\\nw[宝石商]":22},"extension":"json","dataType":"map","filename":"Map064","basename":"Map064.json","path":"data/Map064.json","relPath":"data/Map064.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":23,"percent":0},"cellInfo":[]},"data/Map065.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　『女を落とす１２の冴えたやり方』\n\\>\n\\>『……だが、ブ男でも落胆する必要はない。\n\\>　突き詰めれば男はチンコだ。そう、チンコなのである。\n\\>　\n\\>　ここで砂漠地帯に伝わるチンコ強化の秘法を、この\n\\>　本を読んでいるキミにだけ教えよう！\n\\>　\n\\>　毒サソリはしっているだろうか。あの尻尾に毒針を\n\\>　持つ、恐ろしい虫だ。\n\\>　その恐ろしい毒針を一ヶ月のあいだ雪中酒に浸けた\n\\>　後、チンコの根本に刺すのだ。すると強度と持続性\n\\>　が増し、太さも一回り以上大きくなるのだ！\n\\>　\n\\>　\\}※なお本書に書かれた方法で命を落としても著者は一切の責任を負いません\\{』",""],["MWL_行数リセット",""],["\\>　　　　　『今日から始めるマーケティング』\n\\>\n\\>『……初心者にもやりやすい方法をひとつ挙げるなら\n\\>　サクラを使うやり方だろう。\n\\>　\n\\>　それは詐欺じゃないかと真面目なあなたは思うかも\n\\>　しれないが、客の中にサクラを混ぜて商品の価値を\n\\>　宣伝するのは伝統的な手法なのだ。\n\\>　先人が築いてきた知恵を使うのに、なにをためらう\n\\>　ことがあろう？\n\\>　\n\\>　ただし「お客様の個人的感想」の枠内に収まるよう、\n\\>　サクラの言い回しには注意する必要がある』",""]],"context":[["Map065/events/1/name"],["Map065/events/2/name"],["Map065/events/3/name"],["Map065/events/5/name","Map065/events/6/name"],["Map065/events/5/pages/0/list/2/Plugin Command","Map065/events/5/pages/1/list/2/Plugin Command","Map065/events/6/pages/0/list/2/Plugin Command","Map065/events/6/pages/1/list/2/Plugin Command"],["Map065/events/5/pages/0/list/3/scrollingMessage","Map065/events/5/pages/1/list/3/scrollingMessage"],["Map065/events/5/pages/0/list/19/Plugin Command","Map065/events/5/pages/1/list/19/Plugin Command","Map065/events/6/pages/0/list/17/Plugin Command","Map065/events/6/pages/1/list/17/Plugin Command"],["Map065/events/6/pages/0/list/3/scrollingMessage","Map065/events/6/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"本":3,"MWL_行数変更 16":4,"\\>　　　　『女を落とす１２の冴えたやり方』\n\\>\n\\>『……だが、ブ男でも落胆する必要はない。\n\\>　突き詰めれば男はチンコだ。そう、チンコなのである。\n\\>　\n\\>　ここで砂漠地帯に伝わるチンコ強化の秘法を、この\n\\>　本を読んでいるキミにだけ教えよう！\n\\>　\n\\>　毒サソリはしっているだろうか。あの尻尾に毒針を\n\\>　持つ、恐ろしい虫だ。\n\\>　その恐ろしい毒針を一ヶ月のあいだ雪中酒に浸けた\n\\>　後、チンコの根本に刺すのだ。すると強度と持続性\n\\>　が増し、太さも一回り以上大きくなるのだ！\n\\>　\n\\>　\\}※なお本書に書かれた方法で命を落としても著者は一切の責任を負いません\\{』":5,"MWL_行数リセット":6,"\\>　　　　　『今日から始めるマーケティング』\n\\>\n\\>『……初心者にもやりやすい方法をひとつ挙げるなら\n\\>　サクラを使うやり方だろう。\n\\>　\n\\>　それは詐欺じゃないかと真面目なあなたは思うかも\n\\>　しれないが、客の中にサクラを混ぜて商品の価値を\n\\>　宣伝するのは伝統的な手法なのだ。\n\\>　先人が築いてきた知恵を使うのに、なにをためらう\n\\>　ことがあろう？\n\\>　\n\\>　ただし「お客様の個人的感想」の枠内に収まるよう、\n\\>　サクラの言い回しには注意する必要がある』":7},"extension":"json","dataType":"map","filename":"Map065","basename":"Map065.json","path":"data/Map065.json","relPath":"data/Map065.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":8,"percent":0},"cellInfo":[]},"data/Map066.json":{"data":[["EV001",""],["EV002",""],["光",""],["火",""],["商人",""],["「これからしばらくは、悪竜退治の絵や彫刻が人気に\n　なるだろうね。よし、画家に発注しておこう」\\nw[商人]",""],["「ずっと馬車に乗ってたんで尻が……アイタタ……」\\nw[商人]",""],["EV007",""],["EV008",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「オレァ、一番の芸術は人だと思うね。\n　なんせ美人の奴隷は高く売れるからな」\\nw[仲買人]",""],["依頼フキダシ",""],["ギルド通信",""],["矢印",""],["豪商",""],["「芸術にも流行り廃りがある。\n　悪竜ブームはどのくらい続くかな」\\nw[豪商]",""],["「もうちょっと街道の整備に金を回してもらいたいものだ。\n　王国の人間は金の使い方を分かっちゃいないな」\\nw[豪商]",""],["ギルド職員",""],["料理1",""],["美術商",""],["「芸術には絶対的な価値なんてない。\n　だから弁舌ひとつで高く売れたりもするんだ」\\nw[美術商]",""],["行商人",""],["「よく分からん抽象画が、仕入れ値の倍で売れたときは\n　驚いたよ。\n　売っておいてなんだが、世の中物好きが多いな」\\nw[行商人]",""],["女商人",""],["「西の山に出没してた鬼、だれかが捕まえてくれたみたい。\n　町の人間が冒険者に依頼でも出したのかしら？」\\nw[骨董商]",""],["「ペイサーの西の山には峠道が走ってるんだけど、\n　近頃は鬼が出るんで通れないのよ。困ったわぁ」\\nw[骨董商]",""]],"context":[["Map066/events/1/name"],["Map066/events/2/name"],["Map066/events/3/name"],["Map066/events/4/name"],["Map066/events/5/name"],["Map066/events/5/pages/0/list/1/message/noPicture/bottom"],["Map066/events/5/pages/0/list/7/message/noPicture/bottom"],["Map066/events/7/name"],["Map066/events/8/name"],["Map066/events/9/name"],["Map066/events/9/pages/0/list/0/comment"],["Map066/events/9/pages/0/list/10/comment"],["Map066/events/9/pages/0/list/11/message/noPicture/bottom"],["Map066/events/10/name"],["Map066/events/11/name"],["Map066/events/12/name"],["Map066/events/13/name"],["Map066/events/13/pages/0/list/1/message/noPicture/bottom"],["Map066/events/13/pages/0/list/7/message/noPicture/bottom"],["Map066/events/15/name"],["Map066/events/16/name"],["Map066/events/17/name"],["Map066/events/17/pages/0/list/0/message/noPicture/bottom","Map066/events/17/pages/2/list/0/message/noPicture/bottom"],["Map066/events/18/name"],["Map066/events/18/pages/0/list/0/message/noPicture/bottom","Map066/events/18/pages/2/list/0/message/noPicture/bottom"],["Map066/events/19/name"],["Map066/events/19/pages/0/list/1/message/noPicture/bottom"],["Map066/events/19/pages/0/list/6/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],["red"],["red"],null,["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],null,["gold"],null,["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"光":2,"火":3,"商人":4,"「これからしばらくは、悪竜退治の絵や彫刻が人気に\n　なるだろうね。よし、画家に発注しておこう」\\nw[商人]":5,"「ずっと馬車に乗ってたんで尻が……アイタタ……」\\nw[商人]":6,"EV007":7,"EV008":8,"仲買人（依頼05）":9,"依頼を出している場合":10,"依頼を出していない場合":11,"「オレァ、一番の芸術は人だと思うね。\n　なんせ美人の奴隷は高く売れるからな」\\nw[仲買人]":12,"依頼フキダシ":13,"ギルド通信":14,"矢印":15,"豪商":16,"「芸術にも流行り廃りがある。\n　悪竜ブームはどのくらい続くかな」\\nw[豪商]":17,"「もうちょっと街道の整備に金を回してもらいたいものだ。\n　王国の人間は金の使い方を分かっちゃいないな」\\nw[豪商]":18,"ギルド職員":19,"料理1":20,"美術商":21,"「芸術には絶対的な価値なんてない。\n　だから弁舌ひとつで高く売れたりもするんだ」\\nw[美術商]":22,"行商人":23,"「よく分からん抽象画が、仕入れ値の倍で売れたときは\n　驚いたよ。\n　売っておいてなんだが、世の中物好きが多いな」\\nw[行商人]":24,"女商人":25,"「西の山に出没してた鬼、だれかが捕まえてくれたみたい。\n　町の人間が冒険者に依頼でも出したのかしら？」\\nw[骨董商]":26,"「ペイサーの西の山には峠道が走ってるんだけど、\n　近頃は鬼が出るんで通れないのよ。困ったわぁ」\\nw[骨董商]":27},"extension":"json","dataType":"map","filename":"Map066","basename":"Map066.json","path":"data/Map066.json","relPath":"data/Map066.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":28,"percent":0},"cellInfo":[]},"data/Map067.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["EV004",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　『写実絵画展・目録』\n\\>\n\\>　『憂鬱に沈む令嬢』　448年　リヴェル\n\\>\n\\>　『農民とカラス』　411年　作者不詳\n\\>\n\\>　『砂漠を行く隊商』　395年　アレオイス\n\\>　\n\\>　『シーグヌースの港』　503年　トルグウェス\n\\>　\n\\>　『妻のアヘ顔』　470年　ガンマローエ\n\\>　\n\\>　『海岸線』　512年　タルバント\n\\>　\n\\>　『名も知らぬ赤い花』　388年　スージェロイ",""],["MWL_行数リセット",""],["\\>　　　　　　　『私的エルフ考』\n\\>\n\\>『……というように、ハイエルフとダークエルフには\n\\>　肌の色以外にも様々な違いが見られる。\n\\>　中でもわけて興味深いのは、四属性に対する耐性の\n\\>　違いだ。\n\\>　ハイエルフは火属性に弱く、ダークエルフは風属性を\n\\>　苦手とする。\n\\>　\n\\>　起源を同じくする二種族になぜこのような差異がある\n\\>　のか、はっきりとしたことは分からない。\n\\>　しかしハイエルフは普段の生活で火を使うことが少な\n\\>　く、対してダークエルフは人間と同等に火を利用する\n\\>　ことは知られている。\n\\>　この生活習慣の差が長い年月のうちに耐性の差を生ん\n\\>　だという可能性も……』",""]],"context":[["Map067/events/1/name"],["Map067/events/2/name"],["Map067/events/3/name"],["Map067/events/4/name"],["Map067/events/5/name","Map067/events/6/name"],["Map067/events/5/pages/0/list/2/Plugin Command","Map067/events/5/pages/1/list/2/Plugin Command","Map067/events/6/pages/0/list/2/Plugin Command","Map067/events/6/pages/1/list/2/Plugin Command"],["Map067/events/5/pages/0/list/3/scrollingMessage","Map067/events/5/pages/1/list/3/scrollingMessage"],["Map067/events/5/pages/0/list/19/Plugin Command","Map067/events/5/pages/1/list/19/Plugin Command","Map067/events/6/pages/0/list/20/Plugin Command","Map067/events/6/pages/1/list/20/Plugin Command"],["Map067/events/6/pages/0/list/3/scrollingMessage","Map067/events/6/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"EV004":3,"本":4,"MWL_行数変更 16":5,"\\>　　　　　『写実絵画展・目録』\n\\>\n\\>　『憂鬱に沈む令嬢』　448年　リヴェル\n\\>\n\\>　『農民とカラス』　411年　作者不詳\n\\>\n\\>　『砂漠を行く隊商』　395年　アレオイス\n\\>　\n\\>　『シーグヌースの港』　503年　トルグウェス\n\\>　\n\\>　『妻のアヘ顔』　470年　ガンマローエ\n\\>　\n\\>　『海岸線』　512年　タルバント\n\\>　\n\\>　『名も知らぬ赤い花』　388年　スージェロイ":6,"MWL_行数リセット":7,"\\>　　　　　　　『私的エルフ考』\n\\>\n\\>『……というように、ハイエルフとダークエルフには\n\\>　肌の色以外にも様々な違いが見られる。\n\\>　中でもわけて興味深いのは、四属性に対する耐性の\n\\>　違いだ。\n\\>　ハイエルフは火属性に弱く、ダークエルフは風属性を\n\\>　苦手とする。\n\\>　\n\\>　起源を同じくする二種族になぜこのような差異がある\n\\>　のか、はっきりとしたことは分からない。\n\\>　しかしハイエルフは普段の生活で火を使うことが少な\n\\>　く、対してダークエルフは人間と同等に火を利用する\n\\>　ことは知られている。\n\\>　この生活習慣の差が長い年月のうちに耐性の差を生ん\n\\>　だという可能性も……』":8},"extension":"json","dataType":"map","filename":"Map067","basename":"Map067.json","path":"data/Map067.json","relPath":"data/Map067.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":9,"percent":0},"cellInfo":[]},"data/Map068.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["火",""],["商人",""],["「悪竜騒ぎのせいで、王都方面の物流が滞っていたけど、\n　ようやく解消されてきたようだ」\\nw[商人]",""],["「海路での貿易は、儲けが大きいけど危険も大きいんだ。\n　海洋商人になるつもりなら、よく考えた方がいい」\\nw[商人]",""],["光",""],["EV007",""],["EV008",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「最近は、あまり海賊の話を聞かなくなったな。\n　いいことだ」\\nw[仲買人]",""],["ドゥブカ島について",""],["「北海も広いから、そのドゥブカって島もどこかに\n　あるのかもしれないけど……でもこの近くには無いと\n　思うよ？」\\nw[仲買人]",""],["「海で怖いのは、一に嵐、二に海賊ってとこだな」\\nw[仲買人]",""],["依頼フキダシ",""],["ギルド通信",""],["矢印",""],["豪商",""],["「風の噂に聞いたのだが、海賊の頭目が大怪我を負って、\n　再起不能になったらしい。いい気味だよ」\\nw[豪商]",""],["「ドゥブカ島？　知らんよ。\n　それより海賊島の方をどうにかして欲しいもんだ」\\nw[豪商]",""],["「先日も、知り合いの商人が海賊に襲われて破産して\n　しまったよ。どうにかならないものか……」\\nw[豪商]",""],["ギルド職員",""],["「さっき、武器商ギルドに寝返った商人がウチに戻りたいと\n　頭を下げにきてたよ。\n　あちらさんは、かなり苦しくなってきたようだな」\\nw[海運商人]",""],["「売買交渉が難航したうえに、帰りは嵐に巻き込まれて\n　大変だったよ。\n　まあ利益はかなり出せたけどね」\\nw[海運商人]",""],["料理1",""],["「主要な航路のそばに、ドゥブカ島なんて島は無い\n　はずだ。あるとすれば滅多に船が行かないような\n　海域かもな」\\nw[商人]",""],["「いつか大陸をぐるりと回る航路が拓かれるかもしれん。\n　そうしたら商売の幅はもっと広がるだろう」\\nw[商人]",""],["「ドゥブカ？　変な名前の島だね。\n　あいにくだけど、僕は知らないよ」\\nw[商人]",""],["「南方の大きな国々じゃ、こっちより性能のいい\n　帆船が開発されたらしいですね」\\nw[商人]",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["女商人",""],["「ドゥブカ島ねぇ……。ちょっと分からないわ。\n　実在する島なの？」\\nw[女商人]",""],["「島の東にある古い灯台って、モンスターの住処になって\n　るけど、お宝もあるって噂なのよね。確かめに行く気\n　にはならないけど」\\nw[女商人]",""]],"context":[["Map068/events/1/name"],["Map068/events/2/name"],["Map068/events/3/name"],["Map068/events/4/name"],["Map068/events/5/name","Map068/events/17/name","Map068/events/19/name","Map068/events/20/name"],["Map068/events/5/pages/0/list/1/message/noPicture/bottom"],["Map068/events/5/pages/0/list/7/message/noPicture/bottom"],["Map068/events/6/name"],["Map068/events/7/name"],["Map068/events/8/name"],["Map068/events/10/name"],["Map068/events/10/pages/0/list/0/comment"],["Map068/events/10/pages/0/list/10/comment"],["Map068/events/10/pages/0/list/12/message/noPicture/bottom"],["Map068/events/10/pages/0/list/19/comment","Map068/events/14/pages/0/list/8/comment","Map068/events/19/pages/0/list/2/comment","Map068/events/19/pages/2/list/2/comment","Map068/events/20/pages/0/list/2/comment","Map068/events/20/pages/2/list/2/comment","Map068/events/22/pages/0/list/2/comment"],["Map068/events/10/pages/0/list/20/message/noPicture/bottom"],["Map068/events/10/pages/0/list/33/message/noPicture/bottom"],["Map068/events/11/name"],["Map068/events/12/name"],["Map068/events/13/name"],["Map068/events/14/name"],["Map068/events/14/pages/0/list/1/message/noPicture/bottom"],["Map068/events/14/pages/0/list/9/message/noPicture/bottom"],["Map068/events/14/pages/0/list/21/message/noPicture/bottom"],["Map068/events/16/name"],["Map068/events/17/pages/0/list/1/message/noPicture/bottom","Map068/events/17/pages/2/list/1/message/noPicture/bottom"],["Map068/events/17/pages/0/list/8/message/noPicture/bottom","Map068/events/17/pages/2/list/8/message/noPicture/bottom"],["Map068/events/18/name"],["Map068/events/19/pages/0/list/3/message/noPicture/bottom","Map068/events/19/pages/2/list/3/message/noPicture/bottom"],["Map068/events/19/pages/0/list/16/message/noPicture/bottom","Map068/events/19/pages/2/list/16/message/noPicture/bottom"],["Map068/events/20/pages/0/list/3/message/noPicture/bottom","Map068/events/20/pages/2/list/3/message/noPicture/bottom"],["Map068/events/20/pages/0/list/15/message/noPicture/bottom","Map068/events/20/pages/2/list/15/message/noPicture/bottom"],["Map068/events/21/name"],["Map068/events/21/note"],["Map068/events/22/name"],["Map068/events/22/pages/0/list/3/message/noPicture/bottom"],["Map068/events/22/pages/0/list/15/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["red"],null,null,["gold"],["gold"],["gold"],["gold"],null,null,null,["gold"],null,null,["gold"],null,null,null,null,["gold"],null,["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["ドゥブカ島について"]},{"headerIndex":8,"headerParam":["ドゥブカ島について"]},{"headerIndex":2,"headerParam":["ドゥブカ島について"]},{"headerIndex":2,"headerParam":["ドゥブカ島について"]},{"headerIndex":2,"headerParam":["ドゥブカ島について"]},{"headerIndex":2,"headerParam":["ドゥブカ島について"]},{"headerIndex":2,"headerParam":["ドゥブカ島について"]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],null,[{"headerIndex":3,"headerParam":["",0,0,2]},{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]},{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]},{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]},{"headerIndex":15,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"火":3,"商人":4,"「悪竜騒ぎのせいで、王都方面の物流が滞っていたけど、\n　ようやく解消されてきたようだ」\\nw[商人]":5,"「海路での貿易は、儲けが大きいけど危険も大きいんだ。\n　海洋商人になるつもりなら、よく考えた方がいい」\\nw[商人]":6,"光":7,"EV007":8,"EV008":9,"仲買人（依頼05）":10,"依頼を出している場合":11,"依頼を出していない場合":12,"「最近は、あまり海賊の話を聞かなくなったな。\n　いいことだ」\\nw[仲買人]":13,"ドゥブカ島について":14,"「北海も広いから、そのドゥブカって島もどこかに\n　あるのかもしれないけど……でもこの近くには無いと\n　思うよ？」\\nw[仲買人]":15,"「海で怖いのは、一に嵐、二に海賊ってとこだな」\\nw[仲買人]":16,"依頼フキダシ":17,"ギルド通信":18,"矢印":19,"豪商":20,"「風の噂に聞いたのだが、海賊の頭目が大怪我を負って、\n　再起不能になったらしい。いい気味だよ」\\nw[豪商]":21,"「ドゥブカ島？　知らんよ。\n　それより海賊島の方をどうにかして欲しいもんだ」\\nw[豪商]":22,"「先日も、知り合いの商人が海賊に襲われて破産して\n　しまったよ。どうにかならないものか……」\\nw[豪商]":23,"ギルド職員":24,"「さっき、武器商ギルドに寝返った商人がウチに戻りたいと\n　頭を下げにきてたよ。\n　あちらさんは、かなり苦しくなってきたようだな」\\nw[海運商人]":25,"「売買交渉が難航したうえに、帰りは嵐に巻き込まれて\n　大変だったよ。\n　まあ利益はかなり出せたけどね」\\nw[海運商人]":26,"料理1":27,"「主要な航路のそばに、ドゥブカ島なんて島は無い\n　はずだ。あるとすれば滅多に船が行かないような\n　海域かもな」\\nw[商人]":28,"「いつか大陸をぐるりと回る航路が拓かれるかもしれん。\n　そうしたら商売の幅はもっと広がるだろう」\\nw[商人]":29,"「ドゥブカ？　変な名前の島だね。\n　あいにくだけど、僕は知らないよ」\\nw[商人]":30,"「南方の大きな国々じゃ、こっちより性能のいい\n　帆船が開発されたらしいですね」\\nw[商人]":31,"宝箱（消耗品正面開き）":32,"<TE:13>":33,"女商人":34,"「ドゥブカ島ねぇ……。ちょっと分からないわ。\n　実在する島なの？」\\nw[女商人]":35,"「島の東にある古い灯台って、モンスターの住処になって\n　るけど、お宝もあるって噂なのよね。確かめに行く気\n　にはならないけど」\\nw[女商人]":36},"extension":"json","dataType":"map","filename":"Map068","basename":"Map068.json","path":"data/Map068.json","relPath":"data/Map068.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":37,"percent":0},"cellInfo":[]},"data/Map069.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　『シーグヌース開拓録』\n\\>\n\\>『……そして、その嵐がシーグヌースの発展を運命づけ\n\\>　たのだ。\n\\>　\n\\>　難破の危機を脱して島の入り江に避難してきたユー\n\\>　ギル号に乗っていた技師オロウィルは、一目でこの\n\\>　地が天然の良港であることを見抜いた。\n\\>　\n\\>　本土に戻ったオロウィルは、伯父である富豪の海運商\n\\>　にシーグヌースが海上輸送の中継地として有望である\n\\>　ことを伝え、その年のうちに予備調査が……』",""],["MWL_行数リセット",""]],"context":[["Map069/events/1/name"],["Map069/events/2/name"],["Map069/events/3/name"],["Map069/events/5/name"],["Map069/events/5/pages/0/list/2/Plugin Command","Map069/events/5/pages/1/list/2/Plugin Command"],["Map069/events/5/pages/0/list/3/scrollingMessage","Map069/events/5/pages/1/list/3/scrollingMessage"],["Map069/events/5/pages/0/list/16/Plugin Command","Map069/events/5/pages/1/list/16/Plugin Command"]],"tags":[["gold"],["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"本":3,"MWL_行数変更 16":4,"\\>　　　　　　　『シーグヌース開拓録』\n\\>\n\\>『……そして、その嵐がシーグヌースの発展を運命づけ\n\\>　たのだ。\n\\>　\n\\>　難破の危機を脱して島の入り江に避難してきたユー\n\\>　ギル号に乗っていた技師オロウィルは、一目でこの\n\\>　地が天然の良港であることを見抜いた。\n\\>　\n\\>　本土に戻ったオロウィルは、伯父である富豪の海運商\n\\>　にシーグヌースが海上輸送の中継地として有望である\n\\>　ことを伝え、その年のうちに予備調査が……』":5,"MWL_行数リセット":6},"extension":"json","dataType":"map","filename":"Map069","basename":"Map069.json","path":"data/Map069.json","relPath":"data/Map069.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":7,"percent":0},"cellInfo":[],"cacheResetOnChange":{}},"data/Map070.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["商人",""],["「知り合いの話じゃ、副都の被害はアルテトによるもの\n　より、後から来たモンスターによるものの方が多い\n　そうだ」\\nw[商人]",""],["「王都にはうまい話がいくつも転がってるが、それと同じくらい\n　ヤバイ話も多いのさ」\\nw[商人]",""],["EV007",""],["光",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「もしやモンスターの被害を受けた副都は、これから\n　復興特需でいい商売の対象になるんじゃ？」\\nw[仲買人]",""],["「ふはははっ！　読みが当たって大儲けだったぜ！\n　……まあ、この前は外して大損だったけどよ」\\nw[仲買人]",""],["依頼フキダシ",""],["ギルド通信",""],["矢印",""],["豪商",""],["「悪竜なんかに襲われたら、築いた財貨も豪邸も、\n　一瞬で灰にされかねんな」\\nw[豪商]",""],["「商売は情報だよ。情報を制した者が儲けられるんだ」\\nw[豪商]",""],["ギルド職員",""],["料理1",""],["「武器商ギルドの弱体化で、市場は健全に戻りつつ\n　あるよ。いやぁ、良かった良かった」\\nw[商人]",""],["「武器商ギルドの連中め。\n　悪竜の話にかこつけて市民の不安を煽り、あちこちで\n　武具を売ってるらしい」\\nw[商人]",""],["「武器商ギルドのやり口は我慢がならん！\n　これでは真っ当な市場が育たんぞ！」\\nw[商人]",""],["若手商人",""],["「まだ武具は高値を維持しているけど、武器商ギルドが\n　特権を失った以上、近いうちに値下がりが始まるはずだ」\\nw[若手商人]",""],["「この非常時こそ自衛のための武器が必要なのに、\n　武器商ギルドの連中め、ますます値を吊り上げやがった」\\nw[若手商人]",""],["「新興の武器商ギルドが商売の世界に新風を吹き込む――\n　なんて言われてたのも昔の話。\n　あいつらのせいで武具関連の取り引きは滅茶苦茶だよ」\\nw[若手商人]",""],["燭台",""],["女商人",""],["「これでようやく役人どもも、武器商ギルドの不正を\n　取り締まるようになるわね」\\nw[女商人]",""],["「伝説じゃ悪竜は死んだはずよね？\n　甦ったってどういうことよ……」\\nw[女商人]",""],["「武器商ギルドは様々な不正取引をしてるはずだけど、\n　役人が見て見ぬふりをするから、誰も捕まらないわ。\n　まったく……」\\nw[女商人]",""]],"context":[["Map070/events/1/name"],["Map070/events/2/name"],["Map070/events/3/name"],["Map070/events/4/name"],["Map070/events/5/name"],["Map070/events/6/name","Map070/events/18/name"],["Map070/events/6/pages/0/list/1/message/noPicture/bottom"],["Map070/events/6/pages/0/list/8/message/noPicture/bottom"],["Map070/events/7/name"],["Map070/events/8/name","Map070/events/21/name","Map070/events/23/name"],["Map070/events/10/name"],["Map070/events/10/pages/0/list/0/comment"],["Map070/events/10/pages/0/list/10/comment"],["Map070/events/10/pages/0/list/12/message/noPicture/bottom"],["Map070/events/10/pages/0/list/18/message/noPicture/bottom"],["Map070/events/11/name"],["Map070/events/12/name"],["Map070/events/13/name"],["Map070/events/14/name"],["Map070/events/14/pages/0/list/1/message/noPicture/bottom"],["Map070/events/14/pages/0/list/7/message/noPicture/bottom"],["Map070/events/16/name"],["Map070/events/17/name"],["Map070/events/18/pages/0/list/1/message/noPicture/bottom","Map070/events/18/pages/2/list/1/message/noPicture/bottom"],["Map070/events/18/pages/0/list/8/message/noPicture/bottom","Map070/events/18/pages/2/list/8/message/noPicture/bottom"],["Map070/events/18/pages/0/list/15/message/noPicture/bottom","Map070/events/18/pages/2/list/15/message/noPicture/bottom"],["Map070/events/19/name"],["Map070/events/19/pages/0/list/1/message/noPicture/bottom","Map070/events/19/pages/2/list/1/message/noPicture/bottom"],["Map070/events/19/pages/0/list/8/message/noPicture/bottom","Map070/events/19/pages/2/list/8/message/noPicture/bottom"],["Map070/events/19/pages/0/list/14/message/noPicture/bottom","Map070/events/19/pages/2/list/14/message/noPicture/bottom"],["Map070/events/20/name","Map070/events/22/name","Map070/events/24/name","Map070/events/25/name"],["Map070/events/26/name"],["Map070/events/26/pages/0/list/1/message/noPicture/bottom"],["Map070/events/26/pages/0/list/8/message/noPicture/bottom"],["Map070/events/26/pages/0/list/14/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],["red"],["red"],null,null,["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],null,null,null,["gold"],null,null,null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":18,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]},{"headerIndex":15,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]},{"headerIndex":14,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"商人":5,"「知り合いの話じゃ、副都の被害はアルテトによるもの\n　より、後から来たモンスターによるものの方が多い\n　そうだ」\\nw[商人]":6,"「王都にはうまい話がいくつも転がってるが、それと同じくらい\n　ヤバイ話も多いのさ」\\nw[商人]":7,"EV007":8,"光":9,"仲買人（依頼05）":10,"依頼を出している場合":11,"依頼を出していない場合":12,"「もしやモンスターの被害を受けた副都は、これから\n　復興特需でいい商売の対象になるんじゃ？」\\nw[仲買人]":13,"「ふはははっ！　読みが当たって大儲けだったぜ！\n　……まあ、この前は外して大損だったけどよ」\\nw[仲買人]":14,"依頼フキダシ":15,"ギルド通信":16,"矢印":17,"豪商":18,"「悪竜なんかに襲われたら、築いた財貨も豪邸も、\n　一瞬で灰にされかねんな」\\nw[豪商]":19,"「商売は情報だよ。情報を制した者が儲けられるんだ」\\nw[豪商]":20,"ギルド職員":21,"料理1":22,"「武器商ギルドの弱体化で、市場は健全に戻りつつ\n　あるよ。いやぁ、良かった良かった」\\nw[商人]":23,"「武器商ギルドの連中め。\n　悪竜の話にかこつけて市民の不安を煽り、あちこちで\n　武具を売ってるらしい」\\nw[商人]":24,"「武器商ギルドのやり口は我慢がならん！\n　これでは真っ当な市場が育たんぞ！」\\nw[商人]":25,"若手商人":26,"「まだ武具は高値を維持しているけど、武器商ギルドが\n　特権を失った以上、近いうちに値下がりが始まるはずだ」\\nw[若手商人]":27,"「この非常時こそ自衛のための武器が必要なのに、\n　武器商ギルドの連中め、ますます値を吊り上げやがった」\\nw[若手商人]":28,"「新興の武器商ギルドが商売の世界に新風を吹き込む――\n　なんて言われてたのも昔の話。\n　あいつらのせいで武具関連の取り引きは滅茶苦茶だよ」\\nw[若手商人]":29,"燭台":30,"女商人":31,"「これでようやく役人どもも、武器商ギルドの不正を\n　取り締まるようになるわね」\\nw[女商人]":32,"「伝説じゃ悪竜は死んだはずよね？\n　甦ったってどういうことよ……」\\nw[女商人]":33,"「武器商ギルドは様々な不正取引をしてるはずだけど、\n　役人が見て見ぬふりをするから、誰も捕まらないわ。\n　まったく……」\\nw[女商人]":34},"extension":"json","dataType":"map","filename":"Map070","basename":"Map070.json","path":"data/Map070.json","relPath":"data/Map070.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":35,"percent":0},"cellInfo":[]},"data/Map071.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　『都市開発の提言集』\n\\>\n\\>『……つまるところ、世代が交代するたびに貧民街の\n\\>　取り壊しと再開発は繰り返し叫ばれてきたのだ。\n\\>　\n\\>　そうでありながら三百年以上にも渡って放置され続け\n\\>　てきたのは、財政上の問題もさることながら、あの\n\\>　犯罪の温床に利用価値を見出す者が大勢いたからに\n\\>　違いない。\n\\>　\n\\>　貧民街を根拠地とする組織的犯罪者たちは、一部の\n\\>　貴族や大商人、そして時には聖職者たちとも手を組み\n\\>　彼らの利益を守るために……』",""],["MWL_行数リセット",""],["\\>　　『王都流ナンパ術　～今日からキミもモテ男～』\n\\>\n\\>『……それではまず、悪い例から見てみよう。\n\\>\n\\>　「ネェちゃん、ワイと茶ぁしばかへん？」\n\\>\n\\>　この誘い文句のどこが悪いか分かるだろうか？\n\\>　口調の雑さ？　方言？　それとも前置きが無いから？\n\\>　いいや、どれも違う。\n\\>　\n\\>　正解は「茶」だ。\n\\>　地方出身者には理解が難しいかもしれないが、生粋の\n\\>　王都っ子にとって、茶をナンパの口実に使われること\n\\>　は侮辱されたに等しいことなのだ』",""],["燭台",""],["光",""]],"context":[["Map071/events/1/name"],["Map071/events/2/name"],["Map071/events/3/name"],["Map071/events/5/name"],["Map071/events/5/note"],["Map071/events/6/name","Map071/events/7/name"],["Map071/events/6/pages/0/list/2/Plugin Command","Map071/events/6/pages/1/list/2/Plugin Command","Map071/events/7/pages/0/list/2/Plugin Command","Map071/events/7/pages/1/list/2/Plugin Command"],["Map071/events/6/pages/0/list/3/scrollingMessage","Map071/events/6/pages/1/list/3/scrollingMessage"],["Map071/events/6/pages/0/list/17/Plugin Command","Map071/events/6/pages/1/list/17/Plugin Command","Map071/events/7/pages/0/list/18/Plugin Command","Map071/events/7/pages/1/list/18/Plugin Command"],["Map071/events/7/pages/0/list/3/scrollingMessage","Map071/events/7/pages/1/list/3/scrollingMessage"],["Map071/events/8/name","Map071/events/10/name","Map071/events/11/name"],["Map071/events/9/name","Map071/events/12/name","Map071/events/13/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,["gold"],["blue"],null,["blue"],null,["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"宝箱（消耗品正面開き）":3,"<TE:13>":4,"本":5,"MWL_行数変更 16":6,"\\>　　　　　　『都市開発の提言集』\n\\>\n\\>『……つまるところ、世代が交代するたびに貧民街の\n\\>　取り壊しと再開発は繰り返し叫ばれてきたのだ。\n\\>　\n\\>　そうでありながら三百年以上にも渡って放置され続け\n\\>　てきたのは、財政上の問題もさることながら、あの\n\\>　犯罪の温床に利用価値を見出す者が大勢いたからに\n\\>　違いない。\n\\>　\n\\>　貧民街を根拠地とする組織的犯罪者たちは、一部の\n\\>　貴族や大商人、そして時には聖職者たちとも手を組み\n\\>　彼らの利益を守るために……』":7,"MWL_行数リセット":8,"\\>　　『王都流ナンパ術　～今日からキミもモテ男～』\n\\>\n\\>『……それではまず、悪い例から見てみよう。\n\\>\n\\>　「ネェちゃん、ワイと茶ぁしばかへん？」\n\\>\n\\>　この誘い文句のどこが悪いか分かるだろうか？\n\\>　口調の雑さ？　方言？　それとも前置きが無いから？\n\\>　いいや、どれも違う。\n\\>　\n\\>　正解は「茶」だ。\n\\>　地方出身者には理解が難しいかもしれないが、生粋の\n\\>　王都っ子にとって、茶をナンパの口実に使われること\n\\>　は侮辱されたに等しいことなのだ』":9,"燭台":10,"光":11},"extension":"json","dataType":"map","filename":"Map071","basename":"Map071.json","path":"data/Map071.json","relPath":"data/Map071.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":12,"percent":0},"cellInfo":[]},"data/Map072.json":{"data":[["EV001",""],["EV002",""],["光",""],["火",""],["商人",""],["「ようやく自由に武器防具が売れるな。\n　まずは冒険者相手に営業をかけるか」\\nw[商人]",""],["「武器商ギルドのヤツラが幅を利かせていなけりゃ、\n　冒険者相手に武器防具を売って儲けられるんだがなぁ」\\nw[商人]",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「冒険者って連中は、なんでああ好き好んで危険な場所に\n　行きたがるのかねぇ」\\nw[仲買人]",""],["依頼フキダシ",""],["ギルド通信",""],["矢印",""],["豪商",""],["「冒険者たちは新陳代謝が早い。\n　すぐに死んで、すぐに代わりが補充されるってことさ」\\nw[豪商]",""],["ギルド長",""],["ギルド職員",""],["若手商人",""],["「やっとオレたちも武器の売買が出来るようになるな。\n　武器商ギルドもまだまだ競合相手として手ごわいだろう\n　けど」\\nw[若手商人]",""],["「冒険者がダンジョンから見つけてきた魔法の武器\n　なんかも、ぜんぶ武器商ギルドのやつらが独占的に\n　買い付けていきやがるんだ」\\nw[若手商人]",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　『ドぐされ行商人一代記』\n\\>\n\\>『……そこで販路を広げようと思ったのだ。\n\\>　ツルハシといえば工事用の道具であるから、卸す先も\n\\>　当然ながら工事業者や建設業者だった。\n\\>　だが俺は仕入れたツルハシを冒険者向けに販売するこ\n\\>　とにした。ダンジョン攻略にツルハシがどれだけ貢献\n\\>　できるかを説いて回ったのだ。\n\\>　\n\\>　この営業が実を結んだかどうかは、ダンジョン内部を\n\\>　見に行けば分かるだろう。様々なダンジョンに壊れた\n\\>　ツルハシの残骸が転がっているはずだ』",""],["MWL_行数リセット",""],["女商人",""],["「ここって冒険の町なんて言われてる割に、近くに\n　ダンジョンは無いのよね。\\nw[雑貨商]",""],["「一応、西の方に\\C[17]地下遺跡\\C[0]と、南の方に\\C[17]火の洞窟\\C[0]がある\n　けど、どっちも距離があるのよ」\\nw[雑貨商]",""]],"context":[["Map072/events/1/name"],["Map072/events/2/name"],["Map072/events/3/name"],["Map072/events/4/name"],["Map072/events/5/name"],["Map072/events/5/pages/0/list/1/message/noPicture/bottom"],["Map072/events/5/pages/0/list/7/message/noPicture/bottom"],["Map072/events/7/name"],["Map072/events/7/pages/0/list/0/comment"],["Map072/events/7/pages/0/list/10/comment"],["Map072/events/7/pages/0/list/11/message/noPicture/bottom"],["Map072/events/8/name"],["Map072/events/9/name"],["Map072/events/10/name"],["Map072/events/11/name"],["Map072/events/11/pages/0/list/0/message/noPicture/bottom"],["Map072/events/13/name"],["Map072/events/15/name"],["Map072/events/16/name"],["Map072/events/16/pages/0/list/1/message/noPicture/bottom"],["Map072/events/16/pages/0/list/8/message/noPicture/bottom"],["Map072/events/17/name"],["Map072/events/17/pages/0/list/2/Plugin Command","Map072/events/17/pages/1/list/2/Plugin Command"],["Map072/events/17/pages/0/list/3/scrollingMessage","Map072/events/17/pages/1/list/3/scrollingMessage"],["Map072/events/17/pages/0/list/16/Plugin Command","Map072/events/17/pages/1/list/16/Plugin Command"],["Map072/events/18/name"],["Map072/events/18/pages/0/list/0/message/noPicture/bottom"],["Map072/events/18/pages/0/list/3/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["red"],["red"],null,["gold"],["gold"],["gold"],["gold"],null,["gold"],["gold"],["gold"],null,null,["gold"],["blue"],null,["blue"],["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"光":2,"火":3,"商人":4,"「ようやく自由に武器防具が売れるな。\n　まずは冒険者相手に営業をかけるか」\\nw[商人]":5,"「武器商ギルドのヤツラが幅を利かせていなけりゃ、\n　冒険者相手に武器防具を売って儲けられるんだがなぁ」\\nw[商人]":6,"仲買人（依頼05）":7,"依頼を出している場合":8,"依頼を出していない場合":9,"「冒険者って連中は、なんでああ好き好んで危険な場所に\n　行きたがるのかねぇ」\\nw[仲買人]":10,"依頼フキダシ":11,"ギルド通信":12,"矢印":13,"豪商":14,"「冒険者たちは新陳代謝が早い。\n　すぐに死んで、すぐに代わりが補充されるってことさ」\\nw[豪商]":15,"ギルド長":16,"ギルド職員":17,"若手商人":18,"「やっとオレたちも武器の売買が出来るようになるな。\n　武器商ギルドもまだまだ競合相手として手ごわいだろう\n　けど」\\nw[若手商人]":19,"「冒険者がダンジョンから見つけてきた魔法の武器\n　なんかも、ぜんぶ武器商ギルドのやつらが独占的に\n　買い付けていきやがるんだ」\\nw[若手商人]":20,"本":21,"MWL_行数変更 16":22,"\\>　　　　　　『ドぐされ行商人一代記』\n\\>\n\\>『……そこで販路を広げようと思ったのだ。\n\\>　ツルハシといえば工事用の道具であるから、卸す先も\n\\>　当然ながら工事業者や建設業者だった。\n\\>　だが俺は仕入れたツルハシを冒険者向けに販売するこ\n\\>　とにした。ダンジョン攻略にツルハシがどれだけ貢献\n\\>　できるかを説いて回ったのだ。\n\\>　\n\\>　この営業が実を結んだかどうかは、ダンジョン内部を\n\\>　見に行けば分かるだろう。様々なダンジョンに壊れた\n\\>　ツルハシの残骸が転がっているはずだ』":23,"MWL_行数リセット":24,"女商人":25,"「ここって冒険の町なんて言われてる割に、近くに\n　ダンジョンは無いのよね。\\nw[雑貨商]":26,"「一応、西の方に\\C[17]地下遺跡\\C[0]と、南の方に\\C[17]火の洞窟\\C[0]がある\n　けど、どっちも距離があるのよ」\\nw[雑貨商]":27},"extension":"json","dataType":"map","filename":"Map072","basename":"Map072.json","path":"data/Map072.json","relPath":"data/Map072.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":28,"percent":0},"cellInfo":[]},"data/Map073.json":{"data":[["商人",""],["「ウチの商会でも出航を検討してみたが、いまは大人しく\n　しているのがいいという結論になったよ」\\nw[商人]",""],["「海洋貿易はいいぞ～！\n　たまに船が沈没するけどな！」\\nw[商人]",""],["EV002",""],["火",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["光",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「最近海賊が出ないのは、ヤツラの内部でなにかあった\n　からかもな。例えば内乱とか跡目争いとか、そういう」\\nw[仲買人]",""],["「海賊のせいで商売あがったりだ！\n　ヤツら、忌々しさじゃ武器商ギルド以上だぜ！」\\nw[仲買人]",""],["「獲った魚を遠隔地に運ぶには、塩漬けか干物にするしか\n　ないが……他にいい方法はないもんかなぁ？」\\nw[仲買人]",""],["依頼フキダシ",""],["ギルド通信",""],["矢印",""],["豪商",""],["「海に海賊はつきものだが、最近は動きが活発すぎる。\n　これではおいそれと船が出せんよ」\\nw[豪商]",""],["「海洋貿易はハイリスク・ハイリターン。\n　その賭けに勝ったから、私はいまこうしていられるのさ」\\nw[豪商]",""],["ギルド職員",""],["料理1",""],["奴隷商人",""],["「商品である奴隷の食費もバカにならんし、ウチの船も\n　いっそ護衛を雇って出航してみるかな」\\nw[奴隷商人]",""],["「奴隷は海外での需要も高いんだ。\n　特にこの辺にしかいない一部の亜人なんかは、特にね」\\nw[奴隷商人]",""],["行商人",""],["「海賊のせいで商品が入荷してこなくて、困ったもんだよ。\n　あきらめて別の町へ行こうかな……」\\nw[行商人]",""],["「奴隷売買がもうかるって言っても、人間や亜人を\n　扱うのは大変そうだな」\\nw[行商人]",""],["女商人",""],["「最近はさっぱり海賊が出なくなったらしいわね。\n　海軍が討伐したわけじゃないそうだけど」\\nw[船具商人]",""],["「海賊がウロチョロしてるせいで、売り上げは半減よ！\n　早くなんとかして欲しいわ」\\nw[船具商人]",""],["「海賊の本拠地は海賊島っていう島らしいけど、海の\n　難所にあるんで海軍も近づけないんですって」\\nw[船具商人]",""]],"context":[["Map073/events/1/name"],["Map073/events/1/pages/0/list/1/message/noPicture/bottom"],["Map073/events/1/pages/0/list/7/message/noPicture/bottom"],["Map073/events/2/name"],["Map073/events/3/name"],["Map073/events/4/name"],["Map073/events/5/name"],["Map073/events/6/name"],["Map073/events/7/name"],["Map073/events/8/name"],["Map073/events/10/name"],["Map073/events/10/pages/0/list/0/comment"],["Map073/events/10/pages/0/list/10/comment"],["Map073/events/10/pages/0/list/12/message/noPicture/bottom"],["Map073/events/10/pages/0/list/19/message/noPicture/bottom"],["Map073/events/10/pages/0/list/25/message/noPicture/bottom"],["Map073/events/11/name","Map073/events/15/name"],["Map073/events/12/name"],["Map073/events/13/name"],["Map073/events/14/name"],["Map073/events/14/pages/0/list/1/message/noPicture/bottom"],["Map073/events/14/pages/0/list/7/message/noPicture/bottom"],["Map073/events/16/name"],["Map073/events/17/name"],["Map073/events/18/name"],["Map073/events/18/pages/0/list/1/message/noPicture/bottom"],["Map073/events/18/pages/0/list/7/message/noPicture/bottom","Map073/events/18/pages/2/list/0/message/noPicture/bottom"],["Map073/events/19/name"],["Map073/events/19/pages/0/list/1/message/noPicture/bottom"],["Map073/events/19/pages/0/list/7/message/noPicture/bottom","Map073/events/19/pages/2/list/0/message/noPicture/bottom"],["Map073/events/20/name"],["Map073/events/20/pages/0/list/1/message/noPicture/bottom"],["Map073/events/20/pages/0/list/8/message/noPicture/bottom"],["Map073/events/20/pages/0/list/14/message/noPicture/bottom"]],"tags":[["gold"],null,null,["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,null,null,["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],null,null,["gold"],null,null,["gold"]],"parameters":[null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}]],"indexIds":{"商人":0,"「ウチの商会でも出航を検討してみたが、いまは大人しく\n　しているのがいいという結論になったよ」\\nw[商人]":1,"「海洋貿易はいいぞ～！\n　たまに船が沈没するけどな！」\\nw[商人]":2,"EV002":3,"火":4,"EV004":5,"EV005":6,"EV006":7,"EV007":8,"光":9,"仲買人（依頼05）":10,"依頼を出している場合":11,"依頼を出していない場合":12,"「最近海賊が出ないのは、ヤツラの内部でなにかあった\n　からかもな。例えば内乱とか跡目争いとか、そういう」\\nw[仲買人]":13,"「海賊のせいで商売あがったりだ！\n　ヤツら、忌々しさじゃ武器商ギルド以上だぜ！」\\nw[仲買人]":14,"「獲った魚を遠隔地に運ぶには、塩漬けか干物にするしか\n　ないが……他にいい方法はないもんかなぁ？」\\nw[仲買人]":15,"依頼フキダシ":16,"ギルド通信":17,"矢印":18,"豪商":19,"「海に海賊はつきものだが、最近は動きが活発すぎる。\n　これではおいそれと船が出せんよ」\\nw[豪商]":20,"「海洋貿易はハイリスク・ハイリターン。\n　その賭けに勝ったから、私はいまこうしていられるのさ」\\nw[豪商]":21,"ギルド職員":22,"料理1":23,"奴隷商人":24,"「商品である奴隷の食費もバカにならんし、ウチの船も\n　いっそ護衛を雇って出航してみるかな」\\nw[奴隷商人]":25,"「奴隷は海外での需要も高いんだ。\n　特にこの辺にしかいない一部の亜人なんかは、特にね」\\nw[奴隷商人]":26,"行商人":27,"「海賊のせいで商品が入荷してこなくて、困ったもんだよ。\n　あきらめて別の町へ行こうかな……」\\nw[行商人]":28,"「奴隷売買がもうかるって言っても、人間や亜人を\n　扱うのは大変そうだな」\\nw[行商人]":29,"女商人":30,"「最近はさっぱり海賊が出なくなったらしいわね。\n　海軍が討伐したわけじゃないそうだけど」\\nw[船具商人]":31,"「海賊がウロチョロしてるせいで、売り上げは半減よ！\n　早くなんとかして欲しいわ」\\nw[船具商人]":32,"「海賊の本拠地は海賊島っていう島らしいけど、海の\n　難所にあるんで海軍も近づけないんですって」\\nw[船具商人]":33},"extension":"json","dataType":"map","filename":"Map073","basename":"Map073.json","path":"data/Map073.json","relPath":"data/Map073.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":34,"percent":0},"cellInfo":[]},"data/Map074.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　『海賊と戦った男たち』\n\\>\n\\>『……後年、ウェーベロイ沖海戦とも呼ばれるように\n\\>　なったこの戦いで、ウェーベロイは甚大な被害を被\n\\>　った。\n\\>　停泊中の船の大半が燃え、その火は陸にも上がって\n\\>　商品を溜め込んだ倉庫ごと、すべてを灰に変えたの\n\\>　である。\n\\>　\n\\>　このとき名ばかりの王国海軍と有志商船連合は敗北\n\\>　したが、略奪する物が燃えてしまったせいで海賊が\n\\>　撤退したため、かろうじて壊滅だけは免れた』",""],["MWL_行数リセット",""],["\\>　　　　　　　『東方世界見聞帳』\n\\>\n\\>『……意外なことに、その地でもっとも喜ばれたのは、\n\\>　氷雪の里の雪中酒でもなければ、フィニア産のチーズ\n\\>　でもなかった。\n\\>　人々が先を争って買ったものは、なんとサンドボウ産\n\\>　のサソリの燻製だったのだ！\n\\>　\n\\>　サソリの燻製といえば薬種として使われることがもっ\n\\>　ぱらであるが、サソリという生き物が存在しないその\n\\>　地では、なぜか燻製を呪術から身を守るためのお守り\n\\>　として皆が買い求め……』",""]],"context":[["Map074/events/1/name"],["Map074/events/2/name"],["Map074/events/3/name"],["Map074/events/5/name","Map074/events/6/name"],["Map074/events/5/pages/0/list/2/Plugin Command","Map074/events/5/pages/1/list/2/Plugin Command","Map074/events/6/pages/0/list/2/Plugin Command","Map074/events/6/pages/1/list/2/Plugin Command"],["Map074/events/5/pages/0/list/3/scrollingMessage","Map074/events/5/pages/1/list/3/scrollingMessage"],["Map074/events/5/pages/0/list/16/Plugin Command","Map074/events/5/pages/1/list/16/Plugin Command","Map074/events/6/pages/0/list/16/Plugin Command","Map074/events/6/pages/1/list/16/Plugin Command"],["Map074/events/6/pages/0/list/3/scrollingMessage","Map074/events/6/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"本":3,"MWL_行数変更 16":4,"\\>　　　　　　　『海賊と戦った男たち』\n\\>\n\\>『……後年、ウェーベロイ沖海戦とも呼ばれるように\n\\>　なったこの戦いで、ウェーベロイは甚大な被害を被\n\\>　った。\n\\>　停泊中の船の大半が燃え、その火は陸にも上がって\n\\>　商品を溜め込んだ倉庫ごと、すべてを灰に変えたの\n\\>　である。\n\\>　\n\\>　このとき名ばかりの王国海軍と有志商船連合は敗北\n\\>　したが、略奪する物が燃えてしまったせいで海賊が\n\\>　撤退したため、かろうじて壊滅だけは免れた』":5,"MWL_行数リセット":6,"\\>　　　　　　　『東方世界見聞帳』\n\\>\n\\>『……意外なことに、その地でもっとも喜ばれたのは、\n\\>　氷雪の里の雪中酒でもなければ、フィニア産のチーズ\n\\>　でもなかった。\n\\>　人々が先を争って買ったものは、なんとサンドボウ産\n\\>　のサソリの燻製だったのだ！\n\\>　\n\\>　サソリの燻製といえば薬種として使われることがもっ\n\\>　ぱらであるが、サソリという生き物が存在しないその\n\\>　地では、なぜか燻製を呪術から身を守るためのお守り\n\\>　として皆が買い求め……』":7},"extension":"json","dataType":"map","filename":"Map074","basename":"Map074.json","path":"data/Map074.json","relPath":"data/Map074.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":8,"percent":0},"cellInfo":[]},"data/Map075.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["火",""],["商人",""],["「\\N[6]のせいでかなりの損失を出してしまったよ。\n　だけど、武器商ギルドが弱ってきた今こそ挽回のチャンス\n　かもしれない」\\nw[商人]",""],["「やっと届いた荷が、モンスターどもに滅茶苦茶に\n　されちまった……！」\\nw[商人]",""],["「契約した商品が届くのを待ってるんだが、約束の期日は\n　もう過ぎてるんだ。大丈夫かな……」\\nw[商人]",""],["EV006",""],["EV007",""],["光",""],["依頼フキダシ",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「悪竜アルテト……あの恐ろしい姿を、いまでも悪夢に\n　見るんだ」\\nw[仲買人]",""],["「オレ見たんだ！\n　真っ赤な赤い竜だった！　しかも角が四本だ！\n　あれこそ悪竜アルテトに違いない！」\\nw[仲買人]",""],["「奴隷の売買にかかわってると、嫌な顔されることなんて\n　しょっちゅうさ。\n　そいつらだって奴隷の恩恵を受けてるくせにな」\\nw[仲買人]",""],["EV011",""],["ギルド通信",""],["矢印",""],["豪商",""],["「この街で長年商売をしてるが、あれほどのモンスターの\n　大群が襲ってくるなど、初めてのことだったよ」\\nw[豪商]",""],["「この街は気に入ったかね？\n　時間があるならゆっくり見て回るといい」\\nw[豪商]",""],["ギルド職員",""],["「\\N[6]は倒されたそうだが、また甦ってきたり\n　しないだろうな？」\\nw[商人]",""],["「\\N[6]なんてお伽話の中のモンスターだろ？\n　それがなんで副都に現れるんだよ……！」\\nw[商人]",""],["「副都から北東の方向に行くと、古くてデカイ塔が建って\n　るんだ。\\nw[商人]",""],["「\\C[17]風の塔\\C[0]なんて呼ばれてるようだけど、いつごろから\n　建ってるのか誰も知らないのさ」\\nw[商人]",""],["女商人",""],["「チェリア姫が女王様かぁ。\n　これで犯罪者の取り締まりが正常化すれば、奴隷に\n　回される数も増えるかもね」\\nw[奴隷商人]",""],["「はぁ……。モンスター襲撃の混乱が原因で、商品の\n　奴隷がほとんど逃げちゃったわ……」\\nw[奴隷商人]",""],["「あら、あなたも奴隷を商っているの？\n　隙を見せると逃げようとするから、管理が大変よね」\\nw[奴隷商人]",""]],"context":[["Map075/events/1/name"],["Map075/events/2/name"],["Map075/events/3/name"],["Map075/events/4/name"],["Map075/events/5/name","Map075/events/17/name"],["Map075/events/5/pages/0/list/1/message/noPicture/bottom"],["Map075/events/5/pages/0/list/9/message/noPicture/bottom"],["Map075/events/5/pages/0/list/14/message/noPicture/bottom"],["Map075/events/6/name"],["Map075/events/7/name"],["Map075/events/8/name"],["Map075/events/9/name"],["Map075/events/10/name"],["Map075/events/10/pages/0/list/0/comment"],["Map075/events/10/pages/0/list/10/comment"],["Map075/events/10/pages/0/list/12/message/noPicture/bottom"],["Map075/events/10/pages/0/list/19/message/noPicture/bottom"],["Map075/events/10/pages/0/list/25/message/noPicture/bottom"],["Map075/events/11/name"],["Map075/events/12/name"],["Map075/events/13/name"],["Map075/events/14/name"],["Map075/events/14/pages/0/list/1/message/noPicture/bottom"],["Map075/events/14/pages/0/list/6/message/noPicture/bottom"],["Map075/events/16/name"],["Map075/events/17/pages/0/list/1/message/noPicture/bottom"],["Map075/events/17/pages/0/list/8/message/noPicture/bottom"],["Map075/events/17/pages/0/list/13/message/noPicture/bottom"],["Map075/events/17/pages/0/list/16/message/noPicture/bottom"],["Map075/events/18/name"],["Map075/events/18/pages/0/list/1/message/noPicture/bottom"],["Map075/events/18/pages/0/list/9/message/noPicture/bottom"],["Map075/events/18/pages/0/list/14/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],null,null,null,["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,null,null,["gold"],["gold"],["gold"],["gold"],null,null,["gold"],null,null,null,null,["gold"]],"parameters":[null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":10,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"火":3,"商人":4,"「\\N[6]のせいでかなりの損失を出してしまったよ。\n　だけど、武器商ギルドが弱ってきた今こそ挽回のチャンス\n　かもしれない」\\nw[商人]":5,"「やっと届いた荷が、モンスターどもに滅茶苦茶に\n　されちまった……！」\\nw[商人]":6,"「契約した商品が届くのを待ってるんだが、約束の期日は\n　もう過ぎてるんだ。大丈夫かな……」\\nw[商人]":7,"EV006":8,"EV007":9,"光":10,"依頼フキダシ":11,"仲買人（依頼05）":12,"依頼を出している場合":13,"依頼を出していない場合":14,"「悪竜アルテト……あの恐ろしい姿を、いまでも悪夢に\n　見るんだ」\\nw[仲買人]":15,"「オレ見たんだ！\n　真っ赤な赤い竜だった！　しかも角が四本だ！\n　あれこそ悪竜アルテトに違いない！」\\nw[仲買人]":16,"「奴隷の売買にかかわってると、嫌な顔されることなんて\n　しょっちゅうさ。\n　そいつらだって奴隷の恩恵を受けてるくせにな」\\nw[仲買人]":17,"EV011":18,"ギルド通信":19,"矢印":20,"豪商":21,"「この街で長年商売をしてるが、あれほどのモンスターの\n　大群が襲ってくるなど、初めてのことだったよ」\\nw[豪商]":22,"「この街は気に入ったかね？\n　時間があるならゆっくり見て回るといい」\\nw[豪商]":23,"ギルド職員":24,"「\\N[6]は倒されたそうだが、また甦ってきたり\n　しないだろうな？」\\nw[商人]":25,"「\\N[6]なんてお伽話の中のモンスターだろ？\n　それがなんで副都に現れるんだよ……！」\\nw[商人]":26,"「副都から北東の方向に行くと、古くてデカイ塔が建って\n　るんだ。\\nw[商人]":27,"「\\C[17]風の塔\\C[0]なんて呼ばれてるようだけど、いつごろから\n　建ってるのか誰も知らないのさ」\\nw[商人]":28,"女商人":29,"「チェリア姫が女王様かぁ。\n　これで犯罪者の取り締まりが正常化すれば、奴隷に\n　回される数も増えるかもね」\\nw[奴隷商人]":30,"「はぁ……。モンスター襲撃の混乱が原因で、商品の\n　奴隷がほとんど逃げちゃったわ……」\\nw[奴隷商人]":31,"「あら、あなたも奴隷を商っているの？\n　隙を見せると逃げようとするから、管理が大変よね」\\nw[奴隷商人]":32},"extension":"json","dataType":"map","filename":"Map075","basename":"Map075.json","path":"data/Map075.json","relPath":"data/Map075.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":33,"percent":0},"cellInfo":[]},"data/Map076.json":{"data":[["EV001",""],["EV002",""],["ギルド長",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　　　『悪魔の嘘と真実』\n\\>\n\\>『……以上の話より、悪魔が甦った死人から生まれる\n\\>　という説は誤りだと断言できよう。\n\\>\n\\>　疑う者があれば、ためしに悪魔系モンスターに火属\n\\>　性の攻撃をしかけてみるといい。\n\\>　死霊系モンスターと違い、大したダメージは与えら\n\\>　ないはずだ。\n\\>　\n\\>　逆に大地の精気を吸って動くゾンビやゴーストでは\n\\>　ありえないことだが、悪魔は地属性攻撃によって多\n\\>　大なダメージを被るのだ。\n\\>　ひとつ実例を挙げるなら――』",""],["MWL_行数リセット",""],["\\>　　　　　『ほんとうにあった奇跡の話』\n\\>\n\\>『「まったく自分の目が信じられませんでした。\n\\>　　周囲にいた人たちも一人残らず驚いていましたよ」\n\\>\n\\>　このように述べたＡさんは、話を聞く私の前で興奮\n\\>　気味に腕を広げた。\n\\>\n\\>　「いまでも信じられない！　でも本当なんです！\n\\>　　その男は湖の水面をスイスイと歩いてみせたん\n\\>　　ですよ！\n\\>　　あれいは水の神様が起こした奇跡に違いない！」\n\\>　　\n\\>　Ａさんによると、名を尋ねられた男は「ニンポ・\n\\>　ミズグモノ＝ジツ」と名乗ったそうだ。",""],["\\>　　　　『パルフュークの百年史・第二巻』\n\\>\n\\>『……その日のうちに王都ラウ・ディゼルを脱した王は\n\\>　ほとんど身一つで街道を駆け、ときには小舟を漕ぎ、\n\\>　命からがらパルフュークへ逃げ込んだのだ。\n\\>　\n\\>　この反乱劇はなんと１８年ものあいだ続いた。\n\\>　対立の長期化によって王はパルフュークに腰を据えて\n\\>　戦争指揮を執ることとなり、そのために勅令を発して\n\\>　この地を臨時の王都としたのである。\n\\>　\n\\>　いまパルフュークが副都と称されるのは、このような\n\\>　歴史によるものだ。\n\\>　ラウ・ディゼルが奪還された後にも、有事の際の拠点\n\\>　として王都に次ぐ政治的経済的機能を持つよう、長い\n\\>　時間をかけて都市開発が行われてきたのである』",""],["\\>　　　　　　　　『建国王記・第７版』\n\\>\n\\>『……かくして「竜の寝床」へ悪竜を追い詰めたリジェルダ\n\\>　は、仲間たちとともに最後の戦いへ挑んだ。\n\\>　\n\\>　あらゆる魔術の使い手であり、どんな獣より鋭い牙と爪を\n\\>　持ち、ミスリルに迫る硬さの鱗に守られた悪竜アルテト。\n\\>　その討伐は困難を極め、戦いは丸一昼夜のあいだ続いた\n\\>　という。\n\\>\n\\>　ここまで苦難をともにしてきた仲間たちは、一人また一人\n\\>　と倒れていき、リジェルダ自身もその身に大小の傷を無数\n\\>　に負って、悪竜の前に膝をついた。\n\\>　\n\\>　だが不屈の心を持つこの青年はあきらめることなく……』",""]],"context":[["Map076/events/1/name"],["Map076/events/2/name"],["Map076/events/3/name"],["Map076/events/5/name","Map076/events/6/name","Map076/events/7/name"],["Map076/events/5/pages/0/list/2/Plugin Command","Map076/events/5/pages/1/list/2/Plugin Command","Map076/events/6/pages/0/list/2/Plugin Command","Map076/events/6/pages/1/list/2/Plugin Command","Map076/events/7/pages/0/list/2/Plugin Command","Map076/events/7/pages/1/list/2/Plugin Command"],["Map076/events/5/pages/0/list/3/scrollingMessage"],["Map076/events/5/pages/0/list/18/Plugin Command","Map076/events/5/pages/1/list/19/Plugin Command","Map076/events/6/pages/0/list/20/Plugin Command","Map076/events/6/pages/1/list/20/Plugin Command","Map076/events/7/pages/0/list/19/Plugin Command","Map076/events/7/pages/1/list/19/Plugin Command"],["Map076/events/5/pages/1/list/3/scrollingMessage"],["Map076/events/6/pages/0/list/3/scrollingMessage","Map076/events/6/pages/1/list/3/scrollingMessage"],["Map076/events/7/pages/0/list/3/scrollingMessage","Map076/events/7/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]}],[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"ギルド長":2,"本":3,"MWL_行数変更 16":4,"\\>　　　　　　　　『悪魔の嘘と真実』\n\\>\n\\>『……以上の話より、悪魔が甦った死人から生まれる\n\\>　という説は誤りだと断言できよう。\n\\>\n\\>　疑う者があれば、ためしに悪魔系モンスターに火属\n\\>　性の攻撃をしかけてみるといい。\n\\>　死霊系モンスターと違い、大したダメージは与えら\n\\>　ないはずだ。\n\\>　\n\\>　逆に大地の精気を吸って動くゾンビやゴーストでは\n\\>　ありえないことだが、悪魔は地属性攻撃によって多\n\\>　大なダメージを被るのだ。\n\\>　ひとつ実例を挙げるなら――』":5,"MWL_行数リセット":6,"\\>　　　　　『ほんとうにあった奇跡の話』\n\\>\n\\>『「まったく自分の目が信じられませんでした。\n\\>　　周囲にいた人たちも一人残らず驚いていましたよ」\n\\>\n\\>　このように述べたＡさんは、話を聞く私の前で興奮\n\\>　気味に腕を広げた。\n\\>\n\\>　「いまでも信じられない！　でも本当なんです！\n\\>　　その男は湖の水面をスイスイと歩いてみせたん\n\\>　　ですよ！\n\\>　　あれいは水の神様が起こした奇跡に違いない！」\n\\>　　\n\\>　Ａさんによると、名を尋ねられた男は「ニンポ・\n\\>　ミズグモノ＝ジツ」と名乗ったそうだ。":7,"\\>　　　　『パルフュークの百年史・第二巻』\n\\>\n\\>『……その日のうちに王都ラウ・ディゼルを脱した王は\n\\>　ほとんど身一つで街道を駆け、ときには小舟を漕ぎ、\n\\>　命からがらパルフュークへ逃げ込んだのだ。\n\\>　\n\\>　この反乱劇はなんと１８年ものあいだ続いた。\n\\>　対立の長期化によって王はパルフュークに腰を据えて\n\\>　戦争指揮を執ることとなり、そのために勅令を発して\n\\>　この地を臨時の王都としたのである。\n\\>　\n\\>　いまパルフュークが副都と称されるのは、このような\n\\>　歴史によるものだ。\n\\>　ラウ・ディゼルが奪還された後にも、有事の際の拠点\n\\>　として王都に次ぐ政治的経済的機能を持つよう、長い\n\\>　時間をかけて都市開発が行われてきたのである』":8,"\\>　　　　　　　　『建国王記・第７版』\n\\>\n\\>『……かくして「竜の寝床」へ悪竜を追い詰めたリジェルダ\n\\>　は、仲間たちとともに最後の戦いへ挑んだ。\n\\>　\n\\>　あらゆる魔術の使い手であり、どんな獣より鋭い牙と爪を\n\\>　持ち、ミスリルに迫る硬さの鱗に守られた悪竜アルテト。\n\\>　その討伐は困難を極め、戦いは丸一昼夜のあいだ続いた\n\\>　という。\n\\>\n\\>　ここまで苦難をともにしてきた仲間たちは、一人また一人\n\\>　と倒れていき、リジェルダ自身もその身に大小の傷を無数\n\\>　に負って、悪竜の前に膝をついた。\n\\>　\n\\>　だが不屈の心を持つこの青年はあきらめることなく……』":9},"extension":"json","dataType":"map","filename":"Map076","basename":"Map076.json","path":"data/Map076.json","relPath":"data/Map076.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":10,"percent":0},"cellInfo":[]},"data/Map077.json":{"data":[["EV001",""],["火",""],["EV003",""],["EV004",""],["EV005",""],["燭台",""],["光",""],["宿屋の主人",""],["宿屋の女将",""],["「ウチの料理はおいしわよ。\n　ぜひご賞味あれ」\\nw[宿屋の女将]",""],["料理1",""],["男（依頼03）",""],["「飲んでる俺が悪いんじゃない。\n　うまいこの酒が、ぜぇーんぶ悪いんだよ」\\nw[酒飲みの男]",""],["女性客",""],["「今日は女子会なの。\n　みんなで旦那の悪口を言い合うのよ！」\\nw[女性客]",""],["女性客2",""],["「結婚した時は品のある男だと思ったのに、あの\n　バカ亭主ったら、今じゃ毎日ブーブーおならを\n　撒き散らして……！」\\nw[女性客]",""],["女性客3",""],["「聞いてよ！\n　うちのアホ旦那め、下心ありありで隣りの未亡人に\n　媚び売ってるのよ！」\\nw[女性客]",""],["吟遊詩人",""],["老人",""],["「酒ばっかり飲んどらんと、たまには家に帰ってやれ。\n　そんなんじゃ女房に愛想を尽かされるぞ？」\\nw[老人]",""],["現金（窃盗用）",""],["窃盗の難しさ（1=簡単、2=難しい、3=高難度）",""],["手薄な時間帯（1=昼、2=夜）",""],["チェック",""],["冒険者",""],["「北の方に『水の塔』というダンジョンがあるんだけど、\n　そこでケガをしてしまったんだ。\n　いまはこの宿で療養中というわけさ」\\nw[冒険者]",""],["労働者1",""],["「かっー！　酒がうまい！\n　この一杯のために仕事してるようなもんだよな」\\nw[労働者]",""],["労働者2",""],["「おい、今日は呑みすぎんなよ。\n　いいか、おめぇはもうちょっと節度ってもんを持て」\\nw[労働者]",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["ユマ（トイレ）",""],["絶倫おじさん（依頼16）",""],["依頼を出している場合",""],["依頼フキダシ",""],["変態紳士（依頼17）",""]],"context":[["Map077/events/1/name"],["Map077/events/2/name"],["Map077/events/3/name"],["Map077/events/4/name"],["Map077/events/5/name"],["Map077/events/6/name"],["Map077/events/7/name"],["Map077/events/8/name"],["Map077/events/9/name"],["Map077/events/9/pages/0/list/0/message/noPicture/bottom"],["Map077/events/10/name","Map077/events/21/name"],["Map077/events/11/name"],["Map077/events/11/pages/0/list/0/message/noPicture/bottom"],["Map077/events/12/name"],["Map077/events/12/pages/0/list/0/message/noPicture/bottom","Map077/events/12/pages/2/list/0/message/noPicture/bottom"],["Map077/events/13/name"],["Map077/events/13/pages/0/list/0/message/noPicture/bottom","Map077/events/13/pages/2/list/0/message/noPicture/bottom"],["Map077/events/14/name"],["Map077/events/14/pages/0/list/0/message/noPicture/bottom","Map077/events/14/pages/2/list/0/message/noPicture/bottom"],["Map077/even