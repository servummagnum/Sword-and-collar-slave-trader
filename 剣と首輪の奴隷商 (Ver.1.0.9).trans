"",0,0,2]}],null,[{"headerIndex":2,"headerParam":["",0,0,2]},{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":20,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":29,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["初回会話Ev"]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],[{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":38,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["",0,0,2]}],[{"headerIndex":59,"headerParam":["",0,0,2]},{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":63,"headerParam":["",0,0,2]},{"headerIndex":53,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]},{"headerIndex":58,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]},{"headerIndex":84,"headerParam":["",0,0,2]}],[{"headerIndex":85,"headerParam":["",0,0,2]},{"headerIndex":88,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":104,"headerParam":["",0,0,2]}],[{"headerIndex":109,"headerParam":["",0,0,2]}],[{"headerIndex":114,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["秘密文書提出Ev"]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":69,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["",0,0,2]}],[{"headerIndex":102,"headerParam":["",0,0,2]}],[{"headerIndex":2,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":13,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":3,"headerParam":[2,false]}],[{"headerIndex":21,"headerParam":["",0,0,1]}],[{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"本":2,"MWL_行数変更 16":3,"\\>　　　　『奴隷制を維持するための提言』\n\\>\n\\>『……しかしこれは事実なのだ。\n\\>\n\\>　亜人とは総じて人間よりも愚かであり、もし同等に\n\\>　扱えば社会的に混乱が起こることは火を見るより\n\\>　明らかである。\n\\>　\n\\>　それでも亜人に法と秩序を理解させ、教化しようと\n\\>　いうならば、奴隷という形で人間社会に迎え入れる\n\\>　しかない。\n\\>　\n\\>　対等な立場からの融和など、試みるだけ無駄という\n\\>　ものだろう。』":4,"MWL_行数リセット":5,"\\>　　　　　『流通の支配率に関する報告』\n\\>\n\\>『この３年間に、金属、革、木材、煙草などの流通\n\\>　は、その半分以上を武器商ギルドが押さえること\n\\>　に成功した。\n\\>　\n\\>　このように多様な品々を扱うようになったことで、\n\\>　「武器商ギルド」という組織名は実体から乖離して\n\\>　しまったといえよう。\n\\>　新たな名称への刷新も考えるべきである。\n\\>　\n\\>　我々の躍進は、商業ギルドの大きすぎる力を削ろう\n\\>　とする国王陛下の英断によるところが大きいが――』":6,"エルラ":7,"「なんであんたらが武器商ギルドにいるのよ？\n　部外者は出ていって欲しいんだけど？」\\nw[\\N[3]]":8,"「\\N[3]、本当に武器商ギルドへ移っちゃったんだね」\\nw[\\N[2]]":9,"「そう言ったでしょう。\n　あんたの所の商会と違って、ウチは先見の明があるから\n　当然よ！」\\nw[\\N[3]]":10,"「汚い手で同業者を潰しておいて、よく言う。\n　それでギルド幹部だと？\\nw[\\N[1]]":11,"「武器商ギルドは悪人ほど良い地位に就ける組織らしいな」\\nw[\\N[1]]":12,"「フンッ！　何を言おうが負け犬の遠吠えよ！\n　好きなだけワンワン喚いていればいいわ！」\\nw[\\N[3]]":13,"「\\N[3]……」\\nw[\\N[2]]":14,"「シッシッ！\n　部外者は出ていって欲しいんだけど？」\\nw[\\N[3]]":15,"バルコルド":16,"「何をしに来た、痴れ者どもが。\n　お嬢様に危害を加えるつもりなら容赦はせんぞ」\\nw[\\N[4]]":17,"「い、いえっ！　わたしたちそんなつもりじゃ！」\\nw[\\N[2]]":18,"「格好ばかりで立ち居振る舞いが執事らしくないな。\n　本職はなんだ？　傭兵か？　それとも冒険者か？」\\nw[\\N[1]]":19,"「そういうお前こそ、商人などと下手な嘘を。\n　正体は商業ギルドお抱えのアサシンといったところか？」\\nw[\\N[4]]":20,"「俺は正真正銘の商人だッ！！」\\nw[\\N[1]]":21,"「\\N[1]さん……せめてフードを外せば誤解も\n　減るのでは……？」\\nw[\\N[2]]":22,"武器商ギルド総長":23,"初回会話Ev":24,"「ほほぅ、商業ギルドのスパイにしては堂々と入って\n　きたものだな」\\nw[武器商ギルド総長]":25,"「とんでもない！　噂の武器商ギルドがどんなものか、\n　ちょっと見させてもらってるだけさ」\\nw[\\N[1]]":26,"「す、すみません。お邪魔でしたらすぐ出て行きますから」\\nw[\\N[2]]":27,"「なぁに、構わんよ！\\nw[武器商ギルド総長]":28,"「お前たちがどれだけ嗅ぎ回ろうと、\\C[17]我々が不利になる\n　ような証拠\\C[0]など出てくるはずもないからな！」\\nw[武器商ギルド総長]":29,"「その証拠っていうのは、もしかしてこれか？」\\nw[\\N[1]]":30,"「な、なぜそれをお前が！？　ぐぬぬっ！」\\nw[武器商ギルド総長]":31,"「実はいま、ちょーっと路銀が足りてないんだよなぁ！\n　いや、他意はないんだけどなぁ！」\\nw[\\N[1]]":32,"「わ、分かった！　それはこちらで買い取ろう！\n　だから内密に頼む！」\\nw[武器商ギルド総長]":33,"『\\in[58]』\\v[1]冊を\\C[17]\\v[2]Ｇ\\C[0]と交換した！":34,"すべての『\\in[58]』を交換し終えた！":35,"「いや、だからスパイじゃないって言ってるだろ」\\nw[\\N[1]]":36,"「シラを切りおって。……フン、まあいい」\\nw[武器商ギルド総長]":37,"「わたしたち、完全にスパイだと勘違いされちゃった\n　みたいですね……」\\nw[\\N[2]]":38,"（しかし、こうも自信満々なところを見ると、後ろ暗い\n　アレコレに関する証拠は、どこかに隠しているんだ\n　ろうな……）\\nw[\\N[1]]":39,"秘密文書提出Ev":40,"持っている\\C[17]『\\in[58]』\\C[0]を、武器商ギルド総長に\n見せますか？":41,"見せる":42,"見せない":43,"「やあ！　忙しいところ悪いが、俺が偶然見つけたこの\n　\\C[17]『秘密文書』\\C[0]について話をしたいんだが？」\\nw[\\N[1]]":44,"「またか！？　分かった、こちらで買い取る！\n　だから内密に頼む！」\\nw[武器商ギルド総長]":45,"「スパイめ！　不正取引の証拠でも探しているのだろうが、\n　見つかるものか！　我がギルドは清廉潔白だからな！」\\nw[武器商ギルド総長]":46,"「スパイめ！　まだ不正取引の証拠を探しているのか！？\n　無駄だからやめておけ！」\\nw[武器商ギルド総長]":47,"「不正の証拠となる文書は全部買い取ったが……しかし……。\\nw[武器商ギルド総長]":48,"「王の後ろ盾が無くなったせいで、他にもまずいアレコレが\n　どんどん暴露されて……あぁっ、頭が痛い……」\\nw[武器商ギルド総長]":49,"「ふはははっ！　もう証拠となる文書は無いはずだ！\n　ざまぁみろ！\\nw[武器商ギルド総長]":50,"「……って、全部見つかっちゃったのかぁ。\n　そっかぁ……ははは……」\\nw[武器商ギルド総長]":51,"トークマーク":52,"本（秘密文書リスト）":53,"\\>　　　　　『？？？？リスト（持ち出し厳禁）』\n\\>\n\\>『　01：王都ラウディゼル\n\\>　　02：副都パルフューク\n\\>　　03：南都タータミア\n\\>　　04：島の町シーグヌース\n\\>　　05：西グレド村\n\\>　　06：チュワ村\n\\>　　07：氷雪の里コールディ\n\\>　　08：オアシス・サンドボウ\n\\>　　09：四聖教大聖堂\n\\>　　10：鉱山　　　　　　　　　』":54,"\n\\>　※　マップに\\C[17]『秘密文書』の位置\\C[0]が追加されました　※":55,"\\>　　　　　『？？？？リスト（持ち出し厳禁）』\n\\>\n\\>『01：王都ラウディゼル\n\\>　02：副都パルフューク\n\\>　03：南都タータミア\n\\>　04：島の町シーグヌース\n\\>　05：西グレド村\n\\>　06：チュワ村\n\\>　07：氷雪の里コールディ\n\\>　08：オアシス・サンドボウ\n\\>　09：四聖教大聖堂\n\\>　10：鉱山　　　　　　　　　　』":56,"秘密文書":57},"extension":"json","dataType":"map","filename":"Map425","basename":"Map425.json","path":"data/Map425.json","relPath":"data/Map425.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":58,"percent":0},"cellInfo":[]},"data/Map426.json":{"data":[["操舵士（砲撃No.13）",""],["水夫1（砲撃No.01）",""],["水夫2（砲撃No.06）",""],["船長（戦闘Ev）",""],["C_STOP",""],["「野郎ども！　略奪の時間だ！\n　乗り込んで金目のものを奪え！」\\nw[海賊船長]",""],["\\{「オーーーッ！！！」\\}\\nw[海賊たち]",""],["「くそぉっ！！　海賊が船に乗り込んできたぞ！！」\\nw[水夫]",""],["FocusCamera 36 14 120",""],["「よくもオレの船に！！　許さんぞ！！」\\nw[船長]",""],["「護衛の冒険者たち！　出番だ！\n　海賊どもから船を守ってくれ！\\nw[船長]",""],["「見事撃退した暁には、特別ボーナスを出してやるから\n　気張ってくれ！」\\nw[船長]",""],["「任せて！　すぐに倒してあげるわ！」\\nw[冒険者Ａ]",""],["「この船を襲ったことを、後悔させてやるさ！」\\nw[冒険者Ｃ]",""],["「俺たちも行くぞ。\n　冒険者として乗り込んだ以上は、働かんとな」\\nw[\\N[1]]",""],["「なんとなく、こうなる気はしてたんですよね……」\\nw[\\N[2]]",""],["「ちょっと待ってくれ。\n　お前たち二人には、別に頼みたいことがある」\\nw[船長]",""],["「なに？」\\nw[\\N[1]]",""],["「大砲じゃないですか！？」\\nw[\\N[2]]",""],["「こんなモンがあるんだったら、海賊船が近づく前に\n　撃っておけよ！」\\nw[\\N[1]]",""],["「そうしなかったのには理由があるのだ。\n　この大砲、実は\\C[17]不良品\\C[0]でな。威力が全然ないのだよ。\\nw[船長]",""],["「敵船に撃ってもダメージは与えられんだろう。\n　しかし人間相手になら効果はあるはずだ。\\nw[船長]",""],["「お前たちには、\\C[17]この大砲で海賊を撃ってもらいたい\\C[0]」\\nw[船長]",""],["「ええぇーーっ？！　そんな無茶なぁ！！」\\nw[\\N[2]]",""],["「撃てたとして、狙い通りに当たるとも思えんが……」\\nw[\\N[1]]",""],["「オレは戦闘の指揮をとらなきゃならんから、他に頼める\n　人間がいないのだ。とにかくやってみてくれ！」\\nw[船長]",""],["「仕方ない、やるぞっ！　\\N[2]ッ、手伝え！」\\nw[\\N[1]]",""],["「ほんと、嫌な予感してたんですよねぇ……」\\nw[\\N[2]]",""],["FocusCamera 16 14 120",""],["C_START",""],["水夫3（砲撃No.08）",""],["冒険者1（砲撃No.03）",""],["冒険者2（砲撃No.05）",""],["冒険者3（砲撃No.12）",""],["冒険者4（砲撃No.14）",""],["海賊1（砲撃No.02）",""],["海賊2（砲撃No.04）",""],["海賊3（砲撃No.07）",""],["海賊4（砲撃No.10）",""],["海賊5（砲撃No.11）",""],["海賊6（砲撃No.15）",""],["海賊船長",""],["EV017",""],["EV018",""],["ユマ",""],["コンテナ1",""],["コンテナ2",""],["ターゲットサークル",""],["船長（砲撃No.09）",""]],"context":[["Map426/events/1/name"],["Map426/events/2/name"],["Map426/events/3/name"],["Map426/events/4/name"],["Map426/events/4/pages/0/list/0/Plugin Command"],["Map426/events/4/pages/0/list/52/message/noPicture/bottom"],["Map426/events/4/pages/0/list/62/message/noPicture/bottom"],["Map426/events/4/pages/0/list/103/message/noPicture/bottom"],["Map426/events/4/pages/0/list/106/Plugin Command"],["Map426/events/4/pages/0/list/109/message/noPicture/bottom"],["Map426/events/4/pages/0/list/114/message/noPicture/bottom"],["Map426/events/4/pages/0/list/117/message/noPicture/bottom"],["Map426/events/4/pages/0/list/122/message/noPicture/bottom"],["Map426/events/4/pages/0/list/125/message/noPicture/bottom"],["Map426/events/4/pages/0/list/203/message/noPicture/bottom"],["Map426/events/4/pages/0/list/210/message/noPicture/bottom"],["Map426/events/4/pages/0/list/215/message/noPicture/bottom"],["Map426/events/4/pages/0/list/219/message/noPicture/bottom"],["Map426/events/4/pages/0/list/256/message/noPicture/bottom"],[