}]],"indexIds":{"EV001":0,"桶の水を持っていく先は、ここではない。":1,"clear_all_weathers":2,"disable_footsteps":3,"EV002":4,"EV003":5,"EV004":6,"EV005":7,"敵索敵スタート":8,"PSS start":9,"中庭":10,"宝箱（消耗品左開き）":11,"<TE:15>":12,"宝箱（お金正面開き）":13,"<TE:16>":14,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":15,"光":16,"敵01":17,"<PsensorS:\\V[1166] Rv\\S[22]>":18,"探索範囲にプレイヤー侵入":19,"SmartPath 0 -1":20,"SmartPath 0 cancel":21,"敵に見つかっている場合の戦闘":22,"勝利したとき":23,"PSS t_stop":24,"逃げたとき":25,"戦闘から離脱したときの処理":26,"PSS t_start":27,"敵がプレイヤーを見失ったときの処理":28,"敵02":29,"敵03":30,"敵04":31,"EV014":32,"移動可能岩":33,"移動終了岩":34,"敵ボス":35,"野外トイレ（排泄Ev）":36,"<TE:82>":37,"回復魔法陣":38,"モンスター進入禁止":39,"EV021":40,"冒険者1":41,"「ここまで来たのに、奥への扉が開かないなんて……」\\nw[冒険者]":42,"冒険者2":43,"「がんばって雪をどかしても、すぐにまた雪が降って\n　きて積もっちゃうのよ。\n　もういや……」\\nw[冒険者]":44,"冒険者3":45,"「あの扉の向こうには、きっとお宝があるはずなんだ！\n　雪さえ……雪さえなければ……！」\\nw[冒険者]":46,"冒険者4":47,"「ここは僕たち冒険者が共同で作った避難場所なんだ。\\nw[冒険者]":48,"「あの扉の前に積もった雪をどかすには、かなりの時間が\n　かかりそうだから、腰を据えて作業するためにね」\\nw[冒険者]":49,"冒険者5":50,"「何人もの冒険者が先へ進めないまま、ここで朽ちて\n　いったんだ……」\\nw[冒険者]":51,"行き止まりEv":52,"「あんなところに穴が開いてるぞ」\\nw[\\N[1]]":53,"「もしかして、あそこから中に入れるんじゃ！？」\\nw[\\N[2]]":54,"「上まで登れればな。\n　だが壁は凍ってツルツルだし、ジャンプして届く距離\n　でもない」\\nw[\\N[1]]":55,"「ダメですか……。\n　なにか上る方法はないんでしょうか？」\\nw[\\N[2]]":56,"「あるかもしれないが、今は思いつかないな。\n　仕方ない、あきらめるとしよう」\\nw[\\N[1]]":57,"「どこか他に、登れる場所はないでしょうか？」\\nw[\\N[2]]":58,"「そうだな、無いとも限らん。\n　一応\\C[17]この中庭をさがしてみる\\C[0]か」\\nw[\\N[1]]":59,"上へ登る方法がないか、この中庭を探してみよう。":60,"冒険者6":61,"「交代で雪かきしてるけど、全然終わらないぜ。\n　もう無理だろ、これ……」\\nw[冒険者]":62,"桶":63,"桶の水には薄氷が張っている。":64,"「なあ、この桶の水もらっていいか？」\\nw[\\N[1]]":65,"「別にかまわないけど？」\\nw[冒険者]":66,"「どうするんですか、水なんて？」\\nw[\\N[2]]":67,"「見てりゃわかる。\n　さっきの穴のところまで戻るぞ」\\nw[\\N[1]]":68,"\\C[17]『桶の水』\\C[0]を手に入れた！":69,"桶矢印":70,"滑り矢印":71,"EV032":72,"「ここにもらってきた水を流して……と」\\nw[\\N[1]]":73,"「で、少し待てば――」\\nw[\\N[1]]":74,"「ツルツルに凍った！？」\\nw[\\N[2]]":75,"「よしっ、じゃあ行くぞ！」\\nw[\\N[1]]":76,"「はい？　行くってどこに……？」\\nw[\\N[2]]":77,"「あわわわっ……と、飛んだ！？」\\nw[\\N[2]]":78,"「いやぁ、思ったよりギリギリだったが、うまくいって\n　よかった」\\nw[\\N[1]]":79,"（ちょっとオシッコ、ちびっちゃった……）\\nw[\\N[2]]":80,"氷1":81,"氷の滑り台でジャンプしますか？":82,"する":83,"しない":84,"氷2":85,"氷3":86,"氷4":87,"氷5":88,"氷6":89,"氷7":90,"氷8":91,"氷9":92,"氷10":93,"飛び降り":94,"雪山に向かって飛び降りますか？":95,"飛び降りる":96,"やめておく":97,"EV045":98,"トイレマーク":99,"<TE:84>":100,"盗賊(悪魔A)Ｒ":101,"｢ねぇねぇ、あたしと遊んでいかない？　フフ……\\I[29]」\\nw[悪魔]":102,"奴隷化性別：0=女、1=男、2=男女ランダム":103,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":104,"戦闘マーク":105,"雪山":106},"extension":"json","dataType":"map","filename":"Map256","basename":"Map256.json","path":"data/Map256.json","relPath":"data/Map256.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":107,"percent":0},"cellInfo":[]},"data/Map257.json":{"data":[["EV001",""],["C_DISABLE_WEATHER",""],["weather : 0 : 9 : 20 : 70 : 0 : Snow_01",""],["EV002",""],["精霊石",""],["壁ひび",""],["※\nアイテム：耐魔力剤\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの総重量を変数に入力する",""]],"context":[["Map257/events/1/name"],["Map257/events/1/pages/0/list/4/Plugin Command","Map257/events/2/pages/0/list/4/Plugin Command"],["Map257/events/1/pages/0/list/5/Plugin Command","Map257/events/2/pages/0/list/5/Plugin Command"],["Map257/events/2/name"],["Map257/events/4/name"],["Map257/events/5/name"],["Map257/events/5/pages/1/list/0/comment"],["Map257/events/5/pages/1/list/3/comment"],["Map257/events/5/pages/1/list/6/comment"],["Map257/events/5/pages/1/list/8/comment"],["Map257/events/5/pages/1/list/10/comment"]],"tags":[["gold"],["blue"],["blue"],["gold"],["gold"],["gold"],["red"],["red"],["red"],["red"],["red"]],"parameters":[null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":3,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":6,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":8,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":10,"headerParam":["↓アイテムの総重量を変数に入力する"]}]],"indexIds":{"EV001":0,"C_DISABLE_WEATHER":1,"weather : 0 : 9 : 20 : 70 :