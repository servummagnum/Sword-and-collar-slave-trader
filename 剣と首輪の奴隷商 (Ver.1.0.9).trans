st/0/message/noPicture/bottom","Map083/events/6/pages/2/list/0/message/noPicture/bottom"]],"tags":[["gold"],["gold"],["gold"],["red"],["red"],["gold"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["窃盗の難しさ（1=簡単、2=難しい、3=高難度）"]}],[{"headerIndex":2,"headerParam":["手薄な時間帯（1=昼、2=夜）"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"現金（窃盗用）":2,"窃盗の難しさ（1=簡単、2=難しい、3=高難度）":3,"手薄な時間帯（1=昼、2=夜）":4,"宿泊客":5,"「この町の冒険者たちは、活気にあふれているね。\n　良くも悪くも」\\nw[宿泊客]":6},"extension":"json","dataType":"map","filename":"Map083","basename":"Map083.json","path":"data/Map083.json","relPath":"data/Map083.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":7,"percent":0},"cellInfo":[]},"data/Map084.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["火",""],["EV005",""],["燭台",""],["光",""],["宿屋の主人",""],["宿屋の女将",""],["「お魚大好きな私たち猫人にとって、港町はちょっとした\n　あこがれの場所なんですよ」\\nw[宿屋の女将]",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["男",""],["「フムフム……安酒もブレンド次第でうまくなるもんだな」\\nw[酒飲みの男]",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["宿泊客（依頼06）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「まいったな……。シーグヌースへ渡りたいのに、\n　海賊のせいでこんなに長く足止めをくらうなんて……」\\nw[宿泊客]",""],["「船の積み荷の上げ下ろしは、ほとんどが奴隷の仕事なの\n　だよ。私の所有している商船でもそうだ」\\nw[宿泊客]",""],["依頼フキダシ",""],["ユマ（トイレ）",""],["絶倫おじさん（依頼16）",""],["吟遊詩人",""],["料理1",""],["料理2",""],["男性冒険者",""],["「\\C[17]迷いの森\\C[0]という深い森を知っているか？\n　かなり危険なダンジョンらしい。\n　ここからだと南の方角にあるそうだが」\\nw[男性冒険者]",""],["「迷いの森というダンジョンを知っているか？\n　かなり危険なダンジョンらしい」\\nw[男性冒険者]",""],["女性冒険者",""],["「海賊対策で護衛を募集してる船があるけど、あたしは\n　パス。だって船酔いしちゃうもの」\\nw[女性冒険者]",""],["「いままでいくつものダンジョンに潜ってきたけど、\n　ひとつとして楽なところなんて無かったわ」\\nw[女性冒険者]",""],["船長",""],["「少し前から、海賊をさっぱり見かけなくなったんだ。\n　改心して真人間に戻ったわけでもあるまいが……」\\nw[船長]",""],["「北海に出没する海賊どもは、海賊島って呼ばれてる\n　島を根城にしてるって話だ」\\nw[船長]",""],["「北の海に出没する海賊どもは、海賊島って呼ばれてる\n　島を根城にしてるって話だ」\\nw[船長]",""],["水夫1",""],["「海賊が出なくなったのは、このオレに恐れをなした\n　からかもな！」\\nw[水夫]",""],["「海賊なんか怖かねぇ！\n　ぶっ殺してやらぁ！」\\nw[水夫]",""],["水夫2",""],["「海賊がいなくなっても、海の魔物は健在だから楽観は\n　できないね」\\nw[水夫]",""],["「海の魔物と海賊、果たしてどっちが怖いか……」\\nw[水夫]",""],["犬",""],["変態紳士（依頼17）",""],["「この街じゃ名の知れてる女船長のところへ、積み荷を\n　届けに行ったんだ。そしたら、その女船長は\\C[17]妙にきれいな\n　玉\\C[0]を手の中で弄んでたのさ。\\nw[男性客]",""],["「オレの玉もいじってください、って言いかけたけど\n　後が怖かったんでやめておいたよ。\n　我ながら賢明な判断だったね、うん」\\nw[男性客]",""],["「船で海外に輸出される奴隷は、大半が戦闘用や肉体\n　労働用だな。外聞もあってか、性奴隷用の女の輸出は\n　それほど多くないらしい」\\nw[男性客]",""]],"context":[["Map084/events/1/name"],["Map084/events/2/name"],["Map084/events/3/name"],["Map084/events/4/name"],["Map084/events/5/name"],["Map084/events/6/name"],["Map084/events/7/name"],["Map084/events/8/name"],["Map084/events/9/name"],["Map084/events/9/pages/0/list/0/message/noPicture/bottom"],["Map084/events/10/name"],["Map084/events/10/pages/1/list/0/message/noPicture/bottom"],["Map084/events/10/pages/1/list/2/Show Choices/2/1from2"],["Map084/events/10/pages/1/list/2/Show Choices/2/2from2"],["Map084/events/10/pages/1/list/12/message/noPicture/bottom"],["Map084/events/11/name","Map084/events/29/name"],["Map084/events/11/pages/0/list/0/message/noPicture/bottom"],["Map084/events/12/name"],["Map084/events/12/note"],["Map084/events/13/name"],["Map084/events/13/pages/0/list/0/comment","Map084/events/16/pages/0/list/1/comment","Map084/events/27/pages/0/list/1/comment"],["Map084/events/13/pages/0/list/10/comment"],["Map084/events/13/pages/0/list/12/message/noPicture/bottom"],["Map084/events/13/pages/0/list/18/message/noPicture/bottom"],["Map084/events/14/name","Map084/events/18/name","Map084/events/28/name"],["Map084/events/15/name"],["Map084/events/16/name"],["Map084/events/17/name"],["Map084/events/19/name"],["Map084/events/20/name"],["Map084/events/21/name"],["Map084/events/21/pages/0/list/0/message/noPicture/bottom"],["Map084/events/21/pages/2/list/0/message/noPicture/bottom"],["Map084/events/22/name"],["Map084/events/22/pages/0/list/1/message/noPicture/bottom","Map084/events/22/pages/2/list/1/message/