"translation":""},{"contextStr":"Map005/events/241/note","translation":""},{"contextStr":"Map005/events/242/note","translation":""},{"contextStr":"Map005/events/243/note","translation":""},{"contextStr":"Map005/events/244/note","translation":""}],[{"contextStr":"Map005/events/245/name","translation":""}],[{"headerIndex":0,"headerParam":["フィールド左右を行き来した際、夜間のみ実行される"]}]],"indexIds":{"マップ左右移動処理":0,"フィールドマップ右→左":1,"コンパス移動処理":2,"違うフィールドへ行ったら、コンパスシルエット表示":3,"元のフィールドへ戻ったら、コンパスシルエット非表示":4,"「雨」の確率切替え（砂漠では降らせない）":5,"C_SET_RAINY_PERCENT 0":6,"C_SET_RAINY_PERCENT \\V[1548]":7,"フィールド左右を行き来したとき、夜だったら盗賊出現":8,"フィールド移動中の盗賊出現・消去\n　夜か朝になった瞬間、盗賊を出したり消したりする処理":9,"盗賊潜伏地03":10,"ポータル":11,"\\C[17]『\\in[50]』\\C[0]を石碑にはめ込みますか？":12,"はめ込む":13,"やめる":14,"石碑が起動し、瞬間移動用のポータルが開いた！":15,"実績 12":16,"伝説によれば、この石碑に\\C[17]『ポータル球』\\C[0]をはめ込む\nことで、瞬間移動ができるポータルが開くのだとか。":17,"西グレド村":18,"街規模変数：都市＝1、町＝2、村＝3、その他＝4、ダンジョン＝5":19,"冒険者の町ハリエーツ":20,"東グレド村":21,"EV010":22,"EV011":23,"フィニア村":24,"イナ村":25,"港湾の町ウェーベロイ":26,"王都ラウ・ディゼル":27,"いま王都に入ると、確実に捕まってしまう。":28,"大神殿":29,"オアシス・サンドボウ":30,"分岐表示板":31,"\n\\>　　←ラノティカ　　　　　　東グレド村→\n\\>　":32,"\n\\>　　←西グレド村　　　　　　南都タータミア→\n\\>　":33,"\\>　←西グレド村　　　　　　　　　　　ハリエーツ→\n\\>　　　　　　　　　　サンドボウ\n\\>　　　　　　　　　　　　↓":34,"\\>　　　　　　↑フィニア村・大聖堂\n\\>\n\\>　　　　　　　↓南都タータミア":35,"\\>　←フィニア村・大聖堂\n\\>　　　　　　　　　　　　　ハリエーツ\n\\>　　　　　　　　　　　　　　　↓":36,"\\>　　　　　　　　　　　↑大聖堂\n\\>　←フィニア村　　\n\\>　　　　　　　　　　↓ハリエーツ":37,"\\>　　　　　　　　　　　　↑大聖堂、ハリエーツ\n\\>　　　　　　　　\n\\>　←王都ラウ・ディゼル":38,"\\>　　　　　　　　　↑ウェーベロイ\n\\>←ソルティモ村　　　　　　　　　　　フィニア村→\n\\>　　　　　　　　　↓ペイサー":39,"\\>←シーグヌース　　　　　　　　　　　　　イナ村→\n\\>　（海路）　　　　王都ラウ・ディゼル\n\\>　　　　　　　　　　　　　↓":40,"\\>　←ウェーベロイ\n\\>　　　　　　　　　　　大聖堂\n\\>　　　　　　　　　　　　↓":41,"\\>　　　　　　　　　↑イナ村\n\\>\n\\>　　　　　↓ハリエーツ・フィニア村":42,"街道盗賊01-1":43,"<PsensorS:\\V[1167] Rv\\S[22]>":44,"夜8時～早朝4時まで出現":45,"朝5時～夜8時までは出現しない":46,"探索範囲にプレイヤー侵入":47,"SmartPath 0 -1":48,"追跡しているプレイヤーと接触":49,"<follower touch>":50,"SmartPath 0 cancel":51,"敵に見つかっている場合の戦闘":52,"PSS t_stop":53,"戦闘から離脱したときの処理":54,"PSS t_start":55,"敵がプレイヤーを見失ったときの処理":56,"奴隷化性別：0=女、1=男、2=男女ランダム":57,"街道盗賊01-2":58,"街道盗賊02-2":59,"街道盗賊02-1":60,"街道盗賊04-1":61,"街道盗賊05-2":62,"街道盗賊06-2":63,"街道盗賊09-2":64,"街道盗賊08-1":65,"街道盗賊10-2":66,"街道盗賊09-1":67,"街道盗賊10-1":68,"街道警備バルーン01":69,"街道警備詰め所01":70,"街道警備バルーン02":71,"街道警備バルーン03":72,"街道警備バルーン04":73,"街道警備バルーン08":74,"街道警備バルーン09":75,"街道警備バルーン10":76,"街道警備バルーン16":77,"街道警備バルーン17":78,"街道警備バルーン18":79,"街道警備バルーン19":80,"街道警備バルーン20":81,"街道警備詰め所02":82,"街道警備詰め所03":83,"街道警備詰め所04":84,"街道警備詰め所08":85,"街道警備詰め所09":86,"街道警備詰め所10":87,"街道警備詰め所16":88,"街道警備詰め所17":89,"街道警備詰め所18":90,"街道警備詰め所19":91,"街道警備詰め所20":92,"盗賊追跡OFF・精霊石(右マップ)":93,"日中はすべての盗賊追跡センサーをoff":94,"PSS stop":95,"夜間は非アクティブな盗賊の追跡センサーをoff":96,"PSS start":97,"街道警備が復活している所の盗賊追跡センサーをoff":98,"\n\n\n倒した街道盗賊のセンサーをoff":99,"\n\n\n落ちてる精霊石の処理":100,"盗賊隠れ家01":101,"イージー":102,"ノーマル":103,"盗賊隠れ家03":104,"weather : 0 : 21 : 15 : 100 : 1 : SunLight_01B":105,"街道調査地点":106,"↓鬼ごっこをどのエリアでやるか、必ず設定すること":107,"依頼フキダシ":108,"敵04":109,"勝利したとき":110,"逃げたとき":111,"盗賊隠れ家6":112,"weather : 0 : 0 : 10 : 70 : 0 : Leaf_01A":113,"敵06":114,"敵05":115,"盗賊隠れ家8":116,"盗賊隠れ家9":117,"隠れ家アイコン":118,"落ちてる精霊石7":119,"敵03":120,"敵02":121,"敵01":122,"指名手配フキダシ":123,"埋設宝箱11":124,"埋設宝箱12":125,"埋設宝箱13":126,"埋設宝箱14":127,"埋設宝箱15":128,"埋設宝箱16":129,"埋設宝箱17":130,"埋設宝箱18":131,"埋設宝箱19":132,"埋設宝箱20":133,"精霊コンパス目標11":134,"↓コンパスの目的地であることを示すコード":135,"<Destination>":136,"精霊コンパス目標12":137,"精霊コンパス目標13":138,"精霊コンパス目標14":139,"精霊コンパス目標15":140,"精霊コンパス目標16":141,"精霊コンパス目標17":142,"精霊コンパス目標18":143,"精霊コンパス目標19":144,"精霊コンパス目標20":145,"ダンジョン1入り口":146,"奴隷不足のとき":147,"\\C[18]※　注意　※\\C[0]\n　伝承学者に手土産として持っていく\\C[17]奴隷の数が不足\\C[0]\n　しています。":148,"このまま地下遺跡に入りますか？":149,"入る":150,"入らない":151,"どの階層へ入りますか？":152,"地下１階":153,"地下２階":154,"地下３階":155,"地下４階":156,"地下５階":157,"ダンジョン3入り口":158,"どこまで進みますか？":159,"洞窟の入り口":160,"洞窟の中間地点":161,"山脈の反対側":162,"洞窟の出口":163,"ダンジョン3裏口":164,"ダンジョン6入り口":165,"地下６階":166,"地下７階":167,"ダンジョン7入り口":168,"迷いの森":169,"森のどこへ行きますか？":170,"入り口":171,"湖の畔":172,"湖畔":173,"最深部":174,"weather : 0 : 29 : 15 : 50 : 1 : Light_01A : 1 : 50":175,"weather : 1 : 29 : 15 : 20 : 1 : Light_01A : 1 : 70":176,"最深部以外":177,"古代遺跡":178,"遺跡のどこへ行きますか？":179,"祭壇の部屋":180,"ハイエルフの森":181,"ver.1.0.2の修正以前に里へ到着してイベントを終えていても、\nここでフラグが立つようにする":182,"ハイエルフの森のどこへ行きますか？":183,"森林１層":184,"森林２層":185,"森林３層":186,"ハイエルフの里":187,"渡し舟航路制御":188,"<C_NoStop:ON>":189,"Ｈエルフの里裏道":190,"裏道フキダシ":191,"王都落ちのび・帰還Ev":192,"「うまく逃げ切れたが、兵士に逮捕の指示が出ていると\n　なると、もう王都には戻れんな」\\nw[\\N[1]]":193,"「わたしたち、反逆者の一味って濡れ衣を着せられ\n　ちゃいましたね」\\nw[\\N[2]]":194,"\n\\>　　※　王都ラウ・ディゼルに入れなくなった\\C[0]　※":195,"「まあいいさ。\n　どうせこれから、迷いの森に行かなきゃならないんだ」\\nw[\\N[1]]":196,"\\>※　生贄を用意して\\C[17]迷いの森\\C[0]に行き、\\C[17]『地母神の乳』\\C[0]を　※\n\\>※　探そう！　　　　　　　　　　　　　　　　　　　　※":197,"地の洞窟・地下3層":198,"「王都へ戻って来たはいいが、普通に入れば兵士に\n　捕まっちまうな」\\nw[\\N[1]]":199,"「こっそり忍び込まなきゃなりませんね」\\nw[\\N[2]]":200,"「よし、変装して街に入るぞ！」\\nw[\\N[1]]":201,"↓王都潜入が夜間にならないよう時間調整":202,"C_ADD_TIME 420":203,"C_ADD_TIME 780":204,"迷いの森表示板":205,"『ここより先、迷いの森。\n　命惜しくば、立ち入るべからず』":206,"個別依頼07（フィールド）":207,"地上絵の野望（第二段階）":208,"労働奴隷を所持しているかチェック":209,"肉体労働用の奴隷":210,"奴隷が規定人数以上あるとき":211,"奴隷が規定人数以下のとき":212,"「いま欲しいのは\\C[17]肉体労働用の奴隷が２人\\C[0]だ。\n　作業を止めたくないから、早いところ頼むよ」\\nw[外道アーティスト]":213,"「これが地上絵か。\n　想像していた以上にデカいな」\\nw[\\N[1]]":214,"「まだ全体像が見えてませんが、面白いものが描かれてる\n　予感がしますね\\I[29]」\\nw[\\N[2]]":215,"「まだ全体像が見えてませんが、なにやら不穏なものが\n　描かれているような……」\\nw[\\N[2]]":216,"「なにが描かれているかは秘密だよ。\n　けど完成のあかつきには、話題沸騰まちがいなしさ！\\nw[外道アーティスト]":217,"「ところで頼んでいた奴隷の方はどうなったかな？」\\nw[外道アーティスト]":218,"「ちゃんと用意してきたぜ。\n　ほらよ」\\nw[\\N[1]]":219,"依頼者に肉体労働用の奴隷２人を渡した！\n報酬として\\C[17]１２０００Ｇ\\C[0]を入手した！":220,"FocusCamera 72 72 90":221,"ResetFocus 90":222,"「ありがとう！\n　そしてまた追加の注文があるんだが、いいかい？」\\nw[外道アーティスト]":223,"「また奴隷ですか？」\\nw[\\N[2]]":224,"「いいや。\n　今回欲しいのは\\C[17]卵８０個\\C[0]と\\C[17]サボテン２０個\\C[0]だ」\\nw[外道アーティスト]":225,"「卵とサボテンだと？\n　なんでそんなものを？」\\nw[\\N[1]]":226,"「この地上絵を描くための特殊な染料を作るのに\n　必要なんだ。\\nw[外道アーティスト]":227,"「報酬はその猫人の娘に似合いそうな\\C[17]『ビキニ鎧』\\C[0]で\n　どうだろう？　頼んだよ！」\\nw[外道アーティスト]":228,"個別依頼\\C[17]『地上絵の野望』\\C[0]の追加発注を受けた！":229,"依頼品：卵80個・サボテン20個":230,"配送先：大聖堂西方の草原地帯":231,"ビキニ鎧":232,"地上絵の野望（第三段階）":233,"卵とサボテンを所持しているかチェック":234,"卵が規定数以上あるとき":235,"\\C[17]卵８０個\\C[0]を依頼者に渡しますか？":236,"渡す":237,"渡さない":238,"卵８０個を依頼者に渡した。":239,"サボテンが規定数以上あるとき":240,"\\C[17]サボテン２０個\\C[0]を依頼者に渡しますか？":241,"サボテン２０個を依頼者に渡した。":242,"卵・サボテンともＯＫ":243,"卵渡し済みで、サボテン無し":244,"「卵はもらったから、あと必要なのは\\C[17]サボテン２０個\\C[0]だね」\\nw[外道アーティスト]":245,"依頼品：サボテン20個（卵は届け済み）":246,"卵無しで、サボテン渡し済み":247,"「サボテンはもらったから、あと必要なのは\\C[17]卵８０個\\C[0]だね」\\nw[外道アーティスト]":248,"依頼品：卵80個（サボテンは届け済み）":249,"卵もサボテンも無し":250,"「いま欲しいのは\\C[17]卵８０個\\C[0]と\\C[17]サボテン２０個\\C[0]だ。\n　必要な素材なんで、よろしく頼んだよ」\\nw[外道アーティスト]":251,"依頼条件達成":252,"「これで依頼の品は全部そろったはずだ」\\nw[\\N[1]]":253,"「ＯＫ！　ＯＫ！\n　おかげさまで地上絵の進捗は予定の通りだよ！」\\nw[外道アーティスト]":254,"卵８０個とサボテン２０個を全て渡した！\n報酬として\\C[17]『\\an[\\v[191]]』\\C[0]を入手した！":255,"「素晴らしい絵になりそうですけど……こんな大聖堂から\n　近い場所に描いちゃって大丈夫ですか？」\\nw[\\N[2]]":256,"「仮にも大聖堂から近いこんな場所に、こんな絵を……。\n　ぜったいに後で怒られると思うんですけど」\\nw[\\N[2]]":257,"「ふんっ！　芸術に理解のない輩はどこにでもいるけど、\n　だからといって私の筆を止めることなどできないよ！」\\nw[外道アーティスト]":258,"「ところで完成も見えてきたようだが、もう必要なものは\n　ないのか？」\\nw[\\N[1]]":259,"「いや、あとひとつだけ。\n　氷雪の里コールディで産出するという\\C[17]『溶けない氷塊』を\n　１個\\C[0]、持ってきてほしい」\\nw[外道アーティスト]":260,"「氷塊？\n　地上絵とは全然関係なさそうですけど？」\\nw[\\N[2]]":261,"「溶けない氷塊をここに設置すれば、辺りの気温が下がって\n　この一帯に雑草が生えなくなる。\\nw[外道アーティスト]":262,"「雑草が伸びると地上絵が見えなくなってしまうから、\n　その対策というわけさ」\\nw[外道アーティスト]":263,"「なるほどな。で、今度の報酬は？」\\nw[\\N[1]]":264,"「\\C[17]３５０００Ｇ\\C[0]と\\C[17]『\\in[23]』２個\\C[0]でお願い\n　できるかな？」\\nw[外道アーティスト]":265,"依頼品：溶けない氷塊１個":266,"３５０００Ｇ、賢者の薬２個":267,"地上絵の野望（第五段階）":268,"溶けない氷塊を所持しているかチェック":269,"「\\C[17]『溶けない氷塊』\\C[0]は、氷雪の里コールディで産出する\n　っていう魔法の氷なんだ。\n　重いだろうけど、調達よろしくね」\\nw[外道アーティスト]":270,"\\C[17]溶けない氷塊１個\\C[0]を依頼者に渡しますか？":271,"「ご注文の『溶けない氷塊』を持って来たぞ。\n　重いし寒いし、道中大変だった」\\nw[\\N[1]]":272,"「サンキュー！\n　こっちもとうとう、地上絵が完成するところだよ！\\nw[外道アーティスト]":273,"「一緒にこの歴史的瞬間を祝ってくれたまえ！」\\nw[外道アーティスト]":274,"依頼者に溶けない氷１個を渡した！":275,"「わたしたちの協力で、このステキな絵が完成するん\n　ですね\\I[29]」\\nw[\\N[2]]":276,"「わたしたちが協力しちゃったせいで、この卑猥な絵が\n　完成しちゃうんですね……」\\nw[\\N[2]]":277,"「協力者ってことで、どこかに名前でも刻んでもらうか？」\\nw[\\N[1]]":278,"「いいですね\\I[29]　あとで頼んでみましょうか？」\\nw[\\N[2]]":279,"「絶対にイヤです！」\\nw[\\N[2]]":280,"「これでよし！\n　さあ、出来上がった！\\nw[外道アーティスト]":281,"「生涯最高の傑作、大地上絵\\C[27]『ダブルピースの少女』\\C[0]の\n　完成だッ！！」\\nw[外道アーティスト]":282,"↓隊列歩行OFF":283,"地上絵を見せる\n↓　　↓　　↓":284,"↑　　↑　　↑\n地上絵を見せる":285,"「改めて見ると、ひどいなこれは」\\nw[\\N[1]]":286,"「そうですか？　これこそ芸術だとおもいますけど\\I[29]」\\nw[\\N[2]]":287,"「何をいまさら……」\\nw[\\N[2]]":288,"「美しい……ビューティホー！！\n　きっとこの地上絵は数千年、数万年後の未来にまで\n　残るだろう！」\\nw[外道アーティスト]":289,"「同感です\\I[29]」\\nw[\\N[2]]":290,"「後世に残る人類の恥ですね」\\nw[\\N[2]]":291,"「ちなみにこいつは、どういう瞬間を描いたもの\n　なんだ？\\nw[\\N[1]]":292,"「痴女がダブルピースしてるようにしか見えないんだが」\\nw[\\N[1]]":293,"「痴女だなんて、ひどい勘違いだ！\\nw[外道アーティスト]":294,"「この絵は芸術家仲間と一緒に実施した\\C[17]射精会\\C[0]を\n　モチーフに描いたんだよ！」\\nw[外道アーティスト]":295,"「\\C[17]写生\\C[0]会？」\\nw[\\N[2]]":296,"「\\C[17]射精\\C[0]会！」\\nw[外道アーティスト]":297,"地上絵Ｈイベント\n↓　　↓　　↓":298,"↑　　↑　　↑\n地上絵Ｈイベント":299,"「まあ素人には分からなくて当然かも。\n　芸術とは自己の発露であって、必ずしも他人の理解を\n　得られるとは――」\\nw[外道アーティスト]":300,"\\{「おい！　これを描いたのはお前らか！？」\\}\\nw[？？？]":301,"「大聖堂から目と鼻の先で、なんという破廉恥な！\n　すぐにこの\\C[17]痴女絵\\C[0]を消すのだ！」\\nw[司祭]":302,"「なにぃ！？　黙れっ、この腐れ坊主！\n　私のアートにケチをつけるつもりか！？\n　これは痴女絵ではなく地上絵だ！！」\\nw[外道アーティスト]":303,"「なんたる傲慢な態度！\n　どうやら言うことを聞く気はないようだな。\\nw[司祭]":304,"「ならば実力行使あるのみ！　やれ！」\\nw[司祭]":305,"「はっ！　了解いたしました！」\\nw[神殿兵]":306,"「なっ、なにをする！？\n　消せ！　いますぐ火を消せぇッ！！」\\nw[外道アーティスト]":307,"「はははっ！\n　このような汚物、すべて焼き払って消毒してくれる！」\\nw[司祭]":308,"「あー、こりゃダメだな。\n　あいつらしっかり風上から、油まで撒いて火をつけ\n　やがった」\\nw[\\N[1]]":309,"「先生の偉大な絵になんて酷いことを！」\\nw[\\N[2]]":310,"「火をかけたくなる気持ちは分かりますけど、\n　いきなりこれはヒドいですよ！」\\nw[\\N[2]]":311,"「ぬおおおぉぉっ！\n　私の最高傑作がああぁっ！！」\\nw[外道アーティスト]":312,"「おお、焼けた焼けた！\n　これに懲りたら、聖堂のそばに不浄の絵など描かぬよう\n　気をつけることだ」\\nw[司祭]":313,"「なんてことだ……！\n　芸術を理解せぬ凡俗め……よくも……！\\nw[外道アーティスト]":314,"「だが、私は負けない！\n　これしきの事でくじけてなるものかぁッ！！\\nw[外道アーティスト]":315,"「芸術は死なないのだッ！！\n　四聖教のクソ坊主め！　いつか目にモノ見せてやる！！\\nw[外道アーティスト]":316,"「覚えていろおおぉッ！！」\\nw[外道アーティスト]":317,"数年後、王国各地で聖堂へ卑猥なペインティングが施される\n『芸術の自由運動』が巻き起こるが、それはまた別の話で\nある――。":318,"「ぬおおおおぉぉッ！！」\\nw[外道アーティスト]":319,"「芸術って、大変ですねぇ……」\\nw[\\N[2]]":320,"「いや、絵を描く場所をもうちょっと慎重に選んでりゃ、\n　済んだ話だと思うんだが……」\\nw[\\N[1]]":321,"個別依頼\\C[17]『地上絵の野望』\\C[0]を完全達成した！":322,"↓隊列歩行ON":323,"達成報酬として\\C[17]３５０００Ｇ\\C[0]と\\C[17]『\\in[23]』２個\\C[0]を\n入手した！":324,"\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！\n\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！":325,"依頼マーク":326,"ユマ（地上絵）":32