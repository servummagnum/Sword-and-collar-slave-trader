erIndex":756,"headerParam":["",0,0,2]}],[{"headerIndex":760,"headerParam":["",0,0,2]}],[{"headerIndex":774,"headerParam":["",0,0,2]}],[{"headerIndex":778,"headerParam":["",0,0,2]}],[{"headerIndex":781,"headerParam":["",0,0,2]}],[{"headerIndex":784,"headerParam":["",0,0,2]}],[{"headerIndex":790,"headerParam":["",0,0,2]}],[{"headerIndex":800,"headerParam":["",0,0,2]}],[{"headerIndex":802,"headerParam":["",0,0,2]}],[{"headerIndex":822,"headerParam":["以下、三ヶ所ともクリアした場合のイベント"]}],[{"headerIndex":833,"headerParam":["",0,0,2]}],[{"headerIndex":839,"headerParam":["",0,0,2]}],[{"headerIndex":843,"headerParam":["",0,0,2]}],[{"headerIndex":847,"headerParam":["",0,0,2]}],[{"headerIndex":853,"headerParam":["",0,0,2]}],[{"headerIndex":856,"headerParam":["",0,0,2]}],[{"headerIndex":860,"headerParam":["",0,0,2]}],[{"headerIndex":871,"headerParam":["",0,0,2]}],[{"headerIndex":875,"headerParam":["",0,0,1]}]],"indexIds":{"脱出用魔法陣":0,"ダンジョンの外へ脱出しますか？":1,"脱出する":2,"脱出しない":3,"createFilter 1 twist 2":4,"setFilter 1 408 312 416 0":5,"moveFilter 1 408 312 816 13 120":6,"eraseFilter 1":7,"EV002":8,"敵索敵スタート":9,"PSS start":10,"最奥部":11,"EXIT":12,"EV005":13,"EV006":14,"EV007":15,"EV008":16,"EV009":17,"敵01":18,"<PsensorS:\\V[1166] Rv\\S[22]>":19,"探索範囲にプレイヤー侵入":20,"SmartPath 0 -1":21,"SmartPath 0 cancel":22,"敵に見つかっている場合の戦闘":23,"勝利したとき":24,"PSS t_stop":25,"逃げたとき":26,"戦闘から離脱したときの処理":27,"PSS t_start":28,"敵がプレイヤーを見失ったときの処理":29,"敵02":30,"敵03":31,"敵04":32,"敵05":33,"宝箱（消耗品正面開き）":34,"<TE:13>":35,"EV016":36,"壁ひび":37,"※\nアイテム：耐衝撃剤\n※":38,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":39,"↓アイテムのIDNo.を変数に入力する":40,"↓アイテムの入手個数を変数に入力する":41,"↓アイテムの重量を変数に入力する":42,"対バルコルド戦":43,"「あれは……！」\\nw[\\N[1]]":44,"「どうしたんですか、\\N[1]さん？\\nw[\\N[2]]":45,"「……あっ！？」\\nw[\\N[2]]":46,"「モンスターには苦労させられたけど、やっと最深部に\n　たどり着いたわね」\\nw[\\N[3]]":47,"「はい、お嬢様」\\nw[\\N[4]]":48,"すでに他の鉤爪ダンジョンイベントを終えているとき\n↓　　↓　　↓":49,"「この前は\\N[2]とあのフード男にしてやられたけど、\n　今度こそ『竜の鉤爪』を持って帰るわよ！\\nw[\\N[3]]":50,"「でないと、あの方に見捨てられてしまうかも……」\\nw[\\N[3]]":51,"「お嬢様、ご安心ください。\n　今回は必ずや、あの邪魔者どもが来ても阻止します。\\nw[\\N[4]]":52,"「そういうわけだ！\n　出てこい！　アサシン！」\\nw[\\N[4]]":53,"「えっ！？」\\nw[\\N[3]]":54,"まだ他の鉤爪ダンジョンイベントをひとつもやっていないとき\n↓　　↓　　↓":55,"「それにしても、こんな場所にあるなんてね。\\nw[\\N[3]]":56,"「あの方の紹介で大聖堂の書庫を利用できたから、\n　どうにか手がかりをつかめたけど――。\\nw[\\N[3]]":57,"「普通分かんないわよ、『竜の鉤爪』の隠し場所\n　なんて！」\\nw[\\N[3]]":58,"「お嬢様、いますぐ鉤爪の確保に向かってください」\\nw[\\N[4]]":59,"「え、なに？　どうしたのよ急に？」\\nw[\\N[3]]":60,"「そこにいるのは分かっているぞ！　出てこい！\n　出て来なければこちらから行くぞ！」\\nw[\\N[4]]":61,"「チッ……！　気づいてやがったか！」\\nw[\\N[1]]":62,"「ど、どうしましょう！？」\\nw[\\N[2]]":63,"「戦うしかないだろ。\n　あっちはやる気満々みたいだしな」\\nw[\\N[1]]":64,"「\\N[2]とフード男！？\\nw[\\N[3]]":65,"「このっ……また邪魔しに来たの！？」\\nw[\\N[3]]":66,"「な、何度だって邪魔するよ！\n　わたしは\\N[3]に勝って、必ず奴隷身分から解放\n　されるもん！」\\nw[\\N[2]]":67,"「あたしに勝つぅー！？\n　あんたがぁ！？\\nw[\\N[3]]":68,"「どこまでツケ上がるつもりよ、この奴隷猫！\n　あたしの出世を妨害するとか、何様のつもり！？」\\nw[\\N[3]]":69,"「ツケ上がってるのはお前だろう、メスガキ！\n　胸のサイズ以外、\\N[2]に勝てる要素が皆無のくせに」\\nw[\\N[1]]":70,"「なっ……！？\n　このアサシン崩れのフード野郎ッ！！」\\nw[\\N[3]]":71,"「挑発に乗らないでください、お嬢様。\\nw[\\N[4]]":72,"「それよりも今は、鉤爪を先に。\n　こいつらの相手は私がやりますので」\\nw[\\N[4]]":73,"「ハッ……そうだった！\\nw[\\N[3]]":74,"「鉤爪を取ってくるから、あなたはそいつらをボコボコに\n　しちゃいなさい！」\\nw[\\N[3]]":75,"「仰せのままに」\\nw[\\N[4]]":76,"「あっ、\\N[3]が……！」\\nw[\\N[2]]":77,"「ここから先は通さん！\n　竜の鉤爪は今度こそお嬢様のものだ！」\\nw[\\N[4]]":78,"「上等だ！　いくぞ\\N[2]！」\\nw[\\N[1]]":79,"「はいっ！」\\nw[\\N[2]]":80,"「な……なんであんたたちが、ここにいるのよ！？」\\nw[\\N[3]]":81,"「気にすんな。\n　ちょっと近くを通りがかっただけだから」\\nw[\\N[1]]":82,"「ふざけんなっ！」\\nw[\\N[3]]":83,"「おそらくこいつらは、私たちに意趣返しするつもりで、\n　鉤爪捜索の邪魔をしに来たのでしょう」\\nw[\\N[4]]":84,"「なんて性根の腐ったヤツラなのかしら！」\\nw[\\N[3]]":85,"「お前が言うか……」\\nw[\\N[1]]":86,"「\\N[3]、あなたたちが海賊とグルになって、ウチの\n　商会を破産に追い込んだことは分かってる！\\nw[\\N[2]]":87,"「わたし、絶対に泣き寝入りなんてしないから！」\\nw[\\N[2]]":88,"「あーあー、泣き虫\\N[2]がイキがっちゃって！\n　あんたがどうあがいた所で、もう勝敗はついてるって\n　いうのに」\\nw[\\N[3]]":89,"「そいつは早計だぜ？\n　俺たちは勝負をひっくり返すために来たんだからな」\\nw[\\N[1]]":90,"「お嬢様、こいつらの相手は私がしますので、先に\n　鉤爪の確保をお願いします」\\nw[\\N[4]]":91,"「わかったわ。\n　遠慮せずギッタンギッタンにしてやりなさい！」\\nw[\\N[3]]":92,"「ここから先は通さん！\n　竜の鉤爪はお嬢様のものだ！」\\nw[\\N[4]]":93,"戦闘勝利↓":94,"「どうした、大口叩いてた割にこれで終わりか？」\\nw[\\N[1]]":95,"「なるほど、予想していたより戦闘慣れしているようだ。\n　なかなかに手ごわい。\\nw[\\N[4]]":96,"「――だが時間稼ぎにはこれで十分」\\nw[\\N[4]]":97,"「な、なに！？」\\nw[\\N[1]]":98,"「\\N[1]さん！\n　\\N[3]が竜の鉤爪を――」\\nw[\\N[2]]":99,"FocusCamera 32 20 60":100,"「竜の鉤爪、いただいたわ！！」\\nw[\\N[3]]":101,"「しまった！　メスガキから鉤爪を取り上げないと！」\\nw[\\N[1]]":102,"「もう遅いわよッ、バーカッ！！」\\nw[\\N[3]]":103,"「今は退いてやろう。\\nw[\\N[4]]":104,"「だが近いうちにキサマとは決着をつけてやる。\n　首を洗って待っていろ、アサシン！」\\nw[\\N[4]]":105,"ResetFocus 60":106,"「くそっ、やられた！」\\nw[\\N[1]]":107,"「お、追いかけないと！」\\nw[\\N[2]]":108,"「いや、もう無理だろう。\\nw[\\N[1]]":109,"「メスガキ一匹ならともかく、あの\\N[4]って男が\n　いるんじゃ追跡は難しい」\\nw[\\N[1]]":110,"「そんな……」\\nw[\\N[2]]":111,"鉤爪をまったく持っていないとき":112,"「三つとも手に入れてやるつもりだったが、幸先の悪い\n　出だしになっちまったな。\\nw[\\N[1]]":113,"「でもまあ、ここ以外の鉤爪はまだ、見つからずに\n　残っているかもしれん。\\nw[\\N[1]]":114,"「気を取り直して、他の二つを探しにいくぞ！」\\nw[\\N[1]]":115,"「そ、そうですね！\n　じゃあ、もうここに用はありませんから、私たちも\n　外に出ましょう！」\\nw[\\N[2]]":116,"鉤爪を一つ持っているとき":117,"「二つ目も手に入れてやるつもりだったが、しくじったな。\\nw[\\N[1]]":118,"「でもまあ、鉤爪の一つはすでに確保してあるんだ。\n　気を取り直して、残り一つも取りにいくぞ！」\\nw[\\N[1]]":119,"他二つの鉤爪を持っているとき":120,"「最後の鉤爪回収で、ケチがついちまったな。\\nw[\\N[1]]":121,"「でもまあ、３個中２個は俺たちで確保してるんだ。\n　こちらが有利には違いない。\\nw[\\N[1]]":122,"「あとはこの手元の鉤爪を守り抜けばいい」\\nw[\\N[1]]":123,"「そ、そうですよね！\n　じゃあ、もうここに用はありませんから、私たちも\n　外に出ましょう！」\\nw[\\N[2]]":124,"「……ん？\n　ちょっと待て、なにか――」\\nw[\\N[1]]":125,"「どうしたんですか？」\\nw[\\N[2]]":126,"「箱の中にまだなにか残ってるぞ」\\nw[\\N[1]]":127,"「えっ！？」\\nw[\\N[2]]":128,"「メスガキのヤツ、鉤爪を持っていくことしか頭になくて\n　目に入らなかったんだろうな。\\nw[\\N[1]]":129,"「これは……\\C[17]粘土板\\C[0]か？\n　なにか文字みたいなのが刻まれてるな」\\nw[\\N[1]]":130,"「読めそうですか？」\\nw[\\N[2]]":131,"「いや、全然知らない文字だ。古代文字か？\\nw[\\N[1]]":132,"「ともあれ、鉤爪と一緒に置いてあったということは、\n　なにか関係のある代物なんだろう。\\nw[\\N[1]]":133,"「竜の鉤爪は逃したが、どうやら無駄足には\n　ならなかったな」\\nw[\\N[1]]":134,"\\C[17]『古代の粘土板』\\C[0]を入手した！":135,"メインシナリオ\\C[17]『砂漠に埋もれし』\\C[0]を一応（？）達成した！":136,"\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！":137,"以下、三ヶ所ともクリアした場合のイベント\n↓　　↓　　↓":138,"「結局、竜の鉤爪は３個中の２個を手に入れましたけど、\n　これからどうします……？」\\nw[\\N[2]]":139,"「どうにかして、この粘土板に書かれている内容を\n　解読したいな。\\nw[\\N[1]]":140,"「内容によっちゃ、メスガキどもを更に追い詰めて\n　やれるかもしれないぞ。\\nw[\\N[1]]":141,"「あと、メスガキどもがこれからどう動くかも気になるな」\\nw[\\N[1]]":142,"「じゃあ一度、王都の貧民街にいる父のところへ\n　行きませんか？\\nw[\\N[2]]":143,"「なにか新しい情報が入っているかもしれませんし」\\nw[\\N[2]]":144,"「そうだな、王都へ向かうか」\\nw[\\N[1]]":145,"メインシナリオ\\C[17]『粘土板解読』\\C[0]を受けた！":146,"\\>　　　※　\\C[17]王都貧民街の酒場\\C[0]にいる、\\N[2]の父親の　※\n\\>　　　※　ところへ行こう。　　　　　　　　　　　※\\<":147,"エルラ":148,"バルコルド":149,"竜の鉤爪宝箱":150,"ユマ":151,"EV023":152,"EV024":153,"モンスター進入禁止":154,"回復魔法陣":155,"床トラップ":156,"床針トラップ制御":157,"床針検知":158,"トラップ無敵時間":159,"EV057":160,"橋渡し1":161},"extension":"json","dataType":"map","filename":"Map302","basename":"Map302.json","path":"data/Map302.json","relPath":"data/Map302.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":162,"percent":0},"cellInfo":[]},"data/Map303.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["C_DISABLE_WEATHER",""],["weather : 0 : 9 : 20 : 70 : 0 : Snow_01",""],["enable_footsteps",""],["EV004",""],["モンスター進入禁止",""],["敵索敵スタート",""],["PSS start",""],["最奥部２階",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["宝箱（防具正面開き）",""],["<TE:4>",""],["敵01",""],["<PsensorS:\\V[1166] Rv\\S[22]>",""],["探索範囲にプレイヤー侵入",""],["SmartPath 0 -1",""],["SmartPath 0 cancel",""],["敵に見つかっている場合の戦闘",""],["勝利したとき",""],["PSS t_stop",""],["逃げたとき",""],["戦闘から離脱したときの処理",""],["PSS t_start",""],["敵がプレイヤーを見失ったときの処理",""],["敵02",""],["敵03",""],["敵04",""],["氷柱1",""],["押せば氷柱を倒せそうだ。",""],["押す",""],["押さない",""],["バルコルド",""],["遭遇Ev",""],["PSS stop",""],["「そこよっ、\\N[4]！\n　いけっ！　やれっ！　ブッ倒せぇッ！！」\\nw[\\N[3]]",""],["「ハァッ！　ヤァッ！　トウッ！！」\\nw[\\N[4]]",""],["「竜の鉤爪はすぐそこよ！\n　がんばれーッ！！」\\nw[\\N[3]]",""],["「メスガキと執事！\n　やっぱり来てやがったか！」\\nw[\\N[1]]",""],["「な、なんかスゴく強そうなモンスターと戦ってますけど、\n　あれ大丈夫なんでしょうか？」\\nw[\\N[2]]",""],["「あいつらのことは放っておけばいい。\n　それよりこの隙に、俺たちは別の道から先回りするぞ」\\nw[\\N[1]]",""],["「わ、わかりました！\n　\\N[3]たちより早く、鉤爪を手に入れましょう！」\\nw[\\N[2]]",""],["\\N[3]たちに気づかれないよう進まなければ。",""],["モンスター",""],["エルラ",""],["EV022",""],["氷柱2",""],["EV024",""],["EV025",""],["倒れ氷柱1",""],["倒れ氷柱2",""],["攻撃エフェクト1",""],["攻撃エフェクト2",""],["モンスター進入禁止1",""],["モンスター進入禁止2",""],["氷柱矢印表示",""],["矢印",""]],"context":[["Map303/events/1/name"],["Map303/events/2/name