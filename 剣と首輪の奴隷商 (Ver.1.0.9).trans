map","filename":"Map348","basename":"Map348.json","path":"data/Map348.json","relPath":"data/Map348.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":39,"percent":0},"cellInfo":[]},"data/Map349.json":{"data":[["ボート",""],["武器屋入り口",""],["船マーク",""],["桟橋（ボート搭乗）",""],["ボートに乗りますか？",""],["乗る",""],["乗らない",""],["ニワトリ",""]],"context":[["Map349/events/1/name"],["Map349/events/2/name"],["Map349/events/3/name"],["Map349/events/4/name"],["Map349/events/4/pages/0/list/0/message/noPicture/bottom"],["Map349/events/4/pages/0/list/2/Show Choices/2/1from2"],["Map349/events/4/pages/0/list/2/Show Choices/2/2from2"],["Map349/events/5/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],null,null,null,["gold"]],"parameters":[null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"ボート":0,"武器屋入り口":1,"船マーク":2,"桟橋（ボート搭乗）":3,"ボートに乗りますか？":4,"乗る":5,"乗らない":6,"ニワトリ":7},"extension":"json","dataType":"map","filename":"Map349","basename":"Map349.json","path":"data/Map349.json","relPath":"data/Map349.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":8,"percent":0},"cellInfo":[]},"data/Map350.json":{"data":[["個別依頼11",""],["鍛冶師の孤独",""],["「一人暮らしも飽きたんで、ペットを飼いたいんだ。\n　おっぱいの大きいハーピーがいいな。\\nw[伝説の鍛冶師]",""],["「用意してくれるなら、特別に\\C[17]ミスリル武具の製作\\C[0]を\n　請け負ってやってもいいぞ？」\\nw[伝説の鍛冶師]",""],["「ここは見たところ鍛冶屋のようだが、なんでこんな\n　辺鄙な場所に？」\\nw[\\N[1]]",""],["「オレは世俗を離れて鍛冶に打ち込むため、人の来ない\n　ここへ移り住んだんだ。\\nw[伝説の鍛冶師]",""],["「言っておくが、ミスリルの武具を作れって話なら\n　断るぞ」\\nw[伝説の鍛冶師]",""],["「ミスリルの武具……？\\nw[\\N[2]]",""],["「もしかしてあなたは、伝説と謳われた\\C[17]ミスリル鍛冶師\\C[0]\n　では？」\\nw[\\N[2]]",""],["「そう呼ぶヤツもいるが、大げさな物言いだ。\n　まあ多少腕に自信はあるが」\\nw[伝説の鍛冶師]",""],["「俺もあんたの噂は耳にしていたよ。\n　しかし、こんな場所に隠れ住んでいたとは。\\nw[\\N[1]]",""],["「ミスリルの武具は作らないと言ったな？\n　どうしてだ？」\\nw[\\N[1]]",""],["「客のワガママに振り回されるのがイヤになっただけだ。\n　オレはオレの作りたいものだけを作る」\\nw[伝説の鍛冶師]",""],["「それは残念ですね。\n　まあわたしたちは奴隷商人なので、売買目的で武具の\n　作成を頼むことはありませんけど」\\nw[\\N[2]]",""],["「個人的には欲しいがな」\\nw[\\N[1]]",""],["「あんたら、奴隷商人なのか？\n　それなら条件次第でミスリル武具の製作を請け負って\n　やってもいいが？」\\nw[伝説の鍛冶師]",""],["「ほう？　その条件ってのは？」\\nw[\\N[1]]",""],["「ちょうど長い一人暮らしにも飽きてきたところでな。\n　ペットの一匹も飼おうかと考えていたんだ。\\nw[伝説の鍛冶師]",""],["「どうだい、オレ好みのペットを連れてきちゃ\n　くれないか？」\\nw[伝説の鍛冶師]",""],["「え？\n　あのぅ、わたしたちは奴隷商人であって、ペット業者\n　ではないんですけど？」\\nw[\\N[2]]",""],["「なに？\n　奴隷商じゃ\\C[17]ハーピー\\C[0]は扱ってないのか？」\\nw[伝説の鍛冶師]",""],["「欲しいペットってのはハーピーかよ！」\\nw[\\N[1]]",""],["「そうだ。\n　できれば\\C[17]おっぱいが大きいヤツ\\C[0]がいいな！」\\nw[伝説の鍛冶師]",""],["「ペットを飼うとか言って、いやらしいことする気\n　満々じゃないですか\\I[29]」\\nw[\\N[2]]",""],["「ペットを飼うとか言って、いやらしいことする気\n　満々ですね……」\\nw[\\N[2]]",""],["個別依頼『鍛冶師の孤独』を受けますか？",""],["受ける",""],["受けない",""],["地下遺跡・4層",""],["ハーピーの営巣地",""],["個別依頼\\C[17]『鍛冶師の孤独』\\C[0]を受けた！",""],["\\C[17]『\\in[139]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「あんたの好み通り、巨乳のハーピーを連れてきたぞ」\\nw[\\N[1]]",""],["「こいつは可愛いペットだ！\n　一人暮らしの無聊をなぐさめるにはもってこいだな！」\\nw[伝説の鍛冶師]",""],["「なぐさめるのは無聊じゃなくて下半身なんでしょ\\I[29]」\\nw[\\N[2]]",""],["「なぐさめるのは無聊じゃなくて下半身のくせに……」\\nw[\\N[2]]",""],["個別依頼\\C[17]『鍛冶師の孤独』\\C[0]を達成した！",""],["「では、あんたらからは特別にミスリル武具の発注を\n　請け負ってやろう。\\nw[伝説の鍛冶師]",""],["「材料となるミスリルインゴットを用意してくれれば、\n　そこにある料金表の値段でミスリル武具を作ってやるよ」\\nw[伝説の鍛冶師]",""],["\n\\>　※　　\\C[17]ミスリル武具\\C[0]の製作依頼が可能になった！　　※",""],["依頼条件未達成",""],["「ペット用のハーピーを頼んだぞ。\n　用意してくれたらミスリル武器の発注を受けてやるから」\\nw[伝説の鍛冶師]",""],["「ミスリル武具の発注をしたければ、そこにある\\C[17]値段表\\C[0]を\n　見てくれ。\n　必要なミスリルインゴットの数と値段が書いてあるから」\\nw[伝説の鍛冶師]",""],["伝説の鍛冶師に\\C[17]『\\v[3]』\\C[0]を作ってもらった！",""],["実績 32",""],["依頼マーク",""],["小屋出入口（ハーピーHEv）",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["\n\\N[1]たちが小屋を立ち去った、その後――。",""],["「では、可愛いペットとの触れ合いを楽しむと\n　するか」\\nw[伝説の鍛冶師]",""],["「フク、イラナイノ？　ナニスルノー？」\\nw[ハーピー]",""],["「気持ちいいことだよ。\n　飼い主とペットのスキンシップさ」\\nw[伝説の鍛冶師]",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["「ピィッ\\I[29]　オマンコ、シロイノ、イッパイ\\I[29]\n　ベタベタ～\\I[29]」\\nw[ハーピー]",""],["「よしよし。これから毎日、パパがそこをベタベタに\n　してやるからな」\\nw[伝説の鍛冶師]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！\n\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["ハーピー",""],["「ピュイィ！\n　オナカヘッタ！　ゴハン！　ゴハン！」\\nw[奴隷ハーピー]",""],["「ピュイッ！　ピュイッ！　パパ、オチンチン\\I[29]\n　オマタ、クチュクチュ、スキィ\\I[29]」\\nw[奴隷ハーピー]",""],["料金表",""],["料金表マーク",""]],"context":[["Map350/events/1/name"],["Map350/events/1/pages/0/list/0/comment"],["Map350/events/1/pages/0/list/5/message/noPicture/bottom"],["Map350/events/1/pages/0/list/8/message/noPicture/bottom"],["Map350/events/1/pages/0/list/28/message/noPicture/bottom"],["Map350/events/1/pages/0/list/33/message/noPicture/bottom"],["Map350/events/1/pages/0/list/36/message/noPicture/bottom"],["Map350/events/1/pages/0/list/42/message/noPicture/bottom"],["Map350/events/1/pages/0/list/44/message/noPicture/bottom"],["Map350/events/1/pages/0/list/49/message/noPicture/bottom"],["Map350/events/1/pages/0/list/53/message/noPicture/bottom"],["Map350/events/1/pages/0/list/57/message/noPicture/bottom"],["Map350/events/1/pages/0/list/61/message/noPicture/bottom"],["Map350/events/1/pages/0/list/67/message/noPicture/bottom"],["Map350/events/1/pages/0/list/73/message/noPicture/bottom"],["Map350/events/1/pages/0/list/77/message/noPicture/bottom"],["Map350/events/1/pages/0/list/82/message/noPicture/bottom"],["Map350/events/1/pages/0/list/85/message/noPicture/bottom"],["Map350/events/1/pages/0/list/88/message/noPicture/bottom"],["Map350/events/1/pages/0/list/94/message/noPicture/bottom"],["Map350/events/1/pages/0/list/100/message/noPicture/bottom"],["Map350/events/1/pages/0/list/104/message/noPicture/bottom"],["Map350/events/1/pages/0/list/108/message/noPicture/bottom"],["Map350/events/1/pages/0/list/115/message/noPicture/bottom"],["Map350/events/1/pages/0/list/123/message/noPicture/bottom"],["Map350/events/1/pages/0/list/131/message/noPicture/bottom"],["Map350/events/1/pages/0/list/133/Show Choices/133/1from2"],["Map350/events/1/pages/0/list/133/Show Choices/133/2from2"],["Map350/events/1/pages/0/list/144/Control Variables/var:1951-1951/tok/0/type/StringLiteral/pos/0"],["Map350/events/1/pages/0/list/147/Control Variables/v