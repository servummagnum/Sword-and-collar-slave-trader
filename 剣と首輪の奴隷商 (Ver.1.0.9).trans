erParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":60,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":71,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["",0,0,2]}],[{"headerIndex":107,"headerParam":["",0,0,2]}],[{"headerIndex":118,"headerParam":["",0,0,2]}],[{"headerIndex":143,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["",0,0,2]}],[{"headerIndex":163,"headerParam":["",0,0,2]}],[{"headerIndex":170,"headerParam":["",0,0,2]}],[{"headerIndex":173,"headerParam":["",0,0,2]}],[{"headerIndex":177,"headerParam":["",0,0,2]}],[{"headerIndex":213,"headerParam":["",0,0,2]}],[{"headerIndex":217,"headerParam":["",0,0,2]}],[{"headerIndex":222,"headerParam":["",0,0,2]}],[{"headerIndex":228,"headerParam":["",0,0,2]}],[{"headerIndex":232,"headerParam":["",0,0,2]}],[{"headerIndex":236,"headerParam":["",0,0,2]}],[{"headerIndex":240,"headerParam":["",0,0,2]}],[{"headerIndex":244,"headerParam":["",0,0,2]}],[{"headerIndex":248,"headerParam":["",0,0,2]}],[{"headerIndex":263,"headerParam":["",0,0,2]}],[{"headerIndex":266,"headerParam":["",0,0,2]}],[{"headerIndex":283,"headerParam":["",0,0,2]}],[{"headerIndex":289,"headerParam":["",0,0,2]}],[{"headerIndex":300,"headerParam":["",0,0,2]}],[{"headerIndex":302,"headerParam":["",0,0,2]}],[{"headerIndex":315,"headerParam":["",0,0,2]}],[{"headerIndex":318,"headerParam":["",0,0,2]}],[{"headerIndex":359,"headerParam":["",0,0,2]}],[{"headerIndex":363,"headerParam":["",0,0,2]}],[{"headerIndex":370,"headerParam":["",0,0,2]}],[{"headerIndex":385,"headerParam":["",0,0,2]}],[{"headerIndex":408,"headerParam":["",0,0,2]}],[{"headerIndex":412,"headerParam":["",0,0,2]}],[{"headerIndex":416,"headerParam":["",0,0,2]}],[{"headerIndex":421,"headerParam":["",0,0,2]}],[{"headerIndex":424,"headerParam":["",0,0,2]}],[{"headerIndex":430,"headerParam":["",0,0,2]}],[{"headerIndex":434,"headerParam":["",0,0,2]}],[{"headerIndex":467,"headerParam":["",0,0,2]}],[{"headerIndex":485,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":487,"headerParam":["",0,0,1]}]],"indexIds":{"本棚（可動）":0,"「よし、潜入成功だ」\\nw[\\N[1]]":1,"「成功しちゃいましたね……。\\nw[\\N[2]]":2,"「でも、どうしてわざわざ宮殿に？\n　建物の中にあの巨大なアルテトがいるとも思えませんけど」\\nw[\\N[2]]":3,"「常識で考えりゃそうだが、相手は幻の古代竜だ。\n　なにがあってもおかしくはない。\\nw[\\N[1]]":4,"「それに操ってるのは、あの腹黒\\N[5]だからな。\\nw[\\N[1]]":5,"「パルフュークの街を滅茶苦茶にしておいて、ここだけ\n　無事に済ませるとは思えん。\\nw[\\N[1]]":6,"「モンスターの襲撃で宮殿内も混乱してるだろうから、\n　この隙に見て回るぞ」\\nw[\\N[1]]":7,"本棚（移動後）":8,"メイド1":9,"「どうしましょう！　どうしましょう！\n　宮殿にまでモンスターが来ちゃったら！？」\\nw[メイド]":10,"「どうしましょう！　どうしましょう！\n　大公殿下が殺されてしまったわ！」\\nw[メイド]":11,"「チェリア様が女王ですって！　すごいわ！」\\nw[メイド]":12,"使用人1":13,"「宮殿全体が混乱している今こそ、窓を拭いて\n　心を落ち着けよう」\\nw[使用人]":14,"「大公様がお亡くなりになるなんて……！\n　こんなときこそ窓を拭いて心を落ち着けよう」\\nw[使用人]":15,"「たとえ主がいなくとも、掃除はしっかりしないとね！\n　さあ今日も窓を拭くぞ！」\\nw[使用人]":16,"燭台":17,"光":18,"宝箱（お金正面開き）":19,"<TE:16>":20,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":21,"EV022":22,"EV023":23,"EV024":24,"チェリア（副都擾乱）":25,"兵士":26,"執事":27,"「チェリア様、ご心配には及びませんので、\n　騒ぎが収まるまでこの部屋でお待ちください」\\nw[執事]":28,"「本当に大丈夫なのですか？\n　街のあちこちから煙が上がり、人々の悲鳴がここまで……\\nw[チェリア]":29,"「なんと恐ろしい……どうしてこのようなことが……」\\nw[チェリア]":30,"「チェリア様……おいたわしや……。\n　このような形で父君を亡くされてしまうとは……」\\nw[執事]":31,"メイド2":32,"身代わり奴隷":33,"メイド（姫身代わり）":34,"主人公（姫身代わり）":35,"ユマ（姫身代わりEv）":36,"「この奴隷をチェリア様のようにすればよろしいの\n　ですか？」\\nw[メイド]":37,"「うむ。なるべくそっくりになるよう頼む」\\nw[騎士]":38,"「では……我が化粧術の最終奥義、ご覧あれ！」\\nw[メイド]":39,"「とりゃあああぁぁッ！！」\\nw[メイド]":40,"「こ、これは……！」\\nw[騎士]":41,"「なにをしているのですか？」\\nw[チェリア]":42,"「チェリア様、ちょうど良いところへ！\n　これをご覧になってくださいませ！」\\nw[メイド]":43,"「まあっ、なんてこと！\n　鏡を見ているみたい！」\\nw[チェリア]":44,"「この出来映えなら、チェリア様の身代わりとして\n　十分に通用するでしょう！」\\nw[騎士]":45,"「どうやら満足してもらえたらしい。\n　あとは報酬をもらうだけだな」\\nw[\\N[1]]":46,"「それにしても、お化粧でこれほどそっくりに出来る\n　なんてびっくりです！\\nw[\\N[2]]":47,"「あのメイドさん凄いですね」\\nw[\\N[2]]":48,"「そうだな。\n　もし姫を狙っている魔術師がここに来たら、\n　どっちをさらえばいいのか迷っちまうんじゃ――」\\nw[\\N[1]]":49,"「ぐははははっ！！\n　憎きパルフューク大公への復讐を今こそ為さん！\\nw[魔術師]":50,"「チェリア姫よ！　その身柄を預かるぞ！\n　恨むなら死んだ父親を恨め！」\\nw[魔術師]":51,"「チェリア姫よ！\n　貴様の父親に絶望を与えるため、その身柄を預かるぞ！」\\nw[魔術師]":52,"「な、なんてことだ！\n　これほど早く敵が来てしまうとは！」\\nw[騎士]":53,"「さあ我とともに来い！\n　言っておくが、逆らっても無駄――。\\nw[魔術師]":54,"「――ってアレ？\n　チェリア姫が二人？\\nw[魔術師]":55,"「ど、どういうことだ？！\n　まさか幻術か？」\\nw[魔術師]":56,"「おのれ邪悪なる魔術師め！\n　お前の好きにはさせんぞ！」\\nw[騎士]":57,"「だまれザコが！　邪魔をするな！」\\nw[魔術師]":58,"「きゃああああぁっ！？」\\nw[チェリア]":59,"「ええいっ！\n　とにかくチェリア姫以外は皆殺しにしてくれる！」\\nw[魔術師]":60,"「くそっ、こりゃあ戦うしかなさそうだ！」\\nw[\\N[1]]":61,"「なんでこんなことにぃー！！」\\nw[\\N[2]]":62,"「ぐはあぁっ？！　つ、強い！？\\nw[魔術師]":63,"「おのれっ……だが我はあきらめんぞ！」\\nw[魔術師]":64,"「チェリア姫はもらったぁッ！！」\\nw[魔術師]":65,"「ち、ちがう！　わたしは――」\\nw[女奴隷]":66,"「どうしましょう！？\n　偽のチェリア姫がさらわれちゃいましたよ！」\\nw[\\N[2]]":67,"「まあ本物は無事だったんだし、とりあえずは\n　良かったんじゃないか？」\\nw[\\N[1]]":68,"「えぇ～！？」\\nw[\\N[2]]":69,"「ぐっ……あの魔術師はどこに！？」\\nw[騎士]":70,"「みごと偽物に引っかかって、そっちをさらっていったぜ」\\nw[\\N[1]]":71,"「そ、そうか……。\n　不覚をとってしまったが、最悪の事態だけは避けられたか」\\nw[騎士]":72,"「わたしの身代わりに連れ去られてしまうなんて！\n　あの人を助けてあげないと！」\\nw[チェリア]":73,"「至急、魔術師の行方を捜索させましょう！」\\nw[騎士]":74,"「こっちの報酬も忘れずに頼むぜ」\\nw[\\N[1]]":75,"「なにもいま催促しなくても……」\\nw[\\N[2]]":76,"「いや、貴殿らの働きでチェリア様は事なきを得た。\n　ご助力、誠に感謝いたす」\\nw[騎士]":77,"個別依頼\\C[17]『姫の身代わり』\\C[0]を達成した！":78,"↓プレーヤー位置強制中央解除":79,"SFC_ENABLE_RESERVE":80,"\nその頃、連れ去られたチェリア姫の偽者は――。":81,"騎士（姫身代わり）":82,"チェリア（身代わり）":83},"extension":"json","dataType":"map","filename":"Map324","basename":"Map324.json","path":"data/Map324.json","relPath":"data/Map324.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":84,"percent":0},"cellInfo":[]},"data/Map325.json":{"data":[["兵士",""],["メイド1",""],["「この使用人部屋に引き篭もってれば、大丈夫……\n　きっと大丈夫よ……」\\nw[メイド]",""],["「大公様が……そんな……。\n　これから私のお給金は誰が払ってくれるの……？」\\nw[メイド]",""],["「チェリア様が王都へ行ってしまったから、宮殿内が\n　なんだか寂しくなってしまったわ」\\nw[メイド]",""],["燭台",""],["光",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["引き返し",""],["兵士に見つかると騒ぎになってしまう。\nこの先へ行くのはやめておこう。",""],["メイド（恩返し前）",""],["「あなたたちは、私を盗賊から救ってくれた……！？\n　どうして宮殿の中に？\\nw[メイド]",""],["「いえ、詮索はよしておきましょう。\n　それよりも、今度会ったらお礼をすると約束しました\n　よね。\\nw[メイド]",""],["「大したものではありませんが、どうぞ、\n　そちらの\\C[17]宝箱\\C[0]を」\\nw[メイド]",""],["EV034",""],["宝箱（防具）",""],["※\n防具：メイド服\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["メイド（恩返し後）",""],["「命の恩人ですからここは見て見ぬふりしますが、\n　警備兵に見つかる前に逃げてくださいね」\\nw[メイド]",""],["「命の恩人ですからここは見て見ぬふりしますが、\n　勝手に入ってきたらダメですよ」\\nw[メイド]",""],["防壁",""],["使用人2",""],["「兵士がバリケードを構築してるけど、この宮殿の中に\n　までモンスターが入ってくるのだろうか？」\\nw[使用人]",""],["「モンスターには襲われずに済んだけど、まさか大公様が\n　お亡くなりになってしまうなんて……」\\nw[使用人]",""]],"context":[["Map325/events/1/name","Map325/events/2/name","Map325/events/4/name","Map325/events/5/name"],["Map325/events/3/name"],["Map325/events/3/pages/0/list/1/message/noPicture/bottom"],["Map325/events/3/pages/1/list/1/message/noPicture/bottom"],["Map325/events/3/pages/2/list/0/message/noPicture/bottom"],["Map325/events/6/name","Map325/events/8/name","Map325/events/9/name","Map325/events/10/name","Map325/events/11/name","Map325/events/22/name","Map325/events/24/name"],["Map325/events/7/name","Map325/events/12/name","Map325/events/13/name","Map325/events/14/name","Map325/events/15/name","Map325/events/23/name","Map325/events/25/name"],["Map325/events/16/name"],["Map325/events/17/name"],["Map325/events/18/name"],["Map325/events/19/name"],["Map325/events/20/name"],["Map325/events/21/name"],["Map325/events/26/name","Map325/events/27/name","Map325/events/28/name","Map325/events/29/name","Map325/events/30/name","Map325/events/31/name","Map325/events/32/name"],["Map325/events/26/pages/0/list/1/message/noPicture/bottom","Map325/events/27/pages/0/list/1/message/noPicture/bottom","Map325/events/28/pages/0/list/1/message/noPicture/bottom","Map325/events/29/pages/0/list/1/message/noPicture/bottom","Map325/events/30/pages/0/list/1/message/noPicture/bottom","Map325/events/31/pages/0/list/1/message/noPicture/bottom","Map325/events/32/pages/0/list/1/message/noPicture/bottom"],["Map325/events/33/name"],["Map325/events/33/pages/0/list/2/message/noPicture/bottom","Map325/events/36/pages/2/list/0/message/noPicture/bottom"],["Map325/events/33/pages/0/