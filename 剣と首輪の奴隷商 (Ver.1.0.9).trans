:["",0,0,2]}],[{"headerIndex":139,"headerParam":["",0,0,2]}],[{"headerIndex":147,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":162,"headerParam":["",0,0,2]}],[{"headerIndex":165,"headerParam":["",0,0,2]}]],"indexIds":{"男":0,"\n\\>　　　　　　～　依頼者の男の自宅にて　～":1,"「ここがキッチン。\n　料理のときは火の扱いに気をつけてくれよ」\\nw[男]":2,"「はい、分かりました。旦那様」\\nw[奴隷女]":3,"（奴隷にされたときはどうなることかと思ったけど、\n　購入者がまともそうで安心したわ……）\\nw[奴隷女]":4,"「次にここがリビング。\n　お客さんを通すこともあるから、掃除はこまめに\n　頼むぜ」\\nw[男]":5,"「はい、旦那様」\\nw[奴隷女]":6,"「どうかなさいましたか？」\\nw[奴隷女]":7,"「夜まで待とうと思ってたけど……やっぱり我慢でき\n　そうにねぇぜ……」\\nw[男]":8,"「はい？」\\nw[奴隷女]":9,"「はぁはぁ……いますぐお前が欲しいっ！\n　ネコちゃん！　オレのネコちゃああぁんっ！」\\nw[男]":10,"「な、なによ急に！？\n　まともな人だと思ったのに、やっぱりそういう目的\n　だったの！？」\\nw[奴隷女]":11,"「さあ、その余計な布を脱いで、すべてを見せておくれ！」\\nw[男]":12,"「ちょ、ちょっと旦那様！　ここテーブルの上なんだけど！\n　せめてベッドにしてよぉ！！」\\nw[奴隷女]":13,"「はぁ……はあぁ……\\I[29]\n　いっぱい出されちゃったぁ\\I[29]」\\nw[奴隷女]":14,"「まだまだこれからだぜ。次はベッドへ行こう。\n　確実に妊娠するよう、もっと子種を入れてやるからな！」\\nw[男]":15,"「はい、旦那さまぁ\\I[29]」\\nw[奴隷女]":16,"↓プレーヤー位置強制中央解除":17,"SFC_DISABLE_RESERVE":18,"個別依頼『猫耳娘ラブ』の達成報酬として\\C[17]４０００Ｇ\\C[0]と\n\\C[17]『\\in[50]』\\C[0]を入手した！":19,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":20,"奴隷":21,"EV003":22},"extension":"json","dataType":"map","filename":"Map411","basename":"Map411.json","path":"data/Map411.json","relPath":"data/Map411.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":23,"percent":0},"cellInfo":[]},"data/Map412.json":{"data":[["魔術師",""],["\n\\>　　　　　　　～　魔術師の自宅にて　～",""],["「起動せよ、魔法陣！」\\nw[魔術師]",""],["「さあ、準備は整った。\n　これより魔術実験を始める」\\nw[魔術師]",""],["「実験ってなにするのかなぁ？\n　わたし、酷いことされちゃうの？　いやーん♪」\\nw[奴隷悪魔]",""],["「悪魔という存在は、ほんとうに度し難い。\n　己の身の危険に無頓着で、死さえ嘲笑うのだからな」\\nw[魔術師]",""],["「えぇ～？　もしかして殺されちゃう？\n　首チョンパ？　それとも毒薬ゴクゴク？」\\nw[奴隷悪魔]",""],["「殺しはしない。\n　もっとも、実験の結果は未知数だから無事に済むという\n　保証もないがな。\\nw[魔術師]",""],["「では服を脱げ、悪魔よ」\\nw[魔術師]",""],["「なぁ～んだ。脅しておいて、結局やることはそれ？\n　いいよぉ、全部見せてあげるわ\\I[29]」\\nw[奴隷悪魔]",""],["「次に、私と交わってもらうぞ」\\nw[魔術師]",""],["「あはははっ♪\n　エッチしたいなら素直にそう言えばいいのに\\I[29]\n　実験なんて言い訳しなくっても、相手してあげるよぉ\\I[29]」\\nw[奴隷悪魔]",""],["「悪魔を妊娠させる魔術！？　本当にそんなものが！？\n　じゃあわたし、あなたの子供を孕んじゃうの……？」\\nw[奴隷悪魔]",""],["「実験が成功すれば、そうなる。\\nw[魔術師]",""],["「そしてもしお前が娘を産んだなら、今度はその子と\n　交わって、ハーフ悪魔は魔術無しでの妊娠が可能かを\n　検証する予定だ」\\nw[魔術師]",""],["「わたしに産ませた子も犯すの！？\n　あははははっ\\I[29]　すごい！　正気じゃないわぁ\\I[29]\\nw[奴隷悪魔]",""],["「人間の考えることのほうが、わたしたちなんかより\n　よっぽど悪魔的ねぇ\\I[29]」\\nw[奴隷悪魔]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『魔術実験』の報酬として\\C[17]筋肉増強剤\\C[0]と\\C[17]魔力増強剤\\C[0]\nを４個ずつ入手した！",""],["奴隷",""],["EV003",""],["EV004",""],["EV005",""],["魔法陣（イベント）",""],["魔法陣",""]],"context":[["Map412/events/1/name"],["Map412/events/1/pages/0/list/5/message/noPicture/middle"],["Map412/events/1/pages/0/list/12/message/noPicture/bottom"],["Map412/events/1/pages/0/list/28/message/noPicture/bottom"],["Map412/events/1/pages/0/list/33/message/noPicture/bottom"],["Map412/events/1/pages/0/list/37/message/noPicture/bottom"],["Map412/events/1/pages/0/list/41/message/noPicture/bottom"],["Map412/events/1/pages/0/list/44/message/noPicture/bottom"],["Map412/events/1/pages/0/list/48/message/noPicture/bottom"],["Map412/events/1/pages/0/list/51/message/noPicture/bottom"],["Map412/events/1/pages/0/list/62/message/noPicture/bottom"],["Map412/events/1/pages/0/list/65/message/noPicture/bottom"],["Map412/events/1/pages/0/list/78/message/noPicture/bottom"],["Map412/events/1/pages/0/list/81/message/noPicture/bottom"],["Map412/events/1/pages/0/list/83/message/noPicture/bottom"],["Map412/events/1/pages/0/list/88/message/noPicture/bottom"],["Map412/events/1/pages/0/list/91/message/noPicture/bottom"],["Map412/events/1/pages/0/list/100/comment"],["Map412/events/1/pages/0/list/101/Plugin Command"],["Map412/events/1/pages/0/list/113/message/noPicture/bottom"],["Map412/events/2/name"],["Map412/events/3/name"],["Map412/events/4/name"],["Map412/events/5/name"],["Map412/events/6/name"],["Map412/events/7/name","Map412/events/8/name","Map412/events/9/name"]],"tags":[["gold"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["red"],["blue"],null,["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[null,[{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":28,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":37,"headerParam":["",0,0,2]}],[{"headerIndex":41,"headerParam":["",0,0,2]}],[{"headerIndex":44,"headerParam":["",0,0,2]}],[{"headerIndex":48,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":78,"headerParam":["",0,0,2]}],[{"headerIndex":81,"headerParam":["",0,0,2]}],[{"headerIndex":83,"headerParam":["",0,0,2]}],[{"headerIndex":88,"headerParam":["",0,0,2]}],[{"headerIndex":91,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":113,"headerParam":["",0,0,2]}]],"indexIds":{"魔術師":0,"\n\\>　　　　　　　～　魔術師の自宅にて　～":1,"「起動せよ、魔法陣！」\\nw[魔術師]":2,"「さあ、準備は整った。\n　これより魔術実験を始める」\\nw[魔術師]":3,"「実験ってなにするのかなぁ？\n　わたし、酷いことされちゃうの？　いやーん♪」\\nw[奴隷悪魔]":4,"「悪魔という存在は、ほんとうに度し難い。\n　己の身の危険に無頓着で、死さえ嘲笑うのだからな」\\nw[魔術師]":5,"「えぇ～？　もしかして殺されちゃう？\n　首チョンパ？　それとも毒薬ゴクゴク？」\\nw[奴隷悪魔]":6,"「殺しはしない。\n　もっとも、実験の結果は未知数だから無事に済むという\n　保証もないがな。\\nw[魔術師]":7,"「では服を脱げ、悪魔よ」\\nw[魔術師]":8,"「なぁ～んだ。脅しておいて、結局やることはそれ？\n　いいよぉ、全部見せてあげるわ\\I[29]」\\nw[奴隷悪魔]":9,"「次に、私と交わってもらうぞ」\\nw[魔術師]":10,"「あはははっ♪\n　エッチしたいなら素直にそう言えばいいのに\\I[29]\n　実験なんて言い訳しなくっても、相手してあげるよぉ\\I[29]」\\nw[奴隷悪魔]":11,"「悪魔を妊娠させる魔術！？　本当にそんなものが！？\n　じゃあわたし、あなたの子供を孕んじゃうの……？」\\nw[奴隷悪魔]":12,"「実験が成功すれば、そうなる。\\nw[魔術師]":13,"「そしてもしお前が娘を産んだなら、今度はその子と\n　交わって、ハーフ悪魔は魔術無しでの妊娠が可能かを\n　検証する予定だ」\\nw[魔術師]":14,"「わたしに産ませた子も犯すの！？\n　あははははっ\\I[29]　すごい！　正気じゃないわぁ\\I[29]\\nw[奴隷悪魔]":15,"「人間の考えることのほうが、わたしたちなんかより\n　よっぽど悪魔的ねぇ\\I[29]」\\nw[奴隷悪魔]":16,"↓プレーヤー位置強制中央解除":17,"SFC_DISABLE_RESERVE":18,"個別依頼『魔術実験』の報酬として\\C[17]筋肉増強剤\\C[0]と\\C[17]魔力増強剤\\C[0]\nを４個ずつ入手した！":19,"奴隷":20,"EV003":21,"EV004":22,"EV005":23,"魔法陣（イベント）":24,"魔法陣":25},"extension":"json","dataType":"map","filename":"Map412","basename":"Map412.json","path":"data/Map412.json","relPath":"data/Map412.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":26,"percent":0},"cellInfo":[]},"data/Map413.json":{"data":[["三流冒険者",""],["\n\\>　　　　～　どことも知れぬ廃墟の神殿にて　～",""],["「サファイアの粉末をまぶした燃料で、火を灯したわよ」\\nw[女魔法使い]",""],["「こっちもＯＫだ！」\\nw[男剣士]",""],["「了解！\n　これで後は、祭壇に生贄を捧げて邪神召喚の呪文を\n　唱えるだけだ」\\nw[三流冒険者]",""],["「というわけでエルフの奴隷さん、服を脱いであの祭壇に\n　あがってもらえるかな？」\\nw[三流冒険者]",""],["「生贄にされると分かっていて、誰がそんな……！」\\nw[生贄エルフ]",""],["「断られると困るんだよなぁ。\n　自分の足で行かないなら、縛って無理矢理に祭壇へ\n　置くことになるけど？」\\nw[三流冒険者]",""],["「分かってくれてうれしいよ。\n　じゃあ祭壇へどうぞ」\\nw[三流冒険者]",""],["「いよいよだな！」\\nw[男剣士]",""],["「召喚した邪神と契約を交わして、わたしたちは\n　トップクラスの冒険者にも勝る力を得る！」\\nw[女魔法使い]",""],["「ああ、みんなで伝説になろう！\n　それじゃあ召喚の呪文を唱えるよ！\\nw[三流冒険者]",""],["「古に封じられし邪神、ショエ＝クロシュよ！\n　我が呼びかけに応えて現世に顕現せよ！\n　オハン・エナロ・ド＝イレヨ・イネ！！」\\nw[三流冒険者]",""],["createFilter 1 rgbsplit 3",""],["setFilter 1 8 0",""],["「あ……現れた！　邪神ショエ＝クロシュだ！」\\nw[三流冒険者]",""],["「ひいいいぃぃっ？！！　まさか、本当に邪神がっ！？」\\nw[生贄エルフ]",""],["「さあ、邪神よ！　その生贄を受け取ってくれ！\n　そしてボクたちに大いなる力を！！」\\nw[三流冒険者]",""],["「％▽＆○＃＄＃＊＞○◇＜＊＄％□」\\nw[邪神]",""],["「は……はははっ……！\n　生贄のエルフは気に入ってくれたようだね！\\nw[三流冒険者]",""],["「ならばボクたちに力をくれ！\n　常人のそれを超えた、大いなる力を！！」\\nw[三流冒険者]",""],["\\{「うわあああぁああぁぁっ？！！\n　なんじゃこりゃあぁっ！！？」\\}\\nw[冒険者たち]",""],["「愚かな人間ども……ふふっ……\\I[29]」\\nw[生贄エルフ]",""],["「我が主よ\\I[29]　わたしはこの子を産み落として、\n　あなた様の完全なる降臨をお助けいたします\\I[29]\\nw[生贄エルフ]",""],["「たとえ何百年かかろうと……必ずや成し遂げて\n　みせましょう\\I[29]」\\nw[生贄エルフ]",""],["eraseFilter 1",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『召喚の生贄』の達成報酬として\\C[17]\\in[46]５個\\C[0]と\n\\C[17]\\in[50]\\C[0]入手した！",""],["奴隷",""],["かがり火",""],["邪神",""],["女魔法使い",""],["男剣士",""]],"context":[["Map413/events/1/name"],["Map413/events/1/pages/0/list/5/message/noPicture/middle"],["Map413/events/1/pages/0/list/37/message/noPicture/bottom"],["Map413/events/1/pages/0/list/40/message/noPicture/bottom"],["Map413/events/1/pages/0/list/43/message/noPictu