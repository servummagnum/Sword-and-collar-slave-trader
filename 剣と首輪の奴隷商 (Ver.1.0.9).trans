P回復20%":460,"が肉体を治癒した！":461,"無気力への誘い":462,"（敵）敵全体に睡眠・魅了＋攻撃力・防御力低下":463,"ＨＰドレイン":464,"（敵）ＨＰを吸収":465,"フルスイング":466,"（敵）敵全体に威力２５０％の物理攻撃を一撃ずつ入れる":467,"氷塊投げ":468,"敵単体に３００％の物理攻撃":469,"睡眠導入":470,"竜の爪牙":471,"（敵）敵全体に威力３００％攻撃":472,"強酸液":473,"（敵）威力１００％でランダムに四回攻撃":474,"白濁液":475,"（敵）敵単体に白濁液をぶっかけて戦技を封印":476,"<RTS_有効アクターID:2>\n<BeforeCommon:483>":477,"ＨＰドレイン＋":478,"余罪魔死魔死":479,"（敵）敵単体に威力３００％攻撃＋攻撃・防御低下":480,"余罪魔死魔死／忍辱阿修羅":481,"（敵）敵全体に威力３００％攻撃＋攻撃・防御低下":482},"extension":"json","dataType":"skills","filename":"Skills","basename":"Skills.json","path":"data/Skills.json","relPath":"data/Skills.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":483,"percent":0},"cellInfo":[],"cacheResetOnChange":{}},"data/States.json":{"data":[["戦闘不能","Unable to fight"],["は倒れた！","fell down!"],["を倒した！","I defeated it!"],["は立ち上がった！","stood up!"],["<ステートヘルプ>\n戦闘不能：一切の行動ができない\n</ステートヘルプ>\nステート１番はＨＰが０になったときに\n自動的に付加されます。","<state help>\nIncapable of combat: unable to take any actions\n</state help>\nState 1 is when HP becomes 0\nIt will be added automatically."],["防御","defense"],["不死身","immortality"],["毒","poison"],["は毒にかかった！","is poisoned!"],["に毒をかけた！","I poisoned it!"],["の毒が消えた！","The poison is gone!"],["<ステートヘルプ>\n毒：ターンごとにＨＰが１０％ずつ減少\n</ステートヘルプ>","<state help>\nPoison: HP decreases by 10% every turn\n</state help>"],["混乱","confusion"],["は混乱した！","I was confused!"],["を混乱させた！","Confused!"],["は我に返った！","I came to my senses!"],["<ステートヘルプ>\n混乱：敵味方関係なくランダムに攻撃\n</ステートヘルプ>","<state help>\nConfusion: Attack randomly regardless of friend or foe.\n</state help>"],["睡眠","sleep"],["は眠った！","fell asleep!"],["を眠らせた！","I put him to sleep!"],["は目を覚ました！","I woke up!"],["<ステートヘルプ>\n睡眠：解除されるまで行動不能\n</ステートヘルプ>","<state help>\nSleep: Incapable of action until canceled\n</state help>"],["魅了","Fascinating"],["は魅了された！","was fascinated!"],["を魅了した！","It fascinated me!"],["<ステートヘルプ>\n魅了：味方を攻撃\n</ステートヘルプ>","<state help>\nCharm: Attack allies\n</state help>"],["沈黙","silence"],["は沈黙した！","was silent!"],["を沈黙させた！","silenced!"],["の沈黙が解けた！","The silence has been lifted!"],["<ステートヘルプ>\n沈黙：全ての魔法を使用禁止\n</ステートヘルプ>","<state help>\nSilence: All magic is prohibited.\n</state help>"],["状態異常無効化","Disable status abnormality"],["は状態異常にかからなくなった！","is no longer affected by status abnormalities!"],["の状態異常耐性が元にもどった！","'s status ailment resistance has returned to normal!"],["<ステートヘルプ>\n状態異常無効化：全ての状態異常を無効\n</ステートヘルプ>","<state help>\nNullify status ailments: Disable all status ailments\n</state help>"],["戦技封印","Battle technique seal"],["は戦技を封じられた！","His combat skills were sealed!"],["の戦技を封じた！","'s combat techniques have been sealed!"],["の封印が解けた！","The seal has been broken!"],["<ステートヘルプ>\n戦技封印：全ての戦技を使用禁止\n</ステートヘルプ>","<state help>\nCombat Skills Seal: Prohibits use of all combat skills\n</state help>"],["異変","Anomaly"],["竜の寝床での演出用。\nステートの存在が見えないようにメッセージなどは空白に。","For performances in the dragon's bed.\nLeave messages etc. blank so that the existence of the state is not visible."],["中身無し","No contents"],["反撃","counterattack"],["は反撃の構えをとった！","prepared for a counterattack!"],["は反撃の構えを解いた。","released his counterattack stance."],["※後の先用\n<ステートヘルプ>\n反撃：攻撃を受けたら即座に反撃\n</ステートヘルプ>\n<CE_MagicCounter:100>\n↑魔法攻撃受けた場合も100%反撃\n<CE_CounterSkillId:114>","*For later use\n<state help>\nCounterattack: Immediately counterattack when attacked\n</state help>\n<CE_MagicCounter:100>\n↑100% counterattack when receiving magic attack\n<CE_CounterSkillId:114>"],["※後の先・弐用\n<ステートヘルプ>\n反撃：攻撃を受けたら即座に反撃\n</ステートヘルプ>\n<CE_MagicCounter:100>\n↑魔法攻撃受けた場合も100%反撃\n<CE_CounterSkillId:115>","※After the end/Niyo\n<state help>\nCounterattack: Immediately counterattack when attacked\n</state help>\n<CE_MagicCounter:100>\n↑100% counterattack when receiving magic attack\n<CE_CounterSkillId:115>"],["攻撃準備","preparation for attack"],["は攻撃の準備をしている！","is preparing to attack!"],["の攻撃準備が解かれた！","Preparations for attack have been released!"],["<ステートヘルプ>\n攻撃準備：次のターンに強力な技が発動\n</ステートヘルプ>","