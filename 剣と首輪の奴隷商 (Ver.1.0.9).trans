,2]}],[{"headerIndex":189,"headerParam":["",0,0,2]}],[{"headerIndex":196,"headerParam":["",0,0,2]}],[{"headerIndex":200,"headerParam":["",0,0,2]}],[{"headerIndex":206,"headerParam":["",0,0,2]}],[{"headerIndex":215,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":230,"headerParam":["",0,0,2]}],[{"headerIndex":233,"headerParam":["",0,0,2]}]],"indexIds":{"男":0,"\n\\>　　　　　～　砂漠の部族長の邸宅にて　～":1,"「はっはっはっ、みな息災なようで何よりだ」\\nw[族長]":2,"「族長のお陰にございます。\n　今宵はこのような酒宴にまでお招きいただき、まことに\n　ありがたく存じます」\\nw[部族の男Ａ]":3,"「北の王国との商取引も順調なようで何よりかと。\\nw[部族の男Ｂ]":4,"「そういえば、また北方の何やら珍しいものをご購入\n　なされたとか？」\\nw[部族の男Ｂ]":5,"「おお、そうなのだ！\\nw[族長]":6,"「実はハーレムの女どもにも少々飽いてきたのでな、\n　砂漠にはいないような珍しい女を探させていたのだ」\\nw[族長]":7,"「珍しい、とおっしゃいますと？」\\nw[部族の男Ｃ]":8,"「北方に棲む亜人の女だ。\n　ちょうど良い、ここでお披露目といこう。\\nw[族長]":9,"「誰か！　例の亜人をここへ！」\\nw[族長]":10,"「これが北の王国より取り寄せた“鬼”という亜人だ」\\nw[族長]":11,"「なんと、角が生えている！」\\nw[部族の男Ｃ]":12,"「それに赤銅色の肌とは、確かにこれは珍しい！」\\nw[部族の男Ｂ]":13,"「取り寄せたばかりでワシもまだよく見ておらんのでな、\n　ここで人との違いをじっくり検分しようではないか」\\nw[族長]":14,"「この鬼の服を脱がせよ」\\nw[族長]":15,"「アァ……ウウゥ……\\I[29]」\\nw[奴隷鬼]":16,"「ふぅっ。玉がスッカラカンになってしまったぞ。\n　しかし良きアソコであった」\\nw[族長]":17,"「見ていたら、久々に勃ってしまった」\\nw[部族の男Ａ]":18,"「鬼娘、なかなかに良さそうではないか。\n　オレも買い付けてみようか……」\\nw[部族の男Ｂ]":19,"「おい、自分でも買うつもりなのか？\n　だったら頼む、オレの分もついでに調達してくれ！」\\nw[部族の男Ｃ]":20,"「だ、だったらオレも！」\\nw[部族の男Ｄ]":21,"「やれやれ、珍しい女を連れて来させたというのに。\n　このままでは希少価値がなくなってしまいそうだ」\\nw[族長]":22,"↓プレーヤー位置強制中央解除":23,"SFC_DISABLE_RESERVE":24,"個別依頼『族長の愛人探し』の達成報酬として\n\\C[17]\\in[19]４個\\C[0]を入手した！":25,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":26,"奴隷":27,"客1":28,"客2":29,"客3":30,"客4":31,"客5":32,"客6":33,"愛妾1":34,"愛妾2":35,"愛妾3":36,"愛妾4":37,"使用人1":38,"使用人2":39,"警備兵1":40,"警備兵2":41},"extension":"json","dataType":"map","filename":"Map420","basename":"Map420.json","path":"data/Map420.json","relPath":"data/Map420.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":42,"percent":0},"cellInfo":[]},"data/Map421.json":{"data":[["男",""],["\n\\>　　　　　　～　依頼者の男の自宅にて　～",""],["「ナニココ？　ヘンナトコ！」\\nw[奴隷ハーピー]",""],["「ハッハッ！　元気があってよろしい！」\\nw[好事家の男]",""],["「ナニスル？　アソブ？」\\nw[奴隷ハーピー]",""],["「うむ、そうだな。\n　新しいペットとの触れ合いは大切だから、一緒に\n　遊ぶとしようか？」\\nw[好事家の男]",""],["「アソブ！　アソブ！　ナニシテアソブ？」\\nw[奴隷ハーピー]",""],["「気持ちいい遊びを教えてあげよう。\n　さあ、まずはその汚い服を脱ごうか」\\nw[好事家の男]",""],["「オシリ、キモチイィ！　モット！　モット！」\\nw[奴隷ハーピー]",""],["「ハハッ！　これは飼育のし甲斐があるハーピーだな。\n　よし、どんどん仕込んでいってやろう\\I[29]」\\nw[好事家の男]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『珍ペット募集』の達成報酬として\\C[17]８０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["奴隷",""],["EV003",""],["火",""],["EV005",""]],"context":[["Map421/events/1/name"],["Map421/events/1/pages/0/list/5/message/noPicture/middle"],["Map421/events/1/pages/0/list/18/message/noPicture/bottom"],["Map421/events/1/pages/0/list/51/message/noPicture/bottom"],["Map421/events/1/pages/0/list/54/message/noPicture/bottom"],["Map421/events/1/pages/0/list/57/message/noPicture/bottom"],["Map421/events/1/pages/0/list/68/message/noPicture/bottom"],["Map421/events/1/pages/0/list/71/message/noPicture/bottom"],["Map421/events/1/pages/0/list/97/message/noPicture/bottom"],["Map421/events/1/pages/0/list/100/message/noPicture/bottom"],["Map421/events/1/pages/0/list/110/comment"],["Map421/events/1/pages/0/list/111/Plugin Command"],["Map421/events/1/pages/0/list/125/message/noPicture/bottom"],["Map421/events/1/pages/0/list/128/message/noPicture/bottom"],["Map421/events/2/name"],["Map421/events/3/name"],["Map421/events/4/name"],["Map421/events/5/name"]],"tags":[["gold"],null,null,null,null,null,null,null,null,null,["red"],["blue"],null,null,["gold"],["gold"],["gold"],["gold"]],"parameters":[null,[{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":18,"headerParam":["",0,0,2]}],[{"headerIndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":54,"headerParam":["",0,0,2]}],[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":71,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":110,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":125,"headerParam":["",0,0,2]}],[{"headerIndex":128,"headerParam":["",0,0,2]}]],"indexIds":{"男":0,"\n\\>　　　　　　～　依頼者の男の自宅にて　～":1,"「ナニココ？　ヘンナトコ！」\\nw[奴隷ハーピー]":2,"「ハッハッ！　元気があってよろしい！」\\nw[好事家の男]":3,"「ナニスル？　アソブ？」\\nw[奴隷ハーピー]":4,"「うむ、そうだな。\n　新しいペットとの触れ合いは大切だから、一緒に\n　遊ぶとしようか？」\\nw[好事家の男]":5,"「アソブ！　アソブ！　ナニシテアソブ？」\\nw[奴隷ハーピー]":6,"「気持ちいい遊びを教えてあげよう。\n　さあ、まずはその汚い服を脱ごうか」\\nw[好事家の男]":7,"「オシリ、キモチイィ！　モット！　モット！」\\nw[奴隷ハーピー]":8,"「ハハッ！　これは飼育のし甲斐があるハーピーだな。\n　よし、どんどん仕込んでいってやろう\\I[29]」\\nw[好事家の男]":9,"↓プレーヤー位置強制中央解除":10,"SFC_DISABLE_RESERVE":11,"個別依頼『珍ペット募集』の達成報酬として\\C[17]８０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！":12,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":13,"奴隷":14,"EV003":15,"火":16,"EV005":17},"extension":"json","dataType":"map","filename":"Map421","basename":"Map421.json","path":"data/Map421.json","relPath":"data/Map421.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":18,"percent":0},"cellInfo":[]},"data/Map422.json":{"data":[["燭台",""],["光",""],["檻出入り口1",""],["モブ奴隷",""],["EV017",""],["ラーナ（ED3Ev）",""],["「こ、こんなところにわたしを入れて、いったいどうする\n　つもりなんですか？！」\\nw[\\N[5]]",""],["「お前を連れてきたアサシンみたいな旦那からは、\n　徹底的に教育してくれって頼まれたぜ」\\nw[牢番]",""],["「教育？　どういう意味ですか？」\\nw[\\N[5]]",""],["「へへっ、慌てなくったって、どうせすぐに分かるさ」\\nw[牢番]",""],["「お客様が来られた。例の女を連れていくぞ」\\nw[従業員]",""],["「はいよ！　早速だな」\\nw[牢番]",""],["「え……わ、わたし……？」\\nw[\\N[5]]",""],["「そうだ、一緒に来い」\\nw[従業員]",""],["「…………」\\nw[\\N[5]]",""],["（いやな予感しかしないけど、今のわたしは竜の力を\n　封じられてる……ここは従うしかなさそうね）\\nw[\\N[5]]",""],["「行くぞ」\\nw[従業員]",""],["「なっ？！　ここは！？」\\nw[\\N[5]]",""],["FocusCamera 12 24 90",""],["「お前たちのような性奴隷を心ゆくまで嬲るための、\n　\\C[17]会員制秘密クラブ\\C[0]だ。\\nw[従業員]",""],["「娼館では禁止されているハードプレイも、ここでなら\n　好きなだけ楽しめるのさ」\\nw[従業員]",""],["「こ、こんな不品行な場所が王国内にあったなんて……」\\nw[\\N[5]]",""],["「一部の金持ちしか入れない特別なクラブで、性奴隷も\n　厳選した者しか受け入れていないのだが――\\nw[従業員]",""],["「お前の場合は貧民街のボスの仲介があったのでな、\n　少々怪しくはあるが、特例で受け入れたのだ」\\nw[従業員]",""],["ResetFocus 60",""],["「ひぎゃああぁあぁぁっ！！　\n　お股が裂けちゃう゛ううぅううぅぅっ！！」\\nw[\\N[3]]",""],["「\\N[3]？！」\\nw[\\N[5]]",""],["「ひっ、姫様あぁっ！！　たすけてえぇっ！！\n　んぎいいぃっ？！　いやあぁあぁぁっ！！」\\nw[\\N[3]]",""],["「お前と一緒に預けられたこの女は、最低１０年間\n　ここでオモチャにされる契約だ。\\nw[従業員]",""],["「もっとも、壊れずに１年以上つづいた試しはないがな」\\nw[従業員]",""],["「まさか、わたしも\\N[3]と同じ目に遭わされるの！？」\\nw[\\N[5]]",""],["「いいや、お前の契約はまったく違う。\n　うまくいけば短期間でここを出られるかもしれないぞ？」\\nw[従業員]",""],["「ひめさまあ゛ああぁあぁぁっ！！\n　だずげでぐださい゛いいぃぃっ！！」\\nw[\\N[3]]",""],["「悪いけど、今のわたしでは力になれないわ。\n　自分のことは自分でどうにかするのね」\\nw[\\N[5]]",""],["「そっ、そんなああぁあぁっ？！！」\\nw[\\N[3]]",""],["「これは驚いた！　\\N[5]姫にそっくりじゃないか！」\\nw[クラブ会員]",""],["（それはそうよ、本人だもの……。\n　もっとも、わたしは死んだことにされてるから言っても\n　信じないでしょうけど）\\nw[\\N[5]]",""],["「いまからお前は、こちらの会員様にご奉仕するんだ。\\nw[従業員]",""],["「こうした奉仕を重ねていき、お前が\\C[27]真性のメス奴隷\\C[0]に\n　なったと認められれば、あのアサシン風の男のところへ\n　戻れるだろう」\\nw[従業員]",""],["「やっ、やっぱりそういう！\n　あの男、本気でわたしを調教して、使役するつもり\n　なんだわ……！」\\nw[\\N[5]]",""],["「ぐふふふっ！　さあ、これを着るんだ！\n　吾輩からのプレゼントだよ！」\\nw[クラブ会員]",""],["「ドレス……？」\\nw[\\N[5]]",""],["「おおっ、ますます\\N[5]姫らしくなった！\n　まるで瓜二つだ！」\\nw[クラブ会員]",""],["「いまさらこんなドレス……」\\nw[\\N[5]]",""],["「ぐふぅっ！　興奮してきたぞ！\n　吾輩のチンコで\\N[5]姫を犯してやるっ！！」\\nw[クラブ会員]",""],["「ちょ、ちょっと待って！　きゃあああぁぁっ？！」\\nw[\\N[5]]",""],["「んはぁ\\I[29]　はあぁ\\I[29]　おしりぃ\\I[29]\n　こんなに気持ちいいなんてぇ……\\I[29]」\\nw[\\N[5]]",""],["「ぐふふふ！　すっかりアナルセックスの虜だな！\n　\\N[5]姫のモノマネも堂に入っていたし、実に素晴らしい\n　性奴隷だ！\\nw[クラブ会員]",""],["「この娘、買い取りは出来んかね？\n　ぜひ吾輩の手元に置いておきたいのだが」\\nw[クラブ会員]",""],["「申し訳ございません。こちらの奴隷は持ち主から一時的に\n　預かっているだけなので……」\\nw[従業員]",""],["「それは残念だ！」\\nw[クラブ会員]",""],["（客のテクニックがあったとはいえ、この乱れよう。\n　元から淫乱の素質があったようだな）\\nw[従業員]",""],["「この分なら、お前の教育はすぐに済みそうだ。\n　喜べ、ここを出られる日もそう遠くはないぞ」\\nw[従業員]",""],["「ああぁ……そうなんれすかぁ？\n　それよりぃ、もっと気持ち良いこと教えてぇ\\I[29]\\nw[\\N[5]]",""],["「そぉだ～\\I[29]\n　外に出たらお兄様のおちんちんも挿れてもらお～\\I[29]」\\nw[\\N[5]]",""],["エンディングＮｏ．３\n『家族が増えるよ！』",""],["クリアデータをセーブしますか？",""],["セーブする",""],["セーブしない",""],["自宅に戻してゲーム再開\n↓　　↓　　↓",""],["三角木馬1（ED3エルラ）",""],["「い゛いぃいぃぃ！？　おねがいっ、下ろしてぇっ！！」\\nw[女奴隷]",""],["三角木馬2",""],["「ぐひいいぃぃっ！？　ひぎゃあぁっ！！\n　裂けちゃうううぅうぅぅっ！！」\\nw[女奴隷]",""],["拘束1",""],["「おかしいな……なにも…感じないわ……」\\nw[女奴隷]",""],["拘束2",""],["「うぁ……あっ……ああぁ……」\\nw[女奴隷]",""],["拘束3",""],["「ひぎっ、ぐっ……おええぇぇっ……！\n　たす……けて……」\\nw[女奴隷]",""],["貴族",""],["「悶え苦しむ女は美しい。そうは思わんかね？」\\nw[クラブ会員]",""],["男",""],["「ふぅ～、ひと休み、ひと休み。\n　さすがに三連続で出すとキツいなぁ」\\nw[クラブ会員]",""],["床セックス",""],["「うぎぃ！？　む、無理に挿れないでぇ！！」\\nw[女奴隷]",""],["ベッド1",""],["「ぐじゅぶっ、ちゅっぷ……うえぇ、臭い……」\\nw[女奴隷]",""],["ベッド2",""],["「きんもぢい゛いぃ～\\I[29]　あはははっ\\I[29]\n　おクスリもっとちょうだ～い\\I[29]\\I[29]」\\nw[女奴隷]",""],["EV029",""],["EV030",""],["EV031",""],["EV032",""],["EV033",""],["EV034",""],["モブ奴隷（ED4ユマ）",""],["「…………」\\nw[女奴隷]",""],["モブ奴隷（ED4ラーナ）",""],["モブ奴隷（ED4エルラ）",""],["商人（ED4奴隷選び）1",""],["「どの奴隷をヒィヒィ言わせてやろうかな～。\n　あれ？　キミもここのメス奴隷？」\\nw[クラブ会員]",""],["「このクラブだと、普通の娼館じゃ禁止されてるハードな\n　プレイもＯＫだから、ついつい熱が入っちゃうよ」\\nw[クラブ会員]",""],["モブ奴隷（Ev）",""],["エルラEv（ED1・2）",""],["エンディング1",""],["凌辱終了後",""],["「オレたちの恨み、思い知ったか！　ざまぁみろ！！」\\nw[商人Ａ]",""],["「ふうぅ～！　まだまだ犯し足りないけど、今日はこの\n　くらいにしておいてやる！」\\nw[商人Ｂ]",""],["「だがそのうちまた来るぞ。それとお前に復讐したい\n　という人間は他にもいる。せいぜい覚悟しておくことだ」\\nw[商人Ｃ]",""],["「\\N[3]？！　しっかりして！」\\nw[\\N[2]]",""],["「うぁ……あ……ううぅ……。\n　……ユ……\\N[2]？」\\nw[\\N[3]]",""],["「そう、\\N[2]だよ。\n　あなたをここから連れ出すために来たの」\\nw[\\N[2]]",""],["「あ、あぁ……\\N[2]……あんたまで復讐しに……！？\n　こんな場所まで追ってくるなんて……！」\\nw[\\N[3]]",""],["「ち、違うよ！　復讐なんてそんな！\\nw[\\N[2]]",""],["「確かに裏切られてショックだったし、恨みもしたけど、\n　\\N[3]はもう十分に報いを受けたと思う。\\nw[\\N[2]]",""],["「わたしは仕返ししたいなんて思ってないよ。\n　だから安心して。\\nw[\\N[2]]",""],["「あのね、今度わたしと父さんでお店を始めるの。\n　夜はちょっと特殊なバーだけど、昼は普通の喫茶店に\n　する予定で……」\\nw[\\N[2]]",""],["「いったいなんの話を……？」\\nw[\\N[3]]",""],["「でもね、わたしだけじゃ昼の従業員が足りないから、\n　奴隷を一人購入しようと思うんだ。\\nw[\\N[2]]",""],["「ねぇ、わたしと一緒にお店をやってくれない？\n　気心の知れた商売上手な人がそばにいると心強いから」\\nw[\\N[2]]",""],["「\\N[2]、あんた……。\n　あたしはあんたを騙して破滅させたのよ？　なのに……」\\nw[\\N[3]]",""],["「うん。でもやっぱり、友達は見捨てられないから」\\nw[\\N[2]]",""],["「うっ……あぁ……\\N[2]ああぁ……。\n　まだあたしのこと、ともだちって呼んで……うぅ……。\\nw[\\N[3]]",""],["「うああぁあああぁぁんっ！！\n　ご、ごめん……ごめんなさああぁいっ！！」\\nw[\\N[3]]",""],["「ちゃんと謝ってくれたね。じゃあこれで仲直り」\\nw[\\N[2]]",""],["「あ゛っ、あ゛りがどおおぉぅ！　うえええぇぇん！！」\\nw[\\N[3]]",""],["それからさらに、数ヶ月が経ち――。",""],["エンディング2",""],["FocusCamera 18 23 30",""],["王国のどこかにある、会員制の\\C[17]秘密クラブ\\C[0]。",""],["そこでは集められた性奴隷を凌辱する背徳の宴が\n毎日のように開かれていた――。",""],["ResetFocus 150",""],["「んぐああぁああぁぁっ！！　たっ、助けてぇ！\n　お股が裂けちゃうううぅぅっ！！」\\nw[\\N[3]]",""],["「なぁに、そのくらいで裂けはしないさ」\\nw[クラブ会員Ａ]",""],["「そうそう、このくらいで音を上げてるようじゃ\n　次のお仕事なんかショック死しちゃうよ」\\nw[クラブ会員Ｂ]",""],["「次回は確か、ケルベロスと交尾させるんだっけ？\n　人間のイチモツよりずっと太くて長いんだよな」\\nw[クラブ会員Ｃ]",""],["「ひぎいぃっ？！　うっ、嘘でしょっ！？\n　モンスターとなんて！！」\\nw[\\N[3]]",""],["「わははっ！　\\N[3]ちゃんはリアクションが大きいから、\n　つい虐めたくなっちゃうんだよねぇ」\\nw[クラブ会員Ｂ]",""],["「そうそう、壊れずにどこまでいけるか見届けたい\n　もんだよ」\\nw[クラブ会員Ａ]",""],["「大人気だねぇ、\\N[3]ちゃん。\n　この分ならクラブのNo.1奴隷も夢じゃないよ」\\nw[クラブ会員Ｃ]",""],["「いやああぁっ！　誰かぁっ！　助けてえぇっ！！\n　\\N[4]ッ！　あたしを助けなさいよおおぉぉっ！！」\\nw[\\N[3]]",""],["「\\N[4]？　誰を呼んでるんだか知らないけど、\n　ここに助けが来ることはないから諦めなよ」\\nw[クラブ会員Ａ]",""],["「ではそろそろ足に重りをつけて、股間の食い込みを\n　強くしようか？」\\nw[クラブ会員Ｃ]",""],["「ひぎゃああぁああぁぁっ！！\n　なんであたしが奴隷なんかにいいぃぃっ？！！」\\nw[\\N[3]]",""],["エンディングＮｏ．２\n『新たな日常の始まり』",""],["王都に戻してゲーム再開\n↓　　↓　　↓",""],["復讐商人1",""],["復讐商人2",""],["復讐商人3",""],["牢見張り男",""],["「ここに入れられた女は、長くもっても２～３年って\n　ところだな。１年目で壊れちまうヤツも多いぜ」\\nw[牢番]",""],["EV049",""],["EV050",""],["EV051",""],["「きんもぢい゛いぃ\\I[29]　あはははっ\\I[29]\n　おクスリもっとちょうだ～い\\I[29]\\I[29]」\\nw[女奴隷]",""],["EV052",""],["\\N[3]を見つけなければ。",""],["EV053",""],["EV054",""],["クラブ従業員（右）",""],["「お飲み物が必要でしたらお申し付けください。\n　すぐにお持ちいたします」\\nw[従業員]",""],["クラブ従業員",""],["「もうしわけございませんが、この先はご予約が必要な\n　プライベートルームになりますのでご遠慮ください」\\nw[従業員]",""],["EV057",""],["貧民街のボス",""],["クラブ訪問Ev（ED1）",""],["「こ、ここが……！？」\\nw[\\N[2]]",""],["「そうだ、普通の娼館に満足できない金持ちがつくった\n　\\C[17]会員制秘密クラブ\\C[0]だ。\\nw[貧民街のボス]",""],["「お前の持って来た情報が確かなら、探している女は\n　ここにいるだろう」\\nw[貧民街のボス]",""],["「王国内に、こんないかがわしい場所があったなんて……」\\nw[\\N[2]]",""],["「話はつけてあるから、探すなら勝手にしろ。\n　オレはこれで帰るからな」\\nw[貧民街のボス]",""],["「案内していただいて、ありがとうございました」\\nw[\\N[2]]",""],["「礼は不要だ。そのぶんの代価は支払ってもらったからな」\\nw[貧民街のボス]",""],["「よぉし！\n　\\N[3]を見つけて、ここから連れ出してあげよう！」\\nw[\\N[2]]",""],["\\C[17]秘密クラブのどこかにいる\\N[3]を探そう！\\C[0]",""],["エルラ確認Ev",""],["「牢屋……ここに\\N[3]が？\\nw[\\N[2]]",""],["「\\N[3]！　ねぇ、\\N[3]！　どこ！？\n　わたし\\N[2]だよ！　いたら返事をして！」\\nw[\\N[2]]",""],["「いないの……？　でも、そんなはずは……」\\nw[\\N[2]]",""],["「あんたが探してるのって、金髪の生意気なヤツ？」\\nw[女奴隷]",""],["「そ、そうです！　知ってるんですか！？\n　\\N[3]はいまどこに？」\\nw[\\N[2]]",""],["「あはははっ！　ご愁傷様！\n　あいつなら今頃、大変な目に遭ってるでしょうよ！」\\nw[女奴隷]",""],["「えぇっ！？　どういうことですか！？」\\nw[\\N[2]]",""],["「あの娘を恨んでいるっていう男たちが客として来た\n　そうでね、プライベートルームに連れて行かれちゃっ\n　たのさ。\\nw[女奴隷]",""],["「逃げ場のない個室の中で、きっと復讐されてるんじゃ\n　ないかな？　あははっ！」\\nw[女奴隷]",""],["「そんな……\\N[3]……！」\\nw[\\N[2]]",""],["クラブ従業員（左）",""],["「この広間にいない性奴隷ですか？\n　それでしたら、奥の牢かもしれませんね」\\nw[従業員]",""],["ドア",""],["部屋の中でお楽しみ中のようだ。",""],["ユマ",""],["会員（ED4奴隷選び）2",""],["会員（ED4奴隷選び）3",""],["全員性奴隷Ev（ED4）",""],["そして……。",""],["「へぇ！　\\C[27]新人の性奴隷\\C[0]が３人も！\n　しかもみんな可愛いじゃないか！」\\nw[クラブ会員Ｂ]",""],["「３人ともキミが個人で所有している奴隷なのだろう？\n　本当にいいのかね？」\\nw[クラブ会員Ａ]",""],["「ああ、かまわんさ。\n　本人たちが不特定多数に犯されたいと望んでるんだ」\\nw[\\N[1]]",""],["「わ、わたしはそんなこと望んでいません！」\\nw[\\N[5]]",""],["「あたしだって！\n　望んでるのはそこのド変態ネコ娘だけでしょ！」\\nw[\\N[3]]",""],["「えぇ～？　だって二人とも、\\N[1]さんのために\n　立派な性奴隷にならなきゃいけないんだよ？\\nw[\\N[2]]",""],["「だから手っ取り早く性の悦びに目覚められるよう、\n　この場をセッティングしたのに」\\nw[\\N[2]]",""],["「確かにお兄様に従うと約束しましたが、こんな事まで\n　しないとならないなんて……」\\nw[\\N[5]]",""],["「そうよ！　命だけは助けてやるとか言っておいて、\n　やることがコレだなんて！」\\nw[\\N[3]]",""],["「お前ら、自分たちのことを棚に上げて、よくもまあ\n　文句を言えるもんだな」\\nw[\\N[1]]",""],["「なにやら揉めているようだが、三人ともヤッてしまって\n　構わんのか？」\\nw[クラブ会員Ｃ]",""],["「おっと、悪い悪い。\n　思う存分やってくれていいぜ」\\nw[\\N[1]]",""],["「俺一人で全員を相手に快楽を刷り込むのは骨が折れる\n　からな。\\nw[\\N[1]]",""],["「是非とも一緒に、こいつらの穴と脳へチンコの快感を\n　焼き付けてやってくれ」\\nw[\\N[1]]",""],["「ぐへへへっ！！」\\nw[クラブ会員たち]",""],["「ひいいいぃいいぃぃっ？！」\\nw[\\N[5]＆\\N[3]]",""],["「楽しませてもらったけど、猫人の娘以外はまだまだ\n　チンポに溺れるほどではないね」\\nw[クラブ会員Ｂ]",""],["「そうだな。もっと休みを与えずに犯しまくって、\n　セックスのことしか考えられないよう追い込む\n　必要がある」\\nw[クラブ会員Ｃ]",""],["「よし、他のクラブ会員たちの力も借りて、チンポ好きの\n　完璧な性奴隷にしてやろうじゃないか！」\\nw[クラブ会員Ａ]",""],["「頼もしいな。じゃあ皆の力を借りるとするか」\\nw[\\N[1]]",""],["\\>\n\\>　　　　　　　　　それから３日後――。",""],["\\>\n\\>　　　　　　　　　　７日後――。",""],["「おちんちん、大好きぃ～\\I[29]\\I[29]」\\nw[\\N[2]＆\\N[5]＆\\N[3]]",""],["「３人とも、すっかりチンコ狂いのメス奴隷だな！」\\nw[クラブ会員Ａ]",""],["「二穴を同時に犯したくらいでビービー泣いてたのが\n　嘘みたいな変わりっぷりだねぇ」\\nw[クラブ会員Ｂ]",""],["「おまんことお尻、一緒に犯されるの好きぃ\\I[29]\n　お腹がキツキツになって満たされてるって感じがするの\\I[29]」\\nw[\\N[3]]",""],["「お口にも同時に挿れられて、一斉に射精されると\n　なお素晴らしいですね\\I[29]」\\nw[\\N[5]]",""],["「全ての穴でオチンチンの体温を感じられるの、\n　最高だよねぇ～\\I[29]」\\nw[\\N[2]]",""],["「ははっ！　たったの７日でも、やれば出来るものだな。\n　今のこいつらは常に脳みそがピンク色のド淫乱だ」\\nw[クラブ会員Ｃ]",""],["「助かったぜ、皆！　礼を言わせてくれ！\n　お陰で３人とも良い性奴隷に仕上がった！」\\nw[\\N[1]]",""],["「水臭いぜ、穴兄弟！\n　またなにかあれば、いつでも来いよ！」\\nw[クラブ会員Ａ]",""],["「キミたちになら、クラブの門戸はいつでも開いて\n　いるからね！」\\nw[クラブ会員Ｂ]",""],["「ありがとう！　兄弟たち！\n　ありがとう！！」\\nw[\\N[1]]",""],["（……でも、一息ついて冷静になると）\\nw[\\N[5]]",""],["（……なんなの、これ？）\\nw[\\N[3]]",""],["（おかしいのは分かってるけど……）\\nw[\\N[2]]",""],["「まあ、気持ちいいから、どうでもいいや\\I[29]\\I[29]」\\nw[\\N[2]＆\\N[5]＆\\N[3]]",""],["エンディングロール\n↓　　↓　　↓",""],["↑　　↑　　↑\nエンディングロール",""],["エンディングＮｏ．４\n『調教完了！』",""],["会員（ED4奴隷選び）4",""],["会員（ED4奴隷選び）5",""],["会員（ED4奴隷選び）6",""],["会員（ED4奴隷選び）7",""],["会員（ED4奴隷選び）8",""],["会員（ED4奴隷選び）9",""]],"context":[["Map422/events/1/name","Map422/events/2/name","Map422/events/7/name","Map422/events/8/name","Map422/events/11/name","Map422/events/12/name","Map422/events/15/name","Map422/events/16/name"],["Map422/events/3/name","Map422/events/4/name","Map422/events/9/name","Map422/events/10/name","Map422/events/13/name","Map422/events/14/name"],["Map422/events/5/name"],["Map422/events/6/name","Map422/events/40/name","Map422/events/41/name","Map422/events/42/name"],["Map422/events/17/name"],["Map422/events/18/name"],["Map422/events/18/pages/0/list/13/message/noPicture/bottom"],["Map422/events/18/pages/0/list/19/message/noPicture/bottom"],["Map422/events/18/pages/0/list/24/message/noPicture/bottom"],["Map422/events/18/pages/0/list/28/message/noPicture/bottom"],["Map422/events/18/pages/0/list/44/message/noPicture/bottom"],["Map422/events/18/pages/0/list/50/message/noPicture/bottom"],["Map422/events/18/pages/0/list/85/message/noPicture/bottom"],["Map422/events/18/pages/0/list/88/message/noPicture/bottom"],["Map422/events/18/pages/0/list/93/message/noPicture/bottom"],["Map422/events/18/pages/0/list/95/message/noPicture/bottom"],["Map422/events/18/pages/0/list/99/message/noPicture/bottom"],["Map422/events/18/pages/0/list/162/message/noPicture/bottom"],["Map422/eve