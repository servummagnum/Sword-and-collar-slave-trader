02,"headerParam":["",0,0,2]}],[{"headerIndex":310,"headerParam":["",0,0,2]}],[{"headerIndex":317,"headerParam":["",0,0,2]}],[{"headerIndex":322,"headerParam":["",0,0,2]}],[{"headerIndex":326,"headerParam":["",0,0,2]}],[{"headerIndex":332,"headerParam":["",0,0,2]}],[{"headerIndex":336,"headerParam":["",0,0,2]}],[{"headerIndex":343,"headerParam":["",0,0,2]}],[{"headerIndex":345,"headerParam":["",0,0,2]}],[{"headerIndex":351,"headerParam":["",0,0,2]}],[{"headerIndex":357,"headerParam":["",0,0,2]}],[{"headerIndex":365,"headerParam":["",0,0,2]}],[{"headerIndex":370,"headerParam":["",0,0,2]}],[{"headerIndex":372,"headerParam":["",0,0,2]}],[{"headerIndex":379,"headerParam":["",0,0,2]}],[{"headerIndex":383,"headerParam":["",0,0,2]}],[{"headerIndex":388,"headerParam":["",0,0,2]}],[{"headerIndex":395,"headerParam":["",0,0,2]}],[{"headerIndex":400,"headerParam":["",0,0,2]}],[{"headerIndex":404,"headerParam":["",0,0,2]}],[{"headerIndex":412,"headerParam":["",0,0,2]}],[{"headerIndex":417,"headerParam":["",0,0,2]}],[{"headerIndex":420,"headerParam":["",0,0,2]}],[{"headerIndex":422,"headerParam":["",0,0,2]}],[{"headerIndex":425,"headerParam":["",0,0,2]}],[{"headerIndex":428,"headerParam":["",0,0,2]}],[{"headerIndex":435,"headerParam":["",0,0,2]}],[{"headerIndex":440,"headerParam":["",0,0,2]}],[{"headerIndex":443,"headerParam":["",0,0,2]}],[{"headerIndex":450,"headerParam":["",0,0,2]}],[{"headerIndex":452,"headerParam":["",0,0,2]}],[{"headerIndex":457,"headerParam":["",0,0,1]}],[{"headerIndex":469,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098118786796.js","start":0,"end":5,"leftHand":{"type":"","context":[]}}]],"indexIds":{"<fgName:fog01>\n<fgLoopX:10>\n<fgLoopY:10>\n<fgSx:1>\n<fgSy:1>":0,"出入口":1,"createFilter 1 twist 2":2,"setFilter 1 408 312 416 0":3,"moveFilter 1 408 312 816 13 120":4,"eraseFilter 1":5,"clear_all_weathers":6,"ボス戦Ev":7,"「白い……泉？\n　これが学者先生の言ってた『地母神の乳』か」\\nw[\\N[1]]":8,"「白く濁った水だから、乳と呼ばれていたんですね」\\nw[\\N[2]]":9,"「いまさらだが、これ飲んで大丈夫なのか？\n　なんで白濁してるんだよ、怪しすぎるだろ。\\nw[\\N[1]]":10,"「\\N[2]、ちょっと試飲してみないか？」\\nw[\\N[1]]":11,"「えぇ～？　精液なら飲んでもいいですけど、それは\n　怪しいからイヤです」\\nw[\\N[2]]":12,"「絶対イヤです」\\nw[\\N[2]]":13,"「チッ！\n　わかったよ、俺が飲めばいいんだろ」\\nw[\\N[1]]":14,"「あとで\\N[1]さんの白濁液を飲んであげますから、\n　地母神の乳はご自分で頑張ってくださいね\\I[29]」\\nw[\\N[2]]":15,"「なんで不本意そうなんですか？\n　\\N[1]さんに飲ませるのが目的で来たのに」\\nw[\\N[2]]":16,"「分かってるって。\n　それじゃあ地母神ちゃんのミルクを飲ませて\n　もらうとするか。\\nw[\\N[1]]":17,"「…………ん？」\\nw[\\N[1]]":18,"「どうしました？」\\nw[\\N[2]]":19,"「……視線を感じる。なにかいるぞ」\\nw[\\N[1]]":20,"「えっ？！」\\nw[\\N[2]]":21,"ボス戦\n↓　　↓　　↓":22,"shatter_event_id : 5 : 1 : 1 : 1":23,"「危なかったな。\n　いきなりあんなモンスターが出てくるとは」\\nw[\\N[1]]":24,"「ここはあいつの縄張りだったのかもしれませんね」\\nw[\\N[2]]":25,"「泉の守護者ってわけか。\\nw[\\N[1]]":26,"「ではその守護者を倒したところで、改めて泉の水を\n　いただくとしよう」\\nw[\\N[1]]":27,"\\N[1]は\\C[17]『地母神の乳』\\C[0]を飲んだ！":28,"「…………」\\nw[\\N[1]]":29,"「どうですか？\\nw[\\N[2]]":30,"「\\N[6]を一撃で倒せちゃうスーパーパワーが\n　みなぎってきましたか？」\\nw[\\N[2]]":31,"「滅茶苦茶マズい……おえぇ……」\\nw[\\N[1]]":32,"「えぇっ？\n　ちょっ、なに吐いてるんですか！？」\\nw[\\N[2]]":33,"「うぐっ、げぇっ……！\n　そ、そう思うならお前も飲んでもみろ……！\\nw[\\N[1]]":34,"「この耐え難い味は……うぐっ……うぅっ……！？」\\nw[\\N[1]]":35,"「\\N[1]さん！？\n　だいじょうぶですか！？」\\nw[\\N[2]]":36,"「はぁっ、はぁっ……こ、これは……。\\nw[\\N[1]]":37,"「わかる……わかるぞ……！\n　確かに俺の中で力が目覚めた！」\\nw[\\N[1]]":38,"「ほんとですか！？　すごい！」\\nw[\\N[2]]":39,"「攻撃力、防御力、敏捷性……その他諸々の能力が、\n　なんと――」\\nw[\\N[1]]":40,"「なんと！？」\\nw[\\N[2]]":41,"「まったく強化される気配もなく、現状維持だ！」\\nw[\\N[1]]":42,"「…………はい？」\\nw[\\N[2]]":43,"「戦闘能力って点でいえば、特になにも変わらないな」\\nw[\\N[1]]":44,"「だっ、だめじゃないですかああぁッ？！\\nw[\\N[2]]":45,"「力が目覚めたんじゃないんですか！？\n　スーパーパワーはどうしたんですかぁ！？」\\nw[\\N[2]]":46,"「ちょっと落ち着け。\n　そもそもスーパーパワーなんて、お前が勝手に言い出した\n　だけだろ。\\nw[\\N[1]]":47,"「あのな、戦闘能力に変化は無いといったが、なにも成果が\n　なかったわけじゃないんだ」\\nw[\\N[1]]":48,"「へ？」\\nw[\\N[2]]":49,"「この泉の水を飲んだことで、認識できるようになった。\\nw[\\N[1]]":50,"「確かに『竜の鉤爪』は今も、死毒の沼の底で正常に\n　機能してるようだ」\\nw[\\N[1]]":51,"「分かるんですか！？」\\nw[\\N[2]]":52,"「ああ。\n　この分なら、俺の方からも鉤爪の力を利用して\n　\\N[6]に干渉出来そうだ。\\nw[\\N[1]]":53,"「ただ、こっちの意のままに操るってのは無理だな。\n　やっぱり\\N[5]の力が強すぎる」\\nw[\\N[1]]":54,"「そうですか……。\n　流石にそう簡単にはいきませんよね」\\nw[\\N[2]]":55,"「だがうまくすれば、悪竜相手でも勝負になるかもしれん。\n　学者先生の予想通り\\N[5]と\\N[6]の同化は、まだ\n　進行途上のようだしな。\\nw[\\N[1]]":56,"「副都で角や尻尾の生えた\\N[5]の姿を見ただろ？\n　あれは人と竜の肉体が中途半端に同化していることの\n　証だ」\\nw[\\N[1]]":57,"「ほぇ～！\n　そんなことまで分かるようになっちゃったんですかぁ！」\\nw[\\N[2]]":58,"「この泉のおかげでな。\\nw[\\N[1]]":59,"「そしてもう一つ分かったことがある。\\nw[\\N[1]]":60,"「\\N[5]と\\N[6]の肉体が完全に統合されてひとつに\n　なったら、もう付け入る隙はなくなるってことだ。\\nw[\\N[1]]":61,"「\\N[6]に対するコントロール権は、同一人物である\n　\\N[5]の管理下に入っちまうんだ。完璧にな。\\nw[\\N[1]]":62,"「そうなるともう、竜の鉤爪があろうと俺の干渉力じゃ\n　まったく歯が立たなくなっちまう」\\nw[\\N[1]]":63,"「それじゃ、肉体が完全にひとつになる前に戦いを挑む\n　必要があるんですね」\\nw[\\N[2]]":64,"「そうだ。時間的猶予はもうあまりない。\\nw[\\N[1]]":65,"「俺の干渉力が通じるうちに、王都へ行って\\N[6]と\n　決着をつけるぞ！」\\nw[\\N[1]]":66,"メインシナリオ\\C[17]『アルテト対策』\\C[0]を達成した！":67,"\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！":68,"\\>　 ※　『地母神の乳』を飲んだことにより特殊戦技　※\n\\>　 ※　\\C[17]『\\sn[104]』\\C[0]を会得した！　　　　　　　　　※":69,"メインシナリオ\\C[17]『王都最終決戦』\\C[0]を受けた！":70,"回復魔法陣":71,"矢印":72,"ボス（甲殻飛蚊）":73,"ユマ":74,"脱出用魔法陣":75,"ダンジョンの外へ脱出しますか？":76,"脱出する":77,"脱出しない":78,"ライティング":79,"木":80,"EXIT":81,"通行止め":82,"影":83,"宝箱（武器正面開き）":84,"<TE:1>":85,"侵入禁止":86,"敵索敵スタート":87,"最奥部":88},"extension":"json","dataType":"map","filename":"Map331","basename":"Map331.json","path":"data/Map331.json","relPath":"data/Map331.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":89,"percent":0},"cellInfo":[]},"data/Map332.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["魔法陣1",""],["スイッチ2",""],["FocusCamera 22 14 90",""],["ResetFocus 90",""],["魔法陣2",""],["魔法陣3",""],["スイッチ3",""],["FocusCamera 21 20 90",""],["魔法陣4",""],["魔法陣5",""],["像1右",""],["像1左",""],["魔法陣6",""],["魔法陣7",""],["魔法陣8",""],["魔法陣9",""],["像2下",""],["像2上",""],["宝箱（防具正面開き）",""],["<TE:4>",""],["通行禁止",""],["イベントトリガー",""],["姫会話Ev",""],["「おいおい、道が途切れてやがるぞ」\\nw[\\N[1]]",""],["「どこかに渡れるような所は……無さそうですね」\\nw[\\N[2]]",""],["「この脱出路を悪用されて、逆に王宮に攻め込まれない\n　ための安全弁ってところか。\\nw[\\N[1]]",""],["「だが向こうへ渡るための仕掛けは、なにかしらある\n　はずだ。探すぞ」\\nw[\\N[1]]