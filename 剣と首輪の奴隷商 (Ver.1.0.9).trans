[{"headerIndex":77,"headerParam":["↓プレーヤー位置強制中央"]}],null,[{"headerIndex":83,"headerParam":["依頼条件未達成"]}],[{"headerIndex":84,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"attachment":"scriptCommand/16944098098294844.js","start":0,"end":4,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098098298072.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,null,[{"headerIndex":0,"headerParam":["夜間用ＢＧＭ演奏"]}],[{"headerIndex":1,"headerParam":["夜→昼"]}],[{"headerIndex":11,"headerParam":["最初から昼"]}],[{"headerIndex":1,"headerParam":["昼→夜"]}],[{"headerIndex":11,"headerParam":["最初から夜"]}],null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":31,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["disable_footstep"]}],null,null,null,[{"headerIndex":11,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":28,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":30,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"宿屋":1,"EV002":2,"醸造所":3,"EV003":4,"雑貨店":5,"EV004":6,"clear_all_weathers":7,"disable_footsteps":8,"EV005":9,"個別依頼22":10,"娯楽用奴隷":11,"「ここは雪に閉ざされる時間が長すぎて、しかも娯楽って\n　ものがほとんど無いんだ。\\nw[里の男]":12,"「冬のあいだは暇で暇で、ほんとうにウンザリするよ」\\nw[里の男]":13,"「田舎の娯楽っていったら、酒と博打と、あとはベッドで\n　嫁さんとズッコンバッコンやるくらいか？」\\nw[\\N[1]]":14,"「エッチは最高の娯楽ですもんね\\I[29]」\\nw[\\N[2]]":15,"「言い方が下品ですよ！　もうっ！」\\nw[\\N[2]]":16,"「いや、まさにその通りなんだ！\n　だから俺たち里の男は考えた。\\nw[里の男]":17,"「数少ない娯楽であるセックスを、もっと楽しめるように\n　しようと！」\\nw[里の男]":18,"「と、言いますと？」\\nw[\\N[2]]":19,"「はぁ？」\\nw[\\N[2]]":20,"「みんなで相談して、共用の性奴隷を買うことにしたのさ！\\nw[里の男]":21,"「そうすれば未婚でも恋人がいなくても、ズッコンバッコン\n　やり放題だろ！」\\nw[里の男]":22,"「そういうことか、話は分かった。\n　しかしどんな女がいいんだ？」\\nw[\\N[1]]":23,"「\\C[17]エルフ\\C[0]がいい！\n　美人エルフの噂はよく聞くから、みんな一度はヤッて\n　みたいって夢見てるんだ！」\\nw[里の男]":24,"「たしかにエルフって綺麗な人が多いですもんね\\I[29]」\\nw[\\N[2]]":25,"「不美人がいないわけじゃないけどな。\\nw[\\N[1]]":26,"「クソみたいな夢ですね」\\nw[\\N[2]]":27,"「言い方が下品だぞ、\\N[2]。\\nw[\\N[1]]":28,"「それで、エルフって以外に要望はあるか？」\\nw[\\N[1]]":29,"「\\C[17]胸はでかい\\C[0]方がいいな。\n　それと生白い女は見飽きてるんで、ハイエルフよりも\n　\\C[17]ダークエルフ\\C[0]がいい。\\nw[里の男]":30,"「ただ、金はあんまり無いんで……みんなから集めた\n　\\C[17]８０００Ｇ\\C[0]と、この\\C[17]\\in[51]\\C[0]でどうにかならない\n　かな？」\\nw[里の男]":31,"個別依頼『娯楽用奴隷』を受けますか？":32,"受ける":33,"受けない":34,"火の洞窟・地下4層":35,"ダークエルフの森":36,"個別依頼\\C[17]『娯楽用奴隷』\\C[0]を受けた！":37,"\\C[17]『\\in[131]』\\C[0]を依頼者に渡しますか？":38,"渡す":39,"渡さない":40,"依頼条件達成":41,"「欲しがってた巨乳エルフ奴隷、用意してやったぞ」\\nw[\\N[1]]":42,"「すごい！　モノホンのエルフだ！\n　これから毎日、この娘をズッコンバッコンできるなんて\n　夢のようだ！\\nw[里の男]":43,"「ありがとう！　奴隷商人さん！」\\nw[里の男]":44,"個別依頼\\C[17]『娯楽用奴隷』\\C[0]を達成した！":45,"\nここでエッチイベント\n↓　　↓　　↓":46,"↓プレーヤー位置強制中央":47,"SFC_ENABLE_RESERVE":48,"依頼条件未達成":49,"「男たちみんなが期待と股間をふくらませて待ってるんで、\n　巨乳ダークエルフの奴隷お願いしますよ！」\\nw[里の男]":50,"依頼マーク":51,"村人（奴隷買い取り）":52,"奴隷買い取り（フキダシ）":53,"村人":54,"「しまった！\n　このままだと薪が足りなくなるぞ！」\\nw[村人]":55,"「この里の特産品の雪中酒は、一度飲んだらやみつきに\n　なるわよぉ」\\nw[村人]":56,"男の子":57,"「さっき、あっちの方にオオカミがいたんだ！\n　すぐにいなくなっちゃったけど」\\nw[男の子]":58,"「村の特産品を買いたきゃ、そこの雑貨屋に行きな」\\nw[村人]":59,"「あぁっ、もうっ！　冷たい！　寒い！\n　雪なんてダイッキライ！！」\\nw[村娘]":60,"EV015":61,"民家":62,"EV016":63,"ＢＧＭ変更":64,"夜間用ＢＧＭ演奏":65,"夜→昼":66,"最初から昼":67,"昼→夜":68,"最初から夜":69,"屋外トイレドア（排泄Ev）":70,"<TE:80>":71,"トイレマーク":72,"落ちてる精霊石（街）":73,"「雪原の南の方には\\C[17]氷雪の神殿\\C[0]があるけど、村では昔から\n　絶対に近づいてはならないって言われてるんだ。\n　何人もの冒険者が挑んでは、バタバタ死んでるらしい」\\nw[村人]":74,"街ズームアウト":75,"P_D_FILENAME name_town\\V[101]":76,"「あぁ、寒いぃ～。\n　よくこんな場所に人が住んでられますね」\\nw[\\N[2]]":77,"「ただ雪深いだけなら人も集まらんだろうが、ここには\n　この地でしか採れないものや作れないものがあるからな」\\nw[\\N[1]]":78,"「氷雪の里の特産品ですか？」\\nw[\\N[2]]":79,"「ああ、そうだ。\n　あと、意外と奴隷の需要も多いそうだぞ」\\nw[\\N[1]]":80,"通行不可":81,"雪山":82,"フクロウ":83,"disable_footstep":84,"マップ取得":85,"FocusCamera 20 17 120":86,"ZoomOut 2.5 120":87,"\\C[17]\\V[921]の地図\\C[0]を取得した！":88,"ResetZoom 60":89,"ResetFocus 60":90,"weather : 0 : 9 : 20 : 70 : 0 : Snow_01":91,"街中イーグルダイブ":92,"ここから飛び降りますか？":93,"飛び降りる":94,"やめる":95,"通行不可スイッチ":96},"extension":"json","dataType":"map","filename":"Map061","basename":"Map061.json","path":"data/Map061.json","relPath":"data/Map061.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":97,"percent":0},"cellInfo":[]},"data/Map062.json":{"data":[["影",""],["木",""],["通行止め",""],["森へ",""],["抜け道",""],["clear_all_weathers",""],["Ｄエルフ族長",""],["交渉用の\\C[17]ハイエルフ奴隷\\C[0]がいないと、長老と話しても\nムダだ……。",""],["すでにハイエルフの里で交渉済みの場合",""],["\n　　　　～　ダークエルフの族長と交渉中　～",""],["「人間がなにをしに来た？\n　歓迎されるとでも思ったか？」\\nw[ダークエルフ族長]",""],["「まさか。\n　だがどうしても、あんたたちに会わなきゃならん\n　事情があってな。\\nw[\\N[1]]",""],["「ぶっちゃけると、エルフだけが持ってるっていう\n　『精霊性具』とやらが欲しいんだ。\\nw[\\N[1]]",""],["「一つくれないか？\n　いくつ持ってるのか知らないが、一つくらい\n　いいだろ？　な？」\\nw[\\N[1]]",""],["「ちょっとぉ？！\n　そんな雑な交渉、まずいですよぉ！」\\nw[\\N[2]]",""],["「我らエルフの至宝である精霊性具が欲しいだと？\n　痴れ者どもが！」\\nw[ダークエルフ族長]",""],["「至宝なのか、大人のオモチャが……」\\nw[\\N[1]]",""],["「族長！　こんな人間の相手などする必要はない！\n　さっさとブッ殺しましょう！」\\nw[ダークエルフ男]",""],["「そうですよ！\n　見せしめとして、斬り落とした首を森の入り口に\n　吊るしてやりましょう！」\\nw[ダークエルフ女]",""],["「あわわわっ……！」\\nw[\\N[2]]",""],["「まあまあ、そんなに殺気立つなよ。\n　なにもタダでくれと言ってるわけじゃないんだ。\\nw[\\N[1]]",""],["「とりあえず、こいつを見てくれ」\\nw[\\N[1]]",""],["「そやつは、憎きハイエルフではないか！？」\\nw[ダークエルフ族長]",""],["「この奴隷は手土産だ。\n　好きに扱ってくれて構わないぜ」\\nw[\\N[1]]",""],["「ふぅむ……首輪つきのハイエルフを持ってきたその\n　センスは認めてやろう」\\nw[ダークエルフ族長]",""],["（認めるんだ……）\\nw[\\N[2]]",""],["「しかし、そやつ一匹と精霊性具を交換とは、虫の\n　良すぎる話だ。\\nw[ダークエルフ族長]",""],["「精霊性具とは、それほど安いモノではないぞ？」\\nw[ダークエルフ族長]",""],["「なにもこのハイエルフと、物々交換してくれってわけ\n　じゃない。\\nw[\\N[1]]",""],["「こいつは手付け金みたいなものだ。\\nw[\\N[1]]",""],["「精霊性具を一つもらえるなら、今後も継続的に\n　ハイエルフの奴隷を売りにきてやろうじゃないか」\\nw[\\N[1]]",""],["「つまり奴隷売買の契約の証として、精霊性具を渡せと？」\\nw[ダークエルフ族長]",""],["「ああ、その通りだ。\\nw[\\N[1]]",""],["「俺は奴隷が売り捌けるし、あんたらは大嫌いな\n　ハイエルフをこき使える。\\nw[\\N[1]]",""],["「お互いに利のある提案だと思うんだが？」\\nw[\\N[1]]",""],["「ぬぅ……」\\nw[ダークエルフ族長]",""],["「そこの男エルフ！\n　屈辱に顔を歪めるハイエルフの女を犯したくないか！？」\\nw[\\N[1]]",""],["「そ、それは……」\n（めっちゃやりてぇー！）\\nw[ダークエルフ男]",""],["「そっちの女エルフ！\n　ハイエルフのイケメンを全裸にひん剥いて、\n　犬みたいに飼いたくないか！？」\\nw[\\N[1]]",""],["「な、なによそれ……」\n（イケメンを飼うとか……興奮するわ！）\\nw[ダークエルフ女]",""],["「俺をダークエルフの里の御用商人にしてくれれば、\n　ハイエルフを捕まえて奴隷として持ってきてやる。\\nw[\\N[1]]",""],["「さあどうだ、返答を聞かせてくれ」\\nw[\\N[1]]",""],["「ぞ、族長……やっぱりブッ殺すのはやめにしましょう。\n　いえ、別にハイエルフ娘とヤリたいからってわけじゃ\n　ないですけどね」\\nw[ダークエルフ男]",""],["「そ、そうね。\n　考えてみれば、精霊性具ってそんなに貴重でもないし、\n　ひとつくらいあげたって……」\\nw[ダークエルフ女]",""],["「えっ！？\n　至宝じゃなかったんですか、精霊性具！？」\\nw[\\N[2]]",""],["「製法は門外不出の秘伝だが、出来上がった性具自体は\n　特別貴重というわけでもないのだ」\\nw[ダークエルフ族長]",""],["「それなら――」\\nw[\\N[1]]",""],["「………………\\!よかろう。\\nw[ダークエルフ族長]",""],["「不倶戴天の敵であるハイエルフを捕え、奴隷にして\n　売ってくれるというなら、人間のお前とでも取り引き\n　してやろう」\\nw[ダークエルフ族長]",""],["「ただし我々は人間の貨幣を使わん。\n　\\C[17]支払いは精霊石\\C[0]になるぞ？」\\nw[ダークエルフ族長]",""],["「問題ないさ。これで契約成立だな」\\nw[\\N[1]]",""],["（口八丁で話をまとめちゃった……なんなのこの人？\n　すごいんだか、すごくないんだか……）\\nw[\\N[2]]",""],["「では渡す前に、この奴隷を使って精霊性具の持つ力を\n　見せてやろう」\\nw[ダークエルフ族長]",""],["「ひっ……！？\n　い、いやっ！　やめてっ！！」\\nw[ハイエルフ奴隷]",""],["「とくと目に焼き付けるといい。\n　これが精霊性具の力だ！」\\nw[ダークエルフ族長]",""],["「よかろう、お前と取り引きしてやる」\\nw[ダークエルフ族長]",""],["「では渡す前に、ハイエルフの奴隷を使って精霊性具の\n　持つ力を見せてやろう」\\nw[ダークエルフ族長]",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↑　　↑　　↑\nここでエッチイベント\n　",""],["「うわぁ……。\n　見なくていいもの見ちゃった……」\\nw[\\N[2]]",""],["「なかなか面白いじゃないか、精霊性具」\\nw[\\N[1]]",""],["「では先に話した通り、この精霊性具を与えよう。\n　これをもって奴隷売買契約の証とする」\\nw[ダークエルフ族長]",""],["「くれるのはいいが、汁くらい拭き取ってからにして\n　くれよ……」\\nw[\\N[1]]",""],["アイテム\\C[17]『精霊性具』\\C[0]を入手した！",""],["\\>　　※　ダークエルフの里で\\C[17]ハイエルフ奴隷の売買\\C[0]が　※\n\\>　　※　できるようになった！　　　　　　　　　　　※\\<",""],["「色々と大変でしたけど、これであのボスから情報が\n　引き出せますね」\\nw[\\N[2]]",""],["「そうだな。\n　じゃあ王都に戻るとするか」\\nw[\\N[1]]",""],["「森の外へ出るなら、\\C[17]右側奥の抜け道\\C[0]を使うといい。\n　簡単に行き来できるぞ」\\nw[ダークエルフ族長]",""],["「そいつはありがたい。使わせてもらうよ」\\nw[\\N[1]]",""],["ユマ",""],["エルフ1",""],["「ハイエルフの女なんて、どうでもいいんだぜ？\n　興味なんて……まあちょっとくらいは……」\\nw[ダークエルフ男]",""],["エルフ2",""],["「おい、イケメンのハイエルフは連れてきたか？」\\nw[ダークエルフ女]",""],["「里から出る裏道なら、右手の奥の方にあるぞ」\\nw[ダークエルフ女]",""],["ハイエルフ奴隷",""],["トークマーク",""],["エルフ2（門番）",""],["「人間が里でなにをしている？\n　ウロチョロするな！」\\nw[ダークエルフ女]",""],["落ちてる精霊石（街）",""],["エルフ男性",""],["「ハイエルフは大嫌いだね。\n　あいつら、俺たちのことを“闇肌”なんて呼んで見下し\n　てやがるんだ！」\\nw[エルフの男]",""],["「お前がハイエルフの奴隷を連れてくるって？\n　なら、せいぜい可愛がってやるさ」\\nw[エルフの男]",""],["エルフ女性",""],["「弟は人間と戦うと言って、森を飛び出していって\n　しまった。無事だといいんだけど……」\\nw[エルフの女]",""],["「ハイエルフの奴隷を売りにくるって？\n　そんなこと言って、裏じゃダークエルフをあいつらに\n　売りつけてんじゃないだろうね？」\\nw[エルフの女]",""],["「我々エルフは、人間が移住してくるよりはるか昔から\n　この地に根を下ろしているのだ。\n　森も、川も、我々のものなのだ！」\\nw[エルフの男]",""],["「我々とハイエルフの仲が悪い理由？\n　同種同士で争うなど、貴様ら人間もよくやっているでは\n　ないか」\\nw[エルフの男]",""],["「この里に人間が足を踏み入れるなんて、何十年ぶりの\n　ことかしら。\n　あなた、なかなか度胸のある男ね」\\nw[エルフの女]",""],["「ハイエルフの男奴隷……。\n　フフフ……あの白い肌を鞭打ったらどうなるかしら」\\nw[エルフの女]",""],["ウサギ",""],["狐",""],["リス",""],["EXIT",""]],"context":[["Map062/events/1/name","Map062/events/2/name","Map062/events/3/name","Map062/events/4/name","Map062/events/5/name","Map062/events/12/name","Map062/events/27/name","Map062/events/50/name","Map062/events/53/name","Map062/events/54/name","Map062/events/57/name","Map062/events/58/name","Map062/events/59/name"],["Map062/events/6/name","Map062/events/8/name","Map062/events/10/name","Map062/events/13/name","Map062/events/16/name","Map062/events/17/name","Map062/events/19/name","Map062/events/21/name","Map062/events/23/name","Map062/events/25/name","Map062/events/28/name","Map062/events/30/name","Map062/events/32/name","Map062/events/34/name","Map062/events/36/name","Map062/events/38/name","Map062/events/40/name","Map062/events/42/name","Map062/events/44/name","Map062/events/46/name","Map062/events/48/name","Map062/events/51/name","Map062/events/55/name"],["Map062/events/7/name","Map062/events/9/name","Map062/events/11/name","Map062/events/14/name","Map062/events/15/name","Map062/events/18/name","Map062/events/20/name","Map062/events/22/name","Map062/events/24/name","Map062/events/26/name","Map062/events/29/name","Map062/events/31/name","Map062/events/33/name","Map062/events/35/name","Map062/events/37/name","Map062/events/39/name","Map062/events/41/name","Map062/events/43/name","Map062/events/45/name","Map062/events/47/name","Map062/events/49/name","Map062/event