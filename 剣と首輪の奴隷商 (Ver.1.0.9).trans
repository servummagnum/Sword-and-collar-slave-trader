ndex":51,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":65,"headerParam":["",0,0,2]}],[{"headerIndex":69,"headerParam":["",0,0,2]}],[{"headerIndex":75,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":10,"headerParam":["",0,0,1]}],[{"headerIndex":27,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],[{"headerIndex":55,"headerParam":["",0,0,2]}],[{"headerIndex":66,"headerParam":["",0,0,2]}],[{"headerIndex":82,"headerParam":["",0,0,2]}],[{"headerIndex":85,"headerParam":["",0,0,2]}],[{"headerIndex":91,"headerParam":["",0,0,2]}],[{"headerIndex":98,"headerParam":["",0,0,2]}],[{"headerIndex":103,"headerParam":["",0,0,2]}],[{"headerIndex":116,"headerParam":["",0,0,2]}],[{"headerIndex":124,"headerParam":["",0,0,2]}],[{"headerIndex":130,"headerParam":["",0,0,2]}],[{"headerIndex":133,"headerParam":["",0,0,2]}],[{"headerIndex":157,"headerParam":["",0,0,2]}],[{"headerIndex":179,"headerParam":["",0,0,2]}],[{"headerIndex":206,"headerParam":["",0,0,2]}],[{"headerIndex":211,"headerParam":["",0,0,2]}],[{"headerIndex":217,"headerParam":["",0,0,2]}],[{"headerIndex":222,"headerParam":["",0,0,2]}],[{"headerIndex":236,"headerParam":["",0,0,1]}],[{"headerIndex":257,"headerParam":["",0,0,1]}],[{"headerIndex":287,"headerParam":["",0,0,2]}],[{"headerIndex":294,"headerParam":["",0,0,2]}],[{"headerIndex":297,"headerParam":["",0,0,2]}],[{"headerIndex":301,"headerParam":["",0,0,2]}],[{"headerIndex":306,"headerParam":["",0,0,2]}],[{"headerIndex":311,"headerParam":["",0,0,2]}],[{"headerIndex":317,"headerParam":["",0,0,2]}],[{"headerIndex":328,"headerParam":["",0,0,2]}],[{"headerIndex":335,"headerParam":["",0,0,2]}],[{"headerIndex":340,"headerParam":["",0,0,2]}],[{"headerIndex":367,"headerParam":["",0,0,2]}],[{"headerIndex":374,"headerParam":["",0,0,2]}],[{"headerIndex":379,"headerParam":["",0,0,2]}],[{"headerIndex":390,"headerParam":["",0,0,2]}],[{"headerIndex":397,"headerParam":["",0,0,2]}],[{"headerIndex":411,"headerParam":["エンディングロール"]}],[{"headerIndex":415,"headerParam":["↑　　↑　　↑"]}],[{"headerIndex":420,"headerParam":["",0,0,2]}]],"indexIds":{"燭台":0,"光":1,"檻出入り口1":2,"モブ奴隷":3,"EV017":4,"ラーナ（ED3Ev）":5,"「こ、こんなところにわたしを入れて、いったいどうする\n　つもりなんですか？！」\\nw[\\N[5]]":6,"「お前を連れてきたアサシンみたいな旦那からは、\n　徹底的に教育してくれって頼まれたぜ」\\nw[牢番]":7,"「教育？　どういう意味ですか？」\\nw[\\N[5]]":8,"「へへっ、慌てなくったって、どうせすぐに分かるさ」\\nw[牢番]":9,"「お客様が来られた。例の女を連れていくぞ」\\nw[従業員]":10,"「はいよ！　早速だな」\\nw[牢番]":11,"「え……わ、わたし……？」\\nw[\\N[5]]":12,"「そうだ、一緒に来い」\\nw[従業員]":13,"「…………」\\nw[\\N[5]]":14,"（いやな予感しかしないけど、今のわたしは竜の力を\n　封じられてる……ここは従うしかなさそうね）\\nw[\\N[5]]":15,"「行くぞ」\\nw[従業員]":16,"「なっ？！　ここは！？」\\nw[\\N[5]]":17,"FocusCamera 12 24 90":18,"「お前たちのような性奴隷を心ゆくまで嬲るための、\n　\\C[17]会員制秘密クラブ\\C[0]だ。\\nw[従業員]":19,"「娼館では禁止されているハードプレイも、ここでなら\n　好きなだけ楽しめるのさ」\\nw[従業員]":20,"「こ、こんな不品行な場所が王国内にあったなんて……」\\nw[\\N[5]]":21,"「一部の金持ちしか入れない特別なクラブで、性奴隷も\n　厳選した者しか受け入れていないのだが――\\nw[従業員]":22,"「お前の場合は貧民街のボスの仲介があったのでな、\n　少々怪しくはあるが、特例で受け入れたのだ」\\nw[従業員]":23,"ResetFocus 60":24,"「ひぎゃああぁあぁぁっ！！　\n　お股が裂けちゃう゛ううぅううぅぅっ！！」\\nw[\\N[3]]":25,"「\\N[3]？！」\\nw[\\N[5]]":26,"「ひっ、姫様あぁっ！！　たすけてえぇっ！！\n　んぎいいぃっ？！　いやあぁあぁぁっ！！」\\nw[\\N[3]]":27,"「お前と一緒に預けられたこの女は、最低１０年間\n　ここでオモチャにされる契約だ。\\nw[従業員]":28,"「もっとも、壊れずに１年以上つづいた試しはないがな」\\nw[従業員]":29,"「まさか、わたしも\\N[3]と同じ目に遭わされるの！？」\\nw[\\N[5]]":30,"「いいや、お前の契約はまったく違う。\n　うまくいけば短期間でここを出られるかもしれないぞ？」\\nw[従業員]":31,"「ひめさまあ゛ああぁあぁぁっ！！\n　だずげでぐださい゛いいぃぃっ！！」\\nw[\\N[3]]":32,"「悪いけど、今のわたしでは力になれないわ。\n　自分のことは自分でどうにかするのね」\\nw[\\N[5]]":33,"「そっ、そんなああぁあぁっ？！！」\\nw[\\N[3]]":34,"「これは驚いた！　\\N[5]姫にそっくりじゃないか！」\\nw[クラブ会員]":35,"（それはそうよ、本人だもの……。\n　もっとも、わたしは死んだことにされてるから言っても\n　信じないでしょうけど）\\nw[\\N[5]]":36,"「いまからお前は、こちらの会員様にご奉仕するんだ。\\nw[従業員]":37,"「こうした奉仕を重ねていき、お前が\\C[27]真性のメス奴隷\\C[0]に\n　なったと認められれば、あのアサシン風の男のところへ\n　戻れるだろう」\\nw[従業員]":38,"「やっ、やっぱりそういう！\n　あの男、本気でわたしを調教して、使役するつもり\n　なんだわ……！」\\nw[\\N[5]]":39,"「ぐふふふっ！　さあ、これを着るんだ！\n　吾輩からのプレゼントだよ！」\\nw[クラブ会員]":40,"「ドレス……？」\\nw[\\N[5]]":41,"「おおっ、ますます\\N[5]姫らしくなった！\n　まるで瓜二つだ！」\\nw[クラブ会員]":42,"「いまさらこんなドレス……」\\nw[\\N[5]]":43,"「ぐふぅっ！　興奮してきたぞ！\n　吾輩のチンコで\\N[5]姫を犯してやるっ！！」\\nw[クラブ会員]":44,"「ちょ、ちょっと待って！　きゃあああぁぁっ？！」\\nw[\\N[5]]":45,"「んはぁ\\I[29]　はあぁ\\I[29]　おしりぃ\\I[29]\n　こんなに気持ちいいなんてぇ……\\I[29]」\\nw[\\N[5]]":46,"「ぐふふふ！　すっかりアナルセックスの虜だな！\n　\\N[5]姫のモノマネも堂に入っていたし、実に素晴らしい\n　性奴隷だ！\\nw[クラブ会員]":47,"「この娘、買い取りは出来んかね？\n　ぜひ吾輩の手元に置いておきたいのだが」\\nw[クラブ会員]":48,"「申し訳ございません。こちらの奴隷は持ち主から一時的に\n　預かっているだけなので……」\\nw[従業員]":49,"「それは残念だ！」\\nw[クラブ会員]":50,"（客のテクニックがあったとはいえ、この乱れよう。\n　元から淫乱の素質があったようだな）\\nw[従業員]":51,"「この分なら、お前の教育はすぐに済みそうだ。\n　喜べ、ここを出られる日もそう遠くはないぞ」\\nw[従業員]":52,"「ああぁ……そうなんれすかぁ？\n　それよりぃ、もっと気持ち良いこと教えてぇ\\I[29]\\nw[\\N[5]]":53,"「そぉだ～\\I[29]\n　外に出たらお兄様のおちんちんも挿れてもらお～\\I[29]」\\nw[\\N[5]]":54,"エンディングＮｏ．３\n『家族が増えるよ！』":55,"クリアデータをセーブしますか？":56,"セーブする":57,"セーブしない":58,"自宅に戻してゲーム再開\n↓　　↓　　↓":59,"三角木馬1（ED3エルラ）":60,"「い゛いぃいぃぃ！？　おねがいっ、下ろしてぇっ！！」\\nw[女奴隷]":61,"三角木馬2":62,"「ぐひいいぃぃっ！？　ひぎゃあぁっ！！\n　裂けちゃうううぅうぅぅっ！！」\\nw[女奴隷]":63,"拘束1":64,"「おかしいな……なにも…感じないわ……」\\nw[女奴隷]":65,"拘束2":66,"「うぁ……あっ……ああぁ……」\\nw[女奴隷]":67,"拘束3":68,"「ひぎっ、ぐっ……おええぇぇっ……！\n　たす……けて……」\\nw[女奴隷]":69,"貴族":70,"「悶え苦しむ女は美しい。そうは思わんかね？」\\nw[クラブ会員]":71,"男":72,"「ふぅ～、ひと休み、ひと休み。\n　さすがに三連続で出すとキツいなぁ」\\nw[クラブ会員]":73,"床セックス":74,"「うぎぃ！？　む、無理に挿れないでぇ！！」\\nw[女奴隷]":75,"ベッド1":76,"「ぐじゅぶっ、ちゅっぷ……うえぇ、臭い……」\\nw[女奴隷]":77,"ベッド2":78,"「きんもぢい゛いぃ～\\I[29]　あはははっ\\I[29]\n　おクスリもっとちょうだ～い\\I[29]\\I[29]」\\nw[女奴隷]":79,"EV029":80,"EV030":81,"EV031":82,"EV032":83,"EV033":84,"EV034":85,"モブ奴隷（ED4ユマ）":86,"「…………」\\nw[女奴隷]":87,"モブ奴隷（ED4ラーナ）":88,"モブ奴隷（ED4エルラ）":89,"商人（ED4奴隷選び）1":90,"「どの奴隷をヒィヒィ言わせてやろうかな～。\n　あれ？　キミもここのメス奴隷？」\\nw[クラブ会員]":91,"「このクラブだと、普通の娼館じゃ禁止されてるハードな\n　プレイもＯＫだから、ついつい熱が入っちゃうよ」\\nw[クラブ会員]":92,"モブ奴隷（Ev）":93,"エルラEv（ED1・2）":94,"エンディング1":95,"凌辱終了後":96,"「オレたちの恨み、思い知ったか！　ざまぁみろ！！」\\nw[商人Ａ]":97,"「ふうぅ～！　まだまだ犯し足りないけど、今日はこの\n　くらいにしておいてやる！」\\nw[商人Ｂ]":98,"「だがそのうちまた来るぞ。それとお前に復讐したい\n　という人間は他にもいる。せいぜい覚悟しておくことだ」\\nw[商人Ｃ]":99,"「\\N[3]？！　しっかりして！」\\nw[\\N[2]]":100,"「うぁ……あ……ううぅ……。\n　……ユ……\\N[2]？」\\nw[\\N[3]]":101,"「そう、\\N[2]だよ。\n　あなたをここから連れ出すために来たの」\\nw[\\N[2]]":102,"「あ、あぁ……\\N[2]……あんたまで復讐しに……！？\n　こんな場所まで追ってくるなんて……！」\\nw[\\N[3]]":103,"「ち、違うよ！　復讐なんてそんな！\\nw[\\N[2]]":104,"「確かに裏切られてショックだったし、恨みもしたけど、\n　\\N[3]はもう十分に報いを受けたと思う。\\nw[\\N[2]]":105,"「わたしは仕返ししたいなんて思ってないよ。\n　だから安心して。\\nw[\\N[2]]":106,"「あのね、今度わたしと父さんでお店を始めるの。\n　夜はちょっと特殊なバーだけど、昼は普通の喫茶店に\n　する予定で……」\\nw[\\N[2]]":107,"「いったいなんの話を……？」\\nw[\\N[3]]":108,"「でもね、わたしだけじゃ昼の従業員が足りないから、\n　奴隷を一人購入しようと思うんだ。\\nw[\\N[2]]":109,"「ねぇ、わたしと一緒にお店をやってくれない？\n　気心の知れた商売上手な人がそばにいると心強いから」\\nw[\\N[2]]":110,"「\\N[2]、あんた……。\n　あたしはあんたを騙して破滅させたのよ？　なのに……」\\nw[\\N[3]]":111,"「うん。でもやっぱり、友達は見捨てられないから」\\nw[\\N[2]]":112,"「うっ……あぁ……\\N[2]ああぁ……。\n　まだあたしのこと、ともだちって呼んで……うぅ……。\\nw[\\N[3]]":113,"「うああぁあああぁぁんっ！！\n　ご、ごめん……ごめんなさああぁいっ！！」\\nw[\\N[3]]":114,"「ちゃんと謝ってくれたね。じゃあこれで仲直り」\\nw[\\N[2]]":115,"「あ゛っ、あ゛りがどおおぉぅ！　うえええぇぇん！！」\\nw[\\N[3]]":116,"それからさらに、数ヶ月が経ち――。":117,"エンディング2":118,"FocusCamera 18 23 30":119,"王国のどこかにある、会員制の\\C[17]秘密クラブ\\C[0]。":120,"そこでは集められた性奴隷を凌辱する背徳の宴が\n毎日のように開かれていた――。":121,"ResetFocus 150":122,"「んぐああぁああぁぁっ！！　たっ、助けてぇ！\n　お股が裂けちゃうううぅぅっ！！」\\nw[\\N[3]]":123,"「なぁに、そのくらいで裂けはしないさ」\\nw[クラブ会員Ａ]":124,"「そうそう、このくらいで音を上げてるようじゃ\n　次のお仕事なんかショック死しちゃうよ」\\nw[クラブ会員Ｂ]":125,"「次回は確か、ケルベロスと交尾させるんだっけ？\n　人間のイチモツよりずっと太くて長いんだよな」\\nw[クラブ会員Ｃ]":126,"「ひぎいぃっ？！　うっ、嘘でしょっ！？\n　モンスターとなんて！！」\\nw[\\N[3]]":127,"「わははっ！　\\N[3]ちゃんはリアクションが大きいから、\n　つい虐めたくなっちゃうんだよねぇ」\\nw[クラブ会員Ｂ]":128,"「そうそう、壊れずにどこまでいけるか見届けたい\n　もんだよ」\\nw[クラブ会員Ａ]":129,"「大人気だねぇ、\\N[3]ちゃん。\n　この分ならクラブのNo.1奴隷も夢じゃないよ」\\nw[クラブ会員Ｃ]":130,"「いやああぁっ！　誰かぁっ！　助けてえぇっ！！\n　\\N[4]ッ！　あたしを助けなさいよおおぉぉっ！！」\\nw[\\N[3]]":131,"「\\N[4]？　誰を呼んでるんだか知らないけど、\n　ここに助けが来ることはないから諦めなよ」\\nw[クラブ会員Ａ]":132,"「ではそろそろ足に重りをつけて、股間の食い込みを\n　強くしようか？」\\nw[クラブ会員Ｃ]":133,"「ひぎゃああぁああぁぁっ！！\n　なんであたしが奴隷なんかにいいぃぃっ？！！」\\nw[\\N[3]]":134,"エンディングＮｏ．２\n『新たな日常の始まり』":135,"王都に戻してゲーム再開\n↓　　↓　　↓":136,"復讐商人1":137,"復讐商人2":138,"復讐商人3":139,"牢見張り男":140,"「ここに入れられた女は、長くもっても２～３年って\n　ところだな。１年目で壊れちまうヤツも多いぜ」\\nw[牢番]":141,"EV049":142,"EV050":143,"EV051":144,"「きんもぢい゛いぃ\\I[29]　あはははっ\\I[29]\n　おクスリもっとちょうだ～い\\I[29]\\I[29]」\\nw[女奴隷]":145,"EV052":146,"\\N[3]を見つけなければ。":147,"EV053":148,"EV054":149,"クラブ従業員（右）":150,"「お飲み物が必要でしたらお申し付けください。\n　すぐにお持ちいたします」\\nw[従業員]":151,"クラブ従業員":152,"「もうしわけございませんが、この先はご予約が必要な\n　プライベートルームになりますのでご遠慮ください」\\nw[従業員]":153,"EV057":154,"貧民街のボス":155,"クラブ訪問Ev（ED1）":156,"「こ、ここが……！？」\\nw[\\N[2]]":157,"「そうだ、普通の娼館に満足できない金持ちがつくった\n　\\C[17]会員制秘密クラブ\\C[0]だ。\\nw[貧民街のボス]":158,"「お前の持って来た情報が確かなら、探している女は\n　ここにいるだろう」\\nw[貧民街のボス]":159,"「王国内に、こんないかがわしい場所があったなんて……」\\nw[\\N[2]]":160,"「話はつけてあるから、探すなら勝手にしろ。\n　オレはこれで帰るからな」\\nw[貧民街のボス]":161,"「案内していただいて、ありがとうございました」\\nw[\\N[2]]":162,"「礼は不要だ。そのぶんの代価は支払ってもらったからな」\\nw[貧民街のボス]":163,"「よぉし！\n　\\N[3]を見つけて、ここから連れ出してあげよう！」\\nw[\\N[2]]":164,"\\C[17]秘密クラブのどこかにいる\\N[3]を探そう！\\C[0]":165,"エルラ確認Ev":166,"「牢屋……ここに\\N[3]が？\\nw[\\N[2]]":167,"「\\N[3]！　ねぇ、\\N[3]！　どこ！？\n　わたし\\N[2]だよ！　いたら返事をして！」\\nw[\\N[2]]":168,"「いないの……？　でも、そんなはずは……」\\nw[\\N[2]]":169,"「あんたが探してるのって、金髪の生意気なヤツ？」\\nw[女奴隷]":170,"「そ、そうです！　知ってるんですか！？\n　\\N[3]はいまどこに？」\\nw[\\N[2]]":171,"「あはははっ！　ご愁傷様！\n　あいつなら今頃、大変な目に遭ってるでしょうよ！」\\nw[女奴隷]":172,"「えぇっ！？　どういうことですか！？」\\nw[\\N[2]]":173,"「あの娘を恨んでいるっていう男たちが客として来た\n　そうでね、プライベートルームに連れて行かれちゃっ\n　たのさ。\\nw[女奴隷]":174,"「逃げ場のない個室の中で、きっと復讐されてるんじゃ\n　ないかな？　あははっ！」\\nw[女奴隷]":175,"「そんな……\\N[3]……！」\\nw[\\N[2]]":176,"クラブ従業員（左）":177,"「この広間にいない性奴隷ですか？\n　それでしたら、奥の牢かもしれませんね」\\nw[従業員]":178,"ドア":179,"部屋の中でお楽しみ中のようだ。":180,"ユマ":181,"会員（ED4奴隷選び）2":182,"会員（ED4奴隷選び）3":183,"全員性奴隷Ev（ED4）":184,"そして……。":185,"「へぇ！　\\C[27]新人の性奴隷\\C[0]が３人も！\n　しかもみんな可愛いじゃないか！」\\nw[クラブ会員Ｂ]":186,"「３人ともキミが個人で所有している奴隷なのだろう？\n　本当にいいのかね？」\\nw[クラブ会員Ａ]":187,"「ああ、かまわんさ。\n　本人たちが不特定多数に犯されたいと望んでるんだ」\\nw[\\N[1]]":188,"「わ、わたしはそんなこと望んでいません！」\\nw[\\N[5]]":189,"「あたしだって！\n　望んでるのはそこのド変態ネコ娘だけでしょ！」\\nw[\\N[3]]":190,"「えぇ～？　だって二人とも、\\N[1]さんのために\n　立派な性奴隷にならなきゃいけないんだよ？\\nw[\\N[2]]":191,"「だから手っ取り早く性の悦びに目覚められるよう、\n　この場をセッティングしたのに」\\nw[\\N[2]]":192,"「確かにお兄様に従うと約束しましたが、こんな事まで\n　しないとならないなんて……」\\nw[\\N[5]]":193,"「そうよ！　命だけは助けてやるとか言っておいて、\n　やることがコレだなんて！」\\nw[\\N[3]]":194,"「お前ら、自分たちのことを棚に上げて、よくもまあ\n　文句を言えるもんだな」\\nw[\\N[1]]":195,"「なにやら揉めているようだが、三人ともヤッてしまって\n　構わんのか？」\\nw[クラブ会員Ｃ]":196,"「おっと、悪い悪い。\n　思う存分やってくれていいぜ」\\nw[\\N[1]]":197,"「俺一人で全員を相手に快楽を刷り込むのは骨が折れる\n　からな。\\nw[\\N[1]]":198,"「是非とも一緒に、こいつらの穴と脳へチンコの快感を\n　焼き付けてやってくれ」\\nw[\\N[1]]":199,"「ぐへへへっ！！」\\nw[クラブ会員たち]":200,"「ひいいいぃいいぃぃっ？！」\\nw[\\N[5]＆\\N[3]]":201,"「楽しませてもらったけど、猫人の娘以外はまだまだ\n　チンポに溺れるほどではないね」\\nw[クラブ会員Ｂ]":202,"「そうだな。もっと休みを与えずに犯しまくって、\n　セックスのことしか考えられないよう追い込む\n　必要がある」\\nw[クラブ会員Ｃ]":203,"「よし、他のクラブ会員たちの力も借りて、チンポ好きの\n　完璧な性奴隷にしてやろうじゃないか！」\\nw[クラブ会員Ａ]":204,"「頼もしいな。じゃあ皆の力を借りるとするか」\\nw[\\N[1]]":205,"\\>\n\\>　　　　　　　　　それから３日後――。":206,"\\>\n\\>　　　　　　　　　　７日後――。":207,"「おちんちん、大好きぃ～\\I[29]\\I[29]」\\nw[\\N[2]＆\\N[5]＆\\N[3]]":208,"「３人とも、すっかりチンコ狂いのメス奴隷だな！」\\nw[クラブ会員Ａ]":209,"「二穴を同時に犯したくらいでビービー泣いてたのが\n　嘘みたいな変わりっぷりだねぇ」\\nw[クラブ会員Ｂ]":210,"「おまんことお尻、一緒に犯されるの好きぃ\\I[29]\n　お腹がキツキツになって満たされてるって感じがするの\\I[29]」\\nw[\\N[3]]":211,"「お口にも同時に挿れられて、一斉に射精されると\n　なお素晴らしいですね\\I[29]」\\nw[\\N[5]]":212,"「全ての穴でオチンチンの体温を感じられるの、\n　最高だよねぇ～\\I[29]」\\nw[\\N[2]]":213,"「ははっ！　たったの７日でも、やれば出来るものだな。\n　今のこいつらは常に脳みそがピンク色のド淫乱だ」\\nw[クラブ会員Ｃ]":214,"「助かったぜ、皆！　礼を言わせてくれ！\n　お陰で３人とも良い性奴隷に仕上がった！」\\nw[\\N[1]]":215,"「水臭いぜ、穴兄弟！\n　またなにかあれば、いつでも来いよ！」\\nw[クラブ会員Ａ]":216,"「キミたちになら、クラブの門戸はいつでも開いて\n　いるからね！」\\nw[クラブ会員Ｂ]":217,"「ありがとう！　兄弟たち！\n　ありがとう！！」\\nw[\\N[1]]":218,"（……でも、一息ついて冷静になると）\\nw[\\N[5]]":219,"（……なんなの、これ？）\\nw[\\N[3]]":220,"（おかしいのは分かってるけど……）\\nw[\\N[2]]":221,"「まあ、気持ちいいから、どうでもいいや\\I[29]\\I[29]」\\nw[\\N[2]＆\\N[5]＆\\N[3]]":222,"エンディングロール\n↓　　↓　　↓":223,"↑　　↑　　↑\nエンディングロール":224,"エンディングＮｏ．４\n『調教完了！』":225,"会員（ED4奴隷選び）4":226,"会員（ED4奴隷選び）5":227,"会員（ED4奴隷選び）6":228,"会員（ED4奴隷選び）7":229,"会員（ED4奴隷選び）8":230,"会員（ED4奴隷選び）9":231},"extension":"json","dataType":"map","filename":"Map422","basename":"Map422.json","path":"data/Map422.json","relPath":"data/Map422.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":232,"percent":0},"cellInfo":[]},"data/Map423.json":{"data":[["ユマ",""],["エルラ",""],["ユマ父",""],["モブ客",""],["モブ客（チカン）",""],["モブ客（声かけ1）",""],["モブ客（声かけ2）",""],["料理2",""],["エンディングEv",""],["「おーい、\\N[2]ちゃん！　注文たのむ！」\\nw[男性客]",""],["「はぁい！　ただいま！」\\nw[\\N[2]]",""],["「ねぇ！　こっちの料理はまだぁ？」\\nw[女性客]",""],["「はいはい！　ただいまお持ちしますので！」\\nw[\\N[3]]",""],["「３番テーブルの料理できたニャ！」\\nw[\\N[2]の父]",""],["「父さん！　これ２番テーブルの追加オーダー」\\nw[\\N[2]]",""],["「了解ニャ！」\\nw[\\N[2]の父]",""],["「今日もお客さんいっぱいだね。\n　こんなに繁盛するとは思ってなかったよ」\\nw[\\N[2]]",""],["「当然じゃない！　なんたってシーグヌースで１番と２番の\n　美少女が働いてる店なんだから！」\\nw[\\N[3]]",""],["「きゃぁっ！？　お、おしり触られた！？」\\nw[\\N[2]]",""],["「なんですってぇっ？！」\\nw[\\N[3]]",""],["「このチカン野郎！　誰に断ってあたしの\\N[2]に触って\n　んのよ！　キンタマ蹴り潰すわよ！！」\\nw[\\N[3]]",""],["「わっ、悪かった！　つい出来心で！　すまない！\\nw[チカン客]",""],["「お、お代はここに置いとくから、失礼！」\\nw[チカン客]",""],["「フンッ！　まったく！\\nw[\\N[3]]",""],["「大丈夫だった、\\N[2]？　気持ち悪かったでしょ？\n　体洗う？　一緒にお風呂入ろうか？」\\nw[\\N[3]]",""],["「た、大したことないよ。ちょっと撫でられただけだから」\\nw[\\N[2]]",""],["「でも消毒はしておいた方がいいわ。\n　男の汚らわしい手が触れたんだから」\\nw[\\N[3]]",""],["（消毒って……\\N[3]、目が本気だ……）\\nw[\\N[2]]",""],["\\N[3]は以前の振る舞いを反省して、ウチのお店で\n真面目に働いてくれてるけど、色々あったせいで\n重度の男嫌いになってしまいました。\\nw[\\N[2]]",""],["その反動なのか、わたしとの距離はずっと縮まり――\nそろそろ友人の線を越えてきそうで、ちょっと怖いです。\\nw[\\N[2]]",""],["でも……わたしはとても幸せです。\\nw[\\N[2]]",""],["剣も首輪も必要としない、いまこのときが――。\\nw[\\N[2]]",""],["エンディングＮｏ．１\n『別れと赦し』",""],["クリアデータをセーブしますか？",""],["セーブする",""],["セーブしない",""],["王都に戻してゲーム再開\n↓　　↓　　↓",""],["街規模変数：都市＝1、町＝2、村＝3、その他＝4、ダンジョン＝5",""],["料理1",""]],"context":[["Map423/events/1/name"],["Map423/events/2/name"],["Map423/events/3/name"],["Map423/events/4/name","Map423/events/5/name","Map423/events/7/name","Map423/events/8/name","Map423/events/9/name","Map423/events/10/name","Map423/events/11/name","Map423/events/13/name","Map423/events/14/name","Map423/events/15/name","Map423/events/16/name","Map423/events/18/name","Map423/events/19/name","Map423/events/20/name","Map423/events/21/name"],["Map423/events/6/name"],["Map423/events/12/name"],["Map423/events/17/name"],["Map423/events/22/name"],["Map423/events/23/name"],["Map423/events/23/pages/0/list/11/message/noPicture/bottom"],["Map423/events/23/pages/0/list/25/message/noPicture/bottom"],["Map423/events/23/pages/0/list/40/message/noPicture/bottom"],["Map423/events/23/pages/0/list/48/message/noPicture/bottom"],["Map423/events/23/pages/0/list/68/message/noPicture/bottom"],["Map423/events/23/pages/0/list/97/message/noPicture/bottom"],["Map423/events/23/pages/0/list/100/message/noPicture/bottom"],["Map423/events/23/pages/0/list/116/message/noPicture/bottom"],["Map423/events/23/pages/0/list/124/message/noPicture/bottom"],["Map423/events/23/pages/0/list/154/message/noPicture/bottom"],["Map423/events/23/pages/0/list/160/message/noPicture/bottom"],["Map423/events/23/pages/0/list/179/message/noPicture/bottom"],["Map423/events/23/pages/0/list/184/message/noPicture/bottom"],["Map423/events/23/pages/0/list/188/message/noPicture/bottom"],["Map423/events/23/pages/0/list/205/message/noPicture/bottom"],["Map423/events/23/pages/0/list/212/message/noPicture/bottom"],["Map423/events/23/pages/0/list/224/message/noPicture/bottom"],["Map423/events/23/pages/0/list/228/message/noPicture/bottom"],["Map423/events/23/pages/0/list/233/message/noPicture/bottom"],["Map423/events/23/pages/0/list/238/message/noPicture/bottom"],["Map423/events/23/pages/0/list/242/message/noPicture/bottom"],["Map423/events/23/pages/0/list/245/message/noPicture/bottom"],["Map423/events/23/pages/0/list/247/message/noPicture/bottom"],["Map423/events/23/pages/0/list/256/message/noPicture/bottom"],["Map423/events/23/pages/0/list/268/message/noPicture/bottom"],["Map423/events/23/pages/0/list/270/Show Choices/270/1from2"],["Map423/events/23/pages/0/list/270/Show Choices/270/2from2"],["Map423/events/23/pages/0/list/278/comment"],["Map423/events/23/pages/0/list/284/comment"],["Map423/events/24/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["red"],["red"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":11,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],[{"headerIndex":40,"headerParam":["",0,0,2]}],[{"headerIndex":48,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["",0,0,2]}],[{"headerIndex":100,"headerParam":["",0,0,2]}],[{"headerIndex":116,"headerParam":["",0,0,2]}],[{"headerIndex":124,"headerParam":["",0,0,2]}],[{"headerIndex":154,"headerParam":["",0,0,2]}],[{"headerIndex":160,"headerParam":["",0,0,2]}],[{"headerIndex":179,"headerParam":["",0,0,2]}],[{"headerIndex":184,"headerParam":["",0,0,2]}],[{"headerIndex":188,"headerParam":["",0,0,2]}],[{"headerIndex":205,"headerParam":["",0,0,2]}],[{"headerIndex":212,"headerParam":["",0,0,2]}],[{"headerIndex":224,"headerParam":["",0,0,2]}],[{"headerIndex":228,"headerParam":["",0,0,2]}],[{"headerIndex":233,"headerParam":["",0,0,2]}],[{"headerIndex":238,"headerParam":["",0,0,2]}],[{"headerIndex":242,"headerParam":["",0,0,2]}],[{"headerIndex":245,"headerParam":["",0,0,2]}],[{"headerIndex":247,"headerParam":["",0,0,2]}],[{"headerIndex":256,"headerParam":["",0,0,2]}],[{"headerIndex":268,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":278,"headerParam":["王都に戻してゲーム再開"]}],[{"headerIndex":284,"headerParam":["街規模変数：都市＝1、町＝2、村＝3、その他＝4、ダンジョン＝5"]}]],"indexIds":{"ユマ":0,"エルラ":1,"ユマ父":2,"モブ客":3,"モブ客（チカン）":4,"モブ客（声かけ1）":5,"モブ客（声かけ2）":6,"料理2":7,"エンディングEv":8,"「おーい、\\N[2]ちゃん！　注文たのむ！」\\nw[男性客]":9,"「はぁい！　ただいま！」\\nw[\\N[2]]":10,"「ねぇ！　こっちの料理はまだぁ？」\\nw[女性客]":11,"「はいはい！　ただいまお持ちしますので！」\\nw[\\N[3]]":12,"「３番テーブルの料理できたニャ！」\\nw[\\N[2]の父]":13,"「父さん！　これ２番テーブルの追加オーダー」\\nw[\\N[2]]":14,"「了解ニャ！」\\nw[\\N[2]の父]":15,"「今日もお客さんいっぱいだね。\n　こんなに繁盛するとは思ってなかったよ」\\nw[\\N[2]]":16,"「当然じゃない！　なんたってシーグヌースで１番と２番の\n　美少女が働いてる店なんだから！」\\nw[\\N[3]]":17,"「きゃぁっ！？　お、おしり触られた！？」\\nw[\\N[2]]":18,"「なんですってぇっ？！」\\nw[\\N[3]]":19,"「このチカン野郎！　誰に断ってあたしの\\N[2]に触って\n　んのよ！　キンタマ蹴り潰すわよ！！」\\nw[\\N[3]]":20,"「わっ、悪かった！　つい出来心で！　すまない！\\nw[チカン客]":21,"「お、お代はここに置いとくから、失礼！」\\nw[チカン客]":22,"「フンッ！　まったく！\\nw[\\N[3]]":23,"「大丈夫だった、\\N[2]？　気持ち悪かったでしょ？\n　体洗う？　一緒にお風呂入ろうか？」\\nw[\\N[3]]":24,"「た、大したことないよ。ちょっと撫でられただけだから」\\nw[\\N[2]]":25,"「でも消毒はしておいた方がいいわ。\n　男の汚らわしい手が触れたんだから」\\nw[\\N[3]]":26,"（消毒って……\\N[3]、目が本気だ……）\\nw[\\N[2]]":27,"\\N[3]は以前の振る舞いを反省して、ウチのお店で\n真面目に働いてくれてるけど、色々あったせいで\n重度の男嫌いになってしまいました。\\nw[\\N[2]]":28,"その反動なのか、わたしとの距離はずっと縮まり――\nそろそろ友人の線を越えてきそうで、ちょっと怖いです。\\nw[\\N[2]]":29,"でも……わたしはとても幸せです。\\nw[\\N[2]]":30,"剣も首輪も必要としない、いまこのときが――。\\nw[\\N[2]]":31,"エンディングＮｏ．１\n『別れと赦し』":32,"クリアデータをセーブしますか？":33,"セーブする":34,"セーブしない":35,"王都に戻してゲーム再開\n↓　　↓　　↓":36,"街規模変数：都市＝1、町＝2、村＝3、その他＝4、ダンジョン＝5":37,"料理1":38},"extension":"json","dataType":"map","filename":"Map423","basename":"Map423.json","path":"data/Map423.json","relPath":"data/Map423.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":39,"percent":0},"cellInfo":[]},"data/Map424.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["やり手商人",""],["「悪竜による破壊は不景気を呼ぶか……いや、復興特需\n　が起こる可能性もあるな」\\nw[やり手商人]",""],["「商売の世界ってのは、元々が生き馬の目を抜くような\n　競争社会だ。武器商ギルドはその戦いに勝ち抜くため\n　の重要な足がかりなのさ」\\nw[やり手商人]",""],["EV007",""],["光",""],["商人",""],["「あんな小娘が女王だと……！\n　臣下の言いなりになって武器商ギルドを潰そうと\n　しおって！」\\nw[ベテラン商人]",""],["「市民が自衛のための武器を欲している今こそが、まさに\n　商売時というものだ」\\nw[ベテラン商人]",""],["「武器商ギルドのやり方を強引だと責める輩もおるが、\n　それは才覚の無い者のひがみに過ぎんよ」\\nw[ベテラン商人]",""],["仲買人",""],["「本当に\\N[6]が来るなら、商売なんて放り出して王都\n　から避難すべきだろうか……」\\nw[仲買人]",""],["「いまや時代は武器商ギルドのものだよ！\n　キミも商人なら商業ギルドでなくこちらに入るべきだ」\\nw[仲買人]",""],["「武器商ギルドの天下も短かったなぁ……。\n　でもいまさら商業ギルドに戻るわけにもいかないし……」\\nw[仲買人]",""],["「既得権益にあぐらをかいていたのは、商業ギルドじゃ\n　なくて武器商ギルドだったというのか……！？」\\nw[若手商人]",""],["「この“悪竜ショック”による社会不安に乗じて、ギルドの\n　みんなは武器の価格を吊り上げてるけど……それで本当\n　にいいのだろうか……？」\\nw[若手商人]",""],["「既得権益にあぐらをかいている商業ギルドの連中が\n　僕たち武器商ギルドの躍進をねたんで、悪い噂を流して\n　いるんだ！」\\nw[若手商人]",""],["料理1",""],["ガラ悪商人",""],["「悪竜がきて街が混乱すりゃ、窃盗や略奪も増えて出所の\n　怪しい品が流通しやすくなるだろうな。うまい汁が吸える\n　かもしれねぇぜ」\\nw[ガラの悪い商人]",""],["「クククッ！　昔はブイブイいわせた資産家も歳を取ったら\n　ただのボケじじいだ。凡庸な絵画を相場の十倍で売りつけ\n　てやったぜ！」\\nw[ガラの悪い商人]",""],["材木商",""],["「悪竜との戦いが長期化するようなら、軍事拠点の\n　補修や新設で材木の需要が高まるかもしれんな」\\nw[材木商]",""],["「資材運搬には水路が重要だが、この国にはまだまだ整備\n　されていない河川が多いのだ」\\nw[材木商]",""],["「このギルドも随分と寂しくなってしまった……。\n　ツケが回ってきたということか……」\\nw[材木商]",""],["胡散臭い商人",""],["「甦った悪竜、か。そのせいで物流が滞るとしたら……\n　そうだな、いまのうちに買い占めのための資金を用意\n　しておくか……」\\nw[胡散臭い商人]",""],["「邪魔な同業者を潰すうまいやり方を知りたくないか？\n　このギルドに入れば、そういう技術も身につくぜ？」\\nw[胡散臭い商人]",""],["ギルド職員",""],["「武器商ギルドへようこそ！\n　当ギルドのモットーは『信頼と実績と実利』です！」\\nw[ギルド職員]",""],["「武器商ギルドへようこそ！\n　いまならほとんど無条件で会員になれますよ！\n　だから是非！　お願いだから！」\\nw[ギルド職員]",""],["貴金属商",""],["「今みたいに世相と経済が不安定になると、金やミスリルの\n　値段が上がるのよ。安定資産だからね」\\nw[貴金属商]",""],["「勝ち馬に乗る、っていうのは大事よ？\n　ここと商業ギルドと、どっちが有利かは分かるでしょ？」\\nw[貴金属商]",""],["「自分では時勢の見極めが出来ていたつもりだったけど、\n　自惚れだったみたいね……」\\nw[貴金属商]",""],["ギルド幹部",""],["「悪竜が甦ったなら、商売も厳しくなる一方だよ？\n　いまのうちに誰を味方にするべきか、よく考えておいた\n　方がいい」\\nw[ギルド幹部]",""],["「で？　おたくの商会、うちに頼らずにやっていけるの？\n　いい加減、商業ギルドには見切りをつけるべきじゃない\n　かな？」\\nw[ギルド幹部]",""],["「自分のことだけで手一杯なのに、なんでこの上\n　悪竜なんかが甦るんだよ……！」\\nw[落ち目の商人]",""],["「恩も義理もある商業ギルドから、こっちのギルドに\n　乗り換えろというのか？　しかしそうしなければ……\n　くっ、どうしたらいいんだ……」\\nw[落ち目の商人]",""],["奴隷商",""],["「正直、悪竜が甦ったなんて悪質なデマだと思うわ。\n　副都がモンスターに襲われたのは本当でしょうけど」\\nw[奴隷商]",""],["「大司教が背教の疑いで審問にかけられるらしいわ。\n　あの俗物がいなくなると、商売がやりにくくなるのに……」\\nw[奴隷商]",""],["「王都聖堂の大司教は、話の分かる聖職者よ。\n　つまり金と女にだらしない俗物ってこと」\\nw[奴隷商]",""],["エンディング2Ev",""],["政策の転換により、武器商ギルドは前国王から与えられて\nいた数々の特権を剥奪された。",""],["同時にこれまで黙認されてきた、違法な取引や同業者への\n妨害行為が検挙対象となり、ギルド会員が続々と捕縛され\nていき――。",""],["特権と信頼を失った武器商ギルドは、急速にその規模を\n縮小していくこととなった。",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["兵士",""],["初訪問Ev",""],["「ほう、ここが\\C[17]武器商ギルド\\C[0]の本部か」\\nw[\\N[1]]",""],["「勝手に入っちゃっていいんですか？\n　対立する商業ギルドの会員なのに」\\nw[\\N[2]]",""],["「見学くらいはいいだろ？」\\nw[\\N[1]]",""],["「まさか\\N[1]さん、武器商ギルドに乗り換えよう\n　とか考えているんじゃ……？」\\nw[\\N[2]]",""],["「そんなわけあるか！\\nw[\\N[1]]",""],["「あのメスガキが上層部にいるようなギルドだぞ？\n　頼まれたって入るものか！」\\nw[\\N[1]]",""],["「ならいいですけど……」\\nw[\\N[2]]",""],["「心配するなって。本当にちょっと見て回るだけだから」\\nw[\\N[1]]",""],["燭台",""]],"context":[["Map424/events/1/name"],["Map424/events/2/name"],["Map424/events/3/name"],["Map424/events/4/name"],["Map424/events/5/name"],["Map424/events/6/name"],["Map424/events/6/pages/0/list/1/message/noPicture/bottom"],["Map424/events/6/pages/0/list/7/message/noPicture/bottom"],["Map424/events/7/name"],["Map424/events/8/name","Map424/events/34/name","Map424/events/35/name","Map424/events/36/name"],["Map424/events/9/name","Map424/events/11/name","Map424/events/19/name"],["Map424/events/9/pages/0/list/1/message/noPicture/bottom","Map424/events/9/pages/2/list/1/message/noPicture/bottom"],["Map424/events/9/pages/0/list/9/message/noPicture/bottom","Map424/events/9/pages/2/list/9/message/noPicture/bottom"],["Map424/events/9/pages/0/list/15/message/noPicture/bottom","Map424/events/9/pages/2/list/15/message/noPicture/bottom"],["Map424/events/10/name"],["Map424/events/10/pages/0/list/1/message/noPicture/bottom"],["Map424/events/10/pages/0/list/7/message/noPicture/bottom"],["Map424/events/10/pages/1/list/0/message/noPicture/bottom"],["Map424/events/11/pages/0/list/1/message/noPicture/bottom","Map424/events/11/pages/2/list/1/message/noPicture/bottom"],["Map424/events/11/pages/0/list/8/message/noPicture/bottom","Map424/events/11/pages/2/list/8/message/noPicture/bottom"],["Map424/events/11/pages/0/list/15/message/noPicture/bottom","Map424/events/11/pages/2/list/15/message/noPicture/bottom"],["Map424/events/12/name"],["Map424/events/13/name"],["Map424/events/13/pages/0/list/1/message/noPicture/bottom"],["Map424/events/13/pages/0/list/8/message/noPicture/bottom"],["Map424/events/14/name"],["Map424/events/14/pages/0/list/1/message/noPicture/bottom"],["Map424/events/14/pages/0/list/7/message/noPicture/bottom"],["Map424/events/14/pages/1/list/0/message/noPicture/bottom"],["Map424/events/15/name"],["Map424/events/15/pages/0/list/1/message/noPicture/bottom"],["Map424/events/15/pages/0/list/8/message/noPicture/bottom"],["Map424/events/16/name"],["Map424/events/16/pages/0/list/0/message/noPicture/bottom"],["Map424/events/16/pages/2/list/0/message/noPicture/bottom"],["Map424/events/17/name"],["Map424/events/17/pages/0/list/1/message/noPicture/bottom"],["Map424/events/17/pages/0/list/7/message/noPicture/bottom"],["Map424/events/17/pages/1/list/0/message/noPicture/bottom"],["Map424/events/18/name"],["Map424/events/18/pages/0/list/1/message/noPicture/bottom"],["Map424/events/18/pages/0/list/8/message/noPicture/bottom"],["Map424/events/19/pages/0/list/1/message/noPicture/bottom"],["Map424/events/19/pages/0/list/7/message/noPicture/bottom"],["Map424/events/20/name"],["Map424/events/20/pages/0/list/1/message/noPicture/bottom"],["Map424/events/20/pages/0/list/8/message/noPicture/bottom"],["Map424/events/20/pages/0/list/14/message/noPicture/bottom"],["Map424/events/21/name"],["Map424/events/21/pages/0/list/18/message/noPicture/bottom"],["Map424/events/21/pages/0/list/30/message/noPicture/bottom"],["Map424/events/21/pages/0/list/34/message/noPicture/bottom"],["Map424/events/21/pages/0/list/41/comment"],["Map424/events/21/pages/0/list/42/Plugin Command"],["Map424/events/22/name","Map424/events/23/name","Map424/events/24/name","Map424/events/25/name","Map424/events/26/name","Map424/events/27/name","Map424/events/28/name","Map424/events/29/name","Map424/events/30/name"],["Map424/events/31/name"],["Map424/events/31/pages/0/list/15/message/noPicture/bottom"],["Map424/events/31/pages/0/list/19/message/noPicture/bottom"],["Map424/events/31/pages/0/list/25/message/noPicture/bottom"],["Map424/events/31/pages/0/list/31/message/noPicture/bottom"],["Map424/events/31/pages/0/list/36/message/noPicture/bottom"],["Map424/events/31/pages/0/list/38/message/noPicture/bottom"],["Map424/events/31/pages/0/list/45/message/noPicture/bottom"],["Map424/events/31/pages/0/list/49/message/noPicture/bottom"],["Map424/events/32/name","Map424/events/33/name","Map424/events/37/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],null,null,null,["gold"],null,null,null,null,null,null,["gold"],["gold"],null,null,["gold"],null,null,null,["gold"],null,null,["gold"],null,null,["gold"],null,null,null,["gold"],null,null,null,null,["gold"],null,null,null,["gold"],null,null,null,["red"],["blue"],["gold"],["gold"],null,null,null,null,null,null,null,null,["gold"]],"parameters":[null,null,null,null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]},{"headerIndex":9,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]},{"headerIndex":15,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]},{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]},{"headerIndex":15,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],null,[{"headerIndex":18,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":41,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,null,null,[{"headerIndex":15,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":25,"headerParam":["",0,0,2]}],[{"headerIndex":31,"headerParam":["",0,0,2]}],[{"headerIndex":36,"headerParam":["",0,0,2]}],[{"headerIndex":38,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],[{"headerIndex":49,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"やり手商人":5,"「悪竜による破壊は不景気を呼ぶか……いや、復興特需\n　が起こる可能性もあるな」\\nw[やり手商人]":6,"「商売の世界ってのは、元々が生き馬の目を抜くような\n　競争社会だ。武器商ギルドはその戦いに勝ち抜くため\n　の重要な足がかりなのさ」\\nw[やり手商人]":7,"EV007":8,"光":9,"商人":10,"「あんな小娘が女王だと……！\n　臣下の言いなりになって武器商ギルドを潰そうと\n　しおって！」\\nw[ベテラン商人]":11,"「市民が自衛のための武器を欲している今こそが、まさに\n　商売時というものだ」\\nw[ベテラン商人]":12,"「武器商ギルドのやり方を強引だと責める輩もおるが、\n　それは才覚の無い者のひがみに過ぎんよ」\\nw[ベテラン商人]":13,"仲買人":14,"「本当に\\N[6]が来るなら、商売なんて放り出して王都\n　から避難すべきだろうか……」\\nw[仲買人]":15,"「いまや時代は武器商ギルドのものだよ！\n　キミも商人なら商業ギルドでなくこちらに入るべきだ」\\nw[仲買人]":16,"「武器商ギルドの天下も短かったなぁ……。\n　でもいまさら商業ギルドに戻るわけにもいかないし……」\\nw[仲買人]":17,"「既得権益にあぐらをかいていたのは、商業ギルドじゃ\n　なくて武器商ギルドだったというのか……！？」\\nw[若手商人]":18,"「この“悪竜ショック”による社会不安に乗じて、ギルドの\n　みんなは武器の価格を吊り上げてるけど……それで本当\n　にいいのだろうか……？」\\nw[若手商人]":19,"「既得権益にあぐらをかいている商業ギルドの連中が\n　僕たち武器商ギルドの躍進をねたんで、悪い噂を流して\n　いるんだ！」\\nw[若手商人]":20,"料理1":21,"ガラ悪商人":22,"「悪竜がきて街が混乱すりゃ、窃盗や略奪も増えて出所の\n　怪しい品が流通しやすくなるだろうな。うまい汁が吸える\n　かもしれねぇぜ」\\nw[ガラの悪い商人]":23,"「クククッ！　昔はブイブイいわせた資産家も歳を取ったら\n　ただのボケじじいだ。凡庸な絵画を相場の十倍で売りつけ\n　てやったぜ！」\\nw[ガラの悪い商人]":24,"材木商":25,"「悪竜との戦いが長期化するようなら、軍事拠点の\n　補修や新設で材木の需要が高まるかもしれんな」\\nw[材木商]":26,"「資材運搬には水路が重要だが、この国にはまだまだ整備\n　されていない河川が多いのだ」\\nw[材木商]":27,"「このギルドも随分と寂しくなってしまった……。\n　ツケが回ってきたということか……」\\nw[材木商]":28,"胡散臭い商人":29,"「甦った悪竜、か。そのせいで物流が滞るとしたら……\n　そうだな、いまのうちに買い占めのための資金を用意\n　しておくか……」\\nw[胡散臭い商人]":30,"「邪魔な同業者を潰すうまいやり方を知りたくないか？\n　このギルドに入れば、そういう技術も身につくぜ？」\\nw[胡散臭い商人]":31,"ギルド職員":32,"「武器商ギルドへようこそ！\n　当ギルドのモットーは『信頼と実績と実利』です！」\\nw[ギルド職員]":33,"「武器商ギルドへようこそ！\n　いまならほとんど無条件で会員になれますよ！\n　だから是非！　お願いだから！」\\nw[ギルド職員]":34,"貴金属商":35,"「今みたいに世相と経済が不安定になると、金やミスリルの\n　値段が上がるのよ。安定資産だからね」\\nw[貴金属商]":36,"「勝ち馬に乗る、っていうのは大事よ？\n　ここと商業ギルドと、どっちが有利かは分かるでしょ？」\\nw[貴金属商]":37,"「自分では時勢の見極めが出来ていたつもりだったけど、\n　自惚れだったみたいね……」\\nw[貴金属商]":38,"ギルド幹部":39,"「悪竜が甦ったなら、商売も厳しくなる一方だよ？\n　いまのうちに誰を味方にするべきか、よく考えておいた\n　方がいい」\\nw[ギルド幹部]":40,"「で？　おたくの商会、うちに頼らずにやっていけるの？\n　いい加減、商業ギルドには見切りをつけるべきじゃない\n　かな？」\\nw[ギルド幹部]":41,"「自分のことだけで手一杯なのに、なんでこの上\n　悪竜なんかが甦るんだよ……！」\\nw[落ち目の商人]":42,"「恩も義理もある商業ギルドから、こっちのギルドに\n　乗り換えろというのか？　しかしそうしなければ……\n　くっ、どうしたらいいんだ……」\\nw[落ち目の商人]":43,"奴隷商":44,"「正直、悪竜が甦ったなんて悪質なデマだと思うわ。\n　副都がモンスターに襲われたのは本当でしょうけど」\\nw[奴隷商]":45,"「大司教が背教の疑いで審問にかけられるらしいわ。\n　あの俗物がいなくなると、商売がやりにくくなるのに……」\\nw[奴隷商]":46,"「王都聖堂の大司教は、話の分かる聖職者よ。\n　つまり金と女にだらしない俗物ってこと」\\nw[奴隷商]":47,"エンディング2Ev":48,"政策の転換により、武器商ギルドは前国王から与えられて\nいた数々の特権を剥奪された。":49,"同時にこれまで黙認されてきた、違法な取引や同業者への\n妨害行為が検挙対象となり、ギルド会員が続々と捕縛され\nていき――。":50,"特権と信頼を失った武器商ギルドは、急速にその規模を\n縮小していくこととなった。":51,"↓プレーヤー位置強制中央解除":52,"SFC_DISABLE_RESERVE":53,"兵士":54,"初訪問Ev":55,"「ほう、ここが\\C[17]武器商ギルド\\C[0]の本部か」\\nw[\\N[1]]":56,"「勝手に入っちゃっていいんですか？\n　対立する商業ギルドの会員なのに」\\nw[\\N[2]]":57,"「見学くらいはいいだろ？」\\nw[\\N[1]]":58,"「まさか\\N[1]さん、武器商ギルドに乗り換えよう\n　とか考えているんじゃ……？」\\nw[\\N[2]]":59,"「そんなわけあるか！\\nw[\\N[1]]":60,"「あのメスガキが上層部にいるようなギルドだぞ？\n　頼まれたって入るものか！」\\nw[\\N[1]]":61,"「ならいいですけど……」\\nw[\\N[2]]":62,"「心配するなって。本当にちょっと見て回るだけだから」\\nw[\\N[1]]":63,"燭台":64},"extension":"json","dataType":"map","filename":"Map424","basename":"Map424.json","path":"data/Map424.json","relPath":"data/Map424.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":65,"percent":0},"cellInfo":[]},"data/Map425.json":{"data":[["EV001",""],["EV002",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　『奴隷制を維持するための提言』\n\\>\n\\>『……しかしこれは事実なのだ。\n\\>\n\\>　亜人とは総じて人間よりも愚かであり、もし同等に\n\\>　扱えば社会的に混乱が起こることは火を見るより\n\\>　明らかである。\n\\>　\n\\>　それでも亜人に法と秩序を理解させ、教化しようと\n\\>　いうならば、奴隷という形で人間社会に迎え入れる\n\\>　しかない。\n\\>　\n\\>　対等な立場からの融和など、試みるだけ無駄という\n\\>　ものだろう。』",""],["MWL_行数リセット",""],["\\>　　　　　『流通の支配率に関する報告』\n\\>\n\\>『この３年間に、金属、革、木材、煙草などの流通\n\\>　は、その半分以上を武器商ギルドが押さえること\n\\>　に成功した。\n\\>　\n\\>　このように多様な品々を扱うようになったことで、\n\\>　「武器商ギルド」という組織名は実体から乖離して\n\\>　しまったといえよう。\n\\>　新たな名称への刷新も考えるべきである。\n\\>　\n\\>　我々の躍進は、商業ギルドの大きすぎる力を削ろう\n\\>　とする国王陛下の英断によるところが大きいが――』",""],["エルラ",""],["「なんであんたらが武器商ギルドにいるのよ？\n　部外者は出ていって欲しいんだけど？」\\nw[\\N[3]]",""],["「\\N[3]、本当に武器商ギルドへ移っちゃったんだね」\\nw[\\N[2]]",""],["「そう言ったでしょう。\n　あんたの所の商会と違って、ウチは先見の明があるから\n　当然よ！」\\nw[\\N[3]]",""],["「汚い手で同業者を潰しておいて、よく言う。\n　それでギルド幹部だと？\\nw[\\N[1]]",""],["「武器商ギルドは悪人ほど良い地位に就ける組織らしいな」\\nw[\\N[1]]",""],["「フンッ！　何を言おうが負け犬の遠吠えよ！\n　好きなだけワンワン喚いていればいいわ！」\\nw[\\N[3]]",""],["「\\N[3]……」\\nw[\\N[2]]",""],["「シッシッ！\n　部外者は出ていって欲しいんだけど？」\\nw[\\N[3]]",""],["バルコルド",""],["「何をしに来た、痴れ者どもが。\n　お嬢様に危害を加えるつもりなら容赦はせんぞ」\\nw[\\N[4]]",""],["「い、いえっ！　わたしたちそんなつもりじゃ！」\\nw[\\N[2]]",""],["「格好ばかりで立ち居振る舞いが執事らしくないな。\n　本職はなんだ？　傭兵か？　それとも冒険者か？」\\nw[\\N[1]]",""],["「そういうお前こそ、商人などと下手な嘘を。\n　正体は商業ギルドお抱えのアサシンといったところか？」\\nw[\\N[4]]",""],["「俺は正真正銘の商人だッ！！」\\nw[\\N[1]]",""],["「\\N[1]さん……せめてフードを外せば誤解も\n　減るのでは……？」\\nw[\\N[2]]",""],["武器商ギルド総長",""],["初回会話Ev",""],["「ほほぅ、商業ギルドのスパイにしては堂々と入って\n　きたものだな」\\nw[武器商ギルド総長]",""],["「とんでもない！　噂の武器商ギルドがどんなものか、\n　ちょっと見させてもらってるだけさ」\\nw[\\N[1]]",""],["「す、すみません。お邪魔でしたらすぐ出て行きますから」\\nw[\\N[2]]",""],["「なぁに、構わんよ！\\nw[武器商ギルド総長]",""],["「お前たちがどれだけ嗅ぎ回ろうと、\\C[17]我々が不利になる\n　ような証拠\\C[0]など出てくるはずもないからな！」\\nw[武器商ギルド総長]",""],["「その証拠っていうのは、もしかしてこれか？」\\nw[\\N[1]]",""],["「な、なぜそれをお前が！？　ぐぬぬっ！」\\nw[武器商ギルド総長]",""],["「実はいま、ちょーっと路銀が足りてないんだよなぁ！\n　いや、他意はないんだけどなぁ！」\\nw[\\N[1]]",""],["「わ、分かった！　それはこちらで買い取ろう！\n　だから内密に頼む！」\\nw[武器商ギルド総長]",""],["『\\in[58]』\\v[1]冊を\\C[17]\\v[2]Ｇ\\C[0]と交換した！",""],["すべての『\\in[58]』を交換し終えた！",""],["「いや、だからスパイじゃないって言ってるだろ」\\nw[\\N[1]]",""],["「シラを切りおって。……フン、まあいい」\\nw[武器商ギルド総長]",""],["「わたしたち、完全にスパイだと勘違いされちゃった\n　みたいですね……」\\nw[\\N[2]]",""],["（しかし、こうも自信満々なところを見ると、後ろ暗い\n　アレコレに関する証拠は、どこかに隠しているんだ\n　ろうな……）\\nw[\\N[1]]",""],["秘密文書提出Ev",""],["持っている\\C[17]『\\in[58]』\\C[0]を、武器商ギルド総長に\n見せますか？",""],["見せる",""],["見せない",""],["「やあ！　忙しいところ悪いが、俺が偶然見つけたこの\n　\\C[17]『秘密文書』\\C[0]について話をしたいんだが？」\\nw[\\N[1]]",""],["「またか！？　分かった、こちらで買い取る！\n　だから内密に頼む！」\\nw[武器商ギルド総長]",""],["「スパイめ！　不正取引の証拠でも探しているのだろうが、\n　見つかるものか！　我がギルドは清廉潔白だからな！」\\nw[武器商ギルド総長]",""],["「スパイめ！　まだ不正取引の証拠を探しているのか！？\n　無駄だからやめておけ！」\\nw[武器商ギルド総長]",""],["「不正の証拠となる文書は全部買い取ったが……しかし……。\\nw[武器商ギルド総長]",""],["「王の後ろ盾が無くなったせいで、他にもまずいアレコレが\n　どんどん暴露されて……あぁっ、頭が痛い……」\\nw[武器商ギルド総長]",""],["「ふはははっ！　もう証拠となる文書は無いはずだ！\n　ざまぁみろ！\\nw[武器商ギルド総長]",""],["「……って、全部見つかっちゃったのかぁ。\n　そっかぁ……ははは……」\\nw[武器商ギルド総長]",""],["トークマーク",""],["本（秘密文書リスト）",""],["\\>　　　　　『？？？？リスト（持ち出し厳禁）』\n\\>\n\\>『　01：王都ラウディゼル\n\\>　　02：副都パルフューク\n\\>　　03：南都タータミア\n\\>　　04：島の町シーグヌース\n\\>　　05：西グレド村\n\\>　　06：チュワ村\n\\>　　07：氷雪の里コールディ\n\\>　　08：オアシス・サンドボウ\n\\>　　09：四聖教大聖堂\n\\>　　10：鉱山　　　　　　　　　』",""],["\n\\>　※　マップに\\C[17]『秘密文書』の位置\\C[0]が追加されました　※",""],["\\>　　　　　『？？？？リスト（持ち出し厳禁）』\n\\>\n\\>『01：王都ラウディゼル\n\\>　02：副都パルフューク\n\\>　03：南都タータミア\n\\>　04：島の町シーグヌース\n\\>　05：西グレド村\n\\>　06：チュワ村\n\\>　07：氷雪の里コールディ\n\\>　08：オアシス・サンドボウ\n\\>　09：四聖教大聖堂\n\\>　10：鉱山　　　　　　　　　　』",""],["秘密文書",""]],"context":[["Map425/events/1/name"],["Map425/events/2/name"],["Map425/events/3/name","Map425/events/4/name"],["Map425/events/3/pages/0/list/2/Plugin Command","Map425/events/3/pages/1/list/2/Plugin Command","Map425/events/4/pages/0/list/2/Plugin Command","Map425/events/4/pages/1/list/2/Plugin Command","Map425/events/9/pages/0/list/2/Plugin Command","Map425/events/9/pages/1/list/2/Plugin Command"],["Map425/events/3/pages/0/list/3/scrollingMessage","Map425/events/3/pages/1/list/3/scrollingMessage"],["Map425/events/3/pages/0/list/18/Plugin Command","Map425/events/3/pages/1/list/18/Plugin Command","Map425/events/4/pages/0/list/17/Plugin Command","Map425/events/4/pages/1/list/17/Plugin Command","Map425/events/9/pages/0/list/16/Plugin Command","Map425/events/9/pages/1/list/16/Plugin Command"],["Map425/events/4/pages/0/list/3/scrollingMessage","Map425/events/4/pages/1/list/3/scrollingMessage"],["Map425/events/5/name"],["Map425/events/5/pages/0/list/2/message/noPicture/bottom"],["Map425/events/5/pa