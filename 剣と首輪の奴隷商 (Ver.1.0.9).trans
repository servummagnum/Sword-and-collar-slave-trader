m":["↓アイテムの重量を変数に入力する"]}],null,null,null,[{"headerIndex":0,"headerParam":["↓金額おまかせの場合は変数を「0」のままに。"]}],null,[{"headerIndex":0,"headerParam":["※"]}]],"indexIds":{"宝箱（武器正面開き）":0,"<TE:1>":1,"EV002":2,"EV003":3,"EV004":4,"EV005":5,"敵索敵スタート":6,"PSS start":7,"火山の洞窟":8,"障害丸太":9,"EV008":10,"EV009":11,"敵01":12,"<PsensorS:\\V[1166] Rv\\S[22]>":13,"探索範囲にプレイヤー侵入":14,"SmartPath 0 -1":15,"追跡しているプレイヤーと接触":16,"SmartPath 0 cancel":17,"敵に見つかっている場合の戦闘":18,"勝利したとき":19,"PSS t_stop":20,"逃げたとき":21,"戦闘から離脱したときの処理":22,"PSS t_start":23,"敵がプレイヤーを見失ったときの処理":24,"敵02":25,"敵03":26,"敵04":27,"敵05":28,"EV015":29,"移動可能岩":30,"移動終了岩":31,"橋渡し1":32,"橋渡し2":33,"橋渡し3":34,"敵進入禁止":35,"精霊石":36,"宝箱（アイテム）":37,"※\nアイテム：ミスリルインゴット\n※":38,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":39,"↓アイテムのIDNo.を変数に入力する":40,"↓アイテムの入手個数を変数に入力する":41,"↓アイテムの重量を変数に入力する":42,"敵ボス":43,"宝箱（お金左開き）":44,"<TE:18>":45,"↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。":46,"壁ひび":47,"※\nアイテム：精霊石\n※":48},"extension":"json","dataType":"map","filename":"Map321","basename":"Map321.json","path":"data/Map321.json","relPath":"data/Map321.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":49,"percent":0},"cellInfo":[]},"data/Map322.json":{"data":[["EV001",""],["clear_all_weathers",""],["回復魔法陣",""],["EV003",""],["アルテト復活Ev",""],["「どうやらこれが、\\C[17]死毒の沼\\C[0]のようだな」\\nw[\\N[1]]",""],["「ひどい臭い……それにこの煙……」\\nw[\\N[2]]",""],["「吸い込まないよう気をつけろ。\n　どんな害があるか分からんからな」\\nw[\\N[1]]",""],["「こんなに広くて毒々しい沼に竜の鉤爪を捨てれば、\n　二度と拾い上げることなんて出来ないでしょうね」\\nw[\\N[2]]",""],["「ああ。\n　毒水に守られて、鉤爪は二度と人間の手に渡ることは\n　ない……。\\nw[\\N[1]]",""],["「そのはずだ。\n　ああ、そのはずだが……」\\nw[\\N[1]]",""],["「どうかしましたか？\n　早く竜の鉤爪を捨てちゃいましょうよ」\\nw[\\N[2]]",""],["「なにか引っかかるんだよなぁ……」\\nw[\\N[1]]",""],["「なにかって、なにがですか？」\\nw[\\N[2]]",""],["「わからん。\n　ただ喉の奥に魚の小骨が刺さったような、すっきり\n　しない感じがするんだ」\\nw[\\N[1]]",""],["「はぁ？\n　よく分かりませんけど……\\nw[\\N[2]]",""],["「でも、やることに変わりはないですよね？\n　危険を冒してこんな場所まで来たんですから」\\nw[\\N[2]]",""],["「……そうだな。\n　いつまたパルフューク大公の刺客や、メスガキが\n　来るか分かったもんじゃないし――\\nw[\\N[1]]",""],["「この元凶を、とっとと沼に沈めちまおう」\\nw[\\N[1]]",""],["「えっと……これで終わり……で、いいんですよね？」\\nw[\\N[2]]",""],["「そうだ。\n　竜の鉤爪は二つとも死毒の沼の底に沈んだ。\\nw[\\N[1]]",""],["「お姫様の依頼は完了。\n　そんでもって、大公の野望は打ち砕かれた」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『竜の寝床へ』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["「なんと言いますか……最後はあっけなく終わりましたね」\\nw[\\N[2]]",""],["「これまで波乱がありすぎたから、拍子抜けした\n　気分になるな」\\nw[\\N[1]]",""],["「でもこれでやっと、奴隷身分から解放されるんですね！」\\nw[\\N[2]]",""],["「お前が俺の下で働く必要も無くなるわけだ」\\nw[\\N[1]]",""],["「えっ……？\\nw[\\N[2]]",""],["「あっ、そ、そうですよね……」\\nw[\\N[2]]",""],["「まあ、お前にはこれまで十分に働いてもらったからな。\n　元は取れたし、いい買い物だったぜ」\\nw[\\N[1]]",""],["「…………」\\nw[\\N[2]]",""],["「\\N[1]さん……わ、わたし……\n　\\N[1]さんが望むなら、その、これからも――」\\nw[\\N[2]]",""],["\\{「あーはっはっはぁッ！！」\\}\\nw[？？？]",""],["FocusCamera 30 12 120",""],["「また会ったわね！\n　泣き虫\\N[2]にフード野郎！」\\nw[\\N[3]]",""],["「\\N[3]！？　な、なんでここに！？」\\nw[\\N[2]]",""],["「メスガキ！　お前ら、俺たちの後を尾けてきたのか！？」\\nw[\\N[1]]",""],["「はぁ？　なに言ってんの？\n　あたしたちは、あんたらより先にここへ着いてたわよ！」\\nw[\\N[3]]",""],["「なにっ？！」\\nw[\\N[1]]",""],["「なにも知らないマヌケが踊ってる様を見るのは\n　楽しかったわよ！」\\nw[\\N[3]]",""],["「なにを言ってるか分かんないけど……\\N[3]！\n　もう全部終わったんだよ！\\nw[\\N[2]]",""],["「竜の鉤爪は二つとも毒沼の底に沈んで、回収は不可能！\n　\\N[3]が持ってる一つだけじゃ、アルテトを甦らす\n　ことは出来ないんだから！」\\nw[\\N[2]]",""],["「その通り。\n　竜の鉤爪は三つがそろってこそ、力を発揮する\n　マジックアイテムだ」\\nw[\\N[4]]",""],["「だからね、三つとも同じようにしてやるわ！」\\nw[\\N[3]]",""],["「最後の鉤爪を投げ捨てた！？」\\nw[\\N[2]]",""],["「なんのつもりだメスガキ！？」\\nw[\\N[1]]",""],["「まだ分からないの？\n　全部、あの方の書いたシナリオ通りだったって\n　ことよ！」\\nw[\\N[3]]",""],["「え？　あの方ってパルフューク大公でしょ？\n　それがなんで計画通りだなんて――」\\nw[\\N[2]]",""],["「ちがうぞ\\N[2]！\n　くそっ、そういうことか！　まんまと騙されたぜ……！」\\nw[\\N[1]]",""],["「ようやく気付いたか、アサシン。\n　我々が誰に仕えているか。\\nw[\\N[4]]",""],["「お前たちが誰の指図でここまでやって来たか」\\nw[\\N[4]]",""],["「ちょ、ちょっと待って……え、それってまさか……」\\nw[\\N[2]]",""],["「悪竜が封印されたこの毒沼に、竜の鉤爪が三つとも\n　そろった！\\nw[\\N[3]]",""],["「いよいよ目覚めの刻よ！」\\nw[\\N[3]]",""],["「あはっ！　あはははははっ！！\n　甦った！　ついに甦ったわッ！！\\nw[\\N[3]]",""],["「伝説の古代竜\\C[17]アルテト\\C[0]よ！！」\\nw[\\N[3]]",""],["「なっ、なんと凄まじい……！\n　これほどの怪物とは！」\\nw[\\N[4]]",""],["「ひっ、あっ……あわわわわわっ……！\n　％＃＄＆＝￥＊〒＆＄ッ？！」\\nw[\\N[2]]",""],["「おいっ、落ち着け！　ゆっくり呼吸しろ！\n　いいか、あんなモンただのデカいトカゲだ！」\\nw[\\N[1]]",""],["「そそそっ、そんなわけないでしょう！？\n　あの伝説の悪竜アルテトなんですよぉッ！！」\\nw[\\N[2]]",""],["「見なさい！　\\N[2]！　フード野郎！\\nw[\\N[3]]",""],["「あんたたちには散々邪魔されたけど、最後に勝ったのは\n　やっぱりこのあたしよ！\\nw[\\N[3]]",""],["「というわけで早速だけど、あんたたちにはアルテトの餌に\n　なってもらうわ！\\nw[\\N[3]]",""],["「伝説の竜に食べてもらえるなんてステキでしょ？\n　あーはっはっはっ！\\nw[\\N[3]]",""],["「このクソメスガキがっ……！」\\nw[\\N[1]]",""],["「さあアルテトよ！\n　そいつらを食い殺しておしまい！」\\nw[\\N[3]]",""],["「……あ、あれ？\n　アルテト？　ちょっとアルテト！」\\nw[\\N[3]]",""],["「お嬢様、大変申し上げにくいのですが、\n　アルテトを使役できるのはあの方だけのはずでは？」\\nw[\\N[4]]",""],["「ハッ？！　そ、そうだったわ！\n　つい勢いで命じちゃったけど……」\\nw[\\N[3]]",""],["「おいっ、ちょっと待て！\n　お前がアルテトを操れないって、それじゃこのデカブツ、\n　ここからどうなるんだ！？」\\nw[\\N[1]]",""],["「ま、まさか野放しになって、勝手に暴れるんじゃ？！」\\nw[\\N[2]]",""],["「そ、そんなことないわよ！\n　……ないわよね？　\\N[4]？」\\nw[\\N[3]]",""],["「い、いえ……あの方から命じられたのは鉤爪を沼に\n　捨てることだけで、ここから先どうなるかは私にも\n　分かりかねます」\\nw[\\N[4]]",""],["「えっ……それ、ちょっと……ま、まずくない？」\\nw[\\N[3]]",""],["「うあぁあああぁっ？！」\\nw[\\N[2]]",""],["「どどっ、どうしよう！？\n　\\N[4]！　なんとかして！」\\nw[\\N[3]]",""],["「そ、そう言われましても……私ごときでは如何とも\n　しがたく……」\\nw[\\N[4]]",""],["「あのアホども……！\n　自分でやっといて収拾つける算段もないのかよ！」\\nw[\\N[1]]",""],["「ひっ、ひいいいぃぃっ！！」\\nw[\\N[3]]",""],["「大丈夫ですよ。\\N[6]はわたしが御します」\\nw[？？？]",""],["「\\N[5]姫！？」\\nw[\\N[2]]",""],["「ひ、姫様！？　どうしてここに！？\n　王都でお待ちいただいてたはずじゃ！？」\\nw[\\N[3]]",""],["「どうしてって、アルテトが甦ったのだから\n　わたしが来るのは当然でしょう？」\\nw[\\N[5]]",""],["「\\N[3]、今度はうまくやってくれたようですね？\n　これで竜の鉤爪を奪われた件は、不問に付しましょう」\\nw[\\N[5]]",""],["「はっ、はいぃっ！　ありがとうございます！」\\nw[\\N[3]]",""],["「そして\\N[1]殿。\n　あなた方もご苦労様でした」\\nw[\\N[5]]",""],["「やってくれたな、お姫様。\n　すっかり騙されたぜ。\\nw[\\N[1]]",""],["「敵である俺たちを、まんまと鉤爪の運び屋に\n　仕立て上げるとはな……！\\nw[\\N[1]]",""],["「だが何故だ？\\nw[\\N[1]]",""],["「お前にはアルテトなんて物騒なモノを使わなきゃ\n　ならない動機は無いはずだ」\\nw[\\N[1]]",""],["「それは、これから死にゆくあなたに話しても\n　仕方のないことでは？」\\nw[\\N[5]]",""],["「やっ、やっぱり、なにがどう転んでも、\n　わたしたち始末されちゃうんですかぁっ！？」\\nw[\\N[2]]",""],["「ええ、そうです。\n　申し訳ありませんが、ここでお亡くなりになって\n　くださいね\\I[29]」\\nw[\\N[5]]",""],["「この腹黒姫がっ！\\nw[\\N[1]]",""],["「\\N[2]っ！　逃げるぞ！」\\nw[\\N[1]]",""],["「逃がすわけがないでしょう？」\\nw[\\N[5]]",""],["FocusCamera 18 14 60",""],["対アルテト戦闘\n↓　　↓　　↓",""],["↑　　↑　　↑\n対アルテト戦闘",""],["「いまだ！　撤退するぞ！\n　全力で走れぇ！！」\\nw[\\N[1]]",""],["「はいぃっ！！」\\nw[\\N[2]]",""],["FocusCamera 24 12 60",""],["「あいつら、まさかアルテトの攻撃をしのいで\n　逃げるなんてッ！」\\nw[\\N[3]]",""],["「すぐに追撃を――」\\nw[\\N[4]]",""],["「かまわないわ、放っておきなさい。\\nw[\\N[5]]",""],["「あのような小物、逃げおおせたところでどうという\n　こともありませんから。\\nw[\\N[5]]",""],["「それより、今後のことです。\\nw[\\N[5]]",""],["「これよりわたしは、“反逆者パルフューク大公”のいる\n　副都を攻撃してきます。\\nw[\\N[5]]",""],["「あなたたちは王都に戻り、計画を次の段階へ進めて\n　おきなさい」\\nw[\\N[5]]",""],["「かしこまりました！\n　これでいよいよ、姫様――いえ、女王陛下の天下\n　ですね！」\\nw[\\N[3]]",""],["「気が早いですよ、\\N[3]。\n　さあ、お行きなさい」\\nw[\\N[5]]",""],["「それではまた、後ほど」\\nw[\\N[3]]",""],["「失礼いたします」\\nw[\\N[4]]",""],["（なぜあの二人を殺しきれなかったの……？\n　動きが鈍くなった……いえ、鈍くさせられた？）\\nw[\\N[5]]",""],["（まさか……いいえ、そんなはずはない……。\n　きっと封印が解けたばかりで、本調子でなかっただけ）\\nw[\\N[5]]",""],["「そうよね……“わたし”は何ひとつ変わりない。\n　今も、昔も――」\\nw[\\N[5]]",""],["ResetFocus 20",""],["ユマ",""],["煙",""],["波紋",""],["投擲用光",""],["エルラ",""],["バルコルド",""],["波紋2",""],["雷落下地点",""],["雷落下地点2",""],["雷落下地点3",""],["雷落下地点4",""],["アルテト",""],["ラーナ",""],["アルテト回想Ev",""],["「度重なる戦いで疲れ、隙が生じたアルテトに、\n　『竜の鉤爪』が使われたのです。\\nw[\\N[5]]",""],["「封印の力は強く、抗えぬものでした。\\nw[\\N[5]]",""],["「しかし封じられるその間際、アルテトはすべての力を\n　振り絞って、リジェルダにひとつの\\C[17]『呪い』\\C[0]を\n　かけました。\\nw[\\N[5]]",""],["「\\C[17]己の魂の一部\\C[0]を呪詛の矢として放ち、リジェルダの\n　魂に突き立て、その命を縮めんとしたのです。\\nw[\\N[5]]",""],["「アルテトを封じることに成功したリジェルダでしたが、\n　この呪いによって自身の寿命は半減。\\nw[\\N[5]]",""],["「さらにその子孫たちにも影響は及び、王族は短命な\n　者が多くなってしまいました」\\nw[\\N[5]]",""],["eraseFilter 1",""],["回想人物1",""],["回想人物2",""],["アルテト（回想用）",""],["脱出用魔法陣（寝床クリア後）",""],["ダンジョンの外へ脱出しますか？",""],["脱出する",""],["脱出しない",""],["createFilter 1 twist 2",""],["setFilter 1 408 312 416 0",""],["moveFilter 1 408 312 816 13 120",""],["EXIT（鉤爪クリア直後）",""],["敵索敵スタート",""],["死毒の沼",""],["weather : 0 : 32 : 2 : 40 : 0 : Fog_01bp",""]],"context":[["Map322/events/1/name"],["Map322/events/1/pages/0/list/4/Plugin Command","Map322/events/3/pages/0/list/4/Plugin Command","Map322/events/4/pages/1/list/961/Plugin Command"],["Map322/events/2/name"],["Map322/events/3/name"],["Map322/events/4/name"],["Map322/events/4/pages