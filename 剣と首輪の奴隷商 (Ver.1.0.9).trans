length":38,"percent":0},"cellInfo":[]},"data/Map213.json":{"data":[["EV001",""],["敵追跡の停止",""],["SmartPath 10 cancel",""],["SmartPath 11 cancel",""],["SmartPath 12 cancel",""],["SmartPath 13 cancel",""],["PSS stop",""],["PSS reset C",""],["↓敵全部倒したかチェック",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["敵索敵スタート",""],["PSS start",""],["イージー",""],["ノーマル",""],["EV007",""],["EV008",""],["EV009",""],["敵01",""],["<PsensorS:\\V[1166] Rv\\S[22]>",""],["探索範囲にプレイヤー侵入",""],["SmartPath 0 -1",""],["追跡しているプレイヤーと接触",""],["SmartPath 0 cancel",""],["敵に見つかっている場合の戦闘",""],["勝利したとき",""],["PSS t_stop",""],["逃げたとき",""],["戦闘から離脱したときの処理",""],["PSS t_start",""],["敵がプレイヤーを見失ったときの処理",""],["敵02",""],["敵03",""],["敵04",""],["坑夫",""],["「♪おいらは穴掘りエンヤコラ～\n　　鉱石、宝石、がっぽりさ～」\\nw[坑夫]",""],["「モンスターのせいで仕事が止まってたぶん、\n　取り戻さないとな。忙しい忙しい。」\\nw[坑夫]",""],["壁ひび",""],["※\nアイテム：精霊石\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["宝箱",""],["※\nアイテム：ツルハシ\n※",""],["※\nアイテム：万能薬",""],["「トロッコの手入れも大事な仕事なのさ」\\nw[坑夫]",""],["EV020",""],["「モンスターのせいで休めてたけど、また苦役が\n　始まっちまった……つらい」\\nw[鉱山奴隷]",""],["土",""],["EV024",""],["EV025",""],["EV026",""],["EV027",""],["EV028",""],["「きつい……休みたい……」\\nw[鉱山奴隷]",""],["EV030",""],["EV031",""],["EV032",""],["EV033",""],["「くそっ、こき使いやがって……！」\\nw[鉱山奴隷]",""],["「ずっとモンスターがいれば良かったのに！\n　いや……そしたら別の仕事に回されるだけか……」\\nw[鉱山奴隷]",""],["「ヤマニモドリタイ……。\n　ココモ、ヤマダケド」\\nw[鉱山奴隷]",""],["駆除終了Ev",""],["\\>　　\\C[17]※　坑道内のすべてのモンスターを倒した！　※\n\\>　　※　報告しに鉱山監督官のところへ行こう　　※\\C[0]",""],["宝箱（防具正面開き）",""],["<TE:4>",""],["盗賊",""],["「チッ！　人が来やがったか。\n　モンスター騒動が続いてるうちに、金目の物をいただ\n　いていくつもりだったのに！」\\nw[盗賊]",""],["「へぇ、こんな場所に盗賊がいるとは。\n　抜け目のないヤツだ」\\nw[\\N[1]]",""],["「ど、どうしましょう！？\n　盗賊退治は頼まれてませんけど……」\\nw[\\N[2]]",""],["「どうもこうもあるか。\n　わざわざ奴隷志願者が現れてくれたんだ。狩るぞ！」\\nw[\\N[1]]",""],["「ふざけたことを！\n　返り討ちにしてやる！」\\nw[盗賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["※\nアイテム：精霊石",""],["回復魔法陣",""],["盗賊表示",""],[