aram":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]},{"headerIndex":22,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":54,"headerParam":["",0,0,2]},{"headerIndex":42,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":9,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":8,"headerParam":["",0,0,2]}],[{"headerIndex":11,"headerParam":["",0,0,2]}],[{"headerIndex":17,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,[{"headerIndex":10,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,null,[{"headerIndex":75,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["↓【Ver.1.0.5追加】道具箱を一度も開けずに自宅を購入していくと保管上限数が増えない"]}],null,[{"headerIndex":48,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["↓【Ver.1.0.7追加】最初に闘技場でビキニ鎧を入手すると、2番目のビキニ鎧からの"]}]],"indexIds":{"EV001":0,"↓道具箱補正用の変数・スイッチ処理":1,"EV002":2,"道具箱":3,"火":4,"光":5,"ユマ（プロローグ実行）":6,"「ここが俺の家だ。\\nw[\\N[1]]":7,"「……と言っても、一年のほとんどは荷馬車に乗っての\n　旅暮らしで、留守にしてるんだがな」\\nw[\\N[1]]":8,"「えっと、その……あなたは……？」\\nw[\\N[2]]":9,"「俺は\\N[1]。\n　見ての通りの――」\\nw[\\N[1]]":10,"「アサシン……？」\\nw[\\N[2]]":11,"「商人だ！！\n　どこからどう見ても商人だろうが！」\\nw[\\N[1]]":12,"「ええっ！？　商人なんですか？」\\nw[\\N[2]]":13,"（全然そうは見えないんだけど……）\\nw[\\N[2]]":14,"「まったく、どいつもこいつも！\n　……まあいい、話をつづけるぞ」\\nw[\\N[1]]":15,"「俺はお前を“商品”として仕入れた。\n　これが\\C[17]奴隷商\\C[0]としての、俺の初仕事ってわけだ」\\nw[\\N[1]]":16,"「それじゃわたし、ここから更に転売されるんですね……」\\nw[\\N[2]]":17,"「ああ、その予定だ。\\nw[\\N[1]]":18,"「王都あたりの高級娼館に売り込むか、それとも\n　処女好きの変態金持ちでも探すか――」\\nw[\\N[1]]":19,"「まっ、まままっ、待ってください！\\nw[\\N[2]]":20,"「なんかエッチ方面に限定して考えてますけど、\n　わたし、もっと別の方向性でもお役に立てますよ！？」\\nw[\\N[2]]":21,"「と言うと？」\\nw[\\N[1]]":22,"「実はわたし、\\C[17]商家の娘\\C[0]なんです！\n　ですから、読み書きソロバンもちゃんとできます！\\nw[\\N[2]]":23,"「おそばに置いていただければ、きっとあなたの商売の\n　お役に立ちますよ？\\nw[\\N[2]]":24,"「……だから、娼館とか変態に売るのだけは\n　どうかご勘弁を……」\\nw[\\N[2]]":25,"「へぇ、商家の出か。\n　たしかにそれなら、商売の手伝いもできるか。\\nw[\\N[1]]":26,"「俺の助手兼愛人として手元に置いておくってのもアリ\n　かもな」\\nw[\\N[1]]":27,"「えっ！？　愛人！？」\\nw[\\N[2]]":28,"「どうした、なにか不満か？」\\nw[\\N[1]]":29,"「い、いえ！　別に！」\\nw[\\N[2]]":30,"（愛人ってことは、この人とそういうことするって\n　ことだよね……？）\\nw[\\N[2]]":31,"「となると、あとは……。\n　おまえ、武器は扱えるか？」\\nw[\\N[1]]":32,"「え、武器ですか？\n　一応……護身程度でしたら。\\nw[\\N[2]]":33,"「でも、なんでそんなことを？」\\nw[\\N[2]]":34,"「そりゃあ、武器も使えないまま\\C[17]奴隷狩り\\C[0]に行くなんて\n　自殺行為だからな」\\nw[\\N[1]]":35,"「どっ、奴隷狩り！？」\\nw[\\N[2]]":36,"「ま、まさか……\\C[17]\\!自分で、\\!力ずくで、\\!奴隷を集める\\C[0]つもり\n　なんですか！？」\\nw[\\N[2]]":37,"「ああ、そうだ。\n　盗賊や危険な亜人なんかは、捕まえれば合法的に\n　奴隷にできるからな。\\nw[\\N[1]]":38,"「普通は冒険者や兵隊から仕入れるんだろうが、\n　自分で捕まえれば、そのぶん儲けも増えてウハウハだ！」\\nw[\\N[1]]":39,"「そんな……無茶苦茶な……！」\\nw[\\N[2]]":40,"「イヤなら別にいいぞ？\\nw[\\N[1]]":41,"「そのかわり変態孕ませおじさんに、毎日“んほおおぉっ！”\n　とか言わされる生活が待ってるだけだ」\\nw[\\N[1]]":42,"「よ……よろこんで、奴隷狩りのお手伝いを……\n　させていただきますぅ……」\\nw[\\N[2]]":43,"「よし決まりだな！\n　それじゃまずは、情報収集からだ」\\nw[\\N[1]]":44,"「情報……ですか？」\\nw[\\N[2]]":45,"「そうだ。\n　奴隷にできる盗賊や亜人なんて、闇雲に探してもそうそう\n　見つかるもんじゃない。\\nw[\\N[1]]":46,"「だから\\C[17]目撃情報が多い場所\\C[0]を選んで探す。\\nw[\\N[1]]":47,"「その目撃情報の集まるところが、俺も所属している\n　\\C[17]商業ギルド\\C[0]だ」\\nw[\\N[1]]":48,"「あっ、商業ギルド！\n　知ってます！　わたしの父も加入してました」\\nw[\\N[2]]":49,"「この国の商人の半数近くが加入してる大所帯のギルド\n　だからな。集まる情報も膨大だ。\\nw[\\N[1]]":50,"「というわけで、早速ギルドに行くぞ」\\nw[\\N[1]]":51,"「この町――ラノティカの商業ギルド支部って、どこに\n　あるんですか？」\\nw[\\N[2]]":52,"「お前が処女膜の一般公開をやってた広場、あそこの\n　そばに建ってるぞ。行けばすぐわかる」\\nw[\\N[1]]":53,"「い、一般公開って……！！\n　嫌なこと思い出させないでください！！」\\nw[\\N[2]]":54,"「いいから行くぞ。\n　さあっ、俺の輝かしき奴隷商ライフの始まりだ！」\\nw[\\N[1]]":55,"「…………」\\nw[\\N[2]]":56,"自宅":57,"\n↓オープニングタイトル表示\n　\n　":58,"最初に\\C[17]商業ギルド\\C[0]へ向かいましょう！\nギルドは町の中心の\\C[17]広場前\\C[0]に建っています。":59,"※注意※\n現在テストプレイ用の設定になっています。":60,"睡眠処理":61,"チェック":62,"説明書":63,"説明書矢印":64,"ユマの普段着":65,"奴隷服のとき":66,"「そういや、行商で売れ残った\\C[17]女性物の服\\C[0]があったっけな。\n　\\N[2]、いるか？」\\nw[\\N[1]]":67,"「いります！　ください！\\nw[\\N[2]]":68,"「この臭くてボロボロの奴隷服を着替えられるなら、\n　いっそ男物だって構いませんよ！」\\nw[\\N[2]]":69,"「いや、だから女物だって。\n　どうせ安物だしな、好きにしろ」\\nw[\\N[1]]":70,"「やったぁ！\n　じゃあ着替えるので、一人にしてもらえますか？」\\nw[\\N[2]]":71,"「それはダメだ！\n　視姦……じゃなくて監視の必要があるからな！」\\nw[\\N[1]]":72,"「なっ、なんでですか！？\n　別に１人になったからって、逃げたりしませんよ！」\\nw[\\N[2]]":73,"「いいや認めん！\n　着替えるなら、いまこの場でだ！」\\nw[\\N[1]]":74,"「うぅ……わ、わかりましたよ！\n　でも、あんまりこっち見ないでくださいね！」\\nw[\\N[2]]":75,"「ジーーーーーーーッ……」\\nw[\\N[1]]":76,"（すっごい見てる！）\\nw[\\N[2]]":77,"「お、終わりましたよ！」\\nw[\\N[2]]":78,"「うん、似合ってるぞ。\n　それから\\N[2]、お前――」\\nw[\\N[1]]":79,"「はい？」\\nw[\\N[2]]":80,"「やっぱり、いろいろと小さいなぁ。\n　どこがとは言わんが」\\nw[\\N[1]]":81,"「キィーッ！！　大きなお世話ですッ！」\\nw[\\N[2]]":82,"防具\\C[17]『\\an[2]』\\C[0]を入手した！":83,"奴隷服以外のとき":84,"プロローグスキップ設定":85,"「なんですか、その丸いの？\n　金属のボールみたいに見えますけど？」\\nw[\\N[2]]":86,"「分からん。\n　なんで俺の家にこんなものが落ちてるんだ？」\\nw[\\N[1]]":87,"「仕入れたまま忘れちゃってた商品とか？\n　管理はちゃんとしないとダメですよぉ～」\\nw[\\N[2]]":88,"「んなわけあるか！\n　本当に覚えがないんだよ！\\nw[\\N[1]]":89,"「だが俺の家にあったということは、俺のものってこと\n　だよな。\n　よし、もらっておこう」\\nw[\\N[1]]":90,"特殊アイテム\\C[17]『\\in[45]』\\C[0]を入手した！":91,"ユマH1(尿道)":92,"<TE:37>":93,"ユマH2(正常位)":94,"<TE:38>":95,"ユマH3(ディルドー)":96,"<TE:39>":97,"ユマH4(後背位)":98,"<TE:40>":99,"ユマH5(アナル)":100,"<TE:41>":101,"ユマH6(正常位2)":102,"<TE:42>":103,"ユマH7(クスコ)":104,"<TE:43>":105,"ユマH8(口奉仕)":106,"<TE:44>":107,"ユマH9(マイクロビキニ)":108,"<TE:45>":109,"ユマ（ED3Ev）":110,"「お～い、帰ったぞ」\\nw[\\N[1]]":111,"「もぉ、どこ行ってたんですか？\n　人に掃除を押しつけて！」\\nw[\\N[2]]":112,"「ちょっと街の様子を見るだけのつもりだったのに、\n　ギルド長に捕まっちまってな」\\nw[\\N[1]]":113,"「そうでしたか。\\nw[\\N[2]]":114,"「でも\\N[1]さん！\n　わたしはもう奴隷じゃないんですから、仕事はちゃんと\n　分担してくださいね！」\\nw[\\N[2]]":115,"「はいはい、分かってるって。\n　お前は奴隷じゃなくて従業員な」\\nw[\\N[1]]":116,"「そうです！　ちゃんと王宮で\\C[17]奴隷身分からの解放\\C[0]を\n　許可してもらったんですから」\\nw[\\N[2]]":117,"「でも本当に良かったのか？\n　ミニャニャちゃんのところに残らなくて？」\\nw[\\N[1]]":118,"「人の父親を源氏名で呼ばないでください！\\nw[\\N[2]]":119,"「あの人のことは放っておけばいいんですよ！\\nw[\\N[2]]":120,"「故郷のシーグヌースで女装バーを始めるとか、付き合って\n　られません！　そうでしょ！？」\\nw[\\N[2]]":121,"「まあ簡単に了承できないのは確かだな……」\\nw[\\N[1]]":122,"「だいたい\\N[1]さん、わたしがいなくなったら\n　一人で奴隷商なんてやっていけないでしょ？」\\nw[\\N[2]]":123,"「だからこっちに残ってやった、とでも言うつもりか？\\nw[\\N[1]]":124,"「まあいい……それよりお前にもうひとつ、頼みたい\n　業務があるんだが」\\nw[\\N[1]]":125,"「えっ、奴隷売買の手伝い以外にですか？\\nw[\\N[2]]":126,"「それはちょっと……。\n　奴隷商のお手伝いだけでも大変なので、これ以上は……」\\nw[\\N[2]]":127,"「そうか、無理強いはできないから仕方ないな。\n　じゃあ他を当たるから忘れてくれ」\\nw[\\N[1]]":128,"「ちなみにどんな業務なんですか？」\\nw[\\N[2]]":129,"「俺の血を継ぐ子供の出産と、その育児や教育だ」\\nw[\\N[1]]":130,"「ああ、ベビーシッター的な……\\nw[\\N[2]]":131,"「ってソレ！？　\\C[17]奥さんになって欲しい\\C[0]ってことじゃ\n　ないですかぁー？！！」\\nw[\\N[2]]":132,"「見方によってはそうともとれるな」\\nw[\\N[1]]":133,"「他にどう解釈しろと？！\\nw[\\N[2]]":134,"「あー、もうっ……\\N[1]さんは……」\\nw[\\N[2]]":135,"「で、お前はパスってことでいいんだな？」\\nw[\\N[1]]":136,"「それ本気で言ってるなら殴りますよ！\\nw[\\N[2]]":137,"「第一そんなひどい業務、わたし以外にこなせる人なんて\n　いるわけないじゃないですか」\\nw[\\N[2]]":138,"「なにぃっ！？」\\nw[\\N[1]]":139,"「だ、だから……受けてあげてもいいですよ……。\\nw[\\N[2]]":140,"「でもその代わり、ちゃんと誓約の言葉をくださいね。\n　こ、こういうのは必要なことですから……」\\nw[\\N[2]]":141,"「チッ、苦手なんだがな、そういうのは……」\\nw[\\N[1]]":142,"「ダメですよ！\n　わたしは曖昧な約束なんて許しませんからね！」\\nw[\\N[2]]":143,"「分かった分かった。……ゴホン。\\nw[\\N[1]]":144,"「\\N[2]」\\nw[\\N[1]]":145,"「は……はい！」\\nw[\\N[2]]":146,"「お前のまんこは絶品だ！\n　その素晴らしい穴から俺の子をモリモリ産んでくれ！」\\nw[\\N[1]]":147,"「……………………」\\nw[\\N[2]]":148,"「んっ？　ど、どうした\\N[2]？」\\nw[\\N[1]]":149,"「ちょっと台所で包丁研いできます……」\\nw[\\N[2]]":150,"「な、なぜこのタイミングで？\n　というかだな、今のはちょっとした俺流の照れ隠しと\n　いうか……」\\nw[\\N[1]]":151,"「今日のごはんはモツ煮込みでいいですよね？」\\nw[\\N[2]]":152,"「いや待て！　今のはさすがに俺が悪かった！\n　モツはやめよう！　モツは！」\\nw[\\N[1]]":153,"エンディングロール\n↓　　↓　　↓":154,"↑　　↑　　↑\nエンディングロール":155,"エンディング後再開処理（ED3,4）":156,"C_START":157,"C_ENABLE_WEATHER":158,"\\>※　本作を遊んでいただきありがとうございました。　※\n\\>※　ここから未クリアの依頼やダンジョンを引き続き　※\n\\>※　攻略することができます。　　　　　　　　　　　※":159,"\\>\\N[1]が戦技\\C[17]『\\sn[103]』\\C[0]を覚えた！":160,"\\>自宅にある\\C[17]赤い本\\C[0]から、\\C[17]アルテトとの決戦\\C[0]をやり直せる\n\\>ようになった！\n\\>（※別エンディングを見るためにご活用ください）":161,"ラーナ（ED3,4）":162,"初回のみ":163,"「お兄様のお望み通り、わたし秘密クラブで教育されて\n　来ました\\I[29]\\nw[\\N[5]]":164,"「お陰様で、自分がいかに卑小で淫猥であるか自覚する\n　ことが出来ましたわ\\I[29]\\nw[\\N[5]]":165,"「つきましては今後とも、お兄様の性奴隷としてご奉仕\n　させていただきますね\\I[29]\\nw[\\N[5]]":166,"「え？　血のつながり？\n　それがどうかいたしましたか？\\nw[\\N[5]]":167,"「わたしを屈服させたお兄様の種でなら、喜んで孕ま\n　させていただきますわ\\I[29]」\\nw[\\N[5]]":168,"ラノティカの自宅で\\N[5]が同居するようになった！":169,"「お兄様、なんなりとお命じになってくださいね\\I[29]」\\nw[\\N[5]]":170,"エッチする":171,"なにもしない":172,"「えぇ～？！　してくださらないのですかぁ？」\\nw[\\N[5]]":173,"「お兄様のお陰様で、自分がいかに卑小で淫猥であるか\n　自覚することが出来ましたわ\\I[29]\\nw[\\N[5]]":174,"「あの秘密クラブでの輪姦調教を生かして、今後とも\n　性奴隷としてご奉仕させていただきますね\\I[29]\\nw[\\N[5]]":175,"ラーナハートマーク":176,"エルラ（ED4）":177,"「あの、これまで本当に……ご、ごめんなさい……。\n　無礼の数々、後悔してるの！\\nw[\\N[3]]":178,"「本気で反省してますから、どうか見捨てないで！\\nw[\\N[3]]":179,"「だってあたしもう、\\N[1]様のおちんちん無しじゃ\n　生きていけない体なんだもの\\I[29]」\\nw[\\N[5]]":180,"ラノティカの自宅で\\N[3]が同居するようになった！":181,"「ねぇ～\\I[29]　エッチしましょうよぉ\\I[29]\n　お願いですからぁ\\I[29]」\\nw[\\N[3]]":182,"「そんなぁ？　いますっごく抱いて欲しいのにぃ！」\\nw[\\N[3]]":183,"エルラハートマーク":184,"EV032":185,"クリア後最終決戦やり直し":186,"<TE:100>":187,"ポスター1":188,"<TE:88>":189,"ポスター2":190,"<TE:89>":191,"ポスター3":192,"<TE:90>":193,"EV038":194,"どうしますか？":195,"共有データ全てON":196,"信頼度・発情度操作":197,"排泄ゲージ操作":198,"テストプレイ設定終了":199,"主人公名前変更":200,"道具保管数+20":201,"信頼度・発情度の操作":202,"信頼度を10上げる↑":203,"信頼度を50上げる↑":204,"信頼度を50下げる↓":205,"発情度を10上げる↑":206,"発情度を50上げる↑":207,"発情度を50下げる↓":208,"排泄+5":209,"排泄+10":210,"排泄+50":211,"PHWarehouse create <道具箱:20:rule1>":212,"PHWarehouse capacity increase <道具箱:20>":213,"+20！":214,"道具箱上限補正用処理":215,"↓【Ver.1.0.5追加】道具箱を一度も開けずに自宅を購入していくと保管上限数が増えない\n　バグの補正。決定ボタン10連続押しで補正処理が起動。":216,"PHWarehouse capacity increase <道具箱:10>":217,"道具箱の保管上限数の修正措置をおこないました。":218,"ビキニ鎧補正用処理":219,"↓【Ver.1.0.7追加】最初に闘技場でビキニ鎧を入手すると、2番目のビキニ鎧からの\n　入手になってしまうバグの補正。決定ボタン10連続押しで補正処理が起動。":220},"extension":"json","dataType":"map","filename":"Map017","basename":"Map017.json","path":"data/Map017.json","relPath":"data/Map017.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":1,"length":221,"percent":0.4524886877828055},"cellInfo":[]},"data/Map018.json":{"data":[["農民",""],["羊",""],["逃走防止用",""],["EV010",""],["宿屋",""],["EV011",""],["民家",""],["EV012",""],["ニワトリ",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["水車",""],["村人（奴隷買い取り）",""],["奴隷買い取り（フキダシ）",""],["農作物売買フキダシ",""],["アヒル",""],["「近頃はフォアグラの需要も増えてきて、出荷量は\n　右肩上がりなんだ」\\nw[農民]",""],["「羊の肉は独特のクセがあるけど、慣れれば大して\n　気にならんさ」\\nw[農民]",""],["牧羊犬",""],["男の子",""],["「羊ののうみそって食べたことある？\n　ボクあるよ！」\