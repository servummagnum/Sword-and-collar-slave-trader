"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"宿屋の主人":1,"下水道掃除の仕事を受けるまでは入れない":2,"「宿屋に泊まってどうする？\n　それより今は商業ギルドへ行かないと」\\nw[\\N[1]]":3,"EV003":4,"客":5,"「町を出て山沿いに北東の方へ行くと、ヤバイ\\C[17]洞窟\\C[0]が\n　あるんだよ。\\nw[男性客]":6,"「中にはモンスターがウジャウジャいてさ。\n　あれっていわゆる、ダンジョンなんじゃないか？」\\nw[男性客]":7,"トイレドア（排泄Ev）":8,"トイレで用を足しますか？":9,"入る":10,"入らない":11,"いまのところ用を足す必要は無い。":12,"火":13,"宿屋の女将":14,"「ほらほら、商人ならもっと金を使っていきなよ！」\\nw[宿屋の女将]":15,"男":16,"「街道を西の方へ行くとナクル村があるんだ。\n　あそこじゃマツタケを栽培してるってな」\\nw[酒飲みの男]":17,"トイレマーク（屋内用）":18,"<TE:84>":19,"ユマ（トイレ）":20,"依頼フキダシ":21,"燭台":22,"宿泊客（依頼06）":23,"依頼を出している場合":24,"依頼を出していない場合":25,"「私は農園を経営してるんだがね、そろそろ息子に全部\n　ゆだねて楽隠居するつもりなんだ」\\nw[宿泊客]":26,"絶倫おじさん（依頼16）":27,"変態紳士（依頼17）":28,"光":29,"吟遊詩人":30,"「\\C[17]ポータル球\\C[0]は実在すると思うかね？\n　私はあると思っているよ。鼻で笑う者もいるがね。\\nw[男性客]":31,"「そういえば広場にいた男が変な玉を見つけたようなことを\n　言っていたが……いや、そう都合よく出てくるはずは\n　ないか……」\\nw[男性客]":32,"「古代人は石碑にはめたポータル球の力で瞬間移動を\n　していたというが、私も一度でいいから体験して\n　みたいものだ」\\nw[男性客]":33,"料理1":34,"客1":35,"「ずっと西にいった先の森には、\\C[17]ダークエルフの里\\C[0]が\n　あるんだ。\n　不用意に踏み込むとモンスターに襲われるってさ」\\nw[男性客]":36,"客2":37,"「エルフと言えば、盗賊をやってるエルフもいるらしいぞ。\n　やつらは弓が得意だから、厄介だろうな」\\nw[男性客]":38,"客3":39,"「オレの若い頃には、まだ今ほど鉱山から資源は採れて\n　なかったな」\\nw[老人]":40,"料理2":41,"客4":42,"「一度でいいから、芸術の町に行ってみたいわ。\n　きっとステキなところなんでしょうね」\\nw[女性客]":43,"客5":44,"「旅行に行くなら、やっぱり王都がいいわね。\n　大都会を見てみたいの」\\nw[女性客]":45,"料理3":46,"客6":47,"「鬼っていう亜人を見たことあるか？\n　あれはヤバいぜ。特に男が」\\nw[労働者]":48,"客7":49,"「亜人っていうと、悪魔が一番怖いな。\n　邪神の眷属だっていうけど、本当なんだろうか？」\\nw[労働者]":50,"客8":51,"「ヤバイ亜人って言ったら、やっぱエルフだろ。\n　あいつら未だに『人間は侵略者だ』って言って\n　俺たちを目の敵にしてるんだぜ？」\\nw[労働者]":52},"extension":"json","dataType":"map","filename":"Map008","basename":"Map008.json","path":"data/Map008.json","relPath":"data/Map008.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":53,"percent":0},"cellInfo":[],"cacheResetOnChange":{}},"data/Map009.json":{"data":[["EV001",""],["ギルド通信を読むまで出られない",""],["「おっと、出る前に\\C[17]ギルド通信\\C[0]を見ておかないと」\\nw[\\N[1]]",""],["EV002",""],["EV003",""],["火",""],["商人",""],["「武器商ギルドの勢いにも、とうとう陰りが見え始めたな。\n　巻き返しのチャンス到来というわけだ」\\nw[商人]",""],["「我々と対立する武器商ギルドは、新興ながら勢いが\n　すごいんだ。王様が特権を与えたせいでね」\\nw[商人]",""],["仲買人（依頼05）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「農作物を仕入れるなら、豊作のところへ行かないと。\n　不作の村だと、高いこと高いこと……」\\nw[仲買人]",""],["依頼フキダシ",""],["チェック",""],["ギルド通信",""],["下水道掃除の依頼を受注するイベント",""],["「ここに掲示されてる\\C[17]ギルド通信\\C[0]に、盗賊なんかの\n　目撃情報が載ってるんだ」\\nw[\\N[1]]",""],["「そうなんですか。\n　意外と簡単に手に入る情報なんですね」\\nw[\\N[2]]",""],["「ギルド会費を払ってやってるんだから、これくらいの\n　情報は提供してもらわないと割にあわんさ」\\nw[\\N[1]]",""],["\\{「おいっ、\\N[1]！！」\\}\\nw[？？？]",""],["「これはこれは、\\C[17]ギルド長\\C[0]。\n　どしたんだ、そんな怖い顔して？」\\nw[\\N[1]]",""],["「どうしたもこうしたもあるか！\n　すっとぼけるのも大概にしておけ！\\nw[ギルド長]",""],["「お前な、いい加減\\C[18]ギルド会費の未払い\\C[0]をどうにかしろ！\n　どれだけ溜まってるか分かってるのか！？」\\nw[ギルド長]",""],["「うわっ……会費を滞納してたくせに、割に合わないとか\n　偉そうに言ってたんですか？」\\nw[\\N[2]]",""],["「うるさい黙れ。\n　それはそれ、これはこれ、だ」\\nw[\\N[1]]",""],["「いやいや、別問題じゃないでしょう？\n　会費払わずにサービスだけ受けようなんて、ダメダメ\n　じゃないですか」\\nw[\\N[2]]",""],["「その通りだ！\n　未払いの会費を持ってくるまで、お前はギルドの\n　\\C[18]サービス全般を利用禁止\\C[0]だ！\\nw[ギルド長]",""],["「ギルド通信の閲覧も許さんからな！」\\nw[ギルド長]",""],["「ちょ、ちょっと待ってくれ！\n　実はいま、大きな買い物をした直後であまり金が無いんだ。\\nw[\\N[1]]",""],["「今度来たとき絶対に払うから、今日は見逃してくれ。\n　頼む！」\\nw[\\N[1]]",""],["「そう言って、毎度毎度逃げおって！\n　今回ばかりはダメだ！\\nw[ギルド長]",""],["「お前も商人なら、払うべきものはキッチリ払え！」\\nw[ギルド長]",""],["「そう言われても、無い袖は振れないしなぁ……」\\nw[\\N[1]]",""],["「ならば、こうしよう。\n　緊急性が高くて報酬も悪くないのに、引き受け手が\n　見つからん仕事がある。\\nw[ギルド長]",""],["「お前がその仕事をこなしてくれたら、会費の件は\n　チャラにしてやろう」\\nw[ギルド長]",""],["「なんだその仕事ってのは？\n　誰も引き受けないってことは、どうせロクでもない\n　ことだろ？」\\nw[\\N[1]]",""],["「この町の下水道に棲みついている\\C[17]害獣の駆除\\C[0]だ。\\nw[ギルド長]",""],["「町長が冒険者に駆除の依頼を出しているのに\n　見向きもされなくて、ちょうど困っていたんだ」\\nw[ギルド長]",""],["「ドブ浚いかよ！\n　……だが、仕事を選べる状況でもないか」\\nw[\\N[1]]",""],["「受けるんですか？」\\nw[\\N[2]]",""],["「ああ。\n　考えようによっちゃ、戦闘訓練になるだろうし、\n　やって損になることも無いだろ」\\nw[\\N[1]]",""],["「じゃあ頼んだぞ、\\N[1]。\n　下水道には\\C[17]町の東側の階段\\C[0]から下りられるからな」\\nw[ギルド長]",""],["メインシナリオ\\C[17]『商業ギルドへ』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「１」\\C[0]上がった！",""],["メインシナリオ\\C[17]『下水の害獣駆除』\\C[0]を受けた！",""],["「さて……。\n　まずは装備を整えて、それから下水道へ向かうとするか」\\nw[\\N[1]]",""],["\n\\>　　※　町の店舗で\\C[17]買い物\\C[0]ができるようになった！　※",""],["「\\N[2]を買ったせいで金欠だから、購入するものは\n　慎重に選ばないとな」\\nw[\\N[1]]",""],["下水道の害獣駆除が終わるまで、ギルド通信の閲覧は\nできない。",""],["「今週のギルド通信の\\C[17]治安情報\\C[0]にも、盗賊どもの\n　情報が載ってるな」\\nw[\\N[1]]",""],["「じゃあ、さっそく奴隷狩りに？」\\nw[\\N[2]]",""],["「そうしてもいいが、装備が整わないまま猪突猛進して\n　返り討ちにあうのも考えものだ。\\nw[\\N[1]]",""],["「いままで通り行商による\\C[17]交易\\C[0]で金を稼いで、先に装備を\n　整えるか……。\\nw[\\N[1]]",""],["「それとも\\C[17]ダンジョン\\C[0]で、冒険者みたいに宝箱から\n　武器防具を調達するか……。\\nw[\\N[1]]",""],["「ま、そのへんは状況を見て、臨機応変にいこう」\\nw[\\N[1]]",""],["「それは行き当たりばったりと言うのでは？」\\nw[\\N[2]]",""],["「お～い！　\\N[1]！！」\\nw[ギルド長]",""],["「ギルド長？\n　どうした、まだ何か用でも？」\\nw[\\N[1]]",""],["「実はお前に、もうひとつ頼みたいことが出来たんだ。\n　報酬は払うから、引き受けてくれんか？」\\nw[ギルド長]",""],["「そりゃあ内容によるな。\n　いったい、どんな依頼を？」\\nw[\\N[1]]",""],["「\\C[17]鉱山\\C[0]の様子を見てきてほしいのだ」\\nw[ギルド長]",""],["「鉱山？」\\nw[\\N[2]]",""],["「このラノティカの町から北に行った、山向こう側に鉱山が\n　あるんだ。\\nw[\\N[1]]",""],["「そこで掘り出された鉱石は、この町で精錬されて\n　インゴットに加工されたあと、各地に売られて\n　いくんだ」\\nw[\\N[1]]",""],["「その通りなのだが……実はその鉱山が\\C[17]操業停止状態\\C[0]らしい\n　のだ。おかげで鉱石がまったく入ってこない」\\nw[ギルド長]",""],["「それで様子を見てこいってわけか。\n　いいぜ、それくらいなら請け負ってやっても」\\nw[\\N[1]]",""],["「報酬として\\C[17]１０００Ｇ\\C[0]払うから、頼んだぞ」\\nw[ギルド長]",""],["メインシナリオ\\C[17]『鉱山視察』\\C[0]を受けた！",""],["\n\\>　　　\\C[17]※　町の外に出られるようになった！　※\\C[0]",""],["実績 1",""],["豪商",""],["「ギルド通信の市場ニュースは、気にかけておいた方が\n　いい。\\nw[豪商]",""],["「不景気な街でモノを売ろうとしても、利益は出ないからな。\n　売るなら景気のいいところにしないと」\\nw[豪商]",""],["ギルド長",""],["まだ駆除が終わってない",""],["「下水道には\\C[17]町の東側の階段\\C[0]から下りられる。\n　きちんと全部駆除するんだぞ」\\nw[ギルド長]",""],["駆除完了",""],["「ギルド長、下水の害獣駆除終わったぜ。\\nw[\\N[1]]",""],["「これで滞納分のギルド会費はチャラってことで\n　いいな？」\\nw[\\N[1]]",""],["「ほう。もう終わったのか。\n　商売人より冒険者の方が向いてるんじゃないか？」\\nw[ギルド長]",""],["「大きなお世話だ。\\nw[\\N[1]]",""],["「ともかく、仕事は終えたんだから\\C[17]ギルド通信\\C[0]を\n　見せてもらうぜ」\\nw[\\N[1]]",""],["「よかろう。\n　ついでにボーナスでこれもつけてやる」\\nw[ギルド長]",""],["アイテム\\C[17]『精霊石』\\C[0]をもらった！",""],["「それ\\C[17]精霊石\\C[0]ですか？\n　わぁ、綺麗ですね」\\nw[\\N[2]]",""],["「受付カウンターでの\\C[17]精霊石交換サービス\\C[0]も再開して\n　いるから、帰りに寄っていってみるといい。\\nw[ギルド長]",""],["「ではご苦労だったな。\n　次の会費徴収からは、くれぐれも滞納しないように」\\nw[ギルド長]",""],["「へいへい。気をつけますよ」\\nw[\\N[1]]",""],["メインシナリオ\\C[17]『下水の害獣駆除』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「３」\\C[0]上がった！",""],["\n\\>\\C[17]※　商業ギルドの各種サービスが利用可能になった！　※\\C[0]",""],["実績 2",""],["「\\C[17]鉱山\\C[0]がどうなっているか、見てきてくれ。\n　操業停止だなんて……悪いことが起きていなければ\n　いいが……」\\nw[ギルド長]",""],["鉱山視察の報告",""],["鉱山のモンスター退治が終わっていないとき",""],["「調べてきたぜ、ギルド長。\n　操業停止の原因はモンスターの発生だ」\\nw[\\N[1]]",""],["「なんだと！？」\\nw[ギルド長]",""],["「鉱山の坑道の中にモンスターが湧いて、作業が\n　まったく出来ないそうです。\\nw[\\N[2]]",""],["「駆除がいつごろ終了するかは、見通しが\n　立たない、ということらしく……」\\nw[\\N[2]]",""],["「なんということだ……。\n　この損失は大きなものになるぞ！\\nw[ギルド長]",""],["「……ともあれ、よく調べてきてくれたな。\n　助かったぞ。これが約束の報酬だ」\\nw[ギルド長]",""],["鉱山のモンスター退治が終了してるとき",""],["「そんでもって、そのモンスターは俺たちが\n　残らず倒してきた」\\nw[\\N[1]]",""],["「倒した！？　お前が！？\n　まさか、私をかついでるわけじゃ――」\\nw[ギルド長]",""],["「いえいえ、これが本当でして。\n　わたしも付き合わされて大変だったんですよ～」\\nw[\\N[2]]",""],["「そういうわけで、もう鉱山は操業を再開してるぞ。\n　鉱石もすぐ町へ入ってくるようになるはずだ」\\nw[\\N[1]]",""],["「驚いたな……お前、ほんとうに商人より冒険者の方が\n　向いてるんじゃないか？」\\nw[ギルド長]",""],["「大きなお世話だ！\n　それより報酬だ、報酬」\\nw[\\N[1]]",""],["「わかっとるから、急かすな。ほれ」\\nw[ギルド長]",""],["メインシナリオ\\C[17]『鉱山視察』\\C[0]を達成した！\n報酬として\\C[17]１０００Ｇ\\C[0]をもらった！",""],["「それとこれはモンスターを退治して、早期に操業を\n　再開させてくれ礼だ。遠慮せずとっておけ」\\nw[ギルド長]",""],["追加の報酬として\\C[17]精霊石を２個\\C[0]をもらった！",""],["「おっ、ラッキー！」\\nw[\\N[1]]",""],["「じゃ、俺は自分の商売に戻らせてもらうぞ」\\nw[\\N[1]]",""],["「うむ、ご苦労だったな」\\nw[ギルド長]",""],["ギルド職員",""],["ユマ",""],["ギルド長（OPイベント用）",""],["行商人",""],["「ギルド通信の治安情報に出ている場所のそばには、\n　だいたい盗賊や亜人の隠れ家があるんだ。\\nw[行商人]",""],["「うっかり近づかないよう、気をつけないと」\\nw[行商人]",""],["「砂漠の町で売ってる古代の遺物なんかは利益率が\n　高いんだが、いかんせん重くってなぁ」\\nw[商人]",""],["新米商人",""],["「なにを売買すれば、手っ取り早く儲けられるんで\n　しょうかね？」\\nw[新米商人]",""],["料理1",""],["宝箱",""],["※\nアイテム：火炎瓶\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　　『サバイバル行商入門』\n\\>\n\\>『……このように行商人の大半は護衛を雇えるほどの\n\\>　収入がないため、自分の身は自分で守るしかない。\n\\>\n\\>　本書では自衛のために知っておくべき知識のうち、\n\\>　一般常識に属するもの――例えば火属性の怪物に\n\\>　は水属性の攻撃を、風属性には地属性を――は割愛\n\\>　し、より実践的な学びを目指すこととする。\n\\>　\n\\>　自分は剣も弓も扱えない、と早くも諦め半分の読者\n\\>　諸兄は安心してほしい。\n\\>　そのような武器がなくとも身を守ることはできる。\n\\>　そう、ガムテープさえあればね。",""],["MWL_行数リセット",""],["女商人",""],["「弱ったからといって、武器商ギルドが無くなることは\n　ないでしょうね」\\nw[女商人]",""],["「わたしたちのギルドが力を持ち過ぎたから、王様は\n　武器商ギルドを対抗勢力に育ててる……って話だけど、\n　本当なのかしら？」\\nw[女商人]",""]],"context":[["Map009/events/1/name"],["Map009/events/1/pages/1/list/0/comment","Map009/events/2/pages/1/list/0/comment","Map009/events/3/pages/1/list/0/comment"],["Map009/events/1/pages/1/list/4/message/noPicture/bottom","Map009/events/2/pages/1/list/4/message/noPicture/bottom","Map009/events/3/pages/1/list/4/message/noPicture/bottom"],["Map009/events/2/name"],["Map009/events/3/name"],["Map009/events/4/name"],["Map009/events/5/name","Map009/events/20/name"],["Map009/events/5/pages/0/list/1/message/noPicture/bottom"],["Map009/events/5/pages/0/list/7/message/noPicture/bottom"],["Map009/events/7/name"],["Map009/events/7/pages/0/list/0/comment","Map009/events/13/pages/1/list/0/comment"],["Map009/events/7/pages/0/list/10/comment","Map009/events/13/pages/1/list/13/comment"],["Map009/events/7/pages/0/list/11/message/noPicture/bottom"],["Map009/events/8/name","Map009/events/14/name"],["Map009/events/9/name","Map009/events/18/name"],["Map009/events/10/name"],["Map009/events/10/pages/0/list/2/comment"],["Map009/events/10/pages/0/list/53/message/noPicture/bottom"],["Map009/events/10/pages/0/list/66/message/noPicture/bottom"],["Map009/events/10/pages/0/list/72/message/noPicture/bottom"],["Map009/events/10/pages/0/list/76/message/noPicture/bottom"],["Map009/events/10/pages/0/list/114/message/noPicture/bottom"],["Map009/events/10/pages/0/list/120/message/noPicture/bottom"],["Map009/events/10/pages/0/list/123/message/noPicture/bottom"],["Map009/events/10/pages/0/list/132/message/noPicture/bottom"],["Map009/events/10/pages/0/list/138/message/noPicture/bottom"],["Map009/events/10/pages/0/list/146/message/noPicture