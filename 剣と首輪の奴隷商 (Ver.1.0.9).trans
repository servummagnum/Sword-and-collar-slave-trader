プレイヤーを見失ったときの処理":21,"奴隷化性別：0=女、1=男、2=男女ランダム":22,"敵02":23,"敵03":24,"敵04":25},"extension":"json","dataType":"map","filename":"Map427","basename":"Map427.json","path":"data/Map427.json","relPath":"data/Map427.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":26,"percent":0},"cellInfo":[]},"data/Map428.json":{"data":[["EV001",""],["客1",""],["「噂の媚薬を手に入れてさ、おかげでアッチの方は\n　ビンビンだよ！」\\nw[客]",""],["EV003",""],["EV004",""],["EV005",""],["娼婦",""],["「さっきの客に、鎖骨が綺麗だねって言われたけど、\n　他に褒めるところは無かったのかしら……？」\\nw[娼婦]",""],["「怪しい薬を飲んでまでエッチしたいの？\n　ほんとにスケベなんだからぁ\\I[29]」\\nw[娼婦]",""],["ドア",""],["部屋の中でお楽しみ中のようだ。",""],["燭台",""],["窃盗用下着3",""],["<TE:118>",""],["客2",""],["光",""],["EV015",""],["娼館従業員",""],["個別依頼27",""],["企画モノ娼婦Ｂ",""],["「マンネリ化を打破するっていう店の方針で、今度\n　企画物サービスをするんですって。\\nw[娼婦]",""],["「その目玉として\\C[17]女悪魔\\C[0]を使うから、連れてきて\n　くれる？」\\nw[娼婦]",""],["「女悪魔で、いったいどんな企画をやるんだ？」\\nw[\\N[1]]",""],["「『逆レイプ！　悪魔と化したロリ妹に犯される男！\n　　お兄ちゃんの臭い精子、全部搾り取ってあげる\\I[29]』」\\nw[娼婦]",""],["「！…………\\I[29]\\I[29]」\\nw[\\N[2]]",""],["「なんで興味津々って顔してるのよ？」\\nw[娼婦]",""],["「…………」\\nw[\\N[2]]",""],["「わ、わたしが考えたわけじゃないわよ！？\n　支配人が、マゾっ気のあるお客にウケるって言って……」\\nw[娼婦]",""],["「なかなか面白そうじゃないか。\n　しかしロリ悪魔ってことは、そういう体形のほうが\n　いいのか？」\\nw[\\N[1]]",""],["「そうね、\\C[17]胸は控えめ\\C[0]な娘でお願い」\\nw[娼婦]",""],["「予算は\\C[17]５０００Ｇ\\C[0]。\n　あと\\C[17]\\in[29]も１個\\C[0]オマケでつけるわ」\\nw[娼婦]",""],["個別依頼『企画モノ娼婦Ｂ』を受けますか？",""],["受ける",""],["受けない",""],["氷雪の神殿・中庭",""],["水の塔",""],["個別依頼\\C[17]『企画モノ娼婦Ｂ』\\C[0]を受けた！",""],["依頼条件達成",""],["\\C[17]『\\in[121]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["「貧乳悪魔を仕入れてきたぞ。\n　そこそこロリっぽいと思うが」\\nw[\\N[1]]",""],["「そうね、この娘ならいい感じかしら。\\nw[娼婦]",""],["「エッチの技術はこれから仕込むとして……\n　うん、いけそう」\\nw[娼婦]",""],["個別依頼\\C[17]『企画モノ娼婦Ｂ』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「女悪魔の準備が出来次第、サービス開始予定だから、\n　はやく見つけてきてね」\\nw[娼婦]",""],["依頼マーク",""],["男",""],["\n\\>　　　　　　　　～　娼館の一室にて　～",""],["「ねぇ、お兄さま\\I[29]\n　なんでさっきから、股間を膨らませていらっしゃるのぉ？」\\nw[奴隷娼婦]",""],["「あー、ちょっと待った。\n　『お兄さま』じゃなく『お兄ちゃん』でお願いできる\n　かな？　口調も庶民的な感じで頼むよ」\\nw[男性客]",""],["「あら、設定にこだわるお客さんね。\n　いいわよ、じゃあご要望通りに――。\\nw[奴隷娼婦]",""],["「ねぇ、お兄ちゃん\\I[29]\n　なんで股間を膨らませてるのぉ？」\\nw[奴隷娼婦]",""],["「な、なんのことだ？」\\nw[男性客]",""],["「とぼけたってダメだよぉ\\I[29]\n　さっきからあたしの胸元とか太股とか、盗み見てるでしょ」\\nw[奴隷娼婦]",""],["「バカを言うな！\n　妹の体に興奮するなんて、そんなワケ――」\\nw[男性客]",""],["「股間にテント張っておいて、全然説得力ないんだけどぉ？\n　あたしとヤリたいんでしょ\\I[29]」\\nw[奴隷娼婦]",""],["「だから違う！　お前の勘違いだ！\n　それより早く正気に戻ってくれ！\\nw[男性客]",""],["「お前は悪魔にとり憑かれておかしくなってるんだ！\n　そうでなきゃ、こんなこと――」\\nw[男性客]",""],["「あーもうっ、面倒くさいなぁ。\n　さっさとその発情チンポ出しなさいよぉ\\I[29]」\\nw[奴隷娼婦]",""],["「こ、こらっ、股間に触るな！　なにをするんだっ！？」\\nw[男性客]",""],["「お兄ちゃん、いっぱい出したね\\I[29]」\\nw[奴隷娼婦]",""],["「いやはや、妹逆レイプというシチュエーションが\n　これほど燃えるとは。とても良かったよ」\\nw[男性客]",""],["「ほんと？　うれしい\\I[29]\n　これ考えた支配人に、高評価だったって伝えておくね\\I[29]」\\nw[奴隷娼婦]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『企画モノ娼婦Ｂ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[29]１個\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！",""],["セックス中",""],["依頼フキダシ",""],["娼館の客（依頼22~25)",""],["依頼を出している場合",""],["娼館支配人（依頼20）",""],["奴隷市（フキダシ）",""],["薄衣購入フキダシ",""]],"context":[["Map428/events/1/name"],["Map428/events/2/name"],["Map428/events/2/pages/0/list/0/message/noPicture/bottom"],["Map428/events/3/name"],["Map428/events/4/name"],["Map428/events/5/name"],["Map428/events/6/name","Map428/events/7/name"],["Map428/events/6/pages/0/list/0/message/noPicture/bottom","Map428/events/6/pages/2/list/0/message/noPicture/bottom"],["Map428/events/7/pages/0/list/8/message/noPicture/bottom"],["Map428/events/8/name","Map428/events/24/name"],["Map428/events/8/pages/0/list/0/message/noPicture/bottom","Map428/events/24/pages/0/list/0/message/noPicture/bottom"],["Map428/events/9/name","Map428/events/12/name","Map428/events/17/name","Map428/events/19/name"],["Map428/events/10/name"],["Map428/events/10/note"],["Map428/events/11/name"],["Map428/events/13/name","Map428/events/14/name","Map428/events/18/name"],["Map428/events/15/name"],["Map428/events/16/name"],["Map428/ev