ex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]}],null,[{"headerIndex":2,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]},{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":4,"headerParam":["初回鉱山訪問イベント"]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]}],[{"headerIndex":21,"headerParam":["",0,0,2]}]],"indexIds":{"<fgName:fog01>\n<fgLoopX:10>\n<fgLoopY:10>\n<fgSx:1>\n<fgSy:1>":0,"EV001":1,"敵追跡の停止":2,"SmartPath 10 cancel":3,"SmartPath 11 cancel":4,"SmartPath 12 cancel":5,"SmartPath 13 cancel":6,"PSS stop":7,"PSS reset C":8,"EV002":9,"EV003":10,"EV004":11,"壁ひび":12,"※\nアイテム：精霊石\n※":13,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":14,"↓アイテムのIDNo.を変数に入力する":15,"↓アイテムの入手個数を変数に入力する":16,"↓アイテムの総重量を変数に入力する":17,"敵索敵スタート":18,"PSS start":19,"宝箱（消耗品左開き）":20,"<TE:15>":21,"EV008":22,"\\>　　　　\\C[17]※　　　　鬼をすべて倒した！　　　　※\n\\>　　　　※　報告しにチューリオ村へ戻ろう　　※\\C[0]":23,"EV009":24,"敵01":25,"<PsensorS:\\V[1166] Rv\\S[22]>":26,"敵に見つかっていない場合の戦闘":27,"探索範囲にプレイヤー侵入":28,"SmartPath 0 -1":29,"追跡しているプレイヤーと接触":30,"SmartPath 0 cancel":31,"敵に見つかっている場合の戦闘":32,"PSS t_stop":33,"戦闘から離脱したときの処理":34,"PSS t_start":35,"敵がプレイヤーを見失ったときの処理":36,"奴隷化性別：0=女、1=男、2=男女ランダム":37,"敵02":38,"「ムダンシンニュー！　ブッコロシテヨシ！」\\nw[女の鬼]":39,"敵03":40,"敵04":41,"案内板":42,"\n\\>　←チューリオ村　　　　　　　　芸術の町ペイサー→\\<":43,"初回イベント":44,"初回鉱山訪問イベント":45,"「この峠が\\C[17]抜け道\\C[0]になってるのか」\\nw[\\N[1]]":46,"「鬼さえいなくなれば、山の反対側まで安全に通り抜け\n　できるんですね」\\nw[\\N[2]]":47,"「ついでに鬼奴隷も確保できて一石二鳥だ。\n　さあ行くぜ、鬼退治！」\\nw[\\N[1]]":48},"extension":"json","dataType":"map","filename":"Map299","basename":"Map299.json","path":"data/Map299.json","relPath":"data/Map299.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":49,"percent":0},"cellInfo":[]},"data/Map300.json":{"data":[["火",""],["光",""],["ベッドの男",""],["EV004",""],["EV005",""],["指名手配されているので、外へ出るわけにはいかない。",""],["EV006",""],["燭台",""],["犯罪者1",""],["「実行するときは声をかけな。\n　いまから準備はしておくから――」\\nw[怪しい女]",""],["「いよいよだね。\n　金庫の中にいくら入ってるか楽しみだよ」\\nw[怪しい女]",""],["「火事場泥棒ってのは、趣味じゃないんだけどねぇ」\\nw[怪しい女]",""],["「結局、悪竜が暴れたのは王宮の辺りだけだったから、\n　火事場泥棒をする暇もなかったねぇ」\\nw[怪しい女]",""],["犯罪者2",""],["「あの家に隠し金庫があるって情報、ウラが取れたぜ。\n　あとは留守になれば――」\\nw[怪しい男]",""],["「決行日が決まったぞ。\n　その日、標的の家は留守になるはずだ」\\nw[怪しい男]",""],["「もしモンスターの襲撃で街が大混乱になったら、その時\n　こそ盗みのチャンスだぜ」\\nw[怪しい男]",""],["「ボスの命令で騒動を起こしてたときに悪竜が出現した\n　けど、あれはただの偶然だったのか……？」\\nw[怪しい男]",""],["ドア",""],["中から男女の甘い声が聞こえる。\nお楽しみ中のようだ。",""],["犯罪者3",""],["「ね、ねぇ、そんなことして大丈夫なの？\n　もし衛兵に見つかったら――」\\nw[挙動不審な女]",""],["「ほ、ほんとにやるの？\n　もし見つかったら、よくて奴隷、下手したら縛り首\n　なんだよ？」\\nw[挙動不審な女]",""],["「モ、モンスターが来たら、わたしは逃げるわよ！\n　命が惜しいもの！」\\nw[挙動不審な女]",""],["「悪竜は出たみたいだけど、モンスターの群れは来なかった\n　から良かったわ」\\nw[挙動不審な女]",""],["犯罪者4",""],["「姐さんのおかげで、仕事は万事順調でさぁ。\n　うぇへへへ……」\\nw[狡そうな男]",""],["「姐さん姐さん！\n　実はまたトラブルが起きちまって、助けてくれませんか？」\\nw[狡そうな男]",""],["「姐さん！　もし噂されてるみてぇに、悪竜が王都へ\n　来ちまったらどうしやしょう？！」\\nw[狡そうな男]",""],["「悪竜に街が壊されることも無かったし、これでまた\n　姐さんと一緒に後ろ暗い商売ができまさぁ」\\nw[狡そうな男]",""],["犯罪者5",""],["「またトラブったら、いつでも相談しな。\n　あたしのシマで勝手な真似するヤツは、絶対に許しちゃ\n　おかないからね！」\\nw[貫禄のある女]",""],["「詳しく話してごらん。\n　なぁに、イキがってる連中なんて、あたしがみんな\n　黙らしてやるよ」\\nw[貫禄のある女]",""],["「悪竜相手じゃあたしがメンチきっても無駄だろうしねぇ。\n　そんときゃ逃げるが勝ちさ」\\nw[貫禄のある女]",""],["「悪竜は倒されたけど、王様が替わっちまったからねぇ。\n　あたしらの商売、やりにくくなるかもよ？」\\nw[貫禄のある女]",""],["犯罪者6",""],["「ほ、ほんとに証拠は残らないんでしょうね……？」\\nw[怯えている女]",""],["「お陰で遺産は手に入れられたけど……ほんとに\n　バレない？　だいじょうぶかしら……」\\nw[怯えている女]",""],["「せっかく遺産を自分のものにできたのに、もしアルテト\n　なんかが来て、全部ダメになっちゃったら……」\\nw[怯えている女]",""],["「そ、そんなぁ！　約束が違うわ！\n　\\N[6]から財産を守ってくれるっていうから\n　預けたのに！」\\nw[怯えている女]",""],["犯罪者7",""],["「お前は主人の食事に薬を混ぜるだけでいい。\n　あとは我々に任せておけ」\\nw[陰気な男]",""],["「怯えることはない。\n　お前を疑う者など誰もいないさ」\\nw[陰気な男]",""],["「遺産の保全が心配なら、半分ほど預かってやろうか？\n　手数料はいただくがな」\\nw[陰気な男]",""],["「文句を言うのはお門違いだぞ？\n　預かり手数料が日毎に５割増になることは、契約書にも\n　ちゃんと書いてあるからな」\\nw[陰気な男]",""],["EV021",""],["『倉庫はいつも整理整頓！\n　できないヤツはブッ殺す！！』",""],["犯罪者8",""],["「俺は今まで、３桁の人間を殺してきた。\n　最初の一人を殺っちまえば、どうってことねぇのさ」\\nw[粗野な男]",""],["「俺が実戦の中で編み出した殺人術は、おいそれとは\n　教えられねぇな！」\\nw[粗野な男]",""],["「まあ俺が本気を出せば、伝説の悪竜も無事じゃ済まない\n　だろうな」\\nw[粗野な男]",""],["「悪竜を倒したのは謎の冒険者だって言われてるだろ？\n　何を隠そう実は……このオレなんだぜ？」\\nw[粗野な男]",""],["犯罪者9",""],["「３桁って、殺しのプロフェッショナルじゃねぇか……！\n　マジすげぇぜ！」\\nw[軽薄な男]",""],["「すげぇ！　殺人術だってよ！\n　俺にも教えてくれないかなぁ」\\nw[軽薄な男]",""],["「アルテトとも戦えるなんて、この人まじパネェぜ！」\\nw[軽薄な男]",""],["「アルテトを倒したってマジっすか！？\n　パネェや！」\\nw[軽薄な男]",""],["犯罪者10",""],["「その男、殺しに慣れているようなことを言ってるが、\n　全部ウソだぞ。信じるな」\\nw[冷淡な女]",""],["「あいつの腕の傷、自分の剣でうっかりつけたんだぞ。\n　まったく、大した殺人術だよ」\\nw[冷淡な女]",""],["「悪竜どころか、毒グモ相手に必死こいてた男が\n　なにを言ってるんだか……」\\nw[冷淡な女]",""],["「わたしにも勝てん男が、どうやって悪竜を倒したという\n　のやら。まったく……」\\nw[冷淡な女]",""],["プレイヤー1",""],["「なんで勝てないんだ！？\n　クソがっ！　イカサマしてんじゃねぇのか！？」\\nw[煩い男]",""],["「くそっ、またダメだッ！\n　今日はとことんツイてねぇぜ！！」\\nw[煩い男]",""],["プレイヤー2",""],["「フフフ……確率のなんたるかも知らないド素人に、\n　このボクが負けるはずもない」\\nw[得意げな男]",""],["「確率を考慮するボクは、今日もトータルでプラス収支さ。\n　すでに３０Ｇも儲けているよ」\\nw[得意げな男]",""],["観客1",""],["「なんだか分かんないけど、スゴーイ！\n　もっと勝って、そのお金で指輪買ってー\\I[29]」\\nw[色っぽい女]",""],["「なぁーんかさ、この人、勝つには勝つんだけど、\n　稼ぎ方がみみっちいのよね」\\nw[色っぽい女]",""],["観客2",""],["「なんで裸なのかって？\n　それは服まで賭けて、ボロ負けしたからだよ！」\\nw[裸の男]",""],["「今日もボロ負けして、服まで取られたんだ。\n　もう家のクローゼットにはパンツしか残ってないよ……」\\nw[裸の男]",""],["観客3",""],["「気をつけろ。\n　ここでイカサマをすると指を斬り落とされるぞ」\\nw[フードの男]",""],["「いまのところ、イカサマをしている者はいないようだ。\n　代償が指の切断となれば、誰でも躊躇するだろうからな」\\nw[フードの男]",""],["ボス",""],["「あんたがこの貧民街のボスか？\n　俺は――」\\nw[\\N[1]]",""],["「知っている。\n　ここへ来たのは、商船を襲った海賊について聞きたい\n　からだな？」\\nw[貧民街のボス]",""],["「えっ！？　どうしてそれを！？」\\nw[\\N[2]]",""],["「なにを驚く。\n　俺のこの情報収集力を頼って、ここまで来たのだろう？」\\nw[貧民街のボス]",""],["「それはそうなんだが……こんなに耳が早いとは、さすがに\n　驚いたぜ」\\nw[\\N[1]]",""],["「時間を無駄にするのは嫌いなのでな、結論から言うぞ。\\nw[貧民街のボス]",""],["「お前たちが欲しがっている情報には、心当たりがある」\\nw[貧民街のボス]",""],["「本当か！？」\\nw[\\N[1]]",""],["「その情報を教えてやってもいいが――」\\nw[貧民街のボス]",""],["「交換条件があるんだろ？\n　裏社会のボスから、タダで情報がもらえるとは\n　思っちゃいないさ」\\nw[\\N[1]]",""],["「話が早い男で助かる。\n　条件というのは、\\C[17]奴隷を使った交渉事\\C[0]だ」\\nw[貧民街のボス]",""],["「交渉？\n　誰かと奴隷の売買をしろということですか？」\\nw[\\N[2]]",""],["「少し違う。\n　奴隷を持参して、ある物と交換してきて欲しいのだ」\\nw[貧民街のボス]",""],["「相手はどこの誰だ？」\\nw[\\N[1]]",""],["「森に住まう、\\C[17]エルフの族長\\C[0]だ」\\nw[貧民街のボス]",""],["「なに！？\n　エルフの森に行って来いっていうのか！？」\\nw[\\N[1]]",""],["「それは無理ですよ！\n　エルフが人間や猫人を嫌っていることは、誰だって\n　知ってることです！」\\nw[\\N[2]]",""],["「しかも交渉相手が族長だなんて、絶対に会ってもらえま\n　せんよ！」\\nw[\\N[2]]",""],["「だからこその、奴隷の手土産だ。\\nw[貧民街のボス]",""],["「ハイエルフとダークエルフのあいだにある確執は\n　知っているか？」\\nw[貧民街のボス]",""],["「詳しくは知らんが、大昔にあったゴタゴタのせいで、\n　殺し合いをするほど反目し合ってるらしいな」\\nw[\\N[1]]",""],["「その通りだ。\n　奴らは人間に対する以上の憎しみを、肌の色が違う同族\n　に抱いている。\\nw[貧民街のボス]",""],["「そこを利用するのだ。\\nw[貧民街のボス]",""],["「敵対するエルフ族の奴隷を連れていけば、話くらいは聞いて\n　もらえるだろう。\\nw[貧民街のボス]",""],["「そこからの交渉は、お前たち次第だ」\\nw[貧民街のボス]",""],["「で、でも、下手するとエルフに集団で殺されちゃう\n　可能性もあるんじゃ……」\\nw[\\N[2]]",""],["「しくじれば、そうなるかもな。\\nw[\\N[1]]",""],["「で、そんな危険を冒してまで、なにが欲しいんだ？\n　よっぽどスゴイ物なんだろうな？」\\nw[\\N[1]]",""],["「持ち帰ってほしいのは、エルフのみが所有するという\n　\\C[17]『精霊性具』\\C[0]だ」\\nw[貧民街のボス]",""],["「せ、せいぐ……？\n　って、もしかして……」\\nw[\\N[2]]",""],["「俗に言う、大人のオモチャだな」\\nw[貧民街のボス]",""],["「おいおい、命がけで大人のオモチャをもらって\n　来いってか？」\\nw[\\N[1]]",""],["「大人のオモチャだろうが子供のオモチャだろうが、\n　金になるなら入手するまでだ。\\nw[貧民街のボス]",""],["「精霊性具を欲しいという好きモノの金持ちは、\n　この王都内だけですら、両手の指に余るほどいるのだ」\\nw[貧民街のボス]",""],["「確かに珍しい性具なら、使ってみたくもなりますよね\\I[29]」\\nw[\\N[2]]",""],["「世の中、変態だらけですね……」\\nw[\\N[2]]",""],["「お前たちならば、気難しいエルフとも交渉ができそう\n　だと、そう判断した。\\nw[貧民街のボス]",""],["「海賊に関する情報が欲しければ、精霊性具を入手\n　してこい」\\nw[貧民街のボス]",""],["「それが条件と言うなら、呑むしかないか。\n　いいだろう、交渉してきてやるよ。\\nw[\\N[1]]",""],["「そうそう、ひとつ大事なことを聞き忘れてた。\\nw[\\N[1]]",""],["「交渉相手のエルフってのは、どっちだ？\n　\\C[17]ハイエルフ\\C[0]か、それとも\\C[17]ダークエルフ\\C[0]か？」\\nw[\\N[1]]",""],["「\\C[17]どちらでもいい。\\C[0]\n　精霊性具は両方のエルフとも持っているはずだ。\\nw[貧民街のボス]",""],["「ちなみに集めた情報によれば、ハイエルフの長老は\n　\\C[17]金髪が好き\\C[0]で、ダークエルフの長老は\\C[17]貧乳好き\\C[0]らしいぞ。\\nw[貧民街のボス]",""],["「連れていく奴隷の選定に役立てるといい」\\nw[貧民街のボス]",""],["「お、おう……」\\nw[\\N[1]]",""],["「あ、あの、実はもうひとつお願いしたいことが\n　あるんですけど……」\\nw[\\N[2]]",""],["「なんだ？」\\nw[貧民街のボス]",""],["「\\C[17]わたしの父の行方\\C[0]についても、調べて欲しいんです。\n　別々に奴隷として売られたあと、どうなったか分から\n　なくて……」\\nw[\\N[2]]",""],["「人探しか。\n　情報が出てくるか確約はできないが、ついでに調べて\n　おいてやろう」\\nw[貧民街のボス]",""],["「あ、ありがとうございます！」\\nw[\\N[2]]",""],["「では行け。\n　吉報を待っているぞ」\\nw[貧民街のボス]",""],["氷雪の神殿・中央部",""],["ハイエルフの森",""],["地下遺跡・1層",""],["ダークエルフの森",""],["メインシナリオ\\C[17]『名声アップ』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「４」\\C[0]上がった！",""],["メインシナリオ\\C[17]『エルフとの交渉』\\C[0]を受けた！",""],["「さて、どちらのエルフ族と交渉するか……。\n　連れていく奴隷を間違えないよう気をつけないとな」\\nw[\\N[1]]",""],["「相手の好みを外して、交渉決裂にでもなったら\n　大変ですもんね」\\nw[\\N[2]]",""],["「行き先はハイエルフの森でも、ダークエルフの森でも\n　構わない。\n　精霊性具さえ持ち帰ってくればな」\\nw[貧民街のボス]",""],["精霊性具を持っていないとき",""],["「仰せの通り、エルフと交渉して譲ってもらったぜ。\n　これが\\C[17]精霊性具\\C[0]だ」\\nw[\\N[1]]",""],["「人間嫌いのエルフを相手に、五体満足で入手してきたか。\n　正直、少し驚いたぞ」\\nw[貧民街のボス]",""],["「俺たちなら交渉可能だって言ったのは、あんただろうが。\n　それに言うほど簡単じゃなかったんだぜ？」\\nw[\\N[1]]",""],["「そうですよ！\n　森はモンスターだらけだし、エルフはわたしたちのこと\n　殺す気満々でいるし！」\\nw[\\N[2]]",""],["「しかし目的を果たして、無事に戻ってきた。\n　お前たちには、それだけの力があったということだ。\\nw[貧民街のボス]",""],["「要求した通りに精霊性具を持ち帰ってきたからには、\n　こちらも約束を果たさねばな」\\nw[貧民街のボス]",""],["「じゃあ、海賊の件で有望な情報をもらえるのか？」\\nw[\\N[1]]",""],["「ああ。\n　結論から言うと、その猫人の父娘に濡れ衣をかけたという\n　商会は、裏で海賊どもと繋がっている」\\nw[貧民街のボス]",""],["「そんなっ、本当に……！？\n　\\N[3]が海賊なんかと……」\\nw[\\N[2]]",""],["「やっぱりか。そうだと思ってたぜ。\\nw[\\N[1]]",""],["「あのメスガキの商会は商売敵を潰せるし、海賊は\n　航海予定を教えられて簡単に獲物を襲える。\\nw[\\N[1]]",""],["「両方に利のある裏取引をしたわけだ」\\nw[\\N[1]]",""],["「そういうことになるな。\n　だが情報はこれで終わりではない。\\nw[貧民街のボス]",""],["「その\\N[3]という女、武器商ギルドのコネクションや\n　海賊どもまで動員して、何かを探しているようなのだ」\\nw[貧民街のボス]",""],["「探す？　いったい何をだ？」\\nw[\\N[1]]",""],["「詳しいことはつかめていない。\n　ただそれは\\C[17]『竜の鉤爪』\\C[0]という名の、古い道具かなにか\n　らしい」\\nw[貧民街のボス]",""],["「竜の……鉤爪……？」\\nw[\\N[2]]",""],["「そしてこれもあやふやな情報ではあるが、竜の鉤爪の\n　捜索は、\\C[17]王族の誰か\\C[0]の意向によるものらしい」\\nw[貧民街のボス]",""],["「なんだとっ？！　そりゃ本当か？」\\nw[\\N[1]]",""],["「そういえば\\N[3]、シーグヌースで会ったときに\n　王族とも取り引きしてるって自慢してましたよね」\\nw[\\N[2]]",""],["「竜の鉤爪というのは、よほど貴重なものらしい。\n　捜索にはかなり力を入れている様子だ。\\nw[貧民街のボス]",""],["「そのせいで、こちらにも情報が流れてきたのだ」\\nw[貧民街のボス]",""],["「なぁ、その捜索を命じた王族ってのが誰か、\n　調べることは出来るか？」\\nw[\\N[1]]",""],["「調べてどうする？\n　下手に首を突っ込むと、王族の権力によって潰される\n　かもしれんぞ」\\nw[貧民街のボス]",""],["「その権力を、逆手に取ってやろうっていうのさ。\\nw[\\N[1]]",""],["「メスガキより早く、俺たちが竜の鉤爪とやらを\n　見つけて持ち去ったら、どうなると思う？\\nw[\\N[1]]",""],["「役立たずのメスガキどもは王族の怒りを買って、\n　商会の経営にも大きな打撃を受けるんじゃないか？\\nw[\\N[1]]",""],["「そこで海賊との裏取引の事実を暴露してやれば、\n　一気に潰すことだって可能かもしれない」\\nw[\\N[1]]",""],["「落ち目になった商会に、海賊との密約疑惑が出れば\n　庇う者など誰もいない、というわけか」\\nw[貧民街のボス]",""],["「そうそう。\n　世間の信用を失えば、あっという間に終わりだ」\\nw[\\N[1]]",""],["「面白い話だ。\n　せいぜい頑張って竜の鉤爪を探すといい。\\nw[貧民街のボス]",""],["「だが、我々の助力は期待するな」\\nw[貧民街のボス]",""],["「おいおい、そりゃないだろ？\n　あんたらがうまく立ち回れば、傾いたメスガキの商会から\n　ガッポリいただくことだって、出来るはずだ」\\nw[\\N[1]]",""],["「だとしても、王族を敵に回しかねないとあっては\n　リスクが大きすぎる。\\nw[貧民街のボス]",""],["「その話には乗れないな。\n　提供できる情報もここまでだ」\\nw[貧民街のボス]",""],["「期待外れだぜ。\n　貧民街のボスともあろう者が、そんな臆病でいいのか？」\\nw[\\N[1]]",""],["「安い挑発に乗るつもりはない。\n　他に儲け話があるなら聞いてやってもいいが、\n　この件は終わりだ、いいな？」\\nw[貧民街のボス]",""],["「チッ……！」\\nw[\\N[1]]",""],["「あの……」\\nw[\\N[2]]",""],["「そうだったな。\n　もうひとつ、渡しておくべき情報があった。\\nw[貧民街のボス]",""],["「お前の父親だが、居所がつかめたぞ」\\nw[貧民街のボス]",""],["「ほっ、本当ですか！？　父はどこに！？」\\nw[\\N[2]]",""],["「意外にもすぐ近くにいて、見つけるのは簡単だった。\n　今は\\C[17]この貧民街にある小さな酒場\\C[0]で働いている」\\nw[貧民街のボス]",""],["「この街に！？\n　じゃあ、これからすぐ会いに行けるんですね！？」\\nw[\\N[2]]",""],["「ここを出て少し北に行ったところにある、\\C[17]緑の屋根の\n　建物\\C[0]がその酒場だ」\\nw[貧民街のボス]",""],["「良かったじゃないか。\n　奴隷身分のままじゃ、また一緒に暮らすってわけには\n　いかんだろうが」\\nw[\\N[1]]",""],["「それでも、生きて再会できるだけで嬉しいです！」\\nw[\\N[2]]",""],["「約束は果たした。\n　これでお前たちとの仕事は終わりだ」\\nw[貧民街のボス]",""],["「欲しいモノは手に入ったから、もう用無しってか？」\\nw[\\N[1]]",""],["「いいや、お前らが使えることは十分にわかったからな。\n　今後とも付き合いは続けていきたいと思っている」\\nw[貧民街のボス]",""],["「そいつはどうも」\\nw[\\N[1]]",""],["「もし他にも金になる話があれば、いつでもこのアジトの\n　入り口をくぐるがいい」\\nw[貧民街のボス]",""],["「ああ。次は俺の口車に乗ってくれることを期待しとくぜ」\\nw[\\N[1]]",""],["「フン……。\n　リスクとリターンの天秤が釣り合うなら、そのときは\n　考えてやろう」\\nw[貧民街のボス]",""],["メインシナリオ\\C[17]『エルフとの交渉』\\C[0]を達成した！",""],["\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！",""],["「それじゃ早速、お前の親父に会いに行くか。\n　俺も挨拶しておきたいしな」\\nw[\\N[1]]",""],["「えぇっ！？\n　挨拶って、\\N[1]さん？　も、もしかして……\n　\\}娘さんをください的な……ゴニョゴニョ……\\{」\\nw[\\N[2]]",""],["「娘さんのアソコの具合は最高です――と、ちゃんと\n　褒めておいてやるからな」\\nw[\\N[1]]",""],["「じゃあわたしも、\\N[1]さんのオチンチンの具合\n　を、父にいっぱい語って聞かせます\\I[29]」\\nw[\\N[2]]",""],["「お前の親父に殺されたくはないから、やっぱりそういう\n　話は無しでいこう。な？」\\nw[\\N[1]]",""],["「やめてください。\n　\\N[1]さん刺したあと、わたしも自刃して\n　果てますよ？」\\nw[\\N[2]]",""],["「じょ、冗談だ冗談。\n　よく出来た娘さんだって褒めておくから、怒るな」\\nw[\\N[1]]",""],["\\>　　※　貧民街にいるユマの父親のところへ行こう。　※\n\\>　　※　\\C[17]緑の屋根の小さな酒場\\C[0]にいるらしい。　　　　※\\<",""],["「ここを出て少し北に行ったところにある、\\C[17]緑の屋根の\n　建物\\C[0]が目的の酒場だ。\n　猫人娘の父親はそこにいるはずだ」\\nw[貧民街のボス]",""],["「金になる話は持ってきたか？\n　無いのなら去れ。時間を浪費させるな」\\nw[貧民街のボス]",""],["アジト",""],["「このアジトは自由に使ってかまわん。\n　ただし街中へは出るな」\\nw[貧民街のボス]",""],["「分かってるさ。\n　俺たちの変装は通用しないようだからな」\\nw[\\N[1]]",""],["「向こうにある倉庫に、\\C[17]密輸用の抜け穴\\C[0]がある。\n　移動したいときは、そこを使え。\\nw[貧民街のボス]",""],["「悪竜と戦う準備が整ったら、俺に知らせろ。\n　約束通りサポートをしてやる」\\nw[貧民街のボス]",""],["「ああ、頼むぜ」\\nw[\\N[1]]",""],["\\>　　※　決戦の準備ができたら、\\C[17]貧民街のボス\\C[0]に　※\n\\>　　※　話しかけよう。　　　　　　　　　　　　※\\<",""],["「戦いの準備はもういいのか？」\n\\>　\\C[18]※ここから先、ゲームクリアまで行動が制限されます※\\C[0]\n\\>　\\C[18]※悪竜討伐が終わるまで戻ることはできません　　　※\\C[0]\\nw[貧民街のボス]",""],["決戦に行く",""],["まだ行かない",""],["推奨レベル未満",""],["最終決戦は\\C[17]レベル１４以上推奨\\C[0]となります。\nこのまま行きますか？",""],["行く",""],["行かない",""],["「作戦は単純だ。\\nw[\\N[1]]",""],["「あんたら貧民街のヤクザ者が、王都の各所で騒動を\n　起こして、兵士たちを混乱させる。\\nw[\\N[1]]",""],["「その隙に俺たちが王宮へ入り、\\N[6]を倒す」\\nw[\\N[1]]",""],["「ふぅむ……。\\nw[貧民街のボス]",""],["「だが、そう簡単に王宮へ入れるか？」\\nw[貧民街のボス]",""],["「そこは任せておけ」\\nw[\\N[1]]",""],["「必ず\\N[1]さんとわたしで、\\N[6]を\n　倒してきます！」\\nw[\\N[2]]",""],["「いいだろう、すでにお前たちに賭けると決めた身だ。\n　その言葉を信じて動いてやる」\\nw[貧民街のボス]",""],["「\\N[2]、どうしても行くのニャ？」\\nw[\\N[2]の父]",""],["「うん。自分で決めたことだから」\\nw[\\N[2]]",""],["「私もついて行ってやりたいけど……腰が……。\n　役に立たない父親でごめんニャ……」\\nw[\\N[2]の父]",""],["「後でとびきりいい酒を奢ってあげるから、あんたたち\n　必ず帰ってきなさいよ」\\nw[マスター]",""],["「お前たちが勝たないと、私の学者生命まで終わりなんだ\n　からな！　本当に頼んだぞ！」\\nw[伝承学者]",""],["「任せておけ。\n　俺の人生、これまで成るように成ってきたんだ。\\nw[\\N[1]]",""],["「今回だってどうにかなるさ」\\nw[\\N[1]]",""],["「とてつもなく不安ニャ……」\\nw[\\N[2]の父]",""],["「だがこの男しか、悪竜に勝つ見込みのある者はいない\n　のだろう？\\nw[貧民街のボス]",""],["「サイコロはすでに振った。\n　あとは期待して出目を待つしかない」\\nw[貧民街のボス]",""],["「ああ、期待しとけ。\n　ここにあるのはイカサマを仕込んだサイコロだからな」\\nw[\\N[1]]",""],["C_ADD_TIME \\V[1]",""],["「フン……王になれるチャンスを棒に振るとはな。\n　もっともお前がその器だとも思えんが」\\nw[貧民街のボス]",""],["トークマーク",""],["ユマ",""],["EV035",""],["密輸通路入り口",""],["どこへ行きますか？",""],["王都の外",""],["自宅if(s[1461])",""],["闘技場",""],["自宅","Player home"],["EXITマーク",""],["ユマ父",""],["「私たちは大丈夫ニャから、自分のことだけ考えて\n　無茶をしないようにするんニャよ？」\\nw[\\N[2]の父]",""],["マスター",""],["「私たちも兵士から、反逆者の一味扱いされちゃってね。\n　ボスに頼んでここに匿ってもらってるの」\\nw[マスター]",""],["伝承学者",""],["「不本意だが、いまは雌伏のときだ。\n　さっさと\\N[6]を倒してきてくれ」\\nw[伝承学者]",""],["睡眠処理",""],["ギャンブラー",""],["「そのうち気が向いたら、あんたとも勝負をして\n　やろうかの」\\nw[ギャンブラー]",""],["特定アイテムを賭けての勝負\n↓　　↓　　↓",""],["「この老体とギャンブルをやってみるかね？\n　もしキミが勝ったら\\C[17]戦斧\\C[0]をあげよう。\\nw[ギャンブラー]",""],["「だがワシが勝ったときは、その猫人の美少女の\n　\\C[27]お尻を見せてもらおうかね。\\C[0]かまわんかな？」\\nw[ギャンブラー]",""],["勝負を受ける",""],["やめておく",""],["奴隷カードの説明",""],["PNDK_LC getSurplusWeights 15",""],["↓積載重量空きOK",""],["賞品の重量が\\C[18]\\v[17]Ｗ\\C[0]オーバーしてしまうため、勝負を\n受けられません。\n積載重量に余裕を作ってください。",""],["「よしっ、勝負じゃ！！」\\nw[ギャンブラー]",""],["勝利（戦利品ゲット）",""],["「ワシも老いたかのぅ。\n　負けは負けじゃ、この戦斧を持っていきなされ」\\nw[ギャンブラー]",""],["Lv1~6",""],["武器\\C[17]『\\wn[98]』\\C[0]を手に入れた！",""],["Lv6~9",""],["武器\\C[17]『\\wn[103]』\\C[0]を手に入れた！",""],["Lv9~11",""],["武器\\C[17]『\\wn[106]』\\C[0]を手に入れた！",""],["Lv12~14",""],["武器\\C[17]『\\wn[111]』\\C[0]を手に入れた！",""],["Lv15~",""],["武器\\C[17]『\\wn[115]』\\C[0]を手に入れた！",""],["引き分け",""],["「引き分けとは残念じゃな。\n　まあ、こういうこともあるわい」\\nw[ギャンブラー]",""],["敗北（ユマ凌辱）",""],["「ほっほう！　ワシが勝ってしまったね。\n　ではお尻を見せてくれるかな？」\\nw[ギャンブラー]",""],["「はい、若い女の子のお尻ですよぉ～\\I[29]\n　じっくり見て、オチンチン元気にしてくださいね\\I[29]」\\nw[\\N[2]]",""],["「恥じらいのないスケベ娘らしい、スケベな尻じゃな！」\\nw[ギャンブラー]",""],["「いい歳してお尻見せろとか……バカみたい！\n　これでいいですか！？　満足しました！？」\\nw[\\N[2]]",""],["「そう怒らんと、もうちょっと見せい。\n　やはり若い尻は良いものじゃなぁ」\\nw[ギャンブラー]",""],["\\N[2]の発情度が\\C[17]「１」\\C[0]上がった！\n\\N[2]の信頼度が\\C[18]「１」\\C[0]下がった！",""],["現金を賭けての勝負（繰り返し）\n↓　　↓　　↓",""],["「現金を賭けて勝負するかい？」\n（※賭け金は\\C[17]『\\v[1170]G』\\C[0]です）\\nw[ギャンブラー]",""],["賭ける",""],["現金がある",""],["現金なし",""],["「おいおい、金がないんじゃ勝負が成立せんぞ」\\nw[ギャンブラー]",""],["勝利（賭け金ゲット）",""],["「ふぅむ、今日はツイておらんな……」\\nw[ギャンブラー]",""],["\\C[17]『\\v[1170]G』\\C[0]を手に入れた！",""],["敗北（賭け金没収）",""],["「ワシの勝ちじゃ。\n　まあこちとら年季が違うからの」\\nw[ギャンブラー]",""],["\\C[9]『\\v[1170]G』\\C[0]を失った！",""],["EV045",""],["EV046",""],["EV047",""],["ギャンブルふきだし",""],["宝箱（お金右開き）",""],["<TE:17>",""],["↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。",""],["EV050",""]],"context":[["Map300/events/1/