cの場合はoptionキー)\n":47,"Shift+マウス ： ウィンドウや画像がオブジェクトや画面端にスナップしなくなります。\n":48,"コンソールに「changePos(x, y);」(x:X座標、y:Y座標)と打ち込むと直前に編集したウィンドウ位置を変更できます。\n":49,"Ctrl+S ： 全ての変更を保存します。\n":50,"Ctrl+C ： 直前に操作した座標をクリップボードにコピーします。\n":51,"Ctrl+Z ： 直前に行った操作を元に戻します。\n":52,"Ctrl+Shift+Enter ： 表示している画面の配置を全てリセットしてロードし直します。\n":53,"右クリック ： ウィンドウの枠（もしくはウィンドウ全体）の表示/非表示を切り替えます。\n":54,"数字キー ： ウィンドウの範囲内で押下すると、以下のとおり対応するプロパティを変更できます。\n":55," 1. ウィンドウの横幅(※1)\n":56," 2. ウィンドウの高さ(直接指定)(※1)\n":57," 3. ウィンドウの余白(※2)\n":58," 4. ウィンドウのフォントサイズ(※2)\n":59," 5. ウィンドウの1行のあたりの高さ(※2)\n":60," 6. ウィンドウの背景透明度(※2)\n":61," 7. ウィンドウの行数(※2)\n":62," 8. ウィンドウの背景画像ファイル名\n":63," 9. ウィンドウのフォント名(※3)\n":64,"※1 JS計算式を適用できます。計算式は入力したその場で1回だけ評価されます。\n":65,"※2 JS計算式を適用できます。計算式は保存され、画面表示のたびに再評価されます。\n":66,"分からない場合、今まで通り数値を設定すれば問題ありません。\n":67,"※3 あらかじめフォントをロードする必要があります。「フォントロードプラグイン」をお使いください。\n":68,"入手先：raw.githubusercontent.com/triacontane/RPGMakerMV/master/FontLoad.js\n":69,"※4 Macの場合、Ctrlキーはoptionキーで代用してください。（commandキーでは反応しません）\n":70,"-----------------------------------------------------------------------------------------------------\n":71,"以下の操作ログが表示されます。\n":72,"X座標[":73,"]をクリップボードにコピーしました。":74,"Y座標[":75,"text":76,"すべての変更を保存しました。":77,"左記の番号の操作を元に戻しました。":78,"shift":79,"自動保存により変更が保存されました。":80,"fs":81,"/data/":82,"rgba(255,255,255,1.0)":83,"X:[":84,"] Y:[":85,"位置を変更しました。":86,"背景の表示/非表示を変更しました。":87,"の値を":88,"に変更しました。":89,"num1":90,"横幅":91,"width":92,"num2":93,"高さ":94,"height":95,"num3":96,"_customPadding":97,"num4":98,"_customFontSize":99,"num5":100,"_customLineHeight":101,"num6":102,"背景の透明度":103,"_customBackOpacity":104,"num7":105,"行数":106,"_customLineNumber":107,"num8":108,"背景画像のファイル名":109,"_customBackFileName":110,"num9":111,"フォント名":112,"_customFontFace":113,"を入力してください。":114,"endX":115,"endY":116,"プラグインコマンドの実行中にエラーが発生しました。":117,"- コマンド名 　: ":118,"- コマンド引数 : ":119,"- エラー原因   : ":120,"解除_メッセージウィンドウ":121,"_UNLOCK_MESSAGE_WINDOW":122,"固定_メッセージウィンドウ":123,"_LOCK_MESSAGE_WINDOW":124,"解除_選択肢ウィンドウ":125,"_UNLOCK_CHOICE_WINDOW":126,"固定_選択肢ウィンドウ":127,"_LOCK_CHOICE_WINDOW":128,"$dataContainerProperties":129,"ContainerProperties.json":130,"ContainerPropertiesMobile.json":131,"が見付かりませんでした。":132,"data/":133,"GET":134,"application/json":135,"x":136,"y":137,"ファイルが見付からなかったので、左記の番号の変更を戻しました。":138,"IconSet":139,"left":140,"center":141,"right":142},"basename":"GraphicalDesignMode.js","filename":"GraphicalDesignMode.js","extension":".js","dirname":"js/plugins","path":"js/plugins/GraphicalDesignMode.js","progress":{"translated":0,"length":143,"percent":0},"indexIsBuilt":false,"relPath":"js/plugins/GraphicalDesignMode.js","originalFormat":"Autogenerated TRANS obj","type":"","cellInfo":[]},"js/plugins/FTKR_GDM_WindowEditor.js":{"data":[["FTKR_GDM_WindowEditor",""],["autoCreate",""],["Font Size",""],["Window Padding",""],["Window Line Height",""],["Window Opacity",""],["Hide Frame",""],["Window Background Image Name",""],["Scene Background Image Name",""],["Command Position X",""],["Command Position Y",""],["Command Width",""],["Command Max Cols",""],["Command Align",""],["left",""],["Common Width",""],["Common Height",""],["Actor Status Space",""],["Actor Status Space In Text",""],["Actor Status Width Rate",""],["Select Width",""],["Select Height",""],["Select Max Cols",""],["Select Cursor Height",""],["Select Status Space",""],["Select Status Space In Text",""],["Select Status Width Rate",""],["GraphicalDesignMode",""],["ON",""],["TRUE",""],["AutoSave",""],["自動保存",""],["GridSize",""],["グリッドサイズ",""],["直接入力",""],["Scene_Item",""],["Scene_Skill",""],["Scene_Equip",""],["Scene_Status",""],["Scene_Save",""],["Scene_Load",""],["Scene_Options",""],["Scene_OSW",""],["なし",""],["シーン終了",""],["シーン変更",""],["コモンイベント",""],["ウィンドウアクティブ",""],["Window_OswCommon",""],["Window_OswCommand",""],["Window_OswSelect",""],["subConfig",""],["COMMAND",""],["HANDLER",""],["window",""],["値を入力してください",""],["ACTOR",""],["CLASS",""],["SKILL",""],["ITEM",""],["WEAPON",""],["ARMOR",""],["ENEMY",""],["TROOP",""],["STATE",""],["VARIABLE",""],["SWITCH"