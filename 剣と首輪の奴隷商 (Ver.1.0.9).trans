ら夜"]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]}],[{"headerIndex":2,"headerParam":["↓拾得奴隷の種類決定"]},{"headerIndex":2,"headerParam":["↓拾得奴隷の種類決定"]},{"headerIndex":2,"headerParam":["↓拾得奴隷の種類決定"]},{"headerIndex":2,"headerParam":["↓拾得奴隷の種類決定"]}],null,null,null,null,[{"headerIndex":15,"headerParam":["依頼を引き受けている場合、暴漢と戦闘"]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["",0,0,1]}],[{"headerIndex":50,"headerParam":["暴漢と戦闘"]}],[{"headerIndex":54,"headerParam":["",0,0,2]}],[{"headerIndex":58,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,null,null,null,[{"attachment":"scriptCommand/16944098097455084.js","start":0,"end":6,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098097458828.js","start":0,"end":6,"leftHand":{"type":"","context":[]}}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]},{"headerIndex":4,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"attachment":"scriptCommand/16944098097468366.js","start":0,"end":6,"leftHand":{"type":"","context":[]}},{"attachment":"scriptCommand/16944098097464808.js","start":0,"end":6,"leftHand":{"type":"","context":[]}}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"attachment":"scriptCommand/16944098097463222.js","start":0,"end":4,"leftHand":{"type":"","context":[]}}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,null,null,null,[{"headerIndex":10,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":26,"headerParam":["街中イーグルダイブ"]}],[{"headerIndex":28,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"宿屋入り口":0,"宿屋":1,"ギルド入り口":2,"商業ギルド":3,"武器屋入り口":4,"武器防具店":5,"装飾品店入り口":6,"アクセサリ店":7,"魔法具屋入り口":8,"魔法具店":9,"高級品店入り口":10,"卸売商会":11,"聖堂入り口":12,"聖堂":13,"馬車屋":14,"王国官吏（依頼30）":15,"依頼を出している場合":16,"EV010":17,"EV011":18,"EV012":19,"EV013":20,"EV014":21,"EV015":22,"EV016":23,"EV017":24,"EV018":25,"EV019":26,"EV020":27,"EV021":28,"EV022":29,"女性":30,"「人間も猫人も、神々の前ではひとしく平等よ」\\nw[信心深い女]":31,"依頼フキダシ":32,"男性":33,"「海賊がたびたび出没してるのに、それでも海に出ようと\n　してる商船があるみたいだ。\\nw[地元の男]":34,"「まあ交易しないと借金ばかり膨れるから、仕方ない\n　んだろうけど」\\nw[地元の男]":35,"「波の音を子守歌にして、俺たち地元の人間は育てられて\n　きたんだ」\\nw[地元の男]":36,"工事監督官（依頼31）":37,"「港の方で商船護衛の人員を募集してるようだ。\n　オレも現役だったら、応じていたかもしれないな」\\nw[元冒険者]":38,"「海賊退治に参加したことがあるけど、あいつらは船の\n　上での戦いに慣れてるから、かなり手こずったよ」\\nw[元冒険者]":39,"「このボロボロの剣を研ぎ直してもらうか、それとも新しい\n　剣を買うか……うーん、悩ましい……」\\nw[冒険者]":40,"研究者（依頼32)":41,"おっぱいマニア（依頼18）":42,"執事（依頼21）":43,"スケベじじい（依頼19）":44,"街ズームアウト":45,"P_D_FILENAME name_town\\V[101]":46,"「ウェーベロイだ！\n　久しぶりってほどでもないのに、なんだか懐かしいなぁ」\\nw[\\N[2]]":47,"「ここに来たことがあるのか？」\\nw[\\N[1]]":48,"「はい。実家の商売上、この町には毎年のように船で\n　立ち寄ってました」\\nw[\\N[2]]":49,"「勝手知ったる場所ってわけだ」\\nw[\\N[1]]":50,"「そこまでじゃありませんけど、まあ多少は……。\\nw[\\N[2]]":51,"「あ、港に行くなら西の方ですよ！」\\nw[\\N[2]]":52,"「それくらいなら俺でも分かるんだが……」\\nw[\\N[1]]":53,"ロープ(下)":54,"マストに登りますか？":55,"登る":56,"登らない":57,"ロープ":58,"依頼掲示板":59,"掲示板マーク":60,"兵士":61,"兵士（追跡）":62,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":63,"馬車":64,"通行遮断":65,"食料品店":66,"尾行対象（依頼13・14・15）":67,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":68,"難易度ノーマル用":69,"難易度イージー用（振り向く前に立ち止まる時間が倍）":70,"視界範囲に引っかかったとき":71,"SmartPath 0 66 0":72,"周囲2マス圏内に侵入したとき":73,"尾行に気づいて逃走":74,"浮気相手の元へゴールしたとき":75,"ターゲット表示":76,"浮気調査（依頼13・14・15）":77,"浮気相手(依頼11)":78,"船長":79,"護衛雇い入れEv":80,"「なんだお前らは？　なにか用か？」\\nw[船長]":81,"「えぇっと……こちらでシーグヌース行きの商船の護衛を\n　募集していると聞きまして」\\nw[\\N[2]]":82,"「俺たちは冒険者ギルド所属の冒険者だ。\n　雇ってもらいたくて来た」\\nw[\\N[1]]":83,"「ほう、そうか！　ギルドの冒険者なら雇ってもいいな。\\nw[船長]":84,"「そっちの娘はともかく、お前は腕が立ちそうだ。\n　軽く１０人や２０人は暗殺してるって面構えだな」\\nw[船長]":85,"「してねぇよッ！！」\\nw[\\N[1]]":86,"「では雇ってくださるということで、いいですか？」\\nw[\\N[2]]":87,"「おう、いいぜ！　とりあえずこれが契約金だ。\n　よろしく頼むぜ」\\nw[船長]":88,"契約金として\\C[17]\\v[1]Ｇ\\C[0]を得た！":89,"「これで護衛の数もじゅうぶんに揃ったし、お前らの\n　準備が出来次第、すぐに出発するぞ！」\\nw[船長]":90,"商船に乗って出航しますか？":91,"出航する":92,"まだ行かない":93,"「海賊どもから船を守りつつシーグヌースへ渡るために、\n　当船では護衛を募集している！\\nw[船長]":94,"「ただし身許の不確かなゴロツキは雇わんぞ！\n　冒険者なら、最低限ギルドに入会してから来い！」\\nw[船長]":95,"「普段は運賃をもらって\\C[17]島の町シーグヌース\\C[0]まで\n　同乗させてやってるんだが……。\n　今は海賊が暴れ回っているから船を出せんのだ」\\nw[船長]":96,"船マーク":97,"個別依頼20":98,"童貞卒業式":99,"「長距離の航海ってのは危険がつきものでね、\n　いつ命を落とすか分かったもんじゃないのさ。\\nw[女船長]":100,"「だから死んでも悔いが残らないよう、新米水夫どもは、\n　初の長距離航海の前に童貞を捨てるのが習わしに\n　なってるんだ」\\nw[女船長]":101,"「童貞ってテクニックは無いでしょうけど、性欲はすごく\n　旺盛でしょうね\\I[29]」\\nw[\\N[2]]":102,"「ウチの船にも今度、そういう性欲を持て余した新米どもが\n　何人か入ったんだよ。\\nw[女船長]":103,"「そ……そうなんですか、へぇ……」\\nw[\\N[2]]":104,"「ウチの船にも今度、新米どもが何人か入ったんだよ。\\nw[女船長]":105,"「もうちょっと若けりゃ、あたしが童貞卒業の相手を\n　してやってもいいんだけど――。\\nw[女船長]":106,"「この歳で若い男を何人も相手するのは、さすがにキツい\n　からねぇ」\\nw[女船長]":107,"「なら、金をやって娼館に行かせるのか？」\\nw[\\N[1]]":108,"「これまではそうしてたけど、少し前にウチの水夫の一人が\n　酔って暴れてから娼館は出入り禁止になっちまったのさ。\\nw[女船長]":109,"「そこであんたらにお願いだ。\n　新米どもの童貞チンコを突っ込むための奴隷を、用意して\n　くれないか？」\\nw[女船長]":110,"「なるほど。で、希望の奴隷はどんなのだ？」\\nw[\\N[1]]":111,"「新米どもの要望を総合すると、\\C[17]褐色肌の人間\\C[0]で、\\C[17]胸は\n　大きすぎず小さすぎず\\C[0]――だそうだ。\\nw[女船長]":112,"「注文通りの女を用意できるなら、この貴重な\\C[17]\\in[27]\\C[0]と\n　\\C[17]\\in[28]\\C[0]を４個ずつやろう。\n　それと海岸で拾った\\C[17]奇妙な玉っころ\\C[0]もくれてやる」\\nw[女船長]":113,"個別依頼『童貞卒業式』を受けますか？":114,"受ける":115,"受けない":116,"古代遺跡・中央部":117,"火の洞窟":118,"個別依頼\\C[17]『童貞卒業式』\\C[0]を受けた！":119,"\\C[17]『\\in[112]』\\C[0]を依頼者に渡しますか？":120,"渡す":121,"渡さない":122,"依頼条件達成":123,"「お望みの通りの奴隷を連れてきたぞ。\n　さあ、確認してくれ」\\nw[\\N[1]]":124,"「ふむふむ……いいね、健康で頑丈そうだ。\\nw[女船長]":125,"「性欲のたぎってる若造どもに犯されるわけだから、\n　体が丈夫に越したことはない。\\nw[女船長]":126,"「いいだろう、この奴隷をいただこうか」\\nw[女船長]":127,"個別依頼\\C[17]『童貞卒業式』\\C[0]を達成した！":128,"\nここからエッチイベント\n↓　　↓　　↓":129,"↓プレーヤー位置強制中央":130,"SFC_ENABLE_RESERVE":131,"依頼条件未達成":132,"「早いとこ奴隷を持ってきておくれよ。\n　うちの新米水夫どもも、首を長くして待ってるからさ」\\nw[女船長]":133,"兵士（追跡）2":134,"「ここのところ密輸が増えているから、より厳しく\n　目を光らせねば！」\\nw[兵士]":135,"奴隷市":136,"奴隷市（フキダシ）":137,"奴隷市（通行不可）":138,"漁師":139,"海産物売買フキダシ":140,"男性市民1":141,"「王都や副都は悪竜のせいで大変だったそうだが、\n　この町は至って平和なものさ」\\nw[男性]":142,"「この町を流れ過ぎていく商品の数は膨大なものだ。\n　ここは流通の要衝地なのさ」\\nw[男性]":143,"女性市民1":144,"「恋人が外国行きの商船に乗ったまま、二年間も戻って\n　来ないの。\n　やっぱりもう、あの人は……」\\nw[女性]":145,"女性市民2":146,"「今日の晩ごはんは、なんのお魚にしようかしら？」\\nw[主婦]":147,"男の子1":148,"「オレは海のおとこだから、将来は父ちゃんと一緒に\n　船に乗るんだ！」\\nw[男の子]":149,"女の子1":150,"「この花はわたしが育てました！\n　きれいでしょ？」\\nw[女の子]":151,"港湾労働者1":152,"「来る日も来る日も、倉庫と船を往復しての荷物運び。\n　イヤになっちゃうぜ」\\nw[労働者]":153,"水夫1":154,"「できればもうちょっと載せたいけど、船の積載量\n　ギリギリだからなぁ……」\\nw[水夫]":155,"水夫2":156,"「輸出の準備をしちゃいるけど、出航はいつになるやら。\n　まったく、海賊どもめ……」\\nw[水夫]":157,"「輸出用の酒樽はこれでよし……と。\n　あとは麦と染料の準備を――」\\nw[水夫]":158,"女性市民3":159,"「そうよ、いま無理して船に乗ることなんてないわ」\\nw[女性]":160,"「お願いだから、無事に帰ってきてちょうだい」\\nw[女性]":161,"男性市民2":162,"「シーグヌースまで行きたいが、船がないんじゃ仕方ない。\n　しかし、海賊はいつになったら大人しくなるんだ？」\\nw[男性]":163,"「そんなに心配しなくて大丈夫さ。\n　シーグヌースまで往復してくるだけなんだから」\\nw[男性]":164,"女性市民4":165,"「あら珍しい。\n　深海魚が混じってるわ」\\nw[老婦人]":166,"男の子2":167,"「ぺス！\n　お手ッ――からの空中三回転半ひねり！」\\nw[男の子]":168,"犬":169,"（無理言うなボケ！）\\nw[ペス]":170,"女性市民5":171,"「海風の強い日は、洗濯物が飛ばされちゃうことも\n　しょっちょうなのよ」\\nw[主婦]":172,"奴隷1":173,"「休みなく荷物の上げ下ろし……。\n　俺の一生はこれだけで終わっちまうのか……？」\\nw[奴隷]":174,"奴隷2":175,"「カッとなって友人を殺してしまった報いが、この\n　境遇なんだ。\n　甘んじて受け入れるしかないよ……」\\nw[奴隷]":176,"奴隷3":177,"（隙を見て、絶対に逃げ出してやる……！）\\nw[人間奴隷]":178,"奴隷4":179,"（おのれ人間め！　この屈辱は忘れんぞ！）\\nw[エルフ奴隷]":180,"奴隷5":181,"（オナカヘッタ……）\\nw[鬼奴隷]":182,"水夫3":183,"「海賊のせいで出航できなくて、余計な出費ばかり増えて\n　いくよ」\\nw[水夫]":184,"「いいか奴隷ども！　舟の上に逃げ場はない！\n　痛い目にあいたくなければ大人しくしていろ！」\\nw[水夫]":185,"民家入り口":186,"民家":187,"自宅入り口":188,"自宅":189,"EV105":190,"売り家表示":191,"EV107":192,"ＢＧＭ変更":193,"夜間用ＢＧＭ演奏":194,"夜→昼":195,"最初から昼":196,"昼→夜":197,"最初から夜":198,"盗賊1":199,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":200,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":201,"「邪魔をするなら殺す！」\\nw[蛮族]":202,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":203,"奴隷化性別：0=女、1=男、2=男女ランダム":204,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":205,"戦闘マーク1":206,"景気ランタン":207,"落ちてる精霊石（街）":208,"依頼01・02戦闘":209,"依頼を引き受けている場合、暴漢と戦闘":210,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":211,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":212,"暴漢と戦闘":213,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":214,"襲ってきた暴漢を街の警備兵に引き渡した。":215,"暴漢":216,"猫":217,"レイプ魔":218,"レイプ被害者":219,"レイプマーク":220,"レイプEv向き合わせ":221,"レイプEv発生制御":222,"レイプ現場遭遇":223,"街中盗賊出没":224,"淫行男1":225,"卑猥な男":226,"「街で女とすれ違うたびによぉ、股間がうずいて\n　仕方ねぇんだ。つい襲っちまいそうになる」\\nw[\\v[1655]]":227,"「ハァハァ、エロそうな女がいるじゃねぇか！\n　そのメス奴隷、使わせろよ！！」\\nw[\\v[1655]]":228,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":229,"売春させる":230,"やめておく":231,"淫行表示":232,"街中淫行制御":233,"淫行男2":234,"残虐な男":235,"「明日あたり、土左衛門が上がるかもしれねぇなぁ。\n　……さっきちぃっとばかし、やっちまってな」\\nw[\\v[1655]]":236,"「暴力振るったあとは、やたらと女を抱きたくなりやがる。\n　ってぇわけで、その奴隷ちっと貸せや」\\nw[\\v[1655]]":237,"水死体":238,"娼館":239,"見張り台(降り口)":240,"マストを降りますか？":241,"降りる":242,"降りない":243,"フクロウ":244,"マップ取得":245,"FocusCamera 55 32 120":246,"ZoomOut 3 120":247,"\\C[17]\\V[909]の地図\\C[0]を取得した！":248,"ResetZoom 60":249,"ResetFocus 60":250,"街中イーグルダイブ":251,"ここから飛び降りますか？":252,"飛び降りる":253,"やめる":254,"水柱1":255,"「勝手にマストに登ったりするなよ。\n　落ちても責任は取れないからな」\\nw[水夫]":256,"侵入不可":257,"掲示板依頼初期化おばあちゃん":258,"<TE:110>":259,"四聖教メッセンジャー":260,"<TE:112>":261,"会話マーク(EX)":262,"<TE:113>":263},"extension":"json","dataType":"map","filename":"Map056","basename":"Map056.json","path":"data/Map056.json","relPath":"data/Map056.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":264,"percent":0.7575757575757576},"cellInfo":[]},"data/Map057.json":{"data":[["水車",""],["武器屋入り口",""],["宿屋",""],["家具職人",""],["EV005",""],["EV006",""],["EV007",""],["EV008",""],["羊",""],["村人（奴隷買い取り）",""],["奴隷市（フキダシ）",""],["農作物売買フキダシ",""],["農民",""],["ニワトリ",""],["牧羊犬",""],["農婦",""],["「ウチの人も、せめてこれくらいの大きさがあれば……」\\nw[農婦]",""],["「西へ行くと港町ウェーベロイよ。\n　この村の特産品は、そこから海路であちこちに運ばれて\n　いるの」\\nw[主婦]",""],["女の子",""],["「メロンすきだけど、売りものだからかってにたべちゃ\n　ダメなの」\\nw[女の子]",""],["民家",""],["「ウチの村でも奴隷を使っているけど、期待したほど\n　生産性は上がらなかったな」\\nw[農民]",""],["奴隷1",""],["「剪定に害虫の駆除に雑草取りに……。\n　はぁ……やってらんないわぁ……」\\nw[奴隷]",""],["奴隷2",""],["「このあいだ、作業中につまみ食いしたら\n　尻をぶたれたのよ！　ひどくない！？」\\nw[