ram":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]},{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]}]],"indexIds":{"手配中盗賊":0,"「貴様らごときが勝てると、本気で思っているのか？\n　笑わせるな！」\\nw[手配中の女蛮族]":1,"「み、見誤った……強い……」\\nw[手配中の女蛮族]":2,"奴隷化性別：0=女、1=男、2=男女ランダム":3,"EV002":4,"EV003":5},"extension":"json","dataType":"map","filename":"Map193","basename":"Map193.json","path":"data/Map193.json","relPath":"data/Map193.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map195.json":{"data":[["EV001",""],["EV002",""],["敵ボス",""],["「あたいらの稼ぎを横取りする気！？\n　そうはさせない！」\\nw[猫賊の首領]",""],["「強い……あたいの技が通じないなんて……」\\nw[猫賊の首領]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["宝箱",""],["猫賊の首領",""]],"context":[["Map195/events/1/name"],["Map195/events/2/name"],["Map195/events/3/name"],["Map195/events/3/pages/0/list/1/message/noPicture/bottom"],["Map195/events/3/pages/0/list/15/message/noPicture/bottom"],["Map195/events/3/pages/1/list/0/comment"],["Map195/events/4/name"],["Map195/events/4/pages/0/list/8/Control Variables/var:3-3/tok/0/type/StringLiteral/pos/0"]],"tags":[["gold"],["gold"],["gold"],null,null,["red"],["gold"],["green"]],"parameters":[null,null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":15,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["奴隷化性別：0=女、1=男、2=男女ランダム"]}],null,[{"attachment":"scriptCommand/16944098104622068.js","start":0,"end":7,"leftHand":{"type":"","context":[]}}]],"indexIds":{"EV001":0,"EV002":1,"敵ボス":2,"「あたいらの稼ぎを横取りする気！？\n　そうはさせない！」\\nw[猫賊の首領]":3,"「強い……あたいの技が通じないなんて……」\\nw[猫賊の首領]":4,"奴隷化性別：0=女、1=男、2=男女ランダム":5,"宝箱":6,"猫賊の首領":7},"extension":"json","dataType":"map","filename":"Map195","basename":"Map195.json","path":"data/Map195.json","relPath":"data/Map195.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":8,"percent":0},"cellInfo":[]},"data/Map196.json":{"data":[["EV001",""],["客1",""],["「お気に入りのあの娘、今日は出勤してないのかぁ……」\\nw[客]",""],["EV003",""],["EV004",""],["EV005",""],["娼婦",""],["「男の人ってパイズリが好きよねぇ」\\nw[娼婦]",""],["「あんた、女連れで娼館にくるなんて……。\n　え？　客じゃなくて出入りの奴隷商人？」\\nw[娼婦]",""],["ドア",""],["部屋の中でお楽しみ中のようだ。",""],["燭台",""],["窃盗用下着3",""],["<TE:118>",""],["客2",""],["光",""],["EV015",""],["個別依頼25",""],["常連客の注文Ｃ",""],["「はぁ……嫌になるわホント……。\n　あのクソ客……！」\\nw[娼婦]",""],["「どうした、うっかり客に種でも付けられたか？」\\nw[\\N[1]]",""],["「うっさいわよ、この奴隷商人！\\nw[娼婦]",""],["「って、奴隷商人！\n　あんたいいトコに来たわね！」\\nw[娼婦]",""],["「わたしたちに、なにか御用ですか？」\\nw[\\N[2]]",""],["「そうそう！\n　\\C[17]ダークエルフ\\C[0]をウチの店に入れて欲しいのよ！\\nw[娼婦]",""],["「常連のクソ客が、昔一度だけ抱いたことのあるダーク\n　エルフが忘れられないらしくて――\\nw[娼婦]",""],["「だからって、あたしとヤッてるときにまでダークエルフの\n　話をしやがって、あの野郎！」\\nw[娼婦]",""],["「そ、そうか……。\n　でもダークエルフが店に来たら、その客、横取りされ\n　ちまうんじゃないか？」\\nw[\\N[1]]",""],["「いいのよ！\n　そうなれば、あのクソ客とも縁が切れるから。\\nw[娼婦]",""],["「あいつ好みの\\C[17]貧乳\\C[0]なダークエルフ、連れてきてよ。\n　支配人はあたしが説得するからさ」\\nw[娼婦]",""],["「でもそんな無理して、お金の方は大丈夫なんですか？」\\nw[\\N[2]]",""],["「\\C[17]５０００Ｇ\\C[0]までなら支配人に支払わせられる。\n　それで足りないなら、あたしのとっておきのコレ――\n　\\C[17]\\in[30]\\C[0]を１個プラスしてあげるわ」\\nw[娼婦]",""],["個別依頼『常連客の注文Ｃ』を受けますか？",""],["受ける",""],["受けない",""],["大山脈西洞窟・地下2層",""],["ダークエルフの隠れ家",""],["個別依頼\\C[17]『常連客の注文Ｃ』\\C[0]を受けた！",""],["\\C[17]『\\in[129]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「ほれ、ダークエルフだ。注文の通り連れてきたぞ」\\nw[\\N[1]]",""],["「待ってたわ！\n　はぁ……これでやーっと、あのムカつく客から離れ\n　られる。\\nw[娼婦]",""],["「フフフ……せいぜい好きなダークエルフに入れ込んで、\n　財布の中身を空っぽにするといいわ！」\\nw[娼婦]",""],["個別依頼\\C[17]『常連客の注文Ｃ』\\C[0]を達成した！",""],["\nここでエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「あのクソ客をダークエルフに乗り換えさせるんだから、\n　ちゃんと連れてきてよ！」\\nw[娼婦]",""],["男",""],["\n\\>　　　　　　　　～　娼館の一室にて　～",""],["「やった！　本当にダークエルフの女の子だ！\n　もう一度抱いてみたいと思ってたんだよ！」\\nw[男性客]",""],["「チッ！　クズが！\n　奴隷の身に落とされていなければ、人間など指一本\n　触れさせはしないのに……！」\\nw[奴隷娼婦]",""],["「そうそう、その無駄にプライド高いとこ！\n　前に抱いたダークエルフ娘も、そんな態度だったよ」\\nw[男性客]",""],["「貴様ら人間のことだ、どうせ寄ってたかって強姦\n　したんだろう？」\\nw[奴隷娼婦]",""],["「やだなぁ、そんな酷い真似はしてないよ。\n　お金や食料と交換で、エッチさせてもらっただけ」\\nw[男性客]",""],["「う、嘘を言うな！\n　誇り高きエルフがそのようなことするものか！」\\nw[奴隷娼婦]",""],["「キミだってこれから僕とするんだよ？\n　さあ、ベッドでその綺麗な褐色の体を見せておくれ」\\nw[男性客]",""],["「ああ、スッキリした！\n　これでキミも、無駄な誇りとやらを完全に捨てられた\n　かな？」\\nw[男性客]",""],["「エ、エルフは……にんげんに屈したりなんかぁ……\\I[29]」\\nw[奴隷娼婦]",""],["「やれやれ、強情だなぁ。\n　だったら性処理奴隷の自覚ができるまで、なんども\n　通って抱いてあげるからね\\I[29]」\\nw[男性客]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『常連客の注文Ｃ』の達成報酬として\\C[17]５０００Ｇ\\C[0]と\n\\C[17]\\in[30]を１個\\C[0]入手した！",""],["\\N[2]の発情度が\\C[17]「３」\\C[0]上がった！",""],["掲示板マーク",""],["娼館従業員",""],["EV020",""],["娼館の客（依頼22~25)",""],["依頼を出している場合",""],["依頼フキダシ",""],["娼館支配人（依頼20）",""],["奴隷市（フキダシ）",""],["薄衣購入フキダシ",""],["チェック",""]],"context":[["Map196/events/1/name"],["Map196/events/2/name"],["Map196/events/2/pages/0/list/0/message/noPicture/bottom"],["Map196/events/3/name"],["Map196/events/4/name"],["Map196/events/5/name"],["Map196/events/6/name","Map196/events/7/name"],["Map196/events/6/pages/0/list/8/message/noPicture/bottom"],["Map196/events/7/pages/0/list/0/message/noPicture/bottom"],["Map196/events/8/name","Map196/events/21/name"],["Map196/events/8/pages/0/list/0/message/noPicture/bottom","Map196/events/21/pages/0/list/0/message/noPicture/bottom"],["Map196/events/9/name","Map196/events/12/name"],["Map196/events/10/name"],["Map196/events/10/note"],["Map196/events/11/name"],["Map196/events/13/name","Map196/events/14/name"],["Map196/events/15/name"],["Map196/events/16/name"],["Map196/events/16/pages/0/list/0/comment"],["Map196/events/16/pages/0/list/5/message/noPicture/bottom"],["Map196/events/16/pages/0/list/19/message/noPicture/bottom"],["Map196/events/16/pages/0/list/22/message/noPicture/bottom"],["Map196/events/16/pages/0/list/25/message/noPicture/bottom"],["Map196/events/16/pages/0/list/29/message/noPicture/bottom"],["Map196/events/16/pages/0/list/32/message/noPicture/bottom"],["Map196/events/16/pages/0/list/35/message/noPicture/bottom"],["Map196/events/16/pages/0/list/39/message/noPicture/bottom"],["Map196/events/16/pages/0/list/44/m