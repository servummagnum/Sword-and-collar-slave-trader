]}],[{"headerIndex":12,"headerParam":["",0,0,2]}],[{"headerIndex":18,"headerParam":["",0,0,2]}],null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":7,"headerParam":["",0,0,2]},{"headerIndex":7,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]},{"headerIndex":6,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]},{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":6,"headerParam":["",0,0,2]},{"headerIndex":6,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":5,"headerParam":["",0,0,2]}],[{"headerIndex":11,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"火":3,"EV005":4,"燭台":5,"光":6,"宿屋の主人":7,"宿屋の女将":8,"「お魚大好きな私たち猫人にとって、港町はちょっとした\n　あこがれの場所なんですよ」\\nw[宿屋の女将]":9,"トイレドア（排泄Ev）":10,"トイレで用を足しますか？":11,"入る":12,"入らない":13,"いまのところ用を足す必要は無い。":14,"男":15,"「フムフム……安酒もブレンド次第でうまくなるもんだな」\\nw[酒飲みの男]":16,"トイレマーク（屋内用）":17,"<TE:84>":18,"宿泊客（依頼06）":19,"依頼を出している場合":20,"依頼を出していない場合":21,"「まいったな……。シーグヌースへ渡りたいのに、\n　海賊のせいでこんなに長く足止めをくらうなんて……」\\nw[宿泊客]":22,"「船の積み荷の上げ下ろしは、ほとんどが奴隷の仕事なの\n　だよ。私の所有している商船でもそうだ」\\nw[宿泊客]":23,"依頼フキダシ":24,"ユマ（トイレ）":25,"絶倫おじさん（依頼16）":26,"吟遊詩人":27,"料理1":28,"料理2":29,"男性冒険者":30,"「\\C[17]迷いの森\\C[0]という深い森を知っているか？\n　かなり危険なダンジョンらしい。\n　ここからだと南の方角にあるそうだが」\\nw[男性冒険者]":31,"「迷いの森というダンジョンを知っているか？\n　かなり危険なダンジョンらしい」\\nw[男性冒険者]":32,"女性冒険者":33,"「海賊対策で護衛を募集してる船があるけど、あたしは\n　パス。だって船酔いしちゃうもの」\\nw[女性冒険者]":34,"「いままでいくつものダンジョンに潜ってきたけど、\n　ひとつとして楽なところなんて無かったわ」\\nw[女性冒険者]":35,"船長":36,"「少し前から、海賊をさっぱり見かけなくなったんだ。\n　改心して真人間に戻ったわけでもあるまいが……」\\nw[船長]":37,"「北海に出没する海賊どもは、海賊島って呼ばれてる\n　島を根城にしてるって話だ」\\nw[船長]":38,"「北の海に出没する海賊どもは、海賊島って呼ばれてる\n　島を根城にしてるって話だ」\\nw[船長]":39,"水夫1":40,"「海賊が出なくなったのは、このオレに恐れをなした\n　からかもな！」\\nw[水夫]":41,"「海賊なんか怖かねぇ！\n　ぶっ殺してやらぁ！」\\nw[水夫]":42,"水夫2":43,"「海賊がいなくなっても、海の魔物は健在だから楽観は\n　できないね」\\nw[水夫]":44,"「海の魔物と海賊、果たしてどっちが怖いか……」\\nw[水夫]":45,"犬":46,"変態紳士（依頼17）":47,"「この街じゃ名の知れてる女船長のところへ、積み荷を\n　届けに行ったんだ。そしたら、その女船長は\\C[17]妙にきれいな\n　玉\\C[0]を手の中で弄んでたのさ。\\nw[男性客]":48,"「オレの玉もいじってください、って言いかけたけど\n　後が怖かったんでやめておいたよ。\n　我ながら賢明な判断だったね、うん」\\nw[男性客]":49,"「船で海外に輸出される奴隷は、大半が戦闘用や肉体\n　労働用だな。外聞もあってか、性奴隷用の女の輸出は\n　それほど多くないらしい」\\nw[男性客]":50},"extension":"json","dataType":"map","filename":"Map084","basename":"Map084.json","path":"data/Map084.json","relPath":"data/Map084.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":51,"percent":0},"cellInfo":[]},"data/Map085.json":{"data":[["EV001",""],["EV002",""],["窃盗用下着2",""],["<TE:117>",""]],"context":[["Map085/events/1/name"],["Map085/events/2/name"],["Map085/events/3/name"],["Map085/events/3/note"]],"tags":[["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"EV001":0,"EV002":1,"窃盗用下着2":2,"<TE:117>":3},"extension":"json","dataType":"map","filename":"Map085","basename":"Map085.json","path":"data/Map085.json","relPath":"data/Map085.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":4,"percent":0},"cellInfo":[]},"data/Map086.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["火",""],["EV005",""],["燭台",""],["光",""],["宿屋の主人",""],["料理1",""],["料理2",""],["巡礼者1",""],["「大聖堂へ巡礼に来られたことは、一生の思い出に\n　なります」\\nw[巡礼者]",""],["巡礼者2",""],["「敬虔な四聖教徒にとって、大聖堂への巡礼は\n　義務であり憧れでもあるんです」\\nw[巡礼者]",""],["巡礼者3",""],["「実を言うと、あまり信心深い方じゃないんだけど、\n　悪竜復活の話を聞いて、ちょっと祈りたくなったよ」\\nw[巡礼者の夫]",""],["「実を言うと、あまり信心深い方じゃないんだけどね。\n　ボクはほとんど観光気分さ」\\nw[巡礼者の夫]",""],["巡礼者4",""],["「ウチの人はあまり神様を信じていませんけど、\n　その分わたしがたくさん祈ってるんですよ」\\nw[巡礼者の妻]",""],["巡礼者5",""],["「願掛けとして、大聖堂へ１００回来ると誓ったのさ。\n　今はまだ１８回目、先は長いよ」\\nw[巡礼者]",""],["「願掛けとして、大聖堂へ１００回来ると誓ったのさ。\n　今はまだ１７回目、先は長いよ」\\nw[巡礼者]",""],["商人",""],["「王都の被害は危惧していたよりずっと軽微だったようで、\n　安心しているよ」\\nw[商人]",""],["「私は大聖堂へ、祭具や祭服などを収めているんだ。\n　特別儲かるわけじゃないけど、誇りに思える仕事だよ」\\nw[商人]",""],["巡礼者6",""],["「もっと皆の信仰心が篤ければ、悪竜も甦ったり\n　しなかったのかしら？」\\nw[巡礼者]",""],["「四聖教の大聖堂ともなると、すごい額のお金が動くんで\n　しょうね。\n　……っと、不敬なこと考えちゃったわ」\\nw[巡礼者]",""],["巡礼者7",""],["「悪竜が倒されたのも、四聖神様のご加護があったから\n　かもしれんね」\\nw[巡礼者]",""],["「田舎を出て初めて巡礼に来たが……大聖堂や司祭様の\n　荘厳なことといったら。\n　とても驚いたよ」\\nw[巡礼者]",""],["観光案内人",""],["「王国中からやってくる巡礼者に、大聖堂の見どころを\n　教えてやるのが俺の仕事さ」\\nw[観光案内人]",""]],"context":[["Map086/events/1/name"],["Map086/events/2/name"],["Map086/events/3/name"],["Map086/events/4/name"],["Map086/events/5/name"],["Map086/events/6/name"],["Map086/events/7/name","Map086/events/8/name"],["Map086/events/9/name"],["Map086/events/10/name"],["Map086/events/11/name"],["Map086/events/12/name"],["Map086/events/12/pages/0/list/0/message/noPicture/bottom","Map086/events/12/pages/2/list/0/message/noPicture/bottom"],["Map086/events/13/name"],["Map086/events/13/pages/0/list/0/message/noPicture/bottom","Map086/events/13/pages/2/list/0/message/noPicture/bottom"],["Map086/events/14/name"],["Map086/events/14/pages/0/list/1/message/noPicture/bottom","Map086/events/14/pages/2/list/1/message/noPicture/bottom"],["Map086/events/14/pages/0/list/7/message/noPicture/bottom","Map086/events/14/pages/2/list/7/message/noPicture/bottom"],["Map086/events/15/name"],["Map086/events/15/pages/0/list/0/message/noPicture/bottom","Map086/events/15/pages/2/list/0/message/noPicture/bottom"],["Map086/events/16/name"],["Map086/events/16/pages/0/list/1/message/noPicture/bottom"],["Map086/events/16/pages/0/list/7/message/noPicture/bottom"],["Map086/events/17/name"],["Map086/events/17/pages/0/list/1/message/noPicture/bottom"],["Map086/events/17/pages/0/list/7/message/noPicture/bottom"],["Map086/events/18/name"],["Map086/events/18/pages/0/list/1/message/noPicture/bottom"],["Map086/events/1