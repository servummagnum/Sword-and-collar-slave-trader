ram":["",0,0,2]}],[{"headerIndex":113,"headerParam":["",0,0,2]}],[{"headerIndex":118,"headerParam":["",0,0,2]}],[{"headerIndex":121,"headerParam":["",0,0,2]}],[{"headerIndex":128,"headerParam":["",0,0,2]}],[{"headerIndex":134,"headerParam":["",0,0,2]}],[{"headerIndex":141,"headerParam":["",0,0,2]},{"headerIndex":5,"headerParam":["",0,0,2]},{"headerIndex":14,"headerParam":["",0,0,2]}],[{"attachment":"scriptCommand/16944098114152980.js","start":0,"end":13,"leftHand":{"type":"","context":[]}}],[{"attachment":"scriptCommand/16944098114156788.js","start":0,"end":16,"leftHand":{"type":"","context":[]}}],[{"attachment":"scriptCommand/16944098114153376.js","start":0,"end":13,"leftHand":{"type":"","context":[]}}],[{"headerIndex":1,"headerParam":["",0,0,2]}],[{"headerIndex":10,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"headerIndex":0,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":2,"headerParam":["",0,0,2]}],null,null,[{"headerIndex":22,"headerParam":["",0,0,2]}],[{"headerIndex":24,"headerParam":["",0,0,2]}],[{"headerIndex":33,"headerParam":["",0,0,2]}],[{"headerIndex":47,"headerParam":["",0,0,2]}],[{"headerIndex":52,"headerParam":["",0,0,2]}],[{"headerIndex":75,"headerParam":["",0,0,2]}],[{"headerIndex":84,"headerParam":["",0,0,2]}],[{"headerIndex":88,"headerParam":["スライムHシーン"]}],[{"headerIndex":102,"headerParam":["↑　　↑　　↑"]}],[{"headerIndex":126,"headerParam":["",0,0,2]}],[{"headerIndex":129,"headerParam":["",0,0,2]}],[{"headerIndex":160,"headerParam":["",0,0,2]}],[{"headerIndex":191,"headerParam":["",0,0,2]}],[{"headerIndex":197,"headerParam":["",0,0,2]}],[{"headerIndex":206,"headerParam":["",0,0,1]}],[{"headerIndex":209,"headerParam":["",0,0,2]}],[{"headerIndex":217,"headerParam":["↓原因不明だが蛮族奴隷♀AのHイベント後に上部表示と排泄ゲージの一部が"]}],[{"headerIndex":241,"headerParam":["",0,0,2]}],[{"headerIndex":252,"headerParam":["",0,0,2]}]],"indexIds":{"宝箱（消耗品正面開き）":0,"<TE:13>":1,"EV002":2,"敵索敵スタート":3,"PSS start":4,"入り口":5,"宝箱（防具正面開き）":6,"<TE:4>":7,"EV005":8,"EV006":9,"EV007":10,"EV008":11,"EV009":12,"敵01":13,"<PsensorS:\\V[1166] Rv\\S[22]>":14,"探索範囲にプレイヤー侵入":15,"SmartPath 0 -1":16,"SmartPath 0 cancel":17,"敵に見つかっている場合の戦闘":18,"勝利したとき":19,"PSS t_stop":20,"逃げたとき":21,"戦闘から離脱したときの処理":22,"PSS t_start":23,"敵がプレイヤーを見失ったときの処理":24,"敵02":25,"敵03":26,"敵04":27,"敵05":28,"鉤爪捜索開始Ev":29,"「いつ誰が建てたかも分かっていない、砂漠の古代遺跡か。\n　モンスターが棲みついてるみたいだな」\\nw[\\N[1]]":30,"「でもここに竜の鉤爪があるなら、行かないと！」\\nw[\\N[2]]":31,"「楽に見つかるといいんだが……まあ期待せずに進むか」\\nw[\\N[1]]":32,"初回ダンジョン名表示":33,"PSS stop":34,"P_D_FILENAME name_dungeon\\V[91]":35,"床針トラップ制御":36,"EV018":37,"盗賊（ダンジョン内）":38,"「やる気か！？　人間風情が！」\\nw[ダークエルフ]":39,"奴隷化性別：0=女、1=男、2=男女ランダム":40,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":41,"床針検知":42,"入り口炎":43,"すごい火勢だ。\nこの炎を越えて先へ進むことは出来そうにない。":44,"トラップ無敵時間":45,"床トラップ":46,"冒険者1":47,"「いったい何がどうなってるんだ？\n　なんで遺跡の入り口に、あんな火柱が立ってる？」\\nw[\\N[1]]":48,"「どこかのバカな三流冒険者が、トラップを作動させて\n　しまったんだ。\\nw[冒険者]":49,"「おかげで探索に来た他の冒険者たちは、全員ここで\n　足止めってわけさ」\\nw[冒険者]":50,"「その三流冒険者さんは……？」\\nw[\\N[2]]":51,"「あの火柱に焼かれて、とっくに消し炭だよ」\\nw[冒険者]":52,"「そいつはまいったな。\n　トラップを解除する方法はないのか？」\\nw[\\N[1]]":53,"「壁の向こうに\\C[17]解除用のスイッチ\\C[0]があるはずだけど、\n　回り道もないから、そもそも押しに行けないんだ。\\nw[冒険者]":54,"「ただひとつ望みがあるとすれば、そこの\\C[17]壁面に開いて\n　いる穴\\C[0]だね。\n　向こう側までつながってるんだ」\\nw[冒険者]":55,"「狭い穴ですね。\n　男性じゃ無理でしょうし、わたしの体格でもギリギリ\n　通れるかどうか……」\\nw[\\N[2]]":56,"「自分が行こうと考えているなら、やめておいた方がいい。\n　猫人のキミでは、もうひとつのトラップが作動して\n　しまうかもしれない」\\nw[冒険者]":57,"「まだなにか罠があるんですか？」\\nw[\\N[2]]":58,"「この遺跡を作った古代人の血を引く者――つまり\\C[17]砂漠の\n　民\\C[0]にしかトラップ解除ができない作りになっているんだ。\\nw[冒険者]":59,"「それ以外の者が解除ボタンを押すと……ボンッ！」\\nw[冒険者]":60,"「ひぇ～」\\nw[\\N[2]]":61,"「そこの女冒険者は、見たところ砂漠の民のようだが？\n　彼女が穴を抜けて解除してくるわけにはいかないのか？」\\nw[\\N[1]]":62,"「そうしようとは思ったんだけど、いざ穴を抜けようと\n　したらお尻や胸が引っかかっちゃって……」\\nw[地元の女冒険者]":63,"「彼女は見ての通り、ボンッ、キュッ、ボンッな女性\n　だから」\\nw[冒険者]":64,"「となると、\\C[17]凹凸の少ない砂漠の民の女\\C[0]を連れてくれば\n　いいんだな。\\nw[\\N[1]]":65,"「\\C[17]貧乳の蛮族奴隷\\C[0]を捕まえてくるか。\n　ヤツラも砂漠の民であることに変わりはないからな」\\nw[\\N[1]]":66,"「\\N[1]さん、今わたしたちが連れてる奴隷の\n　中に胸の薄い蛮族奴隷いますよ！」\\nw[\\N[2]]":67,"「あれ？　そうだったか？\\nw[\\N[1]]":68,"「だがそれなら話は早い。\n　その蛮族奴隷に解除ボタンを押させよう」\\nw[\\N[1]]":69,"「奴隷にできそうな蛮族の女がいればいいが、そううまく\n　いくものだろうか……？」\\nw[冒険者]":70,"「それなら、\\C[17]砂漠の西の方\\C[0]に蛮族の隠れ家があると\n　聞いたことがあるぞ」\\nw[冒険者]":71,"遺跡の先へ進みたければ、\\C[17]『\\in[111]』\\C[0]を捕獲して\n連れてこよう。":72,"捕獲対象：蛮族奴隷♀Ａ":73,"出現場所：大山脈東洞窟・2層":74,"出現場所：蛮族の隠れ家":75,"「どこかに奴隷にできそうな、貧乳の女蛮族でも\n　いればいいんだが……」\\nw[冒険者]":76,"「\\C[17]砂漠の西の方\\C[0]に蛮族の隠れ家があるらしい。\n　そこに貧乳の女蛮族がいれば、奴隷にすることも……」\\nw[冒険者]":77,"冒険者2":78,"「厄介なことになっちゃったわね……」\\nw[地元の女冒険者]":79,"冒険者3":80,"「まったくいい迷惑だぜ！\n　どこのマヌケがトラップを作動させたんだか」\\nw[冒険者]":81,"冒険者4":82,"「困ったわねぇ。\n　わたしの魔法でもあの炎は消せなかったし、どうしたら\n　いいのかしら？」\\nw[冒険者]":83,"冒険者5":84,"「オレじゃどうにも出来ねぇし、誰かがトラップを解除して\n　くれるまで、のんびり待つとするかね」\\nw[冒険者]":85,"会話マーク":86,"穴矢印":87,"壁穴":88,"\\C[17]『\\in[111]』\\C[0]に命じて、壁の穴を潜らせますか？":89,"命令する":90,"やめておく":91,"「この穴の向こうにあるスイッチを押してくればいいの？\\nw[蛮族奴隷]":92,"「そうすれば、あたしのこと解放してくれるのね？\n　分かったわ、約束は守ってよ」\\nw[蛮族奴隷]":93,"「これ、頭より爪先から入った方が良さそうかも。\n　よっと……」\\nw[蛮族奴隷]":94,"「くっ……せまい……。\n　でも頑張ればいけそう……。\\nw[蛮族奴隷]":95,"「肌が擦れる……んっ……！\n　でもあとちょっとで……」\\nw[蛮族奴隷]":96,"「ひぃっ！？　な、なに！？\n　ブヨブヨした何かが足にっ……いやぁッ！！？\\nw[蛮族奴隷]":97,"「助けて！　何かがあたしの足にまとわりついてるのっ！\n　いやあぁっ？！　上ってくる！？\n　おしりにっ……ひいいいぃぃッ！！」\\nw[蛮族奴隷]":98,"スライムHシーン\n↓　　↓　　↓":99,"↑　　↑　　↑\nスライムHシーン":100,"「うっ……うぅ……。\n　やっと……離れてくれたぁ……」\\nw[蛮族奴隷]":101,"「ボ、ボタン……押さなきゃ……」\\nw[蛮族奴隷]":102,"「これで、あたしは自由に……」\\nw[蛮族奴隷]":103,"「よしよし、これで先へ進めるな」\\nw[\\N[1]]":104,"「あの奴隷さんの献身的な働きのおかげですね……」\\nw[\\N[2]]":105,"\n\\>\\C[17]　　　　※　古代遺跡に入れるようになった　※":106,"\\C[17]『\\in[111]』\\C[0]を一人解放した。":107,"↓原因不明だが蛮族奴隷♀AのHイベント後に上部表示と排泄ゲージの一部が\n　消去されてしまうので、ここで再描画させる。":108,"\\C[17]『\\in[111]』\\C[0]を連れてきて穴を抜けさせ、\n向こう側にあるトラップの解除ボタンを押させよう。":109,"壁に穴が開いている。":110,"蛮族奴隷":111,"スライム":112,"戦闘マーク":113},"extension":"json","dataType":"map","filename":"Map289","basename":"Map289.json","path":"data/Map289.json","relPath":"data/Map289.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":114,"percent":0},"cellInfo":[]},"data/Map290.json":{"data":[["ワープ魔法陣・白",""],["createFilter 1 zoomblur 0",""],["setFilter 1 408 312 0 0",""],["moveFilter 1 408 312 0 0.3 60",""],["moveFilter 1 408 312 0 0 60",""],["eraseFilter 1",""],["宝箱（武器正面開き）",""],["<TE:1>",""],["敵索敵スタート",""],["PSS start",""],["転送部屋",""],["EV005",""],["宝箱（お金左開き）",""],["<TE:18>",""],["↓金額おまかせの場合は変数を「0」のままに。\n　特定の金額を入れたい場合は変数へ入力。",""],["宝箱（消耗品正面開き）",""],["<TE:13>",""],["EV008",""],["EV009",""],["敵01",""],["<PsensorS:\\V[1166] Rv\\S[22]>",""],["探索範囲にプレイヤー侵入",""],["SmartPath 0 -1",""],["SmartPath 0 cancel",""],["敵に見つかっている場合の戦闘",""],["勝利したとき",""],["PSS t_stop",""],["逃げたとき",""],["戦闘から離脱したときの処理",""],["PSS t_start",""],["敵がプレイヤーを見失ったときの処理",""],["敵02",""],["敵03",""],["敵04",""],["敵05",""],["壁ひび",""],["※\nアイテム：精霊石\n※",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["EV017",""],["ワープ魔法陣・赤",""],["メモ",""],["骸骨のそばに、古びたメモが落ちている。",""],["『先へ進むだけなら、\\C[18]赤\\C[0]→\\C[9]青\\C[0]で事足りる。\n　しかし別のルートには――（以下判読不能）』",""],["ワープ魔法陣・緑",""],["ワープ魔法陣・黄",""],["宝箱（お金正面開き）",""],["<TE:16>",""],["ワープ魔法陣・青",""],["宝箱",""],["※\nアイテム：ツルハシ\n※",""],["敵ボス",""],["盗賊(悪魔B)Ｒ",""],["｢ねぇねぇ、あたしと遊んでいかない？　フフ……\\I[29]」\\nw[悪魔]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["EV040",""],["EV041",""],["EV042",""],["戦闘マーク",""],["冒険者3",""],["「テキトーに魔法陣で飛んでると、自分の位置を見失っち\n　まうな、こりゃ」\\nw[冒険者]",""],["『\\C[11]緑\\C[0]→\\C[9]青\\C[0]のルートでさらに深部へ進めることは確認した。\n　もう一方のルートは――（以下判読不能）』",""],["冒険者4",""],["「あれは転移の魔法陣ね。\n　使ってみないと行き先は分からないわよ」\\nw[冒険者]",""],["冒険者1",""],["「キミたちのおかげで入り口のトラップは解除できたけど、\n　ここから先もまた厄介そうだよ」\\nw[冒険者]",""],["冒険者2",""],["「転移魔法陣か……。\n　どこに繋がってるか分からないけど、乗らないことには\n　先へ進めないし……」\\nw[地元の女冒険者]",""]],"context":[["Map290/events/1/name","Map290/events/4/name","Map290/events/16/name","Map290/events/37/name"],["Map290/events/1/pages/0/list/0/Plugin Command","Map290/events/4/pages/0/list/0/Plugin Command","Map290/