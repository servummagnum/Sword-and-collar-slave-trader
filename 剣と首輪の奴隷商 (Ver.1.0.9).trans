am":["",0,0,2]}],[{"headerIndex":46,"headerParam":["",0,0,2]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":53,"headerParam":["",0,0,2]}],[{"headerIndex":58,"headerParam":["",0,0,2]}],[{"headerIndex":80,"headerParam":["",0,0,2]}],[{"headerIndex":83,"headerParam":["",0,0,2]}],[{"headerIndex":85,"headerParam":["",0,0,2]}],[{"headerIndex":97,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":113,"headerParam":["",0,0,2]}],[{"headerIndex":116,"headerParam":["",0,0,2]}]],"indexIds":{"操舵長":0,"\n\\>　　　　　　　　～　港の倉庫にて　～":1,"「こんなところに連れ込んで、なんだっていうのよ！？\\nw[奴隷女]":2,"「あたいが奴隷だからってナメた真似したらタダじゃ\n　おかないよ！」\\nw[奴隷女]":3,"「そ、操舵長！\n　彼女、こう言ってますけど……？」\\nw[水夫Ａ]":4,"「なぁにビビッてやがんだ、揃いも揃って！\\nw[操舵長]":5,"「お前らの\\C[17]童貞\\C[0]を捨てさせるために、わざわざ船長が\n　買ってくれた奴隷なんだぞ。\n　ありがたくヤればいいんだよ！」\\nw[操舵長]":6,"「勝手なことホザくな！\n　誰がテメェらなんかと――」\\nw[奴隷女]":7,"「口は悪いが体は頑丈そうだな。\n　これなら輪姦しても簡単にブッ壊れたりしないだろう」\\nw[操舵長]":8,"「くっ……くそっ！　やめろ！！\n　このロクデナシの獣ども！」\\nw[奴隷女]":9,"「おいっ、童貞ども！\n　この女は獣みたいに犯されるのがお望みらしいぞ！\\nw[操舵長]":10,"「お前らの獣欲をたっぷりぶつけてやれ！」\\nw[操舵長]":11,"「アイアイサー！！」\\nw[水夫Ａ・Ｂ・Ｃ]":12,"「うぅ……たすけてぇ……」\\nw[奴隷女]":13,"「若いんだから、お前らもっとイケるだろ！\\nw[操舵長]":14,"「出航まではまだ時間がある。\n　いまのうちにイヤってほど女を味わっておけよ！」\\nw[操舵長]":15,"↓プレーヤー位置強制中央解除":16,"SFC_DISABLE_RESERVE":17,"個別依頼『童貞卒業式』の達成報酬として\\C[17]\\in[27]４個\\C[0]\nと\\C[17]\\in[28]４個\\C[0]と\\C[17]\\in[50]\\C[0]を入手した！":18,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":19,"奴隷":20,"EV003":21,"水夫A":22,"水夫B":23,"水夫C":24},"extension":"json","dataType":"map","filename":"Map409","basename":"Map409.json","path":"data/Map409.json","relPath":"data/Map409.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":25,"percent":0},"cellInfo":[]},"data/Map410.json":{"data":[["奴隷",""],["男",""],["\n\\>　　　　　　～　依頼者の息子の自宅にて　～",""],["「ぐっひひひっ！　なかなか美味いじゃないか。\n　料理の腕は合格だなぁ」\\nw[ブサイクな男]",""],["「あ、ありがとうございます、ご主人様。\n　家事奴隷として掃除や洗濯もしっかりとやらせて\n　いただきますので――」\\nw[奴隷女]",""],["「家事奴隷だぁ？　なにを勘違いしてる」\\nw[ブサイクな男]",""],["「え？　そのためにわたしを買ったんじゃ？」\\nw[奴隷女]",""],["「ちがうちがう。\n　親父がお前を買ってきたのは、\\C[17]オレ様の嫁\\C[0]にするためだよ」\\nw[ブサイクな男]",""],["「う、うそっ！？　なによそれ！」\\nw[奴隷女]",""],["「ぐひひひっ。\n　オレ様の好みにピッタリの女を見つけてくれた親父には、\n　感謝しなきゃな。\\nw[ブサイクな男]",""],["「じゃあ腹も膨れたことだし、次は子作りといこうか？\n　あっちの具合を確かめてやるからなぁ、ひひひひっ！」\\nw[ブサイクな男]",""],["「いっ、いやよ！\n　誰があんたみたいなブ男なんかの嫁に！」\\nw[奴隷女]",""],["「あれあれぇ～？　そんなこと言っていいのかなぁ～？」\\nw[ブサイクな男]",""],["「くくくっ！\n　別に逃げてもいいけど、逃亡奴隷は捕まったら即処刑\n　っていうのがこの国の法律なんだよねぇ」\\nw[ブサイクな男]",""],["「くっ……」\\nw[奴隷女]",""],["「オレ様の嫁になって子供を孕むか、それとも処刑されるか、\n　好きな方を選んでいいぜぇ～。\\nw[ブサイクな男]",""],["「オレ様は先にベッドルームへ行ってるから、覚悟が\n　決まったら来いよぉ」\\nw[ブサイクな男]",""],["「こんなところで死ぬわけにはいかない……。\n　しかたないわ……生きるために……」\\nw[奴隷女]",""],["「賢明な判断だなぁ、ぎひひひっ。\n　それじゃあ服を脱いで、こっちにケツを向けるんだ」\\nw[ブサイクな男]",""],["「うぅ……演技のつもりだったのに、途中から\n　ほんとに気持ち良くされちゃったぁ……」\\nw[奴隷女]",""],["「ふぅ、出た出た。\n　これからも毎日中出しして、お腹に新しい命を宿して\n　やるからなぁ」\\nw[ブサイクな男]",""],["「奴隷としてコキ使われながら、妊娠出産させられるのが\n　わたしの人生だっていうの……？\\nw[奴隷女]",""],["「あぁ……絶望で目の前が暗くなる……」\\nw[奴隷女]",""],["「だから何を言ってる？\n　お前はオレ様の奴隷でなく、嫁だと言っただろ。\\nw[ブサイクな男]",""],["「嫁をコキ使うものかよ。家事は二人で折半だ。\n　ああそれと、新生活用にお前の服や化粧道具なんかも\n　買わないとな」\\nw[ブサイクな男]",""],["「えっ……？　そ、それって……？」\\nw[奴隷女]",""],["「ぐふふっ、指輪とドレスも揃えて盛大に披露宴も\n　開いてやるからなぁ。覚悟しておけぇ！」\\nw[ブサイクな男]",""],["「もしかして、普通にお嫁さんにもらってくれる……の？」\\nw[奴隷女]",""],["「ぐはーはっはっ！\n　いまから子育てが楽しみだぜぇ！」\\nw[ブサイクな男]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『息子の嫁探し』の達成報酬として\\C[17]７０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["ドア",""]],"context":[["Map410/events/1/name"],["Map410/events/2/name"],["Map410/events/2/pages/0/list/5/message/noPicture/middle"],["Map410/events/2/pages/0/list/10/message/noPicture/bottom"],["Map410/events/2/pages/0/list/14/message/noPicture/bottom"],["Map410/events/2/pages/0/list/19/message/noPicture/bottom"],["Map410/events/2/pages/0/list/22/message/noPicture/bottom"],["Map410/events/2/pages/0/list/30/message/noPicture/bottom"],["Map410/events/2/pages/0/list/34/message/noPicture/bottom"],["Map410/events/2/pages/0/list/37/message/noPicture/bottom"],["Map410/events/2/pages/0/list/41/message/noPicture/bottom"],["Map410/events/2/pages/0/list/45/message/noPicture/bottom"],["Map410/events/2/pages/0/list/48/message/noPicture/bottom"],["Map410/events/2/pages/0/list/56/message/noPicture/bottom"],["Map410/events/2/pages/0/list/61/message/noPicture/bottom"],["Map410/events/2/pages/0/list/64/message/noPicture/bottom"],["Map410/events/2/pages/0/list/67/message/noPicture/bottom"],["Map410/events/2/pages/0/list/89/message/noPicture/bottom"],["Map410/events/2/pages/0/list/120/message/noPicture/bottom"],["Map410/events/2/pages/0/list/140/message/noPicture/bottom"],["Map410/events/2/pages/0/list/144/message/noPicture/bottom"],["Map410/events/2/pages/0/list/149/message/noPicture/bottom"],["Map410/events/2/pages/0/list/152/message/noPicture/bottom"],["Map410/events/2/pages/0/list/156/message/noPicture/bottom"],["Map410/events/2/pages/0/list/159/message/noPicture/bottom"],["Map410/events/2/pages/0/list/165/message/noPicture/bottom"],["Map410/events/2/pages/0/list/167/message/noPicture/bottom"],["Map410/events/2/pages/0/list/171/message/noPicture/bottom"],["Map410/events/2/pages/0/list/174/message/noPicture/bottom"],["Map410/events/2/pages/0/list/183/comment"],["Map410/events/2/pages/0/list/184/Plugin Command"],["Map410/events/2/pages/0/list/198/message/noPicture/bottom"],["Map410/events/2/pages/0/list/201/message/noPicture/bottom"],["Map410/events/3/name"]],"tags":[["gold"],["gold"],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["red"],["blue"],null,null,["gold"]],"parameters":[null,null,[{"headerIndex":5,"headerParam":["",0,1,1]}],[{"headerIndex":10,"headerParam":["",0,0,2]}],[{"headerIndex":14,"headerParam":["",0,0,2]}],[{"headerIndex":19,"headerParam":["",0,0,2]}],[{"headerIndex":22,"headerParam":["",0,0,2]}],[{"headerIndex":30,"headerParam":["",0,0,2]}],[{"headerIndex":34,"headerParam":["",0,0,2]}],[{"headerIndex":37,"headerParam":["",0,0,2]}],[{"headerIndex":41,"headerParam":["",0,0,2]}],[{"headerIndex":45,"headerParam":["",0,0,2]}],[{"headerIndex":48,"headerParam":["",0,0,2]}],[{"headerIndex":56,"headerParam":["",0,0,2]}],[{"headerIndex":61,"headerParam":["",0,0,2]}],[{"headerIndex":64,"headerParam":["",0,0,2]}],[{"headerIndex":67,"headerParam":["",0,0,2]}],[{"headerIndex":89,"headerParam":["",0,0,2]}],[{"headerIndex":120,"headerParam":["",0,0,2]}],[{"headerIndex":140,"headerParam":["",0,0,2]}],[{"headerIndex":144,"headerParam":["",0,0,2]}],[{"headerIndex":149,"headerParam":["",0,0,2]}],[{"headerIndex":152,"headerParam":["",0,0,2]}],[{"headerIndex":156,"headerParam":["",0,0,2]}],[{"headerIndex":159,"headerParam":["",0,0,2]}],[{"headerIndex":165,"headerParam":["",0,0,2]}],[{"headerIndex":167,"headerParam":["",0,0,2]}],[{"headerIndex":171,"headerParam":["",0,0,2]}],[{"headerIndex":174,"headerParam":["",0,0,2]}],[{"headerIndex":183,"headerParam":["↓プレーヤー位置強制中央解除"]}],null,[{"headerIndex":198,"headerParam":["",0,0,2]}],[{"headerIndex":201,"headerParam":["",0,0,2]}]],"indexIds":{"奴隷":0,"男":1,"\n\\>　　　　　　～　依頼者の息子の自宅にて　～":2,"「ぐっひひひっ！　なかなか美味いじゃないか。\n　料理の腕は合格だなぁ」\\nw[ブサイクな男]":3,"「あ、ありがとうございます、ご主人様。\n　家事奴隷として掃除や洗濯もしっかりとやらせて\n　いただきますので――」\\nw[奴隷女]":4,"「家事奴隷だぁ？　なにを勘違いしてる」\\nw[ブサイクな男]":5,"「え？　そのためにわたしを買ったんじゃ？」\\nw[奴隷女]":6,"「ちがうちがう。\n　親父がお前を買ってきたのは、\\C[17]オレ様の嫁\\C[0]にするためだよ」\\nw[ブサイクな男]":7,"「う、うそっ！？　なによそれ！」\\nw[奴隷女]":8,"「ぐひひひっ。\n　オレ様の好みにピッタリの女を見つけてくれた親父には、\n　感謝しなきゃな。\\nw[ブサイクな男]":9,"「じゃあ腹も膨れたことだし、次は子作りといこうか？\n　あっちの具合を確かめてやるからなぁ、ひひひひっ！」\\nw[ブサイクな男]":10,"「いっ、いやよ！\n　誰があんたみたいなブ男なんかの嫁に！」\\nw[奴隷女]":11,"「あれあれぇ～？　そんなこと言っていいのかなぁ～？」\\nw[ブサイクな男]":12,"「くくくっ！\n　別に逃げてもいいけど、逃亡奴隷は捕まったら即処刑\n　っていうのがこの国の法律なんだよねぇ」\\nw[ブサイクな男]":13,"「くっ……」\\nw[奴隷女]":14,"「オレ様の嫁になって子供を孕むか、それとも処刑されるか、\n　好きな方を選んでいいぜぇ～。\\nw[ブサイクな男]":15,"「オレ様は先にベッドルームへ行ってるから、覚悟が\n　決まったら来いよぉ」\\nw[ブサイクな男]":16,"「こんなところで死ぬわけにはいかない……。\n　しかたないわ……生きるために……」\\nw[奴隷女]":17,"「賢明な判断だなぁ、ぎひひひっ。\n　それじゃあ服を脱いで、こっちにケツを向けるんだ」\\nw[ブサイクな男]":18,"「うぅ……演技のつもりだったのに、途中から\n　ほんとに気持ち良くされちゃったぁ……」\\nw[奴隷女]":19,"「ふぅ、出た出た。\n　これからも毎日中出しして、お腹に新しい命を宿して\n　やるからなぁ」\\nw[ブサイクな男]":20,"「奴隷としてコキ使われながら、妊娠出産させられるのが\n　わたしの人生だっていうの……？\\nw[奴隷女]":21,"「あぁ……絶望で目の前が暗くなる……」\\nw[奴隷女]":22,"「だから何を言ってる？\n　お前はオレ様の奴隷でなく、嫁だと言っただろ。\\nw[ブサイクな男]":23,"「嫁をコキ使うものかよ。家事は二人で折半だ。\n　ああそれと、新生活用にお前の服や化粧道具なんかも\n　買わないとな」\\nw[ブサイクな男]":24,"「えっ……？　そ、それって……？」\\nw[奴隷女]":25,"「ぐふふっ、指輪とドレスも揃えて盛大に披露宴も\n　開いてやるからなぁ。覚悟しておけぇ！」\\nw[ブサイクな男]":26,"「もしかして、普通にお嫁さんにもらってくれる……の？」\\nw[奴隷女]":27,"「ぐはーはっはっ！\n　いまから子育てが楽しみだぜぇ！」\\nw[ブサイクな男]":28,"↓プレーヤー位置強制中央解除":29,"SFC_DISABLE_RESERVE":30,"個別依頼『息子の嫁探し』の達成報酬として\\C[17]７０００Ｇ\\C[0]と\n\\C[17]\\in[50]\\C[0]を入手した！":31,"\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！":32,"ドア":33},"extension":"json","dataType":"map","filename":"Map410","basename":"Map410.json","path":"data/Map410.json","relPath":"data/Map410.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":34,"percent":0},"cellInfo":[]},"data/Map411.json":{"data":[["男",""],["\n\\>　　　　　　～　依頼者の男の自宅にて　～",""],["「ここがキッチン。\n　料理のときは火の扱いに気をつけてくれよ」\\nw[男]",""],["「はい、分かりました。旦那様」\\nw[奴隷女]",""],["（奴隷にされたときはどうなることかと思ったけど、\n　購入者がまともそうで安心したわ……）\\nw[奴隷女]",""],["「次にここがリビング。\n　お客さんを通すこともあるから、掃除はこまめに\n　頼むぜ」\\nw[男]",""],["「はい、旦那様」\\nw[奴隷女]",""],["「どうかなさいましたか？」\\nw[奴隷女]",""],["「夜まで待とうと思ってたけど……やっぱり我慢でき\n　そうにねぇぜ……」\\nw[男]",""],["「はい？」\\nw[奴隷女]",""],["「はぁはぁ……いますぐお前が欲しいっ！\n　ネコちゃん！　オレのネコちゃああぁんっ！」\\nw[男]",""],["「な、なによ急に！？\n　まともな人だと思ったのに、やっぱりそういう目的\n　だったの！？」\\nw[奴隷女]",""],["「さあ、その余計な布を脱いで、すべてを見せておくれ！」\\nw[男]",""],["「ちょ、ちょっと旦那様！　ここテーブルの上なんだけど！\n　せめてベッドにしてよぉ！！」\\nw[奴隷女]",""],["「はぁ……はあぁ……\\I[29]\n　いっぱい出されちゃったぁ\\I[29]」\\nw[奴隷女]",""],["「まだまだこれからだぜ。次はベッドへ行こう。\n　確実に妊娠するよう、もっと子種を入れてやるからな！」\\nw[男]",""],["「はい、旦那さまぁ\\I[29]」\\nw[奴隷女]",""],["↓プレーヤー位置強制中央解除",""],["SFC_DISABLE_RESERVE",""],["個別依頼『猫耳娘ラブ』の達成報酬として\\C[17]４０００Ｇ\\C[0]と\n\\C[17]『\\in[50]』\\C[0]を入手した！",""],["\\N[2]の発情度が\\C[17]「２」\\C[0]上がった！",""],["奴隷",""],["EV003",""]],"context":[["Map411/events/1/name"],["Map411/events/1/pages/0/list/5/message/noPicture/middle"],["Map411/events/1/pages/0/list/11/mes