半分以上は、干したり塩漬けにしたりして、\n　保存食にするのよ」\\nw[主婦]":21,"男の子":22,"「あれ？　カニは？\n　さっきまでそこにいたのに」\\nw[男の子]":23,"「魚を獲ってると、たまに海の魔物と出会うことがある。\n　そういうときは、一も二もなく逃げるんだけどね」\\nw[漁師]":24,"EV020":25,"民家":26,"EV021":27,"ＢＧＭ変更":28,"夜間用ＢＧＭ演奏":29,"夜→昼":30,"最初から昼":31,"昼→夜":32,"最初から夜":33,"落ちてる精霊石（街）":34,"マップ取得":35,"FocusCamera 19 17 120":36,"ZoomOut 2.2 120":37,"\\C[17]\\V[916]の地図\\C[0]を取得した！":38,"ResetZoom 60":39,"ResetFocus 60":40,"景気ランタン":41,"猫":42},"extension":"json","dataType":"map","filename":"Map050","basename":"Map050.json","path":"data/Map050.json","relPath":"data/Map050.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":43,"percent":0},"cellInfo":[]},"data/Map051.json":{"data":[["EV001",""],["宿屋",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["舟",""],["船頭",""],["「普段は運賃をもらって\\C[17]島の町シーグヌース\\C[0]まで\n　舟を渡してるんだがなぁ。\n　今は海賊が暴れ回っているから無理だ」\\nw[船頭]",""],["船マーク",""],["村人（奴隷買い取り）",""],["奴隷買い取り（フキダシ）",""],["漁師",""],["海産物売買フキダシ",""],["ニワトリ",""],["猫",""],["屋外トイレドア（排泄Ev）",""],["<TE:80>",""],["主婦",""],["「そろそろ収穫の時期かしらね」\\nw[主婦]",""],["男の子",""],["「おてつだいしてるの！\n　貝のカラむき！」\\nw[男の子]",""],["「少し波が高いな。\n　漁に出るのに問題はなさそうだが」\\nw[漁師]",""],["EV019",""],["醸造所",""],["EV020",""],["民家",""],["漁師2",""],["「豊漁の時は、ここで火を焚いてドンチャン騒ぎを\n　することもあるんだ」\\nw[漁師]",""],["奴隷1",""],["「ここに連れて来られるまで海って見たことなかった\n　んだけど……すごいもんだな」\\nw[奴隷]",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["EV024",""],["トイレマーク",""],["景気ランタン",""],["落ちてる精霊石（街）",""],["マップ取得",""],["FocusCamera 20 17 120",""],["ZoomOut 2.15 120",""],["\\C[17]\\V[917]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""]],"context":[["Map051/events/1/name"],["Map051/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map051/events/2/name"],["Map051/events/3/name"],["Map051/events/4/name"],["Map051/events/5/name"],["Map051/events/6/name","Map051/events/29/name"],["Map051/events/7/name"],["Map051/events/7/pag