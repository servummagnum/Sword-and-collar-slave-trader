,"headerParam":["",0,0,2]}],[{"headerIndex":35,"headerParam":["",0,0,2]}],[{"headerIndex":39,"headerParam":["",0,0,2]}],[{"headerIndex":43,"headerParam":["",0,0,2]}],[{"headerIndex":49,"headerParam":["",0,0,2]}],[{"headerIndex":64,"headerParam":["",0,0,2]}],[{"headerIndex":68,"headerParam":["",0,0,2]}],[{"headerIndex":74,"headerParam":["",0,0,2]}],[{"headerIndex":80,"headerParam":["ギルド長へ報告する前に個別依頼01を終わらせた場合"]}],[{"headerIndex":84,"headerParam":["",0,0,2]}],[{"headerIndex":89,"headerParam":["ギルド長へ報告してから個別依頼01を終わらせた場合"]}],[{"headerIndex":100,"headerParam":["依頼条件未達成"]}],[{"headerIndex":101,"headerParam":["",0,0,2]}],null,null,null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":0,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"個別依頼01":3,"鉱山（状況確認）":4,"「くそっ……どうすりゃいいんだ……！」\\nw[鉱山監督官]":5,"「なにやら困っている様子だが、どうしたんだ？」\\nw[\\N[1]]":6,"「なんだお前らは？」\\nw[鉱山監督官]":7,"「ラノティカの商業ギルドから来た者だ」\\nw[\\N[1]]":8,"「坑夫のみなさんも途方に暮れているようでしたけど、\n　なにがあったんですか？」\\nw[\\N[2]]":9,"「坑道内に\\C[17]モンスター\\C[0]が湧いて出ちまったんだよ！」\\nw[鉱山監督官]":10,"「あちゃー！　そりゃあご愁傷様だな。\n　で、駆除の予定はどうなってるんだ？」\\nw[\\N[1]]":11,"「王国軍にはとっくに討伐を願い出てるんだが、返事の\n　ひとつも来やしない。\\nw[鉱山監督官]":12,"「兵隊のアホどもめ！\n　ここが王国の金蔵だって分かってるのか！？」\\nw[鉱山監督官]":13,"「どうやら当面のあいだは操業停止状態が続きそうですね。\n　戻ってギルド長に報告しましょう」\\nw[\\N[2]]":14,"「ああ、そうだな……」\\nw[\\N[1]]":15,"「考えたんだが、坑道内のモンスターを倒すのと引き換えに\n　俺たちにも\\C[17]鉱石取引の権利\\C[0]を寄越すよう要求してみたら\n　どうだ……？」\\nw[\\N[1]]":16,"「はぁ？　なに言ってるんですか！？\n　わたしたちがモンスター退治って、本気ですか！？」\\nw[\\N[2]]":17,"「やってやれないことは、ないと思うんだが」\\nw[\\N[1]]":18,"「反対です！　反対！　無謀ですよ！\n　断固はんたーい！！」\\nw[\\N[2]]":19,"「うーん……どうするか……」\\nw[\\N[1]]":20,"鉱山（個別依頼01）":21,"鉱山監督官に、坑道内のモンスター退治を申し出ますか？":22,"申し出る":23,"やめておく":24,"「よう、監督官のおっさん。\n　坑道に出たモンスターだが、俺たちが退治してきて\n　やろうか？」\\nw[\\N[1]]":25,"「お前らが？　いったい何の冗談だ？」\\nw[鉱山監督官]":26,"「冗談でこんな話するかよ。\n　モンスターは一匹残らず狩ってきてやるから、代わりに\n　俺にも\\C[17]鉱石取引の権利\\C[0]をくれ」\\nw[\\N[1]]":27,"「ふんっ、やっぱり冗談にしか聞こえんぞ？\n　それも笑えない類の。\\nw[鉱山監督官]":28,"「まあ、もし本当にモンスターを残らず片付けてくれる\n　なら、取引の権利でもなんでもくれてやるがな」\\nw[鉱山監督官]":29,"「あぁ、言っちゃった……」\\nw[\\N[2]]":30,"「ようし、言質は取ったぞ！\n　必ずモンスターを一掃して戻ってくるから待ってろよ！」\\nw[\\N[1]]":31,"「はいはい、期待せずに待たせてもらうよ」\\nw[鉱山監督官]":32,"個別依頼\\C[17]『鉱山の解放』\\C[0]を受けた！":33,"依頼者にモンスター退治の成功を報告しますか？":34,"報告する":35,"報告しない":36,"依頼条件達成":37,"「約束通り、坑道内のモンスターは全部倒してきたぜ」\\nw[\\N[1]]":38,"「ま、まさか本当にやってのけるなんて！」\\nw[鉱山監督官]":39,"「苦労しましたよぉ……」\\nw[\\N[2]]":40,"「それじゃあ、鉱石取引の許可をいただこうか？」\\nw[\\N[1]]":41,"「ぐぬぬ……仕方ないか。\n　いいだろう、私の権限で商人\\N[1]に鉱石\n　取り引きの許可証を発行する！」\\nw[鉱山監督官]":42,"「やったぜ！」\\nw[\\N[1]]":43,"個別依頼\\C[17]『鉱山の解放』\\C[0]を達成した！":44,"報酬として\\C[17]鉱石取引の許可\\C[0]を得た！\n\\N[2]の信頼度が\\C[17]「５」\\C[0]上がった！":45,"\n\\>　 ※　鉱山監督官から\\C[17]鉱石\\C[0]が買えるようになった！　※":46,"ギルド長へ報告する前に個別依頼01を終わらせた場合":47,"「ではラノティカに戻って、ギルド長に報告しましょう」\\nw[\\N[2]]":48,"ギルド長へ報告してから個別依頼01を終わらせた場合":49,"依頼条件未達成":50,"「本当にモンスターを退治できるなら、ぜひとも\n　やってもらいたいもんだ」\\nw[鉱山監督官]":51,"EV005":52,"ユマ":53,"武器商ギルド秘密文書（横）":54,"<TE:75>":55,"坑夫":56,"「厄介事ってのは、突然きやがる」\\nw[坑夫]":57,"「二人でモンスターを退治しちまうとは、大したもんだ！」\\nw[坑夫]":58,"「知ってるか？　ラノティカの町の精錬所に行けば\n　\\C[17]ミスリル鉱石からミスリルインゴットを精錬\\C[0]できる\n　んだぜ」\\nw[坑夫]":59},"extension":"json","dataType":"map","filename":"Map214","basename":"Map214.json","path":"data/Map214.json","relPath":"data/Map214.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":60,"percent":0},"cellInfo":[]},"data/Map215.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["EV006",""],["EV007",""],["EV008",""],["EV009",""],["宝箱",""],["※\nアイテム：生命水",""],["↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）",""],["↓アイテムのIDNo.を変数に入力する",""],["↓アイテムの入手個数を変数に入力する",""],["↓アイテムの重量を変数に入力する",""],["EV011",""],["EV012",""]],"context":[["Map215/events/1/name"],["Map215/events/2/name"],["Map215/events/3/name"],["Map215/events/4/name"],["Map215/events/5/name"],["Map215/events/6/name"],["Map215/events/7/name"],["Map215/events/8/name"],["Map215/events/9/name"],["Map215/events/10/name"],["Map215/events/10/pages/0/list/0/comment"],["Map215/events/10/pages/0/list/2/comment"],["Map215/events/10/pages/0/list/5/comment"],["Map215/events/10/pages/0/list/7/comment"],["Map215/events/10/pages/0/list/9/comment"],["Map215/events/11/name"],["Map215/events/12/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],["red"],["red"],["red"],["gold"],["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["※"]}],[{"headerIndex":2,"headerParam":["↓宝箱に入っているアイテムの種類"]}],[{"headerIndex":5,"headerParam":["↓アイテムのIDNo.を変数に入力する"]}],[{"headerIndex":7,"headerParam":["↓アイテムの入手個数を変数に入力する"]}],[{"headerIndex":9,"headerParam":["↓アイテムの重量を変数に入力する"]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"EV006":5,"EV007":6,"EV008":7,"EV009":8,"宝箱":9,"※\nアイテム：生命水":10,"↓宝箱に入っているアイテムの種類\n　（0=アイテム、1=武器、2=防具、3=装飾品）":11,"↓アイテムのIDNo.を変数に入力する":12,"↓アイテムの入手個数を変数に入力する":13,"↓アイテムの重量を変数に入力する":14,"EV011":15,"EV012":16},"extension":"json","dataType":"map","filename":"Map215","basename":"Map215.json","path":"data/Map215.json","relPath":"data/Map215.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":17,"percent":0},"cellInfo":[]},"data/Map216.json":{"data":[["展示モンスター1",""],["展示モンスター2",""],["展示モンスター3",""],["展示モンスター4",""],["注意書き",""],["『\\C[18]※注意※\\C[0]\n　檻をつかまないでください。\n　展示モンスターに指を食い千切られる危険があります』",""],["燭台",""],["光",""],["EV024",""],["指名手配されているので、外へ出るわけにはいかない。",""],["EV025",""],["EV026",""],["EV031",""],["EV032",""],["係員",""],["「ここはＶＩＰ専用の入り口となっておりますので、\n　申し訳ありませんがご遠慮ください」\\nw[係員]",""],["売店員",""],["「えー、お酒におつまみ、いかがですかー？\n　観戦のお供におひとつどうぞー」\\nw[売店員]",""],["観戦客",""],["「こいつらは恐ろしいバケモンだけど、アルテトは\n　それ以上の怪物なんだよな……」\\nw[観戦客]",""],["「あのモンスターに犯されてた女の子……すごかったなぁ！\n　思い出すたびに股間がエレクトしちまうよ！」\\nw[観戦客]",""],["「こんな化け物と戦うなんて、ゾッとするぜ。\n　まあそれを観に来たんだけどな」\\nw[観戦客]",""],["「注目の剣闘士といえば、やはり“滅多突きのゲラン”\n　だろう」\\nw[観戦客]",""],["「なにやら腕っぷしの強い商人が、剣闘士として試合に\n　出ているらしいぞ」\\nw[観戦客]",""],["「例の商人剣闘士、快進撃が続いているらしいな。\n　こいつは要チェックだ」\\nw[観戦客]",""],["「チャンピオン・\\N[1]！\n　キミの戦いは実にエキサイティングだ！」\\nw[観戦客]",""],["「商人剣闘士\\N[1]！\n　私はすっかり彼のファンになってしまったよ。\n　……って本人！？」\\nw[観戦客]",""],["「ひとつ賭けをしないかね？\n　悪竜が王都まで来るかどうか、という内容で。\n　私は来ると睨んでいるよ」\\nw[観戦客]",""],["「僕が思うに、一番注目すべき剣闘士はグールをやすやすと\n　倒したあの“戦斧のトード”ですよ」\\nw[観戦客]",""],["「商人が新人剣闘士として出場している？\n　ふんっ、“戦斧のトード”と比べたら大したこと\n　ありませんよ」\\nw[観戦客]",""],["「なるほど、確かに噂の商人剣闘士は頑張っているようだ。\n　しかし、ボロが出るのも時間の問題でしょう」\\nw[観戦客]",""],["「私の一押し剣闘士“戦斧のトード”ですら敵わなかった\n　モンスターを倒すとは……。\n　確かにあんたがチャンピオンだ！」\\nw[観戦客]",""],["「\\N[1]なる商人剣闘士……\n　予想外に活躍しているようですね。\n　でもまさか“戦斧のトード”より強いなんてことは……」\\nw[観戦客]",""],["「私は王都にアルテトが来ることはないと思って\n　いますよ。その前に軍が退治するでしょう」\\nw[観戦客]",""],["「ここのメシは高い割りにいまいちだけど、料理店じゃ\n　ないから仕方ないか……」\\nw[観戦客]",""],["「噂は噂よ、悪竜復活だなんてバカバカしい。\n　それより注目の剣闘士の話をしましょ！」\\nw[観戦客]",""],["「亭主が働いてるあいだに、お酒飲んで剣闘観戦……\n　サイッコーね！」\\nw[観戦客]",""],["「悪竜やモンスターが来るかもしれないのに、\n　剣闘試合なんて見てていいのかって、不安になるわ」\\nw[観戦客]",""],["「わたしも亭主が仕事へ行ってるあいだに来たんだけど、\n　今月分の食費を半分以上スッちゃって……どうしよう」\\nw[観戦客]",""],["「ここに出場する剣闘士たち全員でかかれば、悪竜の\n　一匹くらい倒せるんじゃないかね？」\\nw[観戦客]",""],["「４０年間、この闘技場で賭け続けてきたワシの収支を\n　教えてやろうか？\\nw[観戦客]",""],["「＋１００Ｇじゃよ！」\\nw[観戦客]",""],["「データさえあれば、悪竜が王都を襲う確率を弾き出せる\n　のだがね」\\nw[観戦客]",""],["「統計学を駆使して、理論的に賭けていけば、\n　必ず儲けを出すことができるのだよ。\\nw[観戦客]",""],["「統計データがないので、いますぐは無理だけどね！」\\nw[観戦客]",""],["「悪竜と戦うより、ここでモンスターを相手にする方が\n　簡単なはず……でもやっぱり怖いなぁ……」\\nw[冒険者]",""],["「腕試しに出場してみるべきか……。\n　でもこんなところで大怪我でもしちゃったら……」\\nw[冒険者]",""],["「こいつったら、いっつもこんな調子で決断できないの。\n　そんなだから三流冒険者のままなのよ？」\\nw[冒険者]",""],["剣闘士",""],["「俺はやれば出来る子だ……そうだ、アルテトと戦う\n　わけじゃないんだ、これくらい簡単簡単……」\\nw[冒険者]",""],["「大丈夫だ……俺はやれば出来る子。\n　俺はやれば出来る子……」\\nw[冒険者]",""],["「本当にアルテトが甦ったのなら、一度戦ってみたい\n　もんだぜ。クククククッ……」\\nw[滅多突きのゲラン]",""],["「よう、チャンピオン。さすがの戦いぶりだったな。\n　だがその座、すぐにオレがいただくぜ」\\nw[滅多突きのゲラン]",""],["「くくっ……自分の戦いが始まるのを待っている\n　この時間、たまんねぇぜ」\\nw[滅多突きのゲラン]",""],["奴隷",""],["「自由の身になる前に、悪竜が襲ってきたりしない\n　だろうな……？　それだけは勘弁してくれよ」\\nw[奴隷剣闘士]",""],["「あと３回……あと３回勝てば、晴れて自由の身に\n　なれるんだ！」\\nw[奴隷剣闘士]",""],["「くそっ、盗賊の仲間なんかになっちまったせいで、\n　こんな羽目に……！　死にたくねぇよぉ……」\\nw[奴隷剣闘士]",""],["「あっ、ダメですよ～。\n　この先は試合出場者しか入れませんので～。\n　出場したいなら、受付へ行ってください～」\\nw[係員]",""],["「闘技場へようこそ！\n　観戦ですか？　それとも出場をご希望で？」\\nw[係員]",""],["観戦したい",""],["出場したい",""],["闘技場のルールについて",""],["やめておく",""],["「観戦は無料ですので、通路右奥の階段から観覧席へ\n　どうぞ」\\nw[係員]",""],["「出場をご希望ですね？\n　では初回登録を行いますので、こちらにサインを……\n　はい、結構です。\\nw[係員]",""],["「闘技場のルールについては、そこにある\\C[17]ルールブック\\C[0]に\n　書いてありますので、一度は目を通してください。\\nw[係員]",""],["「それでは左手奥の剣闘士用出入口へどうぞ。\n　次回からはこちらに声をかけずとも、出場できますよ」\\nw[係員]",""],["闘技場のルール",""],["MWL_行数変更 16",""],["\\>　　　　　　　　　『闘技場のルール』\n\\>\n\\>・戦えるのは主人公か\\N[2]のどちらか一人だけ。\n\\>\n\\>・１試合終わるごとに、そこでやめるか続けるか選択できる。\n\\>　連戦の場合、前の試合のダメージは残ったまま。\n\\>\n\\>・敗北したら剣闘試合は終了。\n\\>　次回は負けた相手との再試合からスタート。\n\\>\n\\>・一試合勝つごとに、賞品がひとつもらえる。\n\\>",""],["MWL_行数リセット",""],["「いらっしゃいませ。\n　観戦ですか？　それとも出場をご希望で？」\\nw[係員]",""],["「すでに出場登録はされているようですね。\n　左手奥の剣闘士用出入口へ、どうぞお進みください」\\nw[係員]",""],["闘技場ルール",""],["「剣闘試合に出場するなら、左奥の出場口へ\n　どうぞ～」\\nw[係員]",""],["係員（剣闘試合へ）",""],["エルラのところへ\\C[17]勝利を報告\\C[0]しに行かなければ。",""],["エルラのところへ\\C[18]敗北を報告\\C[0]しに行かなければ。",""],["全試合勝利後",""],["「新王者のあなたと戦えるような強いモンスターは、\n　すでにおりませんが、\\N[3]様のご要望により特別\n　試合を組ませていただきました」\\nw[係員]",""],["「新王者のあなたと戦えるような強いモンスターは、\n　すでにおりません」\\nw[係員]",""],["↓初回試合が第何試合になるか\n　（例：LV10で初試合なら第八試合（試合進行度7）から）",""],["「剣闘試合に出場しますか？」\n（出場する試合は第\\v[3]試合となります）\\nw[係員]",""],["出場する",""],["出場しない",""],["どちらが出場しますか？",""],["\\N[1]",""],["\\N[2]",""],["「ＨＰを回復されてから出場したほうが良いのでは？」\\nw[係員]",""],["EV056",""],["EV057",""],["「剣闘試合に出場する方は真っすぐ奥へお進みください。\n　賞品の受け渡しはこちらの部屋で行っております」\\nw[係員]",""],["BGS消去",""],["料理1",""],["料理（昼）1",""],["料理（昼）2",""],["冒険者",""],["「悪竜の噂が本当なら、そろそろ王都を離れるべきかも\n　しれんな」\\nw[冒険者]",""],["「夜間の剣闘観戦は楽しいのぅ！\n　酒もうまいわい！」\\nw[冒険者]",""],["「夜間の闘技観戦は楽しいのぅ！\n　酒もうまいわい！」\\nw[冒険者]",""],["老人",""],["「悪竜復活を天罰だと言う者もいるが、そんなわけ\n　あるものか」\\nw[老人]",""],["「また朝帰りで嫁にどやされてしまうが、こればっかりは\n　やめられんのだ」\\nw[老人]",""],["エルラ",""],["これまだ甦った\\N[6]が退治される前の話――。",""],["「げっ！？　\\N[2]とクソ雑魚フード男！\n　なんでこんな所に！」\\nw[\\N[3]]",""],["「そりゃこっちのセリフだ、メスガキ」\\nw[\\N[1]]",""],["「今日は\\N[3]一人なの？\n　あの執事の人がいないみたいだけど？」\\nw[\\N[2]]",""],["「\\N[4]は別の仕事に行ってるのよ。\n　ウチの商会はあんたらと違って暇じゃないんでね！」\\nw[\\N[3]]",""],["「そう言うお前はサボって剣闘観戦か？\n　けっこうなご身分だな」\\nw[\\N[1]]",""],["「はぁ！？　ふざけんじゃないわよ！\n　あたしだって仕事で来てんのよ！\\nw[\\N[3]]",""],["「剣闘試合に使われるモンスターを納品しに来たの！」\\nw[\\N[3]]",""],["「ええっ！？\n　\\N[3]、モンスターまで商品として扱ってるの！？」\\nw[\\N[2]]",""],["「そうよ！\n　ウチの商会は扱う品をどんどん広げていってるの！\\nw[\\N[3]]",""],["「いえ、ウチだけじゃないわ。\n　武器商ギルド自体があらゆる分野の売買に進出して\n　いってるのよ！\\nw[\\N[3]]",""],["「そう遠くないうちに商業ギルドは潰れて、あたしたち\n　武器商ギルドの天下が来るわ！」\\nw[\\N[3]]",""],["「王に媚びて武器流通の特権を握ったのも、そのための\n　布石ってわけか。\\nw[\\N[1]]",""],["「だがそううまく行くかな？」\\nw[\\N[1]]",""],["「行かせるのよ、このあたしがね！」\\nw[\\N[3]]",""],["「すごい自信……」\\nw[\\N[2]]",""],["「自信だけは、な」\\nw[\\N[1]]",""],["「で、あんたらは何をしに闘技場まで来たのよ？\n　まさか剣闘試合に出るつもりじゃないでしょうね？」\\nw[\\N[3]]",""],["「なんだ、知らなかったのか？\n　俺たちは人気急上昇中の新人剣闘士だぞ」\\nw[\\N[1]]",""],["「はあぁっ？！　あんたらがぁ！？\n　冗談でしょ！\\nw[\\N[3]]",""],["「あんたらみたいな素人が、あたしの調達してきた\n　凶悪モンスターに勝てるわけないじゃない！」\\nw[\\N[3]]",""],["「そ、そんなことないよ！\n　わたしたちだって、経験を積んで強くなってるんだから！」\\nw[\\N[2]]",""],["「だったら賭けでもしてみる？\n　もし次の試合であんたらが負けたら――。\\nw[\\N[3]]",""],["「\\N[2]が\\C[17]全裸でその檻の中へ入ってモンスターにタッチ\n　してくる\\C[0]ってのはどう？」\\nw[\\N[3]]",""],["「ぜ、全裸でって……そんなのどうなっちゃうか……\n　考えただけで、あぁ……\\I[29]」\\nw[\\N[2]]",""],["「ぜ、全裸でって……そんなの無理っ！\n　無理ムリむりぃっ！！」\\nw[\\N[2]]",""],["「その賭け乗った！」\\nw[\\N[1]]",""],["「本気ですか、\\N[1]さん！？\n　ど、どうしよ～\\I[29]」\\nw[\\N[2]]",""],["「ええええぇええぇっ！！？」\\nw[\\N[2]]",""],["「ただし俺たちが勝った場合は、当然同じことをお前に\n　してもらうぞ」\\nw[\\N[1]]",""],["「別にいいけどぉ～。\n　どうせあんたらに勝つ見込みなんて無いんだしぃ～」\\nw[\\N[3]]",""],["（そもそも、あたしってば闘技場の運営者とはズブズブの\n　間柄だからね）\\nw[\\N[3]]",""],["（それとなく妨害行為を加えるくらい、朝飯前よ！）\\nw[\\N[3]]",""],["「なら、賭けは成立だな。\n　不都合な結果になったからといって、逃げるなよ？」\\nw[\\N[1]]",""],["「そっちこそね。\n　\\N[2]が全裸でモンスターと戯れるところ、じっくり\n　眺めてやるから！」\\nw[\\N[3]]",""],["（負けたらモンスターに……じゃあ無理に勝たなくても\\I[29]\n　でも\\N[3]とモンスターの絡みも見てみたいなぁ\\I[29]）\\nw[\\N[2]]",""],["「やだぁっ！\n　そんな賭け、わたしはやりたくないですよぉっ！！」\\nw[\\N[2]]",""],["\\>\\C[17]　※　次の剣闘試合で\\N[3]との賭けが行われます。　※\\C[0]\n （主人公側が敗北したときは\\N[2]のエッチイベントあり）",""],["「次の剣闘試合であんたらが負けたら、\\N[2]は\\C[17]全裸で\n　モンスターの檻の中\\C[0]行きよ！」\\nw[\\N[3]]",""],["「俺たちが勝ったらメスガキ、お前が檻の中だ。\n　忘れるなよ？」\\nw[\\N[1]]",""],["会話マーク",""],["闘技場賭け結果Ev",""],["賭けに勝利・エルラ異種姦",""],["「なんであんたらが勝ってんのよ！？\n　こ……こんなはずじゃ……」\\nw[\\N[3]]",""],["「逃げなかったとは感心だな。\n　それじゃ全裸で檻の中へ入って、モンスターにタッチ\n　して来てもらおうか？」\\nw[\\N[1]]",""],["「\\N[3]……。\\nw[\\N[2]]",""],["「ね、\\N[1]さんに謝ろ？\n　土下座して陳謝すれば、きっと許してくれるよ」\\nw[\\N[2]]",""],["「ど、土下座ですって！？　このあたしが！？\n　こんな道端の犬の糞みたいな男に！？」\\nw[\\N[3]]",""],["「その犬の糞に負けたクソ以下の存在がお前なんだよ。\n　さっさと服を脱いで檻に入りやがれ！」\\nw[\\N[1]]",""],["「\\N[3]、そこまですることないよ！\n　自分が悪かったって謝ってくれれば――」\\nw[\\N[2]]",""],["「うるさいうるさい！\n　だっ、誰が謝ったりするもんですか！\\nw[\\N[3]]",""],["「あんたらに頭を下げるくらいなら、あたしは檻の中に\n　入ってやるッ！！\\nw[\\N[3]]",""],["「みっ、見てなさいよ！」\\nw[\\N[3]]",""],["「なんだなんだ？　この騒ぎは？」\\nw[観戦客Ａ]",""],["「すげえぞっ！\n　女の子が全裸でモンスターのいる檻の中に入った！」\\nw[観戦客Ｂ]",""],["「ひぇ～！\n　あの子、頭おかしいんじゃないの？」\\nw[観戦客Ｃ]",""],["「は……ははっ……。\n　な、なによ、大したことないじゃない……！\\nw[\\N[3]]",""],["「ほらっ！　入ったわよ！\n　あとはちょっと、モンスターに触ってやれば……」\\nw[\\N[3]]",""],["「ひっ！？　や、やめっ……近づくなぁ！\n　こ、この下等モンスター！」\\nw[\\N[3]]",""],["「くるなっ！\n　ひいいぃっ！？　さわるなぁっ！\\nw[\\N[3]]",""],["「いやあああぁぁっ？！！」\\nw[\\N[3]]",""],["エルラ異種姦Ev\n↓　　↓　　↓",""],["\\N[3]との賭けに勝った！\n\\N[2]の信頼度が\\C[17]「１０」\\C[0]上がった！",""],["「うぐぐ……おのれっ、フード男と\\N[2]めぇ……！\n　この借りは絶対に……ぜぇーったいに返してやるッ！！」\\nw[\\N[3]]",""],["↑　　↑　　↑\nエルラ異種姦Ev",""],["賭けに敗北・ユマ異種姦",""],["「あっはははっ！！　負けてやんの！\n　無様すぎるぅ～！！」\\nw[\\N[3]]",""],["「くそっ……！\n　魔法を使った妨害行為がなけりゃ……！\\nw[\\N[1]]",""],["「おいメスガキ！\n　あの魔法はお前の差し金だろ！？」\\nw[\\N[1]]",""],["「はぁ？　なんのことかしら？\n　この期に及んで言い訳とか、見苦しいんですけどぉ？」\\nw[\\N[3]]",""],["「ま、負けちゃった……。\n　全裸であの檻に……わたしどうなっちゃうのぉ\\I[29]」\\nw[\\N[2]]",""],["「ま、負けちゃった……。\n　全裸であの檻に……いやあぁ……」\\nw[\\N[2]]",""],["「さあ、約束を果たしてもらいましょうか？\n　ほらっ、ほらっ！　はーやーくぅー！！」\\nw[\\N[3]]",""],["「チッ！　仕方ない……行け\\N[2]！\n　ちょっと入ってモンスターにタッチすれば済む話だ」\\nw[\\N[1]]",""],["「あ、言っておくけど、檻の外から助けに入るのはナシよ！\n　ちゃんと自力で出てくること！」\\nw[\\N[3]]",""],["「し、仕方ないなぁ\\I[29]\n　約束だもんね、入らなきゃ……うふふ……\\I[29]」\\nw[\\N[2]]",""],["「そんなあああぁぁっ！！？」\\nw[\\N[2]]",""],["「はぁ……はぁ……\\I[29]\n　闘技場のお客さんにすっごく見られてる\\I[29]\\nw[\\N[2]]",""],["「お客さんだけじゃない……モンスターもわたしの\n　体を見てる……\\I[29]」\\nw[\\N[2]]",""],["「あ……あぁ……ひいぃぃ……。\\nw[\\N[2]]",""],["「ちょ、ちょっと触ったらダッシュで逃げますからね！\n　檻の出入り口、開けておいてくださいよ！」\\nw[\\N[2]]",""],["「わぁっ！？　近づいてきたぁ\\I[29]」\\nw[\\N[2]]",""],["「うわっ、わわわっ！？\n　こ、来ないで！　いやっ！！」\\nw[\\N[2]]",""],["「ど、どうなっちゃうの？\n　わたし、どうされちゃうのぉ\\I[29]」\\nw[\\N[2]]",""],["「いっ、いやっ！　近づかないで！\n　わたしもう外に出るんだから！　出るんだからぁっ！！\\nw[\\N[2]]",""],["「いやあああぁああぁぁっ！！？」\\nw[\\N[2]]",""],["ユマ異種姦Ev\n↓　　↓　　↓",""],["「\\N[2]の淫乱ぶり、あれは何よ！　ドン引きだわ！\n　でも勝ったのはあたしだからね！　あんたらの負け！」\\nw[\\N[3]]",""],["「おぉ～ほっほっほっ！　いいものが見れたわぁ。\n　ざまぁないわね、\\N[2]！」\\nw[\\N[3]]",""],["「モンスターに犯されるなんて初めてでしたけど、\n　すっごく興奮しちゃいましたぁ\\I[29]」\\nw[\\N[2]]",""],["「そ、そうか？　まあなんだ……お前が気にしていない\n　のなら、それでいいが……」\\nw[\\N[2]]",""],["\\N[3]との賭けに負けてしまった！\n\\N[2]の信頼度が\\C[18]「５」\\C[0]下がった！\n\\N[2]の発情度が\\C[18]「１０」\\C[0]上がった！",""],["「こんな酷い目に遭ったのも、全部\\N[1]さんが\n　賭けを受けたりしたから……恨みますよ……」\\nw[\\N[2]]",""],["「わ、悪かった。今回ばかりは俺の落ち度だ。\n　ほんとうにスマン……」\\nw[\\N[2]]",""],["\\N[3]との賭けに負けてしまった！\n\\N[2]の信頼度が\\C[18]「４０」\\C[0]下がった！",""],["↑　　↑　　↑\nユマ異種姦Ev",""],["闘技場売店",""],["「試合前に回復薬の補充はいかがでしょう？」\\nw[係員]",""],["ShopInventory apply shop309",""],["ショップ拡張設定 購入/売却コマンド表示最適化",""],["ショップ拡張設定 購入価格レート 変数 #1",""],["ユマ（闘技場）",""],["EV071",""],["EV072",""],["EV073",""],["EV074",""],["EV075",""],["EV076",""],["EV077",""],["檻出入り口",""],["トイレドア（排泄Ev）",""],["トイレで用を足しますか？",""],["入る",""],["入らない",""],["いまのところ用を足す必要は無い。",""],["EV080",""],["トイレマーク（屋内用）",""],["<TE:84>",""],["ユマ（トイレ）",""],["闘技場職員（奴隷買い取り）",""],["奴隷市（フキダシ）",""],["秘密の出入口",""],["アジト",""],["EXITマーク",""],["「悪竜\\N[6]か……一度でいいからオレの斧を\n　叩き込んでやりたいもんだ」\\nw[戦斧のトード]",""],["「おいチャンピオン、勘違いするなよ？\n　オレがトップの座に興味が無いから、お前はその地位に\n　いられるだけなんだぞ」\\nw[戦斧のトード]",""],["「モンスターの肉をぶった斬る感触が好きで、オレは\n　剣闘を続けているのさ」\\nw[戦斧のトード]",""]],"context":[["Map216/events/1/name"],["Map216/events/2/name"],["Map216/events/3/name"],["Map216/events/4/name"],["Map216/events/5/name"],["Map216/events/5/pages/0/list/0/message/noPicture/bottom"],["Map216/events/6/name","Map216/events/7/name","Map216/events/8/name","Map216/events/9/name","Map216/events/10/name","Map216/events/11/name","Map216/events/12/name","Map216/events/13/name","Map216/events/14/name","Map216/events/29/name","Map216/events/30/name"],["Map216/events/15/name","Map216/events/16/name","Map216/events/17/name","Map216/event