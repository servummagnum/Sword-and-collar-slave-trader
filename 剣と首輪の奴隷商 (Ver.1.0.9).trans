["",0,0,2]}],[{"headerIndex":44,"headerParam":["",0,0,2]}],[{"headerIndex":50,"headerParam":["",0,0,2]}],[{"headerIndex":54,"headerParam":["",0,0,2]}],[{"headerIndex":62,"headerParam":["",0,0,2]}],[{"headerIndex":69,"headerParam":["",0,0,2]}],[{"headerIndex":74,"headerParam":["",0,0,2]}],[{"headerIndex":105,"headerParam":["",0,0,2]}],[{"headerIndex":112,"headerParam":["",0,0,2]}],[{"headerIndex":126,"headerParam":["",0,0,2]}],[{"headerIndex":129,"headerParam":["",0,0,1]}],null,null,[{"headerIndex":4,"headerParam":["",0,0,2]}],[{"headerIndex":16,"headerParam":["",0,0,2]}],[{"headerIndex":41,"headerParam":["",0,0,2]}],[{"headerIndex":44,"headerParam":["",0,0,2]}],[{"headerIndex":54,"headerParam":["",0,0,2]}],[{"headerIndex":57,"headerParam":["",0,0,2]}],[{"headerIndex":75,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":2,"headerParam":["",0,0,2]}],null,null,null,[{"headerIndex":15,"headerParam":["",0,0,1]}],null,null,null,[{"headerIndex":8,"headerParam":["",0,0,1]}],null,[{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]},{"headerIndex":0,"headerParam":["",0,0,1]}],null,[{"headerIndex":1,"headerParam":["",0,0,2]}],null,[{"headerIndex":4,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"大司教(報告Ev)":2,"「だっ、大司教様！\n　おくつろぎのところ、申し訳ありません！」\\nw[僧侶]":3,"「どうした？」\\nw[大司教]":4,"「ただいま大司教様にお目通り願いたいという、\n　奴隷商人が来ておりまして――」\\nw[僧侶]":5,"「それがなんだというのだ？\n　いつものように、適当に追い返しておけ」\\nw[大司教]":6,"「はっ！\n　し、しかしその奴隷商人、１０万Ｇもの寄付金を\n　持参してきておりまして」\\nw[僧侶]":7,"「ほう、１０万Ｇだと？\\nw[大司教]":8,"「どうやらワシに会うにはどうしたらいいか、わきまえて\n　おる商人のようだな」\\nw[大司教]":9,"見張り1":10,"見張り2":11,"「ここは大司教様の私室だ」\\nw[見張り僧侶]":12,"大司教(エッチEv)":13,"「さあて、それでは二人まとめて――」\\nw[大司教]":14,"「お待ちになって、大司教様。\n　二人一緒だなんて雑な抱き方は、もったないですわ。\\nw[スパイ尼僧]":15,"「まずはわたしのご奉仕を、ぜひお受けいただけません？」\\nw[スパイ尼僧]":16,"「はははっ、ワシを独り占めしたいのか！？\n　この卑しいメス奴隷め！\\nw[大司教]":17,"「いいだろう、まずはお前からだ！」\\nw[大司教]":18,"「はいっ、楽しみですわぁ」\\nw[スパイ尼僧]":19,"\\}「\\N[2]さん、私が大司教の気を引いている隙に、『覚え書き』を探してください。\\{\\nw[スパイ尼僧]":20,"\\}「この部屋のどこかに、絶対にあるはずですから」\\{\\nw[スパイ尼僧]":21,"\\}「わ、わかりました……！」\\{\\nw[\\N[2]]":22,"「ではベッドへ上がる前に、裸になってこの頭巾を\n　かぶるのだ」\\nw[大司教]":23,"「これは……尼僧の頭巾では？」\\nw[スパイ尼僧]":24,"「そうだ。\n　尼僧を犯すことに興奮するというのに、最近は\n　色々あって手を出しにくくなってしまってな――。\\nw[大司教]":25,"「だからお前が尼僧となるのだ！」\\nw[大司教]":26,"（あの人、スパイだけど本職の尼僧でもあるよね？\n　精神的にキツくないかな……心配……）\\nw[\\N[2]]":27,"「わたし、尼僧になって犯されちゃうの？\n　ステキ\\I[29]　興奮しちゃうわ\\I[29]」\\nw[スパイ尼僧]":28,"（プロのスパイって、すごいなぁー……）\\nw[\\N[2]]":29,"「いいぞ、いいぞ！\n　ワシの聖なる肉棒もたぎってきおった！\\nw[大司教]":30,"「ヒィヒィ言わせてやるから、覚悟しろ！」\\nw[大司教]":31,"\nここでエッチイベント\n↓　　↓　　↓":32,"↑　　↑　　↑\nここでエッチイベント\n　":33,"「ふぅ～、満足させてもらったぞ。\n　さて次は、あの猫人の娘を――」\\nw[大司教]":34,"「まっ、待って大司教様！\n　こんなんじゃ足りないわ\\I[29]　もっとちょうだぁい\\I[29]」\\nw[スパイ尼僧]":35,"「あれだけ責めてやったのに、まだ足りないだと？\n　このド淫乱め！\\nw[大司教]":36,"「いいだろう！　イキ狂って気絶するまで犯してやる！」\\nw[大司教]":37,"「わぁ、またやっちゃうんだ\\I[29]\n　スパイさんのアソコ、あんなにグチョグチョで種まみれ\n　なのに……\\I[29]」\\nw[\\N[2]]":38,"「うわっ、まだやるの……？\n　スパイさんのアソコ、あんなにグチョグチョで種まみれ\n　なのに……」\\nw[\\N[2]]":39,"（\\N[2]さん、なにを見入っているんですか！？\n　早く、今のうちに捜索を……！）\\nw[スパイ尼僧]":40,"「んああぁああぁぁっ\\I[29]\n　大司教様のおちんぽぉ、きもちいいぃぃっ\\I[29]\\nw[スパイ尼僧]":41,"「もっと奥までぇ\\I[29]\n　わたしの感じるところ、おちんぽで\\C[17]探し当ててぇ\\C[0]\\I[29]」\\nw[スパイ尼僧]":42,"（ハッ！　そうだ！\n　ボーっとしてる場合じゃない！）\\nw[\\N[2]]":43,"（大司教がスパイさんに夢中になってるあいだに、\n　\\C[17]『覚え書き』\\C[0]を探さないと！）\\nw[\\N[2]]":44,"usefultimer timer width set 200":45,"usefultimer timer height set 120":46,"usefultimer timer fontsize set 60":47,"usefultimer timer x set 616":48,"usefultimer timer y set 0":49,"usefultimer timer start 20*60":50,"usefultimer timer pause":51,"\\>\\C[17]　※　２０秒以内に、部屋の中から『覚え書き』を　※\n\\>　※　見つけ出せ！　　　　　　　　　　　　　　　※\\C[0]\n\\> （見つけられなかったとき\\N[2]のエッチイベントあり）\\<":52,"\n\\>　　　　　 （決定ボタンを押してスタート）\\<":53,"usefultimer timer resume":54,"覚え書き捜索失敗のとき":55,"「おいっ！　なにをコソコソやってる！？」\\nw[大司教]":56,"「うぇっ？！\n　べ、別になにも探してませんよー？」\\nw[\\N[2]]":57,"「怪しい！　怪しすぎる！\n　まさかキサマ、大聖堂本部の回し者か！？」\\nw[大司教]":58,"「ちちち、違いますよっ！？\n　なんのことだかさっぱり！」\\nw[\\N[2]]":59,"「おいっ！」\\nw[大司教]":60,"「どうなさいました、大司教様？」\\nw[見張り僧侶Ａ]":61,"「この娘、不審すぎる！　スパイかもしれん！\n　ワシが直々に取り調べてやるから、服を剥ぎ取れ！」\\nw[大司教]":62,"「取り調べですか！　喜んでお手伝いいたします！」\\nw[見張り僧侶Ａ]":63,"「さあ、大司教様の前でその汚い服を脱ぐんだ！」\\nw[見張り僧侶Ｂ]":64,"「こ、こういうのはキライじゃないですけど、\n　いまはちょっとマズいというか……」\\nw[\\N[2]]":65,"「ま、待ってください！　いやあぁっ！？」\\nw[\\N[2]]":66,"（ごめんなさい、\\N[2]さん。\n　いまあなたを庇ったら私まで拘束されてしまうから、\n　見ているしかないの……）\\nw[スパイ尼僧]":67,"覚え書き発見したとき":68,"「やった！　見つけた！\n　あとはこれを持って外に出るだけ――。\\nw[\\N[2]]":69,"「でも、入り口には見張りがいるし、どうやって\n　逃げたらいいんだろ……？」\\nw[\\N[2]]":70,"「きゃああああぁあぁっ！？」\\nw[スパイ尼僧]":71,"「ど、どうした！？\n　いきなり悲鳴をあげて」\\nw[大司教]":72,"「いまっ……ま、窓の向こうから誰かがこっちを\n　覗いて……」\\nw[スパイ尼僧]":73,"「なんだとッ！？\n　さては大聖堂本部のスパイか！？」\\nw[大司教]":74,"「おいっ！　お前たち！\n　曲者が出たぞ！　聖堂の外を探してこい！」\\nw[大司教]":75,"「ハッ！　ただちに！」\\nw[見張り僧侶]":76,"「おのれ、しつこく嗅ぎ回りおって！\n　しかし絶対に証拠はつかませんぞ！」\\nw[大司教]":77,"\\}「\\N[2]さん、いまのうちに外へ！」\\{\\nw[スパイ尼僧]":78,"「あっ……\\}はいっ、わかりました！\\{」\\nw[\\N[2]]":79,"\n\\>　　　　　\\C[17]※　急いで聖堂の外へ逃げよう　※\\C[0]":80,"僧侶（言伝て）":81,"受け渡しEv":82,"「そこで止まりなさい」\\nw[見張り僧侶]":83,"「おお、来たか来たか。\n　ぐふふふ……二人とも部屋に入るがいい」\\nw[大司教]":84,"「どちらも上玉だな。\n　ちょうどこれまで使ってた女に、飽きてきたところだ。\\nw[大司教]":85,"「じっくり、たっぷりと、可愛がってやるからな」\\nw[大司教]":86,"「奴隷商人、お前はなかなか気の利くヤツだな。\n　今度、大きな仕事を回してやるから楽しみにしていろ。\\nw[大司教]":87,"「ではもう帰っていいぞ」\\nw[大司教]":88,"「ぐふふふっ……！」\\nw[大司教]":89,"ユマ":90,"スパイ尼僧":91,"注意":92,"\\C[17]※注意※\\C[0]\nここから先、しばらく『メニュー』が使えなくなります。\n必要であれば今のうちにセーブを行ってください。":93,"スパイ尼僧2":94,"覚え書き捜索タイマー":95,"usefultimer timer textcolor set #ff0000":96,"\n　　　　　　　\\C[10]※　タイムオーバー！　※\\C[0]":97,"usefultimer timer textcolor reset":98,"usefultimer timer stop":99,"覚え書き発見":100,"\n　　　\\C[17]※　『大司教の覚え書き』を見つけた！！　※\\C[0]":101,"覚え書き捜索先":102,"ここに『覚え書き』は無さそうだ。":103,"部屋脱出禁止":104,"「この部屋を出てはダメだ！」\\nw[見張り僧侶]":105,"奴隷引き渡し誘導":106,"大司教に見つからないよう、逃げなければ。":107},"extension":"json","dataType":"map","filename":"Map136","basename":"Map136.json","path":"data/Map136.json","relPath":"data/Map136.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":108,"percent":0},"cellInfo":[]},"data/Map137.json":{"data":[["EV001",""],["EV002",""],["学僧",""],["「ここタータミアから南に行った砂漠には、\\C[17]古代の遺跡\\C[0]が\n　あるんだそうだ。\\nw[学僧]",""],["「王国内にも遺跡はあるけど、それらはいったい誰が\n　造ったものなのか……」\\nw[学僧]",""],["燭台",""],["光",""],["本",""],["MWL_行数変更 16",""],["\\>　　　　　『タータミア教区・布教日誌』\n\\>\n\\>『王国北部では、猫人の土着宗教の取り込みが功を奏し\n\\>　たことで四聖教の布教は順調に進んでいるが、ここ\n\\>　南部では事情がまったく違う。\n\\>　\n\\>　独自の宗教観を持つ砂漠の民はもとより、王国の民\n\\>　であっても未だに異教の神をまつる者が珍しくなく、\n\\>　改宗をうながすには更に多くの時間と金銭と労力が\n\\>　かかることだろう。\n\\>　\n\\>　前任者からは根気強く進めていくよう言われたが、\n\\>　果たしてどこまでやれるものか……』",""],["MWL_行数リセット",""],["\\>　　『魔物ごはん　～モンスターを捌いて食す～』\n\\>\n\\>『……意外とうまいのがワームだった。肉は柔らかく、\n\\>　臭みはほとんどない。\n\\>　軽く火で炙って塩をまぶすだけでもいけるが、お勧め\n\\>　はソテーだ。\n\\>　\n\\>　他に美味い部類のモンスターというと、プレデター\n\\>　がいる。味はチキンに似ており、チキン料理と同じ\n\\>　調理法でだいたいいける。\n\\>\n\\>　ただしプレデターはしばしば人間や亜人を襲って\n\\>　食い殺すので、その肉を食べるのに抵抗がないと\n\\>　言えば嘘になる』",""]],"context":[["Map137/events/1/name"],["Map137/events/2/name"],["Map137/events/3/name"],["Map137/events/3/pages/0/list/0/message/noPicture/bottom"],["Map137/events/3/pages/0/list/3/message/noPicture/bottom"],["Map137/events/4/name"],["Map137/events/5/name"],["Map137/events/6/name","Map137/events/7/name"],["Map137/events/6/pages/0/list/2/Plugin Command","Map137/events/6/pages/1/list/2/Plugin Command","Map137/events/7/pages/0/list/2/Plugin Command","Map137/events/7/pages/1/list/2/Plugin Command"],["Map137/events/6/pages/0/list/3/scrollingMessage","Map137/events/6/pages/1/list/3/scrollingMessage"],["Map137/events/6/pages/0/list/17/Plugin Command","Map137/events/6/pages/1/list/17/Plugin Command","Map137/events/7/pages/0/list/18/Plugin Command","Map137/events/7/pages/1/list/18/Plugin Command"],["Map137/events/7/pages/0/list/3/scrollingMessage","Map137/events/7/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":3,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"学僧":2,"「ここタータミアから南に行った砂漠には、\\C[17]古代の遺跡\\C[0]が\n　あるんだそうだ。\\nw[学僧]":3,"「王国内にも遺跡はあるけど、それらはいったい誰が\n　造ったものなのか……」\\nw[学僧]":4,"燭台":5,"光":6,"本":7,"MWL_行数変更 16":8,"\\>　　　　　『タータミア教区・布教日誌』\n\\>\n\\>『王国北部では、猫人の土着宗教の取り込みが功を奏し\n\\>　たことで四聖教の布教は順調に進んでいるが、ここ\n\\>　南部では事情がまったく違う。\n\\>　\n\\>　独自の宗教観を持つ砂漠の民はもとより、王国の民\n\\>　であっても未だに異教の神をまつる者が珍しくなく、\n\\>　改宗をうながすには更に多くの時間と金銭と労力が\n\\>　かかることだろう。\n\\>　\n\\>　前任者からは根気強く進めていくよう言われたが、\n\\>　果たしてどこまでやれるものか……』":9,"MWL_行数リセット":10,"\\>　　『魔物ごはん　～モンスターを捌いて食す～』\n\\>\n\\>『……意外とうまいのがワームだった。肉は柔らかく、\n\\>　臭みはほとんどない。\n\\>　軽く火で炙って塩をまぶすだけでもいけるが、お勧め\n\\>　はソテーだ。\n\\>　\n\\>　他に美味い部類のモンスターというと、プレデター\n\\>　がいる。味はチキンに似ており、チキン料理と同じ\n\\>　調理法でだいたいいける。\n\\>\n\\>　ただしプレデターはしばしば人間や亜人を襲って\n\\>　食い殺すので、その肉を食べるのに抵抗がないと\n\\>　言えば嘘になる』":11},"extension":"json","dataType":"map","filename":"Map137","basename":"Map137.json","path":"data/Map137.json","relPath":"data/Map137.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":12,"percent":0},"cellInfo":[]},"data/Map138.json":{"data":[["EV001",""],["EV002",""],["EV003",""],["EV004",""],["EV005",""],["司祭",""],["燭台",""],["光",""],["尼僧（依頼01・02）",""],["依頼を出している場合",""],["依頼を出していない場合",""],["「お金も大切でしょうが、そのために人の道を外れては\n　いけません。どうかお気をつけて」\\nw[尼僧]",""],["依頼フキダシ",""]],"context":[["Map138/events/1/name"],["Map138/events/2/name"],["Map138/events/3/name"],["Map138/events/4/name"],["Map138/events/5/name"],["Map138/events/6/name"],["Map138/events/7/name","Map138/events/8/name"],["Map138/events/9/name","Map138/events/10/name"],["Map138/events/11/name"],["Map138/events/11/pages/0/list/0/comment"],["Map138/events/11/pages/0/list/19/comment"],["Map138/events/11/pages/0/list/20/message/noPicture/bottom"],["Map138/events/12/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["gold"],["red"],["red"],null,["gold"]],"parameters":[null,null,null,null,null,null,null,null,null,[{"headerIndex":0,"headerParam":["依頼を出している場合"]}],[{"headerIndex":19,"headerParam":["依頼を出していない場合"]}],[{"headerIndex":20,"headerParam":["",0,0,2]}]],"indexIds":{"EV001":0,"EV002":1,"EV003":2,"EV004":3,"EV005":4,"司祭":5,"燭台":6,"光":7,"尼僧（依頼01・02）":8,"依頼を出している場合":9,"依頼を出していない場合":10,"「お金も大切でしょうが、そのために人の道を外れては\n　いけません。どうかお気をつけて」\\nw[尼僧]":11,"依頼フキダシ":12},"extension":"json","dataType":"map","filename":"Map138","basename":"Map138.json","path":"data/Map138.json","relPath":"data/Map138.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":13,"percent":0},"cellInfo":[]},"data/Map139.json":{"data":[["EV001",""],["EV002",""],["学僧",""],["「犯罪者を奴隷として使役する、という王国の風習は\n　我々の祖先が開拓者としてこの地にやってきたことと\n　関係があるようだ。\\nw[学僧]",""],["「つまり国造りの仕事が山積みの中、牢屋で人手を遊ばせて\n　おく余裕なんて無かったってわけだ」\\nw[学僧]",""],["光",""],["燭台",""],["本",""],["MWL_行数変更 16",""],["\\>　　　『殺虫の心得　～虫モンスター対処法～』\n\\>\n\\>『……これらクモ、ハチ、サソリ、ワームといった虫系\n\\>　のモンスターは、概して風属性に弱く地属性に強いと\n\\>　いった特徴を持つ。\n\\>　魔法防御も特別高くはないので、あなたが魔法使いで\n\\>　あれば、風属性魔法を使用することをお勧めする。\n\\>　\n\\>　しかし弱点が分かっているからと、油断してはいけな\n\\>　い。毒を持つ虫モンスターは多いので、解毒のための\n\\>　アイテムや魔法は必須だ。また……』",""],["MWL_行数リセット",""],["\\>　　　　　　　『王国の危険地帯』\n\\>\n\\>『……わけても危険視される場所のひとつが、迷いの森\n\\>　と呼ばれる大森林地帯だ。\n\\>　中は常に霧がかかっており、方角を見失いやすい。\n\\>　更に多くのモンスターが跳梁跋扈しているため、事前\n\\>　の準備もなく入れば、外へ逃げることもままならずに\n\\>　怪物の腹の中へ収められてしまうだろう。\n\\>　\n\\>　しかし迷いの森には様々な神秘的伝説もあり、いまも\n\\>　その謎に挑もうとする冒険者が後を絶たないのである』",""]],"context":[["Map139/events/1/name"],["Map139/events/2/name"],["Map139/events/3/name"],["Map139/events/3/pages/0/list/0/message/noPicture/bottom"],["Map139/events/3/pages/0/list/4/message/noPicture/bottom"],["Map139/events/4/name"],["Map139/events/5/name"],["Map139/events/6/name","Map139/events/7/name"],["Map139/events/6/pages/0/list/2/Plugin Command","Map139/events/6/pages/1/list/2/Plugin Command","Map139/events/7/pages/0/list/2/Plugin Command","Map139/events/7/pages/1/list/2/Plugin Command"],["Map139/events/6/pages/0/list/3/scrollingMessage","Map139/events/6/pages/1/list/3/scrollingMessage"],["Map139/events/6/pages/0/list/15/Plugin Command","Map139/events/6/pages/1/list/15/Plugin Command","Map139/events/7/pages/0/list/15/Plugin Command","Map139/events/7/pages/1/list/15/Plugin Command"],["Map139/events/7/pages/0/list/3/scrollingMessage","Map139/events/7/pages/1/list/3/scrollingMessage"]],"tags":[["gold"],["gold"],["gold"],null,null,["gold"],["gold"],["gold"],["blue"],null,["blue"]],"parameters":[null,null,null,[{"headerIndex":0,"headerParam":["",0,0,2]}],[{"headerIndex":4,"headerParam":["",0,0,2]}],null,null,null,null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}],null,[{"headerIndex":3,"headerParam":[2,false]},{"headerIndex":3,"headerParam":[2,false]}]],"indexIds":{"EV001":0,"EV002":1,"学僧":2,"「犯罪者を奴隷として使役する、という王国の風習は\n　我々の祖先が開拓者としてこの地にやってきたことと\n　関係があるようだ。\\nw[学僧]":3,"「つまり国造りの仕事が山積みの中、牢屋で人手を遊ばせて\n　おく余裕なんて無かったってわけだ」\\nw[学僧]":4,"光":5,"燭台":6,"本":7,"MWL_行数変更 16":8,"\\>　　　『殺虫の心得　～虫モンスター対処法～』\n\\>\n\\>『……これらクモ、ハチ、サソリ、ワームといった虫系\n\\>　のモンスターは、概して風属性に弱く地属性に強いと\n\\>　いった特徴を持つ。\n\\>　魔法防御も特別高くはないので、あなたが魔法使いで\n\\>　あれば、風属性魔法を使用することをお勧めする。\n\\>　\n\\>　しかし弱点が分かっているからと、油断してはいけな\n\\>　い。毒を持つ虫モンスターは多いので、解毒のための\n\\>　アイテムや魔法は必須だ。また……』":9,"MWL_行数リセット":10,"\\>　　　　　　　『王国の危険地帯』\n\\>\n\\>『……わけても危険視される場所のひとつが、迷いの森\n\\>　と呼ばれる大森林地帯だ。\n\\>　中は常に霧がかかっており、方角を見失いやすい。\n\\>　更に多くのモンスターが跳梁跋扈しているため、事前\n\\>　の準備もなく入れば、外へ逃げることもままならずに\n\\>　怪物の腹の中へ収められてしまうだろう。\n\\>　\n\\>　しかし迷いの森には様々な神秘的伝説もあり、いまも\n\\>　その謎に挑もうとする冒険者が後を絶たないのである』":11},"extension":"json","dataType":"map","filename":"Map139","basename":"Map139.json","path":"data/Map139.json","relPath":"data/Map139.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":12,"percent":0},"cellInfo":[]},"data/Map140.json":{"data":[["EV001",""],["作業員",""],["馬車",""],["EV004",""],["馬",""],["値段表",""]],"context":[["Map140/events/1/name"],["Map140/events/2/name"],["Map140/events/3/name"],["Map140/events/4/name"],["Map140/events/5/name","Map140/events/6/name","Map140/events/7/name"],["Map140/events/8/name","Map140/events/9/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"EV001":0,"作業員":1,"馬車":2,"EV004":3,"馬":4,"値段表":5},"extension":"json","dataType":"map","filename":"Map140","basename":"Map140.json","path":"data/Map140.json","relPath":"data/Map140.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map141.json":{"data":[["馬車",""],["作業員",""],["馬",""],["EV004",""],["EV006",""],["値段表",""]],"context":[["Map141/events/1/name"],["Map141/events/2/name"],["Map141/events/3/name","Map141/events/5/name"],["Map141/events/4/name"],["Map141/events/6/name"],["Map141/events/7/name","Map141/events/8/name"]],"tags":[["gold"],["gold"],["gold"],["gold"],["gold"],["gold"]],"parameters":[],"indexIds":{"馬車":0,"作業員":1,"馬":2,"EV004":3,"EV006":4,"値段表":5},"extension":"json","dataType":"map","filename":"Map141","basename":"Map141.json","path":"data/Map141.json","relPath":"data/Map141.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":0,"length":6,"percent":0},"cellInfo":[]},"data/Map142.json":{"data":[["馬車",""],["作業員",""],["馬",""],["EV004",""],["EV006",""],["値段表",""]],"context"