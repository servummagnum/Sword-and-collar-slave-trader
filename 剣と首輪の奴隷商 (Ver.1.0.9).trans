,0,0,2]}]],"indexIds":{"商人ギルド入り口":0,"商業ギルド":1,"武器屋入り口":2,"武器防具店":3,"宿屋入り口":4,"宿屋":5,"アクセサリ店":6,"魔法具店":7,"卸売商会":8,"聖堂":9,"馬車屋入り口":10,"馬車屋":11,"娼館":12,"EV010":13,"EV011":14,"EV012":15,"EV013":16,"EV014":17,"EV015":18,"EV016":19,"EV017":20,"EV018":21,"女性":22,"「日々の祈りこそが、いつの日か救いになるのよ」\\nw[信心深い女]":23,"鳥":24,"男性":25,"「聞いたか！？　悪竜を倒した謎の冒険者の話だよ！\n　すげぇぜ！　伝説の冒険者の再来だ！」\\nw[地元の男]":26,"「この像は伝説の冒険者のものなんだ。\n　圧倒的な強さを誇る怪物を倒した英雄さ」\\nw[地元の男]":27,"淫行男1":28,"悪辣な男":29,"「このまえ借金を返さないクズ男の妻と娘を、目の前で\n　犯してやったのさ。楽しかったぜぇ」\\nw[\\v[1655]]":30,"「お前の連れの女、いい声で鳴きそうだなぁ。\n　目の前で犯してやろうか？」\\nw[\\v[1655]]":31,"\\N[2]をこの男と\\C[27]売春\\C[0]させますか？":32,"売春させる":33,"やめておく":34,"「冒険者ギルドなら、街の南側にあるよ」\\nw[元冒険者]":35,"淫行表示":36,"「モンスターの多い僻地にいくほど、俺たち冒険者の\n　価値は上がるってものさ」\\nw[冒険者]":37,"EV026":38,"依頼フキダシ":39,"工事監督官（依頼31）":40,"依頼を出している場合":41,"執事（依頼21）":42,"研究者（依頼32)":43,"スケベじじい（依頼19）":44,"王国官吏（依頼30）":45,"おっぱいマニア（依頼18）":46,"矢印マーク":47,"街ズームアウト":48,"P_D_FILENAME name_town\\V[101]":49,"「冒険者が集まる町だって聞きましたけど、なんで\n　ここに？\n　冒険がいっぱいありそうには見えませんけど」\\nw[\\N[2]]":50,"「さあな、理由は俺もよく知らん。\n　だが冒険者の仕事の半分以上は、冒険とは無関係の\n　労働だ。\\nw[\\N[1]]":51,"「もしかしたら、王都と南都の中間地点だから仕事を\n　受けやすいってだけかもな」\\nw[\\N[1]]":52,"「夢がありませんねぇ」\\nw[\\N[2]]":53,"落ちてる精霊石（街）":54,"レイプEv発生制御":55,"通行不可":56,"依頼掲示板":57,"掲示板マーク":58,"兵士":59,"兵士（追跡）":60,"「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]":61,"馬車":62,"通行遮断":63,"食料品店":64,"尾行対象（依頼13・14・15）":65,"<PsensorF:7 Td1 Ev1 Rv\\S[22]>":66,"難易度ノーマル用":67,"難易度イージー用（振り向く前に立ち止まる時間が倍）":68,"視界範囲に引っかかったとき":69,"SmartPath 0 7 39":70,"周囲2マス圏内に侵入したとき":71,"尾行に気づいて逃走":72,"浮気相手の元へゴールしたとき":73,"浮気調査（依頼13・14・15）":74,"浮気相手(依頼11)":75,"「パトロール異常なし！\n　今日も町は平和であります！」\\nw[兵士]":76,"ターゲット表示":77,"個別依頼18":78,"召喚の生贄":79,"「故郷を飛び出して冒険者になったけど、うちのパーティは\n　みんな弱いんで、苦労してばかりなんだ。\\nw[三流冒険者]":80,"「でも挫けないよ！\n　絶対に強くなって、伝説の冒険者のような偉業を\n　成すんだ！」\\nw[三流冒険者]":81,"「頑張り屋さんですね。\n　わたしも応援しますから、良い冒険者になってください」\\nw[\\N[2]]":82,"「ありがとう、猫の人！\n　それじゃあ力を貸して欲しいんだけど」\\nw[三流冒険者]":83,"「どういうことだ？\n　言っておくが、訓練の相手とかなら他の連中を\n　当たってくれよ」\\nw[\\N[1]]":84,"「はははっ、違いますよ！\n　お願いしたいのは、奴隷の調達です。\\nw[三流冒険者]":85,"「邪神召喚を行うための生贄用に、\\C[17]エルフの奴隷\\C[0]を\n　売ってくれませんか？」\\nw[三流冒険者]":86,"「……はい？\n　じゃしん……しょうかん……？」\\nw[\\N[2]]":87,"「そうです！\n　召喚した邪神と取り引きして、一気にズバーンッと\n　強くなるんですよ！」\\nw[三流冒険者]":88,"「なにこの人……？\n　爽やかな顔して、とんでもなく邪悪なこと言い出した\n　んですけど……」\\nw[\\N[2]]":89,"「邪神の好みが分からないんで、とりあえずエルフ奴隷の\n　容姿はノーマルな感じでお願いします。\n　\\C[17]おっぱいの大きさとか普通\\C[0]で。\\nw[三流冒険者]":90,"「あと\\C[17]肌は白い\\C[0]方がいいかな？\n　そっちのほうが生贄っぽいしね！\\nw[三流冒険者]":91,"「ああそれと、召喚には\\C[17]サファイアも一個\\C[0]必要なんだっけ。\n　一緒に持ってきてくれます？」\\nw[三流冒険者]":92,"「いいぜ、払うもんさえ払ってくれればな」\\nw[\\N[1]]":93,"「現金はあまりないんで、報酬はこの前ダンジョンで\n　見つけたこの\\C[17]精霊石5個\\C[0]と\\C[17]怪しい玉\\C[0]でどうでしょう？」\\nw[三流冒険者]":94,"個別依頼『召喚の生贄』を受けますか？":95,"受ける":96,"受けない":97,"大山脈東洞窟・1層":98,"ハイエルフの森":99,"個別依頼\\C[17]『召喚の生贄』\\C[0]を受けた！":100,"\\C[17]『\\in[126]』\\C[0]と\\C[17]『\\in[305]』\\C[0]を依頼者に渡しますか？":101,"渡す":102,"渡さない":103,"依頼条件達成":104,"「エルフ奴隷を連れてきたぞ。\n　それとサファイアもだ」\\nw[\\N[1]]":105,"「どうもありがとう！\n　これで邪神召喚ができます！」\\nw[三流冒険者]":106,"\\}「ちょっと\\N[1]さん！　いいんですか！？\n　邪神召喚の手伝いなんかしちゃって」\\{\\nw[\\N[2]]":107,"\\}「大丈夫だって。邪神なんて本当に呼び出せるかよ。\n　どうせ『ごっこ遊び』をやってお終いだ」\\{\\nw[\\N[1]]":108,"「どうかしましたか？」\\nw[三流冒険者]":109,"「いやいや、こっちの話だ。\n　それじゃあ、邪神の召喚がんばってくれな！」\\nw[\\N[1]]":110,"「はいっ、ありがとうございました！」\\nw[三流冒険者]":111,"個別依頼\\C[17]『召喚の生贄』\\C[0]を達成した！":112,"\nここでエッチイベント\n↓　　↓　　↓":113,"↓プレーヤー位置強制中央":114,"SFC_ENABLE_RESERVE":115,"依頼条件未達成":116,"「邪神を召喚して絶対に強くなるんだ！\n　そのための生贄と宝石、お願いしますね」\\nw[三流冒険者]":117,"冒険者ギルド":118,"奴隷市":119,"奴隷市（フキダシ）":120,"奴隷市（通行不可）":121,"犬":122,"亀":123,"冒険者1":124,"「悪竜を倒した冒険者の話を聞いてたらやる気が出て\n　きたぜ！　オレだっていつかきっと有名になってやる！」\\nw[若い冒険者]":125,"「姉ちゃんの反対を押し切って冒険者になった手前、\n　なにかデッカイ手柄を立てて見返してやらないと！」\\nw[若い冒険者]":126,"女性1":127,"「この町は沼地が近いせいで、カエルやヘビがよく出るのよ。\n　もう慣れちゃったけど」\\nw[主婦]":128,"女性2":129,"「冒険者の町なんて言われてるけど、ならず者の町の\n　間違いじゃないかしら？」\\nw[主婦]":130,"冒険者2":131,"「やんのかコラ！\n　相手になってやるぞ！」\\nw[冒険者]":132,"冒険者3":133,"「上等だコラ！\n　かかってこいやッ！」\\nw[冒険者]":134,"冒険者4":135,"「名もなき伝説の冒険者がこうして語り継がれているように、\n　悪竜退治の英雄も伝説になるんだろうね」\\nw[冒険者]":136,"「この町に冒険者が集まるようになったのは、\n　やはりその像の男――伝説の冒険者のせいだろうね。\\nw[冒険者]":137,"「その功績にあやかろうと人が集まってきて、\n　とうとう冒険者ギルドまで作っちまったのさ」\\nw[冒険者]":138,"学者":139,"「この辺りは、水棲動物や昆虫の生息地として\n　貴重なのだよ」\\nw[学者]":140,"男の子1":141,"「おじゃまたくし！　おじゃまたくしがいるよ！」\\nw[男の子]":142,"奴隷1":143,"「奴隷になったときはどうしようかと思ったけど、\n　家事をやってれば普通にゴハンが食べられるから\n　よかったわ」\\nw[女奴隷]":144,"民家":145,"売り家表示":146,"EV092":147,"自宅入り口":148,"自宅":149,"EV094":150,"ＢＧＭ変更":151,"夜間用ＢＧＭ演奏":152,"夜→昼":153,"最初から昼":154,"昼→夜":155,"最初から夜":156,"盗賊1":157,"「見たな！　生かしてはおかぬ！」\\nw[盗賊]":158,"「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]":159,"「邪魔をするなら殺す！」\\nw[蛮族]":160,"「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]":161,"奴隷化性別：0=女、1=男、2=男女ランダム":162,"↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ":163,"戦闘マーク1":164,"景気ランタン":165,"EV101":166,"台座に『伝説の冒険者』と彫られている。":167,"依頼01・02戦闘":168,"依頼を引き受けている場合、暴漢と戦闘":169,"「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]":170,"\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]":171,"暴漢と戦闘":172,"「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]":173,"襲ってきた暴漢を街の警備兵に引き渡した。":174,"暴漢":175,"アヒル":176,"レイプ魔":177,"レイプ被害者":178,"レイプマーク":179,"レイプEv向き合わせ":180,"掲示板依頼初期化おばあちゃん":181,"<TE:110>":182,"レイプ現場遭遇":183,"街中盗賊出没":184,"欲深な男":185,"「悪事ってぇのは金になる。その気さえありゃな」\\nw[\\v[1655]]":186,"「金があればよぉ、女だって自由に抱ける！\n　お前のその女も買ってやろうか？」\\nw[\\v[1655]]":187,"街中淫行制御":188,"通行不可スイッチ":189,"フクロウ":190,"マップ取得":191,"FocusCamera 31 19 120":192,"ZoomOut 2.8 120":193,"\\C[17]\\V[907]の地図\\C[0]を取得した！":194,"ResetZoom 60":195,"ResetFocus 60":196,"街中イーグルダイブ":197,"ここから飛び降りますか？":198,"飛び降りる":199,"やめる":200,"藁山":201,"四聖教メッセンジャー":202,"<TE:112>":203,"会話マーク(EX)":204,"<TE:113>":205},"extension":"json","dataType":"map","filename":"Map055","basename":"Map055.json","path":"data/Map055.json","relPath":"data/Map055.json","dirname":"/data","originalFormat":"RPG MAKER MV RAW DATA","lineBreak":"\n","type":"","indexIsBuilt":false,"progress":{"translated":2,"length":206,"percent":0.9708737864077669},"cellInfo":[]},"data/Map056.json":{"data":[["宿屋入り口",""],["宿屋",""],["ギルド入り口",""],["商業ギルド",""],["武器屋入り口",""],["武器防具店",""],["装飾品店入り口",""],["アクセサリ店",""],["魔法具屋入り口",""],["魔法具店",""],["高級品店入り口",""],["卸売商会",""],["聖堂入り口",""],["聖堂",""],["馬車屋","Stagecoach shop"],["王国官吏（依頼30）",""],["依頼を出している場合",""],["EV010",""],["EV011",""],["EV012",""],["EV013",""],["EV014",""],["EV015",""],["EV016",""],["EV017",""],["EV018",""],["EV019",""],["EV020",""],["EV021",""],["EV022",""],["女性",""],["「人間も猫人も、神々の前ではひとしく平等よ」\\nw[信心深い女]",""],["依頼フキダシ",""],["男性",""],["「海賊がたびたび出没してるのに、それでも海に出ようと\n　してる商船があるみたいだ。\\nw[地元の男]",""],["「まあ交易しないと借金ばかり膨れるから、仕方ない\n　んだろうけど」\\nw[地元の男]",""],["「波の音を子守歌にして、俺たち地元の人間は育てられて\n　きたんだ」\\nw[地元の男]",""],["工事監督官（依頼31）",""],["「港の方で商船護衛の人員を募集してるようだ。\n　オレも現役だったら、応じていたかもしれないな」\\nw[元冒険者]",""],["「海賊退治に参加したことがあるけど、あいつらは船の\n　上での戦いに慣れてるから、かなり手こずったよ」\\nw[元冒険者]",""],["「このボロボロの剣を研ぎ直してもらうか、それとも新しい\n　剣を買うか……うーん、悩ましい……」\\nw[冒険者]",""],["研究者（依頼32)",""],["おっぱいマニア（依頼18）",""],["執事（依頼21）",""],["スケベじじい（依頼19）",""],["街ズームアウト",""],["P_D_FILENAME name_town\\V[101]",""],["「ウェーベロイだ！\n　久しぶりってほどでもないのに、なんだか懐かしいなぁ」\\nw[\\N[2]]",""],["「ここに来たことがあるのか？」\\nw[\\N[1]]",""],["「はい。実家の商売上、この町には毎年のように船で\n　立ち寄ってました」\\nw[\\N[2]]",""],["「勝手知ったる場所ってわけだ」\\nw[\\N[1]]",""],["「そこまでじゃありませんけど、まあ多少は……。\\nw[\\N[2]]",""],["「あ、港に行くなら西の方ですよ！」\\nw[\\N[2]]",""],["「それくらいなら俺でも分かるんだが……」\\nw[\\N[1]]",""],["ロープ(下)",""],["マストに登りますか？",""],["登る",""],["登らない",""],["ロープ",""],["依頼掲示板",""],["掲示板マーク",""],["兵士",""],["兵士（追跡）",""],["「広場で騒ぎを起こすヤツはしょっぴくからな！」\\nw[兵士]",""],["馬車",""],["通行遮断",""],["食料品店",""],["尾行対象（依頼13・14・15）",""],["<PsensorF:7 Td1 Ev1 Rv\\S[22]>",""],["難易度ノーマル用",""],["難易度イージー用（振り向く前に立ち止まる時間が倍）",""],["視界範囲に引っかかったとき",""],["SmartPath 0 66 0",""],["周囲2マス圏内に侵入したとき",""],["尾行に気づいて逃走",""],["浮気相手の元へゴールしたとき",""],["ターゲット表示",""],["浮気調査（依頼13・14・15）",""],["浮気相手(依頼11)",""],["船長",""],["護衛雇い入れEv",""],["「なんだお前らは？　なにか用か？」\\nw[船長]",""],["「えぇっと……こちらでシーグヌース行きの商船の護衛を\n　募集していると聞きまして」\\nw[\\N[2]]",""],["「俺たちは冒険者ギルド所属の冒険者だ。\n　雇ってもらいたくて来た」\\nw[\\N[1]]",""],["「ほう、そうか！　ギルドの冒険者なら雇ってもいいな。\\nw[船長]",""],["「そっちの娘はともかく、お前は腕が立ちそうだ。\n　軽く１０人や２０人は暗殺してるって面構えだな」\\nw[船長]",""],["「してねぇよッ！！」\\nw[\\N[1]]",""],["「では雇ってくださるということで、いいですか？」\\nw[\\N[2]]",""],["「おう、いいぜ！　とりあえずこれが契約金だ。\n　よろしく頼むぜ」\\nw[船長]",""],["契約金として\\C[17]\\v[1]Ｇ\\C[0]を得た！",""],["「これで護衛の数もじゅうぶんに揃ったし、お前らの\n　準備が出来次第、すぐに出発するぞ！」\\nw[船長]",""],["商船に乗って出航しますか？",""],["出航する",""],["まだ行かない",""],["「海賊どもから船を守りつつシーグヌースへ渡るために、\n　当船では護衛を募集している！\\nw[船長]",""],["「ただし身許の不確かなゴロツキは雇わんぞ！\n　冒険者なら、最低限ギルドに入会してから来い！」\\nw[船長]",""],["「普段は運賃をもらって\\C[17]島の町シーグヌース\\C[0]まで\n　同乗させてやってるんだが……。\n　今は海賊が暴れ回っているから船を出せんのだ」\\nw[船長]",""],["船マーク",""],["個別依頼20",""],["童貞卒業式",""],["「長距離の航海ってのは危険がつきものでね、\n　いつ命を落とすか分かったもんじゃないのさ。\\nw[女船長]",""],["「だから死んでも悔いが残らないよう、新米水夫どもは、\n　初の長距離航海の前に童貞を捨てるのが習わしに\n　なってるんだ」\\nw[女船長]",""],["「童貞ってテクニックは無いでしょうけど、性欲はすごく\n　旺盛でしょうね\\I[29]」\\nw[\\N[2]]",""],["「ウチの船にも今度、そういう性欲を持て余した新米どもが\n　何人か入ったんだよ。\\nw[女船長]",""],["「そ……そうなんですか、へぇ……」\\nw[\\N[2]]",""],["「ウチの船にも今度、新米どもが何人か入ったんだよ。\\nw[女船長]",""],["「もうちょっと若けりゃ、あたしが童貞卒業の相手を\n　してやってもいいんだけど――。\\nw[女船長]",""],["「この歳で若い男を何人も相手するのは、さすがにキツい\n　からねぇ」\\nw[女船長]",""],["「なら、金をやって娼館に行かせるのか？」\\nw[\\N[1]]",""],["「これまではそうしてたけど、少し前にウチの水夫の一人が\n　酔って暴れてから娼館は出入り禁止になっちまったのさ。\\nw[女船長]",""],["「そこであんたらにお願いだ。\n　新米どもの童貞チンコを突っ込むための奴隷を、用意して\n　くれないか？」\\nw[女船長]",""],["「なるほど。で、希望の奴隷はどんなのだ？」\\nw[\\N[1]]",""],["「新米どもの要望を総合すると、\\C[17]褐色肌の人間\\C[0]で、\\C[17]胸は\n　大きすぎず小さすぎず\\C[0]――だそうだ。\\nw[女船長]",""],["「注文通りの女を用意できるなら、この貴重な\\C[17]\\in[27]\\C[0]と\n　\\C[17]\\in[28]\\C[0]を４個ずつやろう。\n　それと海岸で拾った\\C[17]奇妙な玉っころ\\C[0]もくれてやる」\\nw[女船長]",""],["個別依頼『童貞卒業式』を受けますか？",""],["受ける",""],["受けない",""],["古代遺跡・中央部",""],["火の洞窟",""],["個別依頼\\C[17]『童貞卒業式』\\C[0]を受けた！",""],["\\C[17]『\\in[112]』\\C[0]を依頼者に渡しますか？",""],["渡す",""],["渡さない",""],["依頼条件達成",""],["「お望みの通りの奴隷を連れてきたぞ。\n　さあ、確認してくれ」\\nw[\\N[1]]",""],["「ふむふむ……いいね、健康で頑丈そうだ。\\nw[女船長]",""],["「性欲のたぎってる若造どもに犯されるわけだから、\n　体が丈夫に越したことはない。\\nw[女船長]",""],["「いいだろう、この奴隷をいただこうか」\\nw[女船長]",""],["個別依頼\\C[17]『童貞卒業式』\\C[0]を達成した！",""],["\nここからエッチイベント\n↓　　↓　　↓",""],["↓プレーヤー位置強制中央",""],["SFC_ENABLE_RESERVE",""],["依頼条件未達成",""],["「早いとこ奴隷を持ってきておくれよ。\n　うちの新米水夫どもも、首を長くして待ってるからさ」\\nw[女船長]",""],["兵士（追跡）2",""],["「ここのところ密輸が増えているから、より厳しく\n　目を光らせねば！」\\nw[兵士]",""],["奴隷市",""],["奴隷市（フキダシ）",""],["奴隷市（通行不可）",""],["漁師",""],["海産物売買フキダシ",""],["男性市民1",""],["「王都や副都は悪竜のせいで大変だったそうだが、\n　この町は至って平和なものさ」\\nw[男性]",""],["「この町を流れ過ぎていく商品の数は膨大なものだ。\n　ここは流通の要衝地なのさ」\\nw[男性]",""],["女性市民1",""],["「恋人が外国行きの商船に乗ったまま、二年間も戻って\n　来ないの。\n　やっぱりもう、あの人は……」\\nw[女性]",""],["女性市民2",""],["「今日の晩ごはんは、なんのお魚にしようかしら？」\\nw[主婦]",""],["男の子1",""],["「オレは海のおとこだから、将来は父ちゃんと一緒に\n　船に乗るんだ！」\\nw[男の子]",""],["女の子1",""],["「この花はわたしが育てました！\n　きれいでしょ？」\\nw[女の子]",""],["港湾労働者1",""],["「来る日も来る日も、倉庫と船を往復しての荷物運び。\n　イヤになっちゃうぜ」\\nw[労働者]",""],["水夫1",""],["「できればもうちょっと載せたいけど、船の積載量\n　ギリギリだからなぁ……」\\nw[水夫]",""],["水夫2",""],["「輸出の準備をしちゃいるけど、出航はいつになるやら。\n　まったく、海賊どもめ……」\\nw[水夫]",""],["「輸出用の酒樽はこれでよし……と。\n　あとは麦と染料の準備を――」\\nw[水夫]",""],["女性市民3",""],["「そうよ、いま無理して船に乗ることなんてないわ」\\nw[女性]",""],["「お願いだから、無事に帰ってきてちょうだい」\\nw[女性]",""],["男性市民2",""],["「シーグヌースまで行きたいが、船がないんじゃ仕方ない。\n　しかし、海賊はいつになったら大人しくなるんだ？」\\nw[男性]",""],["「そんなに心配しなくて大丈夫さ。\n　シーグヌースまで往復してくるだけなんだから」\\nw[男性]",""],["女性市民4",""],["「あら珍しい。\n　深海魚が混じってるわ」\\nw[老婦人]",""],["男の子2",""],["「ぺス！\n　お手ッ――からの空中三回転半ひねり！」\\nw[男の子]",""],["犬",""],["（無理言うなボケ！）\\nw[ペス]",""],["女性市民5",""],["「海風の強い日は、洗濯物が飛ばされちゃうことも\n　しょっちょうなのよ」\\nw[主婦]",""],["奴隷1",""],["「休みなく荷物の上げ下ろし……。\n　俺の一生はこれだけで終わっちまうのか……？」\\nw[奴隷]",""],["奴隷2",""],["「カッとなって友人を殺してしまった報いが、この\n　境遇なんだ。\n　甘んじて受け入れるしかないよ……」\\nw[奴隷]",""],["奴隷3",""],["（隙を見て、絶対に逃げ出してやる……！）\\nw[人間奴隷]",""],["奴隷4",""],["（おのれ人間め！　この屈辱は忘れんぞ！）\\nw[エルフ奴隷]",""],["奴隷5",""],["（オナカヘッタ……）\\nw[鬼奴隷]",""],["水夫3",""],["「海賊のせいで出航できなくて、余計な出費ばかり増えて\n　いくよ」\\nw[水夫]",""],["「いいか奴隷ども！　舟の上に逃げ場はない！\n　痛い目にあいたくなければ大人しくしていろ！」\\nw[水夫]",""],["民家入り口",""],["民家",""],["自宅入り口",""],["自宅","Player home"],["EV105",""],["売り家表示",""],["EV107",""],["ＢＧＭ変更",""],["夜間用ＢＧＭ演奏",""],["夜→昼",""],["最初から昼",""],["昼→夜",""],["最初から夜",""],["盗賊1",""],["「見たな！　生かしてはおかぬ！」\\nw[盗賊]",""],["「チッ！　抜かった……！\n　見られたからには口封じだ！」\\nw[雪賊]",""],["「邪魔をするなら殺す！」\\nw[蛮族]",""],["「馬鹿め！　正義を気取って死期を早めたな！」\\nw[猫賊]",""],["奴隷化性別：0=女、1=男、2=男女ランダム",""],["↓拾得奴隷の種類決定\n　1=人間(普通)、2=人間(白肌)、3=蛮族、4=猫人、5=悪魔、6=Hｴﾙﾌ、7=Dｴﾙﾌ、8=鬼、9=ﾊｰﾋﾟｰ",""],["戦闘マーク1",""],["景気ランタン",""],["落ちてる精霊石（街）",""],["依頼01・02戦闘",""],["依頼を引き受けている場合、暴漢と戦闘",""],["「てめぇッ！　\\C[17]金\\C[0]を持ってやがるな！\n　こっちに寄越せッ！！」\\nw[暴漢]",""],["\n　\\C[18]※　配達中の現金を狙って、暴漢が襲ってきた！　※\\C[0]",""],["暴漢と戦闘",""],["「ぎゃひぃーーッ！！\n　参った！　俺の負けだァ！！」\\nw[暴漢]",""],["襲ってきた暴漢を街の警備兵に引き渡した。",""],["暴漢",""],["猫",""],["レイプ魔",""],["レイプ被害者",""],["レイプマーク",""],["レイプEv向き合わせ",""],["レイプEv発生制御",""],["レイプ現場遭遇",""],["街中盗賊出没",""],["淫行男1",""],["卑猥な男",""],["「街で女とすれ違うたびによぉ、股間がうずいて\n　仕方ねぇんだ。つい襲っちまいそうになる」\\nw[\\v[1655]]",""],["「ハァハァ、エロそうな女がいるじゃねぇか！\n　そのメス奴隷、使わせろよ！！」\\nw[\\v[1655]]",""],["\\N[2]をこの男と\\C[27]売春\\C[0]させますか？",""],["売春させる",""],["やめておく",""],["淫行表示",""],["街中淫行制御",""],["淫行男2",""],["残虐な男",""],["「明日あたり、土左衛門が上がるかもしれねぇなぁ。\n　……さっきちぃっとばかし、やっちまってな」\\nw[\\v[1655]]",""],["「暴力振るったあとは、やたらと女を抱きたくなりやがる。\n　ってぇわけで、その奴隷ちっと貸せや」\\nw[\\v[1655]]",""],["水死体",""],["娼館",""],["見張り台(降り口)",""],["マストを降りますか？",""],["降りる",""],["降りない",""],["フクロウ",""],["マップ取得",""],["FocusCamera 55 32 120",""],["ZoomOut 3 120",""],["\\C[17]\\V[909]の地図\\C[0]を取得した！",""],["ResetZoom 60",""],["ResetFocus 60",""],["街中イーグルダイブ",""],["ここから飛び降りますか？",""],["飛び降りる",""],["やめる",""],["水柱1",""],["「勝手にマストに登ったりするなよ。\n　落ちても責任は取れないからな」\\nw[水夫]",""],["侵入不可",""],["掲示板依頼初期化おばあちゃん",""],["<TE:110>",""],["四聖教メッセンジャー",""],["<TE:112>",""],["会話マーク(EX)",""],["<TE:113>",""]],"context":[["Map056/events/1/name"],["Map056/events/1/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/2/name","Map056/events/132/name"],["Map056/events/2/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/3/name","Map056/events/8/name"],["Map056/events/3/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/4/name"],["Map056/events/4/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/5/name"],["Map056/events/5/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/6/name"],["Map056/events/6/pages/0/list/3/Control Variables/var:1076-1076/tok/0/type/StringLiteral/pos/0"],["Map056/events/7/name"],["Map056/events/7/pages/0/list/3/Control Variables/var:1076-1076/to